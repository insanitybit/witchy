// csv — comma-separated values, decode and encode (RFC 4180-ish).
//
// Fields are separated by commas and rows by newlines. A field that contains a
// comma, a quote, or a newline is wrapped in double quotes, and a literal quote
// inside such a field is doubled (`""`). The decoder is a small character state
// machine, so embedded commas/newlines/quotes round-trip through `encode`.

import string
import dict
import iter

// Decode CSV text into rows of fields. A trailing newline is ignored; `\r\n` and
// `\n` line endings both work. Genuinely fallible (RFC-0044 rule 2): a field that
// opens a quote and never closes it, or a bare `"` in the middle of an unquoted
// field (`a"b`) / text after a closing quote (`"a"b`), is structurally malformed,
// so decoding returns `Err` naming the fault rather than silently mangling it. A
// lone `\r` (not part of a `\r\n`) is a literal data byte, kept rather than
// silently deleted. Paired with `encode`, aligned with `json`/`toml`.
pub fn decode(text: String) -> Result(List(List(String)), String):
    let chars = string.chars(text)
    let n = list.length(chars)
    var rows = []
    var row = []
    var field = ""
    var in_quotes = false
    var started = false
    var closed = false
    var i = 0
    while i < n:
        let ch = list.at(chars, i)
        if in_quotes:
            if ch == "\"":
                if i + 1 < n && list.at(chars, i + 1) == "\"":
                    field = field + "\""
                    i = i + 2
                else:
                    in_quotes = false
                    closed = true
                    i = i + 1
            else:
                field = field + ch
                i = i + 1
        else if ch == "\"":
            if started:
                return Err("`" + text + "` has a stray `\"` (a quote may only open a field or be doubled inside one)")
            else:
                started = true
                in_quotes = true
                i = i + 1
        else if ch == ",":
            row = list.push(row, field)
            field = ""
            started = false
            closed = false
            i = i + 1
        else if ch == "\n":
            row = list.push(row, field)
            rows = list.push(rows, move row)
            row = []
            field = ""
            started = false
            closed = false
            i = i + 1
        else if ch == "\r" && i + 1 < n && list.at(chars, i + 1) == "\n":
            // `\r\n`: drop the `\r` so the following `\n` terminates the row.
            i = i + 1
        else:
            if closed:
                return Err("`" + text + "` has text after a closing quote (a quoted field must be followed by `,` or a newline)")
            field = field + ch
            started = true
            i = i + 1
    if in_quotes:
        return Err("`" + text + "` has an unterminated quoted field (expected a closing `\"`)")
    // Flush a final row that had no trailing newline (including a lone empty
    // quoted field, which set `started` but left `field` empty).
    if started || list.length(row) > 0:
        rows = list.push(rows, list.push(row, field))
    Ok(rows)

// Encode rows back to CSV text (each row newline-terminated), quoting any field
// that needs it.
pub fn encode(rows: List(List(String))) -> String:
    var out = ""
    for row in rows:
        out = out + encode_row(row) + "\n"
    out

fn encode_row(row: List(String)) -> String:
    // Quote each field, then join with commas — dogfoods std/iter.
    let parts: List(String) = iter.collect(iter.map(iter.from_list(row), fn(f: String): encode_field(f)))
    list.join(parts, ",")

fn encode_field(f: String) -> String:
    if needs_quoting(f):
        "\"" + list.join(string.split(f, "\""), "\"\"") + "\""
    else:
        f

fn needs_quoting(f: String) -> Bool:
    string.contains(f, ",") || string.contains(f, "\"") || string.contains(f, "\n") || string.contains(f, "\r")

// Decode with the first row as a header: each remaining row becomes a Dict keyed
// by the header columns. Fallible (RFC-0044): besides `decode`'s faults, a
// duplicate header column (`a,b,a`) would silently collapse in the Dict, and a
// ragged data row (a field count other than the header's) would silently drop or
// invent columns — both are rejected with an `Err` naming the fault instead.
pub fn decode_records(text: String) -> Result(List(Dict(String, String)), String):
    var out = []
    var i = 0
    var header = []
    var width = 0
    for row in decode(text)?:
        if i == 0:
            if let Some(dup) = first_duplicate(row):
                return Err("duplicate CSV header column `" + dup + "`")
            header = row
            width = list.length(row)
        else:
            if list.length(row) != width:
                return Err("CSV row " + "${i}" + " has " + "${list.length(row)}" + " fields but the header has " + "${width}")
            out = list.push(out, zip_record(header, row))
        i = i + 1
    Ok(out)

// The first column name that appears more than once in `header`, or None.
fn first_duplicate(header: List(String)) -> Option(String):
    var seen = []
    for col in header:
        if list.contains(seen, col):
            return Some(col)
        seen = list.push(seen, col)
    None

fn zip_record(header: List(String), row: List(String)) -> Dict(String, String):
    var d = dict.new()
    var i = 0
    for col in header:
        d = dict.insert(d, col, if i < list.length(row): list.at(row, i) else: "")
        i = i + 1
    d
