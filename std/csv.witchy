// csv — comma-separated values, decode and encode (RFC 4180-ish).
//
// Fields are separated by commas and rows by newlines. A field that contains a
// comma, a quote, or a newline is wrapped in double quotes, and a literal quote
// inside such a field is doubled (`""`). The decoder is a small character state
// machine, so embedded commas/newlines/quotes round-trip through `encode`.

import string
import dict

// Decode CSV text into rows of fields. A trailing newline is ignored; `\r\n` and
// `\n` line endings both work. Genuinely fallible (RFC-0044 rule 2): a field that
// opens a quote and never closes it is structurally malformed input, so decoding
// returns `Err` naming the fault rather than silently absorbing it. Paired with
// `encode`, and aligned with `json`/`toml` (serialization formats `decode`).
pub fn decode(text: String) -> Result(List(List(String)), String):
    let chars = string.chars(text)
    let n = list.length(chars)
    var rows = []
    var row = []
    var field = ""
    var in_quotes = false
    var i = 0
    while i < n:
        let ch = list.at(chars, i)
        if in_quotes:
            if ch == "\"":
                if i + 1 < n && list.at(chars, i + 1) == "\"":
                    field = field + "\""
                    i = i + 2
                else:
                    in_quotes = false
                    i = i + 1
            else:
                field = field + ch
                i = i + 1
        else if ch == "\"":
            in_quotes = true
            i = i + 1
        else if ch == ",":
            row = list.push(row, field)
            field = ""
            i = i + 1
        else if ch == "\n":
            row = list.push(row, field)
            rows = list.push(rows, move row)
            row = []
            field = ""
            i = i + 1
        else if ch == "\r":
            i = i + 1
        else:
            field = field + ch
            i = i + 1
    if in_quotes:
        return Err("`" + text + "` has an unterminated quoted field (expected a closing `\"`)")
    // Flush a final row that had no trailing newline.
    if !string.is_empty(field) || list.length(row) > 0:
        rows = list.push(rows, list.push(row, field))
    Ok(rows)

// Encode rows back to CSV text (each row newline-terminated), quoting any field
// that needs it.
pub fn encode(rows: List(List(String))) -> String:
    var out = ""
    for row in rows:
        out = out + encode_row(row) + "\n"
    out

fn encode_row(row: List(String)) -> String:
    var parts = []
    for f in row:
        parts = list.push(parts, encode_field(f))
    list.join(parts, ",")

fn encode_field(f: String) -> String:
    if needs_quoting(f):
        "\"" + list.join(string.split(f, "\""), "\"\"") + "\""
    else:
        f

fn needs_quoting(f: String) -> Bool:
    string.contains(f, ",") || string.contains(f, "\"") || string.contains(f, "\n") || string.contains(f, "\r")

// Decode with the first row as a header: each remaining row becomes a Dict keyed
// by the header columns (a short row's missing columns read as ""). Fallible for
// the same reason as `decode` (it decodes first), so it returns `Result`.
pub fn decode_records(text: String) -> Result(List(Dict(String, String)), String):
    var out = []
    var i = 0
    var header = []
    for row in decode(text)?:
        if i == 0:
            header = row
        else:
            out = list.push(out, zip_record(header, row))
        i = i + 1
    Ok(out)

fn zip_record(header: List(String), row: List(String)) -> Dict(String, String):
    var d = dict.new()
    var i = 0
    for col in header:
        d = dict.insert(d, col, if i < list.length(row): list.at(row, i) else: "")
        i = i + 1
    d
