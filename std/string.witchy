// The witchy standard string library. Importing it grants no root authority;
// this module's implementation operates on ordinary string data. The primitive
// string operations (`split`, `replace`, `contains`, `to_upper`, ...) are
// builtins; these are the conveniences built on top of them.

import option
import list

// --- Native primitives (intercepted by both backends; self-recursive
// placeholder bodies give the type checker the signatures). These must exist
// as module-level functions because the intrinsic interception resolves by
// the qualified name `string.X`. The impl methods below delegate to these. ---
pub fn length(s: String) -> Int:
    string.length(s)

pub fn char_count(s: String) -> Int:
    string.char_count(s)

pub fn char_offset(s: String, n: Int) -> Int:
    string.char_offset(s, n)

pub fn chars(s: String) -> unique List(String):
    string.chars(s)

pub fn from_code(code: Int) -> unique String:
    string.from_code(code)

pub fn split(s: String, sep: String) -> unique List(String):
    string.split(s, sep)

pub fn contains(s: String, needle: String) -> Bool:
    string.contains(s, needle)

pub fn starts_with(s: String, prefix: String) -> Bool:
    string.starts_with(s, prefix)

pub fn ends_with(s: String, suffix: String) -> Bool:
    string.ends_with(s, suffix)

pub fn replace(s: String, from: String, to: String) -> unique String:
    string.replace(s, from, to)

pub fn substring(s: String, start: Int, end: Int) -> unique String:
    string.substring(s, start, end)

pub fn as_str(s: &String) -> &str:
    string.as_str(s)

pub fn slice(s: &str, start: Int, end: Int) -> &str:
    string.slice(s, start, end)

pub fn to_string(s: &str) -> unique String:
    string.to_string(s)

pub fn len(s: &str) -> Int:
    string.len(s)

// Content operations on retained string views. These inspect UTF-8 bytes
// without materializing an owned String.
pub fn hash_view(s: &str) -> Int:
    string.hash_view(s)

pub fn equal_views(left: &str, right: &str) -> Bool:
    string.equal_views(left, right)

pub fn to_upper(s: String) -> unique String:
    string.to_upper(s)

pub fn to_lower(s: String) -> unique String:
    string.to_lower(s)

pub fn trim(s: String) -> unique String:
    string.trim(s)

pub fn to_int(s: String) -> Int:
    string.to_int(s)

// --- Private helpers ---

// The raw search intrinsic: the byte offset of the first occurrence at or after
// byte offset `from` (at most the length; aborts past it), or -1. Private: public callers use
// `index_of` (Option) or `contains` (Bool); the std internals below use it
// directly for scan loops that resume past a match without copying.
fn find(s: String, needle: String, from: Int) -> Int:
    string.find(s, needle, from)

// The raw last-occurrence byte offset (or -1), scanning non-overlapping matches
// left to right. Private: public callers use `last_index_of` (Option); the std
// internals here take the raw offset directly.
fn rfind(s: String, sep: String) -> Int:
    if string.length(sep) == 0:
        0 - 1
    else:
        var last = 0 - 1
        var i = find(s, sep, 0)
        while i >= 0:
            last = i
            i = find(s, sep, i + string.length(sep))
        last

// --- impl String: all operations as methods ---
impl String:
    // The string's length in BYTES (UTF-8). For user-perceived characters, see
    // `char_count`.
    pub fn length(self) -> Int:
        string.length(self)

    // The number of Unicode scalar values. Linear in the length.
    pub fn char_count(self) -> Int:
        string.char_count(self)

    // The byte offset where character `n` (counted by Unicode scalar) starts,
    // or `length()` when the string has `n` or fewer characters; 0 for a
    // negative `n`. Linear in the offset: to walk characters, use `chars` or
    // `char_indices`.
    pub fn char_offset(self, n: Int) -> Int:
        string.char_offset(self, n)

    // The characters, each as a single-character String - one O(n) pass, so
    // callers can index characters in O(1).
    pub fn chars(self) -> unique List(String):
        string.chars(self)

    // Each character with the byte offset where it starts, in order - one O(n)
    // pass. `"héllo".char_indices()` begins `[(0, "h"), (1, "é"), (3, "l")`.
    pub fn char_indices(self) -> unique List((Int, String)):
        var out = []
        var offset = 0
        for c in string.chars(self):
            list.push(out, (offset, c))
            offset = offset + string.length(c)
        out

    // Split on every occurrence of `sep`.
    pub fn split(self, sep: String) -> unique List(String):
        string.split(self, sep)

    // Whether `needle` occurs in `self`.
    pub fn contains(self, needle: String) -> Bool:
        string.contains(self, needle)

    pub fn starts_with(self, prefix: String) -> Bool:
        string.starts_with(self, prefix)

    pub fn ends_with(self, suffix: String) -> Bool:
        string.ends_with(self, suffix)

    // The byte offset of the first occurrence of `needle` as `Some`, or `None`
    // when `needle` does not occur (RFC-0044 rule 1:
    // absence is `Option`, never a -1 sentinel). An empty `needle` matches nothing
    // (the module-wide empty-pattern rule, matching `last_index_of`/`count`). For
    // a bare yes/no, use `contains`.
    pub fn index_of(self, needle: String) -> Option(Int):
        let i = if needle.is_empty(): 0 - 1 else: find(self, needle, 0)
        if i < 0:
            None
        else:
            Some(i)

    // Replace every occurrence of `from` with `to`.
    pub fn replace(self, from: String, to: String) -> unique String:
        string.replace(self, from, to)

    // The bytes from offset `start` (inclusive) to `end` (exclusive). ABORTS
    // unless `0 <= start <= end <= length()` and both offsets fall on character
    // boundaries, so a result is always whole characters. Offsets come from
    // `index_of`, `length`, `char_offset`, or `char_indices`; for a character
    // count use `take`/`drop`.
    pub fn substring(self, start: Int, end: Int) -> unique String:
        string.substring(self, start, end)

    // Return a rooted immutable view of this String as a string slice (`&str`).
    pub fn as_str(self: &String) -> &str:
        string.as_str(self)

    // ASCII case mapping (the portable set both backends share).
    pub fn to_upper(self) -> unique String:
        string.to_upper(self)

    pub fn to_lower(self) -> unique String:
        string.to_lower(self)

    // Strip leading and trailing ASCII whitespace.
    pub fn trim(self) -> unique String:
        string.trim(self)

    // Remove leading ASCII whitespace (the set `trim` strips). The trimmed text
    // begins with a non-space, so its first occurrence starts after the prefix.
    pub fn trim_start(self) -> unique String:
        let kept = string.trim(self)
        if string.length(kept) == 0:
            ""
        else:
            string.substring(self, find(self, kept, 0), string.length(self))

    // Remove trailing ASCII whitespace (the set `trim` strips).
    pub fn trim_end(self) -> unique String:
        let kept = string.trim(self)
        if string.length(kept) == 0:
            ""
        else:
            string.substring(self, 0, find(self, kept, 0) + string.length(kept))

    // Parse a decimal integer; junk, overflow, or an empty string ABORTS the
    // program (a runtime error, not an `Err`) on every backend. For the total
    // version that returns `Option(Int)`, see `parse_int`.
    pub fn to_int(self) -> Int:
        string.to_int(self)

    // Repeat a string `n` times.
    pub fn repeat(self, n: Int) -> unique String:
        var out = ""
        var i = 0
        while i < n:
            out = out + self
            i = i + 1
        out

    // Left-pad `self` with copies of `fill` until it is `width` characters wide.
    // The padding is trimmed to fit exactly, so any non-empty fill yields a result
    // of exactly `width` chars; `self` is returned unchanged when already that long.
    // An empty `fill` can never reach the promised width, so when padding is
    // needed it fails loudly (RFC-0044 rule 3) instead of returning a short string.
    pub fn pad_left(self, width: Int, fill: String) -> String:
        let len = string.char_count(self)
        if len >= width:
            self
        else:
            if fill.is_empty():
                fail("string.pad_left: empty `fill` cannot pad to width ${width}")
            let needed = width - len
            fill.repeat(needed).take(needed) + self

    // Right-pad `self` with copies of `fill` until it is `width` characters wide; an
    // empty `fill` fails loudly when padding is needed (see `pad_left`).
    pub fn pad_right(self, width: Int, fill: String) -> String:
        let len = string.char_count(self)
        if len >= width:
            self
        else:
            if fill.is_empty():
                fail("string.pad_right: empty `fill` cannot pad to width ${width}")
            let needed = width - len
            self + fill.repeat(needed).take(needed)

    // Center `self` in a field `width` characters wide, padding both sides with `fill`;
    // an odd remainder goes on the right. `self` is returned unchanged when already at
    // least that wide; an empty `fill` fails loudly when padding is needed (see
    // `pad_left`).
    pub fn center(self, width: Int, fill: String) -> String:
        let len = string.char_count(self)
        if len >= width:
            self
        else:
            if fill.is_empty():
                fail("string.center: empty `fill` cannot pad to width ${width}")
            let total = width - len
            let left = total / 2
            let right = total - left
            fill.repeat(left).take(left) + self + fill.repeat(right).take(right)

    // Remove `prefix` from the front of `self` when present; otherwise return `self`
    // unchanged. The complement of the `starts_with` builtin.
    pub fn strip_prefix(self, prefix: String) -> String:
        if string.starts_with(self, prefix):
            string.substring(self, string.length(prefix), string.length(self))
        else:
            self

    // Remove `suffix` from the end of `self` when present; otherwise return `self`
    // unchanged. The complement of the `ends_with` builtin.
    pub fn strip_suffix(self, suffix: String) -> String:
        if string.ends_with(self, suffix):
            string.substring(self, 0, string.length(self) - string.length(suffix))
        else:
            self

    // The single character (as a String) at character index `i` (counted by Unicode
    // scalar) as `Some`, or `None` when `i` is out of range (RFC-0044 rule 1:
    // absence is `Option`, never a "" sentinel). Linear in `i`: to visit every
    // character, use `chars` or `char_indices`.
    pub fn char_at(self, i: Int) -> Option(String):
        let start = string.char_offset(self, i)
        if i < 0 || start >= string.length(self):
            None
        else:
            Some(string.substring(self, start, string.char_offset(self, i + 1)))

    // Whether the string has no characters.
    pub fn is_empty(self) -> Bool:
        string.length(self) == 0

    // The string with its characters in reverse order. Counted by Unicode scalar,
    // so multi-byte characters stay intact: `reverse("café")` is `"éfac"`.
    pub fn reverse(self) -> unique String:
        let cs = string.chars(self)
        var out = ""
        var i = cs.length() - 1
        while i >= 0:
            out = out + cs[i]
            i = i - 1
        out

    // The first `n` characters, counted by Unicode scalar (the whole string if it
    // is shorter, "" if n <= 0). Linear in `n`.
    pub fn take(self, n: Int) -> unique String:
        string.substring(self, 0, string.char_offset(self, n))

    // All characters after the first `n`, counted by Unicode scalar ("" if n
    // covers the whole string). Linear in `n`.
    pub fn drop(self, n: Int) -> unique String:
        string.substring(self, string.char_offset(self, n), string.length(self))

    // The number of non-overlapping occurrences of `sub` in `self` (0 for an empty
    // `sub`), scanning left to right.
    pub fn count(self, sub: String) -> Int:
        if string.length(sub) == 0:
            0
        else:
            var total = 0
            var i = find(self, sub, 0)
            while i >= 0:
                total = total + 1
                i = find(self, sub, i + string.length(sub))
            total

    // The whitespace-separated words of `self`: tabs, newlines, and carriage
    // returns are treated as spaces, and empty pieces (from runs of whitespace) are
    // dropped. `"the  quick\tfox".words()` is `["the", "quick", "fox"]`.
    pub fn words(self) -> unique List(String):
        let a = string.replace(self, "\t", " ")
        let b = string.replace(a, "\n", " ")
        let c = string.replace(b, "\r", " ")
        var out = []
        for w in string.split(c, " "):
            if string.length(w) > 0:
                list.push(out, w)
        out

    // Replace only the first occurrence of `from` with `to`; return `self` unchanged
    // when `from` is absent. An empty `from` matches nothing (the module-wide
    // empty-pattern rule: `count`/`index_of`/`last_index_of` treat it as absent).
    // (The `replace` builtin replaces every occurrence.)
    pub fn replace_first(self, from: String, to: String) -> String:
        let i = if from.is_empty(): 0 - 1 else: find(self, from, 0)
        if i < 0:
            self
        else:
            string.substring(self, 0, i) + to + string.substring(self, i + string.length(from), string.length(self))

    // Split at the first occurrence of `sep` into `Some((before, after))`, with
    // `sep` itself dropped. Returns `None` when `sep` is absent or empty, so parsing
    // code can distinguish a missing separator from a present separator with an empty
    // side (`"host"` vs `"host:"`).
    pub fn split_once_opt(self, sep: String) -> Option((String, String)):
        let i = if sep.is_empty(): 0 - 1 else: find(self, sep, 0)
        if i < 0:
            None
        else:
            Some((string.substring(self, 0, i), string.substring(self, i + string.length(sep), string.length(self))))

    // Split at the first occurrence of `sep` into `(before, after)`, with `sep`
    // itself dropped. Compatibility wrapper: when `sep` is absent - including the
    // empty separator, which matches nothing (mirroring `rsplit_once`) - returns
    // `(s, "")`. Prefer `split_once_opt` for parsers and validators that need to
    // distinguish absence from a present empty side.
    pub fn split_once(self, sep: String) -> (String, String):
        match self.split_once_opt(sep):
            Some(parts) -> parts
            None -> (self, "")

    // The byte offset of the LAST occurrence of `sep` in `self` as `Some`, or
    // `None` when absent or `sep` is empty (RFC-0044 rule 1: absence is `Option`,
    // never -1). The right-to-left companion of `index_of`.
    pub fn last_index_of(self, sep: String) -> Option(Int):
        let i = rfind(self, sep)
        if i < 0:
            None
        else:
            Some(i)

    // Split on the LAST occurrence of `sep` into `Some((before, after))`, with `sep`
    // itself dropped. Returns `None` when `sep` is absent or empty.
    pub fn rsplit_once_opt(self, sep: String) -> Option((String, String)):
        let i = rfind(self, sep)
        if i < 0:
            None
        else:
            Some((string.substring(self, 0, i), string.substring(self, i + string.length(sep), string.length(self))))

    // Split on the LAST occurrence of `sep` (e.g. a file extension): `rsplit_once`
    // of `"a.b.c"` on `"."` is `("a.b", "c")`. Compatibility wrapper: when `sep`
    // is absent the whole string is the right part: `("", s)` - mirroring
    // `split_once`'s `(s, "")`. Prefer `rsplit_once_opt` when absence matters.
    pub fn rsplit_once(self, sep: String) -> (String, String):
        match self.rsplit_once_opt(sep):
            Some(parts) -> parts
            None -> ("", self)

    // Safely parse a base-10 integer: an optional leading `-`/`+` then one or more
    // digits. Returns None for empty, sign-only, non-digit, or out-of-range (beyond
    // the i64 range) input - so it never traps the way the raw `string_to_int`
    // builtin can.
    pub fn parse_int(self) -> Option(Int):
        let cs = string.chars(self)
        let n = cs.length()
        if n == 0:
            None
        else:
            var start = 0
            let first = cs[0]
            let neg = first == "-"
            if first == "-" || first == "+":
                start = 1
            if start >= n:
                None
            else:
                var i = start
                var ok = true
                while i < n:
                    let c = cs[i]
                    if c < "0" || c > "9":
                        ok = false
                    i = i + 1
                if ok == false:
                    None
                else:
                    var j = start
                    while j < n - 1 && cs[j] == "0":
                        j = j + 1
                    // Every character is an ASCII sign or digit, so the
                    // character index `j` is also its byte offset.
                    let mag = string.substring(self, j, n)
                    let mlen = n - j
                    let limit = if neg: "9223372036854775808" else: "9223372036854775807"
                    if mlen > 19 || mlen == 19 && mag > limit:
                        None
                    else:
                        Some(string.to_int(self))

    // Split text into its newline-separated lines.
    pub fn lines(self) -> unique List(String):
        string.split(self, "\n")

// --- impl str: string slice methods ---
impl str:
    // The string slice's length in BYTES (UTF-8).
    pub fn length(self: &str) -> Int:
        string.len(self)

    // The number of Unicode scalar values in this slice.
    pub fn char_count(self: &str) -> Int:
        string.to_string(self).char_count()

    // The sub-slice from byte offset `start` (inclusive) to `end` (exclusive).
    // ABORTS unless `0 <= start <= end <= length()` and both offsets fall on
    // character boundaries (see `String.substring`).
    pub fn slice(self: &str, start: Int, end: Int) -> &str:
        string.slice(self, start, end)

    // Whether the string slice has no characters.
    pub fn is_empty(self: &str) -> Bool:
        string.len(self) == 0

    // Materialize this rooted slice view as an owned String.
    pub fn to_string(self: &str) -> unique String:
        string.to_string(self)
