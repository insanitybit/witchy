// The witchy standard string library. Like `list`, it is pure: it declares no
// capability parameters, so importing it grants no authority. The primitive
// string operations (`split`, `replace`, `contains`, `to_upper`, ...) are
// builtins; these are the conveniences built on top of them.

import option

// Join a list of strings with a separator between each.
// --- Native primitives (intercepted by both backends; self-recursive
// placeholder bodies give the type checker the signatures). ---

// The string's length in BYTES (UTF-8). For user-perceived characters, see
// `char_count`.
pub fn length(s: String) -> Int:
    string.length(s)

// The number of Unicode scalar values.
pub fn char_count(s: String) -> Int:
    string.char_count(s)

// The characters, each as a single-character String — one O(n) pass, so
// callers can index characters in O(1).
pub fn chars(s: String) -> List(String):
    string.chars(s)

// The single character (as a String) for a Unicode scalar value — the inverse
// of reading a code point. An out-of-range or surrogate value yields U+FFFD
// (the replacement character), never an error. Powers the JSON `\u` decoder.
pub fn from_code(code: Int) -> String:
    string.from_code(code)

// Split on every occurrence of `sep`.
pub fn split(s: String, sep: String) -> List(String):
    string.split(s, sep)

// Whether `needle` occurs in `s`.
pub fn contains(s: String, needle: String) -> Bool:
    string.contains(s, needle)

pub fn starts_with(s: String, prefix: String) -> Bool:
    string.starts_with(s, prefix)

pub fn ends_with(s: String, suffix: String) -> Bool:
    string.ends_with(s, suffix)

// The byte index of the first occurrence of `needle`, or -1.
pub fn index_of(s: String, needle: String) -> Int:
    string.index_of(s, needle)

// Replace every occurrence of `from` with `to`.
pub fn replace(s: String, from: String, to: String) -> String:
    string.replace(s, from, to)

// The substring from byte `start` (inclusive) to `end` (exclusive).
pub fn substring(s: String, start: Int, end: Int) -> String:
    string.substring(s, start, end)

// ASCII case mapping (the portable set both backends share).
pub fn to_upper(s: String) -> String:
    string.to_upper(s)

pub fn to_lower(s: String) -> String:
    string.to_lower(s)

// Strip leading and trailing ASCII whitespace.
pub fn trim(s: String) -> String:
    string.trim(s)

// Parse a decimal integer; junk, overflow, or an empty string ABORTS the
// program (a runtime error, not an `Err`) on every backend. For the total
// version that returns `Option(Int)`, see `parse_int`.
pub fn to_int(s: String) -> Int:
    string.to_int(s)

pub fn join(parts: List(String), sep: String) -> String:
    var s = ""
    var first = true
    for p in parts:
        if first:
            s = p
            first = false
        else:
            s = s + sep + p
    s

// Repeat a string `n` times.
pub fn repeat(s: String, n: Int) -> String:
    var out = ""
    var i = 0
    while i < n:
        out = out + s
        i = i + 1
    out

// Left-pad `s` with copies of `fill` until it is `width` characters wide.
// The padding is trimmed to fit exactly, so any fill width yields a result of
// exactly `width` chars; `s` is returned unchanged when already that long.
pub fn pad_left(s: String, width: Int, fill: String) -> String:
    let len = string.char_count(s)
    if len >= width:
        s
    else:
        let needed = width - len
        string.substring(repeat(fill, needed), 0, needed) + s

// Right-pad `s` with copies of `fill` until it is `width` characters wide.
pub fn pad_right(s: String, width: Int, fill: String) -> String:
    let len = string.char_count(s)
    if len >= width:
        s
    else:
        let needed = width - len
        s + string.substring(repeat(fill, needed), 0, needed)

// Center `s` in a field `width` characters wide, padding both sides with `fill`;
// an odd remainder goes on the right. `s` is returned unchanged when already at
// least that wide.
pub fn center(s: String, width: Int, fill: String) -> String:
    let len = string.char_count(s)
    if len >= width:
        s
    else:
        let total = width - len
        let left = total / 2
        let right = total - left
        string.substring(repeat(fill, left), 0, left) + s + string.substring(repeat(fill, right), 0, right)

// Remove `prefix` from the front of `s` when present; otherwise return `s`
// unchanged. The complement of the `starts_with` builtin.
pub fn strip_prefix(s: String, prefix: String) -> String:
    if string.starts_with(s, prefix):
        string.substring(s, string.length(prefix), string.length(s))
    else:
        s

// Remove `suffix` from the end of `s` when present; otherwise return `s`
// unchanged. The complement of the `ends_with` builtin.
pub fn strip_suffix(s: String, suffix: String) -> String:
    if string.ends_with(s, suffix):
        string.substring(s, 0, string.length(s) - string.length(suffix))
    else:
        s

// The single character at character index `i` (counted by Unicode scalar), or
// "" when `i` is out of range. A readable shorthand over `substring`.
pub fn char_at(s: String, i: Int) -> String:
    string.substring(s, i, i + 1)

// Whether the string has no characters.
pub fn is_empty(s: String) -> Bool:
    string.length(s) == 0

// The string with its characters in reverse order. Counted by Unicode scalar
// (via `char_count`/`substring`), so multi-byte characters stay intact:
// `reverse("café")` is `"éfac"`.
pub fn reverse(s: String) -> String:
    var out = ""
    var i = string.char_count(s) - 1
    while i >= 0:
        out = out + string.substring(s, i, i + 1)
        i = i - 1
    out

// The first `n` characters (the whole string if it is shorter, "" if n <= 0).
pub fn take(s: String, n: Int) -> String:
    string.substring(s, 0, n)

// All characters after the first `n` ("" if n covers the whole string).
pub fn drop(s: String, n: Int) -> String:
    string.substring(s, n, string.char_count(s))

// The number of non-overlapping occurrences of `sub` in `s` (0 for an empty
// `sub`). After each match the search resumes past it.
pub fn count(s: String, sub: String) -> Int:
    if string.char_count(sub) == 0:
        0
    else:
        var total = 0
        var rest = s
        var i = string.index_of(rest, sub)
        while i >= 0:
            total = total + 1
            rest = string.substring(rest, i + string.char_count(sub), string.char_count(rest))
            i = string.index_of(rest, sub)
        total

// The whitespace-separated words of `text`: tabs, newlines, and carriage
// returns are treated as spaces, and empty pieces (from runs of whitespace) are
// dropped. `words("the  quick\tfox")` is `["the", "quick", "fox"]`.
pub fn words(text: String) -> List(String):
    let a = string.replace(text, "\t", " ")
    let b = string.replace(a, "\n", " ")
    let c = string.replace(b, "\r", " ")
    var out = []
    for w in string.split(c, " "):
        if string.length(w) > 0:
            out = list.push(out, w)
    out

// Replace only the first occurrence of `from` with `to`; return `s` unchanged
// when `from` is absent. (The `replace` builtin replaces every occurrence.)
pub fn replace_first(s: String, from: String, to: String) -> String:
    let i = string.index_of(s, from)
    if i < 0:
        s
    else:
        string.substring(s, 0, i) + to + string.substring(s, i + string.char_count(from), string.char_count(s))

// Split at the first occurrence of `sep` into `(before, after)`, with `sep`
// itself dropped. When `sep` is absent, returns `(s, "")`. Handy for parsing
// `key=value` or `host:port`. Counted by Unicode scalar.
pub fn split_once(s: String, sep: String) -> (String, String):
    let i = string.index_of(s, sep)
    if i < 0:
        (s, "")
    else:
        (string.substring(s, 0, i), string.substring(s, i + string.char_count(sep), string.char_count(s)))

// The index of the LAST occurrence of `sep` in `s`, or -1 when absent (and -1
// for an empty `sep`). The right-to-left companion of the `index_of` builtin.
pub fn last_index_of(s: String, sep: String) -> Int:
    if string.length(sep) == 0:
        0 - 1
    else:
        var last = 0 - 1
        var base = 0
        var rest = s
        var i = string.index_of(rest, sep)
        while i >= 0:
            last = base + i
            base = base + i + string.char_count(sep)
            rest = string.substring(rest, i + string.char_count(sep), string.char_count(rest))
            i = string.index_of(rest, sep)
        last

// Split on the LAST occurrence of `sep` (e.g. a file extension): `rsplit_once`
// of `"a.b.c"` on `"."` is `("a.b", "c")`. When `sep` is absent the whole string
// is the right part: `("", s)` — mirroring `split_once`'s `(s, "")`.
pub fn rsplit_once(s: String, sep: String) -> (String, String):
    let i = last_index_of(s, sep)
    if i < 0:
        ("", s)
    else:
        (string.substring(s, 0, i), string.substring(s, i + string.char_count(sep), string.char_count(s)))

// Safely parse a base-10 integer: an optional leading `-`/`+` then one or more
// digits. Returns None for empty, sign-only, or non-digit input — so it never
// traps on bad input the way the raw `string_to_int` builtin can.
pub fn parse_int(s: String) -> Option(Int):
    let n = string.char_count(s)
    if n == 0:
        None
    else:
        var start = 0
        let first = char_at(s, 0)
        if first == "-" || first == "+":
            start = 1
        if start >= n:
            None
        else:
            var i = start
            var ok = true
            while i < n:
                let c = char_at(s, i)
                if c < "0" || c > "9":
                    ok = false
                i = i + 1
            if ok:
                Some(string.to_int(s))
            else:
                None

// Split text into its newline-separated lines.
pub fn lines(text: String) -> List(String):
    string.split(text, "\n")

// Whether `c` is an ASCII whitespace character (space, tab, newline, return).
fn is_space(c: String) -> Bool:
    c == " " || c == "\t" || c == "\n" || c == "\r"

// Remove leading whitespace.
pub fn trim_start(s: String) -> String:
    var i = 0
    let n = string.char_count(s)
    while i < n && is_space(char_at(s, i)):
        i = i + 1
    string.substring(s, i, n)

// Remove trailing whitespace.
pub fn trim_end(s: String) -> String:
    var j = string.char_count(s)
    while j > 0 && is_space(char_at(s, j - 1)):
        j = j - 1
    string.substring(s, 0, j)
