// The witchy standard string library. Like `list`, it is pure: it declares no
// capability parameters, so importing it grants no authority. The primitive
// string operations (`split`, `replace`, `contains`, `to_upper`, ...) are
// builtins; these are the conveniences built on top of them.

import option
import list

// --- Native primitives (intercepted by both backends; self-recursive
// placeholder bodies give the type checker the signatures). These must exist
// as module-level functions because the intrinsic interception resolves by
// the qualified name `string.X`. The impl methods below delegate to these. ---
pub fn length(s: String) -> Int:
    string.length(s)

pub fn char_count(s: String) -> Int:
    string.char_count(s)

pub fn chars(s: String) -> List(String):
    string.chars(s)

pub fn from_code(code: Int) -> String:
    string.from_code(code)

pub fn split(s: String, sep: String) -> List(String):
    string.split(s, sep)

pub fn contains(s: String, needle: String) -> Bool:
    string.contains(s, needle)

pub fn starts_with(s: String, prefix: String) -> Bool:
    string.starts_with(s, prefix)

pub fn ends_with(s: String, suffix: String) -> Bool:
    string.ends_with(s, suffix)

pub fn replace(s: String, from: String, to: String) -> String:
    string.replace(s, from, to)

pub fn substring(s: String, start: Int, end: Int) -> String:
    string.substring(s, start, end)

pub fn as_str(s: &'a String) -> &'a str:
    string.as_str(s)

pub fn slice(s: &'a str, start: Int, end: Int) -> &'a str:
    string.slice(s, start, end)

pub fn to_string(s: &'a str) -> String:
    string.to_string(s)

pub fn len(s: &'a str) -> Int:
    string.len(s)

pub fn to_upper(s: String) -> String:
    string.to_upper(s)

pub fn to_lower(s: String) -> String:
    string.to_lower(s)

pub fn trim(s: String) -> String:
    string.trim(s)

pub fn to_int(s: String) -> Int:
    string.to_int(s)

// --- Private helpers ---

// The raw search intrinsic (char index of the first occurrence, or -1). Private:
// public callers use `index_of` (Option) or `contains` (Bool); the std internals
// below use it directly for tight scan loops where the -1 test is the condition.
fn find(s: String, needle: String) -> Int:
    string.find(s, needle)

// The raw last-occurrence index (or -1). Private: public callers use
// `last_index_of` (Option); the std internals here take the raw index directly.
fn rfind(s: String, sep: String) -> Int:
    if string.length(sep) == 0:
        0 - 1
    else:
        var last = 0 - 1
        var base = 0
        var rest = s
        var i = find(rest, sep)
        while i >= 0:
            last = base + i
            base = base + i + string.char_count(sep)
            rest = string.substring(rest, i + string.char_count(sep), string.char_count(rest))
            i = find(rest, sep)
        last

// The raw character at `i`, or "" out of range (the clamping `substring` view).
// Private: the std internals below index with an already-bounds-checked `i`, so
// the Option would be pure overhead; public callers use `char_at`.
fn char_or_empty(s: String, i: Int) -> String:
    string.substring(s, i, i + 1)

// Whether `c` is an ASCII whitespace character (space, tab, newline, return).
fn is_space(c: String) -> Bool:
    c == " " || c == "\t" || c == "\n" || c == "\r"

// --- impl String: all operations as methods ---
impl String:
    // The string's length in BYTES (UTF-8). For user-perceived characters, see
    // `char_count`.
    pub fn length(self) -> Int:
        string.length(self)

    // The number of Unicode scalar values.
    pub fn char_count(self) -> Int:
        string.char_count(self)

    // The characters, each as a single-character String - one O(n) pass, so
    // callers can index characters in O(1).
    pub fn chars(self) -> List(String):
        string.chars(self)

    // Split on every occurrence of `sep`.
    pub fn split(self, sep: String) -> List(String):
        string.split(self, sep)

    // Whether `needle` occurs in `self`.
    pub fn contains(self, needle: String) -> Bool:
        string.contains(self, needle)

    pub fn starts_with(self, prefix: String) -> Bool:
        string.starts_with(self, prefix)

    pub fn ends_with(self, suffix: String) -> Bool:
        string.ends_with(self, suffix)

    // The character index (counted by Unicode scalar) of the first occurrence of
    // `needle` as `Some`, or `None` when `needle` does not occur (RFC-0044 rule 1:
    // absence is `Option`, never a -1 sentinel). An empty `needle` matches nothing
    // (the module-wide empty-pattern rule, matching `last_index_of`/`count`). For
    // a bare yes/no, use `contains`.
    pub fn index_of(self, needle: String) -> Option(Int):
        let i = if needle.is_empty(): 0 - 1 else: find(self, needle)
        if i < 0:
            None
        else:
            Some(i)

    // Replace every occurrence of `from` with `to`.
    pub fn replace(self, from: String, to: String) -> String:
        string.replace(self, from, to)

    // The substring from character index `start` (inclusive) to `end` (exclusive),
    // counted by Unicode scalar; out-of-range indices clamp.
    pub fn substring(self, start: Int, end: Int) -> String:
        string.substring(self, start, end)

    // Return a borrowed view of this String as a string slice (`&'a str`).
    pub fn as_str(self: &'a String) -> &'a str:
        string.as_str(self)

    // ASCII case mapping (the portable set both backends share).
    pub fn to_upper(self) -> String:
        string.to_upper(self)

    pub fn to_lower(self) -> String:
        string.to_lower(self)

    // Strip leading and trailing ASCII whitespace.
    pub fn trim(self) -> String:
        string.trim(self)

    // Remove leading whitespace.
    pub fn trim_start(self) -> String:
        var i = 0
        let n = string.char_count(self)
        while i < n && is_space(char_or_empty(self, i)):
            i = i + 1
        string.substring(self, i, n)

    // Remove trailing whitespace.
    pub fn trim_end(self) -> String:
        var j = string.char_count(self)
        while j > 0 && is_space(char_or_empty(self, j - 1)):
            j = j - 1
        string.substring(self, 0, j)

    // Parse a decimal integer; junk, overflow, or an empty string ABORTS the
    // program (a runtime error, not an `Err`) on every backend. For the total
    // version that returns `Option(Int)`, see `parse_int`.
    pub fn to_int(self) -> Int:
        string.to_int(self)

    // Repeat a string `n` times.
    pub fn repeat(self, n: Int) -> String:
        var out = ""
        var i = 0
        while i < n:
            out = out + self
            i = i + 1
        out

    // Left-pad `self` with copies of `fill` until it is `width` characters wide.
    // The padding is trimmed to fit exactly, so any non-empty fill yields a result
    // of exactly `width` chars; `self` is returned unchanged when already that long.
    // An empty `fill` can never reach the promised width, so when padding is
    // needed it fails loudly (RFC-0044 rule 3) instead of returning a short string.
    pub fn pad_left(self, width: Int, fill: String) -> String:
        let len = string.char_count(self)
        if len >= width:
            self
        else:
            if fill.is_empty():
                fail("string.pad_left: empty `fill` cannot pad to width ${width}")
            let needed = width - len
            string.substring(fill.repeat(needed), 0, needed) + self

    // Right-pad `self` with copies of `fill` until it is `width` characters wide; an
    // empty `fill` fails loudly when padding is needed (see `pad_left`).
    pub fn pad_right(self, width: Int, fill: String) -> String:
        let len = string.char_count(self)
        if len >= width:
            self
        else:
            if fill.is_empty():
                fail("string.pad_right: empty `fill` cannot pad to width ${width}")
            let needed = width - len
            self + string.substring(fill.repeat(needed), 0, needed)

    // Center `self` in a field `width` characters wide, padding both sides with `fill`;
    // an odd remainder goes on the right. `self` is returned unchanged when already at
    // least that wide; an empty `fill` fails loudly when padding is needed (see
    // `pad_left`).
    pub fn center(self, width: Int, fill: String) -> String:
        let len = string.char_count(self)
        if len >= width:
            self
        else:
            if fill.is_empty():
                fail("string.center: empty `fill` cannot pad to width ${width}")
            let total = width - len
            let left = total / 2
            let right = total - left
            string.substring(fill.repeat(left), 0, left) + self + string.substring(fill.repeat(right), 0, right)

    // Remove `prefix` from the front of `self` when present; otherwise return `self`
    // unchanged. The complement of the `starts_with` builtin.
    pub fn strip_prefix(self, prefix: String) -> String:
        if string.starts_with(self, prefix):
            string.substring(self, string.char_count(prefix), string.char_count(self))
        else:
            self

    // Remove `suffix` from the end of `self` when present; otherwise return `self`
    // unchanged. The complement of the `ends_with` builtin.
    pub fn strip_suffix(self, suffix: String) -> String:
        if string.ends_with(self, suffix):
            string.substring(self, 0, string.char_count(self) - string.char_count(suffix))
        else:
            self

    // The single character (as a String) at character index `i` (counted by Unicode
    // scalar) as `Some`, or `None` when `i` is out of range (RFC-0044 rule 1:
    // absence is `Option`, never a "" sentinel). For a clamping view use `substring`.
    pub fn char_at(self, i: Int) -> Option(String):
        if i >= 0 && i < string.char_count(self):
            Some(string.substring(self, i, i + 1))
        else:
            None

    // Whether the string has no characters.
    pub fn is_empty(self) -> Bool:
        string.length(self) == 0

    // The string with its characters in reverse order. Counted by Unicode scalar
    // (via `char_count`/`substring`), so multi-byte characters stay intact:
    // `reverse("café")` is `"éfac"`.
    pub fn reverse(self) -> String:
        var out = ""
        var i = string.char_count(self) - 1
        while i >= 0:
            out = out + string.substring(self, i, i + 1)
            i = i - 1
        out

    // The first `n` characters (the whole string if it is shorter, "" if n <= 0).
    pub fn take(self, n: Int) -> String:
        string.substring(self, 0, n)

    // All characters after the first `n` ("" if n covers the whole string).
    pub fn drop(self, n: Int) -> String:
        string.substring(self, n, string.char_count(self))

    // The number of non-overlapping occurrences of `sub` in `self` (0 for an empty
    // `sub`). After each match the search resumes past it.
    pub fn count(self, sub: String) -> Int:
        if string.char_count(sub) == 0:
            0
        else:
            var total = 0
            var rest = self
            var i = find(rest, sub)
            while i >= 0:
                total = total + 1
                rest = string.substring(rest, i + string.char_count(sub), string.char_count(rest))
                i = find(rest, sub)
            total

    // The whitespace-separated words of `self`: tabs, newlines, and carriage
    // returns are treated as spaces, and empty pieces (from runs of whitespace) are
    // dropped. `"the  quick\tfox".words()` is `["the", "quick", "fox"]`.
    pub fn words(self) -> List(String):
        let a = string.replace(self, "\t", " ")
        let b = string.replace(a, "\n", " ")
        let c = string.replace(b, "\r", " ")
        var out = []
        for w in string.split(c, " "):
            if string.length(w) > 0:
                list.push(out, w)
        out

    // Replace only the first occurrence of `from` with `to`; return `self` unchanged
    // when `from` is absent. An empty `from` matches nothing (the module-wide
    // empty-pattern rule: `count`/`index_of`/`last_index_of` treat it as absent).
    // (The `replace` builtin replaces every occurrence.)
    pub fn replace_first(self, from: String, to: String) -> String:
        let i = if from.is_empty(): 0 - 1 else: find(self, from)
        if i < 0:
            self
        else:
            string.substring(self, 0, i) + to + string.substring(self, i + string.char_count(from), string.char_count(self))

    // Split at the first occurrence of `sep` into `Some((before, after))`, with
    // `sep` itself dropped. Returns `None` when `sep` is absent or empty, so parsing
    // code can distinguish a missing separator from a present separator with an empty
    // side (`"host"` vs `"host:"`). Counted by Unicode scalar.
    pub fn split_once_opt(self, sep: String) -> Option((String, String)):
        let i = if sep.is_empty(): 0 - 1 else: find(self, sep)
        if i < 0:
            None
        else:
            Some((string.substring(self, 0, i), string.substring(self, i + string.char_count(sep), string.char_count(self))))

    // Split at the first occurrence of `sep` into `(before, after)`, with `sep`
    // itself dropped. Compatibility wrapper: when `sep` is absent - including the
    // empty separator, which matches nothing (mirroring `rsplit_once`) - returns
    // `(s, "")`. Prefer `split_once_opt` for parsers and validators that need to
    // distinguish absence from a present empty side. Counted by Unicode scalar.
    pub fn split_once(self, sep: String) -> (String, String):
        match self.split_once_opt(sep):
            Some(parts) -> parts
            None -> (self, "")

    // The character index of the LAST occurrence of `sep` in `self` as `Some`, or
    // `None` when absent or `sep` is empty (RFC-0044 rule 1: absence is `Option`,
    // never -1). The right-to-left companion of `index_of`.
    pub fn last_index_of(self, sep: String) -> Option(Int):
        let i = rfind(self, sep)
        if i < 0:
            None
        else:
            Some(i)

    // Split on the LAST occurrence of `sep` into `Some((before, after))`, with `sep`
    // itself dropped. Returns `None` when `sep` is absent or empty.
    pub fn rsplit_once_opt(self, sep: String) -> Option((String, String)):
        let i = rfind(self, sep)
        if i < 0:
            None
        else:
            Some((string.substring(self, 0, i), string.substring(self, i + string.char_count(sep), string.char_count(self))))

    // Split on the LAST occurrence of `sep` (e.g. a file extension): `rsplit_once`
    // of `"a.b.c"` on `"."` is `("a.b", "c")`. Compatibility wrapper: when `sep`
    // is absent the whole string is the right part: `("", s)` - mirroring
    // `split_once`'s `(s, "")`. Prefer `rsplit_once_opt` when absence matters.
    pub fn rsplit_once(self, sep: String) -> (String, String):
        match self.rsplit_once_opt(sep):
            Some(parts) -> parts
            None -> ("", self)

    // Safely parse a base-10 integer: an optional leading `-`/`+` then one or more
    // digits. Returns None for empty, sign-only, non-digit, or out-of-range (beyond
    // the i64 range) input - so it never traps the way the raw `string_to_int`
    // builtin can.
    pub fn parse_int(self) -> Option(Int):
        let n = string.char_count(self)
        if n == 0:
            None
        else:
            var start = 0
            let first = char_or_empty(self, 0)
            let neg = first == "-"
            if first == "-" || first == "+":
                start = 1
            if start >= n:
                None
            else:
                var i = start
                var ok = true
                while i < n:
                    let c = char_or_empty(self, i)
                    if c < "0" || c > "9":
                        ok = false
                    i = i + 1
                if ok == false:
                    None
                else:
                    var j = start
                    while j < n - 1 && char_or_empty(self, j) == "0":
                        j = j + 1
                    let mag = string.substring(self, j, n)
                    let mlen = string.char_count(mag)
                    let limit = if neg: "9223372036854775808" else: "9223372036854775807"
                    if mlen > 19 || mlen == 19 && mag > limit:
                        None
                    else:
                        Some(string.to_int(self))

    // Split text into its newline-separated lines.
    pub fn lines(self) -> List(String):
        string.split(self, "\n")

// --- impl str: string slice methods ---
impl str:
    // The string slice's length in BYTES (UTF-8).
    pub fn len(self: &'a str) -> Int:
        string.len(self)

    // The string slice's length in BYTES (UTF-8).
    pub fn length(self: &'a str) -> Int:
        string.len(self)

    // The number of Unicode scalar values in this slice.
    pub fn char_count(self: &'a str) -> Int:
        string.to_string(self).char_count()

    // The sub-slice from character index `start` (inclusive) to `end` (exclusive),
    // counted by Unicode scalar; out-of-range indices clamp.
    pub fn slice(self: &'a str, start: Int, end: Int) -> &'a str:
        string.slice(self, start, end)

    // Whether the string slice has no characters.
    pub fn is_empty(self: &'a str) -> Bool:
        string.len(self) == 0

    // Convert this borrowed slice into an owned String.
    pub fn to_string(self: &'a str) -> String:
        string.to_string(self)
