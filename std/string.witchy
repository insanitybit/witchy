// The witchy standard string library. Like `list`, it is pure: it declares no
// capability parameters, so importing it grants no authority. The primitive
// string operations (`split`, `replace`, `contains`, `to_upper`, ...) are
// builtins; these are the conveniences built on top of them.

// Join a list of strings with a separator between each.
pub fn join(parts: List(String), sep: String) -> String {
  var s = ""
  var first = true
  for p in parts {
    if first {
      s = p
      first = false
    } else {
      s = s <> sep <> p
    }
  }
  s
}

// Repeat a string `n` times.
pub fn repeat(s: String, n: Int) -> String {
  var out = ""
  var i = 0
  while i < n {
    out = out <> s
    i = i + 1
  }
  out
}

// Left-pad `s` with copies of `fill` until it is `width` characters wide.
// The padding is trimmed to fit exactly, so any fill width yields a result of
// exactly `width` chars; `s` is returned unchanged when already that long.
pub fn pad_left(s: String, width: Int, fill: String) -> String {
  let len = string_length(s)
  if len >= width {
    s
  } else {
    let needed = width - len
    substring(repeat(fill, needed), 0, needed) <> s
  }
}

// Right-pad `s` with copies of `fill` until it is `width` characters wide.
pub fn pad_right(s: String, width: Int, fill: String) -> String {
  let len = string_length(s)
  if len >= width {
    s
  } else {
    let needed = width - len
    s <> substring(repeat(fill, needed), 0, needed)
  }
}

// Remove `prefix` from the front of `s` when present; otherwise return `s`
// unchanged. The complement of the `starts_with` builtin.
pub fn strip_prefix(s: String, prefix: String) -> String {
  if starts_with(s, prefix) {
    substring(s, string_length(prefix), string_length(s))
  } else {
    s
  }
}

// Remove `suffix` from the end of `s` when present; otherwise return `s`
// unchanged. The complement of the `ends_with` builtin.
pub fn strip_suffix(s: String, suffix: String) -> String {
  if ends_with(s, suffix) {
    substring(s, 0, string_length(s) - string_length(suffix))
  } else {
    s
  }
}

// The single character at character index `i` (counted by Unicode scalar), or
// "" when `i` is out of range. A readable shorthand over `substring`.
pub fn char_at(s: String, i: Int) -> String {
  substring(s, i, i + 1)
}

// Whether the string has no characters.
pub fn is_empty(s: String) -> Bool {
  string_length(s) == 0
}

// The number of non-overlapping occurrences of `sub` in `s` (0 for an empty
// `sub`). After each match the search resumes past it.
pub fn count(s: String, sub: String) -> Int {
  if string_length(sub) == 0 {
    0
  } else {
    var total = 0
    var rest = s
    var i = index_of(rest, sub)
    while i >= 0 {
      total = total + 1
      rest = substring(rest, i + string_length(sub), string_length(rest))
      i = index_of(rest, sub)
    }
    total
  }
}

// Split text into its newline-separated lines.
pub fn lines(text: String) -> List(String) {
  split(text, "\n")
}
