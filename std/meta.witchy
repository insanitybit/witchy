// Compile-time type introspection — the `typeInfo` half of witchy's comptime
// reflection (Zig's `@typeInfo`). A `comptime:` block can read the structure of
// every type in its module as ordinary data and generate code from it (e.g. a
// `to_json` specialized to a record's fields), with zero runtime cost. The
// compiler injects the type list as `module_types()`; these are the shapes it
// hands you.
//
// This is COMPILE-TIME structure (field names + declared type names as strings),
// distinct from `std/reflect`'s runtime `Mirror` (a value's structure at runtime).

import string

// One field of a record: its name and its declared type rendered as a string
// (e.g. "Int", "List(String)", "Option(Point)").
type FieldInfo:
    name: String
    type_name: String

// One constructor of a sum type: its name and its positional payload types.
type VariantInfo:
    name: String
    field_types: List(String)

// A type's structure. `kind` is "record" (one constructor with named fields),
// "sum" (one or more positional constructors), or "unit". `fields` is populated
// for records, `variants` for sums.
type TypeInfo:
    name: String
    kind: String
    params: List(String)
    fields: List(FieldInfo)
    variants: List(VariantInfo)

// --- built-in derive generators ----------------------------------------------
// `derive(X)` desugars to a comptime call `meta.derive_<x>(typeInfo)` that returns
// the impl source. These ARE witchy — the per-trait code generation that used to be
// hardcoded in the Rust compiler now lives here as ordinary, readable functions over
// `TypeInfo`, and anyone can write their own `derive_foo` the same way.

// The impl target with its type parameters — `Box(a)` for a generic type, `Point`
// otherwise. Also the type of a same-typed `other` parameter.
fn target_with_params(t: TypeInfo) -> String:
    if list.is_empty(t.params):
        t.name
    else:
        t.name + "(" + string.join(t.params, ", ") + ")"

// A ` where a: Trait, b: Trait` clause binding each type parameter to `trait_name`,
// or "" for a non-generic type — so a generic type's derived impl discharges its
// parameters' bounds and monomorphizes per argument.
fn where_each(params: List(String), trait_name: String) -> String:
    if list.is_empty(params):
        ""
    else:
        var bounds = []
        for p in params:
            bounds = list.push(bounds, p + ": " + trait_name)
        " where " + string.join(bounds, ", ")

// `derive(Show)` → structural rendering via the `__render` builtin.
pub fn derive_show(t: TypeInfo) -> String:
    "impl Show for " + target_with_params(t) + where_each(t.params, "Show") + ":\n    fn show(self) -> String:\n        __render(self)\n"

// `derive(Eq)` → the total-equality marker. Refines `PartialEq` (derive both).
pub fn derive_eq(t: TypeInfo) -> String:
    "impl Eq for " + target_with_params(t) + where_each(t.params, "Eq") + "\n"

// `derive(PartialEq)` → field-wise structural equality. The operators dispatch
// per field, so it is content-correct on both backends: a record compares each
// field with `==`; a sum type matches the variant and compares payloads.
pub fn derive_partial_eq(t: TypeInfo) -> String:
    let head = "impl PartialEq for " + target_with_params(t) + where_each(t.params, "PartialEq") + ":\n    fn eq(self, other: " + target_with_params(t) + ") -> Bool:\n"
    if t.kind == "record":
        head + "        " + record_eq_body(t.fields) + "\n"
    else:
        var arms = []
        for v in t.variants:
            arms = list.push(arms, variant_eq_arm(v))
        head + "        match self:\n" + string.join(arms, "\n") + "\n"

// The `&&`-chained field comparison of a record's `eq`, or `true` for a unit.
fn record_eq_body(fields: List(FieldInfo)) -> String:
    if list.is_empty(fields):
        "true"
    else:
        var terms = []
        for f in fields:
            terms = list.push(terms, "self." + f.name + " == other." + f.name)
        string.join(terms, " && ")

// One arm of a sum type's `eq`: match `other` against the same variant, compare
// payloads pairwise, and fail on any other variant.
fn variant_eq_arm(v: VariantInfo) -> String:
    var pats = []
    var opats = []
    var terms = []
    var i = 0
    for ft in v.field_types:
        pats = list.push(pats, "p${i}")
        opats = list.push(opats, "o${i}")
        terms = list.push(terms, "p${i} == o${i}")
        i = i + 1
    var selfpat = v.name
    var otherpat = v.name
    if list.length(pats) > 0:
        selfpat = v.name + "(" + string.join(pats, ", ") + ")"
        otherpat = v.name + "(" + string.join(opats, ", ") + ")"
    var rhs = "true"
    if list.length(terms) > 0:
        rhs = string.join(terms, " && ")
    "            " + selfpat + " -> match other:\n                " + otherpat + " -> " + rhs + "\n                _ -> false"

// The `reflect`-call for a field/payload of declared type `type_name` applied to
// the expression text `value` — single-line, dispatched by the type's shape.
fn reflect_call(type_name: String, value: String) -> String:
    if string.starts_with(type_name, "List("):
        "reflect_list(" + value + ")"
    else if string.starts_with(type_name, "Option("):
        "reflect_option(" + value + ")"
    else:
        "reflect_one(" + value + ")"

// `derive(Reflect)` → an `impl Reflect for T` building the value's `Mirror`: a
// record to `MRecord("T", [(field, reflect field)…])`, a sum type to a `match`
// over variants to `MVariant`. (The module must `import reflect`; caller checks.)
pub fn derive_reflect(t: TypeInfo) -> String:
    let head = "impl Reflect for " + target_with_params(t) + where_each(t.params, "Reflect") + ":\n    fn reflect(self) -> Mirror:\n"
    if t.kind == "record":
        var pairs = []
        for f in t.fields:
            pairs = list.push(pairs, "(\"" + f.name + "\", " + reflect_call(f.type_name, "self." + f.name) + ")")
        head + "        MRecord(\"" + t.name + "\", [" + string.join(pairs, ", ") + "])\n"
    else:
        var arms = []
        for v in t.variants:
            var pats = []
            var refls = []
            var i = 0
            for ft in v.field_types:
                let pv = "p${i}"
                pats = list.push(pats, pv)
                refls = list.push(refls, reflect_call(ft, pv))
                i = i + 1
            var pat = v.name
            if list.length(pats) > 0:
                pat = v.name + "(" + string.join(pats, ", ") + ")"
            arms = list.push(arms, "            " + pat + " -> MVariant(\"" + t.name + "\", \"" + v.name + "\", [" + string.join(refls, ", ") + "])")
        head + "        match self:\n" + string.join(arms, "\n") + "\n"

// The lexicographic if/else chain shared by `derive(Ord)` and `derive(PartialOrd)`:
// compare fields in declaration order via the operators (which dispatch to each
// field type's impl), yielding `lt`/`gt`/`eq` (wrapped in `Some` for the partial
// variant).
fn lexicographic_body(fields: List(FieldInfo), lt: String, gt: String, eq: String) -> String:
    var arms = []
    for f in fields:
        arms = list.push(arms, "self." + f.name + " < other." + f.name + ": " + lt)
        arms = list.push(arms, "self." + f.name + " > other." + f.name + ": " + gt)
    var body = ""
    var first = true
    for a in arms:
        if first:
            body = body + "        if " + a + "\n"
            first = false
        else:
            body = body + "        else if " + a + "\n"
    body + "        else: " + eq + "\n"

// `derive(Ord)` → lexicographic `compare` returning `Ordering` (records only; the
// caller validates the shape). Requires the `PartialEq`/`Eq`/`PartialOrd` impls too.
pub fn derive_ord(t: TypeInfo) -> String:
    "impl Ord for " + target_with_params(t) + where_each(t.params, "Ord") + ":\n    fn compare(self, other: " + target_with_params(t) + ") -> Ordering:\n" + lexicographic_body(t.fields, "Less", "Greater", "Equal")

// `derive(PartialOrd)` → lexicographic `partial_compare` (records only).
pub fn derive_partial_ord(t: TypeInfo) -> String:
    "impl PartialOrd for " + target_with_params(t) + where_each(t.params, "PartialOrd") + ":\n    fn partial_compare(self, other: " + target_with_params(t) + ") -> Option(Ordering):\n" + lexicographic_body(t.fields, "Some(Less)", "Some(Greater)", "Some(Equal)")

// The element type inside `List(X)` / `Option(X)` — `after_prefix("List(String)",
// "List(")` is "String" (strips the prefix and the trailing ")").
fn after_prefix(s: String, prefix: String) -> String:
    string.substring(s, string.char_count(prefix), string.char_count(s) - 1)

// A `Result`-producing decode of a `Json` value already in hand (recursive).
fn json_decode_value(ty: String, value: String) -> String:
    if ty == "Int":
        "json.int_of(" + value + ")"
    else if ty == "Float":
        "json.float_of(" + value + ")"
    else if ty == "Bool":
        "json.bool_of(" + value + ")"
    else if ty == "String":
        "json.string_of(" + value + ")"
    else if string.starts_with(ty, "List("):
        let elem = after_prefix(ty, "List(")
        "result.all(list.map(json.array_of(" + value + ")?, fn(__e: Json): " + json_decode_value(elem, "__e") + "))"
    else:
        ty + ".from_json(" + value + ")"

// Decode one record field from the object `j`: an Option reads with `get` (absent
// allowed), everything else with `require`. Trails a `?` so it's a `let` initializer.
fn json_decode_field(ty: String, key: String) -> String:
    if string.starts_with(ty, "Option("):
        let elem = after_prefix(ty, "Option(")
        "json.optional(json.get(j, \"" + key + "\"), fn(__e: Json): " + json_decode_value(elem, "__e") + ")?"
    else:
        json_decode_value(ty, "json.require(j, \"" + key + "\")?") + "?"

// `derive(Deserialize)` generates `from_json` for a record (the caller validates the
// shape). It decodes and coerces each field, returning on the first error. There is
// no matching `Serialize` derive, because reflection (`json.value_of`, `stringify`,
// `Into(Json)`) already encodes any value, so only this reconstruction is per-type.
// The generated code uses only json/result/list/option.
pub fn derive_deserialize(t: TypeInfo) -> String:
    var lets = []
    var names = []
    for f in t.fields:
        lets = list.push(lets, "        let " + f.name + " = " + json_decode_field(f.type_name, f.name) + "\n")
        names = list.push(names, f.name)
    let from_json = "    fn from_json(j: Json) -> Result(Self, String):\n" + string.join(lets, "") + "        Ok(" + t.name + "(" + string.join(names, ", ") + "))\n"
    // The generated body makes module-qualified calls (json.*, list.map, result.all);
    // emitted source is parsed on its own, so it must carry those imports for the
    // parser to qualify them (comptime merges them into the module).
    "import json\nimport list\nimport result\n\nimpl Deserialize for " + t.name + ":\n" + from_json
