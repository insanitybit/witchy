// Compile-time type introspection - the `typeInfo` half of witchy's comptime
// reflection (Zig's `@typeInfo`). A `comptime:` block can read the structure of
// every type in its module as ordinary data and generate code from it (e.g. a
// `to_json` specialized to a record's fields), with zero runtime cost. The
// compiler injects the type list as the `module_types` value; these are the
// shapes it hands you.
//
// This is COMPILE-TIME structure (field names + declared type expressions),
// distinct from `std/reflect`'s runtime `Mirror` (a value's structure at runtime).

// RFC-0080's typed boundary for whole generated items. `quote item:` values
// retain compiler-owned item AST. For an item quote with holes, the compiler
// substitutes typed expression, type, and pattern nodes into that AST.
sealed type ItemSyntax:
    ItemSyntax(String)

// An opaque aggregate of generated items. Keeping the aggregate typed lets
// generators build and transform a whole generated module without flattening
// its items back into source text.
sealed type ModuleSyntax:
    ModuleSyntax(List(ItemSyntax))

// Source spans are compiler-owned metadata. The constructor is sealed so user
// code cannot forge locations; expansion records definition, invocation, and
// hole-ancestry spans for diagnostics and generated-symbol navigation.
sealed type Span:
    Span(String, Int, Int)

// Hole-free `quote type:` values retain a compiler-owned type AST. The
// internal constructor carries an opaque handle and display source. Builders
// resolve the handle to its checked type AST.
sealed type TypeSyntax:
    CompilerTypeSyntax(String, String)

// Hole-free `quote expr:` values retain a compiler-owned expression AST.
sealed type ExprSyntax:
    CompilerExprSyntax(String, String)

// Hole-free `quote pattern:` values retain compiler-owned pattern AST. Existing
// builders compose the checked pattern AST through its opaque handle.
sealed type PatternSyntax:
    CompilerPatternSyntax(String, String)

sealed type SyntaxHole:
    ExprHole(ExprSyntax)
    TypeHole(TypeSyntax)
    PatternHole(PatternSyntax)

// Hole-free `quote stmt:` values retain compiler-owned statement AST.
sealed type StmtSyntax:
    CompilerStmtSyntax(String, String)

// Hole-free `quote block:` values retain compiler-owned block AST.
sealed type BlockSyntax:
    CompilerBlockSyntax(String, String)

sealed type MatchArmSyntax:
    CompilerMatchArmSyntax(String, String)

sealed type ParamSyntax:
    CompilerParamSyntax(String, String)

sealed type Ident:
    Ident(String)
    CallSiteIdent(String)

// A compiler-issued hole in the active tagged literal. The compiler bridge
// constructs this sealed value; tags never receive the hole's source.
sealed type TagHole:
    TagHole(String)

// Attach compiler-approved standard-module imports to an already structural
// item. The item remains sealed and the import set is carried as a compiler
// module fragment; no source is rendered or reparsed.
pub fn item_with_imports(imports: List(String), item_syntax: ItemSyntax) -> ItemSyntax:
    __meta_item_with_imports(imports, item_syntax)

fn __meta_item_with_imports(imports: List(String), item_syntax: ItemSyntax) -> ItemSyntax:
    __meta_item_with_imports(imports, item_syntax)

// A validated Witchy identifier. This rejects keywords, `_`, non-ASCII source
// spelling, and compiler-reserved `__` names before generated source is parsed.
pub fn ident(name: String) -> Ident:
    if !is_identifier(name):
        fail("meta.ident: invalid identifier `" + name + "`")
    Ident(name)

fn internal_ident(name: String) -> Ident:
    if name != "__dynamic_field" && name != "__name":
        fail("meta.internal_ident: unsupported compiler identifier")
    Ident(name)

// An explicit invocation-site reference. The syntax constructor that consumes
// this Ident determines whether it denotes a value/function, type, or
// constructor; the compiler retains that category and origin without rendering
// a forgeable source marker.
pub fn call_site(name: String) -> Ident:
    if !is_identifier(name):
        fail("meta.call_site: expected an identifier, got `" + name + "`")
    CallSiteIdent(name)

// A deterministic compiler-owned binding name. The returned identifier cannot
// collide with source names because its spelling lives in the reserved `__`
// namespace; repeated calls, blocks, and tagged-literal invocations are distinct.
pub fn fresh(hint: String) -> Ident:
    if !is_identifier(hint):
        fail("meta.fresh: invalid identifier hint `" + hint + "`")
    Ident(__meta_fresh_ident(hint))

// Interpreter-owned compile-time hook. Runtime modules cannot mention Ident,
// and the linker limits this private intrinsic to std/meta.
fn __meta_fresh_ident(hint: String) -> String:
    __meta_fresh_ident(hint)

pub fn is_identifier(name: String) -> Bool:
    let n = name.char_count()
    if n == 0 || name == "_" || is_keyword(name) || name.contains("__"):
        false
    else:
        var ok = is_ident_start(name.substring(0, 1))
        var i = 1
        while i < n:
            if !is_ident_continue(name.substring(i, i + 1)):
                ok = false
            i = i + 1
        ok

fn ident_source(id: Ident) -> String:
    match id:
        Ident(source) -> source
        CallSiteIdent(source) -> source

fn expr_ident(id: Ident) -> ExprSyntax:
    match id:
        Ident(source) -> __meta_expr_leaf("name", source)
        CallSiteIdent(source) -> __meta_call_site_expr(source)

// Compiler-owned literal/name construction. The bridge decodes the typed
// payload directly into an Expr node; it never renders and reparses source.
fn __meta_expr_leaf(kind: String, payload: String) -> ExprSyntax:
    __meta_expr_leaf(kind, payload)

// Reify exactly one compiler-issued hole without parsing its source. The
// compiler substitutes its call-site expression after tag expansion.
pub fn expr_tag_hole_typed(hole: TagHole) -> ExprSyntax:
    match hole:
        TagHole(marker) -> __meta_expr_tag_hole(marker)

fn __meta_expr_tag_hole(marker: String) -> ExprSyntax:
    __meta_expr_tag_hole(marker)

// Construct a nested tagged literal from validated tag identity, static parts,
// and compiler-owned expression handles. The bridge stores an owned AST; it
// never concatenates or reparses source. `parts` must have exactly one more
// member than `holes`.
pub fn expr_tagged(tag: Ident, parts: List(String), holes: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_tagged(tag, parts, holes)

fn __meta_expr_tagged(tag: Ident, parts: List(String), holes: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_tagged(tag, parts, holes)

// Interpreter-owned compile-time hook. It creates a compiler-owned expression
// node carrying call-site origin; no source spelling can mint that origin.
fn __meta_call_site_expr(name: String) -> ExprSyntax:
    __meta_call_site_expr(name)

fn is_ident_start(c: String) -> Bool:
    c == "_" || "a" <= c && c <= "z" || "A" <= c && c <= "Z"

fn is_ident_continue(c: String) -> Bool:
    is_ident_start(c) || "0" <= c && c <= "9"

fn is_keyword(name: String) -> Bool:
    match name:
        "fn" -> true
        "gen" -> true
        "yield" -> true
        "async" -> true
        "await" -> true
        "let" -> true
        "var" -> true
        "match" -> true
        "pub" -> true
        "if" -> true
        "else" -> true
        "true" -> true
        "false" -> true
        "type" -> true
        "own" -> true
        "move" -> true
        "import" -> true
        "while" -> true
        "for" -> true
        "in" -> true
        "return" -> true
        "break" -> true
        "continue" -> true
        "trait" -> true
        "impl" -> true
        "where" -> true
        "as" -> true
        "region" -> true
        "comptime" -> true
        "capability" -> true
        _ -> false

// Compiler-owned named type syntax. Type arguments retain their AST and origin
// through generator calls instead of being assembled from source text.
pub fn type_named(name: Ident, args: List(TypeSyntax)) -> TypeSyntax:
    match name:
        Ident(source) -> __meta_type_named(source, args)
        CallSiteIdent(source) -> __meta_call_site_type(source, args)

// Compiler-owned definition-site named type construction. Type arguments retain
// their own origin and structure.
fn __meta_type_named(name: String, args: List(TypeSyntax)) -> TypeSyntax:
    __meta_type_named(name, args)

// Interpreter-owned compile-time hook. It retains an invocation-site type
// identity plus structurally decoded type arguments.
fn __meta_call_site_type(name: String, args: List(TypeSyntax)) -> TypeSyntax:
    __meta_call_site_type(name, args)

pub fn type_qualified(module: Ident, name: Ident, args: List(TypeSyntax)) -> TypeSyntax:
    let member = ident_source(name)
    match module:
        Ident(source) -> __meta_type_named(source + "." + member, args)
        CallSiteIdent(source) -> __meta_call_site_type(source + "." + member, args)

// A tuple type such as `(Int, String)`.
pub fn type_tuple(types: List(TypeSyntax)) -> TypeSyntax:
    __meta_type_tuple(types)

// Compiler-owned tuple type construction.
fn __meta_type_tuple(types: List(TypeSyntax)) -> TypeSyntax:
    __meta_type_tuple(types)

// A function type such as `fn(Int) -> String`.
pub fn type_fn(params: List(TypeSyntax), ret: TypeSyntax) -> TypeSyntax:
    __meta_type_fn(params, [], false, false, ret)

pub fn type_fn_with_conventions(params: List(TypeSyntax), conventions: List(String), ret: TypeSyntax) -> TypeSyntax:
    __meta_type_fn(params, conventions, false, false, ret)

// A function type with explicit invocation qualifiers.
pub fn type_fn_with_qualifiers(params: List(TypeSyntax), conventions: List(String), pure: Bool, once: Bool, ret: TypeSyntax) -> TypeSyntax:
    __meta_type_fn(params, conventions, pure, once, ret)

// Compiler-owned function type construction. An empty convention list means
// default `let` parameters; otherwise it must align with params.
fn __meta_type_fn(params: List(TypeSyntax), conventions: List(String), pure: Bool, once: Bool, ret: TypeSyntax) -> TypeSyntax:
    __meta_type_fn(params, conventions, pure, once, ret)

// A deeply immutable type qualifier.
pub fn type_frozen(ty: TypeSyntax) -> TypeSyntax:
    __meta_type_qualified("frozen", ty)

// A unique-reference type qualifier.
pub fn type_unique(ty: TypeSyntax) -> TypeSyntax:
    __meta_type_qualified("unique", ty)

// Compiler-owned ownership qualifier construction.
fn __meta_type_qualified(qualifier: String, ty: TypeSyntax) -> TypeSyntax:
    __meta_type_qualified(qualifier, ty)

// A capability type with rights, such as `Dir[Read]`.
pub fn type_capability(name: Ident, rights: List(TypeSyntax)) -> TypeSyntax:
    let head = ident_source(name)
    if head != "Dir" && head != "File" && head != "Net":
        fail("meta.type_capability: expected Dir, File, or Net")
    __meta_type_capability(name, rights)

// Compiler-owned capability type construction. Rights remain structural type
// children; the ambient capability head is validated above and by the bridge.
fn __meta_type_capability(name: Ident, rights: List(TypeSyntax)) -> TypeSyntax:
    __meta_type_capability(name, rights)

pub fn type_expr(ty: TypeExpr) -> TypeSyntax:
    __meta_type_expr(ty)

// Compiler-owned conversion from reflection data to type syntax. Rendering is
// reserved for generators that explicitly need source text.
fn __meta_type_expr(ty: TypeExpr) -> TypeSyntax:
    __meta_type_expr(ty)

// Expression syntax builders retain compiler-owned AST handles. Call-site
// names keep their origin through composition and linking.
pub fn expr_name(name: Ident) -> ExprSyntax:
    expr_ident(name)

pub fn expr_call(callee: ExprSyntax, args: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_call(callee, args)

// Build a direct call from a compiler-validated identifier. Unlike `expr_call`,
// this preserves the direct-call AST shape required by declaration-site
// resolution and generic specialization; it never accepts source text.
pub fn expr_named_call(name: Ident, args: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_named_call(name, args)

pub fn expr_try(value: ExprSyntax) -> ExprSyntax:
    __meta_expr_try(value)

pub fn expr_lambda(params: List(ParamSyntax), ret: Option(TypeSyntax), body: ExprSyntax) -> ExprSyntax:
    __meta_expr_lambda(params, ret, body)

pub fn expr_method_call(receiver: ExprSyntax, method: Ident, args: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_method_call(receiver, method, args)

pub fn expr_qualified_call(module: Ident, name: Ident, args: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_qualified_call(module, name, args)

// A qualified call with a compiler-validated nominal path, such as
// `sibling.Child.from_json`. Each path segment remains an Ident until the
// compiler bridge creates the AST call name; callers cannot supply dotted or
// otherwise unvalidated source strings.
pub fn expr_qualified_call_path(path: List(Ident), member: Ident, args: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_qualified_call_path(path, member, args)

// Derive-internal only: arbitrary macros must not mint the private descriptor
// intrinsic; only derive_reflect uses this sealed bridge for field identity.
fn expr_dynamic_descriptor(value: ExprSyntax) -> ExprSyntax:
    __meta_expr_dynamic_descriptor(value)

fn __meta_expr_dynamic_descriptor(value: ExprSyntax) -> ExprSyntax:
    __meta_expr_dynamic_descriptor(value)

fn __meta_expr_named_call(name: Ident, args: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_named_call(name, args)

fn __meta_expr_qualified_call(module: Ident, name: Ident, args: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_qualified_call(module, name, args)

fn __meta_expr_qualified_call_path(path: List(Ident), member: Ident, args: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_qualified_call_path(path, member, args)

// Compiler-owned structural composition for `expr_call`. It preserves syntax
// identity such as `meta.call_site` through a constructed call.
fn __meta_expr_call(callee: ExprSyntax, args: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_call(callee, args)

fn __meta_expr_try(value: ExprSyntax) -> ExprSyntax:
    __meta_expr_try(value)

fn __meta_expr_lambda(params: List(ParamSyntax), ret: Option(TypeSyntax), body: ExprSyntax) -> ExprSyntax:
    __meta_expr_lambda(params, ret, body)

fn __meta_expr_method_call(receiver: ExprSyntax, method: Ident, args: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_method_call(receiver, method, args)

pub fn expr_field(base: ExprSyntax, field: Ident) -> ExprSyntax:
    __meta_expr_field(base, field)

// Compiler-owned structural composition for `expr_field`. The base keeps its
// expression origin; fields are validated identifiers rather than bindings.
fn __meta_expr_field(base: ExprSyntax, field: Ident) -> ExprSyntax:
    __meta_expr_field(base, field)

pub fn expr_int(n: Int) -> ExprSyntax:
    __meta_expr_leaf("int", "${n}")

pub fn expr_bool(b: Bool) -> ExprSyntax:
    __meta_expr_leaf("bool", if b: "true" else: "false")

// A compiler-owned string literal. The value is stored as an `Expr::Str`, so
// quotes, backslashes, interpolation markers, and source-looking text remain
// data rather than generated syntax.
pub fn expr_string(value: String) -> ExprSyntax:
    __meta_expr_leaf("string", value)

// A compiler-owned binary expression. `op` is admitted by the compiler's
// fixed source-operator whitelist; it is never parsed as a source fragment.
pub fn expr_binary(op: String, lhs: ExprSyntax, rhs: ExprSyntax) -> ExprSyntax:
    __meta_expr_binary(op, lhs, rhs)

// Interpreter-owned compile-time hook for `expr_binary`. Both children retain
// their compiler-owned expression identity through the constructed AST node.
fn __meta_expr_binary(op: String, lhs: ExprSyntax, rhs: ExprSyntax) -> ExprSyntax:
    __meta_expr_binary(op, lhs, rhs)

// A compiler-owned list expression. Each element stays a typed expression node;
// the bridge never joins their rendered source.
pub fn expr_list(elements: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_list(elements)

fn __meta_expr_list(elements: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_list(elements)

// A compiler-owned tuple expression. Each member remains an expression node;
// tuple punctuation is introduced by the AST builder rather than source text.
pub fn expr_tuple(elements: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_tuple(elements)

fn __meta_expr_tuple(elements: List(ExprSyntax)) -> ExprSyntax:
    __meta_expr_tuple(elements)

// One named record field. A tuple is sufficient here: both parts are already
// sealed syntax values, so introducing another compiler-syntax type would add
// a runtime-leakage surface without adding authority.
pub fn record_field(name: Ident, value: ExprSyntax) -> (Ident, ExprSyntax):
    (name, value)

// Compiler-owned construction of an explicitly named record. The record head
// and labels are definition-site identifiers; invocation-site identifiers are
// references and are rejected rather than having their origin erased.
pub fn expr_record(name: Ident, fields: List((Ident, ExprSyntax))) -> ExprSyntax:
    __meta_expr_record(name, fields, None)

pub fn expr_record_update(name: Ident, fields: List((Ident, ExprSyntax)), base: ExprSyntax) -> ExprSyntax:
    __meta_expr_record(name, fields, Some(base))

// This builds only nominal records. Anonymous-record shapes require compiler
// registration and are deliberately not forged from a formatted type name.
fn __meta_expr_record(name: Ident, fields: List((Ident, ExprSyntax)), base: Option(ExprSyntax)) -> ExprSyntax:
    __meta_expr_record(name, fields, base)

pub fn expr_match(scrutinee: ExprSyntax, arms: List(MatchArmSyntax)) -> ExprSyntax:
    if list.is_empty(arms):
        fail("meta.expr_match: at least one match arm is required")
    __meta_expr_match(scrutinee, arms)

pub fn expr_block(body: BlockSyntax) -> ExprSyntax:
    __meta_expr_block(body)

pub fn expr_if(cond: ExprSyntax, then_body: BlockSyntax, else_body: Option(BlockSyntax)) -> ExprSyntax:
    __meta_expr_if(cond, then_body, else_body)

fn __meta_expr_if(cond: ExprSyntax, then_body: BlockSyntax, else_body: Option(BlockSyntax)) -> ExprSyntax:
    __meta_expr_if(cond, then_body, else_body)

// The generated function is checked as async before this suspension is lowered.
pub fn expr_await(value: ExprSyntax) -> ExprSyntax:
    __meta_expr_await(value)

fn __meta_expr_await(value: ExprSyntax) -> ExprSyntax:
    __meta_expr_await(value)

fn __meta_expr_block(body: BlockSyntax) -> ExprSyntax:
    __meta_expr_block(body)

// The scrutinee and each match arm retain compiler-owned syntax nodes.
fn __meta_expr_match(scrutinee: ExprSyntax, arms: List(MatchArmSyntax)) -> ExprSyntax:
    __meta_expr_match(scrutinee, arms)

// Compiler-owned pattern syntax. Validated identifiers and structural pattern
// children retain their origin through generated matches.
pub fn pattern_var(name: Ident) -> PatternSyntax:
    match name:
        Ident(source) -> __meta_pattern_leaf("var", source, "", false)
        CallSiteIdent(source) -> __meta_pattern_leaf("call-site-var", source, "", false)

pub fn pattern_wildcard() -> PatternSyntax:
    __meta_pattern_leaf("wildcard", "", "", false)

pub fn pattern_int(n: Int) -> PatternSyntax:
    __meta_pattern_leaf("int", "${n}", "", false)

pub fn pattern_bool(b: Bool) -> PatternSyntax:
    __meta_pattern_leaf("bool", if b: "true" else: "false", "", false)

// A string literal pattern.
pub fn pattern_str(value: String) -> PatternSyntax:
    __meta_pattern_leaf("string", value, "", false)

// A duration literal pattern from its whole-millisecond value.
pub fn pattern_duration_ms(ms: Int) -> PatternSyntax:
    __meta_pattern_leaf("duration", "${ms}", "", false)

// An integer range pattern.
pub fn pattern_range(lo: Int, hi: Int, inclusive: Bool) -> PatternSyntax:
    __meta_pattern_leaf("range", "${lo}", "${hi}", inclusive)

// Compiler-owned pattern leaf construction. Scalar payloads are validated and
// decoded directly into Pattern variants by the compiler bridge.
fn __meta_pattern_leaf(kind: String, first: String, second: String, inclusive: Bool) -> PatternSyntax:
    __meta_pattern_leaf(kind, first, second, inclusive)

pub fn pattern_ctor(name: Ident, args: List(PatternSyntax)) -> PatternSyntax:
    match name:
        Ident(source) -> __meta_pattern_ctor(source, args)
        CallSiteIdent(source) -> __meta_call_site_pattern(source, args)

// Compiler-owned definition-site constructor-pattern construction. Arguments
// retain their own origin and structure.
fn __meta_pattern_ctor(name: String, args: List(PatternSyntax)) -> PatternSyntax:
    __meta_pattern_ctor(name, args)

// Interpreter-owned compile-time hook. It retains an invocation-site
// constructor-pattern identity plus structurally decoded arguments.
fn __meta_call_site_pattern(name: String, args: List(PatternSyntax)) -> PatternSyntax:
    __meta_call_site_pattern(name, args)

// A module-qualified constructor pattern such as `iter.Item(x)`.
pub fn pattern_qualified_ctor(module: Ident, name: Ident, args: List(PatternSyntax)) -> PatternSyntax:
    let member = ident_source(name)
    match module:
        Ident(source) -> __meta_pattern_ctor(source + "." + member, args)
        CallSiteIdent(source) -> __meta_call_site_pattern(source + "." + member, args)

pub fn pattern_anon_ctor(tag: Ident, args: List(PatternSyntax)) -> PatternSyntax:
    match tag:
        Ident(source) -> __meta_pattern_ctor("." + source, args)
        CallSiteIdent(source) -> __meta_call_site_pattern("." + source, args)

// A tuple pattern.
pub fn pattern_tuple(patterns: List(PatternSyntax)) -> PatternSyntax:
    __meta_pattern_tuple(patterns)

fn __meta_pattern_tuple(patterns: List(PatternSyntax)) -> PatternSyntax:
    __meta_pattern_tuple(patterns)

// An exact-length list pattern.
pub fn pattern_list(patterns: List(PatternSyntax)) -> PatternSyntax:
    __meta_pattern_list(patterns)

fn __meta_pattern_list(patterns: List(PatternSyntax)) -> PatternSyntax:
    __meta_pattern_list(patterns)

// A list pattern with `..` or `..rest`.
pub fn pattern_list_rest(patterns: List(PatternSyntax), rest: Option(Ident)) -> PatternSyntax:
    __meta_pattern_list_rest(patterns, rest)

fn __meta_pattern_list_rest(patterns: List(PatternSyntax), rest: Option(Ident)) -> PatternSyntax:
    __meta_pattern_list_rest(patterns, rest)

// An or-pattern. Every alternative must bind the same names when type-checked.
pub fn pattern_or(patterns: List(PatternSyntax)) -> PatternSyntax:
    if list.is_empty(patterns):
        fail("meta.pattern_or: at least one alternative is required")
    __meta_pattern_or(patterns)

fn __meta_pattern_or(patterns: List(PatternSyntax)) -> PatternSyntax:
    __meta_pattern_or(patterns)

pub fn expr_hole(expr: ExprSyntax) -> SyntaxHole:
    ExprHole(expr)

pub fn type_hole(ty: TypeSyntax) -> SyntaxHole:
    TypeHole(ty)

pub fn pattern_hole(pattern: PatternSyntax) -> SyntaxHole:
    PatternHole(pattern)

pub fn match_arm(pattern: PatternSyntax, body: ExprSyntax) -> MatchArmSyntax:
    __meta_match_arm(pattern, body)

// Compiler-owned match-arm construction. Pattern and body retain their AST
// identity until the enclosing match is built.
fn __meta_match_arm(pattern: PatternSyntax, body: ExprSyntax) -> MatchArmSyntax:
    __meta_match_arm(pattern, body)

// Compiler-owned statement and block syntax retain AST nodes through
// block-shaped generators.
pub fn stmt_let(mutable: Bool, name: Ident, ty: Option(TypeSyntax), value: ExprSyntax) -> StmtSyntax:
    __meta_stmt_let(mutable, name, ty, value)

// Compiler-owned let/var statement construction. Binder, optional type, and
// value remain typed nodes through block construction.
fn __meta_stmt_let(mutable: Bool, name: Ident, ty: Option(TypeSyntax), value: ExprSyntax) -> StmtSyntax:
    __meta_stmt_let(mutable, name, ty, value)

pub fn stmt_expr(expr: ExprSyntax) -> StmtSyntax:
    __meta_stmt_expr(expr)

// Compiler-owned expression statement construction.
fn __meta_stmt_expr(expr: ExprSyntax) -> StmtSyntax:
    __meta_stmt_expr(expr)

pub fn stmt_return(value: ExprSyntax) -> StmtSyntax:
    __meta_stmt_return(value)

// Compiler-owned return statement construction.
fn __meta_stmt_return(value: ExprSyntax) -> StmtSyntax:
    __meta_stmt_return(value)

pub fn stmt_return_none() -> StmtSyntax:
    __meta_stmt_leaf("return")

// The generated function is checked as a generator before this yield is lowered.
pub fn stmt_yield(value: ExprSyntax) -> StmtSyntax:
    __meta_stmt_yield(value)

fn __meta_stmt_yield(value: ExprSyntax) -> StmtSyntax:
    __meta_stmt_yield(value)

// Compiler-owned statement construction for leaf statements without children.
fn __meta_stmt_leaf(kind: String) -> StmtSyntax:
    __meta_stmt_leaf(kind)

pub fn block(stmts: List(StmtSyntax), tail: Option(ExprSyntax)) -> BlockSyntax:
    if list.is_empty(stmts) && option.is_none(tail):
        fail("meta.block: body must contain at least one statement or tail expression")
    __meta_block(stmts, tail)

// Compiler-owned block construction. Owned statements and the optional tail
// expression are transferred directly instead of being projected to source.
fn __meta_block(stmts: List(StmtSyntax), tail: Option(ExprSyntax)) -> BlockSyntax:
    __meta_block(stmts, tail)

// Attach a typed copy-out annotation to an already compiler-owned block.
pub fn block_region(body: BlockSyntax, result: Option(TypeSyntax)) -> BlockSyntax:
    __meta_block_region(body, result)

fn __meta_block_region(body: BlockSyntax, result: Option(TypeSyntax)) -> BlockSyntax:
    __meta_block_region(body, result)

// A function parameter and function item constructors. The single-expression
// form now delegates to the block form so item generation has one body shape.
pub fn param(name: Ident, ty: TypeSyntax) -> ParamSyntax:
    __meta_param(name, ty)

// Compiler-owned parameter construction. Binding and type remain typed through
// generated function construction.
fn __meta_param(name: Ident, ty: TypeSyntax) -> ParamSyntax:
    __meta_param(name, ty)

pub fn function(public: Bool, name: Ident, params: List(ParamSyntax), ret: Option(TypeSyntax), body: ExprSyntax) -> ItemSyntax:
    function_block(public, name, params, ret, block([], Some(body)))

pub fn function_block(public: Bool, name: Ident, params: List(ParamSyntax), ret: Option(TypeSyntax), body: BlockSyntax) -> ItemSyntax:
    __meta_function_block(public, false, false, name, params, ret, body)

pub fn function_async(public: Bool, name: Ident, params: List(ParamSyntax), ret: Option(TypeSyntax), body: BlockSyntax) -> ItemSyntax:
    __meta_function_block(public, true, false, name, params, ret, body)

pub fn function_generator(public: Bool, name: Ident, params: List(ParamSyntax), ret: Option(TypeSyntax), body: BlockSyntax) -> ItemSyntax:
    __meta_function_block(public, false, true, name, params, ret, body)

// Compiler-owned function construction. Name, parameters, return type, and body
// transfer as typed nodes.
fn __meta_function_block(public: Bool, is_async: Bool, is_gen: Bool, name: Ident, params: List(ParamSyntax), ret: Option(TypeSyntax), body: BlockSyntax) -> ItemSyntax:
    __meta_function_block(public, is_async, is_gen, name, params, ret, body)

// Build a trait implementation directly from typed trait/target heads and
// compiler-owned function items. No impl source is rendered or reparsed.
pub fn impl_block(trait_ty: TypeSyntax, target_ty: TypeSyntax, items: List(ItemSyntax)) -> ItemSyntax:
    __meta_impl_block(trait_ty, target_ty, items)

// Structural impl construction with typed conditional bounds. Each pair is
// `(type_parameter, trait)`; the compiler turns it directly into ImplDef bounds.
pub fn impl_block_where(trait_ty: TypeSyntax, target_ty: TypeSyntax, bounds: List((Ident, Ident)), items: List(ItemSyntax)) -> ItemSyntax:
    __meta_impl_block_where(trait_ty, target_ty, bounds, items)

fn __meta_impl_block_where(trait_ty: TypeSyntax, target_ty: TypeSyntax, bounds: List((Ident, Ident)), items: List(ItemSyntax)) -> ItemSyntax:
    __meta_impl_block_where(trait_ty, target_ty, bounds, items)

fn __meta_impl_block(trait_ty: TypeSyntax, target_ty: TypeSyntax, items: List(ItemSyntax)) -> ItemSyntax:
    __meta_impl_block(trait_ty, target_ty, items)

pub fn module(items: List(ItemSyntax)) -> ModuleSyntax:
    ModuleSyntax(items)

pub fn module_items(module_syntax: ModuleSyntax) -> List(ItemSyntax):
    match module_syntax:
        ModuleSyntax(items) -> items

// A declared type expression, exposed as data so generators do not have to parse
// source-looking type strings.
type TypeExpr:
    TNamed(String, List(TypeExpr))
    TTuple(List(TypeExpr))
    TFn(List(TypeExpr), TypeExpr, List(String), Bool, Bool)
    TQualified(String, TypeExpr)
    // A rooted immutable view owns its backing-root carrier.  It has neither a
    // lifetime name nor a mutable/access-kind variant in reflection.
    TView(TypeExpr)

// The declaration shape. `TypeUninhabited` is intentionally not called "unit":
// a fieldless declaration has no constructor and therefore no values.
type TypeKind:
    TypeRecord
    TypeSum
    TypeUninhabited

// One field of a record: its name and declared type.
type FieldInfo:
    name: String
    type_expr: TypeExpr

// One constructor of a sum type: its name and positional payload types.
type VariantInfo:
    name: String
    field_type_exprs: List(TypeExpr)

// A type's structure. `fields` is populated for records and `variants` for sums;
// both are empty for an uninhabited fieldless declaration.
type TypeInfo:
    name: String
    kind: TypeKind
    params: List(String)
    fields: List(FieldInfo)
    variants: List(VariantInfo)

// --- built-in derive generators ----------------------------------------------
// Built-in `derive(X)` desugars to a comptime call `meta.derive_<x>(typeInfo)`
// that returns an `ItemSyntax`. These ARE witchy - the per-trait code generation that used to be
// hardcoded in the Rust compiler now lives here as ordinary, readable functions over
// `TypeInfo`, and anyone can write their own `derive_foo` the same way.

// The impl target with its type parameters - `Box(a)` for a generic type, `Point`
// otherwise. Also the type of a same-typed `other` parameter.
fn target_with_params(t: TypeInfo) -> String:
    if list.is_empty(t.params):
        t.name
    else:
        t.name + "(" + list.join(t.params, ", ") + ")"

// A ` where a: Trait, b: Trait` clause binding each type parameter to `trait_name`,
// or "" for a non-generic type - so a generic type's derived impl discharges its
// parameters' bounds and monomorphizes per argument.
fn where_each(params: List(String), trait_name: String) -> String:
    if list.is_empty(params):
        ""
    else:
        var bounds = []
        for p in params:
            // Lifetime parameters are compile-time owner relations, not types
            // implementing the derived trait.
            if !p.starts_with("'"):
                list.push(bounds, p + ": " + trait_name)
        if list.is_empty(bounds):
            ""
        else:
            " where " + list.join(bounds, ", ")

fn type_sources(types: List(TypeExpr)) -> List(String):
    var out = []
    for ty in types:
        list.push(out, type_source(ty))
    out

fn function_type_sources(types: List(TypeExpr), conventions: List(String)) -> List(String):
    var out = []
    var i = 0
    for ty in types:
        let prefix = match list.at(conventions, i):
            "borrow" -> "let "
            "var" -> "var "
            "own" -> "own "
            _ -> ""

        list.push(out, prefix + type_source(ty))
        i = i + 1
    out

// Render a structured type back to source text only when generated source needs
// to name the type. Semantic branching should stay on `TypeExpr`, not this
// string.
pub fn type_source(ty: TypeExpr) -> String:
    match ty:
        TNamed(name, args) ->
            // Slice descriptors retain their element argument for structural
            // reflection, but `name` is already the complete `[a]` spelling.
            if name.starts_with("["):
                name
            else if list.is_empty(args):
                name
            else:
                name + "(" + list.join(type_sources(args), ", ") + ")"
        TTuple(slots) -> "(" + list.join(type_sources(slots), ", ") + ")"
        TFn(params, ret, conventions, pure, once) ->
            let prefix = if pure: "pure " else: ""
            let prefix = prefix + if once: "once " else: ""
            prefix + "fn(" + list.join(function_type_sources(params, conventions), ", ") + ") -> " + type_source(ret)
        TQualified(q, inner) -> q + " " + type_source(inner)
        TView(inner) -> "&" + type_source(inner)

// `derive(Show)` -> constructor-shaped rendering with each field/payload rendered
// through its own `Show` impl. Primitive fields still match structural
// interpolation bytes, while fields with custom `Show` keep their public display
// form. Generic parameters carry a `: Show` bound, so the same code path compiles
// coherently on both backends.
pub fn derive_show(t: TypeInfo) -> ItemSyntax:
    let self_expr = expr_name(ident("self"))
    let body = match t.kind:
        TypeRecord -> record_show_expr(t.fields, self_expr, t.name)
        _ ->
            var arms: List(MatchArmSyntax) = []
            for v in t.variants:
                var pats: List(PatternSyntax) = []
                var vals: List(ExprSyntax) = []
                var i = 0
                for _ft in v.field_type_exprs:
                    let p = fresh("p")
                    pats.push(pattern_var(p))
                    vals.push(expr_named_call(ident("show"), [expr_name(p)]))
                    i = i + 1
                let pat = if list.is_empty(pats): pattern_ctor(ident(v.name), []) else: pattern_ctor(ident(v.name), pats)
                let rendered = show_ctor_expr(v.name, vals)
                arms.push(match_arm(pat, rendered))
            expr_match(self_expr, arms)
    let method = function(false, ident("show"), [param(ident("self"), type_expr(TNamed(t.name, type_params(t.params))))], Some(type_named(ident("String"), [])), body)
    impl_block_where(type_named(ident("Show"), []), type_expr(TNamed(t.name, type_params(t.params))), bound_list(t.params, "Show"), [method])

fn type_params(params: List(String)) -> List(TypeExpr):
    var out: List(TypeExpr) = []
    for p in params:
        out.push(TNamed(p, []))
    out

fn bound_list(params: List(String), trait_name: String) -> List((Ident, Ident)):
    var out: List((Ident, Ident)) = []
    for p in params:
        if !p.starts_with("'"):
            out.push((ident(p), ident(trait_name)))
    out

fn show_ctor_expr(name: String, values: List(ExprSyntax)) -> ExprSyntax:
    var out: ExprSyntax = expr_string(name)
    if !list.is_empty(values):
        out = expr_binary("+", out, expr_string("("))
        var i = 0
        for value in values:
            if i > 0:
                out = expr_binary("+", out, expr_string(", "))
            out = expr_binary("+", out, value)
            i = i + 1
        out = expr_binary("+", out, expr_string(")"))
    out

fn record_show_expr(fields: List(FieldInfo), self_expr: ExprSyntax, name: String) -> ExprSyntax:
    var out: ExprSyntax = expr_string(name)
    if !list.is_empty(fields):
        out = expr_binary("+", out, expr_string("("))
        var i = 0
        for f in fields:
            if i > 0:
                out = expr_binary("+", out, expr_string(", "))
            let field = expr_field(self_expr, ident(f.name))
            out = expr_binary("+", out, expr_named_call(ident("show"), [field]))
            i = i + 1
        out = expr_binary("+", out, expr_string(")"))
    out

fn derive_show_source(t: TypeInfo) -> String:
    let head = "impl Show for " + target_with_params(t) + where_each(t.params, "Show") + ":\n    fn show(self) -> String:\n"
    match t.kind:
        TypeRecord -> head + "        " + record_show_body(t.name, t.fields) + "\n"
        _ ->
            var arms = []
            for v in t.variants:
                list.push(arms, variant_show_arm(v))
            head + "        match self:\n" + list.join(arms, "\n") + "\n"

// The rendered body of a record's `show`: `"Name"` for a defensive empty-field
// record input, else `"Name(" + show(self.f1) + ", " + show(self.f2) + ")"`.
fn record_show_body(name: String, fields: List(FieldInfo)) -> String:
    if list.is_empty(fields):
        "\"" + name + "\""
    else:
        var parts = []
        for f in fields:
            list.push(parts, "show(self." + f.name + ")")
        "\"" + name + "(\" + " + list.join(parts, " + \", \" + ") + " + \")\""

// One arm of a sum type's `show`: bind the variant's payloads and render them
// through their own `Show` (a nullary variant is just its name).
fn variant_show_arm(v: VariantInfo) -> String:
    var pats = []
    var parts = []
    var i = 0
    for _ft in v.field_type_exprs:
        list.push(pats, "p${i}")
        list.push(parts, "show(p${i})")
        i = i + 1
    var selfpat = v.name
    if list.length(pats) > 0:
        selfpat = v.name + "(" + list.join(pats, ", ") + ")"
    var rhs = "\"" + v.name + "\""
    if list.length(parts) > 0:
        rhs = "\"" + v.name + "(\" + " + list.join(parts, " + \", \" + ") + " + \")\""
    "            " + selfpat + " -> " + rhs

// `derive(Eq)` → the total-equality marker. Refines `PartialEq` (derive both).
pub fn derive_eq(t: TypeInfo) -> ItemSyntax:
    let methodless: List(ItemSyntax) = []
    impl_block_where(type_named(ident("Eq"), []), type_expr(TNamed(t.name, type_params(t.params))), bound_list(t.params, "Eq"), methodless)

fn derive_eq_source(t: TypeInfo) -> String:
    "impl Eq for " + target_with_params(t) + where_each(t.params, "Eq") + "\n"

// `derive(PartialEq)` → field-wise structural equality. The operators dispatch
// per field, so it is content-correct on both backends: a record compares each
// field with `==`; a sum type matches the variant and compares payloads.
pub fn derive_partial_eq(t: TypeInfo) -> ItemSyntax:
    let self_expr = expr_name(ident("self"))
    let other_expr = expr_name(ident("other"))
    let body = match t.kind:
        TypeRecord -> record_eq_expr(t.fields, self_expr, other_expr)
        _ ->
            var arms: List(MatchArmSyntax) = []
            for v in t.variants:
                var pats: List(PatternSyntax) = []
                var opats: List(PatternSyntax) = []
                var terms: List(ExprSyntax) = []
                var i = 0
                for _ft in v.field_type_exprs:
                    let p = fresh("p")
                    let o = fresh("o")
                    pats.push(pattern_var(p))
                    opats.push(pattern_var(o))
                    terms.push(expr_binary("==", expr_name(p), expr_name(o)))
                    i = i + 1
                let pat = if list.is_empty(pats): pattern_ctor(ident(v.name), []) else: pattern_ctor(ident(v.name), pats)
                let op = if list.is_empty(opats): pattern_ctor(ident(v.name), []) else: pattern_ctor(ident(v.name), opats)
                let same = if list.is_empty(terms): expr_bool(true) else: join_binary("&&", terms)
                arms.push(match_arm(pat, expr_match(other_expr, [match_arm(op, same), match_arm(pattern_wildcard(), expr_bool(false))])))
            expr_match(self_expr, arms)
    let target = type_expr(TNamed(t.name, type_params(t.params)))
    let method = function(false, ident("eq"), [param(ident("self"), target), param(ident("other"), target)], Some(type_named(ident("Bool"), [])), body)
    impl_block_where(type_named(ident("PartialEq"), []), target, bound_list(t.params, "PartialEq"), [method])

fn join_binary(op: String, values: List(ExprSyntax)) -> ExprSyntax:
    var out = list.at(values, 0)
    var i = 1
    while i < list.length(values):
        out = expr_binary(op, out, list.at(values, i))
        i = i + 1
    out

fn record_eq_expr(fields: List(FieldInfo), self_expr: ExprSyntax, other_expr: ExprSyntax) -> ExprSyntax:
    if list.is_empty(fields):
        expr_bool(true)
    else:
        var terms: List(ExprSyntax) = []
        for f in fields:
            terms.push(expr_binary("==", expr_field(self_expr, ident(f.name)), expr_field(other_expr, ident(f.name))))
        join_binary("&&", terms)

fn derive_partial_eq_source(t: TypeInfo) -> String:
    let head = "impl PartialEq for " + target_with_params(t) + where_each(t.params, "PartialEq") + ":\n    fn eq(self, other: " + target_with_params(t) + ") -> Bool:\n"
    match t.kind:
        TypeRecord -> head + "        " + record_eq_body(t.fields) + "\n"
        _ ->
            var arms = []
            for v in t.variants:
                list.push(arms, variant_eq_arm(v))
            head + "        match self:\n" + list.join(arms, "\n") + "\n"

// The `&&`-chained field comparison of a record's `eq`, or `true` for a
// defensive empty-field record input.
fn record_eq_body(fields: List(FieldInfo)) -> String:
    if list.is_empty(fields):
        "true"
    else:
        var terms = []
        for f in fields:
            list.push(terms, "self." + f.name + " == other." + f.name)
        list.join(terms, " && ")

// One arm of a sum type's `eq`: match `other` against the same variant, compare
// payloads pairwise, and fail on any other variant.
fn variant_eq_arm(v: VariantInfo) -> String:
    var pats = []
    var opats = []
    var terms = []
    var i = 0
    for _ft in v.field_type_exprs:
        list.push(pats, "p${i}")
        list.push(opats, "o${i}")
        list.push(terms, "p${i} == o${i}")
        i = i + 1
    var selfpat = v.name
    var otherpat = v.name
    if list.length(pats) > 0:
        selfpat = v.name + "(" + list.join(pats, ", ") + ")"
        otherpat = v.name + "(" + list.join(opats, ", ") + ")"
    var rhs = "true"
    if list.length(terms) > 0:
        rhs = list.join(terms, " && ")
    "            " + selfpat + " -> match other:\n                " + otherpat + " -> " + rhs + "\n                _ -> false"

// The `reflect`-call for a field/payload of declared type `ty` applied to the
// expression text `value` - single-line, dispatched by structured type shape.
fn reflect_call(ty: TypeExpr, value: String) -> String:
    match ty:
        TNamed(name, _args) ->
            if name == "List":
                "reflect.reflect_list(" + value + ")"
            else if name == "Option":
                "reflect.reflect_option(" + value + ")"
            else:
                "reflect.reflect_one(" + value + ")"
        _ -> "reflect.reflect_one(" + value + ")"

// `derive(Reflect)` → an `impl Reflect for T` building the value's `Mirror`: a
// record to `MRecord("T", [(field, reflect field)…])`, a sum type to a `match`
// over variants to `MVariant`. (The module must `import reflect`; caller checks.)
pub fn derive_reflect(t: TypeInfo) -> ItemSyntax:
    let target = type_expr(TNamed(t.name, type_params(t.params)))
    let self_expr = expr_name(ident("self"))
    let reflect_body = if let TypeRecord = t.kind:
        var pairs: List(ExprSyntax) = []
        for f in t.fields:
            pairs.push(expr_tuple([expr_string(f.name), reflect_call_expr(f.type_expr, expr_field(self_expr, ident(f.name)))]))
        qualified_call("reflect", "MRecord", [expr_string(t.name), expr_list(pairs)])
    else:
        var arms: List(MatchArmSyntax) = []
        for v in t.variants:
            var pats: List(PatternSyntax) = []
            var vals: List(ExprSyntax) = []
            var i = 0
            for ft in v.field_type_exprs:
                let p = fresh("p")
                pats.push(pattern_var(p))
                vals.push(reflect_call_expr(ft, expr_name(p)))
                i = i + 1
            let pat = if list.is_empty(pats): pattern_ctor(ident(v.name), []) else: pattern_ctor(ident(v.name), pats)
            arms.push(match_arm(pat, qualified_call("reflect", "MVariant", [expr_string(t.name), expr_string(v.name), expr_list(vals)])))
        expr_match(self_expr, arms)
    let reflect_method = function(false, ident("reflect"), [param(ident("self"), target)], Some(type_qualified(ident("reflect"), ident("Mirror"), [])), reflect_body)
    let methods = match t.kind:
        TypeRecord -> [reflect_method, function(false, internal_ident("__dynamic_field"), [param(ident("self"), target), param(internal_ident("__name"), type_named(ident("String"), []))], Some(type_named(ident("Option"), [type_qualified(ident("reflect"), ident("DynamicFieldValue"), [])])), dynamic_field_expr(t.fields, self_expr, 0))]
        _ -> [reflect_method]

    impl_block_where(type_named(ident("Reflect"), []), target, bound_list(t.params, "Reflect"), methods)

fn dynamic_field_expr(fields: List(FieldInfo), self_expr: ExprSyntax, index: Int) -> ExprSyntax:
    if index >= list.length(fields):
        expr_name(ident("None"))
    else:
        let f = list.at(fields, index)
        let value = qualified_call("reflect", "DynamicFieldValue", [expr_dynamic_descriptor(self_expr), expr_dynamic_descriptor(expr_field(self_expr, ident(f.name))), expr_field(self_expr, ident(f.name))])
        let yes = expr_call(expr_name(ident("Some")), [value])
        let cond = expr_binary("==", expr_name(internal_ident("__name")), expr_string(f.name))
        expr_match(cond, [match_arm(pattern_bool(true), yes), match_arm(pattern_wildcard(), dynamic_field_expr(fields, self_expr, index + 1))])

fn qualified_call(module: String, name: String, args: List(ExprSyntax)) -> ExprSyntax:
    expr_qualified_call(ident(module), ident(name), args)

fn reflect_call_expr(ty: TypeExpr, value: ExprSyntax) -> ExprSyntax:
    match ty:
        TNamed(name, _) ->
            if name == "List":
                qualified_call("reflect", "reflect_list", [value])
            else if name == "Option":
                qualified_call("reflect", "reflect_option", [value])
            else:
                qualified_call("reflect", "reflect_one", [value])
        _ -> qualified_call("reflect", "reflect_one", [value])

// `derive(PublicState)` proves a value can cross a public/resumable boundary.
// The generated method checks every field through the field type's own proof;
// capabilities, functions, Bytes, host handles, and secrets fail because they
// deliberately have no PublicState implementation.
pub fn derive_public_state(t: TypeInfo) -> ItemSyntax:
    let target = type_expr(TNamed(t.name, type_params(t.params)))
    let self_expr = expr_name(ident("self"))
    let body = if let TypeRecord = t.kind:
        var stmts: List(StmtSyntax) = []
        for f in t.fields:
            stmts.push(stmt_expr(qualified_call("public_state", "check", [expr_field(self_expr, ident(f.name))])))
        block(stmts, Some(expr_tuple([])))
    else:
        var arms: List(MatchArmSyntax) = []
        for v in t.variants:
            var pats: List(PatternSyntax) = []
            var stmts: List(StmtSyntax) = []
            var i = 0
            for _ft in v.field_type_exprs:
                let p = fresh("p")
                pats.push(pattern_var(p))
                stmts.push(stmt_expr(qualified_call("public_state", "check", [expr_name(p)])))
                i = i + 1
            let pat = if list.is_empty(pats): pattern_ctor(ident(v.name), []) else: pattern_ctor(ident(v.name), pats)
            let arm_body = expr_block(block(stmts, Some(expr_tuple([]))))
            arms.push(match_arm(pat, arm_body))
        function_body_block(expr_match(self_expr, arms))
    let method = function_block(false, ident("public_state_proof"), [param(ident("self"), target)], None, body)
    impl_block_where(type_named(ident("PublicState"), []), target, bound_list(t.params, "PublicState"), [method])

fn function_body_block(expr: ExprSyntax) -> BlockSyntax:
    block([], Some(expr))

// `derive(Ord)` → lexicographic `compare` returning `Ordering` (records only; the
// caller validates the shape). Requires the `PartialEq`/`Eq`/`PartialOrd` impls too.
pub fn derive_ord(t: TypeInfo) -> ItemSyntax:
    let target = type_expr(TNamed(t.name, type_params(t.params)))
    let self_expr = expr_name(ident("self"))
    let other_expr = expr_name(ident("other"))
    let body = ord_lexicographic_expr(t.fields, self_expr, other_expr, 0)
    let method = function(false, ident("compare"), [param(ident("self"), target), param(ident("other"), target)], Some(type_named(ident("Ordering"), [])), body)
    impl_block_where(type_named(ident("Ord"), []), target, bound_list(t.params, "Ord"), [method])

// `derive(PartialOrd)` → lexicographic `partial_compare` (records only).
pub fn derive_partial_ord(t: TypeInfo) -> ItemSyntax:
    let target = type_expr(TNamed(t.name, type_params(t.params)))
    let self_expr = expr_name(ident("self"))
    let other_expr = expr_name(ident("other"))
    let body = partial_ord_lexicographic_expr(t.fields, self_expr, other_expr, 0)
    let method = function(false, ident("partial_compare"), [param(ident("self"), target), param(ident("other"), target)], Some(type_named(ident("Option"), [type_named(ident("Ordering"), [])])), body)
    impl_block_where(type_named(ident("PartialOrd"), []), target, bound_list(t.params, "PartialOrd"), [method])

fn ord_lexicographic_expr(fields: List(FieldInfo), self_expr: ExprSyntax, other_expr: ExprSyntax, index: Int) -> ExprSyntax:
    if index >= list.length(fields):
        expr_name(ident("Equal"))
    else:
        let f = list.at(fields, index)
        let compared = expr_method_call(expr_field(self_expr, ident(f.name)), ident("compare"), [expr_field(other_expr, ident(f.name))])
        let equal = ord_lexicographic_expr(fields, self_expr, other_expr, index + 1)
        expr_match(compared, [match_arm(pattern_ctor(ident("Less"), []), expr_name(ident("Less"))), match_arm(pattern_ctor(ident("Greater"), []), expr_name(ident("Greater"))), match_arm(pattern_ctor(ident("Equal"), []), equal)])

fn partial_ord_lexicographic_expr(fields: List(FieldInfo), self_expr: ExprSyntax, other_expr: ExprSyntax, index: Int) -> ExprSyntax:
    if index >= list.length(fields):
        expr_call(expr_name(ident("Some")), [expr_name(ident("Equal"))])
    else:
        let f = list.at(fields, index)
        let compared = expr_method_call(expr_field(self_expr, ident(f.name)), ident("partial_compare"), [expr_field(other_expr, ident(f.name))])
        let equal = partial_ord_lexicographic_expr(fields, self_expr, other_expr, index + 1)
        expr_match(compared, [match_arm(pattern_ctor(ident("None"), []), expr_name(ident("None"))), match_arm(pattern_ctor(ident("Some"), [pattern_ctor(ident("Less"), [])]), expr_call(expr_name(ident("Some")), [expr_name(ident("Less"))])), match_arm(pattern_ctor(ident("Some"), [pattern_ctor(ident("Greater"), [])]), expr_call(expr_name(ident("Some")), [expr_name(ident("Greater"))])), match_arm(pattern_ctor(ident("Some"), [pattern_ctor(ident("Equal"), [])]), equal)])

// A `Result`-producing decode of a `Json` value already in hand (recursive).
// Every node is built as compiler-owned syntax; in particular the postfix try
// and callback lambda are AST nodes, not source fragments.
fn json_decode_value(ty: TypeExpr, value: ExprSyntax) -> ExprSyntax:
    match ty:
        // An `Option` value already in hand: JSON `null` decodes to `None`,
        // anything else applies the element decoder and wraps `Some`. Reuses
        // `json.optional` (which maps `Some(JsonNull) -> None`) so it composes
        // at any depth - inside a `List`, another `Option`, or a record field.
        TNamed(name, args) ->
            if name == "Int":
                qualified_call("json", "int_of", [value])
            else if name == "Float":
                qualified_call("json", "float_of", [value])
            else if name == "Bool":
                qualified_call("json", "bool_of", [value])
            else if name == "String":
                qualified_call("json", "string_of", [value])
            else if name == "List" && list.length(args) == 1:
                let elem = list.at(args, 0)
                let element = fresh("element")
                let element_ty = type_qualified(ident("json"), ident("Json"), [])
                let error_ty = type_qualified(ident("json"), ident("DeserializeError"), [])
                let result_ty = type_named(ident("Result"), [type_expr(elem), error_ty])
                let decode = expr_lambda([param(element, element_ty)], Some(result_ty), json_decode_value(elem, expr_name(element)))

                let array = expr_try(qualified_call("json", "array_of", [value]))
                let mapped = qualified_call("list", "map", [array, decode])
                qualified_call("result", "all", [mapped])
            else if name == "Option" && list.length(args) == 1:
                let elem = list.at(args, 0)
                let element = fresh("element")
                let element_ty = type_qualified(ident("json"), ident("Json"), [])
                let error_ty = type_qualified(ident("json"), ident("DeserializeError"), [])
                let result_ty = type_named(ident("Result"), [type_expr(elem), error_ty])
                let decode = expr_lambda([param(element, element_ty)], Some(result_ty), json_decode_value(elem, expr_name(element)))

                let some = expr_call(expr_name(ident("Some")), [value])
                qualified_call("json", "optional", [some, decode])
            else:
                expr_qualified_call_path(nominal_path(name), ident("from_json"), [value])
        TQualified(_, inner) -> json_decode_value(inner, value)
        _ -> expr_call(expr_name(ident("fail")), [expr_string("derive(Deserialize): unsupported field type")])

fn nominal_path(name: String) -> List(Ident):
    var path: List(Ident) = []
    for segment in name.split("."):
        path.push(ident(segment))
    path

// Decode one record field from `object`: an Option reads with `get` (absent
// allowed), everything else with `require`. Trails a `?` so it's a `let` initializer.
fn json_decode_field(ty: TypeExpr, object: ExprSyntax, key: String) -> ExprSyntax:
    if let TNamed(name, args) = ty:
        if name == "Option" && list.length(args) == 1:
            let elem = list.at(args, 0)
            let element = fresh("element")
            let element_ty = type_qualified(ident("json"), ident("Json"), [])
            let error_ty = type_qualified(ident("json"), ident("DeserializeError"), [])
            let result_ty = type_named(ident("Result"), [type_expr(elem), error_ty])
            let decode = expr_lambda([param(element, element_ty)], Some(result_ty), json_decode_value(elem, expr_name(element)))

            expr_try(qualified_call("json", "optional", [qualified_call("json", "get", [object, expr_string(key)]), decode]))
        else:
            let required = expr_try(qualified_call("json", "require", [object, expr_string(key)]))
            expr_try(json_decode_value(ty, required))
    else:
        let required = expr_try(qualified_call("json", "require", [object, expr_string(key)]))
        expr_try(json_decode_value(ty, required))

// `derive(Deserialize)` generates `from_json` for a record (the caller validates the
// shape). It decodes and coerces each field, returning on the first error. There is
// no matching `Serialize` derive, because reflection (`json.from_value`, `stringify`,
// `Into(Json)`) already encodes any value, so only this reconstruction is per-type.
// The generated code uses only json/result/list/option.
pub fn derive_deserialize(t: TypeInfo) -> ItemSyntax:
    let json_ty = type_qualified(ident("json"), ident("Json"), [])
    let error_ty = type_qualified(ident("json"), ident("DeserializeError"), [])
    let target = type_expr(TNamed(t.name, type_params(t.params)))
    let result_ty = type_named(ident("Result"), [target, error_ty])
    let input = fresh("json")
    var statements: List(StmtSyntax) = []
    var names: List(ExprSyntax) = []
    for f in t.fields:
        let local = fresh("field")
        statements.push(stmt_let(false, local, None, json_decode_field(f.type_expr, expr_name(input), f.name)))
        names.push(expr_name(local))
    let constructed = expr_call(expr_name(ident(t.name)), names)
    let success = expr_call(expr_name(ident("Ok")), [constructed])
    let body = block(statements, Some(success))
    let method = function_block(false, ident("from_json"), [param(input, json_ty)], Some(result_ty), body)

    let implementation = impl_block_where(type_named(ident("Deserialize"), []), target, bound_list(t.params, "Deserialize"), [method])

    // The generated item makes module-qualified calls, so retain their
    // standard-module imports in the compiler-owned module fragment.
    item_with_imports(["json", "list", "result"], implementation)
