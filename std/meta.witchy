// Compile-time type introspection — the `typeInfo` half of witchy's comptime
// reflection (Zig's `@typeInfo`). A `comptime:` block can read the structure of
// every type in its module as ordinary data and generate code from it (e.g. a
// `to_json` specialized to a record's fields), with zero runtime cost. The
// compiler injects the type list as the `module_types` value; these are the
// shapes it hands you.
//
// This is COMPILE-TIME structure (field names + declared type expressions),
// distinct from `std/reflect`'s runtime `Mirror` (a value's structure at runtime).

// A declared type expression, exposed as data so generators do not have to parse
// source-looking type strings.
type TypeExpr:
    TNamed(String, List(TypeExpr))
    TTuple(List(TypeExpr))
    TFn(List(TypeExpr), TypeExpr)
    TQualified(String, TypeExpr)

// The declaration shape. `TypeUninhabited` is intentionally not called "unit":
// a fieldless declaration has no constructor and therefore no values.
type TypeKind:
    TypeRecord
    TypeSum
    TypeUninhabited

// One field of a record: its name and declared type.
type FieldInfo:
    name: String
    type_expr: TypeExpr

// One constructor of a sum type: its name and positional payload types.
type VariantInfo:
    name: String
    field_type_exprs: List(TypeExpr)

// A type's structure. `fields` is populated for records and `variants` for sums;
// both are empty for an uninhabited fieldless declaration.
type TypeInfo:
    name: String
    kind: TypeKind
    params: List(String)
    fields: List(FieldInfo)
    variants: List(VariantInfo)

// --- built-in derive generators ----------------------------------------------
// `derive(X)` desugars to a comptime call `meta.derive_<x>(typeInfo)` that returns
// the impl source. These ARE witchy — the per-trait code generation that used to be
// hardcoded in the Rust compiler now lives here as ordinary, readable functions over
// `TypeInfo`, and anyone can write their own `derive_foo` the same way.

// The impl target with its type parameters — `Box(a)` for a generic type, `Point`
// otherwise. Also the type of a same-typed `other` parameter.
fn target_with_params(t: TypeInfo) -> String:
    if list.is_empty(t.params):
        t.name
    else:
        t.name + "(" + list.join(t.params, ", ") + ")"

// A ` where a: Trait, b: Trait` clause binding each type parameter to `trait_name`,
// or "" for a non-generic type — so a generic type's derived impl discharges its
// parameters' bounds and monomorphizes per argument.
fn where_each(params: List(String), trait_name: String) -> String:
    if list.is_empty(params):
        ""
    else:
        var bounds = []
        for p in params:
            bounds = list.push(bounds, p + ": " + trait_name)
        " where " + list.join(bounds, ", ")

fn type_sources(types: List(TypeExpr)) -> List(String):
    var out = []
    for ty in types:
        out = list.push(out, type_source(ty))
    out

// Render a structured type back to source text only when generated source needs
// to name the type. Semantic branching should stay on `TypeExpr`, not this
// string.
pub fn type_source(ty: TypeExpr) -> String:
    match ty:
        TNamed(name, args) ->
            if list.is_empty(args):
                name
            else:
                name + "(" + list.join(type_sources(args), ", ") + ")"
        TTuple(slots) -> "(" + list.join(type_sources(slots), ", ") + ")"
        TFn(params, ret) -> "fn(" + list.join(type_sources(params), ", ") + ") -> " + type_source(ret)
        TQualified(q, inner) -> q + " " + type_source(inner)

// `derive(Show)` -> constructor-shaped rendering with each field/payload rendered
// through its own `Show` impl. Primitive fields still match `__render`, while
// fields with custom `Show` keep their public display form. Generic parameters
// carry a `: Show` bound, so the same code path compiles coherently on both
// backends.
pub fn derive_show(t: TypeInfo) -> String:
    let head = "impl Show for " + target_with_params(t) + where_each(t.params, "Show") + ":\n    fn show(self) -> String:\n"
    match t.kind:
        TypeRecord -> head + "        " + record_show_body(t.name, t.fields) + "\n"
        _ ->
            var arms = []
            for v in t.variants:
                arms = list.push(arms, variant_show_arm(v))
            head + "        match self:\n" + list.join(arms, "\n") + "\n"

// The rendered body of a record's `show`: `"Name"` for a defensive empty-field
// record input, else `"Name(" + show(self.f1) + ", " + show(self.f2) + ")"`.
fn record_show_body(name: String, fields: List(FieldInfo)) -> String:
    if list.is_empty(fields):
        "\"" + name + "\""
    else:
        var parts = []
        for f in fields:
            parts = list.push(parts, "show(self." + f.name + ")")
        "\"" + name + "(\" + " + list.join(parts, " + \", \" + ") + " + \")\""

// One arm of a sum type's `show`: bind the variant's payloads and render them
// through their own `Show` (a nullary variant is just its name).
fn variant_show_arm(v: VariantInfo) -> String:
    var pats = []
    var parts = []
    var i = 0
    for _ft in v.field_type_exprs:
        pats = list.push(pats, "p${i}")
        parts = list.push(parts, "show(p${i})")
        i = i + 1
    var selfpat = v.name
    if list.length(pats) > 0:
        selfpat = v.name + "(" + list.join(pats, ", ") + ")"
    var rhs = "\"" + v.name + "\""
    if list.length(parts) > 0:
        rhs = "\"" + v.name + "(\" + " + list.join(parts, " + \", \" + ") + " + \")\""
    "            " + selfpat + " -> " + rhs

// `derive(Eq)` → the total-equality marker. Refines `PartialEq` (derive both).
pub fn derive_eq(t: TypeInfo) -> String:
    "impl Eq for " + target_with_params(t) + where_each(t.params, "Eq") + "\n"

// `derive(PartialEq)` → field-wise structural equality. The operators dispatch
// per field, so it is content-correct on both backends: a record compares each
// field with `==`; a sum type matches the variant and compares payloads.
pub fn derive_partial_eq(t: TypeInfo) -> String:
    let head = "impl PartialEq for " + target_with_params(t) + where_each(t.params, "PartialEq") + ":\n    fn eq(self, other: " + target_with_params(t) + ") -> Bool:\n"
    match t.kind:
        TypeRecord -> head + "        " + record_eq_body(t.fields) + "\n"
        _ ->
            var arms = []
            for v in t.variants:
                arms = list.push(arms, variant_eq_arm(v))
            head + "        match self:\n" + list.join(arms, "\n") + "\n"

// The `&&`-chained field comparison of a record's `eq`, or `true` for a
// defensive empty-field record input.
fn record_eq_body(fields: List(FieldInfo)) -> String:
    if list.is_empty(fields):
        "true"
    else:
        var terms = []
        for f in fields:
            terms = list.push(terms, "self." + f.name + " == other." + f.name)
        list.join(terms, " && ")

// One arm of a sum type's `eq`: match `other` against the same variant, compare
// payloads pairwise, and fail on any other variant.
fn variant_eq_arm(v: VariantInfo) -> String:
    var pats = []
    var opats = []
    var terms = []
    var i = 0
    for _ft in v.field_type_exprs:
        pats = list.push(pats, "p${i}")
        opats = list.push(opats, "o${i}")
        terms = list.push(terms, "p${i} == o${i}")
        i = i + 1
    var selfpat = v.name
    var otherpat = v.name
    if list.length(pats) > 0:
        selfpat = v.name + "(" + list.join(pats, ", ") + ")"
        otherpat = v.name + "(" + list.join(opats, ", ") + ")"
    var rhs = "true"
    if list.length(terms) > 0:
        rhs = list.join(terms, " && ")
    "            " + selfpat + " -> match other:\n                " + otherpat + " -> " + rhs + "\n                _ -> false"

// The `reflect`-call for a field/payload of declared type `ty` applied to the
// expression text `value` — single-line, dispatched by structured type shape.
fn reflect_call(ty: TypeExpr, value: String) -> String:
    match ty:
        TNamed(name, _args) ->
            if name == "List":
                "reflect.reflect_list(" + value + ")"
            else if name == "Option":
                "reflect.reflect_option(" + value + ")"
            else:
                "reflect.reflect_one(" + value + ")"
        _ -> "reflect.reflect_one(" + value + ")"

// `derive(Reflect)` → an `impl Reflect for T` building the value's `Mirror`: a
// record to `MRecord("T", [(field, reflect field)…])`, a sum type to a `match`
// over variants to `MVariant`. (The module must `import reflect`; caller checks.)
pub fn derive_reflect(t: TypeInfo) -> String:
    let head = "import reflect\n\nimpl Reflect for " + target_with_params(t) + where_each(t.params, "Reflect") + ":\n    fn reflect(self) -> reflect.Mirror:\n"
    if let TypeRecord = t.kind:
        var pairs = []
        for f in t.fields:
            pairs = list.push(pairs, "(\"" + f.name + "\", " + reflect_call(f.type_expr, "self." + f.name) + ")")
        head + "        reflect.MRecord(\"" + t.name + "\", [" + list.join(pairs, ", ") + "])\n"
    else:
        var arms = []
        for v in t.variants:
            var pats = []
            var refls = []
            var i = 0
            for ft in v.field_type_exprs:
                let pv = "p${i}"
                pats = list.push(pats, pv)
                refls = list.push(refls, reflect_call(ft, pv))
                i = i + 1
            var pat = v.name
            if list.length(pats) > 0:
                pat = v.name + "(" + list.join(pats, ", ") + ")"
            arms = list.push(arms, "            " + pat + " -> reflect.MVariant(\"" + t.name + "\", \"" + v.name + "\", [" + list.join(refls, ", ") + "])")
        head + "        match self:\n" + list.join(arms, "\n") + "\n"

// The lexicographic body for `derive(Ord)`: compare fields in declaration order
// through the field type's total `Ord.compare`, not through `<`/`>`. Method
// syntax avoids shadowing by a same-module free function named `compare`.
fn ord_lexicographic_body(fields: List(FieldInfo), index: Int, indent: String) -> String:
    if index >= list.length(fields):
        indent + "Equal\n"
    else:
        let f = list.at(fields, index)
        indent + "match self." + f.name + ".compare(other." + f.name + "):\n" + indent + "    Less -> Less\n" + indent + "    Greater -> Greater\n" + indent + "    Equal ->\n" + ord_lexicographic_body(fields, index + 1, indent + "        ")

// The lexicographic body for `derive(PartialOrd)`: propagate an incomparable
// field (`None`) instead of treating "neither less nor greater" as equality.
fn partial_ord_lexicographic_body(fields: List(FieldInfo), index: Int, indent: String) -> String:
    if index >= list.length(fields):
        indent + "Some(Equal)\n"
    else:
        let f = list.at(fields, index)
        indent + "match self." + f.name + ".partial_compare(other." + f.name + "):\n" + indent + "    None -> None\n" + indent + "    Some(Less) -> Some(Less)\n" + indent + "    Some(Greater) -> Some(Greater)\n" + indent + "    Some(Equal) ->\n" + partial_ord_lexicographic_body(fields, index + 1, indent + "        ")

// `derive(Ord)` → lexicographic `compare` returning `Ordering` (records only; the
// caller validates the shape). Requires the `PartialEq`/`Eq`/`PartialOrd` impls too.
pub fn derive_ord(t: TypeInfo) -> String:
    "impl Ord for " + target_with_params(t) + where_each(t.params, "Ord") + ":\n    fn compare(self, other: " + target_with_params(t) + ") -> Ordering:\n" + ord_lexicographic_body(t.fields, 0, "        ")

// `derive(PartialOrd)` → lexicographic `partial_compare` (records only).
pub fn derive_partial_ord(t: TypeInfo) -> String:
    "impl PartialOrd for " + target_with_params(t) + where_each(t.params, "PartialOrd") + ":\n    fn partial_compare(self, other: " + target_with_params(t) + ") -> Option(Ordering):\n" + partial_ord_lexicographic_body(t.fields, 0, "        ")

// A `Result`-producing decode of a `Json` value already in hand (recursive).
fn json_decode_value(ty: TypeExpr, value: String) -> String:
    match ty:
        // An `Option` value already in hand: JSON `null` decodes to `None`,
        // anything else applies the element decoder and wraps `Some`. Reuses
        // `json.optional` (which maps `Some(JsonNull) -> None`) so it composes
        // at any depth — inside a `List`, another `Option`, or a record field.
        TNamed(name, args) ->
            if name == "Int":
                "json.int_of(" + value + ")"
            else if name == "Float":
                "json.float_of(" + value + ")"
            else if name == "Bool":
                "json.bool_of(" + value + ")"
            else if name == "String":
                "json.string_of(" + value + ")"
            else if name == "List" && list.length(args) == 1:
                let elem = list.at(args, 0)
                "result.all(list.map(json.array_of(" + value + ")?, fn(__e: json.Json) -> Result(" + type_source(elem) + ", json.DeserializeError): " + json_decode_value(elem, "__e") + "))"
            else if name == "Option" && list.length(args) == 1:
                let elem = list.at(args, 0)
                "json.optional(Some(" + value + "), fn(__e: json.Json) -> Result(" + type_source(elem) + ", json.DeserializeError): " + json_decode_value(elem, "__e") + ")"
            else:
                type_source(ty) + ".from_json(" + value + ")"
        _ -> type_source(ty) + ".from_json(" + value + ")"

// Decode one record field from `object`: an Option reads with `get` (absent
// allowed), everything else with `require`. Trails a `?` so it's a `let` initializer.
fn json_decode_field(ty: TypeExpr, object: String, key: String) -> String:
    match ty:
        TNamed(name, args) ->
            if name == "Option" && list.length(args) == 1:
                let elem = list.at(args, 0)
                "json.optional(json.get(" + object + ", \"" + key + "\"), fn(__e: json.Json) -> Result(" + type_source(elem) + ", json.DeserializeError): " + json_decode_value(elem, "__e") + ")?"
            else:
                json_decode_value(ty, "json.require(" + object + ", \"" + key + "\")?") + "?"
        _ -> json_decode_value(ty, "json.require(" + object + ", \"" + key + "\")?") + "?"

// `derive(Deserialize)` generates `from_json` for a record (the caller validates the
// shape). It decodes and coerces each field, returning on the first error. There is
// no matching `Serialize` derive, because reflection (`json.from_value`, `stringify`,
// `Into(Json)`) already encodes any value, so only this reconstruction is per-type.
// The generated code uses only json/result/list/option.
pub fn derive_deserialize(t: TypeInfo) -> String:
    var lets = []
    var names = []
    var i = 0
    for f in t.fields:
        let local = "__field${i}"
        lets = list.push(lets, "        let " + local + " = " + json_decode_field(f.type_expr, "__j", f.name) + "\n")
        names = list.push(names, local)
        i = i + 1
    let from_json = "    fn from_json(__j: json.Json) -> Result(Self, json.DeserializeError):\n" + list.join(lets, "") + "        Ok(" + t.name + "(" + list.join(names, ", ") + "))\n"
    // The generated body makes module-qualified calls (json.*, list.map, result.all);
    // emitted source is parsed on its own, so it must carry those imports for the
    // parser to qualify them (comptime merges them into the module). A generic type's
    // impl carries its parameters and a `: Deserialize` bound per parameter — the same
    // `target_with_params`/`where_each` convention every other standard derive uses —
    // so `Box(a)` reconstructs coherently (each `a` field decodes via `a`'s bound).
    "import json\nimport list\nimport result\n\nimpl Deserialize for " + target_with_params(t) + where_each(t.params, "Deserialize") + ":\n" + from_json
