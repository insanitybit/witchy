// Compile-time type introspection — the `typeInfo` half of witchy's comptime
// reflection (Zig's `@typeInfo`). A `comptime:` block can read the structure of
// every type in its module as ordinary data and generate code from it (e.g. a
// `to_json` specialized to a record's fields), with zero runtime cost. The
// compiler injects the type list as the `module_types` value; these are the
// shapes it hands you.
//
// This is COMPILE-TIME structure (field names + declared type expressions),
// distinct from `std/reflect`'s runtime `Mirror` (a value's structure at runtime).

// RFC-0080 first slice: a typed boundary for whole generated items. The compiler
// still stores the payload as source while the structured syntax API grows, but
// comptime code can hand `emit_item` an `ItemSyntax` instead of printing raw text.
sealed type ItemSyntax:
    ItemSyntax(String)

sealed type TypeSyntax:
    TypeSyntax(String)

sealed type ExprSyntax:
    ExprSyntax(String)

sealed type PatternSyntax:
    PatternSyntax(String)

sealed type StmtSyntax:
    StmtSyntax(String)

sealed type BlockSyntax:
    BlockSyntax(String)

sealed type MatchArmSyntax:
    MatchArmSyntax(String)

sealed type ParamSyntax:
    ParamSyntax(String)

sealed type Ident:
    Ident(String)

// A source-backed item wrapper. This is the migration bridge from today's
// source-emitting generators toward structured constructors and quotation.
pub fn item(source: String) -> ItemSyntax:
    ItemSyntax(source)

// A validated Witchy identifier. This rejects keywords, `_`, non-ASCII source
// spelling, and compiler-reserved `__` names before generated source is parsed.
pub fn ident(name: String) -> Ident:
    if !is_identifier(name):
        fail("meta.ident: invalid identifier `" + name + "`")
    Ident(name)

pub fn is_identifier(name: String) -> Bool:
    let n = string.char_count(name)
    if n == 0 || name == "_" || is_keyword(name) || string.contains(name, "__"):
        false
    else:
        var ok = is_ident_start(string.substring(name, 0, 1))
        var i = 1
        while i < n:
            if !is_ident_continue(string.substring(name, i, i + 1)):
                ok = false
            i = i + 1
        ok

fn ident_source(id: Ident) -> String:
    match id:
        Ident(source) -> source

fn is_ident_start(c: String) -> Bool:
    c == "_" || "a" <= c && c <= "z" || "A" <= c && c <= "Z"

fn is_ident_continue(c: String) -> Bool:
    is_ident_start(c) || "0" <= c && c <= "9"

fn is_keyword(name: String) -> Bool:
    match name:
        "fn" -> true
        "gen" -> true
        "yield" -> true
        "async" -> true
        "await" -> true
        "let" -> true
        "var" -> true
        "match" -> true
        "pub" -> true
        "if" -> true
        "else" -> true
        "true" -> true
        "false" -> true
        "type" -> true
        "own" -> true
        "move" -> true
        "import" -> true
        "while" -> true
        "for" -> true
        "in" -> true
        "return" -> true
        "break" -> true
        "continue" -> true
        "trait" -> true
        "impl" -> true
        "where" -> true
        "as" -> true
        "region" -> true
        "comptime" -> true
        "capability" -> true
        _ -> false

// Source-backed type syntax. Prefer this to assembling type names at each
// generator call site; it is still a migration helper, not full hygiene.
pub fn type_named(name: Ident, args: List(TypeSyntax)) -> TypeSyntax:
    type_with_head(ident_source(name), args)

pub fn type_qualified(module: Ident, name: Ident, args: List(TypeSyntax)) -> TypeSyntax:
    type_with_head(ident_source(module) + "." + ident_source(name), args)

// A tuple type such as `(Int, String)`.
pub fn type_tuple(types: List(TypeSyntax)) -> TypeSyntax:
    TypeSyntax("(" + list.join(type_syntax_sources(types), ", ") + ")")

// A function type such as `fn(Int) -> String`.
pub fn type_fn(params: List(TypeSyntax), ret: TypeSyntax) -> TypeSyntax:
    TypeSyntax("fn(" + list.join(type_syntax_sources(params), ", ") + ") -> " + type_syntax_source(ret))

// A deeply immutable type qualifier.
pub fn type_frozen(ty: TypeSyntax) -> TypeSyntax:
    TypeSyntax("frozen " + type_syntax_source(ty))

// A unique-reference type qualifier.
pub fn type_unique(ty: TypeSyntax) -> TypeSyntax:
    TypeSyntax("unique " + type_syntax_source(ty))

// A local unique-reference type qualifier.
pub fn type_local_unique(ty: TypeSyntax) -> TypeSyntax:
    TypeSyntax("local unique " + type_syntax_source(ty))

// A capability type with rights, such as `Dir[Read]`.
pub fn type_capability(name: Ident, rights: List(TypeSyntax)) -> TypeSyntax:
    let head = ident_source(name)
    if head != "Dir" && head != "File" && head != "Net":
        fail("meta.type_capability: expected Dir, File, or Net")
    TypeSyntax(head + "[" + list.join(type_syntax_sources(rights), ", ") + "]")

fn type_with_head(head: String, args: List(TypeSyntax)) -> TypeSyntax:
    if list.is_empty(args):
        TypeSyntax(head)
    else:
        TypeSyntax(head + "(" + list.join(type_syntax_sources(args), ", ") + ")")

pub fn type_expr(ty: TypeExpr) -> TypeSyntax:
    TypeSyntax(type_source(ty))

// Join parser-checked type quote fragments with typed type holes.
pub fn type_join(parts: List(String), holes: List(TypeSyntax)) -> TypeSyntax:
    if list.length(parts) != list.length(holes) + 1:
        fail("meta.type_join: expected one more part than hole")

    var out = list.at(parts, 0)
    var i = 0
    while i < list.length(holes):
        out = out + type_syntax_source(list.at(holes, i)) + list.at(parts, i + 1)
        i = i + 1
    TypeSyntax(out)

fn type_syntax_source(ty: TypeSyntax) -> String:
    match ty:
        TypeSyntax(source) -> source

fn type_syntax_sources(types: List(TypeSyntax)) -> List(String):
    var out = []
    for ty in types:
        out = list.push(out, type_syntax_source(ty))
    out

// Source-backed expression syntax. These constructors make the shape explicit
// while quotation/hygienic identifiers are still pending.
pub fn expr_name(name: Ident) -> ExprSyntax:
    ExprSyntax(ident_source(name))

pub fn expr_call(callee: ExprSyntax, args: List(ExprSyntax)) -> ExprSyntax:
    ExprSyntax(expr_source(callee) + "(" + list.join(expr_sources(args), ", ") + ")")

pub fn expr_field(base: ExprSyntax, field: Ident) -> ExprSyntax:
    ExprSyntax(expr_source(base) + "." + ident_source(field))

pub fn expr_int(n: Int) -> ExprSyntax:
    ExprSyntax("${n}")

pub fn expr_bool(b: Bool) -> ExprSyntax:
    ExprSyntax(if b: "true" else: "false")

pub fn expr_match(scrutinee: ExprSyntax, arms: List(MatchArmSyntax)) -> ExprSyntax:
    if list.is_empty(arms):
        fail("meta.expr_match: at least one match arm is required")
    ExprSyntax("match " + expr_source(scrutinee) + ":\n" + indent(list.join(match_arm_sources(arms), "\n")))

pub fn expr_raw(source: String) -> ExprSyntax:
    ExprSyntax(source)

// Join parser-checked expression quote fragments with typed expression holes.
// `parts` must have exactly one more element than `holes`, as in string
// interpolation: part0, hole0, part1, ...
pub fn expr_join(parts: List(String), holes: List(ExprSyntax)) -> ExprSyntax:
    if list.length(parts) != list.length(holes) + 1:
        fail("meta.expr_join: expected one more part than hole")

    var out = list.at(parts, 0)
    var i = 0
    while i < list.length(holes):
        out = out + expr_source(list.at(holes, i)) + list.at(parts, i + 1)
        i = i + 1
    ExprSyntax(out)

fn expr_source(expr: ExprSyntax) -> String:
    match expr:
        ExprSyntax(source) -> source

fn expr_sources(exprs: List(ExprSyntax)) -> List(String):
    var out = []
    for expr in exprs:
        out = list.push(out, expr_source(expr))
    out

// Source-backed pattern syntax. Patterns share validated identifiers with
// expressions, so generated matches cannot accidentally mint a reserved binding.
pub fn pattern_var(name: Ident) -> PatternSyntax:
    PatternSyntax(ident_source(name))

pub fn pattern_wildcard() -> PatternSyntax:
    PatternSyntax("_")

pub fn pattern_int(n: Int) -> PatternSyntax:
    PatternSyntax("${n}")

pub fn pattern_bool(b: Bool) -> PatternSyntax:
    PatternSyntax(if b: "true" else: "false")

// A string literal pattern.
pub fn pattern_str(value: String) -> PatternSyntax:
    PatternSyntax(string_literal(value))

// A duration literal pattern from its whole-millisecond value.
pub fn pattern_duration_ms(ms: Int) -> PatternSyntax:
    PatternSyntax("${ms}ms")

// An integer range pattern.
pub fn pattern_range(lo: Int, hi: Int, inclusive: Bool) -> PatternSyntax:
    let op = if inclusive: "..=" else: ".."
    PatternSyntax("${lo}" + op + "${hi}")

pub fn pattern_ctor(name: Ident, args: List(PatternSyntax)) -> PatternSyntax:
    pattern_with_head(ident_source(name), args)

// A module-qualified constructor pattern such as `iter.Item(x)`.
pub fn pattern_qualified_ctor(module: Ident, name: Ident, args: List(PatternSyntax)) -> PatternSyntax:
    pattern_with_head(ident_source(module) + "." + ident_source(name), args)

pub fn pattern_anon_ctor(tag: Ident, args: List(PatternSyntax)) -> PatternSyntax:
    pattern_with_head("." + ident_source(tag), args)

// A tuple pattern.
pub fn pattern_tuple(patterns: List(PatternSyntax)) -> PatternSyntax:
    PatternSyntax("(" + list.join(pattern_sources(patterns), ", ") + ")")

// An exact-length list pattern.
pub fn pattern_list(patterns: List(PatternSyntax)) -> PatternSyntax:
    PatternSyntax("[" + list.join(pattern_sources(patterns), ", ") + "]")

// A list pattern with `..` or `..rest`.
pub fn pattern_list_rest(patterns: List(PatternSyntax), rest: Option(Ident)) -> PatternSyntax:
    let parts = pattern_sources(patterns)
    let tail = match rest:
        Some(name) -> ".." + ident_source(name)
        None -> ".."

    PatternSyntax("[" + list.join(list.push(parts, tail), ", ") + "]")

// An or-pattern. Every alternative must bind the same names when type-checked.
pub fn pattern_or(patterns: List(PatternSyntax)) -> PatternSyntax:
    if list.is_empty(patterns):
        fail("meta.pattern_or: at least one alternative is required")
    PatternSyntax(list.join(pattern_sources(patterns), " | "))

// Join parser-checked pattern quote fragments with typed pattern holes.
pub fn pattern_join(parts: List(String), holes: List(PatternSyntax)) -> PatternSyntax:
    if list.length(parts) != list.length(holes) + 1:
        fail("meta.pattern_join: expected one more part than hole")

    var out = list.at(parts, 0)
    var i = 0
    while i < list.length(holes):
        out = out + pattern_source(list.at(holes, i)) + list.at(parts, i + 1)
        i = i + 1
    PatternSyntax(out)

fn pattern_with_head(head: String, args: List(PatternSyntax)) -> PatternSyntax:
    if list.is_empty(args):
        PatternSyntax(head)
    else:
        PatternSyntax(head + "(" + list.join(pattern_sources(args), ", ") + ")")

fn pattern_source(pattern: PatternSyntax) -> String:
    match pattern:
        PatternSyntax(source) -> source

fn pattern_sources(patterns: List(PatternSyntax)) -> List(String):
    var out = []
    for pattern in patterns:
        out = list.push(out, pattern_source(pattern))
    out

fn string_literal(value: String) -> String:
    var out = "\""
    for c in string.chars(value):
        if c == "\"":
            out = out + "\\\""
        else if c == "\\":
            out = out + "\\\\"
        else if c == "\n":
            out = out + "\\n"
        else if c == "\t":
            out = out + "\\t"
        else if c == "\r":
            out = out + "\\r"
        else if c == "\0":
            out = out + "\\0"
        else:
            out = out + c
    out + "\""

pub fn match_arm(pattern: PatternSyntax, body: ExprSyntax) -> MatchArmSyntax:
    MatchArmSyntax(pattern_source(pattern) + " -> " + expr_source(body))

fn match_arm_source(arm: MatchArmSyntax) -> String:
    match arm:
        MatchArmSyntax(source) -> source

fn match_arm_sources(arms: List(MatchArmSyntax)) -> List(String):
    var out = []
    for arm in arms:
        out = list.push(out, match_arm_source(arm))
    out

// Source-backed statement and block syntax. These are still text at the
// compiler boundary, but they make block-shaped generators compose through
// typed, validated pieces instead of one large string template.
pub fn stmt_let(mutable: Bool, name: Ident, ty: Option(TypeSyntax), value: ExprSyntax) -> StmtSyntax:
    let binding = if mutable: "var " else: "let "
    let ty_source = match ty:
        Some(t) -> ": " + type_syntax_source(t)
        None -> ""

    StmtSyntax(binding + ident_source(name) + ty_source + " = " + expr_source(value))

pub fn stmt_expr(expr: ExprSyntax) -> StmtSyntax:
    StmtSyntax(expr_source(expr))

pub fn stmt_return(value: ExprSyntax) -> StmtSyntax:
    StmtSyntax("return " + expr_source(value))

pub fn stmt_return_none() -> StmtSyntax:
    StmtSyntax("return")

// A source-backed statement wrapper for parser-checked `quote stmt:`.
pub fn stmt_raw(source: String) -> StmtSyntax:
    StmtSyntax(source)

pub fn block(stmts: List(StmtSyntax), tail: Option(ExprSyntax)) -> BlockSyntax:
    let lines = block_lines(stmts, tail)
    if list.is_empty(lines):
        fail("meta.block: body must contain at least one statement or tail expression")
    BlockSyntax(list.join(lines, "\n"))

// A source-backed block wrapper for parser-checked `quote block:`.
pub fn block_raw(source: String) -> BlockSyntax:
    BlockSyntax(source)

fn block_lines(stmts: List(StmtSyntax), tail: Option(ExprSyntax)) -> List(String):
    let lines = stmt_sources(stmts)
    match tail:
        Some(expr) -> list.push(lines, expr_source(expr))
        None -> lines

fn block_source(body: BlockSyntax) -> String:
    match body:
        BlockSyntax(source) -> source

fn stmt_source(stmt: StmtSyntax) -> String:
    match stmt:
        StmtSyntax(source) -> source

fn stmt_sources(stmts: List(StmtSyntax)) -> List(String):
    var out = []
    for stmt in stmts:
        out = list.push(out, stmt_source(stmt))
    out

fn indent(source: String) -> String:
    var out = []
    for line in string.split(source, "\n"):
        out = list.push(out, "    " + line)
    list.join(out, "\n")

// A function parameter and function item constructors. The single-expression
// form now delegates to the block form so item generation has one body shape.
pub fn param(name: Ident, ty: TypeSyntax) -> ParamSyntax:
    ParamSyntax(ident_source(name) + ": " + type_syntax_source(ty))

fn param_source(param: ParamSyntax) -> String:
    match param:
        ParamSyntax(source) -> source

fn param_sources(params: List(ParamSyntax)) -> List(String):
    var out = []
    for p in params:
        out = list.push(out, param_source(p))
    out

pub fn function(public: Bool, name: Ident, params: List(ParamSyntax), ret: Option(TypeSyntax), body: ExprSyntax) -> ItemSyntax:
    function_block(public, name, params, ret, block([], Some(body)))

pub fn function_block(public: Bool, name: Ident, params: List(ParamSyntax), ret: Option(TypeSyntax), body: BlockSyntax) -> ItemSyntax:
    let visibility = if public: "pub " else: ""
    let ret_source = match ret:
        Some(ty) -> " -> " + type_syntax_source(ty)
        None -> ""

    item(visibility + "fn " + ident_source(name) + "(" + list.join(param_sources(params), ", ") + ")" + ret_source + ":\n" + indent(block_source(body)))

// A declared type expression, exposed as data so generators do not have to parse
// source-looking type strings.
type TypeExpr:
    TNamed(String, List(TypeExpr))
    TTuple(List(TypeExpr))
    TFn(List(TypeExpr), TypeExpr)
    TQualified(String, TypeExpr)

// The declaration shape. `TypeUninhabited` is intentionally not called "unit":
// a fieldless declaration has no constructor and therefore no values.
type TypeKind:
    TypeRecord
    TypeSum
    TypeUninhabited

// One field of a record: its name and declared type.
type FieldInfo:
    name: String
    type_expr: TypeExpr

// One constructor of a sum type: its name and positional payload types.
type VariantInfo:
    name: String
    field_type_exprs: List(TypeExpr)

// A type's structure. `fields` is populated for records and `variants` for sums;
// both are empty for an uninhabited fieldless declaration.
type TypeInfo:
    name: String
    kind: TypeKind
    params: List(String)
    fields: List(FieldInfo)
    variants: List(VariantInfo)

// --- built-in derive generators ----------------------------------------------
// Built-in `derive(X)` desugars to a comptime call `meta.derive_<x>(typeInfo)`
// that returns an `ItemSyntax`. These ARE witchy — the per-trait code generation that used to be
// hardcoded in the Rust compiler now lives here as ordinary, readable functions over
// `TypeInfo`, and anyone can write their own `derive_foo` the same way.

// The impl target with its type parameters — `Box(a)` for a generic type, `Point`
// otherwise. Also the type of a same-typed `other` parameter.
fn target_with_params(t: TypeInfo) -> String:
    if list.is_empty(t.params):
        t.name
    else:
        t.name + "(" + list.join(t.params, ", ") + ")"

// A ` where a: Trait, b: Trait` clause binding each type parameter to `trait_name`,
// or "" for a non-generic type — so a generic type's derived impl discharges its
// parameters' bounds and monomorphizes per argument.
fn where_each(params: List(String), trait_name: String) -> String:
    if list.is_empty(params):
        ""
    else:
        var bounds = []
        for p in params:
            bounds = list.push(bounds, p + ": " + trait_name)
        " where " + list.join(bounds, ", ")

fn type_sources(types: List(TypeExpr)) -> List(String):
    var out = []
    for ty in types:
        out = list.push(out, type_source(ty))
    out

// Render a structured type back to source text only when generated source needs
// to name the type. Semantic branching should stay on `TypeExpr`, not this
// string.
pub fn type_source(ty: TypeExpr) -> String:
    match ty:
        TNamed(name, args) ->
            if list.is_empty(args):
                name
            else:
                name + "(" + list.join(type_sources(args), ", ") + ")"
        TTuple(slots) -> "(" + list.join(type_sources(slots), ", ") + ")"
        TFn(params, ret) -> "fn(" + list.join(type_sources(params), ", ") + ") -> " + type_source(ret)
        TQualified(q, inner) -> q + " " + type_source(inner)

// `derive(Show)` -> constructor-shaped rendering with each field/payload rendered
// through its own `Show` impl. Primitive fields still match structural
// interpolation bytes, while fields with custom `Show` keep their public display
// form. Generic parameters carry a `: Show` bound, so the same code path compiles
// coherently on both backends.
pub fn derive_show(t: TypeInfo) -> ItemSyntax:
    item(derive_show_source(t))

fn derive_show_source(t: TypeInfo) -> String:
    let head = "impl Show for " + target_with_params(t) + where_each(t.params, "Show") + ":\n    fn show(self) -> String:\n"
    match t.kind:
        TypeRecord -> head + "        " + record_show_body(t.name, t.fields) + "\n"
        _ ->
            var arms = []
            for v in t.variants:
                arms = list.push(arms, variant_show_arm(v))
            head + "        match self:\n" + list.join(arms, "\n") + "\n"

// The rendered body of a record's `show`: `"Name"` for a defensive empty-field
// record input, else `"Name(" + show(self.f1) + ", " + show(self.f2) + ")"`.
fn record_show_body(name: String, fields: List(FieldInfo)) -> String:
    if list.is_empty(fields):
        "\"" + name + "\""
    else:
        var parts = []
        for f in fields:
            parts = list.push(parts, "show(self." + f.name + ")")
        "\"" + name + "(\" + " + list.join(parts, " + \", \" + ") + " + \")\""

// One arm of a sum type's `show`: bind the variant's payloads and render them
// through their own `Show` (a nullary variant is just its name).
fn variant_show_arm(v: VariantInfo) -> String:
    var pats = []
    var parts = []
    var i = 0
    for _ft in v.field_type_exprs:
        pats = list.push(pats, "p${i}")
        parts = list.push(parts, "show(p${i})")
        i = i + 1
    var selfpat = v.name
    if list.length(pats) > 0:
        selfpat = v.name + "(" + list.join(pats, ", ") + ")"
    var rhs = "\"" + v.name + "\""
    if list.length(parts) > 0:
        rhs = "\"" + v.name + "(\" + " + list.join(parts, " + \", \" + ") + " + \")\""
    "            " + selfpat + " -> " + rhs

// `derive(Eq)` → the total-equality marker. Refines `PartialEq` (derive both).
pub fn derive_eq(t: TypeInfo) -> ItemSyntax:
    item(derive_eq_source(t))

fn derive_eq_source(t: TypeInfo) -> String:
    "impl Eq for " + target_with_params(t) + where_each(t.params, "Eq") + "\n"

// `derive(PartialEq)` → field-wise structural equality. The operators dispatch
// per field, so it is content-correct on both backends: a record compares each
// field with `==`; a sum type matches the variant and compares payloads.
pub fn derive_partial_eq(t: TypeInfo) -> ItemSyntax:
    item(derive_partial_eq_source(t))

fn derive_partial_eq_source(t: TypeInfo) -> String:
    let head = "impl PartialEq for " + target_with_params(t) + where_each(t.params, "PartialEq") + ":\n    fn eq(self, other: " + target_with_params(t) + ") -> Bool:\n"
    match t.kind:
        TypeRecord -> head + "        " + record_eq_body(t.fields) + "\n"
        _ ->
            var arms = []
            for v in t.variants:
                arms = list.push(arms, variant_eq_arm(v))
            head + "        match self:\n" + list.join(arms, "\n") + "\n"

// The `&&`-chained field comparison of a record's `eq`, or `true` for a
// defensive empty-field record input.
fn record_eq_body(fields: List(FieldInfo)) -> String:
    if list.is_empty(fields):
        "true"
    else:
        var terms = []
        for f in fields:
            terms = list.push(terms, "self." + f.name + " == other." + f.name)
        list.join(terms, " && ")

// One arm of a sum type's `eq`: match `other` against the same variant, compare
// payloads pairwise, and fail on any other variant.
fn variant_eq_arm(v: VariantInfo) -> String:
    var pats = []
    var opats = []
    var terms = []
    var i = 0
    for _ft in v.field_type_exprs:
        pats = list.push(pats, "p${i}")
        opats = list.push(opats, "o${i}")
        terms = list.push(terms, "p${i} == o${i}")
        i = i + 1
    var selfpat = v.name
    var otherpat = v.name
    if list.length(pats) > 0:
        selfpat = v.name + "(" + list.join(pats, ", ") + ")"
        otherpat = v.name + "(" + list.join(opats, ", ") + ")"
    var rhs = "true"
    if list.length(terms) > 0:
        rhs = list.join(terms, " && ")
    "            " + selfpat + " -> match other:\n                " + otherpat + " -> " + rhs + "\n                _ -> false"

// The `reflect`-call for a field/payload of declared type `ty` applied to the
// expression text `value` — single-line, dispatched by structured type shape.
fn reflect_call(ty: TypeExpr, value: String) -> String:
    match ty:
        TNamed(name, _args) ->
            if name == "List":
                "reflect.reflect_list(" + value + ")"
            else if name == "Option":
                "reflect.reflect_option(" + value + ")"
            else:
                "reflect.reflect_one(" + value + ")"
        _ -> "reflect.reflect_one(" + value + ")"

// `derive(Reflect)` → an `impl Reflect for T` building the value's `Mirror`: a
// record to `MRecord("T", [(field, reflect field)…])`, a sum type to a `match`
// over variants to `MVariant`. (The module must `import reflect`; caller checks.)
pub fn derive_reflect(t: TypeInfo) -> ItemSyntax:
    item(derive_reflect_source(t))

fn derive_reflect_source(t: TypeInfo) -> String:
    let head = "import reflect\n\nimpl Reflect for " + target_with_params(t) + where_each(t.params, "Reflect") + ":\n    fn reflect(self) -> reflect.Mirror:\n"
    if let TypeRecord = t.kind:
        var pairs = []
        for f in t.fields:
            pairs = list.push(pairs, "(\"" + f.name + "\", " + reflect_call(f.type_expr, "self." + f.name) + ")")
        head + "        reflect.MRecord(\"" + t.name + "\", [" + list.join(pairs, ", ") + "])\n"
    else:
        var arms = []
        for v in t.variants:
            var pats = []
            var refls = []
            var i = 0
            for ft in v.field_type_exprs:
                let pv = "p${i}"
                pats = list.push(pats, pv)
                refls = list.push(refls, reflect_call(ft, pv))
                i = i + 1
            var pat = v.name
            if list.length(pats) > 0:
                pat = v.name + "(" + list.join(pats, ", ") + ")"
            arms = list.push(arms, "            " + pat + " -> reflect.MVariant(\"" + t.name + "\", \"" + v.name + "\", [" + list.join(refls, ", ") + "])")
        head + "        match self:\n" + list.join(arms, "\n") + "\n"

// The lexicographic body for `derive(Ord)`: compare fields in declaration order
// through the field type's total `Ord.compare`, not through `<`/`>`. Method
// syntax avoids shadowing by a same-module free function named `compare`.
fn ord_lexicographic_body(fields: List(FieldInfo), index: Int, indent: String) -> String:
    if index >= list.length(fields):
        indent + "Equal\n"
    else:
        let f = list.at(fields, index)
        indent + "match self." + f.name + ".compare(other." + f.name + "):\n" + indent + "    Less -> Less\n" + indent + "    Greater -> Greater\n" + indent + "    Equal ->\n" + ord_lexicographic_body(fields, index + 1, indent + "        ")

// The lexicographic body for `derive(PartialOrd)`: propagate an incomparable
// field (`None`) instead of treating "neither less nor greater" as equality.
fn partial_ord_lexicographic_body(fields: List(FieldInfo), index: Int, indent: String) -> String:
    if index >= list.length(fields):
        indent + "Some(Equal)\n"
    else:
        let f = list.at(fields, index)
        indent + "match self." + f.name + ".partial_compare(other." + f.name + "):\n" + indent + "    None -> None\n" + indent + "    Some(Less) -> Some(Less)\n" + indent + "    Some(Greater) -> Some(Greater)\n" + indent + "    Some(Equal) ->\n" + partial_ord_lexicographic_body(fields, index + 1, indent + "        ")

// `derive(Ord)` → lexicographic `compare` returning `Ordering` (records only; the
// caller validates the shape). Requires the `PartialEq`/`Eq`/`PartialOrd` impls too.
pub fn derive_ord(t: TypeInfo) -> ItemSyntax:
    item(derive_ord_source(t))

fn derive_ord_source(t: TypeInfo) -> String:
    "impl Ord for " + target_with_params(t) + where_each(t.params, "Ord") + ":\n    fn compare(self, other: " + target_with_params(t) + ") -> Ordering:\n" + ord_lexicographic_body(t.fields, 0, "        ")

// `derive(PartialOrd)` → lexicographic `partial_compare` (records only).
pub fn derive_partial_ord(t: TypeInfo) -> ItemSyntax:
    item(derive_partial_ord_source(t))

fn derive_partial_ord_source(t: TypeInfo) -> String:
    "impl PartialOrd for " + target_with_params(t) + where_each(t.params, "PartialOrd") + ":\n    fn partial_compare(self, other: " + target_with_params(t) + ") -> Option(Ordering):\n" + partial_ord_lexicographic_body(t.fields, 0, "        ")

// A `Result`-producing decode of a `Json` value already in hand (recursive).
fn json_decode_value(ty: TypeExpr, value: String) -> String:
    match ty:
        // An `Option` value already in hand: JSON `null` decodes to `None`,
        // anything else applies the element decoder and wraps `Some`. Reuses
        // `json.optional` (which maps `Some(JsonNull) -> None`) so it composes
        // at any depth — inside a `List`, another `Option`, or a record field.
        TNamed(name, args) ->
            if name == "Int":
                "json.int_of(" + value + ")"
            else if name == "Float":
                "json.float_of(" + value + ")"
            else if name == "Bool":
                "json.bool_of(" + value + ")"
            else if name == "String":
                "json.string_of(" + value + ")"
            else if name == "List" && list.length(args) == 1:
                let elem = list.at(args, 0)
                "result.all(list.map(json.array_of(" + value + ")?, fn(__e: json.Json) -> Result(" + type_source(elem) + ", json.DeserializeError): " + json_decode_value(elem, "__e") + "))"
            else if name == "Option" && list.length(args) == 1:
                let elem = list.at(args, 0)
                "json.optional(Some(" + value + "), fn(__e: json.Json) -> Result(" + type_source(elem) + ", json.DeserializeError): " + json_decode_value(elem, "__e") + ")"
            else:
                type_source(ty) + ".from_json(" + value + ")"
        _ -> type_source(ty) + ".from_json(" + value + ")"

// Decode one record field from `object`: an Option reads with `get` (absent
// allowed), everything else with `require`. Trails a `?` so it's a `let` initializer.
fn json_decode_field(ty: TypeExpr, object: String, key: String) -> String:
    match ty:
        TNamed(name, args) ->
            if name == "Option" && list.length(args) == 1:
                let elem = list.at(args, 0)
                "json.optional(json.get(" + object + ", \"" + key + "\"), fn(__e: json.Json) -> Result(" + type_source(elem) + ", json.DeserializeError): " + json_decode_value(elem, "__e") + ")?"
            else:
                json_decode_value(ty, "json.require(" + object + ", \"" + key + "\")?") + "?"
        _ -> json_decode_value(ty, "json.require(" + object + ", \"" + key + "\")?") + "?"

// `derive(Deserialize)` generates `from_json` for a record (the caller validates the
// shape). It decodes and coerces each field, returning on the first error. There is
// no matching `Serialize` derive, because reflection (`json.from_value`, `stringify`,
// `Into(Json)`) already encodes any value, so only this reconstruction is per-type.
// The generated code uses only json/result/list/option.
pub fn derive_deserialize(t: TypeInfo) -> ItemSyntax:
    item(derive_deserialize_source(t))

fn derive_deserialize_source(t: TypeInfo) -> String:
    var lets = []
    var names = []
    var i = 0
    for f in t.fields:
        let local = "__field${i}"
        lets = list.push(lets, "        let " + local + " = " + json_decode_field(f.type_expr, "__j", f.name) + "\n")
        names = list.push(names, local)
        i = i + 1
    let from_json = "    fn from_json(__j: json.Json) -> Result(Self, json.DeserializeError):\n" + list.join(lets, "") + "        Ok(" + t.name + "(" + list.join(names, ", ") + "))\n"
    // The generated body makes module-qualified calls (json.*, list.map, result.all);
    // emitted source is parsed on its own, so it must carry those imports for the
    // parser to qualify them (comptime merges them into the module). A generic type's
    // impl carries its parameters and a `: Deserialize` bound per parameter — the same
    // `target_with_params`/`where_each` convention every other standard derive uses —
    // so `Box(a)` reconstructs coherently (each `a` field decodes via `a`'s bound).
    "import json\nimport list\nimport result\n\nimpl Deserialize for " + target_with_params(t) + where_each(t.params, "Deserialize") + ":\n" + from_json
