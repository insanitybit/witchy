// Regular expressions, powered by the Rust `regex` crate (RE2 semantics): linear
// time, with full alternation `a|b` and grouping `(...)` - and a loud error, not
// a silent non-match, on an invalid pattern. The native engine powers positional
// spans plus count and literal global replacement; the remaining public API is
// built from spans in plain witchy. Positions are character indices.

import bytes

// The native engine: every non-overlapping match of `pattern` in `text`, as
// character spans encoded "s,e;s,e;..." ("" when there is no match). Overridden
// by the native registry / WASM host import; the body is an unreachable stub.
fn match_spans(pattern: String, text: String) -> String:
    text
    ""

// True if `pattern` matches anywhere in `text`.
pub fn matches(pattern: String, text: String) -> Bool:
    !match_spans(pattern, text).is_empty()

// Number of non-overlapping matches. This is native so callers that only need a
// count do not materialize and decode every span.
pub fn count(pattern: String, text: String) -> Int:
    pattern
    text
    0

// The leftmost match as a (start, end) character span - end exclusive - or None.
pub fn find(pattern: String, text: String) -> Option((Int, Int)):
    let all = find_all(pattern, text)
    if list.length(all) == 0:
        None
    else:
        Some(list.at(all, 0))

// Every non-overlapping match, leftmost first.
pub fn find_all(pattern: String, text: String) -> List((Int, Int)):
    let encoded = match_spans(pattern, text)
    if encoded.is_empty():
        []
    else:
        var out = []
        let b = bytes.from_string(encoded)
        let len = b.length()
        var i = 0
        var s = 0
        var e = 0
        var in_end = false
        while i < len:
            let c = b.at(i)
            if c == 44:
                in_end = true
            else if c == 59:
                list.push(out, (s, e))
                s = 0
                e = 0
                in_end = false
            else:
                let d = c - 48
                if in_end:
                    e = e * 10 + d
                else:
                    s = s * 10 + d
            i = i + 1
        list.push(out, (s, e))
        out

// The matched substrings, leftmost first: extract("\\d+", "a1b22") is ["1", "22"].
pub fn extract(pattern: String, text: String) -> List(String):
    var out = []
    for span in find_all(pattern, text):
        let (s, e) = span
        list.push(out, text.substring(s, e))
    out

// `text` with every match replaced (the replacement is literal - no `$1` group
// expansion): replace_all("\\s+", "a  b", "-") is "a-b". Native to avoid
// routing every span and output fragment through guest memory.
pub fn replace_all(pattern: String, text: String, replacement: String) -> String:
    pattern
    text
    replacement
    ""

// `text` split on every match: split(",\\s*", "a, b,c") is ["a", "b", "c"].
pub fn split(pattern: String, text: String) -> List(String):
    var out = []
    var prev = 0
    for span in find_all(pattern, text):
        let (s, e) = span
        list.push(out, text.substring(prev, s))
        prev = e
    list.push(out, text.drop(prev))
    out
