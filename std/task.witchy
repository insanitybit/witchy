// std/task — the cooperative task substrate and its executor.
//
// A `Task(a)` is a CPS-over-closures computation that, when stepped, either
// completes (`Done`) or yields an effect back to the executor: cooperate
// (`Yield`), `spawn` a child (`Fork`), `join` one (`Wait`), or a channel op
// (`Open`/`Push`/`Pull`/`PullAny`, produced by `std/chan`). `run` drives a task
// (and everything it spawns) to completion on a deterministic round-robin
// schedule, so a concurrent run is byte-identical on the interpreter and the
// compiled WebAssembly — no scheduler state in the runtime, no `Pin`.
//
// This module is the scheduling core: the `Task` monad, `spawn`/`join`/
// `yield_now`, and the executor. First-class channels are layered on top in
// `std/chan`; lightweight value-returning structured concurrency (`join_all`/
// `select` over independent futures) lives in `std/future`.
//
// Messages: the executor is ERASED (RFC-0055). Its buffers, `Step`, and `Slot`
// carry the opaque `__Msg`, so ONE program can run channels of many different
// message types — a library may use channels privately without forcing its type
// on the whole program. The typed channel endpoints (`Sender(m)`/`Receiver(m)`
// in `std/chan`) erase a message on `send` and recover it on `recv`; the
// erasure is representationally the identity on both backends (a message already
// rides the universal slot), so interleavings stay byte-identical. Spawned tasks
// return `Nil`; a task reports a result by sending it on a channel, not by
// returning it (a typed `JoinHandle(T)` would force a native runtime and break
// the parity contract).
//
// The `async`/`await` CPS transform lowers onto this substrate (`task.lazy`/
// `and_then`/`done`/`run`), so `chan.recv(rx).await` / `chan.send(tx, x).await`
// work in async fns.

import option

// What a task yields to the executor when stepped. `a` is the task's own result.
// The channel effects (`Open`/`Push`/`Pull`/`PullAny`) are produced by `std/chan`;
// the executor below interprets every variant. Messages are the erased `__Msg`
// (RFC-0055) — the typed endpoints (un)wrap at the boundary.
type Step(a):
    Done(a)
    Yield(Task(a))
    Fork(Task(Nil), fn(Int) -> Task(a))
    Open(Int, fn(Int) -> Task(a))
    Push(Int, __Msg, fn(Nil) -> Task(a))
    Pull(Int, fn(Option(__Msg)) -> Task(a))
    PullAny(List(Int), fn(Option((Int, __Msg))) -> Task(a))
    Wait(Int, fn(Nil) -> Task(a))
    Cancel(Int, fn(Nil) -> Task(a))

// A task communicating via channels, producing an `a`.
type Task(a):
    Task(fn() -> Step(a))

pub fn poll(t: Task(a)) -> Step(a):
    match t:
        Task(th) -> th()

fn unit():
    let _ignore = 0

// ---- core combinators ----

// A finished task.
pub fn done(x: a) -> Task(a):
    Task(fn(): Done(x))

// An already-complete `Task(Nil)` — the async/await lowering target for a body
// that falls off its end.
pub fn ready_unit() -> Task(Nil):
    Task(fn(): Done(unit()))

// Hand control back to the executor once, then continue.
pub fn yield_now() -> Task(Nil):
    Task(fn(): Yield(Task(fn(): Done(unit()))))

// Sequence: run `t`, then continue with `k` applied to its result. This is what
// `await` lowers to — the continuation `k` is the rest of the body.
pub fn and_then(t: Task(a), k: fn(a) -> Task(b)) -> Task(b):
    Task(fn(): and_then_step(poll(t), k))

fn and_then_step(s: Step(a), k: fn(a) -> Task(b)) -> Step(b):
    match s:
        Done(v) -> Yield(k(v))
        Yield(t2) -> Yield(and_then(t2, k))
        Fork(child, cont) -> Fork(child, fn(h): and_then(cont(h), k))
        Open(cap, cont) -> Open(cap, fn(c): and_then(cont(c), k))
        Push(ch, msg, cont) -> Push(ch, msg, fn(u): and_then(cont(u), k))
        Pull(ch, cont) -> Pull(ch, fn(o): and_then(cont(o), k))
        PullAny(chs, cont) -> PullAny(chs, fn(o): and_then(cont(o), k))
        Wait(t2, cont) -> Wait(t2, fn(u): and_then(cont(u), k))
        Cancel(target, cont) -> Cancel(target, fn(u): and_then(cont(u), k))

// Transform a task's result.
pub fn map(t: Task(a), f: fn(a) -> b) -> Task(b):
    and_then(t, fn(x): Task(fn(): Done(f(x))))

// Build the task `thunk()` lazily: nothing runs until the first poll. This is what
// makes an `async fn` LAZY — calling it yields a task that does no work until
// driven (by `run`, or by being `spawn`ed, or `await`ed).
pub fn lazy(thunk: fn() -> Task(a)) -> Task(a):
    Task(fn(): poll(thunk()))

// Run `f(x)` as a task for each `x` in `xs`, in order — the lowering target for an
// `await` inside a `for x in xs:` loop.
pub fn for_each(xs: List(a), f: fn(a) -> Task(Nil)) -> Task(Nil):
    if list.is_empty(xs):
        ready_unit()
    else:
        and_then(f(list.at(xs, 0)), fn(_done): for_each(list.tail(xs), f))

// ---- spawn + join ----
type Handle:
    Handle(Int)

// Start `child` as a concurrent task; the returned handle completes when it does.
pub fn spawn(child: Task(Nil)) -> Task(Handle):
    Task(fn(): Fork(child, fn(h): Task(fn(): Done(Handle(h)))))

// Block until the spawned task behind `h` finishes.
pub fn join(h: Handle) -> Task(Nil):
    match h:
        Handle(id) -> Task(fn(): Wait(id, fn(u): Task(fn(): Done(u))))

// Cancel the spawned task behind `h`: it is stepped no further and is treated as
// finished, so anyone `join`ing it unblocks. Shallow (stops this one task, not its
// descendants) and idempotent (already-finished is a no-op). Deterministic on the
// round-robin schedule, hence byte-identical on both backends.
pub fn cancel(h: Handle) -> Task(Nil):
    match h:
        Handle(id) -> Task(fn(): Cancel(id, fn(u): Task(fn(): Done(u))))

// ---- executor ----

// A scheduling slot: running, parked on a channel recv/send or on a join, or done.
// Parked messages are the erased `__Msg` (RFC-0055).
type Slot:
    Active(Task(Nil))
    WaitRecv(Int, fn(Option(__Msg)) -> Task(Nil))
    WaitSend(Int, __Msg, fn(Nil) -> Task(Nil))
    WaitAny(List(Int), fn(Option((Int, __Msg))) -> Task(Nil))
    WaitJoin(Int, fn(Nil) -> Task(Nil))
    Ended

fn is_live(s: Slot) -> Bool:
    match s:
        Ended -> false
        Active(_) -> true
        WaitRecv(_, _) -> true
        WaitSend(_, _, _) -> true
        WaitAny(_, _) -> true
        WaitJoin(_, _) -> true

fn is_parked(s: Slot) -> Bool:
    match s:
        WaitRecv(_, _) -> true
        WaitSend(_, _, _) -> true
        WaitAny(_, _) -> true
        WaitJoin(_, _) -> true
        Active(_) -> false
        Ended -> false

// Channels are `(buffer, capacity)` pairs; capacity 0 means unbounded.
fn try_pull(i: Int, ch: Int, cont: fn(Option(__Msg)) -> Task(Nil), slots: List(Slot), channels: List((List(__Msg), Int))) -> (List(Slot), List((List(__Msg), Int)), Bool):
    let (buf, cap) = list.at(channels, ch)
    if list.length(buf) > 0:
        let channels2 = list.set_at(channels, ch, (list.tail(buf), cap))
        (list.set_at(slots, i, Active(cont(Some(list.at(buf, 0))))), channels2, true)
    else:
        (list.set_at(slots, i, WaitRecv(ch, cont)), channels, false)

fn try_push(i: Int, ch: Int, msg: __Msg, cont: fn(Nil) -> Task(Nil), slots: List(Slot), channels: List((List(__Msg), Int))) -> (List(Slot), List((List(__Msg), Int)), Bool):
    let (buf, cap) = list.at(channels, ch)
    if cap == 0 || list.length(buf) < cap:
        let channels2 = list.set_at(channels, ch, (list.push(buf, msg), cap))
        (list.set_at(slots, i, Active(cont(unit()))), channels2, true)
    else:
        (list.set_at(slots, i, WaitSend(ch, msg, cont)), channels, false)

// The local index (within `chs`) and global id of the first listed channel with a
// pending message, or None if all are empty.
fn first_ready(k: Int, chs: List(Int), channels: List((List(__Msg), Int))) -> Option((Int, Int)):
    if k >= list.length(chs):
        None
    else:
        let ch = list.at(chs, k)
        let (buf, _cap) = list.at(channels, ch)
        if list.length(buf) > 0:
            Some((k, ch))
        else:
            first_ready(k + 1, chs, channels)

fn try_pull_any(i: Int, chs: List(Int), cont: fn(Option((Int, __Msg))) -> Task(Nil), slots: List(Slot), channels: List((List(__Msg), Int))) -> (List(Slot), List((List(__Msg), Int)), Bool):
    match first_ready(0, chs, channels):
        Some(hit) ->
            let (k, ch) = hit
            let (buf, cap) = list.at(channels, ch)
            let channels2 = list.set_at(channels, ch, (list.tail(buf), cap))
            (list.set_at(slots, i, Active(cont(Some((k, list.at(buf, 0)))))), channels2, true)
        None -> (list.set_at(slots, i, WaitAny(chs, cont)), channels, false)

fn try_join(i: Int, target: Int, cont: fn(Nil) -> Task(Nil), slots: List(Slot), channels: List((List(__Msg), Int))) -> (List(Slot), List((List(__Msg), Int)), Bool):
    match list.at(slots, target):
        Ended -> (list.set_at(slots, i, Active(cont(unit()))), channels, true)
        Active(_) -> (list.set_at(slots, i, WaitJoin(target, cont)), channels, false)
        WaitRecv(_, _) -> (list.set_at(slots, i, WaitJoin(target, cont)), channels, false)
        WaitSend(_, _, _) -> (list.set_at(slots, i, WaitJoin(target, cont)), channels, false)
        WaitAny(_, _) -> (list.set_at(slots, i, WaitJoin(target, cont)), channels, false)
        WaitJoin(_, _) -> (list.set_at(slots, i, WaitJoin(target, cont)), channels, false)

fn step_one(i: Int, slots: List(Slot), channels: List((List(__Msg), Int))) -> (List(Slot), List((List(__Msg), Int)), Bool):
    match list.at(slots, i):
        Ended -> (slots, channels, false)
        WaitRecv(ch, cont) -> try_pull(i, ch, cont, slots, channels)
        WaitSend(ch, msg, cont) -> try_push(i, ch, msg, cont, slots, channels)
        WaitAny(chs, cont) -> try_pull_any(i, chs, cont, slots, channels)
        WaitJoin(t, cont) -> try_join(i, t, cont, slots, channels)
        Active(task) ->
            match poll(task):
                Done(_v) -> (list.set_at(slots, i, Ended), channels, true)
                Yield(t2) -> (list.set_at(slots, i, Active(t2)), channels, true)
                Fork(child, cont) ->
                    let new_id = list.length(slots)
                    let slots2 = list.push(slots, Active(child))
                    (list.set_at(slots2, i, Active(cont(new_id))), channels, true)
                Open(cap, cont) ->
                    let cid = list.length(channels)
                    (list.set_at(slots, i, Active(cont(cid))), list.push(channels, ([], cap)), true)
                Push(ch, msg, cont) -> try_push(i, ch, msg, cont, slots, channels)
                Pull(ch, cont) -> try_pull(i, ch, cont, slots, channels)
                PullAny(chs, cont) -> try_pull_any(i, chs, cont, slots, channels)
                Wait(t, cont) -> try_join(i, t, cont, slots, channels)
                Cancel(target, cont) ->
                    let slots2 = list.set_at(slots, target, Ended)
                    (list.set_at(slots2, i, Active(cont(unit()))), channels, true)

fn step_round(i: Int, n: Int, slots: List(Slot), channels: List((List(__Msg), Int)), prog: Bool) -> (List(Slot), List((List(__Msg), Int)), Bool):
    if i >= n:
        (slots, channels, prog)
    else:
        let (s2, c2, p) = step_one(i, slots, channels)
        step_round(i + 1, n, s2, c2, prog || p)

// At quiescence nothing can deliver: closed receivers get `None`, blocked senders
// and joiners are released so the run terminates instead of hanging.
fn close_one(i: Int, slots: List(Slot), channels: List((List(__Msg), Int))) -> (List(Slot), List((List(__Msg), Int))):
    match list.at(slots, i):
        WaitRecv(_ch, cont) -> (list.set_at(slots, i, Active(cont(None))), channels)
        WaitSend(ch, msg, cont) ->
            let (buf, cap) = list.at(channels, ch)
            (list.set_at(slots, i, Active(cont(unit()))), list.set_at(channels, ch, (list.push(buf, msg), cap)))
        WaitAny(_chs, cont) -> (list.set_at(slots, i, Active(cont(None))), channels)
        WaitJoin(_t, cont) -> (list.set_at(slots, i, Active(cont(unit()))), channels)
        Active(_) -> (slots, channels)
        Ended -> (slots, channels)

fn close_round(i: Int, n: Int, slots: List(Slot), channels: List((List(__Msg), Int))) -> (List(Slot), List((List(__Msg), Int))):
    if i >= n:
        (slots, channels)
    else:
        let (s2, c2) = close_one(i, slots, channels)
        close_round(i + 1, n, s2, c2)

// Drive `root` (and everything it spawns) to completion on a deterministic
// round-robin schedule. An async `main` lowers to a single `run` of its body.
pub fn run(root: Task(Nil)):
    var slots = [Active(root)]
    var channels = []
    var go = true
    while go:
        let n = list.length(slots)
        let (s2, c2, prog) = step_round(0, n, slots, channels, false)
        if prog:
            slots = s2
            channels = c2
            go = list.any(s2, fn(s): is_live(s))
        else if list.any(s2, fn(s): is_parked(s)):
            let (s3, c3) = close_round(0, list.length(s2), s2, c2)
            slots = s3
            channels = c3
            go = true
        else:
            slots = s2
            channels = c2
            go = false
