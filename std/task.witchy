// std/task - the cooperative task substrate and its executor.
//
// A `Task(a)` is a CPS-over-closures computation that, when stepped, either
// completes (`Done`) or yields an effect back to the executor: cooperate
// (`Yield`), `spawn` a child (`Fork`), `join` one (`Wait`), or a channel op
// (`Open`/`Push`/`Pull`/`PullAny`, produced by `std/chan`). `run` drives a task
// (and everything it spawns) to completion on a deterministic round-robin
// schedule, so a concurrent run is byte-identical on the interpreter and the
// compiled WebAssembly - no scheduler state in the runtime, no `Pin`.
//
// This module is the scheduling core: the `Task` monad, `spawn`/`join`/
// `yield_now`, and the executor. First-class channels are layered on top in
// `std/chan`; lightweight value-returning structured concurrency (`join_all`/
// `select` over independent futures) lives in `std/future`.
//
// Messages: the executor is ERASED (RFC-0055). Its buffers, `Step`, and `Slot`
// carry the opaque `__Msg`, so ONE program can run channels of many different
// message types - a library may use channels privately without forcing its type
// on the whole program. The typed channel endpoints (`Sender(m)`/`Receiver(m)`
// in `std/chan`) erase a message on `send` and recover it on `recv`; the
// erasure is representationally the identity on both backends (a message already
// rides the universal slot), so interleavings stay byte-identical. Spawned tasks
// return `Nil`; a task reports a result by sending it on a channel, not by
// returning it (a typed `JoinHandle(T)` would force a native runtime and break
// the parity contract).
//
// The `async`/`await` CPS transform lowers onto this substrate (`task.lazy`/
// `and_then`/`done`/`run`), so `chan.recv(rx).await` / `chan.send(tx, x).await`
// work in async fns.

import option

// What a task yields to the executor when stepped. `a` is the task's own result.
// The channel effects (`Open`/`Push`/`Pull`/`PullAny`) are produced by the private
// bridge below; the executor interprets every variant. Messages are the erased
// `__Msg` (RFC-0055) - std/chan's typed endpoints (un)wrap at the boundary.
sealed type Step(a):
    Done(a)
    Yield(Task(a))
    Fork(Task(Nil), fn(Int) -> Task(a))
    Open(Int, fn(Int) -> Task(a))
    Push(Int, __Msg, fn(Nil) -> Task(a))
    Pull(Int, fn(Option(__Msg)) -> Task(a))
    PullAny(List(Int), fn(Option((Int, __Msg))) -> Task(a))
    Wait(Int, fn(Nil) -> Task(a))
    Cancel(Int, fn(Nil) -> Task(a))

// A task communicating via channels, producing an `a`.
sealed type Task(a):
    Task(fn() -> Step(a))

fn poll(t: Task(a)) -> Step(a):
    match t:
        Task(th) -> th()

fn unit():
    let _ignore = 0

// ---- core combinators ----

// A finished task.
pub fn done(own x: a) -> Task(a):
    Task(fn(): Done(x))

// An already-complete `Task(Nil)` - the async/await lowering target for a body
// that falls off its end.
pub fn ready_unit() -> Task(Nil):
    Task(fn(): Done(unit()))

// Hand control back to the executor once, then continue.
pub fn yield_now() -> Task(Nil):
    Task(fn(): Yield(Task(fn(): Done(unit()))))

// Sequence: run `t`, then continue with `k` applied to its result. This is what
// `await` lowers to - the continuation `k` is the rest of the body.
pub fn and_then(t: Task(a), own k: fn(own a) -> Task(b)) -> Task(b):
    Task(fn(): and_then_step(poll(t), k))

fn and_then_step(own s: Step(a), own k: fn(own a) -> Task(b)) -> Step(b):
    match s:
        Done(v) -> Yield(k(v))
        Yield(t2) -> Yield(and_then(t2, k))
        Fork(child, cont) -> Fork(child, fn(h): and_then(cont(h), k))
        Open(cap, cont) -> Open(cap, fn(c): and_then(cont(c), k))
        Push(ch, msg, cont) -> Push(ch, msg, fn(u): and_then(cont(u), k))
        Pull(ch, cont) -> Pull(ch, fn(o): and_then(cont(o), k))
        PullAny(chs, cont) -> PullAny(chs, fn(o): and_then(cont(o), k))
        Wait(t2, cont) -> Wait(t2, fn(u): and_then(cont(u), k))
        Cancel(target, cont) -> Cancel(target, fn(u): and_then(cont(u), k))

// Transform a task's result.
pub fn map(t: Task(a), f: fn(own a) -> b) -> Task(b):
    and_then(t, fn(own x): Task(fn(): Done(f(x))))

// Build the task `thunk()` lazily: nothing runs until this task is polled. A
// `Task` is a replayable execution recipe, not a memo cell; the standard driver
// advances through continuations, but driving the same task value again reruns
// its thunk.
pub fn lazy(thunk: fn() -> Task(a)) -> Task(a):
    Task(fn(): poll(thunk()))

// Run `f(x)` as a task for each `x` in `xs`, in order - the lowering target for an
// `await` inside a `for x in xs:` loop.
pub fn for_each(xs: List(a), f: fn(a) -> Task(Nil)) -> Task(Nil):
    if list.is_empty(xs):
        ready_unit()
    else:
        and_then(f(list.at(xs, 0)), fn(own _done): for_each(list.tail(xs), f))

// ---- spawn + join ----
must sealed type Handle:
    Handle(Int)

// Channel identity shared with std/chan. User source cannot mint one; the
// compiler-private bridge functions below are callable only from std/task and
// std/chan.
sealed type ChannelId:
    ChannelId(Int)

fn __channel_open(capacity: Int) -> Task(ChannelId):
    Task(fn(): Open(capacity, fn(id): Task(fn(): Done(ChannelId(id)))))

fn __channel_send(channel: ChannelId, msg: __Msg) -> Task(Nil):
    match channel:
        ChannelId(id) -> Task(fn(): Push(id, msg, fn(_done): ready_unit()))

fn __channel_recv(channel: ChannelId, decode: fn(Option(__Msg)) -> a) -> Task(a):
    match channel:
        ChannelId(id) -> Task(fn(): Pull(id, fn(msg): done(decode(msg))))

fn __channel_select(channels: List(ChannelId), k: fn(Option((Int, __Msg))) -> Task(a)) -> Task(a):
    Task(fn(): PullAny(channel_ids(channels), k))

fn channel_ids(channels: List(ChannelId)) -> List(Int):
    list.map(channels, fn(channel):
        match channel:
            ChannelId(id) -> id
    )

// Start `child` as a concurrent task; the returned handle completes when it does.
pub fn spawn(child: Task(Nil)) -> Task(Handle):
    Task(fn(): Fork(child, fn(h): Task(fn(): Done(Handle(h)))))

// Wait for the spawned task behind `h` while the executor can make progress. If
// the whole executor reaches quiescence with this join parked, the close pass
// releases it even if the joined task has a continuation that will run afterward.
pub fn join(own h: Handle) -> Task(Nil):
    match h:
        Handle(id) -> Task(fn(): Wait(id, fn(u): Task(fn(): Done(u))))

// Cancel the spawned task behind `h`: it is stepped no further and is treated as
// finished, so anyone `join`ing it unblocks. Shallow (stops this one task, not its
// descendants) and idempotent (already-finished is a no-op). Deterministic on the
// round-robin schedule, hence byte-identical on both backends.
pub fn cancel(own h: Handle) -> Task(Nil):
    match h:
        Handle(id) -> Task(fn(): Cancel(id, fn(u): Task(fn(): Done(u))))

// ---- executor ----

// A scheduling slot: running, parked on a channel recv/send or on a join, or done.
// Parked messages are the erased `__Msg` (RFC-0055).
sealed type Slot:
    Active(Task(Nil))
    WaitRecv(Int, fn(Option(__Msg)) -> Task(Nil))
    WaitSend(Int, __Msg, fn(Nil) -> Task(Nil))
    WaitAny(List(Int), fn(Option((Int, __Msg))) -> Task(Nil))
    WaitJoin(Int, fn(Nil) -> Task(Nil))
    Ended

fn is_live(s: Slot) -> Bool:
    match s:
        Ended -> false
        Active(_) -> true
        WaitRecv(_, _) -> true
        WaitSend(_, _, _) -> true
        WaitAny(_, _) -> true
        WaitJoin(_, _) -> true

fn is_parked(s: Slot) -> Bool:
    match s:
        WaitRecv(_, _) -> true
        WaitSend(_, _, _) -> true
        WaitAny(_, _) -> true
        WaitJoin(_, _) -> true
        Active(_) -> false
        Ended -> false

// ---- fixed-capacity ring channels (RFC-0059 Stage 2) ----
//
// A channel is a FIXED-capacity ring buffer, not a growable list. Its state is the
// tuple `(buf, head, count, cap)`: `buf` is a physical list of `physcap` slots; the
// `count` live messages are `buf[(head + i) % physcap]` for `i in 0..count`, in FIFO
// order; `cap` is the logical capacity (0 = unbounded). Send writes at the tail slot
// with `list.set_at` (in place - no per-message allocation and no growth), and recv
// just advances `head` - so the O(buffer) `list.tail` rebuild the growable buffer did
// on EVERY recv is gone. FIFO order and the ready/room predicates are byte-identical
// to the old buffer, so the deterministic round-robin schedule is preserved.

// A fresh channel of logical capacity `cap`. Bounded (`cap > 0`): a fixed ring of
// `cap` slots. Unbounded (`cap == 0`): a 1-slot ring that grows amortized. The
// pre-filled slots are erased Int sentinels, never delivered (only written slots in
// `[head, head+count)` are ever read).
fn ring_new(cap: Int) -> (List(__Msg), Int, Int, Int):
    let physcap = if cap > 0: cap else: 1
    (list.repeat(__erase(0), physcap), 0, 0, cap)

// Grow a physically-full ring: relayout its `count` live messages to the front of a
// doubled buffer (FIFO preserved), append `msg`, and return the new
// `(buf, head, count, cap)`. Reached only when a physically full buffer must still
// accept a message - an unbounded channel at its physical limit, or the shutdown
// drain releasing a blocked sender past a bounded `cap`.
fn ring_grow(buf: List(__Msg), head: Int, count: Int, msg: __Msg, cap: Int) -> (List(__Msg), Int, Int, Int):
    let physcap = list.length(buf)
    let newcap = if physcap == 0: 1 else: physcap * 2
    var nb = list.repeat(msg, newcap)
    var k = 0
    while k < count:
        list.set_at(nb, k, list.at(buf, (head + k) % physcap))
        k = k + 1
    list.set_at(nb, count, msg)
    (nb, 0, count + 1, cap)

fn ring_put(own buf: List(__Msg), head: Int, count: Int, msg: __Msg, cap: Int) -> (List(__Msg), Int, Int, Int):
    var out = move buf
    let physcap = list.length(out)
    if count < physcap:
        list.set_at(out, (head + count) % physcap, msg)
        (out, head, count + 1, cap)
    else:
        ring_grow(out, head, count, msg, cap)

// The local index (within `chs`) and global id of the first listed channel with a
// pending message, or None if all are empty. Drives the `PullAny`/`select` path.
fn first_ready(k: Int, chs: List(Int), channels: List((List(__Msg), Int, Int, Int))) -> Option((Int, Int)):
    if k >= list.length(chs):
        None
    else:
        let ch = list.at(chs, k)
        let (_buf, _head, count, _cap) = list.at(channels, ch)
        if count > 0:
            Some((k, ch))
        else:
            first_ready(k + 1, chs, channels)

// Drive `root` (and everything it spawns) to completion on a deterministic
// round-robin schedule. An async `main` lowers to a single `run` of its body.
pub fn run(root: Task(Nil)):
    // (RFC-0036 Design B) The scheduler OWNS its state: `slots` and `channels` are
    // confined-unique local `var` accumulators, mutated in place with
    // (`list.set_at(slots, …)` / `list.push(…)`). Every effect is inlined
    // here so each mutation lands on these locals - never on a borrowed param rebuilt
    // through a tuple return - which is the shape the uniqueness + reclamation
    // machinery reclaims per step, so the heap high-water stays flat as messages flow
    // instead of growing per message. The schedule is unchanged and thus byte-identical
    // on both backends: each round steps slots `0..n` with `n` fixed at the round's
    // start (so a freshly `Fork`ed slot first runs next round), progress is the OR of
    // the round's steps, and a quiescent round with live parked tasks runs the close
    // pass (closed receivers get `None`; blocked senders/joiners are released).
    var slots = [Active(root)]
    var channels = []
    var go = true
    while go:
        let n = list.length(slots)
        var prog = false
        var i = 0
        while i < n:
            match list.at(slots, i):
                Ended -> unit()
                WaitRecv(ch, cont) ->
                    let (buf, head, count, cap) = list.at(channels, ch)
                    if count > 0:
                        let msg = list.at(buf, head)
                        let physcap = list.length(buf)
                        list.set_at(channels, ch, (buf, (head + 1) % physcap, count - 1, cap))
                        list.set_at(slots, i, Active(cont(Some(msg))))
                        prog = true
                    else:
                        unit()
                WaitSend(ch, msg, cont) ->
                    let (wait_buf, head, count, cap) = list.at(channels, ch)
                    if cap == 0 || count < cap:
                        list.set_at(channels, ch, ring_put(wait_buf, head, count, msg, cap))
                        list.set_at(slots, i, Active(cont(unit())))
                        prog = true
                    else:
                        unit()
                WaitAny(chs, cont) ->
                    match first_ready(0, chs, channels):
                        Some(hit) ->
                            let (k, ch) = hit
                            let (buf, head, count, cap) = list.at(channels, ch)
                            let msg = list.at(buf, head)
                            let physcap = list.length(buf)
                            list.set_at(channels, ch, (buf, (head + 1) % physcap, count - 1, cap))
                            list.set_at(slots, i, Active(cont(Some((k, msg)))))
                            prog = true
                        None -> unit()
                WaitJoin(t, cont) ->
                    match list.at(slots, t):
                        Ended ->
                            list.set_at(slots, i, Active(cont(unit())))
                            prog = true
                        _ -> unit()
                Active(task) ->
                    match poll(task):
                        Done(_v) ->
                            list.set_at(slots, i, Ended)
                            prog = true
                        Yield(t2) ->
                            list.set_at(slots, i, Active(t2))
                            prog = true
                        Fork(child, cont) ->
                            let new_id = list.length(slots)
                            list.push(slots, Active(child))
                            list.set_at(slots, i, Active(cont(new_id)))
                            prog = true
                        Open(cap, cont) ->
                            let cid = list.length(channels)
                            list.set_at(slots, i, Active(cont(cid)))
                            list.push(channels, ring_new(cap))
                            prog = true
                        Push(ch, msg, cont) ->
                            let (push_buf, head, count, cap) = list.at(channels, ch)
                            if cap == 0 || count < cap:
                                list.set_at(channels, ch, ring_put(push_buf, head, count, msg, cap))
                                list.set_at(slots, i, Active(cont(unit())))
                                prog = true
                            else:
                                list.set_at(slots, i, WaitSend(ch, msg, cont))
                        Pull(ch, cont) ->
                            let (buf, head, count, cap) = list.at(channels, ch)
                            if count > 0:
                                let msg = list.at(buf, head)
                                let physcap = list.length(buf)
                                list.set_at(channels, ch, (buf, (head + 1) % physcap, count - 1, cap))
                                list.set_at(slots, i, Active(cont(Some(msg))))
                                prog = true
                            else:
                                list.set_at(slots, i, WaitRecv(ch, cont))
                        PullAny(chs, cont) ->
                            match first_ready(0, chs, channels):
                                Some(hit) ->
                                    let (k, ch) = hit
                                    let (buf, head, count, cap) = list.at(channels, ch)
                                    let msg = list.at(buf, head)
                                    let physcap = list.length(buf)
                                    list.set_at(channels, ch, (buf, (head + 1) % physcap, count - 1, cap))
                                    list.set_at(slots, i, Active(cont(Some((k, msg)))))
                                    prog = true
                                None -> list.set_at(slots, i, WaitAny(chs, cont))
                        Wait(t, cont) ->
                            if let Ended = list.at(slots, t):
                                list.set_at(slots, i, Active(cont(unit())))
                                prog = true
                            else:
                                list.set_at(slots, i, WaitJoin(t, cont))
                        Cancel(target, cont) ->
                            list.set_at(slots, target, Ended)
                            list.set_at(slots, i, Active(cont(unit())))
                            prog = true
            i = i + 1
        if prog:
            go = list.any(slots, fn(s): is_live(s))
        else if list.any(slots, fn(s): is_parked(s)):
            let m = list.length(slots)
            var j = 0
            while j < m:
                match list.at(slots, j):
                    WaitRecv(_ch, cont) -> list.set_at(slots, j, Active(cont(None)))
                    WaitSend(ch, msg, cont) ->
                        let (close_buf, head, count, cap) = list.at(channels, ch)
                        list.set_at(slots, j, Active(cont(unit())))
                        list.set_at(channels, ch, ring_put(close_buf, head, count, msg, cap))
                    WaitAny(_chs, cont) -> list.set_at(slots, j, Active(cont(None)))
                    WaitJoin(_t, cont) -> list.set_at(slots, j, Active(cont(unit())))
                    _ -> unit()

                j = j + 1
            go = true
        else:
            go = false
