// HTTP types and a small HTTP/1.1 *client* over the `Net` capability — the
// witchy answer to a slice of Go's net/http (and reqwest's shape). Pure
// transport built on the capability-gated socket primitives: a module handed a
// `Net` restricted to some hosts can reach only those, and one handed no `Net`
// can't reach the network at all. The `server` module builds on the shared
// `Request`/`Response` types here. Runs on both backends: the socket primitives
// compile to capability-gated host imports, so a compiled module's import list
// IS its network footprint.

// `header` returns Option; `get_url` returns typed Result; `url` parses URL strings.

import option
import result
import url
import ascii
import bytes
import show
import error
import convert

// Matchable HTTP client failures for fallible network and parse paths.
type HttpError:
    InvalidUrl(url.UrlError)
    UnsupportedScheme(String)
    ConnectFailed(String, Int)
    NoResolvedAddressPassedPinPolicy(String)
    PinnedConnectFailed(String, String, Int)
    MalformedResponse(ResponseParseError)

// Matchable strict-response parse failures. These are surfaced through
// `HttpError.MalformedResponse` by client APIs and `try_parse_response`.
type ResponseParseError:
    MissingChunkSizeTerminator
    InvalidChunkSize(String)
    MissingFinalChunkDelimiter
    InvalidChunkUtf8
    TruncatedChunk
    MissingChunkDelimiter
    InternalChunkDecoderState

pub fn response_parse_error_message(e: ResponseParseError) -> String:
    match e:
        MissingChunkSizeTerminator -> "chunked response missing chunk-size terminator"
        InvalidChunkSize(line) -> "chunked response has invalid chunk size `" + line + "`"
        MissingFinalChunkDelimiter -> "chunked response missing final CRLF"
        InvalidChunkUtf8 -> "chunked response body is not valid UTF-8"
        TruncatedChunk -> "chunked response ended before the declared chunk size"
        MissingChunkDelimiter -> "chunked response missing chunk delimiter"
        InternalChunkDecoderState -> "unreachable chunked decoder state"

pub fn http_error_message(e: HttpError) -> String:
    match e:
        InvalidUrl(reason) -> "invalid URL: " + url.url_error_message(reason)
        UnsupportedScheme(scheme) -> "unsupported URL scheme `" + scheme + "` (only http and https are supported)"
        ConnectFailed(host, port) -> "connect to " + host + ":" + "${port}" + " failed (unreachable)"
        NoResolvedAddressPassedPinPolicy(host) -> "no resolved address for " + host + " passed the pin policy"
        PinnedConnectFailed(host, ip, port) -> "connect to " + host + " (" + ip + ":" + "${port}" + ") failed"
        MalformedResponse(reason) -> response_parse_error_message(reason)

impl Show for ResponseParseError:
    fn show(self) -> String:
        response_parse_error_message(self)

impl Error for ResponseParseError

impl From(ResponseParseError) for String:
    fn from(value: ResponseParseError) -> Self:
        response_parse_error_message(value)

impl Show for HttpError:
    fn show(self) -> String:
        http_error_message(self)

impl Error for HttpError

impl From(HttpError) for String:
    fn from(value: HttpError) -> Self:
        http_error_message(value)

// A response: status code, headers (name lowercased for case-insensitive
// lookup), and body. Shared by the client and the `server` framework.
type Response:
    Response(Int, List((String, String)), String)

// A parsed request the server hands to a handler: method, raw path, the path
// params the router captured (`:id`), the parsed query string, the (lowercased)
// headers, and the body.
type Request:
    Request(String, String, List((String, String)), List((String, String)), List((String, String)), String)

// (RFC-0020) A vetted pin: a URL resolved ONCE to a single checked IP. Sealed — only
// this module can mint one (`pin`/`unpinned`), so holding a `PinnedUrl` is proof that a
// policy ran and cannot be hand-forged with an attacker's address. `get_pinned` dials
// EXACTLY `ip`, carrying `host` for TLS SNI and the `Host` header, and never re-resolves
// — closing the DNS-rebinding TOCTOU by construction. The `Net` allowlist stays the hard
// floor underneath: `connect_pinned` re-checks `ip`, so even a buggy pin policy cannot
// dial past `net.deny(Net.private())`.
capability PinnedUrl:
    host: String
    port: Int
    secure: Bool
    path: String
    ip: String

// Perform a GET request to `host:port` for `path`, returning the response.
pub fn get(net: Net[Connect, Tcp], host: String, port: Int, path: String) -> Response:
    request(net, "GET", host, port, path, "")

// Perform a POST request with `body` (e.g. a JSON document). The body's byte
// length is sent as Content-Length.
pub fn post(net: Net[Connect, Tcp], host: String, port: Int, path: String, body: String) -> Response:
    request(net, "POST", host, port, path, body)

pub fn put(net: Net[Connect, Tcp], host: String, port: Int, path: String, body: String) -> Response:
    request(net, "PUT", host, port, path, body)

pub fn delete(net: Net[Connect, Tcp], host: String, port: Int, path: String) -> Response:
    request(net, "DELETE", host, port, path, "")

pub fn patch(net: Net[Connect, Tcp], host: String, port: Int, path: String, body: String) -> Response:
    request(net, "PATCH", host, port, path, body)

pub fn head(net: Net[Connect, Tcp], host: String, port: Int, path: String) -> Response:
    request(net, "HEAD", host, port, path, "")

// GET a full URL string (`http://host[:port]/path`), returning an error when
// parsing, connecting, or response decoding fails. Saves splitting
// host/port/path by hand while preserving the fallible `Result` contract.
pub fn get_url(net: Net[Connect, Tcp], raw: String) -> Result(Response, HttpError):
    match url.parse(raw):
        Ok(u) ->
            match scheme_secure(url.scheme(u)):
                Ok(secure) -> try_request_with(net, secure, "GET", url.host(u), url.port(u), url.request_target(u), [], "")
                Err(e) -> Err(e)
        Err(e) -> Err(InvalidUrl(e))

// GET a full URL with String errors for application-style callers and older code.
pub fn get_url_string(net: Net[Connect, Tcp], raw: String) -> Result(Response, String):
    match get_url(net, raw):
        Ok(resp) -> Ok(resp)
        Err(e) -> Err(http_error_message(e))

// (BUG-234) Whether a URL scheme is HTTPS (`Ok(true)`), plain HTTP (`Ok(false)`),
// or unsupported (`Err`). This module speaks only HTTP/1.1: a `ftp:`/`file:`/`ws:`
// URL must NOT be silently dialed as plaintext HTTP to the named host — reject it so
// the caller gets an error rather than an accidental request to the wrong protocol.
fn scheme_secure(scheme: String) -> Result(Bool, HttpError):
    if scheme == "https":
        Ok(true)
    else if scheme == "http":
        Ok(false)
    else:
        Err(UnsupportedScheme(scheme))

// The dial target for a request: `tls:host:port` when `secure` (HTTPS), else
// `host:port`. The capability allowlist governs the bare `host:port`; the `tls:`
// scheme tells `connect` to terminate the connection over TLS (see net `connect`).
fn endpoint(secure: Bool, host: String, port: Int) -> String:
    let base = host + ":" + "${port}"
    if secure:
        "tls:" + base
    else:
        base

// Send a request with custom headers, returning the response. The generic form
// behind the method helpers — use it when you need to set headers (auth,
// content-type, ...). `secure` selects HTTPS (TLS). `Connection: close` ends
// `recv_all` after the body.
pub fn request_with(net: Net[Connect, Tcp], secure: Bool, method: String, host: String, port: Int, path: String, headers: List((String, String)), body: String) -> Response:
    send_on(net.connect(endpoint(secure, host, port)), method, host, path, headers, body)

fn render_and_send(sock: Socket, method: String, host: String, path: String, headers: List((String, String)), body: String):
    // (SEC-043 / BUG-364) Validate everything spliced into the request line/headers
    // BEFORE rendering: a `\r`/`\n` in the method/path/host, or a malformed header
    // name, would inject a header or a second request. The request-LINE fields
    // (method/path/host) must additionally carry no SPACE or TAB — a space in the
    // path or method splits the request line into extra tokens (request smuggling) —
    // so they use the stricter `check_request_field`. Trap loudly (both backends).
    check_request_field("method", method)
    check_request_field("request path", path)
    check_request_field("host", host)
    var head = method + " " + path + " HTTP/1.1\r\n" + "Host: " + host + "\r\n"
    for h in headers:
        let (k, v) = h
        check_header(k, v)
        // (BUG-393) The framing headers are OWNED by this renderer (Content-Length
        // and Connection are appended below), and so is Host — derived from the
        // request target and rendered first above. A caller-supplied Content-Length /
        // Transfer-Encoding / Connection would conflict with ours and enable request
        // smuggling; a second Host is the request-routing twin of that ambiguity.
        // Drop them rather than emit two owned headers.
        if !is_framing_header(k) && string.to_lower(k) != "host":
            head = head + k + ": " + v + "\r\n"
    let req = head + "Content-Length: " + "${string.length(body)}" + "\r\n" + "Connection: close\r\n\r\n" + body

    sock.send_bytes(req)

// Build an HTTP/1.1 request and send it on an already-connected socket, then parse the
// response. Shared by `request_with` (a fresh `connect`) and `send_pinned` (a pinned
// `connect_pinned`) so the two dial paths produce byte-identical requests.
fn send_on(sock: Socket, method: String, host: String, path: String, headers: List((String, String)), body: String) -> Response:
    match send_on_result(sock, method, host, path, headers, body):
        Ok(resp) -> resp
        Err(e) ->
            fail("HTTP response malformed: " + http_error_message(e))
            Response(0, [], "")

fn send_on_result(sock: Socket, method: String, host: String, path: String, headers: List((String, String)), body: String) -> Result(Response, HttpError):
    render_and_send(sock, method, host, path, headers, body)
    try_parse_response(sock.recv_all())

fn request(net: Net[Connect, Tcp], method: String, host: String, port: Int, path: String, body: String) -> Response:
    request_with(net, false, method, host, port, path, [], body)

// Like `request_with`, but fallible: an unreachable upstream yields
// `Err("connect to host:port failed (unreachable)")` instead of trapping. Built
// on `try_connect` so a long-running server (a proxy, a health check) survives a
// down peer — the caller decides what to do (e.g. answer 502) instead of the VM
// aborting. A successful dial sends the request and parses the response as usual.
pub fn try_request_with(net: Net[Connect, Tcp], secure: Bool, method: String, host: String, port: Int, path: String, headers: List((String, String)), body: String) -> Result(Response, HttpError):
    match net.try_connect(endpoint(secure, host, port)):
        None -> Err(ConnectFailed(host, port))
        Some(sock) -> send_on_result(sock, method, host, path, headers, body)

pub fn try_request_with_string(net: Net[Connect, Tcp], secure: Bool, method: String, host: String, port: Int, path: String, headers: List((String, String)), body: String) -> Result(Response, String):
    match try_request_with(net, secure, method, host, port, path, headers, body):
        Ok(resp) -> Ok(resp)
        Err(e) -> Err(http_error_message(e))

// Fallible GET: `Ok(response)` on success, `Err(reason)` if the host is
// unreachable. The fallible counterpart of `get`.
pub fn try_get(net: Net[Connect, Tcp], host: String, port: Int, path: String) -> Result(Response, HttpError):
    try_request_with(net, false, "GET", host, port, path, [], "")

pub fn try_get_string(net: Net[Connect, Tcp], host: String, port: Int, path: String) -> Result(Response, String):
    match try_get(net, host, port, path):
        Ok(resp) -> Ok(resp)
        Err(e) -> Err(http_error_message(e))

// Fallible POST: `Ok(response)` on success, `Err(reason)` if the host is
// unreachable. The fallible counterpart of `post`.
pub fn try_post(net: Net[Connect, Tcp], host: String, port: Int, path: String, body: String) -> Result(Response, HttpError):
    try_request_with(net, false, "POST", host, port, path, [], body)

pub fn try_post_string(net: Net[Connect, Tcp], host: String, port: Int, path: String, body: String) -> Result(Response, String):
    match try_post(net, host, port, path, body):
        Ok(resp) -> Ok(resp)
        Err(e) -> Err(http_error_message(e))

// ---- Rebinding-resistant fetch (RFC-0020): resolve once, pin, connect ----

// Resolve `raw`'s host ONCE, keep the first resolved IP the predicate approves, and pin
// it. The safe shape for fetching an untrusted URL — pair it with a confined `Net` for
// defense in depth, so the capability floor rejects an internal address even if the
// predicate is wrong:
//     let safe = net.deny(Net.private())
//     match http.pin(safe, user_url, allow_ip):
//         Ok(p) -> http.get_pinned(safe, p)
//         Err(e) -> Err(e)
pub fn pin(net: Net[Connect, Tcp], raw: String, allow_ip: fn(String) -> Bool) -> Result(PinnedUrl, HttpError):
    match url.parse(raw):
        Err(e) -> Err(InvalidUrl(e))
        Ok(u) ->
            match scheme_secure(url.scheme(u)):
                Err(e) -> Err(e)
                Ok(secure) ->
                    match first_allowed(net.resolve(url.host(u)), allow_ip):
                        None -> Err(NoResolvedAddressPassedPinPolicy(url.host(u)))
                        Some(ip) -> Ok(PinnedUrl(url.host(u), url.port(u), secure, url.request_target(u), ip))

pub fn pin_string(net: Net[Connect, Tcp], raw: String, allow_ip: fn(String) -> Bool) -> Result(PinnedUrl, String):
    match pin(net, raw, allow_ip):
        Ok(p) -> Ok(p)
        Err(e) -> Err(http_error_message(e))

// The NAMED, greppable no-policy pin: resolve once and pin the first address, applying no
// per-IP policy. Safe only behind a confined `Net` (the allowlist floor still applies);
// prefer `pin` with a real predicate. Named so a review can find every unchecked pin.
pub fn unpinned(net: Net[Connect, Tcp], raw: String) -> Result(PinnedUrl, HttpError):
    pin(net, raw, allow_any)

pub fn unpinned_string(net: Net[Connect, Tcp], raw: String) -> Result(PinnedUrl, String):
    match unpinned(net, raw):
        Ok(p) -> Ok(p)
        Err(e) -> Err(http_error_message(e))

fn allow_any(ip: String) -> Bool:
    true

// The first IP the predicate approves, or `None` if none do. The chooser sees the
// already-resolved candidates and selects one — it never resolves again, so the
// resolve-once invariant stays in one place.
fn first_allowed(ips: List(String), allow_ip: fn(String) -> Bool) -> Option(String):
    for ip in ips:
        if allow_ip(ip):
            return Some(ip)
    None

// GET the pinned target, honoring the pin — dials the pinned IP, never re-resolving.
pub fn get_pinned(net: Net[Connect, Tcp], p: PinnedUrl) -> Result(Response, HttpError):
    send_pinned(net, p, "GET", [], "")

pub fn get_pinned_string(net: Net[Connect, Tcp], p: PinnedUrl) -> Result(Response, String):
    match get_pinned(net, p):
        Ok(resp) -> Ok(resp)
        Err(e) -> Err(http_error_message(e))

// The general pinned send: dial the pinned IP via `connect_pinned` (presenting the
// original hostname for TLS SNI and the `Host` header), issue the request, and parse the
// response. Never re-resolves the host, so no rebinding can slip a new address underneath.
pub fn send_pinned(net: Net[Connect, Tcp], p: PinnedUrl, method: String, headers: List((String, String)), body: String) -> Result(Response, HttpError):
    match p:
        PinnedUrl(host, port, secure, path, ip) ->
            match net.try_connect_pinned(ip, host, port, secure):
                None -> Err(PinnedConnectFailed(host, ip, port))
                Some(sock) -> send_on_result(sock, method, host, path, headers, body)

pub fn send_pinned_string(net: Net[Connect, Tcp], p: PinnedUrl, method: String, headers: List((String, String)), body: String) -> Result(Response, String):
    match send_pinned(net, p, method, headers, body):
        Ok(resp) -> Ok(resp)
        Err(e) -> Err(http_error_message(e))

// ---- Request builder (reqwest-style fluent client) ----

// An outgoing request being assembled: method, full URL, headers, and body.
// Build it up with the chainable methods and finish with `.send(net)`.
type RequestBuilder:
    RequestBuilder(String, String, List((String, String)), String)

// Start a request to `url` with `method` (e.g. "GET").
pub fn build(method: String, url: String) -> RequestBuilder:
    RequestBuilder(method, url, [], "")

pub fn get_request(url: String) -> RequestBuilder:
    build("GET", url)

pub fn post_request(url: String) -> RequestBuilder:
    build("POST", url)

pub fn put_request(url: String) -> RequestBuilder:
    build("PUT", url)

pub fn delete_request(url: String) -> RequestBuilder:
    build("DELETE", url)

pub fn patch_request(url: String) -> RequestBuilder:
    build("PATCH", url)

// The fluent surface: real METHODS on RequestBuilder, each returning the
// extended builder (`http.get_request(url).with_header(...).send(net)`).
impl RequestBuilder:
    pub fn with_header(self, name: String, value: String) -> RequestBuilder:
        // Add a request header (chainable).
        match self:
            RequestBuilder(m, u, hs, b) -> RequestBuilder(m, u, list.push(hs, (name, value)), b)

    pub fn with_body(self, b: String) -> RequestBuilder:
        // Set the request body (e.g. a JSON document); nothing else changes.
        match self:
            RequestBuilder(m, u, hs, _b) -> RequestBuilder(m, u, hs, b)

    pub fn with_query(self, key: String, value: String) -> RequestBuilder:
        // Append a percent-encoded `key=value` query parameter before any
        // fragment. A malformed URL remains unchanged and `send` reports it.
        match self:
            RequestBuilder(m, u, hs, b) ->
                match url.parse(u):
                    Ok(parsed) -> RequestBuilder(m, url.format(url.with_query(parsed, key, value)), hs, b)
                    Err(_e) -> RequestBuilder(m, u, hs, b)

    pub fn send(self, net: Net[Connect, Tcp]) -> Result(Response, HttpError):
        // Send the assembled request, parsing host/port/path from its URL. An `Err`
        // is returned rather than a panic when the URL does not parse.
        match self:
            RequestBuilder(m, u, hs, b) ->
                match url.parse(u):
                    Ok(parsed) ->
                        match scheme_secure(url.scheme(parsed)):
                            Ok(secure) -> try_request_with(net, secure, m, url.host(parsed), url.port(parsed), url.request_target(parsed), hs, b)
                            Err(e) -> Err(e)
                    Err(e) -> Err(InvalidUrl(e))

    pub fn send_string(self, net: Net[Connect, Tcp]) -> Result(Response, String):
        // Send the assembled request with String errors for older code.
        match self.send(net):
            Ok(resp) -> Ok(resp)
            Err(e) -> Err(http_error_message(e))

// Whether the response status is in the 2xx success range.
pub fn is_success(r: Response) -> Bool:
    let c = status(r)
    c >= 200 && c < 300

// The numeric status code, e.g. 200.
pub fn status(r: Response) -> Int:
    match r:
        Response(code, _hdrs, _body) -> code

// The response body.
pub fn body(r: Response) -> String:
    match r:
        Response(_code, _hdrs, b) -> b

// The value of a response header, looked up case-insensitively, or None.
pub fn header(r: Response, name: String) -> Option(String):
    match r:
        Response(_code, hdrs, _body) -> find_header(hdrs, string.to_lower(name))

// Look up a header by its (already-lowercased) name. Shared with `server`.
pub fn find_header(hdrs: List((String, String)), name: String) -> Option(String):
    for p in hdrs:
        let (k, v) = p
        if k == name:
            return Some(v)
    None

// ---- CRLF / header-injection defense (shared by the client and `server`) ----
//
// The request line and headers are built by RAW string concatenation with
// `\r\n` separators, so a `\r` or `\n` smuggled into a method/path/host/header
// value would inject an extra header or a whole second request/response
// (HTTP request/response splitting). These validators are the last line before
// bytes are rendered: they trap LOUDLY and IDENTICALLY on both backends (via
// `fail`) rather than emitting a corrupted, attacker-shaped message. A header
// value/path/host must never carry a control byte; a header name must be a
// non-empty RFC 7230 token.

// Whether `s` contains a CR or LF — the response/request-splitting bytes.
pub fn has_crlf(s: String) -> Bool:
    string.contains(s, "\r") || string.contains(s, "\n")

// A valid HTTP header-name char (RFC 7230 tchar): alphanumeric or one of a small
// punctuation set. Notably EXCLUDES `:`, space, CR, LF — so a header name can
// never carry the `:`/CRLF that would break out of the name field.
fn is_tchar(c: String) -> Bool:
    ascii.is_alnum(c) || string.contains("!#\$%&'*+-.^_`|~", c)

// Whether `name` is a non-empty header-name token (every char a `tchar`).
fn is_header_name(name: String) -> Bool:
    if string.char_count(name) == 0:
        false
    else:
        var ok = true
        for c in string.chars(name):
            if !is_tchar(c):
                ok = false
        ok

// Whether `s` contains any control byte that is forbidden in an outbound HTTP
// field. Header values may contain HTAB; request-line fields may not.
fn has_forbidden_control(s: String, allow_tab: Bool) -> Bool:
    var bad = false
    for c in string.chars(s):
        let c0 = string.char_count(c) == 1 && c < " "
        let del = c == string.from_code(127)
        if del || c0 && !(allow_tab && c == "\t"):
            bad = true
    bad

// Trap unless `value` (a header value) is free of forbidden controls. HTAB is
// allowed in header values; all other C0 controls and DEL are rejected. Request
// method/path/host use `check_request_field`, which is stricter.
pub fn check_field(what: String, value: String):
    if has_forbidden_control(value, true):
        fail("HTTP " + what + " contains a forbidden control character: " + value)

// Trap unless `name` is a valid header-name token (rejects `:`, space, and CR/LF).
pub fn check_header_name(name: String):
    if !is_header_name(name):
        fail("invalid HTTP header name (must be a non-empty RFC 7230 token): " + name)

// Validate one `(name, value)` header pair — the name is a token, the value has
// no forbidden controls. Shared by the client request builder and server renderer.
pub fn check_header(name: String, value: String):
    check_header_name(name)
    check_field("header value", value)

// (BUG-364/506) Trap unless `value` is safe to splice into the request LINE: no
// C0 controls, DEL, space, or tab. The request line is space-delimited (`METHOD SP
// TARGET SP HTTP/1.1`), so a space/tab in method/path/host would split it into
// extra tokens (request smuggling). Stricter than `check_field`, because header
// values legitimately contain spaces and may contain HTAB.
pub fn check_request_field(what: String, value: String):
    if has_forbidden_control(value, false) || string.contains(value, " "):
        fail("HTTP " + what + " contains a whitespace/control character that would break the request line: " + value)

// (BUG-358 / BUG-393) Whether `name` is a message-FRAMING header — Content-Length,
// Transfer-Encoding, or Connection. The renderer owns framing (it appends its own
// Content-Length / Connection), so a caller/handler-supplied framing header must be
// dropped rather than emitted alongside ours: two conflicting framing headers are a
// request/response-smuggling primitive.
pub fn is_framing_header(name: String) -> Bool:
    let n = string.to_lower(name)
    n == "content-length" || n == "transfer-encoding" || n == "connection"

// Parse a raw HTTP/1.1 response string into a `Response`: split at the blank line
// separating headers from body, parse the header lines into (lowercased name,
// trimmed value) pairs, decode a `chunked` body, and read the status code totally
// (a non-numeric or overflowing code becomes 0 rather than trapping). Public so a
// proxy or test can parse a response it obtained by other means. This total helper
// keeps the historical lossy chunked behavior; use `try_parse_response` at trust
// boundaries where malformed framing must be an error.
pub fn parse_response(raw: String) -> Response:
    match parse_response_inner(raw, false):
        Ok(resp) -> resp
        Err(_e) -> Response(0, [], "")

// Strict response parsing for public client paths. In particular, malformed
// `Transfer-Encoding: chunked` bodies return `Err` instead of handing callers a
// recovered prefix that may look like valid JSON.
pub fn try_parse_response(raw: String) -> Result(Response, HttpError):
    match parse_response_inner(raw, true):
        Ok(resp) -> Ok(resp)
        Err(e) -> Err(MalformedResponse(e))

pub fn try_parse_response_string(raw: String) -> Result(Response, String):
    match try_parse_response(raw):
        Ok(resp) -> Ok(resp)
        Err(e) -> Err(http_error_message(e))

fn parse_response_inner(raw: String, strict_chunked: Bool) -> Result(Response, ResponseParseError):
    let sep = string.index_of(raw, "\r\n\r\n") ?? -1
    let head = if sep < 0: raw else: string.substring(raw, 0, sep)
    let bdy = if sep < 0: "" else: string.substring(raw, sep + 4, string.char_count(raw))
    let lines = string.split(head, "\r\n")
    let status_line = if list.length(lines) > 0: list.at(lines, 0) else: ""
    var hdrs = []
    var i = 1
    while i < list.length(lines):
        let line = list.at(lines, i)
        let colon = string.index_of(line, ":") ?? -1
        if colon >= 0:
            let name = string.to_lower(string.substring(line, 0, colon))
            let value = string.trim(string.substring(line, colon + 1, string.char_count(line)))
            hdrs = list.push(hdrs, (name, value))
        i = i + 1
    // (BUG-269) A `Transfer-Encoding: chunked` response frames its body as a series
    // of hex-sized chunks; returning it verbatim would hand the caller wire framing
    // instead of the payload. Decode it when the header advertises chunked (a `TE`
    // value like `gzip, chunked` counts); otherwise pass the body through unchanged.
    let body = match find_header(hdrs, "transfer-encoding"):
        Some(te) ->
            if string.contains(string.to_lower(te), "chunked"):
                if strict_chunked:
                    match dechunk_strict(bdy):
                        Ok(decoded) -> decoded
                        Err(e) -> return Err(e)
                else:
                    dechunk(bdy)
            else:
                bdy
        None -> bdy

    Ok(Response(status_code(status_line), hdrs, body))

// Pull the numeric code out of a status line like "HTTP/1.1 200 OK".
fn status_code(line: String) -> Int:
    let sp = string.index_of(line, " ") ?? -1
    if sp < 0:
        0
    else:
        let rest = string.substring(line, sp + 1, string.char_count(line))
        let sp2 = string.index_of(rest, " ") ?? -1
        let code = if sp2 < 0: rest else: string.substring(rest, 0, sp2)
        // (BUG-203) A malformed/non-HTTP response can carry a non-numeric OR an
        // overflowing code. `string.to_int` TRAPS on i64 overflow — an
        // attacker-controlled response could crash the client — so parse totally
        // with `string.parse_int` (None on non-digit, empty, or overflow) → 0.
        string.parse_int(code) ?? 0

// Decode a `chunked` transfer-coding body: a sequence of
// `<hex-size>[;ext]CRLF <size bytes> CRLF`, ending at a `0`-sized chunk. Total —
// a malformed/truncated stream stops decoding and returns what was recovered
// rather than trapping. Chunk sizes are byte counts, so framing is decoded on
// `Bytes`; only the recovered payload is converted back to text.
fn dechunk(body: String) -> String:
    let raw = bytes.from_string(body)
    let crlf = bytes.from_string("\r\n")
    var out = bytes.from_string("")
    var i = 0
    let n = bytes.length(raw)
    var done = false
    while !done:
        let nl = bytes_index_from(raw, crlf, i)
        if nl < 0:
            done = true
        else:
            let line = bytes.to_string_lossy(bytes.slice(raw, i, nl))
            match parse_hex_size(chunk_size_hex(line)):
                None -> done = true
                Some(sz) ->
                    if sz <= 0:
                        done = true
                    else:
                        let start = nl + 2
                        let stop = start + sz
                        if stop > n:
                            out = bytes.concat(out, bytes.slice(raw, start, n))
                            done = true
                        else:
                            out = bytes.concat(out, bytes.slice(raw, start, stop))
                            i = stop + 2
    bytes.to_string_lossy(out)

fn dechunk_strict(body: String) -> Result(String, ResponseParseError):
    let raw = bytes.from_string(body)
    let crlf = bytes.from_string("\r\n")
    var out = bytes.from_string("")
    var i = 0
    let n = bytes.length(raw)
    while true:
        let nl = bytes_index_from(raw, crlf, i)
        if nl < 0:
            return Err(MissingChunkSizeTerminator)
        let line = bytes.to_string_lossy(bytes.slice(raw, i, nl))
        match parse_hex_size(chunk_size_hex(line)):
            None -> return Err(InvalidChunkSize(line))
            Some(sz) ->
                let start = nl + 2
                if sz <= 0:
                    if start + 2 > n || bytes.slice(raw, start, start + 2) != crlf:
                        return Err(MissingFinalChunkDelimiter)
                    match bytes.decode_utf8(out):
                        Ok(text) -> return Ok(text)
                        Err(_e) -> return Err(InvalidChunkUtf8)
                let stop = start + sz
                if stop > n:
                    return Err(TruncatedChunk)
                if stop + 2 > n || bytes.slice(raw, stop, stop + 2) != crlf:
                    return Err(MissingChunkDelimiter)
                out = bytes.concat(out, bytes.slice(raw, start, stop))
                i = stop + 2
    Err(InternalChunkDecoderState)

// The byte index of `needle` in `b` at or after `from`, or -1.
fn bytes_index_from(b: Bytes, needle: Bytes, from: Int) -> Int:
    if from >= bytes.length(b):
        -1
    else:
        match bytes.index_of(bytes.slice(b, from, bytes.length(b)), needle):
            Some(k) -> from + k
            None -> -1

// The hex size of a chunk line, with any `;chunk-extension` and surrounding
// whitespace stripped.
fn chunk_size_hex(line: String) -> String:
    let semi = string.index_of(line, ";") ?? -1
    let raw = if semi < 0: line else: string.substring(line, 0, semi)
    string.trim(raw)

// Parse a hex string to an Int, totally: `None` on empty, a non-hex digit, or a
// size wide enough to risk i64 overflow (>15 hex digits) — so a hostile chunk
// header can't trap the arithmetic.
fn parse_hex_size(hex: String) -> Option(Int):
    if hex == "" || string.char_count(hex) > 15:
        None
    else:
        var val = 0
        var ok = true
        for c in string.chars(hex):
            match hex_digit(c):
                Some(d) -> val = val * 16 + d
                None -> ok = false
        if ok:
            Some(val)
        else:
            None

// One hex digit `0-9a-fA-F` as its value, or None.
fn hex_digit(c: String) -> Option(Int):
    if string.char_count(c) != 1:
        None
    else:
        match string.index_of("0123456789abcdef", string.to_lower(c)):
            Some(k) -> Some(k)
            None -> None
