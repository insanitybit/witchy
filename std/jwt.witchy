// jwt — verify a compact JWS / JWT (the OIDC identity-token shape), in PURE witchy
// over `crypto` (RS256/ES256), `encoding` (base64url), and `json`. Verification is
// computation, so this module has no host capability of its own — fetching the
// signing keys (JWKS discovery, over HTTPS) is a separate, network-bearing concern.
//
// A compact JWT is `header.payload.signature`, each base64url. The signature covers
// the ASCII bytes of `header.payload`; for RS256 it is verified against the issuer's
// RSA public key (DER PKCS#1, hex). On success the decoded payload `claims` are
// returned for the caller to inspect (`sub`, `iss`, provider-specific owner fields).

import string
import list
import crypto
import encoding
import option
import math
from json import Json

// Verify an RS256 (RSASSA-PKCS1-v1_5 / SHA-256) compact JWT against a DER PKCS#1 RSA
// public key (hex), checking the signature, `exp > now` (unix seconds), and
// `aud == audience`. Returns the decoded claims, or a reason string.
pub fn verify_rs256(token: String, rsa_pubkey_der_hex: String, audience: String, now: Int) -> Result(Json, String):
    let parts = string.split(token, ".")
    if list.length(parts) != 3:
        Err("malformed JWT: expected three `.`-separated segments")
    else:
        // Pin the algorithm: the JOSE header's `alg` MUST be exactly `RS256`. An
        // attacker-chosen `alg` (`none`, a symmetric alg, a downgrade) is refused
        // here rather than trusted — algorithm confusion is defended by failing
        // closed on anything but RS256, never by honouring the header (BUG-250,
        // RFC 8725 §3.1).
        let alg = header_alg(list.at(parts, 0))?
        if alg != "RS256":
            Err("JWT `alg` is `" + alg + "`, not the required `RS256`")
        else:
            let signed = list.at(parts, 0) + "." + list.at(parts, 1)
            // A malformed signature segment is a distinct, reachable error — not a
            // silent truncation to garbage bytes that would later read as "signature
            // invalid". Rejecting on the decode error is the safe direction.
            let sig_hex = encoding.base64url_to_hex(list.at(parts, 2)).map_err(fn(e: String): "JWT signature segment is malformed: " + e)?
            if !crypto.rsa_pkcs1_sha256_verify(rsa_pubkey_der_hex, signed, sig_hex):
                Err("JWT signature is invalid (untrusted or forged)")
            else:
                check_claims(list.at(parts, 1), audience, now)

// The `alg` from a compact JWT's base64url header segment, or an `Err` if the
// header is not valid base64url/JSON or carries no `alg`. A missing `alg` is an
// error (fail closed), not a default.
fn header_alg(header_b64: String) -> Result(String, String):
    let header_json = encoding.base64url_decode(header_b64).map_err(fn(e: String): "JWT header is not valid base64url: " + e)?
    match json.decode(header_json):
        Err(e) -> Err("JWT header is not JSON: " + e)
        Ok(h) ->
            match json.get_string(h, "alg"):
                Some(a) -> Ok(a)
                None -> Err("JWT header is missing `alg`")

// Decode and validate the payload's registered claims: `exp` not in the past, and the
// audience matches (defends against a token minted for a different relying party).
fn check_claims(payload_b64: String, audience: String, now: Int) -> Result(Json, String):
    let payload_json = encoding.base64url_decode(payload_b64).map_err(fn(e: String): "JWT payload is not valid base64url: " + e)?
    match json.decode(payload_json):
        Err(e) -> Err("JWT payload is not JSON: " + e)
        Ok(claims) ->
            if json.get_int(claims, "exp").unwrap_or(0) <= now:
                Err("JWT has expired")
            else if !aud_matches(claims, audience):
                Err("JWT audience mismatch (wrong relying party / replay)")
            else:
                Ok(claims)

// The `aud` claim may be a single string OR an array of strings (RFC 7519 §4.1.3):
// the token is accepted when `audience` is that string, or is a member of that
// array. A missing `aud`, or an `audience` absent from the array, is a mismatch
// (BUG-270).
fn aud_matches(claims: Json, audience: String) -> Bool:
    match json.get(claims, "aud"):
        None -> false
        Some(aud) ->
            match json.as_string(aud):
                Some(single) -> single == audience
                None -> list.contains(json.strings(aud), audience)

// The full OIDC relying-party check: verify the RS256 signature AND that the token was
// minted by the expected `issuer` for the expected `audience`, and is valid now
// (`exp`/`nbf`). Returns the identity claims — `sub` plus provider-specific fields like
// GitHub's `repository` or Google's `email` — for the caller to authorize. This is the
// call a login or trusted-publishing flow makes once it holds the issuer's JWKS key
// (`rsa_key_from_jwk`). The issuer check is what binds a token to a TRUSTED provider:
// without it, anyone who can mint a JWT for the right audience would be admitted.
pub fn verify_oidc(token: String, rsa_pubkey_der_hex: String, issuer: String, audience: String, now: Int) -> Result(Json, String):
    match verify_rs256(token, rsa_pubkey_der_hex, audience, now):
        Err(e) -> Err(e)
        Ok(claims) ->
            if json.get_string(claims, "iss").unwrap_or("") != issuer:
                Err("JWT issuer mismatch (untrusted identity provider)")
            else if not_yet_valid(claims, now):
                Err("JWT is not yet valid (nbf is in the future)")
            else:
                Ok(claims)

// The optional `nbf` (not-before) claim: a token is rejected until its activation time.
// Absent `nbf` means always-active (only `exp` bounds it).
fn not_yet_valid(claims: Json, now: Int) -> Bool:
    match json.get_int(claims, "nbf"):
        None -> false
        Some(nbf) -> nbf > now

// The decoded JOSE header of a compact JWT (its first segment), or an error — so a
// verifier can read `alg`/`kid` to select the JWKS key before checking the signature.
pub fn header(token: String) -> Result(Json, String):
    let parts = string.split(token, ".")
    if list.length(parts) < 1 || string.is_empty(list.at(parts, 0)):
        Err("malformed JWT: no header segment")
    else:
        let header_json = encoding.base64url_decode(list.at(parts, 0)).map_err(fn(e: String): "JWT header is not valid base64url: " + e)?
        json.decode(header_json)

// The payload claims of a compact JWT WITHOUT verifying its signature — for reading the
// routing fields (`iss`, and `kid` via `header`) needed to SELECT the verification key
// before `verify_oidc`. DANGER: never authorize on these claims; verify the signature
// first and read the claims `verify_oidc` returns.
pub fn claims_unverified(token: String) -> Result(Json, String):
    let parts = string.split(token, ".")
    if list.length(parts) < 2 || string.is_empty(list.at(parts, 1)):
        Err("malformed JWT: no payload segment")
    else:
        let payload_json = encoding.base64url_decode(list.at(parts, 1)).map_err(fn(e: String): "JWT payload is not valid base64url: " + e)?
        json.decode(payload_json)

// Build the DER PKCS#1 `RSAPublicKey` (as hex — the shape `verify_rs256` wants) from a
// JWK's base64url modulus `n` and exponent `e`, so an OIDC verifier can turn a JWKS
// entry (`{"kty":"RSA","n":…,"e":…}`) into a key. The result is the ASN.1 DER
// `SEQUENCE { INTEGER n, INTEGER e }`; an INTEGER gains a leading `00` when its top bit
// is set (DER integers are signed two's-complement, RSA values are unsigned magnitudes).
pub fn rsa_key_from_jwk(n: String, e: String) -> Result(String, String):
    let n_hex = encoding.base64url_to_hex(n).map_err(fn(err: String): "JWK modulus `n` is not valid base64url: " + err)?
    let e_hex = encoding.base64url_to_hex(e).map_err(fn(err: String): "JWK exponent `e` is not valid base64url: " + err)?
    // Reject an empty/missing `n` or `e` (a JWK with no such member decodes to empty
    // hex): building a key from them would yield a structurally-valid but bogus DER
    // key that later "verifies" nothing, so fail closed here (BUG-408).
    if string.is_empty(n_hex):
        Err("JWK modulus `n` is empty or missing")
    else if string.is_empty(e_hex):
        Err("JWK exponent `e` is empty or missing")
    else:
        let body = der_integer(n_hex) + der_integer(e_hex)
        Ok("30" + der_len(body) + body)

// An ASN.1 INTEGER (tag `02`) wrapping an unsigned magnitude, sign-padded with `00`
// when the high bit would otherwise read as negative.
fn der_integer(value_hex: String) -> String:
    let content = if high_bit_set(value_hex): "00" + value_hex else: value_hex
    "02" + der_len(content) + content

// DER length of a hex string's byte count (`len/2`): short form below 128, else a
// `0x8N` count-of-length-bytes prefix. RSA keys stay well under 65536 bytes, so one or
// two length bytes always suffice.
fn der_len(content_hex: String) -> String:
    let n = string.length(content_hex) / 2
    if n < 128:
        byte_hex(n)
    else if n < 256:
        "81" + byte_hex(n)
    else:
        "82" + string.pad_left(math.to_hex(n), 4, "0")

// A single byte as exactly two lowercase hex digits.
fn byte_hex(b: Int) -> String:
    string.pad_left(math.to_hex(b), 2, "0")

// Is the top bit of the first byte set (first hex digit in `8`..`f`)? Empty hex is not.
fn high_bit_set(value_hex: String) -> Bool:
    !string.is_empty(value_hex) && string.contains("89abcdef", string.char_at(value_hex, 0) ?? "")

// The `kid` (key id) from a compact JWT's header — used to pick the right JWKS key when a
// provider publishes several (key rotation). `None` if the token or header is malformed.
pub fn kid(token: String) -> Option(String):
    match header(token):
        Err(_) -> None
        Ok(h) -> json.get_string(h, "kid")

// Select the RSA public key for `kid` from a JWKS document (`{"keys":[{"kty":"RSA","kid":
// …,"n":…,"e":…}, …]}`) and return it as the DER PKCS#1 hex `verify_rs256`/`verify_oidc`
// want. This is how an OIDC verifier consumes a provider's published keys (Google, GitHub
// Actions): fetch the JWKS, read the token's `kid` (`jwt.kid`), then pick the key.
pub fn rsa_key_for_kid(jwks: Json, key_id: String) -> Result(String, String):
    match json.get(jwks, "keys"):
        None -> Err("JWKS has no `keys` array")
        Some(keys) ->
            match find_rsa_jwk(json.as_array(keys).unwrap_or([]), key_id):
                None -> Err("no RSA key in the JWKS matches kid `" + key_id + "`")
                Some(ne) ->
                    let (n, e) = ne
                    rsa_key_from_jwk(n, e)

// First RSA JWK whose `kid` matches, as its `(n, e)` base64url pair.
fn find_rsa_jwk(keys: List(Json), key_id: String) -> Option((String, String)):
    for k in keys:
        if json.get_string(k, "kty").unwrap_or("") == "RSA" && json.get_string(k, "kid").unwrap_or("") == key_id:
            return Some((json.get_string(k, "n").unwrap_or(""), json.get_string(k, "e").unwrap_or("")))
    None
