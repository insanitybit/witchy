// Set(a) — an unordered collection of distinct values. Members are compared by
// value equality (a `where a: Eq` bound on every operation that compares), so
// sets of Ints, Strings, tuples, or your own `Eq` types all work. Build one with
// `set.new()` / `set.from_list(xs)`, test membership with `set.contains`, and
// reach for `union`/`intersection`/`difference` for the algebra. A `Set` whose
// members are `Show` renders as `{a, b, c}` through `show`/`say` (import `show`);
// `set.to_list(s)` returns the members in insertion order.

import cmp
import list
import string

sealed type Set(a):
    items: List(a)

// Two sets are equal when they hold exactly the same members, regardless of
// insertion order or the backing list's layout: `from_list([1, 2, 3])` equals
// `from_list([3, 2, 1])`. Without this impl, `==` falls back to the derived
// structural equality of the backing list (order-sensitive on the interpreter,
// and unresolvable on the compiled backend), which is not set equality.
impl PartialEq for Set(a) where a: Eq:
    fn eq(self, other: Self) -> Bool:
        is_subset(self, other) && is_subset(other, self)

impl Eq for Set(a) where a: Eq

// The empty set.
pub fn new() -> Set(a):
    Set([])

// A set of the distinct values in `xs` (duplicates collapse).
pub fn from_list(xs: List(a)) -> Set(a) where a: Eq:
    var s = new()
    for x in xs:
        s = insert(s, x)
    s

// `s` with `x` added (a no-op if already present).
pub fn insert(var s: Set(a), x: a) -> Set(a) where a: Eq:
    let items = s.items
    if cmp.member(items, x):
        s
    else:
        Set(list.push(items, x))

// `s` with `x` removed (a no-op if absent).
pub fn remove(var s: Set(a), x: a) -> Set(a) where a: Eq:
    let items = s.items
    var out = []
    for y in items:
        if !cmp.member([x], y):
            out = list.push(out, y)
    Set(out)

// Whether `x` is a member of `s`.
pub fn contains(s: Set(a), x: a) -> Bool where a: Eq:
    let items = s.items
    cmp.member(items, x)

// The number of distinct members.
pub fn length(s: Set(a)) -> Int:
    list.length(s.items)

// Whether the set has no members.
pub fn is_empty(s: Set(a)) -> Bool:
    list.length(s.items) == 0

// The members as a list, in insertion order.
pub fn to_list(s: Set(a)) -> List(a):
    s.items

// Every member of either set.
pub fn union(s: Set(a), t: Set(a)) -> Set(a) where a: Eq:
    let titems = t.items
    var out = s
    for x in titems:
        out = insert(out, x)
    out

// The members in both sets.
pub fn intersection(s: Set(a), t: Set(a)) -> Set(a) where a: Eq:
    let sitems = s.items
    let titems = t.items
    var out = []
    for x in sitems:
        if cmp.member(titems, x):
            out = list.push(out, x)
    Set(out)

// The members of `s` that are not in `t`.
pub fn difference(s: Set(a), t: Set(a)) -> Set(a) where a: Eq:
    let sitems = s.items
    let titems = t.items
    var out = []
    for x in sitems:
        if !cmp.member(titems, x):
            out = list.push(out, x)
    Set(out)

// The members in exactly one of the two sets.
pub fn symmetric_difference(s: Set(a), t: Set(a)) -> Set(a) where a: Eq:
    let sitems = s.items
    let titems = t.items
    var out = []
    for x in sitems:
        if !cmp.member(titems, x):
            out = list.push(out, x)
    for y in titems:
        if !cmp.member(sitems, y):
            out = list.push(out, y)
    Set(out)

// Whether every member of `s` is also in `t`.
pub fn is_subset(s: Set(a), t: Set(a)) -> Bool where a: Eq:
    let sitems = s.items
    let titems = t.items
    var ok = true
    for x in sitems:
        if !cmp.member(titems, x):
            ok = false
    ok

// Whether the two sets share no members.
pub fn is_disjoint(s: Set(a), t: Set(a)) -> Bool where a: Eq:
    let sitems = s.items
    let titems = t.items
    var ok = true
    for x in sitems:
        if cmp.member(titems, x):
            ok = false
    ok
