// ASCII character predicates over single-character strings (such as those
// `string.char_at` returns). Pure and capability-free, like every std module.
// Classification is by code point in the ASCII range; the comparisons use the
// standard string ordering, so every function here is correct on both the
// interpreter and the compiled backend. The rough equivalent of Go's `unicode`
// helpers for the ASCII subset.

import option

// Each predicate is false for anything but a SINGLE character in its class:
// a bare lexicographic range check would classify by prefix ("55" would pass
// `"0" <= c && c <= "9"`), silently accepting multi-character strings the
// contract excludes.
fn one_char(c: String) -> Bool:
    string.char_count(c) == 1

pub fn is_digit(c: String) -> Bool:
    one_char(c) && "0" <= c && c <= "9"

pub fn is_upper(c: String) -> Bool:
    one_char(c) && "A" <= c && c <= "Z"

pub fn is_lower(c: String) -> Bool:
    one_char(c) && "a" <= c && c <= "z"

pub fn is_alpha(c: String) -> Bool:
    is_upper(c) || is_lower(c)

pub fn is_alnum(c: String) -> Bool:
    is_alpha(c) || is_digit(c)

pub fn is_space(c: String) -> Bool:
    c == " " || c == "\t" || c == "\n" || c == "\r"

// The numeric value of a single decimal digit as `Some`, or `None` when `c` is
// not a digit (RFC-0044 rule 1: absence is `Option`, never a -1 sentinel).
pub fn to_digit(c: String) -> Option(Int):
    if is_digit(c):
        Some(string.to_int(c))
    else:
        None

// True when `s` is non-empty and every character is an ASCII digit — a safe
// guard before `string_to_int`, which traps on non-numeric input.
pub fn all_digits(s: String) -> Bool:
    let n = string.char_count(s)
    if n == 0:
        false
    else:
        var ok = true
        var i = 0
        while i < n:
            if !is_digit(string.substring(s, i, i + 1)):
                ok = false
            i = i + 1
        ok
