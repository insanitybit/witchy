// A JSON library — the witchy take on Go's encoding/json. This slice is the
// value type and the encoder (serialization); the decoder (parsing) follows.
// Pure and capability-free, so — unlike networking — it compiles to WASM like
// the rest of the data std.

import string
// `decode` returns a `Result` and the accessors return `Option`; importing
// these brings `Ok`/`Err`/`Result` and `Some`/`None`/`Option` into scope for any
// program that imports `json`.
import result
import option
// Reflection backs `from_value`/`stringify`: encode ANY value to JSON with no
// `derive(Json)` — `reflect(x)` gives the structure, and we walk the `Mirror`.

// `impl From(a) for Json` gives `Json.from(x)` / `x.into()` for reflectable values.
import convert
from reflect import Mirror

type Json:
    JsonNull
    JsonBool(Bool)
    JsonInt(Int)
    JsonFloat(Float)
    JsonString(String)
    JsonArray(List(Json))
    JsonObject(List((String, Json)))

// Serialize a Json value to its compact textual form.
pub fn encode(j: Json) -> String:
    match j:
        JsonNull -> "null"
        JsonBool(b) -> if b: "true" else: "false"
        JsonInt(n) -> "${n}"
        JsonFloat(x) -> "${x}"
        JsonString(s) -> encode_string(s)
        JsonArray(items) -> encode_array(items)
        JsonObject(pairs) -> encode_object(pairs)

// Serialize with 2-space indentation, for human-readable output. Empty arrays
// and objects stay on one line (`[]` / `{}`).
pub fn encode_pretty(j: Json) -> String:
    encode_indent(j, 0)

fn encode_indent(j: Json, depth: Int) -> String:
    match j:
        JsonNull -> "null"
        JsonBool(b) -> if b: "true" else: "false"
        JsonInt(n) -> "${n}"
        JsonFloat(x) -> "${x}"
        JsonString(s) -> encode_string(s)
        JsonArray(items) -> pretty_array(items, depth)
        JsonObject(pairs) -> pretty_object(pairs, depth)

fn pretty_array(items: List(Json), depth: Int) -> String:
    if list.length(items) == 0:
        "[]"
    else:
        let pad = indent(depth + 1)
        var out = "[\n"
        var first = true
        for it in items:
            if first:
                first = false
            else:
                out = out + ",\n"
            out = out + pad + encode_indent(it, depth + 1)
        out + "\n" + indent(depth) + "]"

fn pretty_object(pairs: List((String, Json)), depth: Int) -> String:
    if list.length(pairs) == 0:
        "{}"
    else:
        let pad = indent(depth + 1)
        var out = "{\n"
        var first = true
        for p in pairs:
            let (k, v) = p
            if first:
                first = false
            else:
                out = out + ",\n"
            out = out + pad + encode_string(k) + ": " + encode_indent(v, depth + 1)
        out + "\n" + indent(depth) + "}"

fn indent(depth: Int) -> String:
    var out = ""
    var i = 0
    while i < depth:
        out = out + "  "
        i = i + 1
    out

fn encode_array(items: List(Json)) -> String:
    var out = "["
    var first = true
    for it in items:
        if first:
            first = false
        else:
            out = out + ","
        out = out + encode(it)
    out + "]"

fn encode_object(pairs: List((String, Json))) -> String:
    var out = "{"
    var first = true
    for p in pairs:
        let (k, v) = p
        if first:
            first = false
        else:
            out = out + ","
        out = out + encode_string(k) + ":" + encode(v)
    out + "}"

// Wrap `s` in quotes, escaping the characters JSON requires.
fn encode_string(s: String) -> String:
    var out = "\""
    for c in string.chars(s):
        out = out + escape_char(c)
    out + "\""

fn escape_char(c: String) -> String:
    if c == "\"":
        "\\\""
    else if c == "\\":
        "\\\\"
    else if c == "\n":
        "\\n"
    else if c == "\t":
        "\\t"
    else if c == "\r":
        "\\r"
    else if c < " ":
        escape_control(c)
    else:
        c

// A C0 control character (`c < U+0020`, other than the `\n`/`\t`/`\r` handled
// above) rendered as a JSON escape: `\b`/`\f` in short form, the rest as
// `\u00XX`. RFC 8259 forbids a raw control character inside a string, so without
// this the encoder produced invalid JSON no conformant parser would accept.
fn escape_control(c: String) -> String:
    let code = control_code(c)
    if code == 8:
        "\\b"
    else if code == 12:
        "\\f"
    else:
        "\\u00" + hex_digit(code / 16) + hex_digit(code % 16)

// The Unicode scalar value of a single character — the inverse of
// `string.from_code`, found by scanning the C0 range. Only called for
// `c < U+0020`, so the scan never exceeds 32 iterations.
fn control_code(c: String) -> Int:
    var k = 0
    while k < 32:
        if c == string.from_code(k):
            return k
        k = k + 1
    0

// One lowercase hex digit for `v` in 0..15 (always in range here).
fn hex_digit(v: Int) -> String:
    string.substring("0123456789abcdef", v, v + 1)

// --- Decoder (parsing) ---------------------------------------------------
//
// A recursive-descent parser. Helpers return `(value, index just past it)` on
// success and thread errors with `?`. Numbers are integers only (JSON floats
// would need a Float-in-collections representation and float-to-string the WASM
// backend still lacks); fractional/exponent numbers decode to `JsonFloat` (see
// error rather than mis-parsed.

// Parse a complete JSON document, or return an error message. The whole input
// must be a single value: trailing content after it (other than whitespace) is
// rejected, so `decode("1 2")` is an Err rather than silently yielding `1`.
pub fn decode(s: String) -> Result(Json, String):
    // Scan over the CHAR ARRAY (one O(n) `string.chars` pass) and index it with O(1)
    // `list.at`, so the whole parse is O(n). Reading characters with `string.substring(s, j,
    // j + 1)` instead would be O(j) per char (UTF-8 character indexing walks from the start),
    // i.e. O(n^2) overall — which made decoding even a modest document take hundreds of ms.
    let cs = string.chars(s)
    let r = parse_value(cs, skip_ws(cs, 0), 0)?
    let (v, rest) = r
    let end = skip_ws(cs, rest)
    if end < list.length(cs):
        Err("unexpected trailing content at " + "${end}")
    else:
        Ok(v)

// Re-join `cs[a..b)` into a String — for the rare multi-char spans (a number's or literal's
// text). The spans are short, so the per-char concat is negligible.
fn cspan(cs: List(String), a: Int, b: Int) -> String:
    var out = ""
    var k = a
    while k < b:
        out = out + list.at(cs, k)
        k = k + 1
    out

// The index of the first non-whitespace char at or after `i`.
fn skip_ws(cs: List(String), i: Int) -> Int:
    var j = i
    let n = list.length(cs)
    while j < n:
        let c = list.at(cs, j)
        if c == " " || c == "\n" || c == "\t" || c == "\r":
            j = j + 1
        else:
            return j
    j

// Parse the value at `i` (whitespace already skipped).
fn parse_value(cs: List(String), i: Int, depth: Int) -> Result((Json, Int), String):
    if depth > 256:
        // SEC-031: bound recursion. A deeply-nested document would otherwise exhaust the
        // call stack and TRAP the VM — an unauthenticated DoS via any `json.decode` of
        // untrusted input (HTTP bodies, registry records). 256 is far beyond any real
        // document and well below the stack limit.
        Err("JSON nesting too deep (max 256)")
    else if i >= list.length(cs):
        Err("unexpected end of input")
    else:
        let c = list.at(cs, i)
        if c == "{":
            parse_object(cs, i, depth)
        else if c == "[":
            parse_array(cs, i, depth)
        else if c == "\"":
            parse_string(cs, i)
        else if c == "t":
            parse_lit(cs, i, "true", JsonBool(true))
        else if c == "f":
            parse_lit(cs, i, "false", JsonBool(false))
        else if c == "n":
            parse_lit(cs, i, "null", JsonNull)
        else:
            parse_number(cs, i)

fn parse_lit(cs: List(String), i: Int, word: String, value: Json) -> Result((Json, Int), String):
    let n = string.char_count(word)
    if i + n <= list.length(cs) && cspan(cs, i, i + n) == word:
        Ok((value, i + n))
    else:
        Err("invalid literal at " + "${i}")

fn is_digit(c: String) -> Bool:
    c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"

// Fold a run of decimal digits (with an optional leading `-`) into a Float
// without an intermediate i64, so a large integer part never overflows. Each
// per-digit `string.to_int` is on a single character, so it can't trap.
fn digits_to_float(s: String) -> Float:
    let n = string.char_count(s)
    var i = 0
    var neg = false
    if n > 0 && string.substring(s, 0, 1) == "-":
        neg = true
        i = 1
    var acc = 0.0
    while i < n:
        acc = acc * 10.0 + math.to_float(string.to_int(string.substring(s, i, i + 1)))
        i = i + 1
    if neg:
        0.0 - acc
    else:
        acc

fn parse_number(cs: List(String), i: Int) -> Result((Json, Int), String):
    let n = list.length(cs)
    var j = i
    if j < n && list.at(cs, j) == "-":
        j = j + 1
    var digits = 0
    while j < n && is_digit(list.at(cs, j)):
        j = j + 1
        digits = digits + 1
    if digits == 0:
        Err("invalid number at " + "${i}")
    else if j < n && is_float_tail(list.at(cs, j)):
        parse_float_tail(cs, i, j)
    else:
        // A bare integer literal beyond the i64 range can't be a `JsonInt`;
        // report it rather than trapping in the raw `string.to_int`.
        match string.parse_int(cspan(cs, i, j)):
            Some(v) -> Ok((JsonInt(v), j))
            None -> Err("integer out of range at " + "${i}")

// A `.`/`e`/`E` after the integer digits: parse the fraction and exponent and
// build a JsonFloat. (Assembled from parts with float arithmetic — fine for
// data interchange; extreme magnitudes may round in the last places.)
fn parse_float_tail(cs: List(String), start: Int, ip_end: Int) -> Result((Json, Int), String):
    let n = list.length(cs)
    var j = ip_end
    var frac = 0
    var frac_digits = 0
    if j < n && list.at(cs, j) == ".":
        j = j + 1
        while j < n && is_digit(list.at(cs, j)):
            frac = frac * 10 + string.to_int(list.at(cs, j))
            frac_digits = frac_digits + 1
            j = j + 1
        if frac_digits == 0:
            return Err("invalid number at " + "${start}")
    var exp = 0
    var exp_neg = false
    if j < n && (list.at(cs, j) == "e" || list.at(cs, j) == "E"):
        j = j + 1
        if j < n && list.at(cs, j) == "+":
            j = j + 1
        else if j < n && list.at(cs, j) == "-":
            exp_neg = true
            j = j + 1
        var exp_digits = 0
        while j < n && is_digit(list.at(cs, j)):
            exp = exp * 10 + string.to_int(list.at(cs, j))
            exp_digits = exp_digits + 1
            j = j + 1
        if exp_digits == 0:
            return Err("invalid number at " + "${start}")
    let negative = list.at(cs, start) == "-"
    // Fold the integer-part digits straight into a Float: a float literal with a
    // huge integer part (`99999999999999999999.5`) is valid JSON and must not
    // trap the way `string.to_int` would on an out-of-i64 magnitude.
    var x = digits_to_float(cspan(cs, start, ip_end))
    var fpart = math.to_float(frac) / pow10(frac_digits)
    if negative:
        fpart = 0.0 - fpart
    x = x + fpart
    if exp_neg:
        x = x / pow10(exp)
    else:
        x = x * pow10(exp)
    Ok((JsonFloat(x), j))

fn pow10(k: Int) -> Float:
    var out = 1.0
    var i = 0
    while i < k:
        out = out * 10.0
        i = i + 1
    out

fn is_float_tail(c: String) -> Bool:
    c == "." || c == "e" || c == "E"

fn parse_string(cs: List(String), i: Int) -> Result((Json, Int), String):
    let r = scan_string(cs, i + 1)?
    let (text, j) = r
    Ok((JsonString(text), j))

// Scan string contents from `start` (just past the opening quote) to the
// closing quote, returning the unescaped text and the index past the quote.
fn scan_string(cs: List(String), start: Int) -> Result((String, Int), String):
    var acc = ""
    var j = start
    let n = list.length(cs)
    while j < n:
        let c = list.at(cs, j)
        if c == "\"":
            return Ok((acc, j + 1))
        else if c == "\\":
            if j + 1 >= n:
                return Err("unterminated escape")
            else if list.at(cs, j + 1) == "u":
                let r = scan_unicode(cs, j, n)?
                let (decoded, k) = r
                acc = acc + decoded
                j = k
            else:
                acc = acc + unescape(list.at(cs, j + 1))
                j = j + 2
        else:
            acc = acc + c
            j = j + 1
    Err("unterminated string")

fn unescape(e: String) -> String:
    if e == "n":
        "\n"
    else if e == "t":
        "\t"
    else if e == "r":
        "\r"
    else if e == "b":
        string.from_code(8)
    else if e == "f":
        string.from_code(12)
    else if e == "/":
        "/"
    else:
        e

// One hex digit (0-9, a-f, A-F) to its 0..15 value, or -1 if not a hex digit.
fn hex_val(c: String) -> Int:
    string.index_of("0123456789abcdef", string.to_lower(c)) ?? -1

// The 16-bit value of the four hex digits at `j`, or -1 if any is not hex.
fn hex4(cs: List(String), j: Int) -> Int:
    let a = hex_val(list.at(cs, j))
    let b = hex_val(list.at(cs, j + 1))
    let c = hex_val(list.at(cs, j + 2))
    let d = hex_val(list.at(cs, j + 3))
    if a < 0 || b < 0 || c < 0 || d < 0:
        -1
    else:
        a * 4096 + b * 256 + c * 16 + d

// Decode a `\uXXXX` escape (with `j` at the backslash). A high surrogate
// (U+D800..U+DBFF) is combined with the following `\uXXXX` low surrogate into a
// single astral code point — how JSON encodes characters beyond the BMP.
// Returns the decoded character and the index just past the escape.
fn scan_unicode(cs: List(String), j: Int, n: Int) -> Result((String, Int), String):
    if j + 6 > n:
        return Err("incomplete \\u escape")
    let cp = hex4(cs, j + 2)
    if cp < 0:
        return Err("invalid \\u escape")
    if cp >= 55296 && cp <= 56319:
        if j + 12 > n || cspan(cs, j + 6, j + 8) != "\\u":
            return Err("unpaired high surrogate")
        let lo = hex4(cs, j + 8)
        if lo < 56320 || lo > 57343:
            return Err("invalid low surrogate")
        Ok((string.from_code(65536 + (cp - 55296) * 1024 + (lo - 56320)), j + 12))
    else if cp >= 56320 && cp <= 57343:
        Err("unexpected low surrogate")
    else:
        Ok((string.from_code(cp), j + 6))

fn parse_array(cs: List(String), i: Int, depth: Int) -> Result((Json, Int), String):
    let n = list.length(cs)
    var items = []
    var j = skip_ws(cs, i + 1)
    if j < n && list.at(cs, j) == "]":
        return Ok((JsonArray(items), j + 1))
    while true:
        let r = parse_value(cs, skip_ws(cs, j), depth + 1)?
        let (v, k) = r
        items = list.push(items, v)
        let m = skip_ws(cs, k)
        if m >= n:
            return Err("unterminated array")
        let c = list.at(cs, m)
        if c == "]":
            return Ok((JsonArray(items), m + 1))
        else if c == ",":
            j = m + 1
        else:
            return Err("expected , or ] in array")
    Err("unreachable")

fn parse_object(cs: List(String), i: Int, depth: Int) -> Result((Json, Int), String):
    let n = list.length(cs)
    var pairs = []
    var j = skip_ws(cs, i + 1)
    if j < n && list.at(cs, j) == "}":
        return Ok((JsonObject(pairs), j + 1))
    while true:
        let ws = skip_ws(cs, j)
        if ws >= n || list.at(cs, ws) != "\"":
            return Err("expected string key in object")
        let kr = scan_string(cs, ws + 1)?
        let (key, k1) = kr
        let colon = skip_ws(cs, k1)
        if colon >= n || list.at(cs, colon) != ":":
            return Err("expected : in object")
        let vr = parse_value(cs, skip_ws(cs, colon + 1), depth + 1)?
        let (v, k2) = vr
        pairs = list.push(pairs, (key, v))
        let m = skip_ws(cs, k2)
        if m >= n:
            return Err("unterminated object")
        let c = list.at(cs, m)
        if c == "}":
            return Ok((JsonObject(pairs), m + 1))
        else if c == ",":
            j = m + 1
        else:
            return Err("expected , or } in object")
    Err("unreachable")

// --- Accessors -----------------------------------------------------------
//
// Read data out of a decoded value. Each returns an Option, so a wrong shape is
// `None` rather than a trap.

// Look up a key in a JSON object.
pub fn get(j: Json, key: String) -> Option(Json):
    match j:
        JsonObject(pairs) -> find_key(pairs, key)
        _ -> None

fn find_key(pairs: List((String, Json)), key: String) -> Option(Json):
    for p in pairs:
        let (k, v) = p
        if k == key:
            return Some(v)
    None

// Whether a JSON object has `key` (false for non-objects).
pub fn contains_key(j: Json, key: String) -> Bool:
    match j:
        JsonObject(pairs) -> pairs_contains_key(pairs, key)
        _ -> false

fn pairs_contains_key(pairs: List((String, Json)), key: String) -> Bool:
    for p in pairs:
        let (k, _v) = p
        if k == key:
            return true
    false

// A shallow merge of two JSON objects: every key of `b` overrides the same key
// in `a`, and `a`'s other keys are kept. If either value is not an object, `b`
// wins (so it works as "patch `a` with `b`"). Override is top-level only —
// nested objects are replaced, not deep-merged.
pub fn merge(a: Json, b: Json) -> Json:
    match a:
        JsonObject(pa) ->
            match b:
                JsonObject(pb) -> JsonObject(merge_pairs(pa, pb))
                _ -> b
        _ -> b

fn merge_pairs(pa: List((String, Json)), pb: List((String, Json))) -> List((String, Json)):
    var out = []
    for p in pa:
        let (k, _v) = p
        if !pairs_contains_key(pb, k):
            out = list.push(out, p)
    for q in pb:
        out = list.push(out, q)
    out

// The element at index `i` of a JSON array.
pub fn index(j: Json, i: Int) -> Option(Json):
    match j:
        JsonArray(items) -> if i >= 0 && i < list.length(items): Some(list.at(items, i)) else: None
        _ -> None

// `j` as an integer, when it is one.
pub fn as_int(j: Json) -> Option(Int):
    match j:
        JsonInt(n) -> Some(n)
        _ -> None

// `j` as a string, when it is one.
pub fn as_string(j: Json) -> Option(String):
    match j:
        JsonString(s) -> Some(s)
        _ -> None

// `j` as a bool, when it is one.
pub fn as_bool(j: Json) -> Option(Bool):
    match j:
        JsonBool(b) -> Some(b)
        _ -> None

// `j` as a list of elements, when it is an array.
pub fn as_array(j: Json) -> Option(List(Json)):
    match j:
        JsonArray(items) -> Some(items)
        _ -> None

// `j` as its key/value pairs, when it is an object — for iterating an object
// whose keys aren't known ahead of time.
pub fn as_object(j: Json) -> Option(List((String, Json))):
    match j:
        JsonObject(pairs) -> Some(pairs)
        _ -> None

// Reconstruct a value from a `Json`. Reflection can read a value's structure but not
// rebuild a value from structure, so `derive(Deserialize)` generates `from_json` per
// type. Encoding needs no trait: `from_value`, `stringify`, and `x.into()` already
// serialize any `Reflect` value.
trait Deserialize:
    fn from_json(j: Json) -> Result(Self, String)

// --- Result-returning decoders (the backbone of `derive(Deserialize)`'s from_json) -----
pub fn require(j: Json, key: String) -> Result(Json, String):
    match get(j, key):
        Some(v) -> Ok(v)
        None -> Err("missing field `" + key + "`")

// Coerce a Json value to a scalar, or `Err` describing the expected shape.
pub fn int_of(j: Json) -> Result(Int, String):
    match j:
        JsonInt(n) -> Ok(n)
        _ -> Err("expected an integer")

pub fn string_of(j: Json) -> Result(String, String):
    match j:
        JsonString(s) -> Ok(s)
        _ -> Err("expected a string")

pub fn bool_of(j: Json) -> Result(Bool, String):
    match j:
        JsonBool(b) -> Ok(b)
        _ -> Err("expected a boolean")

pub fn float_of(j: Json) -> Result(Float, String):
    match j:
        JsonFloat(f) -> Ok(f)
        _ -> Err("expected a number")

pub fn array_of(j: Json) -> Result(List(Json), String):
    match j:
        JsonArray(items) -> Ok(items)
        _ -> Err("expected an array")

// Decode an optional field: an absent key or an explicit `null` is `None`;
// otherwise the value is decoded via `each`. Used for `Option(_)` fields.
pub fn optional(o: Option(Json), each: fn(Json) -> Result(a, String)) -> Result(Option(a), String):
    match o:
        None -> Ok(None)
        Some(JsonNull) -> Ok(None)
        Some(v) -> match each(v):
            Ok(x) -> Ok(Some(x))
            Err(e) -> Err(e)

// Build a JSON object whose keys are sorted (matching a serialized BTreeMap),
// e.g. TUF `targets`. Use this only for dynamic key/value sets whose order must
// be deterministic for signing; records that derive(Json) keep their declared
// field order instead.
pub fn object_sorted(pairs: List((String, Json))) -> Json:
    var sorted: List((String, Json)) = []
    for p in pairs:
        sorted = insert_by_key(sorted, p)
    JsonObject(sorted)

fn insert_by_key(sorted: List((String, Json)), item: (String, Json)) -> List((String, Json)):
    let (ik, _iv) = item
    var out = []
    var placed = false
    for p in sorted:
        let (k, _v) = p
        if !placed && ik < k:
            out = list.push(out, item)
            placed = true
        out = list.push(out, p)
    if !placed:
        out = list.push(out, item)
    out

// --- typed field accessors (get a key, then coerce) --------------------------
// `get` composed with each `as_*` — the common case of reading a typed field out
// of an object without spelling the two steps every time.
pub fn get_string(j: Json, key: String) -> Option(String):
    match get(j, key):
        Some(v) -> as_string(v)
        None -> None

pub fn get_int(j: Json, key: String) -> Option(Int):
    match get(j, key):
        Some(v) -> as_int(v)
        None -> None

pub fn get_bool(j: Json, key: String) -> Option(Bool):
    match get(j, key):
        Some(v) -> as_bool(v)
        None -> None

// The string array at `key` as a `List(String)`, dropping any non-string element;
// `[]` when the key is absent or not an array. Collapses the very common
// "decode an object's array-of-strings field" pattern into one call.
pub fn get_strings(j: Json, key: String) -> List(String):
    match get(j, key):
        Some(arr) -> strings(arr)
        None -> []

// A JSON array value as a `List(String)` (non-strings dropped).
pub fn strings(j: Json) -> List(String):
    var out = []
    if let Some(items) = as_array(j):
        for it in items:
            if let Some(s) = as_string(it):
                out = list.push(out, s)
    out

// The string at index `i` of a JSON array, when it is a string.
pub fn index_string(j: Json, i: Int) -> Option(String):
    match index(j, i):
        Some(v) -> as_string(v)
        None -> None

// Follow a dotted path of object keys, e.g. `get_path(resp, "user.name")`. Any
// missing key (or a non-object along the way) yields `None`.
pub fn get_path(j: Json, path: String) -> Option(Json):
    var cur = Some(j)
    for seg in string.split(path, "."):
        cur = step(cur, seg)
    cur

fn step(cur: Option(Json), seg: String) -> Option(Json):
    match cur:
        Some(j) -> get(j, seg)
        None -> None

// Encode an `Option` as payload-or-`null` — `Some(x)` through `each`, `None` as
// `JsonNull`. Keeps a derived `to_json`'s Option field a single-line call. (The
// param is `each`, not `encode`, so it doesn't shadow `json.encode`.)
pub fn from_option(o: Option(a), each: fn(a) -> Json) -> Json:
    match o:
        Some(x) -> each(x)
        None -> JsonNull

// --- reflective encoding (no derive) -----------------------------------------
// `from_value(x)` encodes a value to `Json` by reflecting over its structure, so
// it works for any type with no derive. `stringify(x)` returns the encoded string.
pub fn from_value(x: a) -> Json where a: Reflect:
    mirror_to_json(reflect(x))

pub fn stringify(x: a) -> String where a: Reflect:
    encode(from_value(x))

// A `Json` reflects to its own value rather than to the `Json` enum's shape, so
// `mirror_to_json(reflect(j))` returns `j`. This lets an already-built `Json` (a
// decoded record, a signed blob) sit inside a reflected value such as an anonymous
// struct, e.g. `json.stringify(.{record: decoded, ok: true})`.
impl Reflect for Json:
    fn reflect(self) -> Mirror:
        match self:
            JsonNull -> MNil
            JsonBool(b) -> MBool(b)
            JsonInt(n) -> MInt(n)
            JsonFloat(f) -> MFloat(f)
            JsonString(s) -> MString(s)
            JsonArray(xs) -> MList(reflect_json_each(xs))
            JsonObject(fields) -> MRecord("", reflect_json_fields(fields))

fn reflect_json_each(xs: List(Json)) -> List(Mirror):
    var out = []
    for x in xs:
        out = list.push(out, x.reflect())
    out

fn reflect_json_fields(fields: List((String, Json))) -> List((String, Mirror)):
    var out = []
    for k, v in fields:
        out = list.push(out, (k, v.reflect()))
    out

// Convert any reflectable value to `Json`, which also gives `Json.from(x)` and
// `x.into()` through `std/convert`'s blanket `Into`. This is `from_value` exposed
// as `From`, so a handler can accept `x: Into(Json)` instead of a pre-encoded string.
impl From(a) for Json where a: Reflect:
    fn from(value: a) -> Json:
        from_value(value)

fn mirror_to_json(m: Mirror) -> Json:
    match m:
        MInt(n) -> JsonInt(n)
        MFloat(f) -> JsonFloat(f)
        MBool(b) -> JsonBool(b)
        MString(s) -> JsonString(s)
        MNil -> JsonNull
        MList(xs) -> JsonArray(mirror_each(xs))
        MTuple(xs) -> JsonArray(mirror_each(xs))
        MRecord(_name, fields) -> JsonObject(mirror_fields(fields))
        MVariant(tyname, variant, payload) -> mirror_variant_to_json(tyname, variant, payload)

fn mirror_each(xs: List(Mirror)) -> List(Json):
    var out = []
    for m in xs:
        out = list.push(out, mirror_to_json(m))
    out

fn mirror_fields(fields: List((String, Mirror))) -> List((String, Json)):
    var out = []
    for k, m in fields:
        out = list.push(out, (k, mirror_to_json(m)))
    out

// An `Option` encodes as payload-or-`null` (matching `derive(Json)`); any other
// sum-type variant as a tagged object `{"$variant": name, "$values": [...]}`.
fn mirror_variant_to_json(tyname: String, variant: String, payload: List(Mirror)) -> Json:
    if tyname == "Option":
        match list.head(payload):
            Some(m) -> mirror_to_json(m)
            None -> JsonNull
    else:
        JsonObject([("\$variant", JsonString(variant)), ("\$values", JsonArray(mirror_each(payload)))])
