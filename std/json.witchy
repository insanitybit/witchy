// A JSON library — the witchy take on Go's encoding/json. This slice is the
// value type and the encoder (serialization); the decoder (parsing) follows.
// Pure and capability-free, so — unlike networking — it compiles to WASM like
// the rest of the data std.

import string
// `decode` returns a `Result` and the accessors return `Option`; importing
// these brings `Ok`/`Err`/`Result` and `Some`/`None`/`Option` into scope for any
// program that imports `json`.
import result
import option

type Json:
    JsonNull
    JsonBool(Bool)
    JsonInt(Int)
    JsonFloat(Float)
    JsonString(String)
    JsonArray(List(Json))
    JsonObject(List((String, Json)))

// Serialize a Json value to its compact textual form.
pub fn encode(j: Json) -> String:
    match j:
        JsonNull -> "null"
        JsonBool(b) -> if b: "true" else: "false"
        JsonInt(n) -> "${n}"
        JsonFloat(x) -> "${x}"
        JsonString(s) -> encode_string(s)
        JsonArray(items) -> encode_array(items)
        JsonObject(pairs) -> encode_object(pairs)

// Serialize with 2-space indentation, for human-readable output. Empty arrays
// and objects stay on one line (`[]` / `{}`).
pub fn encode_pretty(j: Json) -> String:
    encode_indent(j, 0)

fn encode_indent(j: Json, depth: Int) -> String:
    match j:
        JsonNull -> "null"
        JsonBool(b) -> if b: "true" else: "false"
        JsonInt(n) -> "${n}"
        JsonFloat(x) -> "${x}"
        JsonString(s) -> encode_string(s)
        JsonArray(items) -> pretty_array(items, depth)
        JsonObject(pairs) -> pretty_object(pairs, depth)

fn pretty_array(items: List(Json), depth: Int) -> String:
    if list.length(items) == 0:
        "[]"
    else:
        let pad = indent(depth + 1)
        var out = "[\n"
        var first = true
        for it in items:
            if first:
                first = false
            else:
                out = out + ",\n"
            out = out + pad + encode_indent(it, depth + 1)
        out + "\n" + indent(depth) + "]"

fn pretty_object(pairs: List((String, Json)), depth: Int) -> String:
    if list.length(pairs) == 0:
        "{}"
    else:
        let pad = indent(depth + 1)
        var out = "{\n"
        var first = true
        for p in pairs:
            let (k, v) = p
            if first:
                first = false
            else:
                out = out + ",\n"
            out = out + pad + encode_string(k) + ": " + encode_indent(v, depth + 1)
        out + "\n" + indent(depth) + "}"

fn indent(depth: Int) -> String:
    var out = ""
    var i = 0
    while i < depth:
        out = out + "  "
        i = i + 1
    out

fn encode_array(items: List(Json)) -> String:
    var out = "["
    var first = true
    for it in items:
        if first:
            first = false
        else:
            out = out + ","
        out = out + encode(it)
    out + "]"

fn encode_object(pairs: List((String, Json))) -> String:
    var out = "{"
    var first = true
    for p in pairs:
        let (k, v) = p
        if first:
            first = false
        else:
            out = out + ","
        out = out + encode_string(k) + ":" + encode(v)
    out + "}"

// Wrap `s` in quotes, escaping the characters JSON requires.
fn encode_string(s: String) -> String:
    var out = "\""
    for c in string.chars(s):
        out = out + escape_char(c)
    out + "\""

fn escape_char(c: String) -> String:
    if c == "\"":
        "\\\""
    else if c == "\\":
        "\\\\"
    else if c == "\n":
        "\\n"
    else if c == "\t":
        "\\t"
    else if c == "\r":
        "\\r"
    else:
        c

// --- Decoder (parsing) ---------------------------------------------------
//
// A recursive-descent parser. Helpers return `(value, index just past it)` on
// success and thread errors with `?`. Numbers are integers only (JSON floats
// would need a Float-in-collections representation and float-to-string the WASM
// backend still lacks); fractional/exponent numbers decode to `JsonFloat` (see
// error rather than mis-parsed.

// Parse a complete JSON document, or return an error message. The whole input
// must be a single value: trailing content after it (other than whitespace) is
// rejected, so `decode("1 2")` is an Err rather than silently yielding `1`.
pub fn decode(s: String) -> Result(Json, String):
    let r = parse_value(s, skip_ws(s, 0))?
    let (v, rest) = r
    let end = skip_ws(s, rest)
    if end < string.char_count(s):
        Err("unexpected trailing content at " + "${end}")
    else:
        Ok(v)

// The index of the first non-whitespace char at or after `i`.
fn skip_ws(s: String, i: Int) -> Int:
    var j = i
    let n = string.char_count(s)
    while j < n:
        let c = string.substring(s, j, j + 1)
        if c == " " || c == "\n" || c == "\t" || c == "\r":
            j = j + 1
        else:
            return j
    j

// Parse the value at `i` (whitespace already skipped).
fn parse_value(s: String, i: Int) -> Result((Json, Int), String):
    if i >= string.char_count(s):
        Err("unexpected end of input")
    else:
        let c = string.substring(s, i, i + 1)
        if c == "{":
            parse_object(s, i)
        else if c == "[":
            parse_array(s, i)
        else if c == "\"":
            parse_string(s, i)
        else if c == "t":
            parse_lit(s, i, "true", JsonBool(true))
        else if c == "f":
            parse_lit(s, i, "false", JsonBool(false))
        else if c == "n":
            parse_lit(s, i, "null", JsonNull)
        else:
            parse_number(s, i)

fn parse_lit(s: String, i: Int, word: String, value: Json) -> Result((Json, Int), String):
    let n = string.char_count(word)
    if i + n <= string.char_count(s) && string.substring(s, i, i + n) == word:
        Ok((value, i + n))
    else:
        Err("invalid literal at " + "${i}")

fn is_digit(c: String) -> Bool:
    c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"

fn parse_number(s: String, i: Int) -> Result((Json, Int), String):
    let n = string.char_count(s)
    var j = i
    if j < n && string.substring(s, j, j + 1) == "-":
        j = j + 1
    var digits = 0
    while j < n && is_digit(string.substring(s, j, j + 1)):
        j = j + 1
        digits = digits + 1
    if digits == 0:
        Err("invalid number at " + "${i}")
    else if j < n && is_float_tail(string.substring(s, j, j + 1)):
        parse_float_tail(s, i, j)
    else:
        Ok((JsonInt(string.to_int(string.substring(s, i, j))), j))

// A `.`/`e`/`E` after the integer digits: parse the fraction and exponent and
// build a JsonFloat. (Assembled from parts with float arithmetic — fine for
// data interchange; extreme magnitudes may round in the last places.)
fn parse_float_tail(s: String, start: Int, ip_end: Int) -> Result((Json, Int), String):
    let n = string.char_count(s)
    var j = ip_end
    var frac = 0
    var frac_digits = 0
    if j < n && string.substring(s, j, j + 1) == ".":
        j = j + 1
        while j < n && is_digit(string.substring(s, j, j + 1)):
            frac = frac * 10 + string.to_int(string.substring(s, j, j + 1))
            frac_digits = frac_digits + 1
            j = j + 1
        if frac_digits == 0:
            return Err("invalid number at " + "${start}")
    var exp = 0
    var exp_neg = false
    if j < n && (string.substring(s, j, j + 1) == "e" || string.substring(s, j, j + 1) == "E"):
        j = j + 1
        if j < n && string.substring(s, j, j + 1) == "+":
            j = j + 1
        else if j < n && string.substring(s, j, j + 1) == "-":
            exp_neg = true
            j = j + 1
        var exp_digits = 0
        while j < n && is_digit(string.substring(s, j, j + 1)):
            exp = exp * 10 + string.to_int(string.substring(s, j, j + 1))
            exp_digits = exp_digits + 1
            j = j + 1
        if exp_digits == 0:
            return Err("invalid number at " + "${start}")
    let ip = string.to_int(string.substring(s, start, ip_end))
    let negative = string.substring(s, start, start + 1) == "-"
    var x = math.to_float(ip)
    var fpart = math.to_float(frac) / pow10(frac_digits)
    if negative:
        fpart = 0.0 - fpart
    x = x + fpart
    if exp_neg:
        x = x / pow10(exp)
    else:
        x = x * pow10(exp)
    Ok((JsonFloat(x), j))

fn pow10(k: Int) -> Float:
    var out = 1.0
    var i = 0
    while i < k:
        out = out * 10.0
        i = i + 1
    out

fn is_float_tail(c: String) -> Bool:
    c == "." || c == "e" || c == "E"

fn parse_string(s: String, i: Int) -> Result((Json, Int), String):
    let r = scan_string(s, i + 1)?
    let (text, j) = r
    Ok((JsonString(text), j))

// Scan string contents from `start` (just past the opening quote) to the
// closing quote, returning the unescaped text and the index past the quote.
fn scan_string(s: String, start: Int) -> Result((String, Int), String):
    var acc = ""
    var j = start
    let n = string.char_count(s)
    while j < n:
        let c = string.substring(s, j, j + 1)
        if c == "\"":
            return Ok((acc, j + 1))
        else if c == "\\":
            if j + 1 >= n:
                return Err("unterminated escape")
            else if string.substring(s, j + 1, j + 2) == "u":
                let r = scan_unicode(s, j, n)?
                let (decoded, k) = r
                acc = acc + decoded
                j = k
            else:
                acc = acc + unescape(string.substring(s, j + 1, j + 2))
                j = j + 2
        else:
            acc = acc + c
            j = j + 1
    Err("unterminated string")

fn unescape(e: String) -> String:
    if e == "n":
        "\n"
    else if e == "t":
        "\t"
    else if e == "r":
        "\r"
    else if e == "/":
        "/"
    else:
        e

// One hex digit (0-9, a-f, A-F) to its 0..15 value, or -1 if not a hex digit.
fn hex_val(c: String) -> Int:
    string.index_of("0123456789abcdef", string.to_lower(c))

// The 16-bit value of the four hex digits at `j`, or -1 if any is not hex.
fn hex4(s: String, j: Int) -> Int:
    let a = hex_val(string.substring(s, j, j + 1))
    let b = hex_val(string.substring(s, j + 1, j + 2))
    let c = hex_val(string.substring(s, j + 2, j + 3))
    let d = hex_val(string.substring(s, j + 3, j + 4))
    if a < 0 || b < 0 || c < 0 || d < 0:
        -1
    else:
        a * 4096 + b * 256 + c * 16 + d

// Decode a `\uXXXX` escape (with `j` at the backslash). A high surrogate
// (U+D800..U+DBFF) is combined with the following `\uXXXX` low surrogate into a
// single astral code point — how JSON encodes characters beyond the BMP.
// Returns the decoded character and the index just past the escape.
fn scan_unicode(s: String, j: Int, n: Int) -> Result((String, Int), String):
    if j + 6 > n:
        return Err("incomplete \\u escape")
    let cp = hex4(s, j + 2)
    if cp < 0:
        return Err("invalid \\u escape")
    if cp >= 55296 && cp <= 56319:
        if j + 12 > n || string.substring(s, j + 6, j + 8) != "\\u":
            return Err("unpaired high surrogate")
        let lo = hex4(s, j + 8)
        if lo < 56320 || lo > 57343:
            return Err("invalid low surrogate")
        Ok((string.from_code(65536 + (cp - 55296) * 1024 + (lo - 56320)), j + 12))
    else if cp >= 56320 && cp <= 57343:
        Err("unexpected low surrogate")
    else:
        Ok((string.from_code(cp), j + 6))

fn parse_array(s: String, i: Int) -> Result((Json, Int), String):
    let n = string.char_count(s)
    var items = []
    var j = skip_ws(s, i + 1)
    if j < n && string.substring(s, j, j + 1) == "]":
        return Ok((JsonArray(items), j + 1))
    while true:
        let r = parse_value(s, skip_ws(s, j))?
        let (v, k) = r
        items = list.push(items, v)
        let m = skip_ws(s, k)
        if m >= n:
            return Err("unterminated array")
        let c = string.substring(s, m, m + 1)
        if c == "]":
            return Ok((JsonArray(items), m + 1))
        else if c == ",":
            j = m + 1
        else:
            return Err("expected , or ] in array")
    Err("unreachable")

fn parse_object(s: String, i: Int) -> Result((Json, Int), String):
    let n = string.char_count(s)
    var pairs = []
    var j = skip_ws(s, i + 1)
    if j < n && string.substring(s, j, j + 1) == "}":
        return Ok((JsonObject(pairs), j + 1))
    while true:
        let ws = skip_ws(s, j)
        if ws >= n || string.substring(s, ws, ws + 1) != "\"":
            return Err("expected string key in object")
        let kr = scan_string(s, ws + 1)?
        let (key, k1) = kr
        let colon = skip_ws(s, k1)
        if colon >= n || string.substring(s, colon, colon + 1) != ":":
            return Err("expected : in object")
        let vr = parse_value(s, skip_ws(s, colon + 1))?
        let (v, k2) = vr
        pairs = list.push(pairs, (key, v))
        let m = skip_ws(s, k2)
        if m >= n:
            return Err("unterminated object")
        let c = string.substring(s, m, m + 1)
        if c == "}":
            return Ok((JsonObject(pairs), m + 1))
        else if c == ",":
            j = m + 1
        else:
            return Err("expected , or } in object")
    Err("unreachable")

// --- Accessors -----------------------------------------------------------
//
// Read data out of a decoded value. Each returns an Option, so a wrong shape is
// `None` rather than a trap.

// Look up a key in a JSON object.
pub fn get(j: Json, key: String) -> Option(Json):
    match j:
        JsonObject(pairs) -> find_key(pairs, key)
        _ -> None

fn find_key(pairs: List((String, Json)), key: String) -> Option(Json):
    for p in pairs:
        let (k, v) = p
        if k == key:
            return Some(v)
    None

// Whether a JSON object has `key` (false for non-objects).
pub fn has_key(j: Json, key: String) -> Bool:
    match j:
        JsonObject(pairs) -> pairs_has_key(pairs, key)
        _ -> false

fn pairs_has_key(pairs: List((String, Json)), key: String) -> Bool:
    for p in pairs:
        let (k, _v) = p
        if k == key:
            return true
    false

// A shallow merge of two JSON objects: every key of `b` overrides the same key
// in `a`, and `a`'s other keys are kept. If either value is not an object, `b`
// wins (so it works as "patch `a` with `b`"). Override is top-level only —
// nested objects are replaced, not deep-merged.
pub fn merge(a: Json, b: Json) -> Json:
    match a:
        JsonObject(pa) ->
            match b:
                JsonObject(pb) -> JsonObject(merge_pairs(pa, pb))
                _ -> b
        _ -> b

fn merge_pairs(pa: List((String, Json)), pb: List((String, Json))) -> List((String, Json)):
    var out = []
    for p in pa:
        let (k, _v) = p
        if !pairs_has_key(pb, k):
            out = list.push(out, p)
    for q in pb:
        out = list.push(out, q)
    out

// The element at index `i` of a JSON array.
pub fn index(j: Json, i: Int) -> Option(Json):
    match j:
        JsonArray(items) -> if i >= 0 && i < list.length(items): Some(list.at(items, i)) else: None
        _ -> None

// `j` as an integer, when it is one.
pub fn as_int(j: Json) -> Option(Int):
    match j:
        JsonInt(n) -> Some(n)
        _ -> None

// `j` as a string, when it is one.
pub fn as_string(j: Json) -> Option(String):
    match j:
        JsonString(s) -> Some(s)
        _ -> None

// `j` as a bool, when it is one.
pub fn as_bool(j: Json) -> Option(Bool):
    match j:
        JsonBool(b) -> Some(b)
        _ -> None

// `j` as a list of elements, when it is an array.
pub fn as_array(j: Json) -> Option(List(Json)):
    match j:
        JsonArray(items) -> Some(items)
        _ -> None

// `j` as its key/value pairs, when it is an object — for iterating an object
// whose keys aren't known ahead of time.
pub fn as_object(j: Json) -> Option(List((String, Json))):
    match j:
        JsonObject(pairs) -> Some(pairs)
        _ -> None

// --- typed field accessors (get a key, then coerce) --------------------------
// `get` composed with each `as_*` — the common case of reading a typed field out
// of an object without spelling the two steps every time.
pub fn get_string(j: Json, key: String) -> Option(String):
    match get(j, key):
        Some(v) -> as_string(v)
        None -> None

pub fn get_int(j: Json, key: String) -> Option(Int):
    match get(j, key):
        Some(v) -> as_int(v)
        None -> None

pub fn get_bool(j: Json, key: String) -> Option(Bool):
    match get(j, key):
        Some(v) -> as_bool(v)
        None -> None

// The string array at `key` as a `List(String)`, dropping any non-string element;
// `[]` when the key is absent or not an array. Collapses the very common
// "decode an object's array-of-strings field" pattern into one call.
pub fn get_strings(j: Json, key: String) -> List(String):
    match get(j, key):
        Some(arr) -> strings(arr)
        None -> []

// A JSON array value as a `List(String)` (non-strings dropped).
pub fn strings(j: Json) -> List(String):
    var out = []
    if let Some(items) = as_array(j):
        for it in items:
            if let Some(s) = as_string(it):
                out = list.push(out, s)
    out

// The string at index `i` of a JSON array, when it is a string.
pub fn index_string(j: Json, i: Int) -> Option(String):
    match index(j, i):
        Some(v) -> as_string(v)
        None -> None

// Follow a dotted path of object keys, e.g. `get_path(resp, "user.name")`. Any
// missing key (or a non-object along the way) yields `None`.
pub fn get_path(j: Json, path: String) -> Option(Json):
    var cur = Some(j)
    for seg in string.split(path, "."):
        cur = step(cur, seg)
    cur

fn step(cur: Option(Json), seg: String) -> Option(Json):
    match cur:
        Some(j) -> get(j, seg)
        None -> None
