// toml — a TOML reader written in pure witchy (no native code). Two ways in:
// `toml.decode(text)` parses a whole document into a structured `Toml` tree (the
// `json.decode` shape); or look individual values up by a `section.key` path with
// `toml.get`/`get_array`/`table`/... It supports top-level and `[section]` (and
// dotted `[a.b]`) tables, `key = value` for string/int/bool values, and
// `["a", "b"]` arrays. Comments (`#`) — whole-line and trailing — and blank lines
// are ignored. (Floats/dates decode as `TomlString`: witchy has no string->float
// primitive yet.)

import string

// A decoded TOML value (`toml.decode`), the structured counterpart of the
// string-query API below. A document decodes to a `TomlTable`. Floats, dates, and
// other values witchy can't type are kept as `TomlString` (witchy has no
// string->float primitive yet), so a round-trip never loses data.
type Toml:
    TomlString(String)
    TomlInt(Int)
    TomlBool(Bool)
    TomlArray(List(Toml))
    TomlTable(List((String, Toml)))

// Parse a whole TOML document into a `Toml` tree (always a `TomlTable`).
// Supports top-level keys, `[section]` and dotted `[a.b]` tables, `#` comments,
// and `string`/`int`/`bool`/array values. Always succeeds — malformed lines are
// skipped — so the result is `Ok`; the `Result` shape mirrors `json.decode`.
pub fn decode(text: String) -> Result(Toml, String):
    var root = TomlTable([])
    var section = []
    for line in string.lines(text):
        let t = string.trim(line)
        if is_header(t):
            section = header_path(header_name(t))
        else if !(string.is_empty(t) || string.starts_with(t, "#")):
            root = match key_value(t):
                Some((k, v)) -> insert_kv(root, section, k, parse_value(v))
                None -> root
    Ok(root)

// "a.b.c" -> ["a", "b", "c"]; "" -> [].
fn header_path(name: String) -> List(String):
    var out = []
    for seg in string.split(name, "."):
        let s = string.trim(seg)
        if !string.is_empty(s):
            out = list.push(out, unquote_key(s))
    out

// Type a raw value string into a Toml leaf.
fn parse_value(raw: String) -> Toml:
    let v = string.trim(raw)
    if string.starts_with(v, "\""):
        TomlString(unquote(v))
    else if string.starts_with(v, "["):
        var elems = []
        for e in parse_array(v):
            elems = list.push(elems, parse_value(e))
        TomlArray(elems)
    else:
        let bare = unquote(v)
        if bare == "true":
            TomlBool(true)
        else if bare == "false":
            TomlBool(false)
        else:
            match string.parse_int(bare):
                Some(n) -> TomlInt(n)
                None -> TomlString(bare)

// Insert (key -> value) into `node` at the table reached by `path`, creating
// intermediate tables as needed.
fn insert_kv(node: Toml, path: List(String), key: String, value: Toml) -> Toml:
    match node:
        TomlTable(pairs) ->
            if list.length(path) == 0:
                TomlTable(upsert(pairs, key, value))
            else:
                let head = list.at(path, 0)
                let sub = subtable(pairs, head)
                TomlTable(upsert(pairs, head, insert_kv(sub, drop_first(path), key, value)))
        _ -> node

// Replace `key`'s pair if present, else append it.
fn upsert(pairs: List((String, Toml)), key: String, value: Toml) -> List((String, Toml)):
    var out = []
    var found = false
    for p in pairs:
        let (k, _v) = p
        if k == key:
            out = list.push(out, (key, value))
            found = true
        else:
            out = list.push(out, p)
    if found:
        out
    else:
        list.push(out, (key, value))

// The existing sub-table at `head`, or a fresh empty one.
fn subtable(pairs: List((String, Toml)), head: String) -> Toml:
    var result = TomlTable([])
    for p in pairs:
        let (k, v) = p
        if k == head:
            match v:
                TomlTable(_inner) -> result = v
                _ -> result = TomlTable([])
    result

fn drop_first(xs: List(String)) -> List(String):
    var out = []
    var i = 0
    for x in xs:
        if i > 0:
            out = list.push(out, x)
        i = i + 1
    out

// The string value of `path` (e.g. "rune.name"), or None if absent. Surrounding
// double quotes are stripped.
pub fn get(text: String, path: String) -> Option(String):
    match lookup(text, path):
        Some(raw) -> Some(unquote(raw))
        None -> None

// The string-array value of `path` (e.g. "capabilities.runtime"), or [] if
// absent. Each element is unquoted.
pub fn get_array(text: String, path: String) -> List(String):
    match lookup(text, path):
        Some(raw) -> parse_array(raw)
        None -> []

// Every `key = value` pair defined directly under `[section]`, in file order.
// Keys are unquoted (`"acme/money"` -> `acme/money`); values are raw (trimmed,
// still quoted/inline) — feed an inline-table value to `inline_get`. Use this to
// enumerate a table whose keys you don't know ahead of time, like `[dependencies]`.
pub fn table(text: String, section: String) -> List((String, String)):
    var in_section = section == ""
    var out = []
    for line in string.lines(text):
        let t = string.trim(line)
        if is_header(t):
            in_section = header_name(t) == section
        else if in_section:
            if let Some(pair) = key_value(t):
                out = list.push(out, pair)
    out

// Each `[[name]]` array-of-tables entry as its own block of body text — the lines
// after one `[[name]]` header up to the next header. Feed a block to `get` /
// `get_array` to read its fields. Use this to walk a `witchy.lock`'s `[[rune]]`
// entries, which `table`/`get` (single-table) cannot enumerate.
pub fn array_tables(text: String, name: String) -> List(String):
    let marker = "[[" + name + "]]"
    var blocks = []
    var current = ""
    var collecting = false
    for line in string.lines(text):
        let t = string.trim(line)
        if t == marker:
            if collecting:
                blocks = list.push(blocks, current)
            current = ""
            collecting = true
        else if is_header(t):
            if collecting:
                blocks = list.push(blocks, current)
            current = ""
            collecting = false
        else if collecting:
            current = current + line + "\n"
    if collecting:
        blocks = list.push(blocks, current)
    blocks

// Just the keys of `[section]` (unquoted), in file order.
pub fn keys(text: String, section: String) -> List(String):
    var out = []
    for pair in table(text, section):
        let (k, _v) = pair
        out = list.push(out, k)
    out

// Read `key` from an inline table value like `{ path = "../money", version = "1" }`.
// Returns the unquoted value, or None if the key is absent.
pub fn inline_get(inline: String, key: String) -> Option(String):
    let body = string.strip_suffix(string.strip_prefix(string.trim(inline), "{"), "}")
    var found = None
    for part in string.split(body, ","):
        if let Some((k, v)) = key_value(string.trim(part)):
            if k == key:
                found = Some(unquote(v))
    found

// If `line` is `key = value` (and not a comment), return (unquoted key, raw value).
fn key_value(line: String) -> Option((String, String)):
    if string.starts_with(line, "#") || !string.contains(line, "="):
        None
    else:
        let (k, v) = string.split_once(line, "=")
        Some((unquote_key(string.trim(k)), string.trim(v)))

// A bare key is itself; a quoted key has its surrounding quotes stripped (so a
// scoped name like `"acme/money"` reads back as `acme/money`).
fn unquote_key(k: String) -> String:
    if string.starts_with(k, "\"") && string.ends_with(k, "\""):
        string.strip_suffix(string.strip_prefix(k, "\""), "\"")
    else:
        k

// The raw (trimmed, still-quoted) value for `path`, scanning section by section.
fn lookup(text: String, path: String) -> Option(String):
    let (section, key) = split_path(path)
    var in_section = section == ""
    var result = None
    for line in string.lines(text):
        let t = string.trim(line)
        if is_header(t):
            in_section = header_name(t) == section
        else if in_section:
            if let Some(v) = match_key(t, key):
                result = Some(v)
    result

// "rune.name" -> ("rune", "name"); a bare "name" -> ("", "name").
fn split_path(path: String) -> (String, String):
    if string.contains(path, "."):
        string.rsplit_once(path, ".")
    else:
        ("", path)

fn is_header(line: String) -> Bool:
    string.starts_with(line, "[") && string.ends_with(line, "]")

fn header_name(line: String) -> String:
    string.strip_suffix(string.strip_prefix(line, "["), "]")

// If `line` is `key = value`, return the trimmed raw value (still quoted).
fn match_key(line: String, key: String) -> Option(String):
    if string.contains(line, "="):
        let (k, v) = string.split_once(line, "=")
        if string.trim(k) == key:
            Some(string.trim(v))
        else:
            None
    else:
        None

// The value of `s`, with surrounding double quotes removed and any trailing
// `# comment` dropped. For a quoted value we take the text up to the closing
// quote, so a `#` *inside* the string is preserved; for a bare value we cut at
// the first `#`.
fn unquote(s: String) -> String:
    if string.starts_with(s, "\""):
        let (inner, _rest) = string.split_once(string.strip_prefix(s, "\""), "\"")
        inner
    else:
        let (bare, _comment) = string.split_once(s, "#")
        string.trim(bare)

// Parse `["a", "b"]` into ["a", "b"] (unquoted, blanks dropped). Splits at the
// last `]` so a trailing comment is dropped while `]` inside an element (e.g.
// "Dir[Read]") is kept.
fn parse_array(raw: String) -> List(String):
    let (body, _comment) = string.rsplit_once(string.trim(raw), "]")
    let inner = string.strip_prefix(body, "[")
    var out = []
    for part in string.split(inner, ","):
        let t = string.trim(part)
        if !string.is_empty(t):
            out = list.push(out, unquote(t))
    out
