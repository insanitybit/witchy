// The witchy standard comparison hierarchy, mirroring Rust's `std::cmp`:
// `PartialEq` → `Eq` → `PartialOrd` → `Ord`. The comparison operators desugar
// through these traits, so `a == b` and `x < y` work on your own types once you
// implement (or derive) them - there is no separate `compare`/`greater` to call
// by name. Built-in impls cover the primitives; `Self` in a method signature
// stands for the implementing type. Built-in comparisons are data-only. A custom
// trait impl is an ordinary callable contract and may invoke delegated behavior.

import bytes
import option
import string

// The result of a comparison: `a` is `Less` than, `Equal` to, or `Greater` than
// `b`. The return of `Ord.compare`, and (wrapped in `Some`) `PartialOrd`.
type Ordering:
    Less
    Equal
    Greater

// `==` and `!=`. The minimal equality trait: implement `eq` and `ne` comes free.
// `Float` is `PartialEq` but NOT `Eq` - `NaN != NaN`, so equality is not
// reflexive.
trait PartialEq:
    fn eq(let self, let other: Self) -> Bool
    fn ne(let self, let other: Self) -> Bool:
        !eq(self, other)

// Total equality: a marker refining `PartialEq` with reflexivity (no `NaN`).
// Total equality is required by Hash and by ordered collections.
trait Eq: PartialEq

// Stable content hash for dictionary keys. Equal values must have equal hashes.
// Implementations must depend only on the immutable value and must not use
// capabilities, mutable state, or a process-specific seed. Collisions are fine:
// Eq remains the final authority on a dictionary hit.
trait Hash: Eq:
    fn hash(let self) -> Int

fn hash_bytes(data: Bytes) -> Int:
    var h = -3750763034362895579
    for i in 0..bytes.length(data):
        h = (h ^ bytes.at(data, i)) * 1099511628211
    h

fn hash_combine(h: Int, part: Int) -> Int:
    h * 1099511628211 ^ part

// `<` `>` `<=` `>=`. `partial_compare` returns `None` for incomparable values
// (a `NaN`); the four ordering operators are then all false, as in Rust.
// Implement `partial_compare`; the rest come free.
trait PartialOrd: PartialEq:
    fn partial_compare(self, other: Self) -> Option(Ordering)
    fn less(self, other: Self) -> Bool:
        match partial_compare(self, other):
            Some(Less) -> true
            _ -> false
    fn greater(self, other: Self) -> Bool:
        match partial_compare(self, other):
            Some(Greater) -> true
            _ -> false
    fn less_equal(self, other: Self) -> Bool:
        match partial_compare(self, other):
            Some(Less) -> true
            Some(Equal) -> true
            _ -> false
    fn greater_equal(self, other: Self) -> Bool:
        match partial_compare(self, other):
            Some(Greater) -> true
            Some(Equal) -> true
            _ -> false

// A total order: `compare` never reports "incomparable". Sorting and the `min`/
// `max` helpers require `Ord`. Implement `compare`; the companion `PartialOrd`
// impl's `partial_compare` is `Some` of it.
trait Ord: Eq + PartialOrd:
    fn compare(self, other: Self) -> Ordering

// A query's hash must equal the stored key's Hash result whenever equivalent is true.
// The query is borrowed so a lookup can inspect a view without owning a key.
trait Equivalent(k):
    fn equivalent(self: &Self, key: &k) -> Bool
    fn equivalent_hash(self: &Self) -> Int

// Flip an ordering - `Less` <-> `Greater`, `Equal` unchanged - for reverse sorts.
pub fn reverse(o: Ordering) -> Ordering:
    match o:
        Less -> Greater
        Greater -> Less
        Equal -> Equal

// --- primitive impls ---------------------------------------------------------
impl PartialEq for Ordering:
    fn eq(let self, let other: Self) -> Bool:
        match self:
            Less ->
                match other:
                    Less -> true
                    _ -> false
            Equal ->
                match other:
                    Equal -> true
                    _ -> false
            Greater ->
                match other:
                    Greater -> true
                    _ -> false

    fn ne(let self, let other: Self) -> Bool:
        !eq(self, other)

impl Eq for Ordering

impl Hash for Ordering:
    fn hash(let self) -> Int:
        match self:
            Less -> 0
            Equal -> 1
            Greater -> 2

impl PartialEq for Int:
    fn eq(let self, let other: Self) -> Bool:
        self == other

impl Eq for Int

impl Hash for Int:
    fn hash(let self) -> Int:
        self * -7046029254386353131 >> 32 & 4294967295

impl PartialOrd for Int:
    fn partial_compare(self, other: Self) -> Option(Ordering):
        Some(compare(self, other))

impl Ord for Int:
    fn compare(self, other: Self) -> Ordering:
        if self < other:
            Less
        else if self > other:
            Greater
        else:
            Equal

impl PartialEq for Bool:
    fn eq(let self, let other: Self) -> Bool:
        self == other

impl Eq for Bool

impl Hash for Bool:
    fn hash(let self) -> Int:
        if self:
            1
        else:
            0

// Lexicographic ordering by code point - the same order `<` gives on strings, and
// content-correct in compiled code (both backends compare bytes, not pointers).
impl PartialEq for String:
    fn eq(let self, let other: Self) -> Bool:
        self == other

impl Eq for String

impl Hash for String:
    fn hash(let self) -> Int:
        hash_bytes(bytes.from_string(self))

impl PartialOrd for String:
    fn partial_compare(self, other: Self) -> Option(Ordering):
        Some(compare(self, other))

impl Ord for String:
    fn compare(self, other: Self) -> Ordering:
        if self < other:
            Less
        else if self > other:
            Greater
        else:
            Equal

// Byte buffers compare by byte contents, matching direct `==` and String's
// content equality. `Bytes` deliberately has equality but no ordering protocol.
impl PartialEq for Bytes:
    fn eq(let self, let other: Self) -> Bool:
        let n = bytes.length(self)
        if n != bytes.length(other):
            return false
        var i = 0
        while i < n:
            if bytes.at(self, i) != bytes.at(other, i):
                return false
            i = i + 1
        true

    fn ne(let self, let other: Self) -> Bool:
        !eq(self, other)

impl Eq for Bytes

impl Hash for Bytes:
    fn hash(let self) -> Int:
        hash_bytes(self)

impl PartialEq for Duration:
    fn eq(let self, let other: Self) -> Bool:
        self == other

impl Eq for Duration

impl Hash for Duration:
    fn hash(let self) -> Int:
        duration_to_int(self) * -7046029254386353131 >> 32 & 4294967295

impl PartialOrd for Duration:
    fn partial_compare(self, other: Self) -> Option(Ordering):
        Some(compare(self, other))

impl Ord for Duration:
    fn compare(self, other: Self) -> Ordering:
        if self < other:
            Less
        else if self > other:
            Greater
        else:
            Equal

// `Float` is `PartialEq` + `PartialOrd` only: a `NaN` is unequal to everything
// (including itself) and unordered, so `Float` is neither `Eq` nor `Ord`. Sort a
// `List(Float)` with a total wrapper or by comparing a derived key.
impl PartialEq for Float:
    fn eq(let self, let other: Self) -> Bool:
        self == other

impl PartialOrd for Float:
    fn partial_compare(self, other: Self) -> Option(Ordering):
        // A `NaN` is unordered: detect it FIRST (a `NaN` is the only value not
        // equal to itself), because the `<` / `>` operators trap on a `NaN`
        // operand rather than returning false. With both sides known non-`NaN`,
        // the ordering compares safely.
        if !(self == self) || !(other == other):
            None
        else if self < other:
            Some(Less)
        else if self > other:
            Some(Greater)
        else:
            Some(Equal)

// --- structural container impls ---------------------------------------------

// Lists compare element-by-element through the element type's `PartialEq` impl.
impl PartialEq for List(a) where a: PartialEq:
    fn eq(let self, let other: Self) -> Bool:
        let n = list.length(self)
        if n != list.length(other):
            return false
        var i = 0
        while i < n:
            if !(self[i] == other[i]):
                return false
            i = i + 1
        true

impl Eq for List(a) where a: Eq

impl Hash for List(a) where a: Hash:
    fn hash(let self) -> Int:
        var h = 17
        for item in self:
            h = hash_combine(h, item.hash())
        hash_combine(h, self.length())

impl PartialEq for Option(a) where a: PartialEq:
    fn eq(let self, let other: Self) -> Bool:
        match self:
            Some(left) ->
                match other:
                    Some(right) -> left == right
                    None -> false
            None ->
                match other:
                    Some(_) -> false
                    None -> true

impl Eq for Option(a) where a: Eq

impl Hash for Option(a) where a: Hash:
    fn hash(let self) -> Int:
        match self:
            None -> 0
            Some(value) -> hash_combine(1, value.hash())

impl PartialEq for Result(a, e) where a: PartialEq, e: PartialEq:
    fn eq(let self, let other: Self) -> Bool:
        match self:
            Ok(left) ->
                match other:
                    Ok(right) -> left == right
                    Err(_) -> false
            Err(left) ->
                match other:
                    Ok(_) -> false
                    Err(right) -> left == right

impl Eq for Result(a, e) where a: Eq, e: Eq

impl Hash for Result(a, e) where a: Hash, e: Hash:
    fn hash(let self) -> Int:
        match self:
            Ok(value) -> hash_combine(0, value.hash())
            Err(error) -> hash_combine(1, error.hash())

impl PartialEq for Dict(k, v) where k: Hash, v: PartialEq:
    fn eq(let self, let other: Self) -> Bool:
        if dict.length(self) != dict.length(other):
            return false
        for left_entry in dict.pairs(self):
            let (left_key, left_value) = left_entry
            var found = false
            for right_entry in dict.pairs(other):
                let (right_key, right_value) = right_entry
                if left_key == right_key:
                    found = true
                    if !(left_value == right_value):
                        return false
            if !found:
                return false
        true

impl Eq for Dict(k, v) where k: Hash, v: Eq

// Tuples compare slot-by-slot through each slot's equality protocol. The tuple
// protocol surface is explicit through arity 8, matching `Show` and `Reflect`.
impl PartialEq for (a, b) where a: PartialEq, b: PartialEq:
    fn eq(let self, let other: Self) -> Bool:
        let (x0, x1) = self
        let (y0, y1) = other
        x0 == y0 && x1 == y1

    fn ne(let self, let other: Self) -> Bool:
        !eq(self, other)

impl Eq for (a, b) where a: Eq, b: Eq

impl Hash for (a, b) where a: Hash, b: Hash:
    fn hash(let self) -> Int:
        let (x0, x1) = self
        var h = 2
        h = hash_combine(h, x0.hash())
        h = hash_combine(h, x1.hash())
        h

impl PartialEq for (a, b, c) where a: PartialEq, b: PartialEq, c: PartialEq:
    fn eq(let self, let other: Self) -> Bool:
        let (x0, x1, x2) = self
        let (y0, y1, y2) = other
        x0 == y0 && x1 == y1 && x2 == y2

    fn ne(let self, let other: Self) -> Bool:
        !eq(self, other)

impl Eq for (a, b, c) where a: Eq, b: Eq, c: Eq

impl Hash for (a, b, c) where a: Hash, b: Hash, c: Hash:
    fn hash(let self) -> Int:
        let (x0, x1, x2) = self
        var h = 3
        h = hash_combine(h, x0.hash())
        h = hash_combine(h, x1.hash())
        h = hash_combine(h, x2.hash())
        h

impl PartialEq for (a, b, c, d) where a: PartialEq, b: PartialEq, c: PartialEq, d: PartialEq:
    fn eq(let self, let other: Self) -> Bool:
        let (x0, x1, x2, x3) = self
        let (y0, y1, y2, y3) = other
        x0 == y0 && x1 == y1 && x2 == y2 && x3 == y3

    fn ne(let self, let other: Self) -> Bool:
        !eq(self, other)

impl Eq for (a, b, c, d) where a: Eq, b: Eq, c: Eq, d: Eq

impl Hash for (a, b, c, d) where a: Hash, b: Hash, c: Hash, d: Hash:
    fn hash(let self) -> Int:
        let (x0, x1, x2, x3) = self
        var h = 4
        h = hash_combine(h, x0.hash())
        h = hash_combine(h, x1.hash())
        h = hash_combine(h, x2.hash())
        h = hash_combine(h, x3.hash())
        h

impl PartialEq for (a, b, c, d, e) where a: PartialEq, b: PartialEq, c: PartialEq, d: PartialEq, e: PartialEq:
    fn eq(let self, let other: Self) -> Bool:
        let (x0, x1, x2, x3, x4) = self
        let (y0, y1, y2, y3, y4) = other
        x0 == y0 && x1 == y1 && x2 == y2 && x3 == y3 && x4 == y4

    fn ne(let self, let other: Self) -> Bool:
        !eq(self, other)

impl Eq for (a, b, c, d, e) where a: Eq, b: Eq, c: Eq, d: Eq, e: Eq

impl Hash for (a, b, c, d, e) where a: Hash, b: Hash, c: Hash, d: Hash, e: Hash:
    fn hash(let self) -> Int:
        let (x0, x1, x2, x3, x4) = self
        var h = 5
        h = hash_combine(h, x0.hash())
        h = hash_combine(h, x1.hash())
        h = hash_combine(h, x2.hash())
        h = hash_combine(h, x3.hash())
        h = hash_combine(h, x4.hash())
        h

impl PartialEq for (a, b, c, d, e, f) where a: PartialEq, b: PartialEq, c: PartialEq, d: PartialEq, e: PartialEq, f: PartialEq:
    fn eq(let self, let other: Self) -> Bool:
        let (x0, x1, x2, x3, x4, x5) = self
        let (y0, y1, y2, y3, y4, y5) = other
        x0 == y0 && x1 == y1 && x2 == y2 && x3 == y3 && x4 == y4 && x5 == y5

    fn ne(let self, let other: Self) -> Bool:
        !eq(self, other)

impl Eq for (a, b, c, d, e, f) where a: Eq, b: Eq, c: Eq, d: Eq, e: Eq, f: Eq

impl Hash for (a, b, c, d, e, f) where a: Hash, b: Hash, c: Hash, d: Hash, e: Hash, f: Hash:
    fn hash(let self) -> Int:
        let (x0, x1, x2, x3, x4, x5) = self
        var h = 6
        h = hash_combine(h, x0.hash())
        h = hash_combine(h, x1.hash())
        h = hash_combine(h, x2.hash())
        h = hash_combine(h, x3.hash())
        h = hash_combine(h, x4.hash())
        h = hash_combine(h, x5.hash())
        h

impl PartialEq for (a, b, c, d, e, f, g) where a: PartialEq, b: PartialEq, c: PartialEq, d: PartialEq, e: PartialEq, f: PartialEq, g: PartialEq:
    fn eq(let self, let other: Self) -> Bool:
        let (x0, x1, x2, x3, x4, x5, x6) = self
        let (y0, y1, y2, y3, y4, y5, y6) = other
        x0 == y0 && x1 == y1 && x2 == y2 && x3 == y3 && x4 == y4 && x5 == y5 && x6 == y6

    fn ne(let self, let other: Self) -> Bool:
        !eq(self, other)

impl Eq for (a, b, c, d, e, f, g) where a: Eq, b: Eq, c: Eq, d: Eq, e: Eq, f: Eq, g: Eq

impl Hash for (a, b, c, d, e, f, g) where a: Hash, b: Hash, c: Hash, d: Hash, e: Hash, f: Hash, g: Hash:
    fn hash(let self) -> Int:
        let (x0, x1, x2, x3, x4, x5, x6) = self
        var h = 7
        h = hash_combine(h, x0.hash())
        h = hash_combine(h, x1.hash())
        h = hash_combine(h, x2.hash())
        h = hash_combine(h, x3.hash())
        h = hash_combine(h, x4.hash())
        h = hash_combine(h, x5.hash())
        h = hash_combine(h, x6.hash())
        h

impl PartialEq for (a, b, c, d, e, f, g, h) where a: PartialEq, b: PartialEq, c: PartialEq, d: PartialEq, e: PartialEq, f: PartialEq, g: PartialEq, h: PartialEq:
    fn eq(let self, let other: Self) -> Bool:
        let (x0, x1, x2, x3, x4, x5, x6, x7) = self
        let (y0, y1, y2, y3, y4, y5, y6, y7) = other
        x0 == y0 && x1 == y1 && x2 == y2 && x3 == y3 && x4 == y4 && x5 == y5 && x6 == y6 && x7 == y7

    fn ne(let self, let other: Self) -> Bool:
        !eq(self, other)

impl Eq for (a, b, c, d, e, f, g, h) where a: Eq, b: Eq, c: Eq, d: Eq, e: Eq, f: Eq, g: Eq, h: Eq

impl Hash for (a, b, c, d, e, f, g, h) where a: Hash, b: Hash, c: Hash, d: Hash, e: Hash, f: Hash, g: Hash, h: Hash:
    fn hash(let self) -> Int:
        let (x0, x1, x2, x3, x4, x5, x6, x7) = self
        var h = 8
        h = hash_combine(h, x0.hash())
        h = hash_combine(h, x1.hash())
        h = hash_combine(h, x2.hash())
        h = hash_combine(h, x3.hash())
        h = hash_combine(h, x4.hash())
        h = hash_combine(h, x5.hash())
        h = hash_combine(h, x6.hash())
        h = hash_combine(h, x7.hash())
        h

// --- generic helpers over `Ord` ----------------------------------------------

// True when `a` orders strictly before `b` by the type's TOTAL order. Going
// through `compare` (not the `<` operator, which only needs `PartialOrd`) is what
// makes these helpers reject a merely-partial type like `Float`.
fn lt(a: x, b: x) -> Bool where x: Ord:
    match compare(a, b):
        Less -> true
        _ -> false

pub fn max_of(x: a, y: a) -> a where a: Ord:
    if lt(x, y):
        y
    else:
        x

pub fn min_of(x: a, y: a) -> a where a: Ord:
    if lt(y, x):
        y
    else:
        x

// `x` confined to the range [lo, hi]. `lo` must not exceed `hi` (RFC-0044
// rule 3): inverted bounds describe an empty range, so they fail loudly
// instead of silently returning `lo` (matching `math.clamp`).
pub fn clamp(x: a, lo: a, hi: a) -> a where a: Ord:
    if lt(hi, lo):
        fail("cmp.clamp: lo exceeds hi (an empty range)")
    if lt(x, lo):
        lo
    else if lt(hi, x):
        hi
    else:
        x

// The largest element of `xs`, or `default` when `xs` is empty. `default` is
// only the empty fallback - it never participates in the comparison, so it is
// returned unchanged only for an empty list (a small `default` no longer wins
// over the elements, nor a large one lose to them).
pub fn maximum(xs: List(a), default: a) -> a where a: Ord:
    var best = default
    var seen = false
    for x in xs:
        if !seen || lt(best, x):
            best = x
            seen = true
    best

// The smallest element of `xs`, or `default` when `xs` is empty. As with
// `maximum`, `default` is the empty fallback only, never a competing bound.
pub fn minimum(xs: List(a), default: a) -> a where a: Ord:
    var best = default
    var seen = false
    for x in xs:
        if !seen || lt(x, best):
            best = x
            seen = true
    best

// --- Equivalent implementations (RFC-0139) -----------------------------------
impl Equivalent(String) for str:
    fn equivalent(self: &str, key: &String) -> Bool:
        string.equal_views(self, string.as_str(key))

    fn equivalent_hash(self: &str) -> Int:
        string.hash_view(self)
