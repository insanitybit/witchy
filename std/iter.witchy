// std/iter - lazy, pull-based iterators: the witchy take on Rust's Iterator,
// minus the part Rust most regrets. Because witchy values are "data" (no
// borrowing), there is no lending-iterator / GAT complexity: an `Iter(a)` is
// just a thunk that produces the next `Step`. Adapters (`map`/`filter`/
// `take_while`/...) are lazy and compose without building intermediate lists;
// consumers (`collect`/`fold`/`find`/`count`) drive the pulling. Infinite
// iterators are fine (`count_from`, `repeat`) as long as something bounds them
// (`take`/`take_while`/`find`). Pure and capability-free; runs on both backends.
// `gen fn`/`yield` lower to this representation: common loops use `unfold` with
// an owned typed frame, while `from_gen` remains the fallback for irregular
// control flow.
//
// Adapters and consumers are METHODS on `Iter` (`it.map(f).take(3)`), so
// pipelines read left-to-right. The module level keeps only what has no
// receiver - the constructors (`iter.range`, `iter.from_list`, ...) - plus
// `iter.collect` (whose polymorphic return type dispatches on the EXPECTED
// type; keeping it a free function also avoids a measured mono-pass blowup)
// and the pull primitive `iter.next` (also a method; the free form drives the
// module's own generic internals).

import option
import set

// One pull: either exhausted, or a value plus the rest of the iterator.
type Step:
    Empty
    Item(a, Iter(a))

// An iterator is a thunk producing its next Step. Pull it with `next`.
type Iter:
    Iter(fn() -> Step(a))

// The pull primitive. Kept at module level (the method delegates to it):
// internal step helpers pull from pattern-bound iterators, whose method
// dispatch the quiet pre-mono pass cannot resolve.
pub fn next(it: Iter(a)) -> Step(a):
    match it:
        Iter(thunk) -> thunk()

// ---- constructors ----

// The empty iterator.
pub fn empty() -> Iter(a):
    Iter(fn(): Empty)

// One element, then done.
pub fn once(x: a) -> Iter(a):
    Iter(fn(): Item(x, empty()))

// Build an iterator from a `seed` by repeatedly applying `f`, which returns
// `Some((value, next_seed))` to yield a value or `None` to stop. The general
// generator primitive - count/fibonacci/range are all unfolds.
pub fn unfold(own seed: s, f: fn(own s) -> Option((a, s))) -> Iter(a):
    Iter(fn(): unfold_step(seed, f))

fn unfold_step(own seed: s, f: fn(own s) -> Option((a, s))) -> Step(a):
    match f(seed):
        Some(pair) ->
            match pair:
                (x, nxt) -> Item(x, unfold(nxt, f))
        None -> Empty

// The integers n, n+1, n+2, ... (infinite).
pub fn count_from(n: Int) -> Iter(Int):
    unfold(n, fn(own i: Int): Some((i, i + 1)))

// The half-open integer range [lo, hi).
pub fn range(lo: Int, hi: Int) -> Iter(Int):
    unfold(lo, fn(own i: Int): if i < hi: Some((i, i + 1)) else: None)

// `x` forever (infinite).
pub fn repeat(x: a) -> Iter(a):
    Iter(fn(): Item(x, repeat(x)))

// A list's elements, in order.
pub fn from_list(xs: List(a)) -> Iter(a):
    unfold(0, fn(own i: Int): if i < list.length(xs): Some((list.at(xs, i), i + 1)) else: None)

// Build an iterator from an index function: `f(0)`, `f(1)`, ... each `Some(x)`
// is the next element and the first `None` ends it. This is the compatibility
// target for generator control flow that cannot yet use the owned-frame path:
// pulling element i re-runs the body to its i-th yield.
pub fn from_gen(f: fn(Int) -> Option(a)) -> Iter(a):
    from_gen_at(f, 0)

fn from_gen_at(f: fn(Int) -> Option(a), i: Int) -> Iter(a):
    Iter(fn(): from_gen_step(f, i))

fn from_gen_step(f: fn(Int) -> Option(a), i: Int) -> Step(a):
    match f(i):
        Some(x) -> Item(x, from_gen_at(f, i + 1))
        None -> Empty

// ---- lazy adapter cores (private) ----
// Each adapter method delegates to one of these free functions, which rebuild
// the lazy tail by calling THEMSELVES - the quiet pre-mono pass cannot resolve
// a method on a pattern-bound `rest`, so the recursion must be a direct call.
// The scans are iterative loops, so the pipeline stays stack-safe.
fn map(it: Iter(a), f: fn(a) -> b) -> Iter(b):
    Iter(fn(): map_step(next(it), f))

fn map_step(s: Step(a), f: fn(a) -> b) -> Step(b):
    match s:
        Empty -> Empty
        Item(x, rest) -> Item(f(x), map(rest, f))

fn filter(it: Iter(a), keep: fn(a) -> Bool) -> Iter(a):
    Iter(fn(): filter_step(next(it), keep))

fn filter_step(s: Step(a), keep: fn(a) -> Bool) -> Step(a):
    var cur = s
    var out = Empty
    var scanning = true
    while scanning:
        match cur:
            Empty -> scanning = false
            Item(x, rest) ->
                if keep(x):
                    out = Item(x, filter(rest, keep))
                    scanning = false
                else:
                    cur = next(rest)
    out

fn filter_map(it: Iter(a), f: fn(a) -> Option(b)) -> Iter(b):
    Iter(fn(): filter_map_step(next(it), f))

fn filter_map_step(s: Step(a), f: fn(a) -> Option(b)) -> Step(b):
    var cur = s
    var out = Empty
    var scanning = true
    while scanning:
        match cur:
            Empty -> scanning = false
            Item(x, rest) ->
                match f(x):
                    Some(y) ->
                        out = Item(y, filter_map(rest, f))
                        scanning = false
                    None -> cur = next(rest)
    out

fn take(it: Iter(a), k: Int) -> Iter(a):
    Iter(fn(): take_step(it, k))

fn take_step(it: Iter(a), k: Int) -> Step(a):
    if k <= 0:
        Empty
    else:
        match next(it):
            Empty -> Empty
            Item(x, rest) -> Item(x, take(rest, k - 1))

fn take_while(it: Iter(a), pred: fn(a) -> Bool) -> Iter(a):
    Iter(fn(): take_while_step(next(it), pred))

fn take_while_step(s: Step(a), pred: fn(a) -> Bool) -> Step(a):
    match s:
        Empty -> Empty
        Item(x, rest) ->
            if pred(x):
                Item(x, take_while(rest, pred))
            else:
                Empty

fn drop_while_step(it: Iter(a), pred: fn(a) -> Bool) -> Step(a):
    var cur = it
    var out = Empty
    var scanning = true
    while scanning:
        match next(cur):
            Empty -> scanning = false
            Item(x, rest) ->
                if pred(x):
                    cur = rest
                else:
                    out = Item(x, rest)
                    scanning = false
    out

fn drop_step(it: Iter(a), k: Int) -> Step(a):
    var cur = it
    var remaining = k
    var out = Empty
    var scanning = true
    while scanning:
        match next(cur):
            Empty -> scanning = false
            Item(x, rest) ->
                if remaining <= 0:
                    out = Item(x, rest)
                    scanning = false
                else:
                    cur = rest
                    remaining = remaining - 1
    out

fn enumerate_from(it: Iter(a), i: Int) -> Iter((Int, a)):
    Iter(fn(): enumerate_step(next(it), i))

fn enumerate_step(s: Step(a), i: Int) -> Step((Int, a)):
    match s:
        Empty -> Empty
        Item(x, rest) -> Item((i, x), enumerate_from(rest, i + 1))

fn zip(a2: Iter(x), b: Iter(y)) -> Iter((x, y)):
    Iter(fn(): zip_step(next(a2), b))

fn zip_step(sa: Step(x), b: Iter(y)) -> Step((x, y)):
    match sa:
        Empty -> Empty
        Item(xa, resta) ->
            match next(b):
                Empty -> Empty
                Item(xb, restb) -> Item((xa, xb), zip(resta, restb))

fn chain(first: Iter(a), second: Iter(a)) -> Iter(a):
    Iter(fn(): chain_step(next(first), second))

fn chain_step(s: Step(a), second: Iter(a)) -> Step(a):
    match s:
        Empty -> next(second)
        Item(x, rest) -> Item(x, chain(rest, second))

fn flat_map(it: Iter(a), f: fn(a) -> Iter(b)) -> Iter(b):
    Iter(fn(): flat_map_step(next(it), f))

fn flat_map_step(s: Step(a), f: fn(a) -> Iter(b)) -> Step(b):
    var cur = s
    var out = Empty
    var scanning = true
    while scanning:
        match cur:
            Empty -> scanning = false
            Item(x, rest) ->
                match next(f(x)):
                    Empty -> cur = next(rest)
                    Item(y, inner_rest) ->
                        out = Item(y, chain(inner_rest, flat_map(rest, f)))
                        scanning = false
    out

fn scan(it: Iter(a), state: s, f: fn(s, a) -> (s, b)) -> Iter(b):
    Iter(fn(): scan_step(it, state, f))

fn scan_step(it: Iter(a), state: s, f: fn(s, a) -> (s, b)) -> Step(b):
    match next(it):
        Empty -> Empty
        Item(x, rest) ->
            match f(state, x):
                (next_state, y) -> Item(y, scan(rest, next_state, f))

// The consumer core shared by `count`/`sum`/`min`/`max` and the `fold`
// method - free so it can run on pattern-bound tails.
fn fold(it: Iter(a), init: b, f: fn(b, a) -> b) -> b:
    var acc = init
    var cur = it
    var more = true
    while more:
        match next(cur):
            Empty -> more = false
            Item(x, rest) ->
                acc = f(acc, x)
                cur = rest
    acc

// ---- collecting ----

// A type an iterator can be collected INTO. `from_iter` mentions the
// implementing type only in its result, so a call dispatches on the EXPECTED
// type - an ascribed binding, a typed parameter, a for-loop - not on any
// argument.
trait FromIterator(e):
    fn from_iter(it: Iter(e)) -> Self

impl FromIterator(a) for List(a):
    fn from_iter(it: Iter(a)) -> List(a):
        var out = []
        var cur = it
        var more = true
        while more:
            match next(cur):
                Empty -> more = false
                Item(x, rest) ->
                    list.push(out, x)
                    cur = rest
        out

impl FromIterator((k, v)) for Dict(k, v) where k: Eq:
    fn from_iter(it: Iter((k, v))) -> Dict(k, v):
        var out = dict.new()
        var cur = it
        var more = true
        while more:
            match next(cur):
                Empty -> more = false
                Item(pair, rest) ->
                    let (key, value) = pair
                    dict.insert(out, key, value)
                    cur = rest
        out

// A conditional impl: collecting into a `Set` needs `Eq` to deduplicate, so the
// `where a: Eq` rides on the impl head (the trait method itself stays bound-free).
impl FromIterator(a) for Set(a) where a: Eq:
    fn from_iter(it: Iter(a)) -> Set(a):
        var items: List(a) = []
        var cur = it
        var more = true
        while more:
            match next(cur):
                Empty -> more = false
                Item(x, rest) ->
                    list.push(items, x)
                    cur = rest
        set.from_list(items)

impl FromIterator(String) for String:
    fn from_iter(it: Iter(String)) -> String:
        var out = ""
        var cur = it
        var more = true
        while more:
            match next(cur):
                Empty -> more = false
                Item(piece, rest) ->
                    out = out + piece
                    cur = rest
        out

// Collect into any FromIterator type, chosen by the call site's expected
// type (drives the iterator to exhaustion - don't call on an unbounded one):
//     let xs: List(Int) = iter.collect(it)
//     let joined: String = iter.collect(pieces)
//     let s: Set(Int) = iter.collect(it)        # de-duplicates; needs `a: Eq`
// Free-function-only ON PURPOSE: the polymorphic return type in an impl block
// causes a measured mono-pass performance explosion.
pub fn collect(it: Iter(a)) -> c where c: FromIterator(a):
    from_iter(it)

// ---- the method surface: adapters (lazy), then consumers ----
impl Iter(a):
    // One pull: `Empty`, or `Item(value, rest)`.
    pub fn next(self) -> Step(a):
        next(self)

    // Apply `f` to every element.
    pub fn map(self, f: fn(a) -> b) -> Iter(b):
        Iter(fn(): map_step(next(self), f))

    // Keep only the elements for which `keep` holds.
    pub fn filter(self, keep: fn(a) -> Bool) -> Iter(a):
        Iter(fn(): filter_step(next(self), keep))

    // Apply `f` to each element, keeping every `Some(y)` and dropping every
    // `None` - a `map` and `filter` fused into one pass (Rust's
    // `Iterator::filter_map`).
    pub fn filter_map(self, f: fn(a) -> Option(b)) -> Iter(b):
        Iter(fn(): filter_map_step(next(self), f))

    // The first `k` elements (fewer if the iterator is shorter).
    pub fn take(self, k: Int) -> Iter(a):
        take(self, k)

    // Elements up to (not including) the first one failing `pred`.
    pub fn take_while(self, pred: fn(a) -> Bool) -> Iter(a):
        Iter(fn(): take_while_step(next(self), pred))

    // Skip the first `k` elements. Lazy like every adapter: nothing is pulled
    // from the source at construction - the skip runs inside the returned
    // iterator's thunk on first pull, and iteratively, so a large `k` cannot
    // exhaust the stack.
    pub fn drop(self, k: Int) -> Iter(a):
        if k <= 0:
            self
        else:
            Iter(fn(): drop_step(self, k))

    // Skip the leading elements while `pred` holds, then yield the rest.
    pub fn drop_while(self, pred: fn(a) -> Bool) -> Iter(a):
        Iter(fn(): drop_while_step(self, pred))

    // Pair each element with its index: (0, x0), (1, x1), ...
    pub fn enumerate(self) -> Iter((Int, a)):
        enumerate_from(self, 0)

    // Zip with another iterator into pairs, stopping at the shorter one.
    pub fn zip(self, other: Iter(b)) -> Iter((a, b)):
        Iter(fn(): zip_step(next(self), other))

    // The elements of `self`, then the elements of `other`.
    pub fn chain(self, other: Iter(a)) -> Iter(a):
        Iter(fn(): chain_step(next(self), other))

    // Map each element to an iterator and concatenate the results.
    pub fn flat_map(self, f: fn(a) -> Iter(b)) -> Iter(b):
        Iter(fn(): flat_map_step(next(self), f))

    // Concatenate an iterator OF iterators into one flat iterator, lazily and
    // in order - `flatten` is `flat_map` with the identity function.
    pub fn flatten(self: Iter(Iter(b))) -> Iter(b):
        flat_map(self, fn(inner): inner)

    // A lazy STATEFUL map: thread `state` through `f`, which returns the new
    // state and the value to emit. `xs.scan(0, fn(s, x): (s + x, s + x))`
    // yields the running sums. Unlike `fold`, it produces an iterator, so it is
    // lazy and composable, and unlike `map` it can carry state between elements.
    pub fn scan(self, state: s, f: fn(s, a) -> (s, b)) -> Iter(b):
        scan(self, state, f)

    // Call `f` on every element for its effect (drives to exhaustion). The
    // right consumer for a generator when you don't need to early-exit - no
    // list is built.
    pub fn for_each(self, f: fn(a) -> Nil):
        var cur = self
        var more = true
        while more:
            match next(cur):
                Empty -> more = false
                Item(x, rest) ->
                    f(x)
                    cur = rest

    // Left fold over the elements.
    pub fn fold(self, init: b, f: fn(b, a) -> b) -> b:
        fold(self, init, f)

    // Number of elements (drives to exhaustion).
    pub fn count(self) -> Int:
        fold(self, 0, fn(n: Int, _x): n + 1)

    // Sum of an Int iterator.
    pub fn sum(self: Iter(Int)) -> Int:
        fold(self, 0, fn(acc: Int, x: Int): acc + x)

    // Split an iterator into its first element and the rest, or None if it is
    // empty. The building block for writing your own recursive iterator
    // transforms (e.g. a prime sieve): pair it with `unfold`, which threads the
    // "rest" as its seed.
    pub fn split_first(self) -> Option((a, Iter(a))):
        match next(self):
            Empty -> None
            Item(x, rest) -> Some((x, rest))

    // The first element satisfying `pred`, or None (stops at the first match,
    // so it is safe on an unbounded iterator if a match exists).
    pub fn find(self, pred: fn(a) -> Bool) -> Option(a):
        var cur = self
        var more = true
        while more:
            match next(cur):
                Empty -> more = false
                Item(x, rest) ->
                    if pred(x):
                        return Some(x)
                    cur = rest
        None

    // Whether at least one element satisfies `pred` - stops (short-circuits) at
    // the first match, so it terminates on an unbounded iterator once one is
    // found. `false` for the empty iterator.
    pub fn any(self, pred: fn(a) -> Bool) -> Bool:
        var cur = self
        var found = false
        var searching = true
        while searching:
            match next(cur):
                Empty -> searching = false
                Item(x, rest) ->
                    if pred(x):
                        found = true
                        searching = false
                    else:
                        cur = rest
        found

    // Whether every element satisfies `pred` - stops at the first failure.
    // `true` for the empty iterator (vacuously). Don't call on an unbounded
    // iterator whose elements all satisfy `pred`: it never stops.
    pub fn all(self, pred: fn(a) -> Bool) -> Bool:
        var cur = self
        var ok = true
        var checking = true
        while checking:
            match next(cur):
                Empty -> checking = false
                Item(x, rest) ->
                    if pred(x):
                        cur = rest
                    else:
                        ok = false
                        checking = false
        ok

    // The last element (drives the iterator to exhaustion), or None if it is
    // empty. Don't call on an unbounded iterator - it never stops.
    pub fn last(self) -> Option(a):
        var cur = self
        var result = None
        var going = true
        while going:
            match next(cur):
                Empty -> going = false
                Item(x, rest) ->
                    result = Some(x)
                    cur = rest
        result

    // The 0-based index of the first element satisfying `pred`, or None. Stops
    // at the first match, so it is safe on an unbounded iterator if a match
    // exists.
    pub fn position(self, pred: fn(a) -> Bool) -> Option(Int):
        var cur = self
        var idx = 0
        var more = true
        while more:
            match next(cur):
                Empty -> more = false
                Item(x, rest) ->
                    if pred(x):
                        return Some(idx)
                    idx = idx + 1
                    cur = rest
        None

impl Iter(a) where a: Ord:
    // The smallest element by the type's `Ord`, or None if the iterator is
    // empty (drives to exhaustion; don't call on an unbounded iterator).
    pub fn min(self) -> Option(a):
        match next(self):
            Empty -> None
            Item(x, rest) ->
                Some(fold(rest, x, fn(best: a, y: a): if y < best: y else: best))

    // The largest element by the type's `Ord`, or None if the iterator is
    // empty (drives to exhaustion; don't call on an unbounded iterator).
    pub fn max(self) -> Option(a):
        match next(self):
            Empty -> None
            Item(x, rest) ->
                Some(fold(rest, x, fn(best: a, y: a): if y > best: y else: best))
