// Checked runtime values (RFC-0082 Stage 1).
//
// `Dynamic` is an explicit owned boundary. Its payload is the representation-safe
// RFC-0081 existential envelope for `Reflect`; its descriptor is generated by the
// compiler from authenticated declaration identity rather than reconstructed from
// this display name.

import reflect

sealed type RuntimeType:
    RuntimeType(Int, String)

sealed type Dynamic:
    Dynamic(RuntimeType, dyn Reflect)

sealed type RuntimeField:
    RuntimeField(String, RuntimeType)

sealed type DynamicFieldStatus:
    FieldFound(RuntimeType)
    FieldPrivate
    FieldSealed
    FieldMissing
    FieldMalformed

// Checked failures remain ordinary matchable data and never become unchecked
// casts or backend traps.
type DynamicError:
    TypeMismatch(RuntimeType)
    MissingField(String)
    PrivateField(String)
    SealedType(RuntimeType)
    MalformedRequest(String)
    MalformedDescriptor(RuntimeType)
    MalformedPayload(RuntimeType)

// Convert one reflectable value into an owned dynamic envelope. The compiler
// replaces `__dynamic_descriptor` with an immutable descriptor constant and
// rejects direct or transitive capability payloads before either backend runs.
pub fn dynamic(value: a) -> Dynamic where a: Reflect:
    Dynamic(__dynamic_descriptor(value), value)

// Return the immutable descriptor carried by a dynamic value.
pub fn type_of(value: Dynamic) -> RuntimeType:
    match value:
        Dynamic(ty, _) -> ty

// Human-readable only. Descriptor equality and decoding never key on this name.
pub fn type_name(ty: RuntimeType) -> String:
    match ty:
        RuntimeType(_, name) -> name

// Declared public readable fields in source order. The compiler replaces the
// intrinsic with an authenticated lookup over canonical descriptor IDs.
pub fn fields(ty: RuntimeType) -> List(RuntimeField):
    __dynamic_fields(ty)

pub fn field_name(field: RuntimeField) -> String:
    match field:
        RuntimeField(name, _) -> name

pub fn field_type(field: RuntimeField) -> RuntimeType:
    match field:
        RuntimeField(_, ty) -> ty

pub fn field(value: Dynamic, name: String) -> Result(Dynamic, DynamicError):
    if name == "":
        Err(MalformedRequest(name))
    else:
        match value:
            Dynamic(ty, payload) ->
                match __dynamic_field_status(ty, name):
                    FieldFound(field_ty) ->
                        match payload.__dynamic_field(name):
                            Some(reflect.DynamicFieldValue(actual_owner, actual_field, field_payload)) ->
                                match (ty, field_ty):
                                    (RuntimeType(expected_owner, _), RuntimeType(expected_field, _)) ->
                                        if actual_owner != expected_owner || actual_field != expected_field:
                                            Err(MalformedPayload(ty))
                                        else:
                                            Ok(Dynamic(field_ty, field_payload))
                            None -> Err(MalformedPayload(ty))
                    FieldPrivate -> Err(PrivateField(name))
                    FieldSealed -> Err(SealedType(ty))
                    FieldMissing -> Err(MissingField(name))
                    FieldMalformed -> Err(MalformedDescriptor(ty))

// Decode only when the inferred expected type has the exact canonical descriptor.
// The compiler specializes this private call after generic monomorphization.
pub fn try_decode(value: Dynamic) -> Option(a):
    __dynamic_try_decode(value)

// Decode to the result type inferred from the surrounding static context. A
// mismatch retains the actual canonical descriptor for diagnostics and recovery.
pub fn decode(value: Dynamic) -> Result(a, DynamicError):
    let decoded: Option(a) = try_decode(value)
    match decoded:
        Some(decoded) -> Ok(decoded)
        None -> Err(TypeMismatch(type_of(value)))
