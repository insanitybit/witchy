// Checked runtime values (RFC-0082 Stage 1).
//
// `Dynamic` is an explicit owned boundary. Its payload is the representation-safe
// RFC-0081 existential envelope for `Reflect`; its descriptor is generated by the
// compiler from authenticated declaration identity rather than reconstructed from
// this display name.

import reflect

sealed type RuntimeType:
    RuntimeType(Int, String)

sealed type Dynamic:
    Dynamic(RuntimeType, dyn Reflect)

// Convert one reflectable value into an owned dynamic envelope. The compiler
// replaces `__dynamic_descriptor` with an immutable descriptor constant and
// rejects direct or transitive capability payloads before either backend runs.
pub fn dynamic(value: a) -> Dynamic where a: Reflect:
    Dynamic(__dynamic_descriptor(value), value)

// Return the immutable descriptor carried by a dynamic value.
pub fn type_of(value: Dynamic) -> RuntimeType:
    match value:
        Dynamic(ty, _) -> ty

// Human-readable only. Descriptor equality and decoding never key on this name.
pub fn type_name(ty: RuntimeType) -> String:
    match ty:
        RuntimeType(_, name) -> name

// Decode only when the inferred expected type has the exact canonical descriptor.
// The compiler specializes this private call after generic monomorphization.
pub fn try_decode(value: Dynamic) -> Option(a):
    __dynamic_try_decode(value)
