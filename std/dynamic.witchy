// Checked runtime values (RFC-0082 Stage 1).
//
// `Dynamic` is an explicit owned boundary. Its payload is the representation-safe
// RFC-0081 existential envelope for `Reflect`; its descriptor is generated by the
// compiler from authenticated declaration identity rather than reconstructed from
// this display name.

import reflect

sealed type RuntimeType:
    RuntimeType(Int, String)

sealed type Dynamic:
    Dynamic(RuntimeType, dyn Reflect)

sealed type RuntimeField:
    RuntimeField(String, RuntimeType)

// Logical callable access metadata. Every position and projection names a
// source type or loan relation; compiler storage offsets and ownership-token
// representations are intentionally absent.
sealed type RuntimeAccessKind:
    AccessValue
    AccessBorrow
    AccessVar
    AccessOwn

sealed type RuntimeAccessQualifier:
    AccessFrozen
    AccessUnique
    AccessLocalUnique
    AccessView(Int)

sealed type RuntimeQualifierPathStep:
    AccessTypeArgument(Int)
    AccessTupleItem(Int)
    AccessFunctionParameter(Int)
    AccessFunctionResult
    AccessExistentialArgument(Int)
    AccessRecordBase
    AccessRecordField(String)

sealed type RuntimeQualifierSite:
    RuntimeQualifierSite(List(RuntimeQualifierPathStep), List(RuntimeAccessQualifier))

sealed type RuntimeParameterAccess:
    RuntimeParameterAccess(RuntimeAccessKind, List(RuntimeQualifierSite), Bool, Bool)

sealed type RuntimeResultAccess:
    RuntimeResultAccess(List(RuntimeQualifierSite), Bool)

sealed type RuntimeLoanProjectionStep:
    AccessField(String)
    AccessTuple(Int)
    AccessIndex(Int)
    AccessRange(Int, Int, Bool)

sealed type RuntimeBorrowOwner:
    RuntimeBorrowOwner(Int, List(RuntimeLoanProjectionStep))

sealed type RuntimeBorrowRelation:
    RuntimeBorrowRelation(Int, List(RuntimeLoanProjectionStep), List(RuntimeBorrowOwner))

sealed type RuntimeCallableAccess:
    RuntimeCallableAccess(List(RuntimeAccessQualifier), List(RuntimeParameterAccess), RuntimeResultAccess, List(RuntimeBorrowRelation))

sealed type RuntimeMethod:
    RuntimeMethod(String, List(RuntimeType), RuntimeType, List(String), RuntimeCallableAccess)

sealed type DynamicFieldStatus:
    FieldFound(RuntimeType)
    FieldPrivate
    FieldSealed
    FieldMissing
    FieldMalformed

// Checked failures remain ordinary matchable data and never become unchecked
// casts or backend traps.
type DynamicError:
    TypeMismatch(RuntimeType)
    MissingField(String)
    MissingMethod(String)
    ArityMismatch(String, Int, Int)
    ArgumentMismatch(Int, RuntimeType, RuntimeType)
    ResultMismatch(RuntimeType, RuntimeType)
    TraitMismatch(RuntimeType)
    CapabilityDenied(String)
    PrivateField(String)
    SealedType(RuntimeType)
    MalformedRequest(String)
    MalformedDescriptor(RuntimeType)
    MalformedPayload(RuntimeType)

// Convert one reflectable value into an owned dynamic envelope. The compiler
// replaces `__dynamic_descriptor` with an immutable descriptor constant and
// rejects direct or transitive capability payloads before either backend runs.
pub fn dynamic(own value: a) -> Dynamic where a: Reflect:
    Dynamic(__dynamic_descriptor(value), value)

// Return the immutable descriptor carried by a dynamic value.
pub fn type_of(value: Dynamic) -> RuntimeType:
    match value:
        Dynamic(ty, _) -> ty

// Human-readable only. Descriptor equality and decoding never key on this name.
pub fn type_name(ty: RuntimeType) -> String:
    match ty:
        RuntimeType(_, name) -> name

// Declared public readable fields in source order. The compiler replaces the
// intrinsic with an authenticated lookup over canonical descriptor IDs.
pub fn fields(ty: RuntimeType) -> List(RuntimeField):
    __dynamic_fields(ty)

pub fn field_name(field: RuntimeField) -> String:
    match field:
        RuntimeField(name, _) -> name

pub fn field_type(field: RuntimeField) -> RuntimeType:
    match field:
        RuntimeField(_, ty) -> ty

// Public methods explicitly registered with `@dynamic`. The compiler replaces
// this lookup with immutable data from the closed authenticated method plan.
pub fn methods(ty: RuntimeType) -> List(RuntimeMethod):
    __dynamic_methods(ty)

pub fn method_name(method: RuntimeMethod) -> String:
    match method:
        RuntimeMethod(name, _, _, _, _) -> name

pub fn method_args(method: RuntimeMethod) -> List(RuntimeType):
    match method:
        RuntimeMethod(_, args, _, _, _) -> args

pub fn method_result(method: RuntimeMethod) -> RuntimeType:
    match method:
        RuntimeMethod(_, _, result, _, _) -> result

pub fn method_capabilities(method: RuntimeMethod) -> List(String):
    match method:
        RuntimeMethod(_, _, _, capabilities, _) -> capabilities

// The canonical access identity covers the receiver and every declared method
// parameter, including explicit capabilities, in source order.
pub fn method_access(method: RuntimeMethod) -> RuntimeCallableAccess:
    match method:
        RuntimeMethod(_, _, _, _, access) -> access

// Invoke only a descriptor-registered method. Arguments are checked against
// exact authenticated descriptors before the compiler-generated typed call.
pub fn call(value: Dynamic, name: String, args: List(Dynamic)) -> Result(Dynamic, DynamicError):
    __dynamic_call(value, name, args)

// Capability-bearing methods use a separate statically typed authority bundle.
// One capability is passed directly; multiple capabilities use a tuple in the
// same order as the reflected method parameters. Capabilities never enter
// `Dynamic` or the ordinary argument list.
pub fn call_with(value: Dynamic, name: String, args: List(Dynamic), capabilities: c) -> Result(Dynamic, DynamicError):
    __dynamic_call_with(value, name, args, capabilities)

// Query an authenticated `dyn Trait` descriptor produced by
// `dynamic.runtime_type(dyn Trait)`. The compiler closes this relation over the
// linked RFC-0081 impl catalog; display names never participate.
pub fn implements(value: Dynamic, trait_type: RuntimeType) -> Bool:
    __dynamic_implements(value, trait_type)

// Validate the same closed relation while retaining the original owned dynamic
// envelope. Trait identity is evidence for later reflection, not an unchecked
// payload cast.
pub fn as_trait(value: Dynamic, trait_type: RuntimeType) -> Result(Dynamic, DynamicError):
    __dynamic_as_trait(value, trait_type)

pub fn field(value: Dynamic, name: String) -> Result(Dynamic, DynamicError):
    if name == "":
        Err(MalformedRequest(name))
    else:
        match value:
            Dynamic(ty, payload) ->
                match __dynamic_field_status(ty, name):
                    FieldFound(field_ty) ->
                        match payload.__dynamic_field(name):
                            Some(reflect.DynamicFieldValue(actual_owner, actual_field, field_payload)) ->
                                match (ty, field_ty):
                                    (RuntimeType(expected_owner, _), RuntimeType(expected_field, _)) ->
                                        if actual_owner != expected_owner || actual_field != expected_field:
                                            Err(MalformedPayload(ty))
                                        else:
                                            Ok(Dynamic(field_ty, field_payload))
                            None -> Err(MalformedPayload(ty))
                    FieldPrivate -> Err(PrivateField(name))
                    FieldSealed -> Err(SealedType(ty))
                    FieldMissing -> Err(MissingField(name))
                    FieldMalformed -> Err(MalformedDescriptor(ty))

// Decode only when the inferred expected type has the exact canonical descriptor.
// The compiler specializes this private call after generic monomorphization.
pub fn try_decode(value: Dynamic) -> Option(a):
    __dynamic_try_decode(value)

// Decode to the result type inferred from the surrounding static context. A
// mismatch retains the actual canonical descriptor for diagnostics and recovery.
pub fn decode(value: Dynamic) -> Result(a, DynamicError):
    let decoded: Option(a) = try_decode(value)
    match decoded:
        Some(decoded) -> Ok(decoded)
        None -> Err(TypeMismatch(type_of(value)))
