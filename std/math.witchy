// The witchy standard math library: small integer helpers, pure and
// capability-free. (Comparison can't be generic without type classes, so these
// are Int-specific.)

pub fn min(a: Int, b: Int) -> Int:
    if a < b:
        a
    else:
        b

pub fn max(a: Int, b: Int) -> Int:
    if a > b:
        a
    else:
        b

pub fn abs(n: Int) -> Int:
    if n < 0:
        -n
    else:
        n

// -1, 0, or 1 depending on the sign of `n`.
pub fn sign(n: Int) -> Int:
    if n < 0:
        -1
    else if n > 0:
        1
    else:
        0

// Constrain `x` to the inclusive range [lo, hi].
pub fn clamp(x: Int, lo: Int, hi: Int) -> Int:
    max(lo, min(x, hi))

// `base` raised to a non-negative `exp` (exp <= 0 gives 1).
pub fn pow(base: Int, exp: Int) -> Int:
    var r = 1
    var i = 0
    while i < exp:
        r = r * base
        i = i + 1
    r

// Greatest common divisor (Euclid's algorithm).
pub fn gcd(a: Int, b: Int) -> Int:
    var x = abs(a)
    var y = abs(b)
    while y > 0:
        let t = y
        y = x % y
        x = t
    x

// Least common multiple (0 if either argument is 0). Divides before
// multiplying to keep the intermediate value small.
pub fn lcm(a: Int, b: Int) -> Int:
    if a == 0:
        0
    else if b == 0:
        0
    else:
        abs(a / gcd(a, b) * b)

// Whether `n` is even.
pub fn is_even(n: Int) -> Bool:
    n % 2 == 0

// Whether `n` is odd.
pub fn is_odd(n: Int) -> Bool:
    n % 2 != 0

// `n!` — the product 1*2*...*n (1 for n <= 1). Watch the 32-bit range:
// factorial grows past it quickly (13! already overflows).
pub fn factorial(n: Int) -> Int:
    var r = 1
    var i = 2
    while i <= n:
        r = r * i
        i = i + 1
    r

// Whether `n` is prime (trial division up to sqrt(n); n < 2 is not prime).
pub fn is_prime(n: Int) -> Bool:
    if n < 2:
        false
    else:
        var prime = true
        var i = 2
        while i * i <= n:
            if n % i == 0:
                prime = false
            i = i + 1
        prime

// --- Float versions (Int comparison can't be reused for Float) ---

pub fn fmin(a: Float, b: Float) -> Float:
    if a < b:
        a
    else:
        b

pub fn fmax(a: Float, b: Float) -> Float:
    if a > b:
        a
    else:
        b

pub fn fabs(x: Float) -> Float:
    if x < 0.0:
        -x
    else:
        x

pub fn fclamp(x: Float, lo: Float, hi: Float) -> Float:
    fmax(lo, fmin(x, hi))
