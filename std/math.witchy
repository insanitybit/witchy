// The witchy standard math library: small integer helpers, pure and
// capability-free. (Comparison can't be generic without type classes, so these
// are Int-specific.)
// --- Native primitives (intercepted by both backends; self-recursive
// placeholder bodies give the type checker the signatures). ---

// Int -> Float, exactly (within f64 precision).
pub fn to_float(n: Int) -> Float:
    math.to_float(n)

// Float -> Int, truncating toward zero; NaN -> 0; out-of-range saturates.
pub fn to_int(x: Float) -> Int:
    math.to_int(x)

// The square root.
pub fn sqrt(x: Float) -> Float:
    math.sqrt(x)

pub fn min(a: Int, b: Int) -> Int:
    if a < b:
        a
    else:
        b

pub fn max(a: Int, b: Int) -> Int:
    if a > b:
        a
    else:
        b

pub fn abs(n: Int) -> Int:
    if n < 0:
        -n
    else:
        n

// -1, 0, or 1 depending on the sign of `n`.
pub fn sign(n: Int) -> Int:
    if n < 0:
        -1
    else if n > 0:
        1
    else:
        0

// Constrain `x` to the inclusive range [lo, hi].
pub fn clamp(x: Int, lo: Int, hi: Int) -> Int:
    max(lo, min(x, hi))

// `base` raised to a non-negative `exp` (`pow(base, 0)` is 1). A negative `exp`
// has no integer answer, so it is a contract violation (RFC-0044 rule 3): abort
// naming the bad argument rather than silently returning 1.
pub fn pow(base: Int, exp: Int) -> Int:
    if exp < 0:
        fail("math.pow: exponent `${exp}` is negative (expected exp >= 0)")
    var r = 1
    var i = 0
    while i < exp:
        r = r * base
        i = i + 1
    r

// Ceiling division: the smallest integer >= a / b (e.g. items split into pages
// of `b`). For a positive divisor `b`; `ceil_div(7, 3)` is 3, `ceil_div(6, 3)` is 2.
pub fn ceil_div(a: Int, b: Int) -> Int:
    if a >= 0:
        (a + b - 1) / b
    else:
        0 - (0 - a) / b

// Division rounded to the nearest integer (ties away from zero), for a positive
// `b`: `round_div(7, 2)` is 4, `round_div(5, 3)` is 2, `round_div(-7, 2)` is -4.
pub fn round_div(a: Int, b: Int) -> Int:
    if a >= 0:
        (a + b / 2) / b
    else:
        0 - (0 - a + b / 2) / b

// Greatest common divisor (Euclid's algorithm).
pub fn gcd(a: Int, b: Int) -> Int:
    var x = abs(a)
    var y = abs(b)
    while y > 0:
        let t = y
        y = x % y
        x = t
    x

// Least common multiple (0 if either argument is 0). Divides before
// multiplying to keep the intermediate value small.
pub fn lcm(a: Int, b: Int) -> Int:
    if a == 0:
        0
    else if b == 0:
        0
    else:
        abs(a / gcd(a, b) * b)

// Whether `n` is even.
pub fn is_even(n: Int) -> Bool:
    n % 2 == 0

// Whether `n` is odd.
pub fn is_odd(n: Int) -> Bool:
    n % 2 != 0

// `n!` — the product 1*2*...*n (1 for n in {0, 1}). Watch the 32-bit range:
// factorial grows past it quickly (13! already overflows). `n < 0` has no
// factorial, so it is a contract violation (RFC-0044 rule 3): abort naming the
// bad argument rather than silently returning 1.
pub fn factorial(n: Int) -> Int:
    if n < 0:
        fail("math.factorial: `${n}` is negative (expected n >= 0)")
    var r = 1
    var i = 2
    while i <= n:
        r = r * i
        i = i + 1
    r

// Whether `n` is prime (trial division up to math.sqrt(n); n < 2 is not prime).
pub fn is_prime(n: Int) -> Bool:
    if n < 2:
        false
    else:
        var prime = true
        var i = 2
        while i * i <= n:
            if n % i == 0:
                prime = false
            i = i + 1
        prime

// Integer square root: the largest `r` with `r*r <= n` (`isqrt(0)` is 0). A
// negative `n` has no real square root, so it is a contract violation
// (RFC-0044 rule 3): abort naming the bad argument rather than silently
// returning 0. Uses `mid <= n / mid` instead of `mid * mid <= n` so it never
// overflows.
pub fn isqrt(n: Int) -> Int:
    if n < 0:
        fail("math.isqrt: `${n}` is negative (expected n >= 0)")
    if n == 0:
        0
    else:
        var lo = 1
        var hi = n
        var ans = 1
        while lo <= hi:
            let mid = lo + (hi - lo) / 2
            if mid <= n / mid:
                ans = mid
                lo = mid + 1
            else:
                hi = mid - 1
        ans

// Whether `n` is a perfect square (0, 1, 4, 9, ...). Negative `n` is never one.
pub fn is_perfect_square(n: Int) -> Bool:
    if n < 0:
        false
    else:
        let r = isqrt(n)
        r * r == n

// Render `n` in `base` (2..16) with lowercase digits; a negative `n` gets a
// leading "-". An out-of-range base yields "" (so callers can detect misuse).
pub fn to_base(n: Int, base: Int) -> String:
    if base < 2 || base > 16:
        ""
    else if n == 0:
        "0"
    else if n < 0:
        "-" + to_base_neg(n, base)
    else:
        to_base_pos(n, base)

fn to_base_pos(n: Int, base: Int) -> String:
    if n == 0:
        ""
    else:
        to_base_pos(n / base, base) + base_digit(n % base)

// Digits of a NEGATIVE `n`, computed on `n` directly rather than negating it
// first — so `Int.MIN` (whose negation overflows back to itself) renders
// correctly. Each step takes the negated low remainder as a digit and divides
// toward zero; both `n % base` and `n / base` stay in range for any negative `n`.
fn to_base_neg(n: Int, base: Int) -> String:
    if n == 0:
        ""
    else:
        to_base_neg(n / base, base) + base_digit(0 - (n % base))

fn base_digit(d: Int) -> String:
    string.substring("0123456789abcdef", d, d + 1)

// `n` in hexadecimal (e.g. 255 -> "ff").
pub fn to_hex(n: Int) -> String:
    to_base(n, 16)

// `n` in binary (e.g. 5 -> "101").
pub fn to_binary(n: Int) -> String:
    to_base(n, 2)

// --- Float versions (Int comparison can't be reused for Float) ---
pub fn float_min(a: Float, b: Float) -> Float:
    if a < b:
        a
    else:
        b

pub fn float_max(a: Float, b: Float) -> Float:
    if a > b:
        a
    else:
        b

pub fn float_abs(x: Float) -> Float:
    if x < 0.0:
        -x
    else:
        x

pub fn float_clamp(x: Float, lo: Float, hi: Float) -> Float:
    float_max(lo, float_min(x, hi))

// Format `x` with `decimals` digits after the decimal point, rounded half-up:
// format_float(3.14159, 2) = "3.14", format_float(-0.5, 1) = "-0.5",
// format_float(2.0, 0) = "2". Built from float arithmetic, so unlike the
// `to_string` builtin it works on the compiled WASM backend too (which has no
// float formatting). Best for a fixed number of places; very large magnitudes
// lose precision to the Float itself. `decimals` is capped at 18 — the most
// places the `Int` scale `pow(10, decimals)` can hold without overflowing.
pub fn format_float(x: Float, decimals: Int) -> String:
    let d = if decimals < 0: 0 else if decimals > 18: 18 else: decimals
    let scale = pow(10, d)
    let scaled = math.to_int(float_abs(x) * math.to_float(scale) + 0.5)
    let sign = if x < 0.0 && scaled > 0: "-" else: ""
    if d == 0:
        sign + "${scaled}"
    else:
        sign + "${scaled / scale}" + "." + zero_pad(scaled % scale, d)

// `n` as a decimal string left-padded with zeros to at least `width` digits.
fn zero_pad(n: Int, width: Int) -> String:
    var s = "${n}"
    while string.length(s) < width:
        s = "0" + s
    s
