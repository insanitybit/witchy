// time — civil (UTC) date/time from a unix timestamp.
//
// `std/duration` models *spans*; this module models *points* on the calendar.
// Given seconds since the unix epoch (1970-01-01T00:00:00Z), it computes the
// civil year/month/day/hour/minute/second and formats them. The conversions use
// the standard days<->civil algorithm (proleptic Gregorian), correct for any CE
// date and for negative timestamps (before 1970) via floor division.

import ascii
import show

sealed type DateTime:
    DateTime(Int, Int, Int, Int, Int, Int)

pub fn year(d: DateTime) -> Int:
    match d:
        DateTime(y, _mo, _da, _h, _mi, _s) -> y

pub fn month(d: DateTime) -> Int:
    match d:
        DateTime(_y, mo, _da, _h, _mi, _s) -> mo

pub fn day(d: DateTime) -> Int:
    match d:
        DateTime(_y, _mo, da, _h, _mi, _s) -> da

pub fn hour(d: DateTime) -> Int:
    match d:
        DateTime(_y, _mo, _da, h, _mi, _s) -> h

pub fn minute(d: DateTime) -> Int:
    match d:
        DateTime(_y, _mo, _da, _h, mi, _s) -> mi

pub fn second(d: DateTime) -> Int:
    match d:
        DateTime(_y, _mo, _da, _h, _mi, s) -> s

// --- construction ------------------------------------------------------------

// The civil UTC date/time at `ms` MILLISECONDS since the unix epoch — what
// `now(clock)` returns, so `time.from_millis(now(clock))` is the idiom for
// "the current date/time".
pub fn from_millis(ms: Int) -> DateTime:
    from_unix(floor_div(ms, 1000))

// The civil UTC date/time at `secs` SECONDS since the unix epoch (a classic
// unix timestamp). `now(clock)` returns milliseconds — use `from_millis`
// for it, or this becomes the year 58000. The formatted/parsing contract is a
// fixed four-digit CE year, so timestamps outside 0001..9999 are out of domain.
pub fn from_unix(secs: Int) -> DateTime:
    let days = floor_div(secs, 86400)
    let sod = secs - days * 86400
    let (y, mo, da) = civil_from_days(days)
    if y < 1 || y > 9999:
        fail("time.from_unix: year `${y}` is out of range (expected 1..9999)")
    DateTime(y, mo, da, sod / 3600, sod / 60 % 60, sod % 60)

// The unix timestamp for a DateTime (its inverse).
pub fn to_unix(d: DateTime) -> Int:
    days_from_civil(year(d), month(d), day(d)) * 86400 + hour(d) * 3600 + minute(d) * 60 + second(d)

// A DateTime from civil UTC components, validated — `civil(2026, 2, 30, ...)`
// is an Err, not a rollover.
pub fn civil(y: Int, mo: Int, da: Int, h: Int, mi: Int, s: Int) -> Result(DateTime, String):
    if y < 1 || y > 9999:
        return Err("year ${y} is out of range 1..9999")
    if mo < 1 || mo > 12:
        return Err("month ${mo} is out of range 1..12")
    if da < 1 || da > days_in_month(y, mo):
        return Err("day ${da} is out of range for ${y}-${mo}")
    if h < 0 || h > 23 || mi < 0 || mi > 59 || s < 0 || s > 59:
        return Err("time ${h}:${mi}:${s} is out of range")
    Ok(DateTime(y, mo, da, h, mi, s))

// Days in a month, honoring leap February. A month outside 1..12 is a contract
// violation (RFC-0044 rule 3): abort naming the bad argument rather than
// silently returning 31 (the old `_ -> 31` catch-all).
pub fn days_in_month(y: Int, mo: Int) -> Int:
    if mo < 1 || mo > 12:
        fail("time.days_in_month: month `${mo}` is out of range (expected 1..12)")
    match mo:
        2 -> if is_leap(y): 29 else: 28
        4 -> 30
        6 -> 30
        9 -> 30
        11 -> 30
        _ -> 31

// --- parsing -------------------------------------------------------------------

// Parse RFC 3339 / ISO 8601: `2026-06-08T22:30:00Z`, an offset like
// `+02:00` (normalized to UTC), fractional seconds (truncated), a space
// instead of the `T`, or a bare `YYYY-MM-DD` (midnight UTC).
pub fn parse_iso8601(text: String) -> Result(DateTime, String):
    let t = string.trim(text)
    let (y, mo, da) = parse_date_part(t)?
    if string.length(t) == 10:
        return civil(y, mo, da, 0, 0, 0)
    let sep = string.substring(t, 10, 11)
    if sep != "T" && sep != "t" && sep != " ":
        return Err("expected `T` between date and time in `${t}`")
    if string.length(t) < 19 || string.substring(t, 13, 14) != ":" || string.substring(t, 16, 17) != ":":
        return Err("expected `HH:MM:SS` after the date in `${t}`")
    let h = int_at(t, 11, 13)?
    let mi = int_at(t, 14, 16)?
    let s = int_at(t, 17, 19)?
    let base = civil(y, mo, da, h, mi, s)?
    // The rest: optional `.fraction` (truncated), then `Z`, an offset, or
    // nothing (read as UTC).
    var rest = string.drop(t, 19)
    if string.starts_with(rest, "."):
        var i = 1
        while i < string.char_count(rest) && ascii.is_digit(string.substring(rest, i, i + 1)):
            i = i + 1
        if i == 1:
            return Err("empty fractional seconds in `${t}`")
        rest = string.drop(rest, i)
    if rest == "" || rest == "Z" || rest == "z":
        return Ok(base)
    let sign = string.substring(rest, 0, 1)
    if sign != "+" && sign != "-" || string.length(rest) != 6 || string.substring(rest, 3, 4) != ":":
        return Err("bad UTC offset `${rest}` in `${t}` (expected `Z` or `+HH:MM`)")
    let oh = int_at(rest, 1, 3)?
    let om = int_at(rest, 4, 6)?
    if oh > 23 || om > 59:
        return Err("UTC offset `${rest}` is out of range")
    let offset = oh * 3600 + om * 60
    let delta = if sign == "+": 0 - offset else: offset
    Ok(from_unix(to_unix(base) + delta))

// `YYYY-MM-DD` at the start of `t`.
fn parse_date_part(t: String) -> Result((Int, Int, Int), String):
    if string.length(t) < 10 || string.substring(t, 4, 5) != "-" || string.substring(t, 7, 8) != "-":
        return Err("`${t}` is not an ISO 8601 date (expected `YYYY-MM-DD`)")
    let y = int_at(t, 0, 4)?
    let mo = int_at(t, 5, 7)?
    let da = int_at(t, 8, 10)?
    Ok((y, mo, da))

// The digits at `s[from..to]`, as an Int — Err on anything non-numeric.
fn int_at(s: String, from: Int, to: Int) -> Result(Int, String):
    let piece = string.substring(s, from, to)
    if piece == "" || !ascii.all_digits(piece):
        return Err("expected digits at ${from}..${to} of `${s}`, found `${piece}`")
    Ok(string.to_int(piece))

// --- calendar facts ----------------------------------------------------------
pub fn is_leap(y: Int) -> Bool:
    y % 4 == 0 && y % 100 != 0 || y % 400 == 0

// Day of week: 0 = Sunday … 6 = Saturday.
pub fn weekday(d: DateTime) -> Int:
    pmod(days_from_civil(year(d), month(d), day(d)) + 4, 7)

pub fn weekday_name(d: DateTime) -> String:
    list.at(["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"], weekday(d))

pub fn month_name(d: DateTime) -> String:
    list.at(["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"], month(d) - 1)

// --- formatting --------------------------------------------------------------

// `YYYY-MM-DD`.
pub fn date_string(d: DateTime) -> String:
    pad4(year(d)) + "-" + pad2(month(d)) + "-" + pad2(day(d))

// `HH:MM:SS`.
pub fn time_string(d: DateTime) -> String:
    pad2(hour(d)) + ":" + pad2(minute(d)) + ":" + pad2(second(d))

// RFC 3339 / ISO 8601 in UTC, e.g. `2026-06-08T22:30:00Z`.
pub fn iso8601(d: DateTime) -> String:
    date_string(d) + "T" + time_string(d) + "Z"

impl Show for DateTime:
    fn show(self) -> String:
        iso8601(self)

// A strftime-style layout: `%Y-%m-%d %H:%M:%S`, `%A %B %d` and friends.
// Directives: %Y year, %m month, %d day, %H hour, %M minute, %S second,
// %a/%A weekday (short/full), %b/%B month name (short/full), %% a literal
// percent. Anything else after `%` passes through unchanged.
pub fn format(d: DateTime, layout: String) -> String:
    var out = ""
    var pending = false
    for c in string.chars(layout):
        if pending:
            out = out + directive(d, c)
            pending = false
        else if c == "%":
            pending = true
        else:
            out = out + c
    // A layout ending in a bare `%` starts a directive that never arrives;
    // preserve the literal character like any other unknown directive.
    if pending:
        out = out + "%"
    out

fn directive(d: DateTime, c: String) -> String:
    match c:
        "Y" -> pad4(year(d))
        "m" -> pad2(month(d))
        "d" -> pad2(day(d))
        "H" -> pad2(hour(d))
        "M" -> pad2(minute(d))
        "S" -> pad2(second(d))
        "a" -> string.substring(weekday_name(d), 0, 3)
        "A" -> weekday_name(d)
        "b" -> string.substring(month_name(d), 0, 3)
        "B" -> month_name(d)
        "%" -> "%"
        _ -> "%" + c

// --- internals ---------------------------------------------------------------

// Days since 1970-01-01 -> (year, month [1..12], day [1..31]). Hinnant's
// algorithm; valid for any z >= 0 (all CE dates).
fn civil_from_days(days: Int) -> (Int, Int, Int):
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let da = doy - (153 * mp + 2) / 5 + 1
    let mo = if mp < 10: mp + 3 else: mp - 9
    (if mo <= 2: y + 1 else: y, mo, da)

// The inverse: (year, month, day) -> days since 1970-01-01.
fn days_from_civil(y: Int, mo: Int, da: Int) -> Int:
    let y2 = if mo <= 2: y - 1 else: y
    let era = floor_div(y2, 400)
    let yoe = y2 - era * 400
    let mp = if mo > 2: mo - 3 else: mo + 9
    let doy = (153 * mp + 2) / 5 + da - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468

// Floor division (rounds toward negative infinity) — so a pre-1970 timestamp
// lands on the right day. Witchy's `/` truncates toward zero.
fn floor_div(a: Int, b: Int) -> Int:
    let q = a / b
    if a % b != 0 && a % b < 0 != (b < 0):
        q - 1
    else:
        q

// Non-negative modulo.
fn pmod(a: Int, b: Int) -> Int:
    let m = a % b
    if m < 0:
        m + b
    else:
        m

fn pad2(n: Int) -> String:
    if n < 10:
        "0" + "${n}"
    else:
        "${n}"

fn pad4(n: Int) -> String:
    if n < 10:
        "000" + "${n}"
    else if n < 100:
        "00" + "${n}"
    else if n < 1000:
        "0" + "${n}"
    else:
        "${n}"
