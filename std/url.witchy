// Minimal URL parsing — the witchy slice of Go's net/url. Pure and
// capability-free, so it compiles to WASM. Handles `scheme://host[:port][/path]`;
// the port defaults by scheme (443 for https, else 80) and the path to "/".

import option
import ascii

type Url:
    Url(String, String, Int, String)

// Parse a URL, or `None` if it has no `scheme://`.
pub fn parse(s: String) -> Option(Url):
    let sep = index_of(s, "://")
    if sep < 0:
        None
    else:
        let scheme = substring(s, 0, sep)
        let rest = substring(s, sep + 3, char_count(s))
        let slash = index_of(rest, "/")
        let authority = if slash < 0: rest else: substring(rest, 0, slash)
        let path = if slash < 0: "/" else: substring(rest, slash, char_count(rest))
        let colon = index_of(authority, ":")
        let host = if colon < 0: authority else: substring(authority, 0, colon)
        if colon < 0:
            Some(Url(scheme, host, default_port(scheme), path))
        else:
            match parse_port(substring(authority, colon + 1, char_count(authority))):
                Some(p) -> Some(Url(scheme, host, p, path))
                None -> None

fn default_port(scheme: String) -> Int:
    if scheme == "https": 443 else: 80

// The `:port` digits as an Int, or None when empty or non-numeric — so a
// malformed authority (`host:abc`) makes `parse` return None rather than trap
// inside `string_to_int`.
fn parse_port(digits: String) -> Option(Int):
    if all_digits(digits):
        Some(string_to_int(digits))
    else:
        None

fn all_digits(s: String) -> Bool:
    let n = char_count(s)
    if n == 0:
        false
    else:
        var ok = true
        var i = 0
        while i < n:
            if !ascii.is_digit(substring(s, i, i + 1)):
                ok = false
            i = i + 1
        ok

pub fn scheme(u: Url) -> String:
    match u:
        Url(s, _host, _port, _path) -> s

pub fn host(u: Url) -> String:
    match u:
        Url(_scheme, h, _port, _path) -> h

pub fn port(u: Url) -> Int:
    match u:
        Url(_scheme, _host, p, _path) -> p

pub fn path(u: Url) -> String:
    match u:
        Url(_scheme, _host, _port, p) -> p

// Render a Url back to its string form — the inverse of `parse`. The port is
// shown only when it differs from the scheme default, so a parse/format round
// trip of `https://host/p` stays `https://host/p` rather than gaining `:443`.
pub fn format(u: Url) -> String:
    match u:
        Url(s, h, p, pa) ->
            let authority = if p == default_port(s): h else: h <> ":" <> int_to_string(p)
            s <> "://" <> authority <> pa
