// Minimal URL parsing — the witchy slice of Go's net/url. Pure and
// capability-free, so it compiles to WASM. Handles `scheme://host[:port][/path]`;
// the port defaults by scheme (443 for https, else 80) and the path to "/".
//
// `parse` returns a matchable `UrlError`; `parse_string` is the String-rendering
// bridge for application-style callers. Simple scalar parses like
// `string.parse_int` stay `Option`.

import option
import result
import encoding
import show
import error
import convert

sealed type Url:
    Url(String, String, Int, String)

// Matchable URL parse failures. The payload is the original raw URL so callers
// can report or classify without parsing display text.
type UrlError:
    MissingSchemeSeparator(String)
    EmptyScheme(String)
    UserinfoUnsupported(String)
    EmptyHost(String)
    InvalidPort(String)
    MalformedIpv6Literal(String)

pub fn url_error_message(e: UrlError) -> String:
    match e:
        MissingSchemeSeparator(raw) -> "missing `scheme://` in: " + raw
        EmptyScheme(raw) -> "empty scheme in: " + raw
        UserinfoUnsupported(raw) -> "userinfo (`user@...`) is not supported in: " + raw
        EmptyHost(raw) -> "empty host in: " + raw
        InvalidPort(raw) -> "invalid port in: " + raw
        MalformedIpv6Literal(raw) -> "malformed IPv6 literal in: " + raw

impl Show for UrlError:
    fn show(self) -> String:
        url_error_message(self)

impl Error for UrlError

impl From(UrlError) for String:
    fn from(value: UrlError) -> Self:
        url_error_message(value)

// Parse a URL, or a matchable error naming what is malformed. A well-formed URL needs a
// non-empty scheme and host — an empty either side (`://host`, `https:///path`)
// is rejected rather than accepted with a blank field. The scheme is
// case-insensitive (RFC 3986 §3.1) and is normalized to lowercase, so
// `HTTPS://` gets the https default port and formats back canonically.
pub fn parse(s: String) -> Result(Url, UrlError):
    let sep = string.index_of(s, "://") ?? -1
    if sep < 0:
        Err(MissingSchemeSeparator(s))
    else:
        let scheme = string.to_lower(string.substring(s, 0, sep))
        if string.is_empty(scheme):
            Err(EmptyScheme(s))
        else:
            let rest = string.substring(s, sep + 3, string.char_count(s))
            // The authority ends at the first `/`, `?`, or `#` — so a query or
            // fragment glued straight to the host (`host?x=1`) is not swallowed
            // into the host. Everything from that delimiter on is the path.
            let cut = authority_end(rest)
            let authority = string.substring(rest, 0, cut)
            let path = if cut >= string.char_count(rest): "/" else: string.substring(rest, cut, string.char_count(rest))
            // Userinfo (`user@` or `user:pass@`) is outside this minimal
            // `scheme://host[:port][/path]` grammar; reject it loudly rather
            // than reinterpret credentials as host/port text (BUG-380).
            if string.contains(authority, "@"):
                Err(UserinfoUnsupported(s))
            else if malformed_ipv6_authority(authority):
                Err(MalformedIpv6Literal(s))
            else:
                // Split host from port at the LAST colon so a bracketed IPv6
                // literal keeps its inner colons (`[::1]:80` -> host `[::1]`,
                // matching the Net layer's last-colon split). A bare IPv6
                // literal has no brackets and no port, so any colon before the
                // closing `]` is part of the host.
                let split = host_port_split(authority)
                let host = string.substring(authority, 0, split)
                if string.is_empty(host):
                    Err(EmptyHost(s))
                else if split >= string.char_count(authority):
                    Ok(Url(scheme, host, default_port(scheme), path))
                else:
                    match parse_port(string.substring(authority, split + 1, string.char_count(authority))):
                        Some(p) -> Ok(Url(scheme, host, p, path))
                        None -> Err(InvalidPort(s))

// Parse a URL with String errors for application-style boundaries.
pub fn parse_string(s: String) -> Result(Url, String):
    match parse(s):
        Ok(u) -> Ok(u)
        Err(e) -> Err(url_error_message(e))

// The index in `rest` where the authority ends: the earliest of `/`, `?`, `#`,
// or the end of the string when none is present.
fn authority_end(rest: String) -> Int:
    var best = string.char_count(rest)
    let slash = string.index_of(rest, "/") ?? -1
    if slash >= 0 && slash < best:
        best = slash
    let query = string.index_of(rest, "?") ?? -1
    if query >= 0 && query < best:
        best = query
    let hash = string.index_of(rest, "#") ?? -1
    if hash >= 0 && hash < best:
        best = hash
    best

// The index of the port-separating colon in an authority, or the authority's
// length when there is no explicit port. A bracketed IPv6 literal (`[::1]`,
// `[::1]:80`) keeps every colon up to and including the closing `]` inside the
// host: the only port colon is one that follows `]`. An unbracketed authority
// splits at its last colon, so an ordinary `host:port` is unambiguous and a
// bare IPv6 literal (`::1`, no port) stays entirely in the host.
fn host_port_split(authority: String) -> Int:
    let n = string.char_count(authority)
    if string.starts_with(authority, "["):
        let close = string.index_of(authority, "]") ?? -1
        if close < 0:
            n
        else if close + 1 < n && string.char_at(authority, close + 1) == Some(":"):
            close + 1
        else:
            n
    else:
        let last = last_colon(authority)
        if last < 0:
            n
        else if string.index_of(authority, ":") != Some(last):
            // More than one colon means an unbracketed IPv6 literal, not a
            // host followed by a decimal port. An explicit IPv6 port requires
            // brackets (`[::1]:8080`) so the boundary is unambiguous.
            n
        else:
            last

fn malformed_ipv6_authority(authority: String) -> Bool:
    let opens = string.starts_with(authority, "[")
    let close = string.index_of(authority, "]") ?? -1
    if opens:
        close < 0 || close + 1 < string.char_count(authority) && string.char_at(authority, close + 1) != Some(":")
    else:
        close >= 0

fn last_colon(s: String) -> Int:
    var i = string.char_count(s) - 1
    var found = 0 - 1
    var scanning = true
    while scanning && i >= 0:
        if string.char_at(s, i) == Some(":"):
            found = i
            scanning = false
        i = i - 1
    found

fn default_port(scheme: String) -> Int:
    if scheme == "https":
        443
    else:
        80

// The `:port` digits as an Int in 0..=65535, or None when empty, non-numeric, or
// out of range — so a malformed authority (`host:abc`) or an oversized port
// (`host:99999999999999999999`) makes `parse` return an error rather than trap
// inside `string.to_int` (which panics on an out-of-i64 magnitude).
fn parse_port(digits: String) -> Option(Int):
    match string.parse_int(digits):
        Some(p) -> if p >= 0 && p <= 65535: Some(p) else: None
        None -> None

pub fn scheme(u: Url) -> String:
    match u:
        Url(s, _host, _port, _path) -> s

pub fn host(u: Url) -> String:
    match u:
        Url(_scheme, h, _port, _path) -> h

pub fn port(u: Url) -> Int:
    match u:
        Url(_scheme, _host, p, _path) -> p

pub fn path(u: Url) -> String:
    match u:
        Url(_scheme, _host, _port, p) -> p

// Render a Url back to its string form — the inverse of `parse`. The port is
// shown only when it differs from the scheme default, so a parse/format round
// trip of `https://host/p` stays `https://host/p` rather than gaining `:443`.
pub fn format(u: Url) -> String:
    match u:
        Url(s, h, p, pa) ->
            let authority = if p == default_port(s): h else: h + ":" + "${p}"
            s + "://" + authority + pa

impl Show for Url:
    fn show(self) -> String:
        format(self)

// Percent-encode `s` for use as a query-string value (RFC 3986): the unreserved set
// (`A-Z a-z 0-9 - _ . ~`) passes through, every other byte becomes `%XX`. Used to build
// query strings safely — e.g. an OAuth `redirect_uri`, `scope`, or `state`.
pub fn encode(s: String) -> String:
    var out = ""
    for ch in string.chars(s):
        if is_unreserved(ch):
            out = out + ch
        else:
            out = out + percent(ch)
    out

fn is_unreserved(ch: String) -> Bool:
    string.contains("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~", ch)

// `%XX` for each UTF-8 byte of a single character (hex of the bytes, split into pairs).
fn percent(ch: String) -> String:
    let hex = string.to_upper(encoding.hex_encode(ch))
    var out = ""
    var i = 0
    while i < string.length(hex):
        out = out + "%" + string.substring(hex, i, i + 2)
        i = i + 2
    out
