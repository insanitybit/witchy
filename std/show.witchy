// The witchy standard `Show` trait: render a value as a `String`. Built-in impls
// cover the scalars — `Int`, `Float`, `Bool`, `String`, and `Duration` (which
// shows in its human form, `1m30s`, not raw milliseconds) — and the built-in
// containers: a `List`, `Dict`, `Set`, `Option`, `Result`, or tuple whose
// elements are themselves `Show` renders structurally through each element's
// `Show` (`[a, b]`, `{k: v}`, `Some(x)`), so `say(console, [1, 2, 3])` and
// `say(console, someSet)` just work — and a custom element `Show` is honored
// (`[P<1,2>, P<3,4>]`). Implement `Show` for your own types to give them a
// *custom* readable form. (The built-in `to_string` already renders any value
// structurally — `Point(1, 2)`, `[Circle(2), Dot]` — on every backend; reach
// for `Show` when you want a different rendering than that default.) Pure
// except `say`, which takes the `Console` it prints to.

import duration
import set
import string

trait Show:
    fn show(self) -> String

impl Show for Int:
    fn show(self) -> String:
        "${self}"

impl Show for Bool:
    fn show(self) -> String:
        if self:
            "true"
        else:
            "false"

impl Show for String:
    fn show(self) -> String:
        self

impl Show for Float:
    fn show(self) -> String:
        "${self}"

// A Duration SHOWS in its human form ("1m30s"), unlike the structural
// `to_string`, which renders the underlying milliseconds — exactly the kind
// of custom rendering `Show` exists for.
impl Show for Duration:
    fn show(self) -> String:
        duration.human(self)

// Render one value through its `Show` impl. Used for a *let-destructured* slot
// (a tuple's parts), where the slot's concrete type is seeded by the
// destructure, so the bound resolves.
fn show_one(x: a) -> String where a: Show:
    show(x)

// Render each element of a list through its `Show` impl. Every container impl
// below funnels its elements through this ONE single-bound helper: the loop
// runs over a parameter (whose concrete type each specialization knows), so the
// `show(x)` dispatch resolves — including when the element is itself a
// container rendered by another blanket impl.
fn show_each(xs: List(a)) -> List(String) where a: Show:
    var parts = []
    for x in xs:
        parts = list.push(parts, show(x))
    parts

// An `Option`'s payload as a 0-or-1-element list, so the container impls can
// render it with `show_each` (the same trick `reflect.witchy` uses).
fn opt_elems(o: Option(a)) -> List(a):
    match o:
        Some(v) -> [v]
        None -> []

// A list renders as `[a, b, c]`, each element through its own `Show` — the same
// structural form `"${xs}"` produces, but honoring a custom element `Show`.
impl Show for List(a) where a: Show:
    fn show(self) -> String:
        "[" + list.join(show_each(self), ", ") + "]"

// An option renders as `Some(x)` / `None`, the payload through its `Show`.
// The `List(a)` ascriptions below (here and in the other container impls) are
// load-bearing: monomorphization substitutes body type annotations, so the
// ascribed binding carries the concrete element type this instantiation uses,
// which is what lets `show_each` specialize on a call result.
impl Show for Option(a) where a: Show:
    fn show(self) -> String:
        let elems: List(a) = opt_elems(self)
        let parts = show_each(elems)
        if list.is_empty(parts):
            "None"
        else:
            "Some(" + list.join(parts, "") + ")"

// A result renders as `Ok(x)` / `Err(e)`, each payload through its `Show`.
impl Show for Result(a, e) where a: Show, e: Show:
    fn show(self) -> String:
        let ok_elems: List(a) = opt_elems(result.ok(self))
        let err_elems: List(e) = opt_elems(result.err(self))
        let oks = show_each(ok_elems)
        let errs = show_each(err_elems)
        if result.is_ok(self):
            "Ok(" + list.join(oks, "") + ")"
        else:
            "Err(" + list.join(errs, "") + ")"

// A dict renders as `{k1: v1, k2: v2}` (insertion order), keys and values each
// through their `Show`.
impl Show for Dict(k, v) where k: Show, v: Show:
    fn show(self) -> String:
        let key_elems: List(k) = dict.keys(self)
        let val_elems: List(v) = dict.values(self)
        let ks = show_each(key_elems)
        let vs = show_each(val_elems)
        var parts = []
        for kk, vv in list.zip(ks, vs):
            parts = list.push(parts, kk + ": " + vv)
        "{" + list.join(parts, ", ") + "}"

// A set renders as `{a, b, c}` (members in insertion order), each through its
// `Show`.
impl Show for Set(a) where a: Show:
    fn show(self) -> String:
        let elems: List(a) = set.to_list(self)
        "{" + list.join(show_each(elems), ", ") + "}"

// Tuples render as `(a, b)`; each common arity has its own impl and dispatches
// per slot, as the derives do.
impl Show for (a, b) where a: Show, b: Show:
    fn show(self) -> String:
        let (x0, x1) = self
        "(" + show_one(x0) + ", " + show_one(x1) + ")"

impl Show for (a, b, c) where a: Show, b: Show, c: Show:
    fn show(self) -> String:
        let (x0, x1, x2) = self
        "(" + show_one(x0) + ", " + show_one(x1) + ", " + show_one(x2) + ")"

impl Show for (a, b, c, d) where a: Show, b: Show, c: Show, d: Show:
    fn show(self) -> String:
        let (x0, x1, x2, x3) = self
        "(" + show_one(x0) + ", " + show_one(x1) + ", " + show_one(x2) + ", " + show_one(x3) + ")"

// Print any `Show` value without converting it by hand — `say(console, 42)`,
// `say(console, point)`, `say(console, [1, 2, 3])`. The Show-accepting `print`
// you reach for instead of `print(console, "${n}")`. (A thin wrapper kept out of
// the `print` builtin so a builtin never depends on a std trait.)
pub fn say(console: Console, x: impl Show):
    print(console, show(x))
