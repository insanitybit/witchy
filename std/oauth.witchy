// oauth — the OAuth 2.0 Authorization Code flow (RFC 6749 §4.1), the basis of "Log in
// with GitHub / Google". Pure witchy over `std/http` (HTTPS) + `url`. A relying party:
//   1. redirects the user to `authorize_url(...)`;
//   2. receives a `code` (and the `state` it sent) at its registered callback;
//   3. exchanges the code for an access token with `exchange_code(...)`.
// Identity is then read from a provider endpoint (GitHub `/user`) or, for OIDC, the
// `id_token` (verify with `std/jwt`). `state` is an opaque anti-CSRF token the caller
// signs before the redirect and re-checks on the callback — bind it to the session.

import http
import url
import string
import option
import result
from json import Json

// The provider authorization-endpoint URL to redirect the user to. After the user
// approves, the provider redirects to `redirect_uri?code=...&state=...`. `scope` is the
// provider's space-separated permission list (e.g. GitHub `read:user`, OIDC `openid email`).
// An endpoint that already carries fixed parameters (a tenant, `prompt`, ...) is
// extended with `&`, never a second `?`.
pub fn authorize_url(authorize_endpoint: String, client_id: String, redirect_uri: String, scope: String, state: String) -> String:
    let joiner = if string.contains(authorize_endpoint, "?"): "&" else: "?"
    authorize_endpoint + joiner + "response_type=code" + "&client_id=" + url.encode(client_id) + "&redirect_uri=" + url.encode(redirect_uri) + "&scope=" + url.encode(scope) + "&state=" + url.encode(state)

// Exchange an authorization `code` for an access token at the provider's token endpoint
// — an HTTPS POST with a form-encoded body and `Accept: application/json`. Returns the
// `access_token`, or a reason. Needs a `Net` that reaches the token host over TLS; the
// `client_secret` should come from a `Secret`, never a literal.
pub fn exchange_code(net: Net[Connect, Tcp], token_url: String, client_id: String, client_secret: String, code: String, redirect_uri: String) -> Result(String, String):
    match token_response(net, token_url, client_id, client_secret, code, redirect_uri):
        Err(e) -> Err(e)
        Ok(doc) -> token_field(doc, "access_token")

// Like `exchange_code`, but returns the OIDC `id_token` (a JWT carrying the user's
// identity) instead of the access token — for "Log in with Google" and other OIDC
// providers. Verify the returned token with `std/jwt` (`kid` → `rsa_key_for_kid` over the
// provider's JWKS → `verify_oidc`).
pub fn exchange_code_id_token(net: Net[Connect, Tcp], token_url: String, client_id: String, client_secret: String, code: String, redirect_uri: String) -> Result(String, String):
    match token_response(net, token_url, client_id, client_secret, code, redirect_uri):
        Err(e) -> Err(e)
        Ok(doc) -> token_field(doc, "id_token")

// The raw token-endpoint response as JSON (the HTTPS POST exchanging the code) — the level
// beneath `exchange_code`; read `access_token` / `id_token` / `refresh_token` from it.
pub fn token_response(net: Net[Connect, Tcp], token_url: String, client_id: String, client_secret: String, code: String, redirect_uri: String) -> Result(Json, String):
    // This POST carries the `client_secret`; plaintext HTTP would leak it on the
    // wire, so refuse anything but HTTPS — fail closed (BUG-265).
    if !string.starts_with(token_url, "https://"):
        return Err("refusing to POST client credentials to a non-HTTPS token endpoint: " + token_url)
    let body = "grant_type=authorization_code" + "&client_id=" + url.encode(client_id) + "&client_secret=" + url.encode(client_secret) + "&code=" + url.encode(code) + "&redirect_uri=" + url.encode(redirect_uri)

    let req = http.post_request(token_url)
        .with_header("accept", "application/json")
        .with_header("content-type", "application/x-www-form-urlencoded")
        .with_body(body)
    match req.send_string(net):
        // Surface the provider's error body (an OAuth error response carries
        // `error`/`error_description`), not just the bare status (BUG-418).
        Err(e) -> Err("token endpoint unreachable: " + e)
        Ok(resp) ->
            if !http.is_success(resp):
                Err("token endpoint returned HTTP " + "${http.status(resp)}" + ": " + http.body(resp))
            else:
                let doc = json.decode(http.body(resp))?
                Ok(doc)

// GET `url` with a `Bearer` access token and parse the JSON body — the "read the
// signed-in user" step after `exchange_code` (GitHub `/user`, an OIDC userinfo endpoint).
// Sends a `User-Agent` (GitHub rejects requests without one). Returns the parsed JSON, or
// a reason. The caller reads identity fields it trusts (`login`, `id`, `email`).
pub fn bearer_get_json(net: Net[Connect, Tcp], url: String, token: String) -> Result(Json, String):
    // The request carries a `Bearer` access token; plaintext HTTP would leak it, so
    // refuse anything but HTTPS — fail closed (BUG-265).
    if !string.starts_with(url, "https://"):
        return Err("refusing to send a bearer token to a non-HTTPS URL: " + url)
    let req = http.get_request(url)
        .with_header("authorization", "Bearer " + token)
        .with_header("accept", "application/json")
        .with_header("user-agent", "witchy-oauth")
    match req.send_string(net):
        Err(e) -> Err("request failed: " + e)
        Ok(resp) ->
            if !http.is_success(resp):
                Err("endpoint returned HTTP " + "${http.status(resp)}")
            else:
                let doc = json.decode(http.body(resp))?
                Ok(doc)

// Read a string field from a token response, surfacing the provider's `error` if the
// field is absent (an OAuth error response carries `error`/`error_description`).
fn token_field(doc: Json, field: String) -> Result(String, String):
    match json.get_string(doc, field):
        Some(token) -> Ok(token)
        None ->
            match json.get_string(doc, "error"):
                Some(provider_error) -> Err("token endpoint error: " + provider_error)
                None -> Err("no " + field + " in token response")
