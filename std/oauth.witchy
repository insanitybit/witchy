// oauth — the OAuth 2.0 Authorization Code flow (RFC 6749 §4.1), the basis of "Log in
// with GitHub / Google". Pure witchy over `std/http` (HTTPS) + `url`. A relying party:
//   1. redirects the user to `authorize_url(...)`;
//   2. receives a `code` (and the `state` it sent) at its registered callback;
//   3. exchanges the code for an access token with `exchange_code(...)`.
// Identity is then read from a provider endpoint (GitHub `/user`) or, for OIDC, the
// `id_token` (verify with `std/jwt`). `state` is an opaque anti-CSRF token the caller
// signs before the redirect and re-checks on the callback — bind it to the session.

import http
import url
import string
import option
import result
import show
import error
import convert
from json import Json

// Matchable OAuth/OIDC client failures. Transport, provider HTTP status, JSON
// response shape, and missing token fields stay distinct until the application
// boundary renders them.
type OAuthError:
    TokenEndpointNotHttps(String)
    BearerEndpointNotHttps(String)
    TokenEndpointUnreachable(http.HttpError)
    BearerRequestFailed(http.HttpError)
    TokenEndpointRejected(Int, String)
    BearerEndpointRejected(Int)
    TokenResponseJson(json.DecodeError)
    BearerResponseJson(json.DecodeError)
    ProviderError(String)
    MissingTokenField(String)

pub fn oauth_error_message(e: OAuthError) -> String:
    match e:
        TokenEndpointNotHttps(endpoint) -> "refusing to POST client credentials to a non-HTTPS token endpoint: " + endpoint
        BearerEndpointNotHttps(endpoint) -> "refusing to send a bearer token to a non-HTTPS URL: " + endpoint
        TokenEndpointUnreachable(reason) -> "token endpoint unreachable: " + http.http_error_message(reason)
        BearerRequestFailed(reason) -> "request failed: " + http.http_error_message(reason)
        TokenEndpointRejected(status, body) -> "token endpoint returned HTTP " + "${status}" + ": " + body
        BearerEndpointRejected(status) -> "endpoint returned HTTP " + "${status}"
        TokenResponseJson(reason) -> "token endpoint response is not JSON: " + json.decode_error_message(reason)
        BearerResponseJson(reason) -> "endpoint response is not JSON: " + json.decode_error_message(reason)
        ProviderError(reason) -> "token endpoint error: " + reason
        MissingTokenField(field) -> "no " + field + " in token response"

impl Show for OAuthError:
    fn show(self) -> String:
        oauth_error_message(self)

impl Error for OAuthError

impl From(OAuthError) for String:
    fn from(value: OAuthError) -> Self:
        oauth_error_message(value)

// The provider authorization-endpoint URL to redirect the user to. After the user
// approves, the provider redirects to `redirect_uri?code=...&state=...`. `scope` is the
// provider's space-separated permission list (e.g. GitHub `read:user`, OIDC `openid email`).
// An endpoint that already carries fixed parameters (a tenant, `prompt`, ...) is
// extended with `&`, never a second `?`.
pub fn authorize_url(authorize_endpoint: String, client_id: String, redirect_uri: String, scope: String, state: String) -> String:
    let joiner = if authorize_endpoint.contains("?"): "&" else: "?"
    authorize_endpoint + joiner + "response_type=code" + "&client_id=" + url.encode(client_id) + "&redirect_uri=" + url.encode(redirect_uri) + "&scope=" + url.encode(scope) + "&state=" + url.encode(state)

// Exchange an authorization `code` for an access token at the provider's token endpoint
// — an HTTPS POST with a form-encoded body and `Accept: application/json`. Returns the
// `access_token`, or a reason. Needs a `Net` that reaches the token host over TLS; the
// `client_secret` should come from a `Secret`, never a literal.
pub fn exchange_code(net: Net[Connect, Tcp], token_url: String, client_id: String, client_secret: String, code: String, redirect_uri: String) -> Result(String, OAuthError):
    match token_response(net, token_url, client_id, client_secret, code, redirect_uri):
        Err(e) -> Err(e)
        Ok(doc) -> token_field(doc, "access_token")

pub fn exchange_code_string(net: Net[Connect, Tcp], token_url: String, client_id: String, client_secret: String, code: String, redirect_uri: String) -> Result(String, String):
    match exchange_code(net, token_url, client_id, client_secret, code, redirect_uri):
        Ok(token) -> Ok(token)
        Err(e) -> Err(oauth_error_message(e))

// Like `exchange_code`, but returns the OIDC `id_token` (a JWT carrying the user's
// identity) instead of the access token — for "Log in with Google" and other OIDC
// providers. Verify the returned token with `std/jwt` (`kid` → `rsa_key_for_kid` over the
// provider's JWKS → `verify_oidc_fresh` with that provider's lifetime policy).
pub fn exchange_code_id_token(net: Net[Connect, Tcp], token_url: String, client_id: String, client_secret: String, code: String, redirect_uri: String) -> Result(String, OAuthError):
    match token_response(net, token_url, client_id, client_secret, code, redirect_uri):
        Err(e) -> Err(e)
        Ok(doc) -> token_field(doc, "id_token")

pub fn exchange_code_id_token_string(net: Net[Connect, Tcp], token_url: String, client_id: String, client_secret: String, code: String, redirect_uri: String) -> Result(String, String):
    match exchange_code_id_token(net, token_url, client_id, client_secret, code, redirect_uri):
        Ok(token) -> Ok(token)
        Err(e) -> Err(oauth_error_message(e))

// The raw token-endpoint response as JSON (the HTTPS POST exchanging the code) — the level
// beneath `exchange_code`; read `access_token` / `id_token` / `refresh_token` from it.
pub fn token_response(net: Net[Connect, Tcp], token_url: String, client_id: String, client_secret: String, code: String, redirect_uri: String) -> Result(Json, OAuthError):
    // This POST carries the `client_secret`; plaintext HTTP would leak it on the
    // wire, so refuse anything but HTTPS — fail closed (BUG-265).
    if !token_url.starts_with("https://"):
        return Err(TokenEndpointNotHttps(token_url))
    let body = "grant_type=authorization_code" + "&client_id=" + url.encode(client_id) + "&client_secret=" + url.encode(client_secret) + "&code=" + url.encode(code) + "&redirect_uri=" + url.encode(redirect_uri)

    let req = http.post_request(token_url)
        .with_header("accept", "application/json")
        .with_header("content-type", "application/x-www-form-urlencoded")
        .with_body(body)
    match req.send(net):
        // Surface the provider's error body (an OAuth error response carries
        // `error`/`error_description`), not just the bare status (BUG-418).
        Err(e) -> Err(TokenEndpointUnreachable(e))
        Ok(resp) ->
            if !http.is_success(resp):
                Err(TokenEndpointRejected(http.status(resp), http.body(resp)))
            else:
                match json.decode(http.body(resp)):
                    Ok(doc) -> Ok(doc)
                    Err(e) -> Err(TokenResponseJson(e))

pub fn token_response_string(net: Net[Connect, Tcp], token_url: String, client_id: String, client_secret: String, code: String, redirect_uri: String) -> Result(Json, String):
    match token_response(net, token_url, client_id, client_secret, code, redirect_uri):
        Ok(doc) -> Ok(doc)
        Err(e) -> Err(oauth_error_message(e))

// GET `url` with a `Bearer` access token and parse the JSON body — the "read the
// signed-in user" step after `exchange_code` (GitHub `/user`, an OIDC userinfo endpoint).
// Sends a `User-Agent` (GitHub rejects requests without one). Returns the parsed JSON, or
// a reason. The caller reads identity fields it trusts (`login`, `id`, `email`).
pub fn bearer_get_json(net: Net[Connect, Tcp], url: String, token: String) -> Result(Json, OAuthError):
    // The request carries a `Bearer` access token; plaintext HTTP would leak it, so
    // refuse anything but HTTPS — fail closed (BUG-265).
    if !url.starts_with("https://"):
        return Err(BearerEndpointNotHttps(url))
    let req = http.get_request(url)
        .with_header("authorization", "Bearer " + token)
        .with_header("accept", "application/json")
        .with_header("user-agent", "witchy-oauth")
    match req.send(net):
        Err(e) -> Err(BearerRequestFailed(e))
        Ok(resp) ->
            if !http.is_success(resp):
                Err(BearerEndpointRejected(http.status(resp)))
            else:
                match json.decode(http.body(resp)):
                    Ok(doc) -> Ok(doc)
                    Err(e) -> Err(BearerResponseJson(e))

pub fn bearer_get_json_string(net: Net[Connect, Tcp], url: String, token: String) -> Result(Json, String):
    match bearer_get_json(net, url, token):
        Ok(doc) -> Ok(doc)
        Err(e) -> Err(oauth_error_message(e))

// Read a string field from a token response, surfacing the provider's `error` if the
// field is absent (an OAuth error response carries `error`/`error_description`).
fn token_field(doc: Json, field: String) -> Result(String, OAuthError):
    match json.get_string(doc, field):
        Some(token) -> Ok(token)
        None ->
            match json.get_string(doc, "error"):
                Some(provider_error) -> Err(ProviderError(provider_error))
                None -> Err(MissingTokenField(field))
