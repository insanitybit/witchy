// Explicit view materialization. `value.owned()` copies a lawful immutable
// `&T` into an independent owned `T`, leaving the rooted view unchanged so the
// owner may subsequently be mutated or moved.
//
// `owned` is a checked typed operation, not a `View` representation conversion.
// It is available only where copying is lawful; `must` resources, authority,
// and view-bearing aggregates require their own
// checked conversion. On an already-owned copyable value it is identity. The
// method uses the ordinary typed dispatch path. The module is named `borrow`
// because `own` is the parameter-convention keyword and cannot be a module name.
trait Owned:
    fn owned(self) -> Self

impl Owned for a:
    fn owned(self) -> Self:
        self
