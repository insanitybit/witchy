// fs — small directory helpers over the `Dir` capability. Each function's
// authority is exactly the `Dir` the caller passes: `collect_files`/`parent_dir`
// need only read, `ensure_dir` needs write. Nothing here widens a capability —
// the confinement of the `Dir` you hand in is preserved.

import string
import option

// Create each level of `path` under `root` (the confined `Dir`'s `make_dir` is
// not recursive). Idempotent. Needs a writable `Dir`.
pub fn ensure_dir(root: Dir, path: String):
    var acc = ""
    for seg in string.split(path, "/"):
        if seg != "":
            acc = if string.is_empty(acc): seg else: acc + "/" + seg
            if !exists(root, acc):
                make_dir(root, acc)

// The parent component of a relative path as `Some`: "a/b/c" -> Some("a/b").
// A single component has no parent, so "a" is `None` (RFC-0044 rule 1: absence
// is `Option`, never an empty-string sentinel). Callers ensuring a parent
// exists can default explicitly: `fs.parent_dir(p) ?? ""` (ensure_dir of ""
// creates nothing).
pub fn parent_dir(path: String) -> Option(String):
    if string.contains(path, "/"):
        let (head, _tail) = string.rsplit_once(path, "/")
        Some(head)
    else:
        None

// Recursively collect every file under `path` whose name ends with `ext`, as
// (relpath, contents) pairs. `rel` is prefixed to each result path (so a nested
// `a/b.witchy` keeps its full relative path). An empty `path` walks from the
// Dir root itself. Needs a readable `Dir`.
pub fn collect_files(root: Dir, path: String, rel: String, ext: String) -> List((String, String)):
    var out = []
    if exists(root, path):
        for entry in list(subtree(root, path)):
            // At the root (empty `path`/`rel`) the child is the bare entry name,
            // never "/entry": the confinement resolver rejects absolute-looking
            // paths, so raw concatenation would skip or trap on root-level entries.
            let child = if string.is_empty(path): entry else: path + "/" + entry
            let child_rel = if string.is_empty(rel): entry else: rel + "/" + entry
            if is_dir(root, child):
                for f in collect_files(root, child, child_rel, ext):
                    out = list.push(out, f)
            else if string.ends_with(entry, ext):
                out = list.push(out, (child_rel, read(root, child)))
    out
