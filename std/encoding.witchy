// encoding — hex and base64 for text conveniences and raw Bytes payloads.
//
// The byte-level codecs need access witchy source cannot express directly, so the
// raw transforms are native intrinsics (like `crypto`): the private helpers below
// are placeholders the runtime never executes — each is intercepted by its
// qualified name and run in Rust on both backends.
//
// Encoding is total, so the encoders return a plain `String`. Decoding can fail, so
// the public `*decode` functions guard the raw codec with a pure-witchy alphabet
// check and return `Result` (RFC-0044): valid input decodes to `Ok`, and any
// non-alphabet character or a truncated final group is a reachable `Err` — never a
// silent truncation (the JWT/WebAuthn segment-decoding hazard BUG-006 named).

import bytes
import result
import string
import show
import error
import convert

// Matchable decode failures for the text encodings this module supports.
type EncodingError:
    InvalidHex(String)
    InvalidBase64(String)
    InvalidBase64Url(String)

pub fn encoding_error_message(e: EncodingError) -> String:
    match e:
        InvalidHex(data) -> "`" + data + "` is not valid hex (expected an even count of `0-9a-fA-F` digits)"
        InvalidBase64(data) -> "`" + data + "` is not valid base64 (expected the `A-Za-z0-9+/` alphabet)"
        InvalidBase64Url(data) -> "`" + data + "` is not valid base64url (expected the URL-safe `A-Za-z0-9-_` alphabet)"

impl Show for EncodingError:
    fn show(self) -> String:
        encoding_error_message(self)

impl Error for EncodingError

impl From(EncodingError) for String:
    fn from(value: EncodingError) -> Self:
        encoding_error_message(value)

// Lowercase hex of `data`'s UTF-8 bytes.
pub fn hex_encode(data: String) -> String:
    hex_encode_bytes(bytes.from_string(data))

// Lowercase hex of raw bytes.
pub fn hex_encode_bytes(data: Bytes) -> String:
    bytes.to_string_lossy(data)

// Decode a hex string (an even count of `0-9a-fA-F` digits) back to text (lossy
// UTF-8 for non-text payloads), or a typed `Err` when it is not hex.
pub fn hex_decode(data: String) -> Result(String, EncodingError):
    result.map_ok(hex_decode_bytes(data), fn(b: Bytes): bytes.to_string_lossy(b))

// Decode a hex string (an even count of `0-9a-fA-F` digits) to raw bytes, or a
// typed `Err` when it is not hex.
pub fn hex_decode_bytes(data: String) -> Result(Bytes, EncodingError):
    if hex_valid(data):
        Ok(hex_decode_bytes_raw(data))
    else:
        Err(InvalidHex(data))

// Decode hex with String errors for application-style boundaries.
pub fn hex_decode_string(data: String) -> Result(String, String):
    match hex_decode(data):
        Ok(text) -> Ok(text)
        Err(e) -> Err(encoding_error_message(e))

// Decode hex bytes with String errors for application-style boundaries.
pub fn hex_decode_bytes_string(data: String) -> Result(Bytes, String):
    match hex_decode_bytes(data):
        Ok(b) -> Ok(b)
        Err(e) -> Err(encoding_error_message(e))

// Standard base64 (with `=` padding) of `data`'s UTF-8 bytes.
pub fn base64_encode(data: String) -> String:
    base64_encode_bytes(bytes.from_string(data))

// Standard base64 (with `=` padding) of raw bytes.
pub fn base64_encode_bytes(data: Bytes) -> String:
    bytes.to_string_lossy(data)

// base64url (no padding; `-`/`_`) of raw bytes.
pub fn base64url_encode_bytes(data: Bytes) -> String:
    bytes.to_string_lossy(data)

// Decode standard base64 (the `A-Za-z0-9+/` alphabet, `=` padding) back to text
// (lossy UTF-8), or a typed `Err` when it is not valid base64.
pub fn base64_decode(data: String) -> Result(String, EncodingError):
    result.map_ok(base64_decode_bytes(data), fn(b: Bytes): bytes.to_string_lossy(b))

// Decode standard base64 (the `A-Za-z0-9+/` alphabet, `=` padding) to raw bytes,
// or a typed `Err` when it is not valid base64.
pub fn base64_decode_bytes(data: String) -> Result(Bytes, EncodingError):
    if base64_valid(data):
        Ok(base64_decode_bytes_raw(data))
    else:
        Err(InvalidBase64(data))

// Decode base64 with String errors for application-style boundaries.
pub fn base64_decode_string(data: String) -> Result(String, String):
    match base64_decode(data):
        Ok(text) -> Ok(text)
        Err(e) -> Err(encoding_error_message(e))

// Decode base64 bytes with String errors for application-style boundaries.
pub fn base64_decode_bytes_string(data: String) -> Result(Bytes, String):
    match base64_decode_bytes(data):
        Ok(b) -> Ok(b)
        Err(e) -> Err(encoding_error_message(e))

// base64url (no padding; `-`/`_`) of the bytes given as a HEX string, or an `Err`
// naming the input when it is not valid hex. The hex indirection lets binary
// round-trip through UTF-8 strings — e.g. a WebAuthn `clientDataJSON.challenge`
// is base64url of the raw challenge bytes. Fallible like `hex_decode` (RFC-0044):
// malformed hex is a reachable `Err`, never the silent drop the raw codec would do.
pub fn hex_to_base64url(hex: String) -> Result(String, EncodingError):
    result.map_ok(hex_decode_bytes(hex), fn(b: Bytes): base64url_encode_bytes(b))

// Convert hex to base64url with String errors for application-style boundaries.
pub fn hex_to_base64url_string(hex: String) -> Result(String, String):
    match hex_to_base64url(hex):
        Ok(text) -> Ok(text)
        Err(e) -> Err(encoding_error_message(e))

// Decode base64url (URL-safe `-`/`_`, no padding) back to text (lossy UTF-8) — the
// JSON header/payload segments of a JWT/OIDC identity token — or an `Err` naming the
// input when it is not valid base64url.
pub fn base64url_decode(data: String) -> Result(String, EncodingError):
    result.map_ok(base64url_decode_bytes(data), fn(b: Bytes): bytes.to_string_lossy(b))

// Decode base64url (URL-safe `-`/`_`, no padding) to raw bytes, or a typed
// `Err` when it is not valid base64url.
pub fn base64url_decode_bytes(data: String) -> Result(Bytes, EncodingError):
    if base64url_valid(data):
        Ok(base64url_decode_bytes_raw(data))
    else:
        Err(InvalidBase64Url(data))

// Decode base64url with String errors for application-style boundaries.
pub fn base64url_decode_string(data: String) -> Result(String, String):
    match base64url_decode(data):
        Ok(text) -> Ok(text)
        Err(e) -> Err(encoding_error_message(e))

// Decode base64url bytes with String errors for application-style boundaries.
pub fn base64url_decode_bytes_string(data: String) -> Result(Bytes, String):
    match base64url_decode_bytes(data):
        Ok(b) -> Ok(b)
        Err(e) -> Err(encoding_error_message(e))

// Decode base64url to a HEX string — for binary that must round-trip through a witchy
// String, e.g. a JWT's RS256 signature fed to `crypto.rsa_pkcs1_sha256_verify` — or an
// `Err` naming the input when it is not valid base64url.
pub fn base64url_to_hex(data: String) -> Result(String, EncodingError):
    result.map_ok(base64url_decode_bytes(data), fn(b: Bytes): hex_encode_bytes(b))

// Decode base64url to hex with String errors for application-style boundaries.
pub fn base64url_to_hex_string(data: String) -> Result(String, String):
    match base64url_to_hex(data):
        Ok(text) -> Ok(text)
        Err(e) -> Err(encoding_error_message(e))

// --- alphabet validators (pure witchy) --------------------------------------
// Character-level, so they agree with the native byte-level codecs: a string these
// accept is entirely ASCII-alphabet, which the codec then consumes in full — so a
// valid decode is never a truncated one. A rejected string never reaches the codec.

// Every character a hex digit, with an even count (each byte is two digits).
fn hex_valid(data: String) -> Bool:
    var count = 0
    var ok = true
    for ch in string.chars(data):
        if string.contains("0123456789abcdefABCDEF", ch):
            count = count + 1
        else:
            ok = false
    ok && count % 2 == 0

// Every non-padding character in the standard base64 alphabet, with a decodable
// bit-length.
fn base64_valid(data: String) -> Bool:
    valid_symbols(data, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")

// Every character in the URL-safe base64 alphabet, with a decodable bit-length.
// base64url is the NO-PADDING form (the JWT/WebAuthn wire format), so any `=` —
// even a well-formed trailing run — is invalid here, not just misplaced padding.
fn base64url_valid(data: String) -> Bool:
    !string.contains(data, "=") && valid_symbols(data, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_")

// Shared base64/base64url check. Every data symbol must be in `alphabet`, and any
// `=` padding must be a contiguous run of 1 or 2 at the very END — never in the
// middle (`S=Gk`) and never three or more (`ab===`). The final group must be
// complete: 1 pad after 3 data symbols, 2 pads after 2. An unpadded string is
// accepted when its symbol count is not `≡ 1 (mod 4)` (a lone trailing symbol
// carries only 6 bits — a truncated final group that would decode to nothing).
fn valid_symbols(data: String, alphabet: String) -> Bool:
    let cs = string.chars(data)
    let n = list.length(cs)
    var i = 0
    var count = 0
    var ok = true
    // Leading data symbols (up to the first `=`).
    while i < n && list.at(cs, i) != "=":
        if !string.contains(alphabet, list.at(cs, i)):
            ok = false
        count = count + 1
        i = i + 1
    // Everything from the first `=` on must itself be `=` (trailing padding only).
    var pad = 0
    while i < n:
        if list.at(cs, i) != "=":
            ok = false
        pad = pad + 1
        i = i + 1
    if !ok:
        false
    else if pad == 0:
        count % 4 != 1
    else if pad == 1:
        count % 4 == 3
    else if pad == 2:
        count % 4 == 2
    else:
        false

// --- raw byte-level codecs (native; intercepted by qualified name) ----------
// These bodies never run: each call is dispatched to the Rust `encoding` registry
// on the interpreter and to the `$encoding` host import on the compiled backend.
fn hex_decode_lossy(data: String) -> String:
    data

fn hex_decode_bytes_raw(data: String) -> Bytes:
    bytes.from_string(data)

fn hex_to_base64url_lossy(hex: String) -> String:
    hex

fn base64_decode_lossy(data: String) -> String:
    data

fn base64_decode_bytes_raw(data: String) -> Bytes:
    bytes.from_string(data)

fn base64url_decode_lossy(data: String) -> String:
    data

fn base64url_decode_bytes_raw(data: String) -> Bytes:
    bytes.from_string(data)

fn base64url_to_hex_lossy(data: String) -> String:
    data
