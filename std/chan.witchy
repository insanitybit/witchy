// std/chan - decoupled concurrency: `spawn` concurrent tasks, communicate over
// first-class `channel`s. Spawning and channels are independent - you can spawn
// without a channel, and a channel is a value you create and pass around, not a
// task's mailbox. Built on a witchy cooperative executor with a deterministic
// round-robin schedule. Given deterministic task behavior, interpreter and
// compiled runs agree; ordinary task callbacks may themselves exercise delegated
// effects. There is no scheduler state in the runtime and no `Pin`.
//
// Messages: channels are per-type generic (RFC-0055). A `Sender(m)`/`Receiver(m)`
// pair carries values of ITS OWN type `m`, and independent channels in one program
// may carry different types - a library may pipeline work through a private channel
// without forcing its message type on the whole program. Under the hood the
// executor is ERASED: its effects and buffers carry the opaque `__Msg`; the
// typed endpoints erase a message on `send` and recover it on `recv`. Compiled
// WebAssembly represents `__Msg` as one typed GC envelope whose i32, i64, f64,
// externref, and erased anyref fields preserve the message's physical kind;
// anyref carries either a GC struct or GC array, and the checked endpoint type
// selects the field to recover. No reference is bit-cast through an integer
// slot. Erasure remains observationally invisible,
// so interleavings stay byte-identical. Spawned tasks return
// `()`; a task reports a result by sending it on a channel, not by returning it (a
// typed `JoinHandle(T)` would force a native runtime and break the parity
// contract). `send`/`recv` are always `await`ed because messaging is an effect on
// the executor-owned buffer; a *bounded* channel additionally blocks the sender
// when full while the executor is making progress (backpressure), an unbounded
// one never does. If every live task parks with no progress, the executor runs
// its quiescence close pass: parked receivers/selects resume with `None`, parked
// senders are released, and parked joins resume. This replaces sender
// refcounting and destructors; it is deterministic on both backends, but
// "closed" means quiescent, not "no `Sender` value can ever be used again".
//
// The `async`/`await` CPS transform lowers onto the `std/task` executor
// (task.lazy/and_then/done/run); channel ops (`await chan.recv(rx)` /
// `await chan.send(tx, x)`) run on the same protocol.

import option
from task import Task, Handle, ChannelId

fn appended(own xs: List(a), own x: a) -> List(a):
    var out = move xs
    list.push_owned(out, move x)
    out

// (RFC-0042) `Task` and `Handle` are owned by std/task. The raw scheduler
// protocol is sealed; chan reaches channel effects through task's compiler-private
// bridge, carrying a non-mintable `ChannelId`. Channel tasks and async-fn tasks
// remain the same type without exposing construction of the erased protocol.
// ---- erasure boundary (RFC-0055) ----

// Recover a received `Option(__Msg)` at the endpoint's message type. The checked
// `m` selects the matching field of the compiled message envelope; the
// `Sender(m)`/`Receiver(m)` pairing to one channel id guarantees the value was
// erased at that same `m`.
fn unerase_option(o: Option(__Msg)) -> Option(m):
    match o:
        Some(x) -> Some(__unerase(x))
        None -> None

// ---- core combinators ----

// A finished task.
pub fn done(own x: a) -> Task(a):
    task.done(x)

// An already-complete `Task(())` - the async/await lowering target for a body
// that falls off its end.
pub fn ready_unit() -> Task(()):
    task.ready_unit()

// Hand control back to the executor once, then continue.
pub fn yield_now() -> Task(()):
    task.yield_now()

// Sequence: run `t`, then continue with `k` applied to its result. This is what
// `await` lowers to - the continuation `k` is the rest of the body.
pub fn and_then(t: Task(a), own k: fn(own a) -> Task(b)) -> Task(b):
    task.and_then(t, k)

// Transform a task's result.
pub fn map(t: Task(a), f: fn(own a) -> b) -> Task(b):
    task.map(t, f)

// Build the task `thunk()` lazily: nothing runs until this task is polled. A
// `Task` is a replayable execution recipe, not a memo cell; the standard driver
// advances through continuations, but driving the same task value again reruns
// its thunk.
pub fn lazy(thunk: fn() -> Task(a)) -> Task(a):
    task.lazy(thunk)

// Run `f(x)` as a task for each `x` in `xs`, in order - the lowering target for an
// `await` inside a `for x in xs:` loop.
pub fn for_each(xs: List(a), f: fn(a) -> Task(())) -> Task(()):
    task.for_each(xs, f)

// ---- spawn + channels (the surface) ----

// The typed sending endpoint of a channel carrying `m` messages.
sealed type Sender(m):
    Sender(ChannelId)

// The typed receiving endpoint of a channel carrying `m` messages.
sealed type Receiver(m):
    Receiver(ChannelId)

// `Handle` is task's (from-imported above) - a spawned child's join handle.

// A channel of logical `capacity`: a positive capacity is bounded (the sender
// blocks when the buffer is full), while 0 - or any non-positive value - is
// unbounded and never blocks the sender, matching the convention that a
// non-positive bound means "no bound".
pub fn channel(capacity: Int) -> Task((Sender(m), Receiver(m))):
    let cap = if capacity < 0: 0 else: capacity
    and_then(task.__channel_open(cap), fn(own id): done((Sender(id), Receiver(id))))

// An unbounded channel - `send` never blocks (the buffer grows without limit).
pub fn unbounded() -> Task((Sender(m), Receiver(m))):
    channel(0)

// Compiler marker for `for await x in rx:`. The async lowering pass unwraps
// this declaration before execution; it exists only so source type checking
// can resolve the parser's lossless receive-stream marker. It must never be
// called as a runtime channel operation.
pub fn __recv_stream(rx: Receiver(m)) -> List(m):
    []

// Send `msg`; on a bounded channel this blocks until there is room while some
// task can make progress. If the whole executor reaches quiescence with this
// send parked, the close pass releases it and stores the message, even if that
// temporarily exceeds the logical capacity. Always awaited. The message is
// erased to the executor's opaque slot at this boundary.
pub fn send(tx: Sender(m), msg: m) -> Task(()):
    match tx:
        Sender(id) -> task.__channel_send(id, __erase(msg))

// Receive the next message, or `None` when the executor reaches quiescence with
// this receive parked. `for await x in rx:` loops until this `None`. Because
// witchy does not refcount sender values, a `Sender` retained by later code may
// still send after such a quiescent close. The erased value is recovered at `m`
// at this boundary.
pub fn recv(rx: Receiver(m)) -> Task(Option(m)):
    match rx:
        Receiver(id) -> task.__channel_recv(id, fn(o): unerase_option(o))

// Compiler-private exact-Int bridges. The lowerer selects these only from a
// proved RFC-0152 ready region; public generic channel APIs and all unproved
// operations continue to use the erased scheduler bridge above.
pub fn __rfc0152_channel_i64(capacity: Int) -> Task((Sender(Int), Receiver(Int))):
    let cap = if capacity < 0: 0 else: capacity
    task.and_then(task.__channel_open_i64(cap), fn(own id): task.done((Sender(id), Receiver(id))))

pub fn __rfc0152_send_i64(tx: Sender(Int), msg: Int) -> Task(()):
    match tx:
        Sender(id) -> task.__channel_send_i64(id, msg)

pub fn __rfc0152_recv_i64(rx: Receiver(Int)) -> Task(Option(Int)):
    match rx:
        Receiver(id) -> task.__channel_recv_i64(id)

// Start `child` as a concurrent task; the returned handle completes when it does.
pub fn spawn(child: Task(())) -> Task(Handle):
    task.spawn(child)

// Wait for the spawned task behind `h` while the executor can make progress. If
// the whole executor reaches quiescence with this join parked, the close pass
// releases it even if the joined task has a continuation that will run afterward.
pub fn join(own h: Handle) -> Task(()):
    task.join(h)

// Cancel the spawned task behind `h`: it is stepped no further and is treated as
// finished, so anyone `join`ing it unblocks immediately. Cancellation is shallow -
// it stops this one task, not any tasks it itself spawned - and idempotent (already
// finished or already cancelled is a no-op). Deterministic on the cooperative
// schedule, hence byte-identical on both backends. Used by `race` to drop the loser.
pub fn cancel(own h: Handle) -> Task(()):
    task.cancel(h)

// Tail-recursive accumulator form (see `recv_n_into`): each raw spawned task
// ID is appended and the recursion continues in TAIL position, so the executor
// trampolines it at constant stack depth rather than building the O(n)-deep
// continuation the post-`concat` form did - the same stack floor that let
// `par_map`/`gather`/`scope` overflow the compiled backend (BUG-396).
fn spawn_all_into(children: List(Task(())), i: Int, own raw_handles: List(Int), finish: fn(List(Int)) -> Task(a)) -> Task(a):
    if i >= list.length(children):
        finish(raw_handles)
    else:
        and_then(task.__spawn_raw(list.at(children, i)), fn(own id): spawn_all_into(children, i + 1, appended(raw_handles, id), finish))

// Return raw task IDs for internal consumers whose next continuation must
// suspend (notably `race_n`). Its caller supplies the same `and_then` boundary
// that the former public-handle accumulator used, preserving scheduler turns.
fn spawn_all_raw(children: List(Task(())), i: Int, own raw_handles: List(Int)) -> Task(List(Int)):
    spawn_all_into(children, i, raw_handles, fn(ids): done(ids))

// Consume every public handle before the first join/cancel suspension. The
// task ID list is ordinary scalar state, so recursive scheduler continuations
// cannot hide a live `must Handle` in a cancellable frame.
fn raw_handle_ids_in_order(ids: List(Int)) -> List(Int):
    // The consuming extraction runs from the tail; retain scheduling order.
    var ordered = []
    var i = list.length(ids)
    while i > 0:
        i = i - 1
        list.push(ordered, list.at(ids, i))
    ordered

fn raw_handle_ids_collect(own hs: List(Handle), own ids: List(Int)) -> List(Int):
    match list.__pop_extract(hs):
        Some(h) -> raw_handle_ids_collect(hs, appended(ids, task.__handle_into_raw(h)))
        None -> raw_handle_ids_in_order(ids)

fn raw_handle_ids(own hs: List(Handle)) -> List(Int):
    raw_handle_ids_collect(hs, [])

// Join every handle in `hs` while the executor can make progress. Like `join`,
// quiescence releases a parked join even if a child has a continuation that will
// run afterward.
pub fn join_all(own hs: List(Handle)) -> Task(()):
    join_all_from(raw_handle_ids(hs), 0)

fn join_all_from(ids: List(Int), i: Int) -> Task(()):
    if i >= list.length(ids):
        ready_unit()
    else:
        and_then(task.__join_raw(list.at(ids, i)), fn(own _done): join_all_from(ids, i + 1))

// Cancel every handle in `hs` - the companion to `join_all`. Each is
// stopped and treated as finished; idempotent, so cancelling an already-finished
// handle is a no-op. Used by `race_n` to drop the losers.
pub fn cancel_all(own hs: List(Handle)) -> Task(()):
    cancel_all_from(raw_handle_ids(hs), 0)

fn cancel_all_from(ids: List(Int), i: Int) -> Task(()):
    if i >= list.length(ids):
        ready_unit()
    else:
        and_then(task.__cancel_raw(list.at(ids, i)), fn(own _done): cancel_all_from(ids, i + 1))

// STRUCTURED concurrency (a "nursery"): run every task in `children`
// concurrently and wait for their raw scheduler IDs while the executor can make progress.
// No public handle is created, so the normal case has no leaked tasks; if the
// whole executor reaches quiescence, the joins release just like `join`. Prefer
// this over a bare `spawn` whose handle you must remember to `join`. The children
// interleave on the cooperative executor, so a concurrent run is byte-identical
// on both backends (the parity contract). Results flow out over channels, as with
// any task (a child returns `()`).
pub fn scope(children: List(Task(()))) -> Task(()):
    spawn_all_into(children, 0, [], fn(ids): join_all_from(ids, 0))

// Receive exactly `n` messages from `rx`, in arrival order. Stops early (and
// shorter) if the channel closes first.
fn recv_n(rx: Receiver(m), n: Int) -> Task(List(m)):
    recv_n_into(rx, n, [])

// Tail-recursive accumulator form: each received message is pushed onto `acc` and
// the recursion continues in TAIL position, so the executor trampolines it at a
// constant stack depth. The earlier post-`concat` form wrapped one extra `and_then`
// around the recursion per received message, building an O(n)-deep continuation
// that overflowed the compiled backend's stack at a few thousand messages - the
// OOB trap `gather`/`par_map` hit at N≈2000 (BUG-396).
fn recv_n_into(rx: Receiver(m), n: Int, acc: List(m)) -> Task(List(m)):
    if n <= 0:
        done(acc)
    else:
        and_then(recv(rx), fn(own o):
            match o:
                Some(x) -> recv_n_into(rx, n - 1, appended(acc, x))
                None -> done(acc)
        )

// STRUCTURED fan-out-and-collect: run every task in `jobs` concurrently and return
// the results that arrive before the collecting channel quiesces. In the normal
// case every job completes and sends exactly one result. Each job produces a value
// of the message type `m` (results ride the same channels), so `gather` is the
// typed companion to `scope` - the same no-escaping-handle shape, with the results
// handed back. Results are in COMPLETION order (deterministic on the cooperative
// executor, hence byte-identical on both backends), not input order.
pub fn gather(jobs: List(Task(m))) -> Task(List(m)):
    and_then(channel(0), fn(own pair):
        let (tx, rx) = pair
        let senders = list.map(jobs, fn(j): and_then(j, fn(own r): send(tx, r)))
        and_then(scope(senders), fn(own _ignore): recv_n(rx, list.length(jobs)))
    )

// Receive one message from each receiver in `rxs`, in list order. A closed
// receiver contributes nothing (its slot is skipped). Used by `par_map` to read
// back results in INPUT order - each task owns its own channel, so the parent
// collecting channel-by-channel is independent of which task finished first.
fn recv_each(rxs: List(Receiver(m))) -> Task(List(m)):
    recv_each_into(rxs, 0, [])

// Tail-recursive accumulator form (see `recv_n_into`): indexing `rxs` and threading
// the growing result forward keeps the recursion in TAIL position, so the executor
// trampolines it at constant stack depth instead of building the O(n)-deep
// continuation that overflowed the compiled backend at N≈2000 (BUG-396).
fn recv_each_into(rxs: List(Receiver(m)), i: Int, acc: List(m)) -> Task(List(m)):
    if i >= list.length(rxs):
        done(acc)
    else:
        and_then(recv(list.at(rxs, i)), fn(own o):
            match o:
                Some(x) -> recv_each_into(rxs, i + 1, appended(acc, x))
                None -> recv_each_into(rxs, i + 1, acc)
        )

// Build one private channel per item, pairing each item's task (which sends its
// own result) with its receiver, so results can be read back in input order.
fn par_build(items: List(a), f: fn(a) -> Task(m)) -> Task((List(Task(())), List(Receiver(m)))):
    par_build_into(items, 0, f, [], [])

// Tail-recursive accumulator form (see `recv_n_into`): each opened channel appends
// its job and receiver to the accumulators and the recursion continues in TAIL
// position, so the executor trampolines it at constant stack depth. The earlier
// post-`concat` form nested an extra `and_then` per item, building the O(n)-deep
// continuation that overflowed the compiled backend at N≈2000 (BUG-396).
fn par_build_into(items: List(a), i: Int, f: fn(a) -> Task(m), jobs: List(Task(())), rxs: List(Receiver(m))) -> Task((List(Task(())), List(Receiver(m)))):
    if i >= list.length(items):
        done((jobs, rxs))
    else:
        and_then(channel(0), fn(own pair):
            let (tx, rx) = pair
            let job = and_then(f(list.at(items, i)), fn(own r): send(tx, r))
            par_build_into(items, i + 1, f, appended(jobs, job), appended(rxs, rx))
        )

// STRUCTURED parallel map (the level-1 combinator): run `f` over every item of
// `items` concurrently and return the results in INPUT order. The tasks are never
// visible - spawn and join happen inside - so this cannot leak a handle, cannot
// deadlock on a forgotten join, and is the ergonomic default for data parallelism.
// Each item's result rides its own channel, so the returned order is the input
// order regardless of completion order. `f` is an ordinary callback and may
// exercise opaque delegated effects, so ordering alone is not a purity or
// determinism contract. A future parallel backend must require an explicit
// effect-free callable contract before assuming that reordering invocations is
// unobservable (see RFC-0032). Results are of the message type `m` (they ride
// channels), as with `gather`.
// The canonical compiler currently refuses this implementation when its
// scheduler carries public task.Handle values through a task result; consuming
// aggregate extraction and cancellation disposition are still needed.
pub fn par_map(items: List(a), f: fn(a) -> Task(m)) -> Task(List(m)):
    and_then(par_build(items, f), fn(own built):
        let (jobs, rxs) = built
        and_then(scope(jobs), fn(own _ignore): recv_each(rxs))
    )

// STRUCTURED parallel reduce: `par_map` the items, then fold the results with
// `combine` starting from `init`. `combine` should be associative for the fold to
// be meaningful independent of evaluation order; the map runs concurrently while
// the fold is a deterministic left fold over the input-ordered results.
pub fn par_reduce(items: List(a), f: fn(a) -> Task(m), init: m, combine: fn(m, m) -> m) -> Task(m):
    and_then(par_map(items, f), fn(own results): done(list.fold(results, init, combine)))

// Run `a` and `b` concurrently and return the FIRST result, cancelling the loser.
// `None` only if neither ever produces a value. The winner is decided by the
// deterministic round-robin schedule (a tie favours `a`), so the outcome is
// byte-identical on both backends - and under a future parallel backend the cancel
// genuinely stops the loser's remaining work. This is the cancellation-enabled
// combinator of RFC-0032's ladder; build `timeout` by racing a task against one
// that yields a sentinel.
pub fn race(a: Task(m), b: Task(m)) -> Task(Option(m)):
    and_then(channel(0), fn(own pair):
        let (tx, rx) = pair
        and_then(task.__spawn_raw(and_then(a, fn(own ra): send(tx, ra))), fn(own ha): and_then(task.__spawn_raw(and_then(b, fn(own rb): send(tx, rb))), fn(own hb): and_then(recv(rx), fn(own o): and_then(task.__cancel_raw(ha), fn(own _x): and_then(task.__cancel_raw(hb), fn(own _y): done(o))))))
    )

// `race` generalized to a pool: run every task in `tasks` concurrently and return
// the FIRST result, cancelling all the others. `None` only if none ever produces a
// value (e.g. an empty list). The winner is fixed by the deterministic schedule, so
// the outcome is byte-identical on both backends.
pub fn race_n(tasks: List(Task(m))) -> Task(Option(m)):
    and_then(channel(0), fn(own pair):
        let (tx, rx) = pair
        let jobs = list.map(tasks, fn(t): and_then(t, fn(own r): send(tx, r)))
        and_then(spawn_all_raw(jobs, 0, []), fn(own ids): and_then(recv(rx), fn(own o): and_then(cancel_all_from(ids, 0), fn(own _x): done(o))))
    )

// The outcome of a `select`: a message from the first or the second receiver, or
// `Closed` once neither can deliver.
type Selected(m):
    First(m)
    Second(m)
    Closed

// Fixed-arity variants retain the selected arm in the public result without
// routing through `List(Receiver(m))`. They have the same deterministic
// source-order rule as `select`: lower-numbered arms win ties.
type Selected3(m):
    First3(m)
    Second3(m)
    Third3(m)
    Closed3

type Selected4(m):
    First4(m)
    Second4(m)
    Third4(m)
    Fourth4(m)
    Closed4

// Private deterministic-instrumentation marker. The compiler records this only
// in `witchy stats` builds, exactly where the ordinary adapter materializes a
// nominal selected union. Direct local result lanes do not call it.
fn __rfc0152_selected_materialized():
    ()

// Receive from whichever of `a` or `b` has a message first; a tie favours `a`.
// Yields `Closed` once both channels are closed.
pub fn select(a: Receiver(m), b: Receiver(m)) -> Task(Selected(m)):
    match a:
        Receiver(ia) ->
            match b:
                Receiver(ib) -> task.__channel_select2(ia, ib, fn(k, o): select2_result(k, o))

// Receive from the first ready receiver among `a`, `b`, and `c`. A tie is
// resolved in argument order; `Closed3` is returned only on scheduler
// quiescence after no arm can deliver.
pub fn select3(a: Receiver(m), b: Receiver(m), c: Receiver(m)) -> Task(Selected3(m)):
    match a:
        Receiver(ia) ->
            match b:
                Receiver(ib) ->
                    match c:
                        Receiver(ic) -> task.__channel_select3_map(ia, ib, ic, fn(k, o): select3_result(k, o))

// Four-way counterpart of `select3`, retaining the same deterministic
// first-ready rule and fixed endpoint ABI.
pub fn select4(a: Receiver(m), b: Receiver(m), c: Receiver(m), d: Receiver(m)) -> Task(Selected4(m)):
    match a:
        Receiver(ia) ->
            match b:
                Receiver(ib) ->
                    match c:
                        Receiver(ic) ->
                            match d:
                                Receiver(id) -> task.__channel_select4_map(ia, ib, ic, id, fn(k, o): select4_result(k, o))

pub fn select2_frame_loop(a: Receiver(m), b: Receiver(m), frame: List(Int), step: fn(Int, Option(__Msg), var List(Int)) -> Bool, done_fn: fn(List(Int)) -> Task(())) -> Task(()):
    match a:
        Receiver(ia) ->
            match b:
                Receiver(ib) -> task.channel_select2_frame_loop(ia, ib, frame, step, done_fn)

// Compiler-owned three-way frame bridge. The public spelling keeps the
// receiver ownership surface typed while task owns the fixed endpoint ids and
// deterministic source-order wake protocol.
pub fn select3_frame_loop(a: Receiver(m), b: Receiver(m), c: Receiver(m), frame: List(Int), step: fn(Int, Option(__Msg), var List(Int)) -> Bool, done_fn: fn(List(Int)) -> Task(())) -> Task(()):
    match a:
        Receiver(ia) ->
            match b:
                Receiver(ib) ->
                    match c:
                        Receiver(ic) -> task.channel_select3_frame_loop(ia, ib, ic, frame, step, done_fn)

// Compiler-owned one-way frame bridge for a payload-free receive loop. A final
// `None` is delivered exactly once by task's close pass.
pub fn recv_frame_loop(rx: Receiver(m), frame: List(Int), step: fn(Option(__Msg), var List(Int)) -> Bool, done_fn: fn(List(Int)) -> Task(())) -> Task(()):
    match rx:
        Receiver(id) -> task.channel_recv_frame_loop(id, frame, step, done_fn)

pub fn select4_frame_loop(a: Receiver(m), b: Receiver(m), c: Receiver(m), d: Receiver(m), frame: List(Int), step: fn(Int, Option(__Msg), var List(Int)) -> Bool, done_fn: fn(List(Int)) -> Task(())) -> Task(()):
    match a:
        Receiver(ia) ->
            match b:
                Receiver(ib) ->
                    match c:
                        Receiver(ic) ->
                            match d:
                                Receiver(id) -> task.channel_select4_frame_loop(ia, ib, ic, id, frame, step, done_fn)

pub fn __select2_map(a: Receiver(m), b: Receiver(m), k: fn(own Selected(m)) -> Task(n)) -> Task(n):
    match a:
        Receiver(ia) ->
            match b:
                Receiver(ib) -> task.__channel_select2_map(ia, ib, fn(tag, o): __select2_decode(k, tag, o))

fn __select2_decode(k: fn(own Selected(m)) -> Task(n), tag: Int, o: Option(__Msg)) -> Task(n):
    match o:
        Some(msg) ->
            if tag == 0:
                __rfc0152_selected_materialized()
                k(First(__unerase(msg)))
            else:
                __rfc0152_selected_materialized()
                k(Second(__unerase(msg)))
        None ->
            __rfc0152_selected_materialized()
            k(Closed)

fn select2_result(k: Int, o: Option(__Msg)) -> Task(Selected(m)):
    match o:
        Some(msg) ->
            if k == 0:
                __rfc0152_selected_materialized()
                done(First(__unerase(msg)))
            else:
                __rfc0152_selected_materialized()
                done(Second(__unerase(msg)))
        None ->
            __rfc0152_selected_materialized()
            done(Closed)

fn select3_result(k: Int, o: Option(__Msg)) -> Task(Selected3(m)):
    match o:
        Some(msg) ->
            if k == 0:
                __rfc0152_selected_materialized()
                done(First3(__unerase(msg)))
            else if k == 1:
                __rfc0152_selected_materialized()
                done(Second3(__unerase(msg)))
            else:
                __rfc0152_selected_materialized()
                done(Third3(__unerase(msg)))
        None ->
            __rfc0152_selected_materialized()
            done(Closed3)

fn select4_result(k: Int, o: Option(__Msg)) -> Task(Selected4(m)):
    match o:
        Some(msg) ->
            if k == 0:
                __rfc0152_selected_materialized()
                done(First4(__unerase(msg)))
            else if k == 1:
                __rfc0152_selected_materialized()
                done(Second4(__unerase(msg)))
            else if k == 2:
                __rfc0152_selected_materialized()
                done(Third4(__unerase(msg)))
            else:
                __rfc0152_selected_materialized()
                done(Fourth4(__unerase(msg)))
        None ->
            __rfc0152_selected_materialized()
            done(Closed4)

// Compiler-owned frame-loop bridge.  Unlike `select`, this decodes the erased
// message directly into the callback's scalar frame step, so the callback does
// not allocate a per-message Task/continuation.
pub fn select2_frame_decode(tag: Int, o: Option(__Msg)) -> Selected(m):
    match o:
        Some(msg) ->
            if tag == 0:
                __rfc0152_selected_materialized()
                First(__unerase(msg))
            else:
                __rfc0152_selected_materialized()
                Second(__unerase(msg))
        None ->
            __rfc0152_selected_materialized()
            Closed

// Three-way counterpart of `select2_frame_decode`. Escaping and complex
// matches materialize the public result; local exhaustive matches use the
// payload bridge below instead.
pub fn select3_frame_decode(tag: Int, o: Option(__Msg)) -> Selected3(m):
    match o:
        Some(msg) ->
            if tag == 0:
                First3(__unerase(msg))
            else if tag == 1:
                Second3(__unerase(msg))
            else:
                Third3(__unerase(msg))
        None -> Closed3

// Four-way frame counterpart.  This remains the ordinary nominal-result path;
// a later typed-lane extension may bypass it only for a proven local match.
pub fn select4_frame_decode(tag: Int, o: Option(__Msg)) -> Selected4(m):
    match o:
        Some(msg) ->
            if tag == 0:
                First4(__unerase(msg))
            else if tag == 1:
                Second4(__unerase(msg))
            else if tag == 2:
                Third4(__unerase(msg))
            else:
                Fourth4(__unerase(msg))
        None -> Closed4

// Compiler-owned scalar frame support. A locally consumed select result can
// dispatch on the scheduler tag and this typed payload option directly, rather
// than first allocating a `Selected(m)` value. Escaping and complex matches
// still use `select2_frame_decode` above.
pub fn select2_frame_payload(o: Option(__Msg)) -> Option(m):
    match o:
        Some(msg) -> Some(__unerase(msg))
        None -> None

// Three-way counterpart of `select2_frame_payload`; the tag remains in the
// compiler-owned step callback, so this bridge only carries typed payload.
pub fn select3_frame_payload(o: Option(__Msg)) -> Option(m):
    match o:
        Some(msg) -> Some(__unerase(msg))
        None -> None

// Four-way counterpart; source-arm identity remains in the separate tag lane.
pub fn select4_frame_payload(o: Option(__Msg)) -> Option(m):
    match o:
        Some(msg) -> Some(__unerase(msg))
        None -> None

// Receive from `rx`, run `f` on each message, until the channel closes. The
// stateless server loop; `for await x in rx:` lowers to this.
pub fn consume(rx: Receiver(m), f: fn(m) -> Task(())) -> Task(()):
    and_then(recv(rx), fn(own o):
        match o:
            Some(x) -> and_then(f(x), fn(own _u): consume(rx, f))
            None -> ready_unit()
    )

// The stateful server loop: receive a message, run `handler` with the current
// `state` to get the next state, and repeat until the channel closes. State
// threads through every message with no hand-written recursion.
pub fn serve(rx: Receiver(m), state: s, handler: fn(s, m) -> Task(s)) -> Task(()):
    and_then(recv(rx), fn(own o):
        match o:
            Some(msg) -> and_then(handler(state, msg), fn(own next): serve(rx, next, handler))
            None -> ready_unit()
    )

// Drive `root` through the canonical `std/task` executor. `chan` keeps this
// facade for channel-centric programs, but scheduling has a single implementation.
pub fn run(root: Task(())):
    task.run(root)
