// The witchy standard `Result` type and helpers. `Result`, `Ok`, and `Err` are
// prelude names and never need an import; `import result` brings in the qualified
// helper functions such as `result.map_ok`. Pure and capability-free, like every
// std module.

// For the `ok`/`err` conversions to Option.

import option

type Result:
    Ok(a)
    Err(e)

pub fn is_ok(r: Result(a, e)) -> Bool:
    match r:
        Ok(_) -> true
        Err(_) -> false

// The Ok value, or `default` if it's an Err.
pub fn unwrap_or(r: Result(a, e), default: a) -> a:
    match r:
        Ok(v) -> v
        Err(_) -> default

// Transform the Ok value, leaving an Err untouched.
pub fn map_ok(r: Result(a, e), f: fn(a) -> b) -> Result(b, e):
    match r:
        Ok(v) -> Ok(f(v))
        Err(x) -> Err(x)

// True if the result is an Err.
pub fn is_err(r: Result(a, e)) -> Bool:
    match r:
        Ok(_) -> false
        Err(_) -> true

// Chain a fallible step: apply `f` (which itself yields a Result) to the Ok
// value, or propagate the Err unchanged.
pub fn and_then(r: Result(a, e), f: fn(a) -> Result(b, e)) -> Result(b, e):
    match r:
        Ok(v) -> f(v)
        Err(x) -> Err(x)

// Transform the Err value, leaving an Ok untouched.
pub fn map_err(r: Result(a, e), f: fn(e) -> g) -> Result(a, g):
    match r:
        Ok(v) -> Ok(v)
        Err(x) -> Err(f(x))

// The Err value, or `default` if it's Ok. This is the error-side counterpart of
// `unwrap_or`: it is a defaulting helper, not a strict assertion that `r` is Err.
pub fn unwrap_err_or(r: Result(a, e), default: e) -> e:
    match r:
        Ok(_) -> default
        Err(x) -> x

// Compatibility alias for `unwrap_err_or`. Prefer `unwrap_err_or` in new code so
// the defaulting behavior is visible at the call site.
pub fn unwrap_err(r: Result(a, e), default: e) -> e:
    unwrap_err_or(r, default)

// The Ok value, or the result of calling `f` (a lazily-computed default).
pub fn unwrap_or_else(r: Result(a, e), f: fn() -> a) -> a:
    match r:
        Ok(v) -> v
        Err(_) -> f()

// The result if it is Ok, otherwise the `alt` result.
pub fn or(r: Result(a, e), alt: Result(a, e)) -> Result(a, e):
    match r:
        Ok(v) -> Ok(v)
        Err(_) -> alt

// The result if it is Ok, otherwise the result produced by applying `f` to the
// error — a lazy, error-aware recovery step.
pub fn or_else(r: Result(a, e), f: fn(e) -> Result(a, e)) -> Result(a, e):
    match r:
        Ok(v) -> Ok(v)
        Err(x) -> f(x)

// Apply `f` to the Ok value, or return `default` for an Err — `map_ok` then
// `unwrap_or` in one step.
pub fn map_or(r: Result(a, e), default: b, f: fn(a) -> b) -> b:
    match r:
        Ok(v) -> f(v)
        Err(_) -> default

// Collapse one layer of nesting: `Ok(Ok(v))` becomes `Ok(v)`; `Ok(Err(e))` and
// `Err(e)` become `Err(e)`. The Result counterpart of `option.flatten`.
pub fn flatten(rr: Result(Result(a, e), e)) -> Result(a, e):
    match rr:
        Ok(inner) -> inner
        Err(x) -> Err(x)

// The Ok value as `Some`, or `None` for an Err — discards the error, turning a
// Result into an Option.
pub fn ok(r: Result(a, e)) -> Option(a):
    match r:
        Ok(v) -> Some(v)
        Err(_) -> None

// The Err value as `Some`, or `None` for an Ok.
pub fn err(r: Result(a, e)) -> Option(e):
    match r:
        Ok(_) -> None
        Err(x) -> Some(x)

// Collect a list of Results into a Result of the list: `Ok` of every value in
// order, or the first `Err` encountered (the "sequence" of fallible steps).
pub fn all(xs: List(Result(a, e))) -> Result(List(a), e):
    var acc = Ok([])
    for x in xs:
        acc = combine(acc, x)
    acc

fn combine(acc: Result(List(a), e), x: Result(a, e)) -> Result(List(a), e):
    match acc:
        Err(e) -> Err(e)
        Ok(vs) ->
            match x:
                Ok(v) -> Ok(list.push(vs, v))
                Err(e) -> Err(e)

// Split a list of Results into the Ok values and the Err values, each in order —
// for batch work that reports every failure, not just the first.
pub fn partition(xs: List(Result(a, e))) -> (List(a), List(e)):
    var acc = ([], [])
    for x in xs:
        acc = partition_step(acc, x)
    acc

fn partition_step(acc: (List(a), List(e)), x: Result(a, e)) -> (List(a), List(e)):
    let (oks, errs) = acc
    match x:
        Ok(v) -> (list.push(oks, v), errs)
        Err(er) -> (oks, list.push(errs, er))
