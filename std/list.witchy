// The witchy standard list library. Every function here is pure: the module
// declares no capability parameters, so importing it grants no authority — it
// can only transform data. This is the capability model in miniature: a library
// you didn't hand a Console/Dir/Net to literally cannot reach them.

// `Option` powers the total lookups below (head/last/get/find): a missing
// element is `None`, never an out-of-bounds trap.
import option

// [0, 1, ..., n-1].
pub fn range(n: Int) -> List(Int) {
  var out = []
  var i = 0
  while i < n {
    out = push(out, i)
    i = i + 1
  }
  out
}

// Apply `f` to every element, collecting the results.
pub fn map(xs: List(a), f: fn(a) -> b) -> List(b) {
  var out = []
  for x in xs {
    out = push(out, f(x))
  }
  out
}

// Keep only the elements for which `keep` returns true.
pub fn filter(xs: List(a), keep: fn(a) -> Bool) -> List(a) {
  var out = []
  for x in xs {
    if keep(x) {
      out = push(out, x)
    }
  }
  out
}

// Split `xs` into (matching, non-matching) by `pred`, each preserving the
// original order. A single pass — the dual of running `filter` twice.
pub fn partition(xs: List(a), pred: fn(a) -> Bool) -> (List(a), List(a)) {
  var yes = []
  var no = []
  for x in xs {
    if pred(x) {
      yes = push(yes, x)
    } else {
      no = push(no, x)
    }
  }
  (yes, no)
}

// Reduce the list to a single value, left to right.
pub fn fold(xs: List(a), init: b, f: fn(b, a) -> b) -> b {
  var acc = init
  for x in xs {
    acc = f(acc, x)
  }
  acc
}

// The sum of a list of integers (0 for the empty list).
pub fn sum(xs: List(Int)) -> Int {
  var total = 0
  for x in xs {
    total = total + x
  }
  total
}

// The product of a list of integers (1 for the empty list).
pub fn product(xs: List(Int)) -> Int {
  var p = 1
  for x in xs {
    p = p * x
  }
  p
}

// Like `fold`, but collect every intermediate accumulator left to right,
// starting from `init`: scan([1,2,3], 0, +) -> [0, 1, 3, 6].
pub fn scan(xs: List(a), init: b, f: fn(b, a) -> b) -> List(b) {
  var acc = init
  var out = [init]
  for x in xs {
    acc = f(acc, x)
    out = push(out, acc)
  }
  out
}

// Whether the list has no elements.
pub fn is_empty(xs: List(a)) -> Bool {
  length(xs) == 0
}

// The first element, or `default` when the list is empty. (A total accessor in
// the style of `get_or`/`unwrap_or`, so it never indexes out of bounds.)
pub fn head_or(xs: List(a), default: a) -> a {
  if is_empty(xs) {
    default
  } else {
    at(xs, 0)
  }
}

// The last element, or `default` when the list is empty.
pub fn last_or(xs: List(a), default: a) -> a {
  if is_empty(xs) {
    default
  } else {
    at(xs, length(xs) - 1)
  }
}

// The first element satisfying `pred`, or `default` if none do.
pub fn find_or(xs: List(a), pred: fn(a) -> Bool, default: a) -> a {
  for x in xs {
    if pred(x) {
      return x
    }
  }
  default
}

// The first element as `Some`, or `None` for the empty list.
pub fn head(xs: List(a)) -> Option(a) {
  if is_empty(xs) {
    None
  } else {
    Some(at(xs, 0))
  }
}

// The last element as `Some`, or `None` for the empty list.
pub fn last(xs: List(a)) -> Option(a) {
  if is_empty(xs) {
    None
  } else {
    Some(at(xs, length(xs) - 1))
  }
}

// The element at index `i` as `Some`, or `None` when `i` is out of range — a
// total, bounds-checked alternative to the `at` builtin.
pub fn get(xs: List(a), i: Int) -> Option(a) {
  if i >= 0 && i < length(xs) {
    Some(at(xs, i))
  } else {
    None
  }
}

// The first element satisfying `pred` as `Some`, or `None` if none do.
pub fn find(xs: List(a), pred: fn(a) -> Bool) -> Option(a) {
  for x in xs {
    if pred(x) {
      return Some(x)
    }
  }
  None
}

// The smallest element as `Some`, or `None` for the empty list.
pub fn min(xs: List(Int)) -> Option(Int) {
  if is_empty(xs) {
    None
  } else {
    var m = at(xs, 0)
    for x in xs {
      if x < m {
        m = x
      }
    }
    Some(m)
  }
}

// The largest element as `Some`, or `None` for the empty list.
pub fn max(xs: List(Int)) -> Option(Int) {
  if is_empty(xs) {
    None
  } else {
    var m = at(xs, 0)
    for x in xs {
      if x > m {
        m = x
      }
    }
    Some(m)
  }
}

// The index of the first element equal to `target` as `Some`, or `None` — the
// Option-returning companion to `index_of` (which uses a -1 sentinel).
pub fn position(xs: List(a), target: a) -> Option(Int) {
  var i = 0
  for x in xs {
    if x == target {
      return Some(i)
    }
    i = i + 1
  }
  None
}

// Concatenate a list of lists into one.
pub fn flatten(xss: List(List(a))) -> List(a) {
  var out = []
  for xs in xss {
    out = concat(out, xs)
  }
  out
}

// Map each element to a list, then concatenate the results.
pub fn flat_map(xs: List(a), f: fn(a) -> List(b)) -> List(b) {
  var out = []
  for x in xs {
    out = concat(out, f(x))
  }
  out
}

// How many elements satisfy `pred`.
pub fn count(xs: List(a), pred: fn(a) -> Bool) -> Int {
  var n = 0
  for x in xs {
    if pred(x) {
      n = n + 1
    }
  }
  n
}

// The longest leading run of elements satisfying `pred`.
pub fn take_while(xs: List(a), pred: fn(a) -> Bool) -> List(a) {
  var out = []
  var taking = true
  for x in xs {
    if taking {
      if pred(x) {
        out = push(out, x)
      } else {
        taking = false
      }
    }
  }
  out
}

// Drop the longest leading run satisfying `pred`, keeping the rest.
pub fn drop_while(xs: List(a), pred: fn(a) -> Bool) -> List(a) {
  var out = []
  var dropping = true
  for x in xs {
    if dropping {
      if !pred(x) {
        dropping = false
        out = push(out, x)
      }
    } else {
      out = push(out, x)
    }
  }
  out
}

// A list of `n` copies of `x` (empty when `n <= 0`).
pub fn repeat(x: a, n: Int) -> List(a) {
  var out = []
  var i = 0
  while i < n {
    out = push(out, x)
    i = i + 1
  }
  out
}

// Index of the first element satisfying `pred`, or -1 if none do. (Like
// `index_of`, but matching by predicate rather than value equality.)
pub fn find_index(xs: List(a), pred: fn(a) -> Bool) -> Int {
  var i = 0
  for x in xs {
    if pred(x) {
      return i
    }
    i = i + 1
  }
  0 - 1
}

// Combine two lists element-wise with `f`, stopping at the shorter one.
pub fn zip_with(xs: List(a), ys: List(b), f: fn(a, b) -> c) -> List(c) {
  var out = []
  var i = 0
  while i < length(xs) && i < length(ys) {
    out = push(out, f(at(xs, i), at(ys, i)))
    i = i + 1
  }
  out
}

// Insert `sep` between adjacent elements: [a, b, c] -> [a, sep, b, sep, c].
pub fn intersperse(xs: List(a), sep: a) -> List(a) {
  var out = []
  var first = true
  for x in xs {
    if first {
      out = push(out, x)
      first = false
    } else {
      out = push(out, sep)
      out = push(out, x)
    }
  }
  out
}

// The list, reversed.
pub fn reverse(xs: List(a)) -> List(a) {
  var out = []
  for x in xs {
    out = concat([x], out)
  }
  out
}

// Insert `x` into an already-sorted list, keeping it ordered by `less`.
fn insert_sorted(xs: List(a), x: a, less: fn(a, a) -> Bool) -> List(a) {
  var out = []
  var placed = false
  for y in xs {
    if placed {
      out = push(out, y)
    } else {
      if less(x, y) {
        out = push(out, x)
        out = push(out, y)
        placed = true
      } else {
        out = push(out, y)
      }
    }
  }
  if placed {
    out
  } else {
    push(out, x)
  }
}

// Sort using a caller-supplied "is-less-than" comparator (insertion sort, so
// the order of equal elements is preserved). Generic over the element type.
pub fn sort_by(xs: List(a), less: fn(a, a) -> Bool) -> List(a) {
  var out = []
  for x in xs {
    out = insert_sorted(out, x, less)
  }
  out
}

// Whether `target` appears in the list (by value equality).
pub fn contains(xs: List(a), target: a) -> Bool {
  for x in xs {
    if x == target {
      return true
    }
  }
  false
}

// Whether at least one element satisfies `pred`.
pub fn any(xs: List(a), pred: fn(a) -> Bool) -> Bool {
  for x in xs {
    if pred(x) {
      return true
    }
  }
  false
}

// Whether every element satisfies `pred` (true for the empty list).
pub fn all(xs: List(a), pred: fn(a) -> Bool) -> Bool {
  for x in xs {
    if !pred(x) {
      return false
    }
  }
  true
}

// Index of the first element equal to `target`, or -1 if absent.
pub fn index_of(xs: List(a), target: a) -> Int {
  var i = 0
  for x in xs {
    if x == target {
      return i
    }
    i = i + 1
  }
  0 - 1
}

// The first `n` elements (fewer if the list is shorter).
pub fn take(xs: List(a), n: Int) -> List(a) {
  var out = []
  var i = 0
  for x in xs {
    if i < n {
      out = push(out, x)
    }
    i = i + 1
  }
  out
}

// All but the first `n` elements.
pub fn drop(xs: List(a), n: Int) -> List(a) {
  var out = []
  var i = 0
  for x in xs {
    if i >= n {
      out = push(out, x)
    }
    i = i + 1
  }
  out
}

// All elements after the first; the empty list maps to the empty list.
pub fn tail(xs: List(a)) -> List(a) {
  drop(xs, 1)
}

// All elements except the last; the empty list maps to the empty list.
pub fn init(xs: List(a)) -> List(a) {
  take(xs, length(xs) - 1)
}

// Split `xs` into consecutive sublists of length `n` (the final one may be
// shorter). `chunks([1,2,3,4,5], 2)` is `[[1,2],[3,4],[5]]`.
pub fn chunks(xs: List(a), n: Int) -> List(List(a)) {
  var out = []
  var cur = []
  var count = 0
  for x in xs {
    cur = push(cur, x)
    count = count + 1
    if count == n {
      out = push(out, cur)
      cur = []
      count = 0
    }
  }
  if count > 0 {
    out = push(out, cur)
  }
  out
}

// The elements in the half-open index range [start, end), clamped to bounds.
// `slice(xs, 1, 3)` of [a,b,c,d] is [b,c].
pub fn slice(xs: List(a), start: Int, end: Int) -> List(a) {
  var out = []
  var i = 0
  for x in xs {
    if i >= start && i < end {
      out = push(out, x)
    }
    i = i + 1
  }
  out
}

// Pair up two lists element-wise, stopping at the shorter one.
pub fn zip(xs: List(a), ys: List(b)) -> List((a, b)) {
  var out = []
  var i = 0
  while i < length(xs) && i < length(ys) {
    out = push(out, (at(xs, i), at(ys, i)))
    i = i + 1
  }
  out
}

// Split a list of pairs into a pair of lists — the inverse of `zip`.
pub fn unzip(xs: List((a, b))) -> (List(a), List(b)) {
  var firsts = []
  var seconds = []
  for x in xs {
    let (a, b) = x
    firsts = push(firsts, a)
    seconds = push(seconds, b)
  }
  (firsts, seconds)
}

// Pair each element with its index: `[a, b]` -> `[(0, a), (1, b)]`.
pub fn enumerate(xs: List(a)) -> List((Int, a)) {
  var out = []
  var i = 0
  for x in xs {
    out = push(out, (i, x))
    i = i + 1
  }
  out
}
