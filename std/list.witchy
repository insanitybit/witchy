// The witchy standard list library. Every function here is pure: the module
// declares no capability parameters, so importing it grants no authority — it
// can only transform data. This is the capability model in miniature: a library
// you didn't hand a Console/Dir/Net to literally cannot reach them.

// [0, 1, ..., n-1].
pub fn range(n: Int) -> List(Int) {
  var out = []
  var i = 0
  while i < n {
    out = push(out, i)
    i = i + 1
  }
  out
}

// Apply `f` to every element, collecting the results.
pub fn map(xs: List(a), f: fn(a) -> b) -> List(b) {
  var out = []
  for x in xs {
    out = push(out, f(x))
  }
  out
}

// Keep only the elements for which `keep` returns true.
pub fn filter(xs: List(a), keep: fn(a) -> Bool) -> List(a) {
  var out = []
  for x in xs {
    if keep(x) {
      out = push(out, x)
    }
  }
  out
}

// Reduce the list to a single value, left to right.
pub fn fold(xs: List(a), init: b, f: fn(b, a) -> b) -> b {
  var acc = init
  for x in xs {
    acc = f(acc, x)
  }
  acc
}

// The list, reversed.
pub fn reverse(xs: List(a)) -> List(a) {
  var out = []
  for x in xs {
    out = concat([x], out)
  }
  out
}

// Insert `x` into an already-sorted list, keeping it ordered by `less`.
fn insert_sorted(xs: List(a), x: a, less: fn(a, a) -> Bool) -> List(a) {
  var out = []
  var placed = false
  for y in xs {
    if placed {
      out = push(out, y)
    } else {
      if less(x, y) {
        out = push(out, x)
        out = push(out, y)
        placed = true
      } else {
        out = push(out, y)
      }
    }
  }
  if placed {
    out
  } else {
    push(out, x)
  }
}

// Sort using a caller-supplied "is-less-than" comparator (insertion sort, so
// the order of equal elements is preserved). Generic over the element type.
pub fn sort_by(xs: List(a), less: fn(a, a) -> Bool) -> List(a) {
  var out = []
  for x in xs {
    out = insert_sorted(out, x, less)
  }
  out
}

// Whether `target` appears in the list (by value equality).
pub fn contains(xs: List(a), target: a) -> Bool {
  for x in xs {
    if x == target {
      return true
    }
  }
  false
}

// Whether at least one element satisfies `pred`.
pub fn any(xs: List(a), pred: fn(a) -> Bool) -> Bool {
  for x in xs {
    if pred(x) {
      return true
    }
  }
  false
}

// Whether every element satisfies `pred` (true for the empty list).
pub fn all(xs: List(a), pred: fn(a) -> Bool) -> Bool {
  for x in xs {
    if !pred(x) {
      return false
    }
  }
  true
}

// Index of the first element equal to `target`, or -1 if absent.
pub fn index_of(xs: List(a), target: a) -> Int {
  var i = 0
  for x in xs {
    if x == target {
      return i
    }
    i = i + 1
  }
  0 - 1
}

// The first `n` elements (fewer if the list is shorter).
pub fn take(xs: List(a), n: Int) -> List(a) {
  var out = []
  var i = 0
  for x in xs {
    if i < n {
      out = push(out, x)
    }
    i = i + 1
  }
  out
}

// All but the first `n` elements.
pub fn drop(xs: List(a), n: Int) -> List(a) {
  var out = []
  var i = 0
  for x in xs {
    if i >= n {
      out = push(out, x)
    }
    i = i + 1
  }
  out
}

// Pair up two lists element-wise, stopping at the shorter one.
pub fn zip(xs: List(a), ys: List(b)) -> List((a, b)) {
  var out = []
  var i = 0
  while i < length(xs) && i < length(ys) {
    out = push(out, (at(xs, i), at(ys, i)))
    i = i + 1
  }
  out
}

// Pair each element with its index: `[a, b]` -> `[(0, a), (1, b)]`.
pub fn enumerate(xs: List(a)) -> List((Int, a)) {
  var out = []
  var i = 0
  for x in xs {
    out = push(out, (i, x))
    i = i + 1
  }
  out
}
