// The region workload: per-iteration garbage reclaimed by `region:`.
fn main(console: Console):
    var total = 0
    var keep = []
    for i in 0..20000:
        let last = region -> Int:
            var row = []
            var j = 0
            for j in 0..500:
                row = list.push(row, j * 3)
            list.at(row, 499)
        total = total + last
        keep = list.push(keep, i)
    print(console, to_string(total))
