mode opt

type Token packed:
    Skip
    Value(Int)

fn main(console: Console, clock: Clock):
    let bench_t0 = clock.now_monotonic()
    var total = 0
    for i in 0..500000:
        let token = if i % 3 == 0: Skip else: Value((i * 7 + 3) % 101)
        match token:
            Skip -> total = total + 1
            Value(value) -> total = total + value
    let bench_t1 = clock.now_monotonic()
    console.print("result=${total}")
    console.print("bench_ns=${bench_t1 - bench_t0}")
