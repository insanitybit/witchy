// The same workload WITHOUT `region:` — the outer `keep` list pins the loop
// (no automatic reset), so garbage accumulates until the memory cap.
fn run_one(i: Int) -> Int:
    var row = []
    var j = 0
    for j in 0..500:
        row = list.push(row, j * 3)
    list.at(row, 499)

fn main(console: Console):
    var total = 0
    var keep = []
    for i in 0..20000:
        total = total + run_one(i)
        keep = list.push(keep, i)
    print(console, to_string(total))
