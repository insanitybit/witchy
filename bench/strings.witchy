// String building: the NAIVE accumulate form — the compiler's linear-update
// rewrite is what makes it builder-class.
fn main(console: Console, clock: Clock):
    let bench_t0 = clock.now_monotonic()
    var s = ""
    for i in 0..20000:
        s = s + "ab"
    let bench_t1 = clock.now_monotonic()
    console.print("${string.length(s)}")
    console.print("bench_ns=${bench_t1 - bench_t0}")
