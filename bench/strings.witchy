// String building: the NAIVE accumulate form — the compiler's linear-update
// rewrite is what makes it builder-class.
fn main(console: Console, clock: Clock):
    let bench_t0 = now_monotonic(clock)
    var s = ""
    for i in 0..20000:
        s = s + "ab"
    let bench_t1 = now_monotonic(clock)
    print(console, "${string.length(s)}")
    print(console, "bench_ns=${bench_t1 - bench_t0}")
