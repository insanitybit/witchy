// Compiler-owned data adapter. Reuse Grimoire's offline rules; no capabilities,
// network freshness, user source, claimed owners, or admission receipts enter.

import gm_core
import crypto
import coven_artifact
import semver
import json
import list

fn verified_source(lock: String, alias: String, record_text: String, paths: List(String), contents: List(String)) -> Result((String, String, String), String):
    let trust = gm_core.pinned_registry_trust(lock).map_err(fn(e: gm_core.LockPinError): e.show())?
    let rootpub = match trust:
        None -> return Err("registry lock has no pinned root")
        Some(pair) -> pair.1

    var aliases: List(String) = []
    var selected: Option((String, String, String)) = None
    let entries = gm_core.lock_rune_entries(lock).map_err(fn(e: gm_core.LockIntegrityError): e.show())?
    for entry in entries:
        if gm_core.entry_source(entry) == Some("coven"):
            let local = gm_core.entry_alias(entry)
            if local.is_empty() || aliases.contains(local):
                return Err("registry lock has empty or duplicate alias")
            aliases.push(local)
            if local == alias:
                let name = gm_core.required_lock_field(entry, "name").map_err(fn(e: gm_core.LockIntegrityError): e.show())?
                let version = gm_core.required_lock_field(entry, "version").map_err(fn(e: gm_core.LockIntegrityError): e.show())?
                let hash = gm_core.required_lock_field(entry, "hash").map_err(fn(e: gm_core.LockIntegrityError): e.show())?
                let _ = gm_core.verify_record_signature(rootpub, record_text).map_err(fn(e: gm_core.RecordVerifyError): e.show())?
                let record = gm_core.parse_vendored_record(record_text).map_err(fn(e: gm_core.VendoredRecordError): e.show())?
                if record.name != name || record.version != version || record.hash != hash:
                    return Err("registry signed record differs from locked coordinate/hash")
                if paths.length() != contents.length() || crypto.rune_hash(paths, contents) != hash:
                    return Err("registry source hash differs from signed lock")
                selected = Some((rootpub, name, version))
    match selected:
        Some(owner) -> Ok(owner)
        None -> Err("registry alias is not pinned in lock")

pub fn verify_source(lock: String, alias: String, record_text: String, paths: List(String), contents: List(String)) -> List(String):
    match verified_source(lock, alias, record_text, paths, contents):
        Ok(owner) -> ["ok", owner.0, owner.1, owner.2]
        Err(message) -> ["error", message, "", ""]

fn verified_precompiled(lock: String, alias: String, record_text: String, manifest_text: String, module: String, requirement: String) -> Result((String, String, String, String, String, String, String), String):
    let trust = gm_core.pinned_registry_trust(lock).map_err(fn(e: gm_core.LockPinError): e.show())?
    let rootpub = match trust:
        None -> return Err("registry lock has no pinned root")
        Some(pair) -> pair.1

    let entries = gm_core.lock_rune_entries(lock).map_err(fn(e: gm_core.LockIntegrityError): e.show())?
    var aliases: List(String) = []
    for entry in entries:
        if gm_core.entry_source(entry) == Some("coven"):
            let local = gm_core.entry_alias(entry)
            if local.is_empty() || aliases.contains(local):
                return Err("registry lock has empty or duplicate alias")
            aliases.push(local)
            if local == alias:
                let name = gm_core.required_lock_field(entry, "name").map_err(fn(e: gm_core.LockIntegrityError): e.show())?
                let version = gm_core.required_lock_field(entry, "version").map_err(fn(e: gm_core.LockIntegrityError): e.show())?
                let kind = gm_core.required_lock_field(entry, "kind").map_err(fn(e: gm_core.LockIntegrityError): e.show())?
                let locked_module = gm_core.required_lock_field(entry, "module").map_err(fn(e: gm_core.LockIntegrityError): e.show())?
                let locked_artifact = gm_core.required_lock_field(entry, "artifact_digest").map_err(fn(e: gm_core.LockIntegrityError): e.show())?
                if kind != "precompiled":
                    return Err("registry lock kind does not select a precompiled dependency")
                if locked_module != module:
                    return Err("registry lock module differs from its precompiled dependency declaration")
                if gm_core.entry_hash(entry) != "(no-hash)":
                    return Err("precompiled registry lock must not carry a source hash")
                let signed = gm_core.verify_record_signature(rootpub, record_text).map_err(fn(e: gm_core.RecordVerifyError): e.show())?
                let record = gm_core.parse_vendored_record(record_text).map_err(fn(e: gm_core.VendoredRecordError): e.show())?
                if record.state != "released":
                    return Err("precompiled registry dependency must be released")
                if record.name != name || record.version != version:
                    return Err("registry signed record differs from locked coordinate")
                let requirement = semver.parse_req_string(requirement).map_err(fn(e: String): "precompiled dependency has malformed version requirement: " + e)?
                let locked_version = semver.parse_string(version).map_err(fn(e: String): "precompiled registry lock has malformed version: " + e)?
                if !semver.matches(requirement, locked_version):
                    return Err("precompiled registry lock version does not satisfy its manifest requirement")
                let artifact_digest = gm_core.jget(signed, "artifact_digest")
                if artifact_digest.is_empty():
                    return Err("registry signed record has no precompiled artifact manifest digest")
                if artifact_digest != locked_artifact:
                    return Err("registry lock artifact digest differs from the signed record")
                let manifest = coven_artifact.parse(manifest_text).map_err(fn(e: coven_artifact.ArtifactError): e.show())?
                if manifest.version != 3:
                    return Err("precompiled registry dependency requires a v3 signed artifact manifest")
                if coven_artifact.manifest_digest(manifest) != locked_artifact:
                    return Err("precompiled artifact manifest differs from locked signed digest")
                let library = match coven_artifact.select_precompiled_library(manifest, module):
                    None -> return Err("signed artifact manifest has no selected precompiled library module")
                    Some(library) -> library
                return Ok((rootpub, name, version, library.wasm_sha256, library.opt_callable_export_sha256, "${library.wasm_size}", "${library.opt_callable_export_size}"))
    Err("registry alias is not pinned in lock")

pub fn verify_precompiled(lock: String, alias: String, record_text: String, manifest_text: String, module: String, requirement: String) -> List(String):
    match verified_precompiled(lock, alias, record_text, manifest_text, module, requirement):
        Ok(library) -> ["ok", library.0, library.1, library.2, library.3, library.4, library.5, library.6]
        Err(message) -> ["error", message, "", "", "", "", "", ""]

fn main(console: Console, args: List(String)):
    let result = if args.at(0) == "source":
        let count = (args.length() - 4) / 2
        verify_source(args.at(1), args.at(2), args.at(3),
            list.slice(args, 4, 4 + count), list.slice(args, 4 + count, args.length()))
    else if args.at(0) == "precompiled":
        verify_precompiled(args.at(1), args.at(2), args.at(3),
            args.at(4), args.at(5), args.at(6))
    else:
        ["error", "unknown registry verifier mode"]
    console.print(json.stringify(result))
