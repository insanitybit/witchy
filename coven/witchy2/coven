def shipped_module(filename, digest, module_name, description):
    """Only execute companion bytes from this installation matching the embedded digest."""
    import types
    if module_name not in sys.modules:
        path = HERE / filename
        source = path.read_bytes()
        if hashlib.sha384(source).hexdigest() != digest:
            raise OSError(f"{path} differs from the {description} shipped with this launcher")
        module = types.ModuleType(module_name)
        module.__file__ = str(path)
        exec(compile(source, str(path), "exec"), module.__dict__)
        sys.modules.setdefault(module_name, module)
    return sys.modules[module_name]


def compiler_client():
    return shipped_module("witchy_compiler.py", COMPILER_CLIENT_DIGEST, COMPILER_CLIENT_MODULE, "compiler client")


def release_format():
    return shipped_module("witchy_release.py", RELEASE_FORMAT_DIGEST, "_witchy_release_" + RELEASE_FORMAT_DIGEST, "release codec")


def toolchain_environment():
    return {key: value for key, value in os.environ.items() if key in TOOLCHAIN_ENVIRONMENT}


_COMPILER_DIGEST = {}
# Each Coven source's bytes as last read, under the file's identity then (device, inode, size,
# modification and change times): read again whenever any of them differs.
_SOURCES = {}


def _source_bytes(source):
    status = source.stat()
    identity = (status.st_dev, status.st_ino, status.st_size, status.st_mtime_ns, status.st_ctime_ns)
    known = _SOURCES.get(source)
    if known is None or known[0] != identity:
        known = _SOURCES[source] = (identity, source.read_bytes())
    return known[1]


def _compiler_digest(compiler, identity):
    key = compiler, identity
    if key not in _COMPILER_DIGEST:
        with open(compiler, "rb") as stream:
            digest = hashlib.file_digest(stream, "sha384").hexdigest()
            if compiler_client().executable_identity(os.fstat(stream.fileno())) != identity:
                raise CovenError("selected compiler changed during cache lookup")
            _COMPILER_DIGEST[key] = digest
    return _COMPILER_DIGEST[key]


def _toolchain_key(operation, program, *parts):
    """Cache compiler results only with the compiler's identity for its full input graph."""
    compiler = tool("WITCHYC", "witchyc")
    client = compiler_client()
    identity = client.executable_identity(os.stat(compiler))
    env = toolchain_environment()
    selected = client.selected(compiler, env)
    if selected is not None and selected.identity != identity:
        raise CovenError("selected compiler changed during cache lookup")
    binding = env.get("WITCHY_WASM_READY_BINDING")
    if binding:
        binding = Path(binding)
        if not binding.is_absolute() or binding.resolve() != binding:
            raise CovenError("proof toolchain selection must be an absolute canonical path")
        binding_bytes = _source_bytes(binding)
    if selected is None or sys.platform != "darwin":
        return None, None, selected

    key = hashlib.sha384()
    def field(value):
        data = value if isinstance(value, bytes) else str(value).encode()
        key.update(len(data).to_bytes(8, "big"))
        key.update(data)
    field(_compiler_digest(compiler, identity))
    for k, v in sorted(env.items()):
        if k.startswith("WITCHY_") and k != "WITCHY_WASMTIME_HOST":
            field(k)
            field(v)
    if binding:
        field(binding_bytes)
    for part in (operation, program, *parts):
        field(part)
    status, graph, error, _ = selected.request(["input-key", HERE / f"{program}.wy"])
    if status:
        raise CovenError(error.strip())
    field(graph)
    return key.hexdigest(), graph, selected


@contextlib.contextmanager
def _cache_directory(enabled=True):
    """This user's own cache directory for Coven's compiler results, held by one descriptor (no
    link followed), so the directory checked is the one read and written (automated review of
    3ca8a3f); None if it is anyone else's or writable by anyone else."""
    if not enabled:
        yield None
        return
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "coven" / "modules"
    held = None
    try:
        try:
            held = os.open(cache, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        except FileNotFoundError:
            cache.mkdir(parents=True, exist_ok=True, mode=0o700)
            held = os.open(cache, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        status = os.fstat(held)
        # An access control list can let others write in it whatever its mode says, and is
        # inherited by every entry made in it (review of 7d40fde: macOS `chmod +a`).
        if status.st_uid != os.getuid() or status.st_mode & 0o077 or extended_acl(held):
            os.close(held)
            held = None
    except OSError:
        if held is not None:
            os.close(held)
        held = None
    try:
        yield held
    finally:
        if held is not None:
            os.close(held)


def _cache_get(held, name):
    """The entry `name`, only if it is a regular file of this user's that no one else can write: one
    link, no group or other bits, no access control list. Opened without blocking (a FIFO planted
    under its name would hang the open; review of 7d40fde)."""
    if held is None:
        return None
    try:
        handle = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=held)
        with os.fdopen(handle, "rb") as stream:
            status = os.fstat(stream.fileno())
            if not stat.S_ISREG(status.st_mode) or status.st_uid != os.getuid() or status.st_nlink != 1 \
                    or status.st_mode & 0o077 or extended_acl(stream.fileno()):
                return None
            return stream.read()
    except OSError:
        return None


def _cache_put(held, name, data):
    if held is None:
        return
    staged = f".{name}.{secrets.token_hex(8)}"
    try:
        handle = os.open(staged, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600, dir_fd=held)
        with os.fdopen(handle, "wb") as stream:
            stream.write(data)
        os.replace(staged, name, src_dir_fd=held, dst_dir_fd=held)
    except OSError:
        try:
            os.unlink(staged, dir_fd=held)
        except OSError:
            pass


@contextlib.contextmanager
def _build_owner(held, name):
    """Coordinate one missing content key. Only the validated cache entry can supply bytes."""
    if held is None:
        yield
        return
    handle = None
    try:
        try:
            handle = os.open(name + ".lock", os.O_CREAT | os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                             0o600, dir_fd=held)
            mode = os.fstat(handle)
            if stat.S_ISREG(mode.st_mode) and mode.st_uid == os.getuid() and mode.st_nlink == 1 and not mode.st_mode & 0o077:
                deadline = time.monotonic() + 4
                while True:
                    try:
                        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                        break
                    except BlockingIOError:
                        if time.monotonic() >= deadline:
                            break
                        time.sleep(0.01)
        except OSError:
            pass
        yield
    finally:
        if handle is not None:
            os.close(handle)


def build_module(program, module, extra=(), *, key=None):
    """Build Coven's own `program` into `module`, through a per-user cache: Coven runs the same few
    programs on every command. A cached module stands only for exactly what built it
    (`_toolchain_key`); entries are written whole and renamed into place."""
    digest, graph, compiler = key or _toolchain_key("build", program, *extra)
    name = digest + ".wasm" if digest is not None else None
    with _cache_directory(name is not None) as held:
        cached = _cache_get(held, name)
        if cached is not None:
            Path(module).write_bytes(cached)
            return
        with _build_owner(held, name):
            cached = _cache_get(held, name)
            if cached is not None:
                Path(module).write_bytes(cached)
                return
            built = compiler_client().run([tool("WITCHYC", "witchyc"), "build", HERE / f"{program}.wy", "-o", module, *extra],
                                   capture_output=True, text=True, env=toolchain_environment(), input_key=graph, selected_compiler=compiler)
            if built.returncode:
                raise CovenError(f"{program}: does not build: {built.stderr.strip()}")
            if held is not None:
                _cache_put(held, name, Path(module).read_bytes())


def grant_flags(program, document, text):
    """The host flags `wasm-grants` proposes for Coven's `program` under the grants `text`,
    through the same per-user cache: the check's result for exactly this compiler, these sources
    and this document's bytes (a document naming fresh temporary paths simply misses). The
    document is written to `document`, and checked there, only when the cache has no result."""
    # Coven emits absolute file grants. Paths in external callers' relative
    # documents resolve against that document's directory.
    # Only the path-bearing grants depend on the document's directory. In
    # ordinary Coven documents they point at absolute private paths.
    base = os.fsencode(Path(document).resolve().parent)
    try:
        tables = tomllib.loads(text.decode())
        paths = [*tables.get("files", {}).values(), *tables.get("input", {}).values(),
                 *(entry["root"] for entry in tables.get("dirs", {}).values()),
                 *(entry["dir"] for entry in tables.get("exec", {}).values())]
        if tables.keys() <= {"files","input","dirs","exec","paths","secrets","net","listen","rand","env","clock","user_caps"} and all(os.path.isabs(path) for path in paths):
            base = b""
    except (AttributeError, KeyError, TypeError, ValueError):
        pass  # Leave diagnostics to wasm-grants.
    digest, graph, compiler = _toolchain_key("grants", program, text, base)
    name = digest + ".flags" if digest is not None else None
    with _cache_directory(name is not None) as held:
        cached = _cache_get(held, name)
        if cached is not None:
            return cached.decode().splitlines()
        Path(document).write_bytes(text)
        checked = compiler_client().run([tool("WITCHYC", "witchyc"), "wasm-grants", HERE / f"{program}.wy", document],
                                 capture_output=True, text=True, env=toolchain_environment(), input_key=graph, document_text=text.decode(), selected_compiler=compiler)
        if checked.returncode:
            raise CovenError(f"{program}: grants refused: {checked.stderr.strip()}")
        if held is not None:
            _cache_put(held, name, checked.stdout.encode())
        return checked.stdout.splitlines()


def run_program(program, grants, temp):
    """Build a registry program and run it with exactly `grants`; return its one-line verdict.
    The program first verifies every signature deferred until now (`carry`), and acts only if
    each is valid; otherwise it acts on nothing and the command decides again (`Unverified`)."""
    # The engine opens every granted path from `/` without following a link (`--no-links`):
    # a registry slot swapped for a link after the launcher's checks is refused, not followed.
    # Every path granted is therefore resolved first, the temporary ones included.
    batch = carry()
    (Path(temp) / "batch").write_bytes(b"".join(batch))
    lines = []
    for section, entries in {"input": {"input": toml_string(Path(temp) / "batch")}, **grants}.items():
        lines.append(f"[{section}]")
        lines += [f"{key} = {value}" for key, value in entries.items()]
    flags = witchy_flags(program, lines, temp)
    limits = run_limits(batch)
    if program in ("publish", "fetch"):
        request_bytes = FETCH_REQUEST_BYTES if program == "fetch" else 0
        limits.append(f"--fs-bytes={PACKAGE_TRANSFER_BYTES + request_bytes}")
    module = witchy_module(program, FETCH_BUILD if program == "fetch" else WITCHY_BUILD)
    ran = subprocess.run([tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host"), module, *flags, *limits],
                         capture_output=True, text=True, env={}, stdin=subprocess.DEVNULL)
    verdict = "\n".join(checked_verdicts(program, batch, ran.stdout.splitlines(), ran.returncode, ran.stderr)).strip()
    if ran.returncode or not verdict:
        raise CovenError(f"{program}: stopped: {ran.stderr.strip() or 'no verdict'}")
    return verdict


# The `witchy-2` suite (the registry spec's rule 17, and the approved profile of 20 November
# 2026): ML-DSA-65 signatures over an object's canonical bytes, which begin with its role's domain
# `witchy/v2/ROLE\0`, computed by the engine's AWS-LC module; SHA-384 for key IDs and digests.
# Every role signs with it: the registry operator (snapshots, operator rotations) and the package
# owners (releases, indexes, rotations, the recovery keys that sign them).
SUITE = "witchy-2"
PUBLIC_KEY_BYTES, SIGNATURE_BYTES, SEED_BYTES = 1952, 3309, 32
MESSAGE_BYTES = 1 << 20  # the most the engine signs, and so the most an object may be
SIGNED_OBJECT_BYTES = MESSAGE_BYTES + len(b"signature \n") + 4 * ((SIGNATURE_BYTES + 2) // 3)
# A key's identifier: the suite, then the SHA-384 of its 1952-byte public key. An ML-DSA-65
# public key has exactly one encoding (FIPS 204's pkEncode, a fixed length), so one key has one
# identifier, with nothing to canonicalize (unlike an SSH key blob, 9f6117f). The suite is part
# of the identifier, so a pin names the suite as well as the key: neither an SSH fingerprint
# nor a witchy-1 ID ever pins a witchy-2 key, and no object can choose the suite it is checked
# under.
KEY_ID = re.compile(r"witchy-2:[0-9a-f]{96}")
RETIRED_KEY_ID = re.compile(r"witchy-1:[0-9a-f]{64}")
SEED_SOURCE = re.compile(r"fd:([3-9]|[1-9][0-9]{1,2}|10[01][0-9]|102[0-3])")
SEED_READ_SECONDS = 5.0
# The roles the registry signs objects for, each with its byte in a verifier batch (verify.wy
# has the same fixed list). One program signs for every role (sign.wy): the role is the grant's
# (`sign/witchy-2/ROLE`), so the engine signs only that role's domain whatever the program does.
VERIFY_ROLES = {"snapshot": 1, "operator-rotation": 2, "release": 3, "index": 4, "rotation": 5}
# The engine's limits for Coven's programs: memory for one object of MESSAGE_BYTES (or a package
# bundle of PACKAGE_BYTES), and the instructions to read and fill it.
WITCHY_BUILD = ["--heap-pages=24"]
# A fetch can hold a package, its file table and a normalized import path.
FETCH_BUILD = ["--heap-pages=48"]
FETCH_REQUEST_BYTES = 305  # The 304-byte request and its EOF probe.
# A program's input is the batch of records it verifies first (`verify_batch`), read a byte at a
# time: the host grants only as many bytes as are given (`--input-bytes`, 64 KiB unless more are
# granted, 16 MiB at most), and each byte costs fuel (about 100, measured). A batch above
# BATCH_BYTES is verified ahead, in runs of verify.wy of at most that much (`carry`), so that a
# program's own work keeps the budget it had (review of d0aabae: a registry of about ten signed
# packages could no longer be snapshotted).
BATCH_BYTES = 4 << 20
FUEL_PER_INPUT_BYTE = 256


def run_limits(batch):
    """The engine's limits for a run whose input is `batch` (records)."""
    size = sum(len(record) for record in batch)
    return ["--memory-pages=64", f"--fuel={200_000_000 + FUEL_PER_INPUT_BYTE * size}", f"--input-bytes={max(size, 1)}"]
PACKAGE_BYTES = 1 << 20  # a version's record and source together: publish.wy and fetch.wy's bound
# The host counts both reads and writes. Each transfer copies one package and
# can touch two SHA-384 digest files (including newline and trailing-byte checks).
# The Wasmtime host charges 256 additional bytes for each committed name.
PACKAGE_TRANSFER_BYTES = 2 * PACKAGE_BYTES + 2 * (len("sha384:") + 96 + 2) + 3 * 256


def domain(role):
    return f"witchy/v2/{role}\0".encode()


def key_id(public):
    return f"{SUITE}:" + hashlib.sha384(public).hexdigest()


def digest_of(data):
    """A content digest as the registry records it (publish.wy computes the same in the engine)."""
    return "sha384:" + hashlib.sha384(data).hexdigest()


def public_key_text(public):
    return f"{SUITE} " + base64.b64encode(public).decode()


def strict_base64(encoded, size):
    """The bytes of exactly `size` that `encoded` is the one canonical base64 of, or None."""
    try:
        decoded = base64.b64decode(encoded, validate=True)
    except (binascii.Error, ValueError):
        return None
    return decoded if len(decoded) == size and base64.b64encode(decoded).decode() == encoded else None


def read_public_key(text, what):
    """A witchy-2 public key from its text, `witchy-2 <base64 of 1952 bytes>`: nothing else."""
    kind, _, encoded = text.partition(" ")
    public = strict_base64(encoded, PUBLIC_KEY_BYTES) if kind == SUITE else None
    if public is None:
        if kind == "witchy-1" or PUBLIC_KEY.fullmatch(text):
            raise CovenError(f"{what} is {'a witchy-1' if kind == 'witchy-1' else 'an SSH'} public key, from before the witchy-2 profile: "
                             f"make a {SUITE} key (`coven key --key SEED`)")
        raise CovenError(f"{what} is not a {SUITE} public key (`{SUITE} <base64>`)")
    return public


def checked_key_id(value, flag, what="key"):
    """A pinned key: a witchy-2 key ID. An SSH fingerprint or a witchy-1 ID is refused, not looked
    up: every role signs with witchy-2 only, so a pin of an older suite pins nothing."""
    if isinstance(value, str) and (FINGERPRINT.fullmatch(value) or RETIRED_KEY_ID.fullmatch(value)):
        old = "an SSH key fingerprint" if FINGERPRINT.fullmatch(value) else "a witchy-1 key ID"
        raise CovenError(f"{flag} {value} is {old}, from before the witchy-2 profile: every key signs with {SUITE} only. "
                         f"Pin the {what}'s key ID, {SUITE}:<96 hex>, which `coven key` prints")
    if not isinstance(value, str) or not KEY_ID.fullmatch(value):
        raise CovenError(f"invalid {flag} {value!r}: {'an' if what[0] in 'aeiou' else 'a'} {what} key ID, {SUITE}:<96 lowercase hex>")
    return value


def checked_operator_id(value, flag="--operator"):
    return checked_key_id(value, flag, "operator")


def retired_digest(what, where):
    """The refusal for a digest from before the witchy-2 profile (`sha256:`), naming what to do:
    a lock is locked again, a registry's version is published again into a new registry."""
    remedy = ("lock again (`grimoire lock`) against a witchy-2 registry" if where == "lock" else
              "this registry predates the profile; republish the package into a new registry")
    return CovenError(f"{what} is a sha256 digest, from before the witchy-2 profile (SHA-384 only): {remedy}")


class Key:
    """A signing key: where its seed is read from (a file, or `fd:N`), never the seed itself, and
    its public key, from the public key file kept beside it."""
    def __init__(self, source, public):
        self.source, self.public, self.id = source, public, key_id(public)


def signing_key(source, public_file=None, flag="--key"):
    source = str(source)
    if source.startswith("fd:"):
        if not SEED_SOURCE.fullmatch(source):
            raise CovenError(f"{flag} {source}: a descriptor from 3 to 1023")
        if public_file is None:
            raise CovenError(f"{flag} {source} needs its public key file ({flag.replace('key', 'public-key')} FILE, from `coven key`)")
    elif public_file is None:
        public_file = f"{source}.pub"
    try:
        text = Path(public_file).read_text().strip()
    except (OSError, UnicodeDecodeError):
        raise CovenError(f"cannot read the public key {public_file}: `coven key --key {source}` writes it") from None
    return Key(source, read_public_key(text, str(public_file)))


def public_key_file(path):
    """The key ID of a public key file (a recovery key's, which signs nothing here)."""
    try:
        text = Path(path).read_text().strip()
    except (OSError, UnicodeDecodeError):
        raise CovenError(f"cannot read the public key {path}") from None
    return key_id(read_public_key(text, str(path)))


def extended_acl(handle):
    from importlib.util import module_from_spec, spec_from_file_location

    if not hasattr(extended_acl, "check"):
        location = spec_from_file_location("coven_permissions", HERE / "coven_permissions.py")
        permissions = module_from_spec(location)
        location.loader.exec_module(permissions)
        extended_acl.check = permissions.extended_acl
    return extended_acl.check(handle)


def read_seed(source):
    """The seed of a key, into a bytearray the caller clears once it is delivered, and the
    identity (device, inode) of the file it came from (None for a pipe). The seed is 32 bytes: a
    file only its owner can read, or a descriptor this process was started with, read to its
    end. Nothing about the value is ever said."""
    seed = bytearray(SEED_BYTES + 1)
    if source.startswith("fd:"):
        number = int(source[3:])
        if number not in INHERITED_DESCRIPTORS:
            raise CovenError(f"key {source}: not a descriptor coven was started with")
        handle, opened = number, False
    else:
        try:
            handle, opened = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), True
        except OSError:
            raise CovenError(f"key {source}: cannot be opened (a regular file, not a link)") from None
    try:
        status = os.fstat(handle)
        if opened and not stat.S_ISREG(status.st_mode):
            raise CovenError(f"key {source}: not a regular file")
        if opened and (status.st_mode & 0o077 or status.st_uid != os.getuid() or extended_acl(handle)):
            raise CovenError(f"key {source}: readable by others than its owner (yours, chmod 600, no ACL)")
        filled, until = 0, time.monotonic() + SEED_READ_SECONDS
        view = memoryview(seed)
        try:
            while filled < len(seed):
                if not opened:
                    ready, _, _ = select.select([handle], [], [], max(0.0, until - time.monotonic()))
                    if not ready:
                        raise CovenError(f"key {source}: descriptor not closed in time")
                count = os.readv(handle, [view[filled:]])
                if count == 0:
                    break
                filled += count
        finally:
            view.release()
    except OSError:
        seed[:] = bytes(len(seed))
        raise CovenError(f"key {source}: unreadable") from None
    except CovenError:
        seed[:] = bytes(len(seed))
        raise
    finally:
        try:
            os.close(handle)  # an inherited descriptor too: it is read once
        except OSError:
            pass
    if filled != SEED_BYTES:
        seed[:] = bytes(len(seed))
        raise CovenError(f"key {source}: not an ML-DSA-65 seed ({SEED_BYTES} bytes)")
    del seed[SEED_BYTES:]
    # A file's identity goes to the engine (`--secret-object`), which then refuses it through any
    # grant; a pipe has none (as Grimoire's `source_files`, with Rust's widening of st_dev).
    return seed, ((status.st_dev & 0xFFFF_FFFF_FFFF_FFFF, status.st_ino) if stat.S_ISREG(status.st_mode) else None)


_MODULES = {}


def witchy_module(program, options=WITCHY_BUILD):
    """Reuse a registry program only while its compiler and inputs have the same cache key."""
    key = _toolchain_key("build", program, *options)
    known = _MODULES.get(program)
    if key[0] is not None and known is not None and known[0] == key:
        return known[1]
    if "work" not in _MODULES:
        _MODULES["work"] = tempfile.TemporaryDirectory(prefix="coven-modules-")
        atexit.register(_MODULES["work"].cleanup)
    module = Path(_MODULES["work"].name) / f"{program}.wasm"
    _MODULES.pop(program, None)
    build_module(program, module, options, key=key)
    if key[0] is not None:
        _MODULES[program] = (key, module)
    return module


def witchy_flags(program, document_lines, temp):
    """The host flags for `program` under these grants. The check runs on the document with each
    path Coven wrote replaced by a placeholder, so its result is cached across runs (every run's
    paths are fresh temporary ones); the placeholders are then replaced by the real paths, each
    exactly once in its flag. A path the template cannot carry is checked as it is."""
    paths = []
    def template(match):
        paths.append(match[1])
        return f'"/__coven_path_{len(paths) - 1}__"'
    text = "\n".join(["[paths]", "links = false", *document_lines]) + "\n"
    templated = re.sub(r'"(/[A-Za-z0-9._/+-]+)"', template, text)
    document = Path(temp) / f"{program}.grants.toml"
    placeholder = re.compile(r"/__coven_path_([0-9]+)__")
    # A real path that looks like a placeholder could be taken for one: such a document is
    # checked as it is (review of 7d40fde).
    if not placeholder.search(text):
        flags = grant_flags(program, document, templated.encode())
        found = [int(number) for flag in flags for number in placeholder.findall(flag)]
        if sorted(found) == list(range(len(paths))):
            # Each placeholder in exactly one place: each replaced by its path, in one pass, so a
            # path put in is never read again as a placeholder (review of 7d40fde).
            return [placeholder.sub(lambda match: paths[int(match[1])], flag) for flag in flags]
    # Otherwise: check the real document instead.
    return grant_flags(program, document, text.encode())


_VERIFIED = {}
# While a command defers verification (`deferred`): the batch records of the signatures it has
# taken as valid so far, which the next engine run verifies before it acts (`carry`).
_DEFERRED = None
# Every record the command deferred, verified since or not: what it holds is released on an
# error only if each has a verdict, and it is valid (`deferred`).
_DEFERRED_ALL = None


class Unverified(Exception):
    """An engine run found a signature the command had deferred invalid: the program acted on
    nothing, and the command is decided again with each verdict known (`deferred`)."""


def verify_record(role, public, message, signature):
    """An object's record in a verifier batch, or None for one the batch cannot frame (a key or
    signature of another length, a message too long, a role outside the fixed list), which is
    invalid without a run."""
    if role not in VERIFY_ROLES or len(public) != PUBLIC_KEY_BYTES or len(signature) != SIGNATURE_BYTES \
            or len(message) > MESSAGE_BYTES:
        return None
    return bytes([VERIFY_ROLES[role]]) + public + len(message).to_bytes(4, "big") + message + signature


def witchy_verify_all(items):
    """For each (role, public key, message, signature), whether the signature is the key's, over
    the message, as an object of that role (`witchy2_verify` in witchy2.wy, which checks the
    role's domain). Results are kept for this process, by the record's SHA-384, so an object
    verified once is not run again.

    While the command defers (`deferred`), an object not verified yet is taken as valid and its
    record joins the batch the command's next engine run verifies before it acts (`carry`); a
    write that no engine run precedes verifies them first (`settle`). Otherwise the objects are
    verified now, in one run of verify.wy."""
    results, batch = [], []
    for role, public, message, signature in items:
        record = verify_record(role, public, message, signature)
        if record is None:
            results.append(False)
            continue
        seen = hashlib.sha384(record).digest()
        results.append(_VERIFIED.get(seen, seen))
        if seen not in _VERIFIED and record not in batch:
            batch.append(record)
    if batch and _DEFERRED is not None:
        _DEFERRED.extend(record for record in batch if record not in _DEFERRED)
        _DEFERRED_ALL.extend(record for record in batch if record not in _DEFERRED_ALL)
        return [True if isinstance(result, bytes) else result for result in results]
    if batch:
        run_verifier(batch)
    return [_VERIFIED[result] if isinstance(result, bytes) else result for result in results]


def run_verifier(batch):
    """verify.wy over `batch`, in runs of at most BATCH_BYTES (or one record): each verdict kept
    (`_VERIFIED`)."""
    part, size = [], 0
    for record in batch:
        if part and size + len(record) > BATCH_BYTES:
            run_verifier_once(part)
            part, size = [], 0
        part.append(record)
        size += len(record)
    if part:
        run_verifier_once(part)


def run_verifier_once(batch):
    with tempfile.TemporaryDirectory(prefix="coven-") as temp:
        temp = Path(temp).resolve()
        (temp / "batch").write_bytes(b"".join(batch))
        flags = witchy_flags("verify", ["[input]", f"input = {toml_string(temp / 'batch')}"], temp)
        ran = subprocess.run([tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host"), witchy_module("verify"), *flags, *run_limits(batch)],
                             capture_output=True, text=True, env={}, stdin=subprocess.DEVNULL)
    checked_verdicts("verify", batch, ran.stdout.splitlines(), ran.returncode, ran.stderr, final=True)


def checked_verdicts(program, batch, lines, returncode, stderr, final=False):
    """The lines a program printed after verifying `batch` (`verify_batch`: `valid` or `invalid`
    for each record, in order, then `end`), each verdict kept. A program that found one invalid
    acted on nothing: `Unverified`, unless `final` (verify.wy, which only verifies)."""
    head = lines[:len(batch) + 1]
    if returncode or len(head) != len(batch) + 1 or head[-1] != "end" or not set(head[:-1]) <= {"valid", "invalid"}:
        raise CovenError(f"{program}: stopped: {stderr.strip() or (lines[-1] if lines else 'no verdict')}")
    for record, verdict in zip(batch, head):
        _VERIFIED[hashlib.sha384(record).digest()] = verdict == "valid"
    if _DEFERRED:
        # Deferred no longer only once its verdict is kept: a run that stopped leaves the batch
        # deferred, and it is verified before anything is reported (automated review of d0aabae).
        _DEFERRED[:] = [record for record in _DEFERRED if hashlib.sha384(record).digest() not in _VERIFIED]
    if not final and "invalid" in head:
        raise Unverified()
    return lines[len(batch) + 1:]


def carry():
    """The deferred records, for the engine run about to start: it verifies them before it acts.
    They stay deferred until their verdicts are kept (`checked_verdicts`). A batch above
    BATCH_BYTES is verified first, by verify.wy (`settle`), and the run carries none."""
    if _DEFERRED and sum(len(record) for record in _DEFERRED) > BATCH_BYTES:
        settle()
    return list(_DEFERRED) if _DEFERRED else []


def settle():
    """Before a write no engine run precedes: every deferred signature verified first (one run
    of verify.wy), and if one is invalid, nothing is written and the command is decided again."""
    batch = list(_DEFERRED) if _DEFERRED else []
    if batch:
        run_verifier(batch)
        if not all(_VERIFIED[hashlib.sha384(record).digest()] for record in batch):
            raise Unverified()


def deferred(command):
    """Run `command` (a function of no arguments) with its verification deferred to its engine
    runs: each signature it reads is taken as valid when it is read, and the next engine run of
    the command (fetch.wy, publish.wy, sign.wy) verifies all of them before it acts, so the
    signatures and the action are one run. A write with no engine run before it (`settle`), and
    the end of the command, whether it succeeded or refused, verify what is still deferred with
    verify.wy. What the command prints is held until then: nothing is reported from a signature
    that was not verified.

    If any deferred signature is invalid, the program that found it acted on nothing, the
    output is dropped, and the command is decided again, this time verifying each signature
    where it is read (as without deferral), with every verdict found so far kept. Anything it
    wrote before was written after an engine run verified every signature its decision rested
    on, as without deferral."""
    global _DEFERRED, _DEFERRED_ALL
    out, err = io.StringIO(), io.StringIO()
    _DEFERRED, _DEFERRED_ALL = [], []
    try:
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            try:
                result = command()
            except Unverified:
                raise
            except Exception:
                settle()  # a refusal is reported only once what it rests on is verified
                raise
            settle()
    except Unverified:
        _DEFERRED = _DEFERRED_ALL = None
        return command()
    except BaseException:
        # What it held is released only if every record it deferred is verified valid (the
        # `settle` above succeeded); otherwise only the error is reported (automated review of
        # d0aabae: an engine run or verify.wy that stopped left held output unverified).
        verified = all(_VERIFIED.get(hashlib.sha384(record).digest()) is True for record in _DEFERRED_ALL)
        _DEFERRED = _DEFERRED_ALL = None
        if verified:
            sys.stdout.write(out.getvalue())
            sys.stderr.write(err.getvalue())
        raise
    _DEFERRED = _DEFERRED_ALL = None
    sys.stdout.write(out.getvalue())
    sys.stderr.write(err.getvalue())
    return result


def witchy_run_signer(role, key, message):
    """Run the signer with `key`'s seed on a pipe of its own, granted `role` only: (its public
    key, the signature of `message`, or None without a message). The seed is read only now,
    written to the engine's pipe and cleared; it never reaches an argument, a variable, a file
    Coven writes or the toolchain. The signer first verifies every signature deferred until now
    (`carry`), and signs only if each is valid; it verifies its own signature, as an object of
    `role`, before it writes it, and that verdict is kept (`_VERIFIED`)."""
    if role not in VERIFY_ROLES:
        raise CovenError(f"no signing role {role!r}")
    program, parameter = "sign", "key"
    with tempfile.TemporaryDirectory(prefix="coven-") as temp:
        temp = Path(temp).resolve()
        work, out = temp / "work", temp / "out"
        work.mkdir()
        out.mkdir()
        if message is not None:
            (work / "message").write_bytes(message)
        (work / "role").write_bytes(bytes([VERIFY_ROLES[role]]))
        batch = carry()
        (temp / "batch").write_bytes(b"".join(batch))
        use = f"sign/{SUITE}/{role}"
        # The descriptor in the document is a placeholder: the engine is given its own pipe's.
        flags = witchy_flags(program, ["[input]", f"input = {toml_string(temp / 'batch')}",
                                       "[dirs]", f"work = {{ root = {toml_string(work)} }}", f"out = {{ root = {toml_string(out)} }}",
                                       "[secrets]", f'{parameter} = {{ use = "{use}", from = "fd:3" }}'], temp)
        slot = f"--secret-slot={parameter}:{use}:fd:3"
        if flags.count(slot) != 1 or any(flag.startswith("--secret") and flag != slot for flag in flags):
            raise CovenError(f"{program}: wasm-grants proposes another secret than the signing key")
        module = witchy_module(program)
        host = tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
        seed, origin = read_seed(key.source)
        try:
            reading, writing = os.pipe()
            try:
                if not 3 <= reading <= 1023:
                    raise CovenError("no descriptor from 3 to 1023 to deliver the key on")
                command = [host, module]
                for flag in flags:
                    if flag == slot:
                        command.append(f"--secret-slot={parameter}:{use}:fd:{reading}")
                        if origin is not None:
                            # The file the seed came from: refused through any grant.
                            command.append(f"--secret-object={parameter}:{origin[0]}:{origin[1]}")
                    else:
                        command.append(flag)
                process = subprocess.Popen([*command, *run_limits(batch)], env={}, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                           stderr=subprocess.PIPE, pass_fds=(reading,))
            except BaseException:
                os.close(writing)
                raise
            finally:
                os.close(reading)
            try:
                view = memoryview(seed)
                try:
                    while view:
                        view = view[os.write(writing, view):]
                finally:
                    view.release()
            except OSError:
                pass  # the engine stopped first, and says why
            finally:
                os.close(writing)
        finally:
            seed[:] = bytes(len(seed))
        stdout, stderr = process.communicate()
        stdout, stderr = stdout.decode("utf-8", "replace"), stderr.decode("utf-8", "replace")
        verdict = "\n".join(checked_verdicts(program, batch, stdout.splitlines(), process.returncode, stderr)).strip()
        expected = "signed" if message is not None else "public key"
        if process.returncode or verdict != expected:
            raise CovenError(f"{program}: {verdict or stderr.strip() or 'no verdict'}")
        public = (out / "public-key").read_bytes()
        signature = (out / "signature").read_bytes() if message is not None else None
    if len(public) != PUBLIC_KEY_BYTES or (signature is not None and len(signature) != SIGNATURE_BYTES):
        raise CovenError(f"{program}: the engine's key or signature has the wrong length")
    if signature is not None:
        # Verified in the same run, as an object of `role`, before it was written.
        _VERIFIED[hashlib.sha384(verify_record(role, public, message, signature)).digest()] = True
    return public, signature


def witchy_sign(role, key, message):
    """`message`, an object of `role`, signed by `key`. The key the engine holds must be the one
    its public key file names, or nothing is signed for it."""
    if not message.startswith(domain(role)) or len(message) > MESSAGE_BYTES:
        raise CovenError(f"not a {role} object to sign")
    public, signature = witchy_run_signer(role, key, message)
    if public != key.public:
        raise CovenError(f"key {key.source} is {key_id(public)}, not {key.id}, which its public key file names")
    return signature


def signed_object(message, signature):
    """A signed object as the registry keeps it: its canonical bytes, then one signature line."""
    return message + b"signature " + base64.b64encode(signature) + b"\n"


def split_signed(raw, role, malformed):
    """(message, signature) of a signed object of `role` that is exactly `raw`."""
    if len(raw) > SIGNED_OBJECT_BYTES:
        raise malformed
    at = raw.rfind(b"\nsignature ")
    if not raw.startswith(domain(role)) or at < 0 or at >= MESSAGE_BYTES or not raw.endswith(b"\n"):
        raise malformed
    try:
        encoded = raw[at + 11:-1].decode("ascii")
    except UnicodeDecodeError:
        raise malformed from None
    signature = strict_base64(encoded, SIGNATURE_BYTES)
    if signature is None:
        raise malformed
    return raw[:at + 1], signature


def split_all(raw, role, malformed):
    """The (message, signature) of each signed object of `role` that `raw` is, one after another
    (`rotations`, `operator-rotations`)."""
    objects, at = [], 0
    if not raw:
        raise malformed
    while at < len(raw):
        limit = at + SIGNED_OBJECT_BYTES
        signature = raw.find(b"\nsignature ", at, limit)
        if signature < 0 or signature - at >= MESSAGE_BYTES:
            raise malformed
        end = raw.find(b"\n", signature + 1, limit)
        if end < 0:
            raise malformed
        objects.append(split_signed(raw[at:end + 1], role, malformed))
        at = end + 1
    return objects


def retired_object(raw):
    """Why `raw` is an object from before the witchy-2 profile (signed with ssh-keygen, or with
    witchy-1), or None."""
    if raw.startswith(b"witchy/v1/"):
        return "signed with witchy-1 (ML-DSA-44)"
    first = raw.partition(b"\n")[0].decode("ascii", "replace")
    if PUBLIC_KEY.match(first) or b"-----BEGIN SSH SIGNATURE-----" in raw:
        return "signed with ssh-keygen"
    return None


def object_body(message, role, header, malformed):
    """The lines of a signed object's body after its domain, whose first lines are `header`
    (its format and `suite witchy-2`), and the signer's public key from its `signer` line."""
    try:
        lines = message[len(domain(role)):].decode("ascii").split("\n")
    except UnicodeDecodeError:
        raise malformed from None
    if len(lines) < len(header) + 2 or lines[:len(header)] != header or lines[-1] != "" or not lines[len(header)].startswith("signer "):
        raise malformed
    try:
        public = read_public_key(lines[len(header)][7:], "the signer")
    except CovenError:
        raise malformed from None
    return public, lines[len(header) + 1:-1]


def make_key(source, out):
    """Write the public key of the key at `source` (its seed) to `out` (KEY.pub for a file), for
    `--key`, and print its key ID."""
    source = str(source)
    if source.startswith("fd:") and (not SEED_SOURCE.fullmatch(source) or out is None):
        raise CovenError(f"--key {source}: a descriptor from 3 to 1023, with --out FILE for its public key")
    out = Path(out if out is not None else f"{source}.pub")
    public, _ = witchy_run_signer("snapshot", Key(source, b""), None)
    text = public_key_text(public) + "\n"
    # Read as bytes and compared, never decoded: a file that is not this text (a seed given as
    # --out by mistake) is named, never quoted, not even in a decoding error (review of the cutover).
    try:
        held = out.read_bytes() if out.exists() else None
    except OSError:
        raise CovenError(f"{out} cannot be read: give another --out") from None
    if held is not None and held != text.encode():
        raise CovenError(f"{out} holds something else than this key's public key: remove it, or give --out")
    out.write_text(text)
    print(f"key {key_id(public)}")
    return True


def slot(registry, name, version):
    root = Path(registry).resolve()
    if not root.is_dir():
        raise CovenError(f"no registry directory at {root}")
    return root / checked_name(name) / checked_version(version)


def real_slot(target):
    """`target` if its name and version directories are real directories of the registry.

    A symlink planted at NAME or NAME/VERSION would point a publish's writes, or a fetch's
    reads, outside the registry (review of 02201da): refused, before and after creating them.
    """
    for part in (target.parent, target):
        if part.is_symlink() or (part.exists() and not part.is_dir()):
            raise CovenError(f"{part} is not a directory of the registry")
    return target


def identity(target):
    """The device and inode of NAME and NAME/VERSION, without following links."""
    return [(os.lstat(part).st_dev, os.lstat(part).st_ino) for part in (target.parent, target)]


def unchanged(target, before):
    """Refuse if a slot was swapped while a program ran. The engine already refuses a link on a
    granted path (`--no-links`); this also catches a slot replaced by another real directory."""
    try:
        after = identity(target)
    except OSError:
        after = None
    if after != before:
        raise CovenError(f"{target} changed while it was in use: the registry is being modified by someone else")


SIGNATURE = "release-signature"
# An SSH public key line: what owners signed with before the witchy-2 profile. Only recognized,
# to refuse such an object with what to do (`retired_object`).
PUBLIC_KEY = re.compile(r"(ssh-ed25519|ecdsa-sha2-nistp256|ssh-rsa) [A-Za-z0-9+/]+=*( [ -~]*)?")


def release_message(name, version, digest, public):
    """What a publisher signs, a witchy-2 object of role `release`: the coordinate and the
    version's digest, and the signer's public key, nothing else."""
    return domain("release") + (f"coven-release 2\nsuite {SUITE}\nsigner {public_key_text(public)}\n"
                                f"name {name}\nversion {version}\ndigest {digest}\n").encode()


def signer_of(target, name, version, digest):
    """The key ID of the key that signed this version's digest, or None if it is unsigned. A
    signature that does not verify, for exactly this name, version and digest, is refused, and so
    is one from before the witchy-2 profile."""
    path = target / SIGNATURE
    raw = registry_file(path, signed=True)
    if raw is None:
        return None
    old = retired_object(raw)
    if old:
        raise CovenError(f"{name} {version}: the release signature is {old}, from before the witchy-2 profile: "
                         f"this registry predates it; republish the package into a new registry")
    malformed = CovenError(f"{name} {version}: the release signature is malformed")
    message, signature = split_signed(raw, "release", malformed)
    public, rest = object_body(message, "release", ["coven-release 2", f"suite {SUITE}"], malformed)
    if len(rest) != 3 or not rest[0].startswith("name ") or not rest[1].startswith("version ") or not rest[2].startswith("digest ") \
            or message != release_message(rest[0][5:], rest[1][8:], rest[2][7:], public):
        raise malformed
    # Signed for another coordinate or digest (a signature moved from another version), or not by
    # the key it names: it does not verify for this one.
    if rest != [f"name {name}", f"version {version}", f"digest {digest}"] or not witchy_verify_all([("release", public, message, signature)])[0]:
        raise CovenError(f"{name} {version}: the release signature does not verify for {digest}")
    return key_id(public)


def sign(target, name, version, digest, key):
    """Sign this version's digest with `key` (a witchy-2 key, its public key beside it as
    KEY.pub) and store the signature once: a version keeps its first signer. A signature already
    there is verified, and is this key's or refused, without signing again."""
    if (target / SIGNATURE).exists() or (target / SIGNATURE).is_symlink():
        signer = signer_of(target, name, version, digest)
        if signer != key.id:
            raise CovenError(f"{name} {version} is already signed by {signer}, not {key.id}")
        return signer
    message = release_message(name, version, digest, key.public)
    raw = signed_object(message, witchy_sign("release", key, message))
    settle()
    # Created exclusively under a random name (O_EXCL: never through a link someone left),
    # then linked into place.
    handle, staged = tempfile.mkstemp(prefix=f".{SIGNATURE}.", dir=target)
    staged = Path(staged)
    with os.fdopen(handle, "wb") as stream:
        stream.write(raw)
    try:
        os.link(staged, target / SIGNATURE)  # fails if a signature is already there
    except FileExistsError:
        pass
    finally:
        staged.unlink()
    signer = signer_of(target, name, version, digest)
    if signer != key.id:
        raise CovenError(f"{name} {version} is already signed by {signer}, not {key.id}")
    return signer


INDEX = "index"
LOCK_FILE = ".index.lock"
REASON = re.compile(r"[ -~]{1,200}")
STATES = ("active", "yanked", "revoked")
VALID_DAYS = 30
# The bounds on what an index may say, checked where it is signed and wherever it is parsed, so
# that no key, stolen or not, signs one that would outlast the freeze bound or leave its recovery
# key no room above it (final-state review: an index at 10**18-1, expiring in 9999, kept a
# recovery out for good).
#   - An index is valid for at most MAX_VALID_DAYS from the day it is signed; one that expires
#     later than that from today (a day's clock skew allowed) is refused.
#   - Its sequence is at most MAX_INDEX_SEQUENCE (2**53 - 1: exact as a double, and far inside the
#     18 digits a snapshot line carries).
#   - The operator admits a sequence at most MAX_SEQUENCE_STEP above the entry it had (0 for a
#     new one), so every admitted sequence is at most STEP times the snapshots signed: a thief
#     needs 2**33 snapshots to reach the bound, and a recovery rotation, which signs one above the
#     admitted sequence, always has room above it.
MAX_VALID_DAYS = 366
MAX_INDEX_SEQUENCE = 2 ** 53 - 1
MAX_SEQUENCE_STEP = 2 ** 20


def today():
    return datetime.datetime.now(datetime.timezone.utc).date()


def version_key(version):
    return tuple(int(part) for part in version.split("."))


def index_message(name, sequence, expires, recovery, entries, public):
    """What a package's owner signs, a witchy-2 object of role `index`: every version of the
    package, with its digest and state, under a sequence number that only grows and a date after
    which the index is refused, and the signer's public key.

    The sequence lets a client refuse an older index than one it has seen (a rollback hiding a
    yank or revocation); the expiry bounds how long a registry can keep serving one it has (a
    freeze); listing every version means a deleted or added entry is noticed (TUF's targets and
    timestamp properties, for one owner key per package). `recovery` is the key ID of the key
    that alone may hand the package to a new owner key, or `none`: set by the first index and
    never changed.
    """
    lines = ["coven-index 2", f"suite {SUITE}", f"signer {public_key_text(public)}", f"name {name}", f"sequence {sequence}",
             f"expires {expires.isoformat()}", f"recovery {recovery}"]
    for version in sorted(entries, key=version_key):
        digest, state, reason = entries[version]
        lines.append(f"version {version} {digest} {state}" + (f" {reason}" if reason else ""))
    return domain("index") + ("\n".join(lines) + "\n").encode()


class Index:
    def __init__(self, signer, sequence, expires, recovery, entries, raw):
        self.signer, self.sequence, self.expires, self.recovery, self.entries, self.raw = signer, sequence, expires, recovery, entries, raw


def read_index(package_dir, name):
    """The package's verified index, or None if it has none. Anything else is refused: a link,
    a malformed index, or one whose signature does not verify for this package's name."""
    raw = registry_file(package_dir / INDEX, signed=True)
    return parse_index(raw, name) if raw is not None else None


def parse_index(raw, name):
    """A verified index from its bytes; a malformed one, one that does not verify, or one from
    before the witchy-2 profile, is refused."""
    old = retired_object(raw)
    if old:
        raise CovenError(f"{name}: its index is {old}, from before the witchy-2 profile: this registry predates it; "
                         f"republish the package into a new registry")
    malformed = CovenError(f"{name}: its index is malformed")
    message, signature = split_signed(raw, "index", malformed)
    public, lines = object_body(message, "index", ["coven-index 2", f"suite {SUITE}"], malformed)
    if len(lines) < 4 or lines[0] != f"name {name}":
        raise malformed
    if not re.fullmatch(r"sequence [1-9][0-9]{0,19}", lines[1]):
        raise malformed
    try:
        sequence = int(lines[1].removeprefix("sequence "))
        expires = datetime.date.fromisoformat(lines[2].removeprefix("expires "))
    except ValueError:
        raise malformed from None
    if sequence > MAX_INDEX_SEQUENCE:
        raise CovenError(f"{name}: its index's sequence {sequence} is above {MAX_INDEX_SEQUENCE}, the most an index may have")
    if expires > today() + datetime.timedelta(days=MAX_VALID_DAYS + 1):
        raise CovenError(f"{name}: its index expires on {expires.isoformat()}, more than {MAX_VALID_DAYS} days ahead, "
                         f"the most an index is valid for")
    recovery = lines[3].removeprefix("recovery ")
    if recovery != "none" and not KEY_ID.fullmatch(recovery):
        raise malformed
    entries = {}
    for line in lines[4:]:
        fields = line.split(" ", 4)
        if len(fields) < 4 or fields[0] != "version" or not VERSION.fullmatch(fields[1]) or fields[1] in entries \
                or not DIGEST.fullmatch(fields[2]) or fields[3] not in STATES:
            raise malformed
        reason = fields[4] if len(fields) == 5 else ""
        if (fields[3] == "active") != (reason == "") or (reason and not REASON.fullmatch(reason)):
            raise malformed
        entries[fields[1]] = (fields[2], fields[3], reason)
    # The one canonical spelling: the bytes signed are the bytes this index would be written as.
    if sequence < 1 or message != index_message(name, sequence, expires, recovery, entries, public):
        raise malformed
    if not witchy_verify_all([("index", public, message, signature)])[0]:
        raise CovenError(f"{name}: its index's signature does not verify")
    return Index(key_id(public), sequence, expires, recovery, entries, raw)


def signed_state(package_dir, name, ours):
    """Where the owner's machine keeps a copy of the last index its key signed for this package of
    this registry: outside the registry, so its writers cannot change it."""
    base = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "coven" / "signed"
    where = hashlib.sha384(f"{REGISTRY_LOCATION.get() or package_dir.parent}\n{ours}".encode()).hexdigest()[:24]
    return base / f"{name}-{where}"


def base_index(package_dir, name, ours, warn=False):
    """The index an owner's update builds on: this machine's copy of the last index its key signed,
    or a later one the registry serves signed by the same key (from another machine).

    The registry's file is not trusted for this. A writer could put back an older index from before
    a yank or revocation, and the owner's next update would sign it again under a higher sequence:
    the withdrawal lost for good (automated review and adversarial review of 0bb1057). A writer
    could also delete the index or replace it with one under their own key, which stopped the
    owner from updating at all; the owner's next update now repairs all three. Without a copy (this
    key never signed this package here) the registry's index is taken on first use."""
    path = signed_state(package_dir, name, ours)
    copy = parse_index(signed_input(path), name) if path.is_file() else None
    if copy is not None and copy.signer != ours:
        raise CovenError(f"{path} is not an index signed by this key")
    try:
        served = read_index(package_dir, name)
    except CovenError:
        if copy is None:
            raise
        served = None
    if served is not None and served.signer != ours:
        # Handed on by rotation: the chain, checked against the recovery key this key signed (its
        # copy's), has this key before the index's signer. A chain that only verifies against the
        # served index's recovery key is a registry writer's, and the copy repairs it.
        try:
            handed = ours in owner_keys(package_dir, name, served, copy.recovery if copy else served.recovery)[:-1]
        except CovenError:
            handed = False
        if handed:
            raise CovenError(f"{name} was handed from this key to {served.signer}: only that key can change its index")
    if copy is None:
        return served
    if served is not None and served.signer == ours and served.sequence > copy.sequence:
        if served.recovery != copy.recovery:
            raise CovenError(f"the registry's index {served.sequence} of {name}, signed by this key, changes its recovery key from "
                             f"{copy.recovery} to {served.recovery}, which never changes: this key may be compromised; rotate with the recovery key")
        # Signed by this key elsewhere (another machine). Its withdrawals only add to the copy's:
        # a state moves from active to yanked to revoked, never back (automated review of bd6bb40).
        for version, (digest, state, reason) in copy.entries.items():
            later = served.entries.get(version)
            if later is not None and later[0] != digest:
                raise CovenError(f"the registry's index {served.sequence} of {name} lists {version} with another digest than this key signed")
            if later is None or STATES.index(later[1]) < STATES.index(state):
                served.entries[version] = (digest, state, reason)
        return served
    if warn and (served is None or served.raw != copy.raw):
        print(f"coven: warning: the registry does not serve the index {copy.sequence} of {name} this key last signed; "
              f"signing over it from {path}", file=sys.stderr)
    return copy


def record_signed_state(package_dir, name, ours, raw, path=None):
    settle()
    path = path or signed_state(package_dir, name, ours)
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, staged = tempfile.mkstemp(prefix=".index.", dir=path.parent)
    with os.fdopen(handle, "wb") as stream:
        stream.write(raw)
    os.replace(staged, path)


def first_entries(package_dir, name, ours, publishing=None):
    """The entries of a package's first index: none. Every signed publish writes the index, so a
    signed version other than the one being published means the index was lost, and starting a new
    one would list its versions as active again, revoked ones included (automated review of
    bd6bb40): refused, as is any version signed by another key. The owner restores the index (from
    $XDG_STATE_HOME/coven/signed on the machine that last signed it) and runs `coven refresh`."""
    for version_dir in sorted(package_dir.iterdir()):
        if not VERSION.fullmatch(version_dir.name) or version_dir.is_symlink() or not version_dir.is_dir():
            continue
        digest = version_dir / "digest"
        recorded = digest.read_text() if digest.is_file() and not digest.is_symlink() else ""
        if not DIGEST.fullmatch(recorded):
            continue
        signer = signer_of(version_dir, name, version_dir.name, recorded)
        if signer is not None and signer != ours:
            raise CovenError(f"{name} {version_dir.name} is signed by {signer}: another key cannot start {name}'s index")
        if signer is not None and version_dir.name != publishing:
            raise CovenError(f"{name} {version_dir.name} is signed, and {name} has no index: the registry lost it. "
                             f"Restore the last index signed (kept in $XDG_STATE_HOME/coven/signed) to {package_dir / INDEX}")
    return {}


def key_pair(key):
    """An owner's signing key: its seed's file, its public key beside it (KEY.pub)."""
    return signing_key(key)


@contextlib.contextmanager
def index_lock(package_dir, name):
    """Updates of one package's index and rotations, one at a time."""
    try:
        held = os.open(package_dir / LOCK_FILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        raise CovenError(f"{name}'s index is being updated by someone else (or {package_dir / LOCK_FILE} was left by a stopped update)") from None
    try:
        yield
    finally:
        os.close(held)
        os.unlink(package_dir / LOCK_FILE)


def write_index(package_dir, name, key, sequence, recovery, entries, valid_days, keep=True):
    """Sign and store the package's index with `key`, and keep the owner's copy of it (unless
    `keep` is false: an HTTP publication keeps it only once the registry accepts it)."""
    if not 1 <= valid_days <= MAX_VALID_DAYS:
        raise CovenError(f"an index is valid for 1 to {MAX_VALID_DAYS} days")
    if not 1 <= sequence <= MAX_INDEX_SEQUENCE:
        raise CovenError(f"{name}: index {sequence} is above {MAX_INDEX_SEQUENCE}, the most an index may have: "
                         f"an index that far ahead was signed by a stolen key; rotate with the recovery key")
    key = key_pair(key) if not isinstance(key, Key) else key
    message = index_message(name, sequence, today() + datetime.timedelta(days=valid_days), recovery, entries, key.public)
    raw = signed_object(message, witchy_sign("index", key, message))
    settle()
    handle, staged = tempfile.mkstemp(prefix=f".{INDEX}.", dir=package_dir)
    with os.fdopen(handle, "wb") as stream:
        stream.write(raw)
    os.replace(staged, package_dir / INDEX)
    if keep:
        record_signed_state(package_dir, name, key.id, raw)
    return sequence


def update_index(package_dir, name, key, change, valid_days=VALID_DAYS, recovery=None, publishing=None):
    """Re-sign the package's index with `change` applied to its entries, as its owner. The first
    index sets the package's recovery key (`recovery`, a key ID), which never changes."""
    key = key_pair(key) if not isinstance(key, Key) else key
    ours = key.id
    verify_ahead(package_objects(package_dir, name, ours))
    with index_lock(package_dir, name):
        current = base_index(package_dir, name, ours, warn=True)
        if current is not None and current.signer != ours:
            raise CovenError(f"{name} is owned by {current.signer}: only its key can change its index")
        if current is not None and recovery is not None and recovery != current.recovery:
            raise CovenError(f"{name}'s recovery key is {current.recovery}, set by its first index: it does not change")
        entries = dict(current.entries) if current else first_entries(package_dir, name, ours, publishing)
        change(entries)
        return write_index(package_dir, name, key, current.sequence + 1 if current else 1,
                           current.recovery if current else (recovery or "none"), entries, valid_days)


ROTATIONS = "rotations"


def rotation_message(name, old, new_public, public):
    """A witchy-2 object of role `rotation`: the key `old` (a key ID) hands package `name` to the
    key `new_public` (its whole public key), signed by `public` (the recovery key, or without one
    the key handing it over)."""
    return domain("rotation") + (f"coven-rotation 2\nsuite {SUITE}\nsigner {public_key_text(public)}\nname {name}\n"
                                 f"from {old}\nto {public_key_text(new_public)}\n").encode()


# Where a package's rotations are read from: the registry's `NAME/rotations` as it is now. A
# client under a snapshot reads instead the exact rotations the snapshot binds (`snapshot_chain`).
LIVE = object()


def live_rotations(package_dir):
    """The bytes of the package's `NAME/rotations`, or None if it has none."""
    return registry_file(package_dir / ROTATIONS)


def chain_statements(package_dir, name, raw=LIVE):
    """The package's rotation statements as (bytes, signer, from, to), each verified as signed by
    its own signer; who may sign them is checked by `read_chain`. None if it has none. `raw`: the
    rotations' bytes (None: none), or LIVE for the registry's file."""
    if raw is LIVE:
        raw = live_rotations(package_dir)
    if raw is None:
        return None
    old = retired_object(raw)
    if old:
        raise CovenError(f"{name}: its rotations are {old}, from before the witchy-2 profile: this registry predates it; "
                         f"republish the package into a new registry")
    malformed = CovenError(f"{name}: its rotations are malformed")
    statements, checks = [], []
    for message, signature in split_all(raw, "rotation", malformed):
        public, lines = object_body(message, "rotation", ["coven-rotation 2", f"suite {SUITE}"], malformed)
        if len(lines) != 3 or lines[0] != f"name {name}" or not lines[1].startswith("from ") or not KEY_ID.fullmatch(lines[1][5:]) \
                or not lines[2].startswith("to "):
            raise malformed
        try:
            new_public = read_public_key(lines[2][3:], "a rotation's new key")
        except CovenError:
            raise malformed from None
        if message != rotation_message(name, lines[1][5:], new_public, public):
            raise malformed
        statements.append((signed_object(message, signature), key_id(public), lines[1][5:], key_id(new_public)))
        checks.append(("rotation", public, message, signature))
    if not all(witchy_verify_all(checks)):
        raise CovenError(f"{name}: a rotation's signature does not verify")
    return [(text.decode("ascii"), *rest) for text, *rest in statements]


def allowed_chain(statements, recovery):
    """The owner keys the statements hand the package through, oldest first, and how many
    statements that takes, stopping at the first one not signed as `recovery` requires (the
    recovery key, or with none the key handing over), not following on, or returning to a key."""
    chain = [statements[0][2]]
    for count, (_, signer, old, new) in enumerate(statements):
        if signer != (recovery if recovery != "none" else old) or chain[-1] != old or new in chain:
            return chain, count
        chain.append(new)
    return chain, len(statements)


def read_chain(package_dir, name, recovery, rotations=LIVE):
    """The package's owner keys in order, from its rotation statements, or None if it has none.

    Each statement hands the package from one key to the next, and is signed by the package's
    recovery key if it has one, or else by the key handing it over: with a recovery key, a stolen
    owner key cannot hand the package to its thief, and a lost one can be replaced. Statements
    must form one chain; anything else is refused."""
    statements = chain_statements(package_dir, name, rotations)
    if statements is None:
        return None
    chain, count = allowed_chain(statements, recovery)
    if count < len(statements):
        _, signer, old, new = statements[count]
        if signer != (recovery if recovery != "none" else old):
            raise CovenError(f"{name}: a rotation from {old} is signed by {signer}, not by "
                             + (f"the package's recovery key {recovery}" if recovery != "none" else "the key it hands over"))
        raise CovenError(f"{name}: its rotations do not form one chain" if chain[-1] != old else f"{name}: its rotations return to an earlier key")
    return chain


def owner_keys(package_dir, name, index, recovery, rotations=LIVE):
    """The keys that have owned the package, oldest first, ending with the index's signer.

    `recovery` is the recovery key the rotations are checked against. It must come from outside
    the registry (a consumer's pin, the owner's own copy): the index's own `recovery` line is signed
    by the end of the chain, which a registry writer can make their own key, naming their own key as
    the recovery key that signs a rotation to it (automated review of 7870240). `rotations`: as
    `chain_statements`'s `raw`."""
    chain = read_chain(package_dir, name, recovery, rotations)
    if chain is None:
        return [index.signer]
    if chain[-1] != index.signer:
        raise CovenError(f"{name}'s index is signed by {index.signer}, but its rotations hand it to {chain[-1]}")
    return chain


def kept_chains(package_dir):
    """The registry's copies of rotations snapshots bound (`NAME/chains/HEX`), each only if its
    bytes have the digest its name says."""
    folder = package_dir / CHAINS
    if folder.is_symlink() or not folder.is_dir():
        return []
    kept = []
    for path in sorted(folder.iterdir()):
        if re.fullmatch(r"[0-9a-f]{96}", path.name) and path.is_file() and not path.is_symlink():
            raw = path.read_bytes()
            if digest_of(raw) == "sha384:" + path.name:
                kept.append(raw)
    return kept


def rotation_sources(package_dir, name):
    """What a rotation may build on: `NAME/rotations` as served, and each bound chain the registry
    keeps, with the statements served after it (`joined_rotations`). A writer who deletes or
    truncates `NAME/rotations` then does not make the owner write a chain that drops the bound
    one (adversarial review of 363f952). Each is (bytes, its statements, verified), the
    unreadable left out; the caller decides which reach the owner."""
    live = live_rotations(package_dir)
    candidates = [live] if live is not None else []
    for bound in kept_chains(package_dir):
        joined = joined_rotations(bound, live) if live is not None else bound
        for raw in (joined, bound):
            if raw is not None and raw not in candidates:
                candidates.append(raw)
    sources = []
    for raw in candidates:
        try:
            sources.append((raw, chain_statements(package_dir, name, raw)))
        except CovenError:
            continue
    return sources


def owner_chain(package_dir, name, current, sources, operator, registry_id, min_snapshot, no_snapshot):
    """The chain an owner's rotation of a package without a recovery key builds on: (its owner
    keys, its statements). Owner keys sign hand-overs there, so a stolen earlier owner key can sign
    a second chain to the current owner through its own key (`[alice->mallory, mallory->bob]` beside
    a bound `[alice->bob]`). The operator admits only a chain that extends the one its snapshot
    binds; built on the thief's, the next index is never admitted and the package freezes (review
    of dd42df8). Authority is the pinned operator's snapshot, never the files served: only the
    sources that extend the chain it binds are taken, and they must agree. With `no_snapshot`
    (explicit, for a registry without an operator), every source reaching the owner must be the
    same chain; two that differ are refused, never chosen between."""
    if no_snapshot == (operator is not None) or (no_snapshot and min_snapshot):
        raise CovenError(f"{name} has no recovery key, so its owner rotates it on the rotations the registry's snapshot binds: "
                         f"give --operator, the pinned operator's key ID, with --registry-id (and optionally --min-snapshot), "
                         f"or --no-snapshot for a registry without an operator")
    bound, where = "none", "the registry"
    if operator is not None:
        checked_operator_id(operator)
        if registry_id is None:
            raise CovenError("a pinned operator (--operator) comes with the registry's identifier pinned beside it (--registry-id)")
        # Fresh by the owner's statement, never by what is served: a writer can serve an older
        # snapshot of the operator's, binding `none` or an earlier chain (review of 208294e).
        if min_snapshot < 1:
            raise CovenError(f"{name}: give --min-snapshot, the latest snapshot sequence of this registry known (`coven verify-snapshot`, "
                             f"or a consumer's witchy.lock), so an older snapshot the registry serves is not built on")
        # And no older than this machine has verified, whatever --min-snapshot says, with an
        # operator chain that extends the one it saw (review of 9f1b37c).
        snapshot, _, fresh = fresh_snapshot(package_dir.parent, operator, checked_registry_id(registry_id), min_snapshot)
        record_fresh(*fresh)
        entry, where = snapshot.entries.get(name), f"snapshot {snapshot.sequence}"
        # The snapshot must record this key as the owner. An older one, recording an earlier owner,
        # binds a shorter chain that a stolen earlier owner key can extend to this key its own way
        # (adversarial review of 65cab4f: a stale --min-snapshot let carol build on such a chain).
        # While the owner stays the same, the operator keeps the chain it bound, so any snapshot
        # recording this owner binds the chain the operator admits from.
        gap = ("Until then, without a recovery key, nothing holds back a thief with this key, who can rotate with --no-snapshot "
               "or other tools. Only a recovery key, named at a package's first signed publish (--recovery-key), closes that window")
        if not entry:
            raise CovenError(f"{name}: {where} does not list it with an owner: the operator's next snapshot admits it; rotate after it. {gap}")
        if entry[2] != current.signer:
            raise CovenError(f"{name}: {where} records its owner {entry[2]}, not this key {current.signer}: rotate after the operator's "
                             f"next snapshot records it (or give a later --min-snapshot). {gap}")
        bound = entry[4]
        if bound == "none":
            # This key has owned the package from its first index on: whatever rotations are served
            # or kept are not built on (a writer's junk there blocks nothing; review of 65cab4f).
            if live_rotations(package_dir) is not None or kept_chains(package_dir):
                print(f"coven: warning: {where} binds no rotations of {name}: not building on the rotations the registry serves or keeps",
                      file=sys.stderr)
            return [current.signer], []
        if bound != "none":
            live = live_rotations(package_dir)
            if live is not None and not extends_bound(live, bound):
                print(f"coven: warning: refusing {name}/rotations as served: they do not extend the rotations {where} binds "
                      f"({bound}); building on those", file=sys.stderr)
    reaching = {}
    for raw, found in sources:
        if not extends_bound(raw, bound):
            continue
        try:
            reaching.setdefault(tuple(text for text, *_ in found), (owner_keys(package_dir, name, current, "none", raw), found))
        except CovenError:
            continue
    if len(reaching) > 1:
        chains = sorted(" -> ".join(keys) for keys, _ in reaching.values())
        raise CovenError(f"{name}: two different chains of rotations reach its owner {current.signer} and extend what {where} binds "
                         f"({bound}), and neither is chosen: " + "; ".join(chains) + ". "
                         + ("Give --operator and --registry-id: the rotation builds on the chain the operator's snapshot binds"
                            if operator is None else "the operator's next snapshot binds one of them; rotate after it"))
    if reaching:
        chain, statements = next(iter(reaching.values()))
    elif bound != "none":
        raise CovenError(f"{name}: no rotations the registry keeps extend the ones {where} binds ({bound}) and reach its owner "
                         f"{current.signer}: the operator restores its copy with its next snapshot")
    else:
        chain, statements = owner_keys(package_dir, name, current, "none"), chain_statements(package_dir, name) or []
    return chain, statements


def rotate(registry, name, key, new_key, valid_days, min_sequence=0, from_index=None, from_owner=None,
           operator=None, registry_id=None, min_snapshot=0, no_snapshot=False):
    """Hand a package to a new owner key: a rotation statement signed by the package's recovery
    key (or, without one, by its owner), then the index re-signed by the new key.

    The owner rotates from its own copy of the index. A recovery key's authority is its own key,
    which consumers pinned, and not the registry's index, whose `recovery` line a stolen owner key
    can sign away (adversarial review of 7870240). It keeps the rotations valid under it, dropping
    any a stolen key signed; hands the package on from the last key they reach; restores its own
    key ID as the recovery key; and signs above any sequence served. Having never signed an
    index, it takes its base from `from_index` (the owner's copy) or the registry, no older than
    `min_sequence` and, from the registry, not expired: a registry writer may have put back an older
    one from before a withdrawal.

    Without a recovery key, the owner's rotation builds only on rotations that extend the ones the
    pinned operator's snapshot binds for the package (`operator`, `registry_id`, no older than
    `min_snapshot`), or, with `no_snapshot`, on the one chain that reaches the owner. Owner keys
    sign hand-overs there, so a stolen earlier owner key can sign a second chain to the current
    owner through its own key; built on, it is one the operator never admits, and the package
    froze (review of dd42df8)."""
    package_dir = Path(registry).resolve() / checked_name(name)
    if package_dir.is_symlink() or not package_dir.is_dir():
        raise CovenError(f"{name} is not published in {Path(registry).resolve()}")
    key, new_key = key_pair(key), key_pair(new_key)
    signer, new, new_public = key.id, new_key.id, new_key.public
    if new == signer:
        raise CovenError("the new owner key must be another key than the one signing the rotation")
    verify_ahead(package_objects(package_dir, name, signer) + ([("index", Path(from_index))] if from_index else [])
                 + [("rotation", raw) for raw in kept_chains(package_dir)]
                 + (registry_objects(package_dir.parent) if operator is not None else []))
    with index_lock(package_dir, name):
        try:
            served = read_index(package_dir, name)
        except CovenError as error:
            print(f"coven: warning: the registry's index of {name} is refused: {error}", file=sys.stderr)
            served = None
        sources = rotation_sources(package_dir, name)
        if signed_state(package_dir, name, signer).is_file() or (served is not None and served.signer == signer):
            current = base_index(package_dir, name, signer, warn=True)
            if current.recovery != "none":
                raise CovenError(f"{name} is handed to a new key only by its recovery key {current.recovery}")
            recovery = "none"
            chain, statements = owner_chain(package_dir, name, current, sources, operator, registry_id, min_snapshot, no_snapshot)
            kept = statements
        else:
            recovery = signer
            statements = chain_statements(package_dir, name) or []
            # Anchored outside the registry: the owner the operator knows (a consumer's lock has
            # it). Without it, a registry writer deletes the rotations, plants an index under its
            # own key, and the recovery key would hand the package on from that key (adversarial
            # review of ab05d8f).
            if from_owner is not None:
                checked_key_id(from_owner, "--from-owner", "owner")
            if from_owner is None:
                raise CovenError(f"this key is not {name}'s owner, so it rotates as {name}'s recovery key (by the registry's index, "
                                 f"{served.recovery if served else 'unknown'}), from the owner it knows: give --from-owner, that key's "
                                 f"key ID (a consumer's witchy.lock has it as `signer`)")
            # From the source that hands the package on to that owner under this recovery key through
            # the most statements: the bound chain when the file served was deleted or cut short.
            chain, count = [from_owner], 0
            for _, found in sources:
                reached, through = allowed_chain(found, recovery)
                if from_owner in reached and min(through, reached.index(from_owner)) > count:
                    count = min(through, reached.index(from_owner))
                    chain, statements = reached[:count + 1], found
            kept = statements[:count]
            if min_sequence < 1:
                raise CovenError(f"this key is not {name}'s owner, so it rotates as {name}'s recovery key (by the registry's index, "
                                 f"{served.recovery if served else 'unknown'}), from an index it did not sign: give --min-sequence, the latest "
                                 f"index sequence of {name} known (from the owner, or a consumer's witchy.lock), so an older one is not signed over")
            current = parse_index(signed_input(from_index), name) if from_index else served
            if current is None:
                raise CovenError(f"{name} has no index the recovery key can rotate from: give --from-index, the owner's last copy")
            if current.signer != chain[-1]:
                raise CovenError(f"the index to rotate from is signed by {current.signer}, and {name}'s rotations valid under "
                                 f"this recovery key end at {chain[-1]}: give --from-index, an index that key signed")
            # From the registry, the index must be no older than the latest known; one the operator
            # chose (`--from-index`: the owner's last copy from before a key was stolen, say) may
            # be, and the new index still signs above it.
            if from_index is None and current.sequence < min_sequence:
                raise CovenError(f"the registry serves index {current.sequence} of {name}, older than index {min_sequence}: "
                                 f"give --from-index, the owner's last copy")
            if from_index is None and current.expires < today():
                raise CovenError(f"the registry's index of {name} expired on {current.expires.isoformat()}: give --from-index, the owner's last copy")
        if new in chain:
            raise CovenError(f"{new} has owned {name} before: rotate to a new key")
        # Above every sequence known and served, but never above what the operator can admit: an
        # index served more than MAX_SEQUENCE_STEP above the one known (a stolen key's, signed far
        # ahead) is never admitted, and the rotation signs above the one known instead.
        sequence = max(current.sequence, min_sequence)
        if served is not None and served.sequence > sequence:
            if served.sequence - sequence < MAX_SEQUENCE_STEP:
                sequence = served.sequence
            else:
                print(f"coven: warning: the registry serves index {served.sequence} of {name}, more than {MAX_SEQUENCE_STEP} above "
                      f"index {sequence}, which the operator never admits; signing above index {sequence}", file=sys.stderr)
        sequence += 1
        if sequence > MAX_INDEX_SEQUENCE:
            raise CovenError(f"{name}: index {sequence} is above {MAX_INDEX_SEQUENCE}, the most an index may have: give --min-sequence, "
                             f"the sequence of the index the registry's snapshot names")
        print(f"{name}: rotating from index {current.sequence}, owner {current.signer}, recovery {current.recovery}, {len(current.entries)} versions")
        for version, (_, state, reason) in sorted(current.entries.items()):
            print(f"{name} {version}: {state}" + (f": {reason}" if reason else ""))
        if len(kept) < len(statements):
            print(f"coven: warning: dropping {len(statements) - len(kept)} rotation(s) of {name}: not signed by this recovery key, "
                  f"or after the owner it hands on from ({chain[-1]})", file=sys.stderr)
        message = rotation_message(name, chain[-1], new_public, key.public)
        statement = signed_object(message, witchy_sign("rotation", key, message)).decode("ascii")
        settle()
        handle, staged = tempfile.mkstemp(prefix=f".{ROTATIONS}.", dir=package_dir)
        with os.fdopen(handle, "w") as stream:
            stream.write("".join(text for text, *_ in kept) + statement)
        os.replace(staged, package_dir / ROTATIONS)
        write_index(package_dir, name, new_key, sequence, recovery, dict(current.entries), valid_days)
    print(f"{name}: owner {chain[-1]} -> {new} (index {sequence})")
    return True


# The registry snapshot (TUF's snapshot and timestamp roles, in one): the registry's operator,
# whose key no publisher holds, signs which index of every package is current. A client verifies
# one snapshot per resolve, against an operator key it pinned, and takes each package's index only
# as the snapshot names it, by digest: a registry writer cannot mix indexes from different moments,
# keep serving an old state past the snapshot's expiry, or hide a newer index from a client that
# has seen a newer snapshot (its floor).
SNAPSHOT = "snapshot"
SNAPSHOT_LOCK = ".snapshot.lock"
INDEXES = "indexes"
CHAINS = "chains"
OPERATOR_ROTATIONS = "operator-rotations"
SNAPSHOT_HOURS = 24
STAMP = "%Y-%m-%dT%H:%M:%SZ"
REGISTRY_ID = re.compile(r"[a-z0-9][a-z0-9.-]{0,63}")


def now():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)


def snapshot_message(registry_id, sequence, expires, entries, public, handed=()):
    """What the operator signs, as a witchy-2 object of role `snapshot` (its domain first): the
    suite and the operator's public key, the registry's identifier (a snapshot or rotation signed
    for one registry is refused by another, under the same key), a sequence that only grows, a
    time after which the snapshot is refused, and for every package either the one index current
    in this snapshot (its sequence, the SHA-384 of its exact bytes, its owner's and its recovery
    key's IDs, and the SHA-384 of the exact rotations its owner was reached through, or `none`)
    or `unsigned` (no index). Then every hand-off the operator has seen, `handed NAME KEY` (the
    key handed the package on), so the record travels with the signed snapshot to every machine
    of the operator's (review of 9cb1718): a key handed on is never admitted as owner again."""
    lines = ["coven-snapshot 4", f"suite {SUITE}", f"operator {public_key_text(public)}", f"registry {registry_id}",
             f"sequence {sequence}", f"expires {expires.strftime(STAMP)}"]
    for name in sorted(entries):
        entry = entries[name]
        lines.append(f"unsigned {name}" if entry is None else f"index {name} {' '.join(map(str, entry))}")
    lines += [f"handed {name} {key}" for name, key in sorted(handed)]
    return domain("snapshot") + ("\n".join(lines) + "\n").encode()


class Snapshot:
    def __init__(self, signer, registry, sequence, expires, entries, raw, handed=frozenset()):
        self.signer, self.registry, self.sequence, self.expires, self.entries, self.raw = signer, registry, sequence, expires, entries, raw
        self.handed = handed


def checked_registry_id(registry_id):
    if not isinstance(registry_id, str) or not REGISTRY_ID.fullmatch(registry_id):
        raise CovenError(f"invalid registry identifier {registry_id!r}: lowercase letters, digits, '.' and '-', at most 64")
    return registry_id


def parse_snapshot(raw, registry_id=None):
    """A verified snapshot from its bytes: a witchy-2 object of role `snapshot`, signed, as
    written, by the operator key it names (who that may be is the operator chain's question,
    `operator_keys`), and, given `registry_id`, for that registry. One signed with ssh-keygen or
    witchy-1, before the witchy-2 profile, is refused: no client takes an older suite."""
    old = retired_object(raw)
    if old:
        raise CovenError(f"the registry's snapshot is {old}, which no role uses any more ({SUITE} only): "
                         f"its operator signs a new one with `coven snapshot` (a new registry: the profile changed every digest)")
    malformed = CovenError("the registry's snapshot is malformed")
    message, signature = split_signed(raw, "snapshot", malformed)
    try:
        text = message[len(domain("snapshot")):].decode("ascii")
    except UnicodeDecodeError:
        raise malformed from None
    lines = text.split("\n")
    if len(lines) < 7 or lines[-1] != "" or lines[0] != "coven-snapshot 4" or lines[1] != f"suite {SUITE}" \
            or not lines[2].startswith("operator ") or not lines[3].startswith("registry ") or not REGISTRY_ID.fullmatch(lines[3][9:]) \
            or not lines[4].startswith("sequence ") or not lines[5].startswith("expires "):
        raise malformed
    try:
        public = read_public_key(lines[2][9:], "the snapshot's operator")
        sequence = int(lines[4].removeprefix("sequence "))
        expires = datetime.datetime.strptime(lines[5].removeprefix("expires "), STAMP).replace(tzinfo=datetime.timezone.utc)
    except (CovenError, ValueError):
        raise malformed from None
    entries, handed = {}, set()
    for line in lines[6:-1]:
        fields = line.split(" ")
        if len(fields) == 3 and fields[0] == "handed" and NAME.fullmatch(fields[1]) and KEY_ID.fullmatch(fields[2]) \
                and (fields[1], fields[2]) not in handed:
            handed.add((fields[1], fields[2]))
            continue
        if handed:
            raise malformed  # the hand-offs come last
        if len(fields) == 2 and fields[0] == "unsigned" and NAME.fullmatch(fields[1]) and fields[1] not in entries:
            entries[fields[1]] = None
            continue
        if len(fields) != 7 or fields[0] != "index" or not NAME.fullmatch(fields[1]) or fields[1] in entries \
                or not re.fullmatch(r"[1-9][0-9]{0,15}", fields[2]) or int(fields[2]) > MAX_INDEX_SEQUENCE \
                or not DIGEST.fullmatch(fields[3]) or not KEY_ID.fullmatch(fields[4]) \
                or not (fields[5] == "none" or KEY_ID.fullmatch(fields[5])) or not (fields[6] == "none" or DIGEST.fullmatch(fields[6])):
            raise malformed
        entries[fields[1]] = (int(fields[2]), fields[3], fields[4], fields[5], fields[6])
    if sequence < 1 or message != snapshot_message(lines[3][9:], sequence, expires, entries, public, handed):
        raise malformed
    if not witchy_verify_all([("snapshot", public, message, signature)])[0]:
        raise CovenError("the registry's snapshot's signature does not verify")
    if registry_id is not None and lines[3][9:] != registry_id:
        raise CovenError(f"the registry's snapshot is signed for registry {lines[3][9:]}, not {registry_id}")
    return Snapshot(key_id(public), lines[3][9:], sequence, expires, entries, raw, frozenset(handed))


def registry_root(registry):
    root = Path(registry).resolve()
    if not root.is_dir():
        raise CovenError(f"no registry directory at {root}")
    return root


def registry_file(path, *, signed=False):
    """Read a registry file without following its final link.

    Single signed records have an engine-defined size bound. Chain files can
    contain multiple signed records and keep their existing aggregate rules.
    """
    try:
        handle = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except FileNotFoundError:
        return None
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise CovenError(f"{path} is not a file of the registry") from None
        raise
    with os.fdopen(handle, "rb") as stream:
        status = os.fstat(handle)
        if not stat.S_ISREG(status.st_mode):
            raise CovenError(f"{path} is not a file of the registry")
        return read_signed_bytes(stream, path, status.st_size) if signed else stream.read()


def read_signed_bytes(stream, path, size):
    if size <= SIGNED_OBJECT_BYTES:
        raw = stream.read(SIGNED_OBJECT_BYTES + 1)
        if len(raw) <= SIGNED_OBJECT_BYTES:
            return raw
    raise CovenError(f"{path}: signed object exceeds {SIGNED_OBJECT_BYTES} bytes")


def signed_input(path):
    """Read an explicitly selected snapshot or index, which may use a link."""
    with Path(path).open("rb") as stream:
        return read_signed_bytes(stream, path, os.fstat(stream.fileno()).st_size)


def operator_rotation_message(registry_id, old_public, sequence, new):
    """The outgoing operator key (`from`, its whole public key, which signs this) hands the role,
    for this registry, to the key whose ID is `new`, whose first snapshot has `sequence`: every
    snapshot the outgoing key signed is below it. A witchy-2 object of role `operator-rotation`,
    so a snapshot's signature never stands for one, nor the reverse."""
    return domain("operator-rotation") + (f"coven-operator-rotation 3\nsuite {SUITE}\nregistry {registry_id}\n"
                                          f"from {public_key_text(old_public)}\nsequence {sequence}\nto {new}\n").encode()


def operator_chain(root, registry_id):
    """The registry's operator keys in order, from `operator-rotations`, and for each hand-over
    the sequence of the new key's first snapshot. Each statement hands the operator role of this
    registry (`registry_id`) from one key to the next and is signed by the key handing it over.
    ([], []) when the role was never handed on. Anything that is not one chain is refused."""
    raw = registry_file(root / OPERATOR_ROTATIONS)
    if raw is None:
        return [], []
    old = retired_object(raw)
    if old:
        raise CovenError(f"the registry's operator rotations are {old}, which no role uses any more ({SUITE} only)")
    malformed = CovenError("the registry's operator rotations are malformed")
    statements = []
    for message, signature in split_all(raw, "operator-rotation", malformed):
        try:
            lines = message[len(domain("operator-rotation")):].decode("ascii").split("\n")
        except UnicodeDecodeError:
            raise malformed from None
        if len(lines) != 7 or lines[0] != "coven-operator-rotation 3" or lines[1] != f"suite {SUITE}" \
                or not lines[2].startswith("registry ") or not REGISTRY_ID.fullmatch(lines[2][9:]) or not lines[3].startswith("from ") \
                or not re.fullmatch(r"sequence [1-9][0-9]{0,18}", lines[4]) \
                or not lines[5].startswith("to ") or not KEY_ID.fullmatch(lines[5][3:]) or lines[6] != "":
            raise malformed
        try:
            public = read_public_key(lines[3][5:], "an operator rotation's key")
        except CovenError:
            raise malformed from None
        if message != operator_rotation_message(lines[2][9:], public, int(lines[4][9:]), lines[5][3:]):
            raise malformed
        statements.append((public, message, signature, lines[2][9:], int(lines[4][9:]), lines[5][3:]))
    if not all(witchy_verify_all([("operator-rotation", public, message, signature) for public, message, signature, *_ in statements])):
        raise CovenError("an operator rotation's signature does not verify")
    chain, sequences = [], []
    for public, _, _, registry, sequence, new in statements:
        if registry != registry_id:
            raise CovenError(f"an operator rotation is signed for registry {registry}, not {registry_id}")
        old = key_id(public)  # the signer: the statement names the key that hands the role on
        if (chain and chain[-1] != old) or new == old or new in chain or (sequences and sequence <= sequences[-1]):
            raise CovenError("the registry's operator rotations are not one chain, each signed by the key it hands the role from")
        chain += [old, new] if not chain else [new]
        sequences.append(sequence)
    return chain, sequences


def operator_keys(root, anchor, signer, registry_id, served=None):
    """The operator keys from `anchor` (the key a client pinned; None: the first) to the snapshot's
    `signer`, which must be the chain's last: a key the role was handed away from signs nothing.
    A client keeps the longest chain it verified and anchors at its newest key (Grimoire's trust
    store), so a registry that serves a shorter chain, or none, does not roll it back."""
    chain = (operator_chain(root, registry_id)[0] if served is None else served) or [anchor or signer]
    start = anchor or chain[0]
    if start not in chain:
        raise CovenError(f"the registry's operator rotations do not include the pinned operator {start}")
    keys = chain[chain.index(start):]
    if keys[-1] != signer:
        raise CovenError(f"the registry's snapshot is signed by {signer}, and its operator is {keys[-1]}"
                         + (f" (handed on from {start})" if len(keys) > 1 else ""))
    return keys


def verify_snapshot(root, raw, anchor, min_sequence, registry_id, chain=None):
    """The snapshot `raw` (the registry's if None), verified: for `registry_id` (None only on first
    use), signed by the operator reached from `anchor`, not older than `min_sequence`, not
    expired. Returns it and the operator keys."""
    if raw is None:
        raw = registry_file(root / SNAPSHOT, signed=True)
        if raw is None:
            raise CovenError(f"{root} has no snapshot: its operator signs one with `coven snapshot`")
    snapshot = parse_snapshot(raw, registry_id)
    keys = operator_keys(root, anchor, snapshot.signer, snapshot.registry, chain)
    if snapshot.sequence < min_sequence:
        raise CovenError(f"the registry serves snapshot {snapshot.sequence}, older than snapshot {min_sequence} already seen")
    if snapshot.expires <= now():
        raise CovenError(f"the registry's snapshot {snapshot.sequence} expired at {snapshot.expires.strftime(STAMP)}: "
                         f"its operator must sign a new one (`coven snapshot`)")
    return snapshot, keys


def snapshot_index(package_dir, name, snapshot):
    """The index `snapshot` names for this package, from the copy kept under its sequence
    (`NAME/indexes/SEQ`), whose bytes must have the snapshot's digest; None if the snapshot lists
    the package as unsigned. (`fetch` refuses a package the snapshot does not list, first: it is
    not published yet.)"""
    entry = snapshot.entries[name]
    if entry is None:
        return None
    folder = package_dir / INDEXES
    if folder.is_symlink() or not folder.is_dir():
        raise CovenError(f"{name}: the registry does not keep the index {entry[0]} its snapshot {snapshot.sequence} names")
    raw = registry_file(folder / str(entry[0]), signed=True)
    if raw is None or digest_of(raw) != entry[1]:
        raise CovenError(f"{name}: the registry serves another index {entry[0]} than its snapshot {snapshot.sequence} names "
                         f"({entry[1]})")
    return parse_index(raw, name)


def snapshot_chain(package_dir, name, snapshot):
    """The exact rotations `snapshot` binds for this package (`NAME/chains/HEX`, whose bytes must
    have the snapshot's digest), or None if it binds none: never whatever `NAME/rotations` holds
    now, so a registry writer cannot choose whether the chain is served."""
    bound = snapshot.entries[name][4]
    if bound == "none":
        return None
    folder = package_dir / CHAINS
    raw = registry_file(folder / bound.removeprefix("sha384:")) if folder.is_dir() and not folder.is_symlink() else None
    if raw is None or digest_of(raw) != bound:
        raise CovenError(f"{name}: the registry does not keep the rotations {bound} its snapshot {snapshot.sequence} names")
    return raw


FRESHNESS = "coven-freshness 1"


def freshness_state(registry_id, operator):
    """Where this machine records the highest snapshot of a registry it has verified, and the
    operator chain it saw, under the operator key pinned (one record per registry ID and key):
    beside `coven/signed`, outside the registry, so its writers cannot lower it."""
    base = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "coven" / "snapshots"
    where = hashlib.sha384(f"{registry_id}\n{operator}".encode()).hexdigest()[:24]
    return base, f"{registry_id}-{where}"


def read_freshness(registry_id, operator):
    """(sequence, operator chain) this machine recorded for the registry under `operator`, or None
    if it has no record (a new machine: not an error). The record is opened without following a
    link; one that is a link, not a regular file, or malformed is refused, never passed over."""
    base, name = freshness_state(registry_id, operator)
    held = None
    try:
        held = os.open(base, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        handle = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=held)
        with os.fdopen(handle, "rb") as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                raise CovenError(f"{base / name} is not a file")
            raw = stream.read(1 << 20)
    except FileNotFoundError:
        return None
    except OSError as error:
        raise CovenError(f"this machine's record of the snapshots it verified ({base / name}) cannot be read: {error.strerror}") from None
    finally:
        if held is not None:
            os.close(held)
    lines = raw.decode("ascii", "replace").split("\n")
    if len(lines) != 6 or lines[0] != FRESHNESS or lines[1] != f"registry {registry_id}" or lines[2] != f"operator {operator}" \
            or not re.fullmatch(r"snapshot (0|[1-9][0-9]{0,18})", lines[3]) or not lines[4].startswith("chain") or lines[5] != "":
        raise CovenError(f"this machine's record of the snapshots it verified ({base / name}) is malformed")
    chain = lines[4][len("chain"):].split(" ")[1:]
    if not all(KEY_ID.fullmatch(key) for key in chain) or len(set(chain)) != len(chain) or (lines[4] != "chain" and not chain):
        raise CovenError(f"this machine's record of the snapshots it verified ({base / name}) is malformed")
    return int(lines[3][len("snapshot "):]), chain


def record_freshness(registry_id, operator, sequence, chain):
    """Raise the record to `sequence` (0: no snapshot of this key's) and the operator chain `chain`
    (None: keep the one recorded; taken only where it extends it): written whole under a staged
    name and renamed into place, inside a directory held without following a link, and locked
    across the read and the write, so two commands at once never lower it. Neither ever falls."""
    settle()
    base, name = freshness_state(registry_id, operator)
    base.mkdir(parents=True, exist_ok=True, mode=0o700)
    held = os.open(base, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    staged = f".{name}.{secrets.token_hex(8)}"
    try:
        fcntl.flock(held, fcntl.LOCK_EX)
        held_record = read_freshness(registry_id, operator)
        if held_record is not None:
            if chain is None or chain[:len(held_record[1])] != held_record[1]:
                chain = held_record[1]
            if held_record[0] >= sequence and held_record[1] == chain:
                return
            sequence = max(sequence, held_record[0])
        chain = chain or []
        handle = os.open(staged, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600, dir_fd=held)
        with os.fdopen(handle, "wb") as stream:
            stream.write(f"{FRESHNESS}\nregistry {registry_id}\noperator {operator}\nsnapshot {sequence}\n"
                         f"chain{''.join(' ' + key for key in chain)}\n".encode())
        os.replace(staged, name, src_dir_fd=held, dst_dir_fd=held)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(staged, dir_fd=held)
        raise
    finally:
        os.close(held)


def fresh_snapshot(root, operator, registry_id, min_snapshot, raw=None):
    """The snapshot `raw` (the registry's if None) as `verify_snapshot` checks it, and also against
    this machine's records (review of 9f1b37c and of 88c38ae):
    - no older than the highest snapshot of its signer's this machine verified, whatever
      `min_snapshot` states. Only the signer's floor: a retired key, stolen, signs any sequence,
      and that never binds its successor's snapshots;
    - on operator rotations that extend the chain recorded under every key of it;
    - not pinned to a key this machine saw handed on: a writer serving `operator-rotations` cut
      short would let that key, retired and perhaps stolen, sign a snapshot.
    Returns the snapshot, its operator keys, and what `record_fresh` records once the caller is done."""
    known = read_freshness(registry_id, operator)
    if known and operator in known[1][:-1]:
        current = known[1][-1]
        raise CovenError(f"this machine saw the operator role of registry {registry_id} handed on from {operator} "
                         f"(to {known[1][known[1].index(operator) + 1]}, now {current}): pin the current operator key, --operator {current}")
    # One read of `operator-rotations`, both verified and recorded: a writer swapping the file
    # between two reads would have the record forget a hand-over (adversarial review of 88c38ae).
    chain = operator_chain(root, registry_id)[0]
    snapshot, keys = verify_snapshot(root, raw, operator, min_snapshot, registry_id, chain)
    for key in dict.fromkeys([*chain, *keys]):
        seen = known if key == operator else read_freshness(registry_id, key)
        if seen and chain[:len(seen[1])] != seen[1]:
            raise CovenError(f"the registry's operator rotations ({' -> '.join(chain) or 'none'}) do not extend the chain this machine "
                             f"saw ({' -> '.join(seen[1])}): refused, a writer may have cut them short")
        if seen and key == snapshot.signer and snapshot.sequence < seen[0]:
            raise CovenError(f"the registry serves snapshot {snapshot.sequence}, older than snapshot {seen[0]} this machine verified")
    return snapshot, keys, (registry_id, snapshot.signer, snapshot.sequence, chain)


def record_fresh(registry_id, signer, sequence, chain, with_chain=True):
    """Record a snapshot `fresh_snapshot` accepted: its sequence as its signer's floor, and, with
    `with_chain`, the operator chain under every key of it, the keys handed away from included, so
    a later pin of any of them is checked against it. `fetch` records only the floor: a client's
    operator chain is its trust store's (Grimoire's), which can forget one a stolen retired key
    forked; a chain recorded here could not be."""
    for key in dict.fromkeys([*(chain if with_chain else []), signer]):
        record_freshness(registry_id, key, sequence if key == signer else 0, chain if with_chain else None)


def operator_state(root, ours):
    """Where the operator's machine keeps a copy of the last snapshot its key signed for this
    registry: outside the registry, so its writers cannot put back an older one under it."""
    base = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "coven" / "operator"
    return base / hashlib.sha384(f"{REGISTRY_LOCATION.get() or root}\n{ours}".encode()).hexdigest()[:24]


def base_snapshot(root, ours, registry_id=None, warn=False, min_base=None):
    """The snapshot an operator's next one builds on, and the sequence it must sign above (the
    last hand-over's): its own copy, or a later one the registry serves signed by this key
    (another machine of the operator's). (None, 0) for a registry's first snapshot.

    A snapshot of the predecessor's is never a base: the predecessor key, rotated away and
    perhaps stolen, can sign one, below the hand-over too (automated review and adversarial
    review of c00d6a6). `rotate-operator` signs the new key's first snapshot, so a new machine
    finds that one, or restores it.

    The registry's identifier comes from this key's own copy, or else from the operator
    (`registry_id`, `--id`): never from the registry's files alone, where a snapshot this key
    signed for another registry could be replayed (automated review of 56ecbf7)."""
    if min_base is not None and min_base < 1:
        raise CovenError(f"--min-base {min_base}: give the highest snapshot sequence this operator knows it signed, 1 or above")
    path = operator_state(root, ours)
    copy = parse_snapshot(signed_input(path)) if path.is_file() else None
    if copy is not None and copy.signer != ours:
        raise CovenError(f"{path} is not a snapshot signed by this key")
    # A snapshot the registry serves that does not parse, or names another registry, is refused:
    # never passed over for this machine's copy (adversarial review of 363f952). The operator
    # restores its last snapshot to the registry, or moves the bad file aside.
    served = parse_snapshot(registry_file(root / SNAPSHOT, signed=True) or b"") if (root / SNAPSHOT).exists() else None
    if served is not None and copy is not None and served.registry != copy.registry:
        raise CovenError(f"the registry serves a snapshot for registry {served.registry}, and this key's copy is of {copy.registry}: "
                         f"restore this key's last snapshot of {copy.registry} to the registry")
    if copy is not None:
        registry_id = copy.registry
    elif served is not None and registry_id is None:
        raise CovenError("this key has no copy of its last snapshot here: give --id, the registry's identifier, "
                         "which is never taken from the registry's own files")
    elif served is not None and served.registry != registry_id:
        raise CovenError(f"the registry serves a snapshot for registry {served.registry}, not {registry_id}: "
                         f"restore this key's last snapshot of {registry_id} to the registry")
    chain, sequences = operator_chain(root, registry_id) if registry_id else ([], [])
    # With operator rotations, only a snapshot this operator signed is a base, whatever --id says:
    # never a fresh start (automated review of 191617e).
    if copy is None and served is None and registry_file(root / OPERATOR_ROTATIONS) is not None:
        raise CovenError("the registry has operator rotations and no snapshot this key signed: restore the last snapshot its operator signed")
    if ours in chain[:-1]:
        raise CovenError(f"this key handed the registry's operator role on to {chain[chain.index(ours) + 1]}: it signs no snapshot")
    if chain and chain[-1] != ours:
        raise CovenError(f"the registry's operator is {chain[-1]}, not this key")
    floor = sequences[-1] if sequences else 0  # every later snapshot is above the hand-over's
    stated = ("give --min-base N, the highest snapshot sequence this operator knows it signed (from its own records, or "
              "its other machine's copy), never the sequence the registry serves")
    if served is not None and served.signer != ours:
        predecessor = chain[-2] if len(chain) > 1 else None
        if copy is not None:
            if warn:
                print(f"coven: warning: the registry serves a snapshot signed by {served.signer}, not by this key; "
                      f"signing over this key's copy {copy.sequence}", file=sys.stderr)
            base = copy
        else:
            raise CovenError(f"the registry's snapshot is signed by {served.signer}"
                             + (", which has not handed the operator role to this key" if served.signer != predecessor else
                                f", which handed the operator role to this key at snapshot {sequences[-1]}")
                             + ": restore this key's last snapshot to the registry")
    elif served is not None and copy is not None and served.sequence <= copy.sequence and served.raw != copy.raw:
        # Signed by this key, but older than this machine's copy, or another one at its sequence:
        # put back by a writer, or this machine's copy is not the operator's latest. Either way it
        # is not built over silently (adversarial review of 363f952).
        raise CovenError(f"the registry serves snapshot {served.sequence} signed by this key, "
                         + ("older than" if served.sequence < copy.sequence else "another than")
                         + f" this machine's copy {copy.sequence}: restore the operator's latest snapshot to the registry")
    elif served is not None and (copy is None or served.sequence > copy.sequence):
        # Signed by this key on another of the operator's machines: its signature, not a writer's.
        # But a writer can put back an older one of them, from before a revocation or a hand-off
        # it records (adversarial review of 384ab92): a base this machine did not keep is taken
        # only no older than the latest snapshot the operator states (`--min-base`).
        base = served
    else:
        if copy is not None and warn and served is None:
            print(f"coven: warning: the registry does not serve the snapshot {copy.sequence} this key last signed; "
                  f"signing over it from {path}", file=sys.stderr)
        base = copy
    # Whichever base is chosen, it is no older than the operator states, and the operator always
    # states it: a machine's own copy can be stale too, and a writer can put back exactly that
    # copy, which nothing here tells from the latest, so that this machine would sign a sequence
    # already signed elsewhere, without the hand-offs recorded since (adversarial review of
    # 363f952, and review of its fix: a stale machine run without --min-base still did).
    if base is not None and min_base is None:
        raise CovenError(f"the base snapshot would be snapshot {base.sequence} (" + ("the registry's" if base is served else "this machine's copy")
                         + f"): {stated}, so an older one put back is not built on")
    if min_base is not None and (base.sequence if base else 0) < min_base:
        raise CovenError(f"the base snapshot is " + (f"snapshot {base.sequence}" if base else "none") + f", older than snapshot {min_base}, "
                         f"which this operator states it signed: restore the operator's latest snapshot (to the registry, or this "
                         f"machine's copy at {path})")
    return base, floor


def operator_chain_copy(root, ours, bound):
    """Where the operator's machine keeps its own copy of the rotations an entry bound (`bound`,
    their digest): outside the registry, so a writer who deletes `NAME/rotations` and
    `NAME/chains/` does not freeze the package (adversarial review of 9cb1718)."""
    return operator_state(root, ours).parent / "chains" / bound.removeprefix("sha384:")


def bound_rotations(root, ours, name, bound):
    """The exact bytes of the rotations an entry bound, from the registry's copy or the operator's
    own, each checked against the digest; None if neither has them (or it bound none)."""
    if bound == "none":
        return None
    for path in (root / name / CHAINS / bound.removeprefix("sha384:"), operator_chain_copy(root, ours, bound)):
        try:
            raw = path.read_bytes() if path.is_file() and not path.is_symlink() else None
        except OSError:
            raw = None
        if raw is not None and digest_of(raw) == bound:
            return raw
    return None


def keep_operator_chain(root, ours, raw):
    path = operator_chain_copy(root, ours, digest_of(raw))
    if path.is_file() and path.read_bytes() == raw:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, staged = tempfile.mkstemp(prefix=".chain.", dir=path.parent)
    with os.fdopen(handle, "wb") as stream:
        stream.write(raw)
    os.replace(staged, path)


def extends_bound(rotations, bound):
    """Whether the rotations' bytes begin with exactly the rotations a snapshot bound (`bound`, their
    digest, or `none`), statement by statement: a file that is shorter, or that does not extend
    them, is not."""
    if bound == "none":
        return True
    if rotations is None:
        return False
    try:
        pieces = split_all(rotations, "rotation", ValueError())
    except ValueError:
        return False
    at = 0
    for message, signature in pieces:
        at += len(signed_object(message, signature))
        if digest_of(rotations[:at]) == bound:
            return True
    return False


def rotation_pieces(raw):
    """The rotations' bytes as their statements' exact bytes, in order, or None if they are not
    statements one after another (whatever they say: `read_chain` verifies them)."""
    try:
        pieces = [signed_object(message, signature) for message, signature in split_all(raw, "rotation", ValueError())]
    except ValueError:
        return None
    return pieces if b"".join(pieces) == raw else None


def joined_rotations(bound, served):
    """The bound rotations' bytes followed by the statements served after their longest overlap:
    the served ones that begin with the end of the bound chain (`[bob->carol, carol->dave]` over a
    bound `[alice->bob, bob->carol]`) add only `carol->dave` (adversarial review of 363f952: a
    rotation written after the file was deleted repeated the bound chain's last statement, and
    the package froze). None if the served bytes are not statements. Nothing is trusted here:
    the result is read under the recorded recovery key like any other chain."""
    ours, theirs = rotation_pieces(bound), rotation_pieces(served)
    if ours is None or theirs is None:
        return None
    for overlap in range(min(len(ours), len(theirs)), -1, -1):
        if ours[len(ours) - overlap:] == theirs[:overlap]:
            return bound + b"".join(theirs[overlap:])
    return None


def admit(package_dir, name, index, previous, rotations, handed=None, bound=None):
    """The snapshot entry for a package, given the index the registry serves now (None: no index),
    the bytes of its rotations now (None: none), read once, and the previous snapshot's entry
    (`...`: none). Returns (entry, why the previous was kept, the rotations' bytes the entry binds
    anew, if any); the entry is `...` for a package not admitted at all.

    The operator's own rules, so that a registry writer cannot get an index into a snapshot that
    its owner did not move to: a sequence only grows, and by at most MAX_SEQUENCE_STEP (so a
    stolen key cannot sign the sequence space away from the recovery key); the recovery key never
    changes; a new owner key is taken only through rotations verified under the recovery key the
    previous entry recorded (with none, from the previous owner), and an owner those rotations
    hand on signs no more. Otherwise the previous entry stays, so a writer who rolls one package
    back or plants an index under its own key holds only that package, and the owner's next update
    (from its own copy) is admitted.

    The entry binds the rotations its owner was reached through (their digest), which clients
    read instead of `NAME/rotations`: a writer cannot choose whether a chain is served.

    Fail closed (review of 9710ad0): rotations that cannot be read under the recorded recovery
    key, or that do not extend the ones the entry bound, are not taken. In their place the bound
    rotations' own bytes (`bound`, from the registry's copy or the operator's) are, with the
    statements served appended (a new rotation written over a deleted file), or alone: a writer
    who deletes or truncates them freezes nothing (adversarial review of 9cb1718). Served statements
    that begin with the end of the bound chain are appended after that overlap (`joined_rotations`,
    adversarial review of 363f952). Without the
    bound bytes, the previous entry stays. Every
    hand-off the operator sees is added to `handed` (its own record, carried in the snapshots it
    signs, so on every machine of the operator's), whose keys
    are never admitted as the package's owner again, whatever `NAME/rotations` says later."""
    handed = set() if handed is None else handed
    if index is None:
        return (None, None, None) if previous is ... else (previous, None if previous is None else "its index is gone", None)
    base = previous[0] if previous not in (..., None) else 0
    if index.sequence > base + MAX_SEQUENCE_STEP:
        return previous, f"its index {index.sequence} is more than {MAX_SEQUENCE_STEP} above " + (f"index {base}" if base else "a new entry's 0"), None
    if (name, index.signer) in handed:
        return previous, f"its index {index.sequence} is signed by {index.signer}, which this operator saw hand {name} on", None
    if previous is ... or previous is None:
        # A new entry: the rotations served must reach the index's signer, under its own
        # recovery key (a consumer's pins then check that key).
        try:
            keys = owner_keys(package_dir, name, index, index.recovery, rotations)
        except CovenError as error:
            return previous, str(error), None
        handed.update((name, key) for key in keys[:-1])
        return entry_of(index, rotations), None, rotations
    sequence, digest, owner, recovery, chain = previous
    if digest_of(index.raw) == digest:
        return previous, None, None
    if index.sequence <= sequence:
        return previous, f"it serves index {index.sequence}, not newer than index {sequence}", None
    if index.recovery != recovery:
        return previous, f"its index {index.sequence} changes the recovery key from {recovery} to {index.recovery}", None
    # The rotations served must read as one chain under the recorded recovery key and extend the
    # ones the entry bound; deleted, truncated or rewritten, the bound ones stand in for them.
    if not extends_bound(rotations, chain):
        if bound is None:
            return previous, f"its rotations do not extend the ones snapshot entry {sequence} bound ({chain}), and neither the registry nor this operator keeps those", None
        joined = joined_rotations(bound, rotations) if rotations is not None else None
        candidates = ([joined] if joined is not None and joined != bound else []) + [bound]
    else:
        candidates = [rotations]
    for rotations in candidates:
        try:
            chained = read_chain(package_dir, name, recovery, rotations) or []
            break
        except CovenError as error:
            refused = str(error)
    else:
        return previous, refused, None
    if index.signer == owner:
        # The same owner: the chain the entry bound stands. But an owner that the rotations served
        # now hand on signs no more, and the operator records the hand-off: a thief with its key,
        # racing a recovery rotation and then removing it, does not keep the package.
        if owner in chained[:-1]:
            handed.update((name, key) for key in chained[:chained.index(owner) + 1])
            return previous, f"its index {index.sequence} is signed by {owner}, which its rotations hand on to {chained[chained.index(owner) + 1]}", None
        return (index.sequence, digest_of(index.raw), owner, recovery, chain), None, None
    if not chained or chained[-1] != index.signer:
        return previous, f"{name}'s index is signed by {index.signer}, but its rotations hand it to {chained[-1] if chained else 'no one'}", None
    keys = chained
    # The rotations must hand the package on from the owner this operator recorded, with or
    # without a recovery key: a chain cut short, ending at a key handed away from (stolen), is not
    # one (adversarial review of c00d6a6). A recovery rotation hands on from the last legitimate
    # owner, which is the recorded one: a thief with an owner key cannot rotate a package that has
    # a recovery key.
    if owner not in keys[:-1]:
        return previous, f"its index {index.sequence} is signed by {index.signer}, to which {owner} did not hand it", None
    handed.update((name, key) for key in keys[:-1])
    return entry_of(index, rotations), None, rotations


def entry_of(index, rotations):
    return (index.sequence, digest_of(index.raw), index.signer, index.recovery, "none" if rotations is None else digest_of(rotations))


def keep_index(root, name, index):
    """Store the index's exact bytes as `NAME/indexes/SEQ`, the copy a snapshot names."""
    keep_copy(root, name, INDEXES, str(index.sequence), index.raw)


def keep_chain(root, name, rotations):
    """Store the rotations' exact bytes as `NAME/chains/HEX` (their SHA-384), the copy a snapshot
    binds."""
    keep_copy(root, name, CHAINS, digest_of(rotations).removeprefix("sha384:"), rotations)


def keep_copy(root, name, folder, target, raw):
    """Store `raw` as `NAME/FOLDER/TARGET`. Every directory is opened from the registry root by a
    descriptor, without following a link, so a package directory or `indexes` swapped for a link
    after a check cannot point the write elsewhere; the staged name is random, so a writer cannot
    plant it first (automated review of 56ecbf7)."""
    settle()
    directory = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    opened = []
    try:
        try:
            opened.append(os.open(root, directory))
            opened.append(os.open(name, directory, dir_fd=opened[-1]))
            try:
                os.mkdir(folder, dir_fd=opened[-1])
            except FileExistsError:
                pass
            opened.append(os.open(folder, directory, dir_fd=opened[-1]))
        except OSError:
            raise CovenError(f"{root / name / folder} is not a directory of the registry") from None
        held = opened[-1]
        try:
            with os.fdopen(os.open(target, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=held), "rb") as stream:
                if stream.read() == raw:
                    return
        except OSError:
            pass
        for _ in range(8):
            staged = f".{folder}.{secrets.token_hex(16)}"
            try:
                handle = os.open(staged, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o644, dir_fd=held)
                break
            except FileExistsError:
                continue
        else:
            raise CovenError(f"cannot stage {folder}/{target} of {name}")
        with os.fdopen(handle, "wb") as stream:
            stream.write(raw)
        os.replace(staged, target, src_dir_fd=held, dst_dir_fd=held)
    finally:
        for descriptor in reversed(opened):
            os.close(descriptor)


@contextlib.contextmanager
def snapshot_lock(root):
    try:
        held = os.open(root / SNAPSHOT_LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        raise CovenError(f"the registry's snapshot is being signed by someone else (or {root / SNAPSHOT_LOCK} was left by a stopped one)") from None
    try:
        yield
    finally:
        os.close(held)
        os.unlink(root / SNAPSHOT_LOCK)


def sign_snapshot(root, key, registry_id, sequence, entries, valid_hours, handed=()):
    """The snapshot's bytes, signed by the operator `key` in the engine and read back."""
    if not 1 <= valid_hours <= 24 * 31:
        raise CovenError("a snapshot is valid for 1 to 744 hours")
    message = snapshot_message(registry_id, sequence, now() + datetime.timedelta(hours=valid_hours), entries, key.public, handed)
    raw = signed_object(message, witchy_sign("snapshot", key, message))
    parse_snapshot(raw, registry_id)  # never write one that clients (or the next snapshot) cannot read
    return raw


def store_snapshot(root, key, raw):
    settle()
    handle, staged = tempfile.mkstemp(prefix=f".{SNAPSHOT}.", dir=root)
    with os.fdopen(handle, "wb") as stream:
        stream.write(raw)
    os.replace(staged, root / SNAPSHOT)
    path = operator_state(root, key.id)
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, staged = tempfile.mkstemp(prefix=".snapshot.", dir=path.parent)
    with os.fdopen(handle, "wb") as stream:
        stream.write(raw)
    os.replace(staged, path)


def snapshot_entries(root, ours, base, handed):
    previous = base.entries if base else {}
    entries, admitted = dict(previous), []
    for package_dir in sorted(root.iterdir()):
        name = package_dir.name
        if not NAME.fullmatch(name) or package_dir.is_symlink() or not package_dir.is_dir() \
                or not any(VERSION.fullmatch(part.name) for part in package_dir.iterdir()):
            continue
        # Read once: what is admitted is what was checked (a sequence or expiry out of bounds
        # is refused by parse_index, so no snapshot carries one).
        try:
            index = read_index(package_dir, name)
            rotations = live_rotations(package_dir)
        except CovenError as error:
            print(f"coven: warning: {name}: " + (f"kept as in snapshot {base.sequence}" if name in previous else "not admitted")
                  + f": {error}", file=sys.stderr)
            continue
        prior = previous.get(name, ...)
        bound = bound_rotations(root, ours, name, prior[4]) if prior not in (..., None) else None
        entry, kept, binds = admit(package_dir, name, index, prior, rotations, handed, bound)
        if kept:
            print(f"coven: warning: {name}: " + (f"kept as in snapshot {base.sequence}" if name in previous else "not admitted")
                  + f": {kept}", file=sys.stderr)
        elif entry is not None and index is not None and entry[1] == digest_of(index.raw):
            admitted.append((name, index, binds if entry[4] != "none" else None))
        if entry is not ...:
            entries[name] = entry
    return entries, admitted


def retain_snapshot_objects(root, ours, entries, admitted, *, signing=True):
    for name, index, rotations in admitted:
        keep_index(root, name, index)  # a no-op when the copy is already there
        if rotations is not None:
            keep_chain(root, name, rotations)
            if signing:
                keep_operator_chain(root, ours, rotations)
    # Every index and chain named must be there for clients, the kept ones included: a bound
    # chain the registry lost is restored from this operator's own copy.
    for name, entry in entries.items():
        if entry is not None and entry[4] != "none":
            held = bound_rotations(root, ours, name, entry[4])
            if held is not None:
                keep_chain(root, name, held)
                if signing:
                    keep_operator_chain(root, ours, held)
        if entry is not None and registry_file(root / name / INDEXES / str(entry[0]), signed=True) is None:
            print(f"coven: warning: {name}: the registry lost index {entry[0]}, which this snapshot names; its owner's next update replaces it",
                  file=sys.stderr)
        if entry is not None and entry[4] != "none" and registry_file(root / name / CHAINS / entry[4].removeprefix("sha384:")) is None:
            print(f"coven: warning: {name}: the registry lost the rotations {entry[4]}, which this snapshot binds; restore them to "
                  f"{root / name / CHAINS}", file=sys.stderr)


def take_snapshot(registry, key, valid_hours, registry_id=None, min_base=None, first=False, review=None):
    """The operator signs the registry's next snapshot: each package's current index, admitted by
    `admit`, kept as `NAME/indexes/SEQ`. Publishers never need this key, and a publish, yank,
    revocation, rotation or refresh reaches clients with the next snapshot. The first snapshot
    names the registry (`--id`); every later one keeps that identifier."""
    root = registry_root(registry)
    ours = key.id
    # Every signature the snapshot rests on, in one engine run: each is still decided as parsed.
    verify_ahead(registry_objects(root, ours) + [item for package_dir in sorted(root.iterdir()) if NAME.fullmatch(package_dir.name)
                                                 for item in package_objects(package_dir, package_dir.name)[:2]])
    with snapshot_lock(root):
        base, floor = base_snapshot(root, ours, registry_id, warn=True, min_base=min_base)
        handed = set(base.handed) if base else set()
        # The registry's first snapshot is the operator's explicit choice (`--first`): no snapshot
        # served, and no copy here, is also what a writer who deleted the registry's shows a new
        # machine, which would sign sequence 1 again without the hand-offs recorded (review of
        # 2a41f8b).
        if base is None and not first:
            raise CovenError("the registry serves no snapshot and this machine has no copy of this key's last one: restore the "
                             "operator's latest snapshot to the registry, or, for the registry's very first snapshot, give --first")
        if base is not None and first:
            raise CovenError(f"--first: the registry already has snapshot {base.sequence} of this key's")
        if base is None and registry_id is None:
            raise CovenError("the registry's first snapshot names the registry: give --id, the identifier clients pin with the operator key")
        if base is not None and registry_id is not None and registry_id != base.registry:
            raise CovenError(f"this registry's identifier is {base.registry}, set by its first snapshot: it does not change")
        registry_id = checked_registry_id(base.registry if base else registry_id)
        entries, admitted = snapshot_entries(root, ours, base, handed)
        if review is not None:
            review(root, base, entries)
        sequence = max(base.sequence if base else 0, floor) + 1
        # Signed first: the signer verifies every signature these entries rest on before it signs
        # (`deferred`), and only then is anything written. The snapshot is stored last, so every
        # index it names is kept before a client can read it.
        raw = sign_snapshot(root, key, registry_id, sequence, entries, valid_hours, handed)
        retain_snapshot_objects(root, ours, entries, admitted)
        store_snapshot(root, key, raw)
    for name, entry in sorted(entries.items()):
        print(f"{name}: " + ("unsigned" if entry is None else f"index {entry[0]}"))
    print(f"snapshot {sequence} of registry {registry_id}, valid for {valid_hours} hours")
    return True


def rotate_operator(registry, key, new_key, valid_hours, registry_id=None, min_base=None):
    """Hand the registry's operator role to a new key: a statement signed by the current operator
    key, naming the registry and the sequence of the new key's first snapshot, then that snapshot,
    signed by the new key, its entries unchanged. Both are signed before either is written."""
    root = registry_root(registry)
    old, new = key.id, new_key.id
    if new == old:
        raise CovenError("the new operator key must be another key")
    verify_ahead(registry_objects(root, old))
    with snapshot_lock(root):
        base, floor = base_snapshot(root, old, registry_id, warn=True, min_base=min_base)
        if base is None:
            raise CovenError("the registry has no snapshot signed by this key to hand on")
        if registry_id is not None and registry_id != base.registry:
            raise CovenError(f"this registry's identifier is {base.registry}, set by its first snapshot: it does not change")
        chain, _ = operator_chain(root, base.registry)
        if new in chain:
            raise CovenError(f"{new} has been the registry's operator before: rotate to a new key")
        sequence = max(base.sequence, floor) + 1
        message = operator_rotation_message(base.registry, key.public, sequence, new)
        statement = signed_object(message, witchy_sign("operator-rotation", key, message))
        first = sign_snapshot(root, new_key, base.registry, sequence, base.entries, valid_hours, base.handed)
        existing = registry_file(root / OPERATOR_ROTATIONS) or b""
        settle()
        handle, staged = tempfile.mkstemp(prefix=f".{OPERATOR_ROTATIONS}.", dir=root)
        with os.fdopen(handle, "wb") as stream:
            stream.write(existing + statement)
        os.replace(staged, root / OPERATOR_ROTATIONS)
        store_snapshot(root, new_key, first)
    print(f"operator {old} -> {new} (snapshot {sequence})")
    return True


def check_snapshot(registry, anchor, registry_id, min_sequence, keep):
    """Verify the registry's snapshot for a client, print what it verified, and keep its exact
    bytes for the client's fetches: one snapshot for a whole resolve. A pinned operator comes with
    the registry identifier pinned beside it; only a first use (neither) takes both as served."""
    if anchor is not None:
        checked_operator_id(anchor)
    if (anchor is None) != (registry_id is None):
        raise CovenError("a pinned operator (--operator) and the registry's identifier (--registry-id) are given together")
    if registry_id is not None:
        checked_registry_id(registry_id)
    root = registry_root(registry)
    verify_ahead(registry_objects(root))
    snapshot, keys = verify_snapshot(root, None, anchor, min_sequence, registry_id)
    if keep is not None:
        settle()  # its signatures verified (one run of verify.wy) before its bytes are kept
        Path(keep).write_bytes(snapshot.raw)
    print(f"snapshot {snapshot.sequence}")
    print(f"registry {snapshot.registry}")
    print(f"operators {' '.join(keys)}")
    print(f"expires {snapshot.expires.strftime(STAMP)}")
    return True


def released_catalog(args, root, request=None):
    """List active release coordinates from one verified operator snapshot."""
    import json
    checked_operator_id(args.operator)
    checked_registry_id(args.registry_id)
    verify_ahead(registry_objects(root))
    snapshot, _, freshness = fresh_snapshot(root, args.operator, args.registry_id, args.min_snapshot)
    settle()  # No request for an index can be induced by an unverified snapshot.
    entries = {name: entry for name, entry in snapshot.entries.items() if entry is not None}
    if len(entries) > 64:
        raise CovenError("catalog exceeds 64 signed packages")
    rows = []
    for name, entry in sorted(entries.items()):
        sequence, _, signer, recovery, chain = entry
        if request is not None:
            received(root, ["packages", name, "index", str(sequence), chain], request)
        package = root / name
        index = snapshot_index(package, name, snapshot)
        if (index.sequence, index.signer, index.recovery) != (sequence, signer, recovery):
            raise CovenError(f"{name}: its index disagrees with the verified snapshot")
        if index.expires < today():
            raise CovenError(f"{name}: its catalog index expired on {index.expires}")
        rotations = snapshot_chain(package, name, snapshot)
        owner_keys(package, name, index, recovery, rotations)
        for version, (digest, state, _) in sorted(index.entries.items()):
            if state == "active":
                rows.append({"name": name, "version": version, "digest": digest})
                if len(rows) > 64:
                    raise CovenError("catalog exceeds 64 active releases")
    settle()
    record_fresh(*freshness, with_chain=False)
    print(json.dumps({"registry": snapshot.registry, "sequence": snapshot.sequence,
                      "snapshot": digest_of(snapshot.raw), "releases": rows},
                     separators=(",", ":"), sort_keys=True))
    return True


def owner_check(package_dir, name, key, version=None, recovery=None):
    """Refuse, before anything is written, a publish whose index update would be refused: by
    anyone but the package's owner (once a package has an index, every version of it is signed by
    that key, and fetch admits no other), or one that would start an index over another key's
    signed versions."""
    if key is None:
        current = read_index(package_dir, name)
        if current is not None:
            raise CovenError(f"{name} is owned by {current.signer}: publish it signed, with that key")
        return
    ours = key.id
    verify_ahead(package_objects(package_dir, name, ours))
    current = base_index(package_dir, name, ours)
    if current is not None and ours != current.signer:
        raise CovenError(f"{name} is owned by {current.signer}: only its key can publish signed versions of it")
    if current is not None and recovery is not None and recovery != current.recovery:
        raise CovenError(f"{name}'s recovery key is {current.recovery}, set by its first index: it does not change")
    if current is None:
        first_entries(package_dir, name, ours, version)


def withdraw(registry, name, version, state, reason, key):
    """Yank or revoke a version: its state in the package's index, re-signed by the package's
    owner, whichever owner key signed the release (after a recovery, the new owner withdraws what a
    stolen key published: adversarial review of 7870240)."""
    if not REASON.fullmatch(reason or ""):
        raise CovenError("the reason is one line of printable ASCII, at most 200 characters")
    target = real_slot(slot(registry, name, version))

    def change(entries):
        listed = entries.get(version)
        if listed is None:
            raise CovenError(f"{name}'s index does not list {version}")
        if state == "yanked" and listed[1] == "revoked":
            raise CovenError(f"{name} {version} is revoked; a revocation is not undone by a yank")
        entries[version] = (listed[0], state, reason)
    sequence = update_index(target.parent, name, key, change)
    print(f"{name} {version}: {state}: {reason} (index {sequence})")
    return True


def refresh(registry, name, key, valid_days):
    """Re-sign the package's index unchanged, with a later expiry: an owner does this before it
    expires, or every signed version of the package stops being fetchable."""
    package_dir = Path(registry).resolve() / checked_name(name)
    if package_dir.is_symlink() or not package_dir.is_dir():
        raise CovenError(f"{name} is not published in {Path(registry).resolve()}")
    sequence = update_index(package_dir, name, key, lambda entries: None, valid_days)
    print(f"{name}: index {sequence}, valid for {valid_days} days")
    return True


def report(name, version, verdict):
    refused = verdict.startswith("refused")
    print(f"{name} {version}: {verdict}", file=sys.stderr if refused else sys.stdout)
    return not refused


def record(name, version, requires):
    """The `package` record publish.wy stores for a package of one file: canonical, so equal
    manifests give equal bytes. A package of several files has a `witchy-package 2` record,
    which lists them (`release_format().pack`)."""
    return release_format().record(name, version, requires)


def slot_bytes(path):
    """A slot's file, at most a version's bytes of it, or None unless it is a regular file there
    (never through a link): read to check it, never instead of the program that verifies it."""
    try:
        handle = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    with os.fdopen(handle, "rb") as stream:
        if not stat.S_ISREG(os.fstat(handle).st_mode):
            return None
        return stream.read(PACKAGE_BYTES + 1)


def checked_release(package, source, name=None, version=None):
    """The release a slot's two files are (`package`, then `source.wy`), parsed: canonical, of
    this coordinate, and for several files exactly the files its record lists, each with its
    digest and inside the package (witchy_release.py). Every command that accepts, serves to a
    client or shows a release reads it through here."""
    try:
        return release_format().parse(package, source, name, version)
    except ValueError as error:
        raise CovenError(str(error)) from None


def inspect_release(path):
    # The guest reads the selected file once. Validate its canonical metadata
    # before displaying any of the bytes supplied by the release.
    path = path.resolve(strict=True)
    if not path.is_file():
        raise CovenError("inspect requires a regular release file")
    with tempfile.TemporaryDirectory(prefix="coven-") as temp:
        temp = Path(temp).resolve()
        flags = witchy_flags("inspect", ["[files]", f"bundle = {toml_string(path)}"], temp)
        max_output = PACKAGE_BYTES + len("sha384:") + 96 + 1  # record and one digest line
        ran = subprocess.run([tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host"), witchy_module("inspect"),
                              *flags, *run_limits([]), f"--fs-bytes={PACKAGE_BYTES + 1}", f"--output-bytes={max_output}"],
                             stdin=subprocess.DEVNULL, capture_output=True, env={})
    if ran.returncode:
        raise CovenError("cannot inspect release: " + ran.stderr.decode(errors="replace").strip())
    digest, _, metadata = ran.stdout.partition(b"\n")
    if not DIGEST.fullmatch(digest.decode("ascii", "replace")):
        reason = {b"refused: out of memory", b"refused: release exceeds the supported size",
                  b"refused: incomplete package record", b"refused: could not hash release"}
        raise CovenError(digest.decode() if digest in reason else "invalid inspection result")
    # The files of a release are in its body, which the guest hashed and does not print: the
    # bytes read here are the ones it hashed (the same digest), and they are parsed whole.
    with path.open("rb") as stream:
        payload = stream.read(PACKAGE_BYTES + 1)
    print("\n".join(inspected(digest.decode(), metadata, payload)))


def inspected(digest, metadata, payload):
    """What `inspect` prints of a release: `payload`, which must hash to `digest` and begin with
    the record the guest printed, parsed as every reader parses it."""
    if digest_of(payload) != digest or not payload.startswith(metadata) or not metadata.endswith(b"\n\n"):
        raise CovenError("the release changed while it was inspected")
    release = checked_release(metadata, payload[len(metadata):])
    lines = [f"{release.name} {release.version}"]
    lines += [f"requires {dependency} {exact}" for dependency, exact in sorted(release.requires.items())]
    if release.format != 1:
        lines.append(f"entry {release.entry}")
        lines += [f"file {file} {length} {pin}" for file, length, pin in release.listing()]
    return lines + [digest]


def publication_source(package, *, manifest_pin=None):
    from coven_tuf_publish import directory

    manifest = (package / "witchy.toml" if package.is_dir() else package).resolve()
    if manifest_pin is not None:
        if not DIGEST.fullmatch(manifest_pin):
            raise CovenError("invalid package manifest SHA-384 pin")
        if package != manifest:
            raise CovenError("a manifest pin requires the absolute, resolved manifest path")
    root = manifest.parent
    with directory(root) as package_fd:
        reader = shipped_module("coven_manifest.py", MANIFEST_READER_DIGEST,
                                "_coven_manifest_" + MANIFEST_READER_DIGEST, "manifest reader")
        host = tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
        try:
            module_args = reader.installed_arguments(HERE)
            if module_args is None:
                module_args = (witchy_module("read_package_manifest", reader.BUILD),)
            name, version, source, requires, checked = reader.read_package_manifest(
                manifest, package_fd, module_args, host, subprocess.run, manifest_pin)
        except ValueError as error:
            raise CovenError(str(error)) from None
        if not source:
            raise CovenError("[package].source must name the package's source file")
        # Only a file of the package itself: no absolute path, and nothing outside the package's
        # directory once symlinks are resolved, so a manifest cannot publish another file.
        if Path(source).is_absolute():
            raise CovenError("[package].source is a path inside the package directory, not an absolute path")
        source = (root / source).resolve()
        if not source.is_relative_to(root) or source == root:
            raise CovenError(f"[package].source must name a file inside the package directory {root}")
        test_entry = root / "test.wy"
        test_members = root / "tests"
        try:
            tests = stat.S_ISREG(os.stat("test.wy", dir_fd=package_fd).st_mode)
        except FileNotFoundError:
            tests = False
        if tests and source.exists() and (source.samefile(test_entry) or
                test_members.is_dir() and any(parent.samefile(test_members) for parent in source.parents)):
            raise CovenError("a release contains the production source, not a package test member")
        if not source.is_file():
            raise CovenError(f"no source file at {source}")
        if not checked:
            # Earlier pinned workers projected the fields without checking release coordinates.
            checked_name(name)
            checked_version(version)
            for dependency, exact in requires.items():
                checked_version(exact)
                if checked_name(dependency) == name:
                    raise CovenError(f"{name} cannot depend on itself")
        with directory(root) as current:
            if not os.path.samestat(os.fstat(package_fd), os.fstat(current)):
                raise CovenError("package directory changed while reading the manifest")
        payload = packed_release(name, version, requires, package_fd, source.relative_to(root), tests)
        return name, version, requires, payload


def packed_release(name, version, requires, package_fd, source, tests):
    """The release's payload: the record, then the source, or for a source that imports files of
    its own directory, every file it reaches (witchy_release.py). The entry is relative
    to the held package directory. Each source file is opened through its parent's handle,
    as a regular file with one name. A file is read once, and those bytes are packed."""
    codec = release_format()
    # A release path, from the manifest's directory: what a package test member is told by.
    prefix = source.parent.parts
    def test_member(path):
        parts = prefix + tuple(path.split("/"))
        return tests and (parts == ("test.wy",) or parts[0] == "tests")
    handles = []
    try:
        current = package_fd
        for part in prefix:
            current = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=current)
            handles.append(current)
        files = codec.read_package(current, source.name, test_member)
        return codec.pack(name, version, requires, source.name, files)
    except codec.ReleaseError as error:
        raise CovenError(f"{name} {version}: {error}") from None
    finally:
        for handle in handles:
            os.close(handle)


def publish(package, registry, key=None, recovery_key=None, *, manifest_pin=None):
    name, version, requires, bundle = publication_source(package, manifest_pin=manifest_pin)
    key = key_pair(key) if key is not None else None
    target = slot(registry, name, version)
    for dependency, exact in requires.items():
        # Only on what is published: every edge of a published package can be fetched.
        recorded = slot(registry, dependency, exact) / "digest"
        if not recorded.is_file():
            raise CovenError(f"{name} {version} requires {dependency} {exact}, which is not published in {Path(registry).resolve()}")
        if RETIRED_DIGEST.fullmatch(recorded.read_text()):
            raise retired_digest(f"{dependency} {exact}'s recorded digest", "registry")
    # Bootstrap: the directories. The claim on the version is publish.wy's `digest` file.
    real_slot(target)
    settle()
    target.mkdir(parents=True, exist_ok=True)
    before = identity(real_slot(target))
    # One bundle, the record and then the source (main takes one file): publish.wy hashes it
    # whole and splits it into `package` and `source.wy` as it stores it. For several files the
    # record lists them and the source is their bytes in that order (`packed_release`).
    if len(bundle) > PACKAGE_BYTES:
        raise CovenError(f"{name} {version}: the package record and source are {len(bundle)} bytes, more than a version holds ({PACKAGE_BYTES})")
    published = (target / "digest").exists() or (target / "digest").is_symlink()
    if published and (target / "digest").is_file() and RETIRED_DIGEST.fullmatch((target / "digest").read_text()):
        raise retired_digest(f"{name} {version}'s recorded digest", "registry")
    present = {entry.name for entry in target.iterdir()}
    # A signature or status planted in an unclaimed slot would be taken as this version's
    # (review: a squatter's signature survived a refused signed publish). Nothing is written.
    # The one exception is a signed publish that stopped after signing: its own signature, over
    # this same digest, is all the slot holds, and `sign` below refuses any other.
    if not published and present and not (key is not None and present == {SIGNATURE}):
        raise CovenError(f"{target} holds files but no published version: remove them before publishing")
    recovery = None
    if recovery_key is not None:
        if key is None:
            raise CovenError("--recovery-key is set with the first signed publish (--key)")
        recovery = public_key_file(recovery_key)
        if recovery == key.id:
            raise CovenError("the recovery key must be another key than the owner's")
    owner_check(target.parent, name, key, version, recovery)
    if key is not None and not published:
        # A new version is signed before it is stored, so the publisher's signature claims the
        # slot first: a signature that got there earlier refuses the publish before anything
        # else is written. publish.wy must then store exactly the digest that was signed.
        sign(target, name, version, digest_of(bundle), key)
    with tempfile.TemporaryDirectory(prefix="coven-") as temp:
        temp = Path(temp).resolve()
        (temp / "bundle").write_bytes(bundle)
        verdict = run_program("publish", {
            "files": {"bundle": toml_string(temp / "bundle")},
            "dirs": {"slot": "{ root = %s }" % toml_string(target), "record": "{ root = %s }" % toml_string(target)},
        }, temp)
    unchanged(target, before)
    if not report(name, version, verdict):
        return False
    if key is not None:
        # The signature, checked against the digest publish.wy actually stored (or, republishing
        # a version, signed now and kept only if it is the version's first signer).
        digest = verdict.split()[-1]
        signer = sign(target, name, version, digest, key)
        print(f"{name} {version}: signed by {signer}")

        def change(entries):
            if entries.get(version, (digest,))[0] != digest:
                raise CovenError(f"{name}'s index lists {version} with another digest")
            entries.setdefault(version, (digest, "active", ""))
        print(f"{name}: index {update_index(target.parent, name, key, change, recovery=recovery, publishing=version)}")
    return True


def verify_ahead(objects):
    """Verify, in one engine run, the signed objects among `objects` ((role, bytes or a path of
    the registry's)) before they are parsed, so that their parsers find each verdict made
    (`witchy_verify_all` keeps them). Nothing is decided here: an object that cannot be framed, or
    a file that is not one, is left to its parser to refuse. Each object's key is the first
    whole witchy-2 public key its body names (`signer`, `operator` or `from`).

    A command that defers (`deferred`) needs none of this: it verifies exactly the objects its
    decision read, in the engine run that acts. Ahead of time, an object it never reads (the
    `NAME/index` a snapshot does not name) would hold up a run that does not rest on it."""
    if _DEFERRED is not None:
        return
    items = []
    for role, raw in objects:
        if isinstance(raw, Path):
            try:
                raw = registry_file(raw, signed=role not in ("rotation", "operator-rotation"))
            except (OSError, CovenError):
                raw = None
        try:
            pieces = split_all(raw or b"", role, ValueError())
        except ValueError:
            continue
        for message, signature in pieces:
            for line in message[len(domain(role)):].split(b"\n"):
                fields = line.split(b" ")
                public = strict_base64(fields[2].decode("ascii", "replace"), PUBLIC_KEY_BYTES) if len(fields) == 3 and fields[1] == SUITE.encode() else None
                if public is not None:
                    items.append((role, public, message, signature))
                    break
    if items:
        witchy_verify_all(items)


def package_objects(package_dir, name, ours=None):
    """A package's signed objects for `verify_ahead`: its index, its rotations, every version's
    release signature, and with `ours` (an owner key's ID) that key's own copy of the index."""
    objects = [("index", package_dir / INDEX), ("rotation", package_dir / ROTATIONS)]
    if ours is not None:
        objects.append(("index", signed_state(package_dir, name, ours)))
    if package_dir.is_dir() and not package_dir.is_symlink():
        objects += [("release", version / SIGNATURE) for version in sorted(package_dir.iterdir()) if VERSION.fullmatch(version.name)]
    return objects


def registry_objects(root, ours=None):
    """The registry's own signed objects for `verify_ahead`: its snapshot and operator rotations,
    and with `ours` (an operator key's ID) that key's own copy of its last snapshot."""
    objects = [("snapshot", root / SNAPSHOT), ("operator-rotation", root / OPERATOR_ROTATIONS)]
    return objects + ([("snapshot", operator_state(root, ours))] if ours is not None else [])


def listing(index, owners, name, version, recorded, signer, min_sequence, expect_owner, expect_recovery):
    """Why the package's index does not admit this version, or None if it does. A package with
    an index admits only the versions it lists, with their digests, signed by one of its owner
    keys (`owners`, oldest first); a signed version needs an index (a missing one hid every yank
    and revocation). A consumer's pinned owner must be one of the package's owner keys, the index
    signed by the last (the owner handed the package on by rotation), and its pinned recovery key
    the index's."""
    if index is None:
        if signer is not None:
            return "it is signed, and its package has no index: the registry has lost or removed it"
        if min_sequence:
            return f"its package has no index, and index {min_sequence} was already seen"
        if expect_owner is not None:
            return f"unsigned, not by the expected {expect_owner}"
        return None
    if index.sequence < min_sequence:
        return f"the registry serves index {index.sequence} of {name}, older than index {min_sequence} already seen"
    if index.expires < today():
        return f"{name}'s index expired on {index.expires.isoformat()}: its owner must run `coven refresh`"
    entry = index.entries.get(version)
    if entry is None or entry[0] != recorded:
        return f"{name}'s index, signed by its owner {index.signer}, does not list this version" + (" with this digest" if entry else "")
    if signer not in owners:
        return f"{'unsigned' if signer is None else f'signed by {signer}'}, and {name} is owned by {index.signer}"
    if expect_owner is not None and expect_owner not in owners:
        return f"owned by {index.signer}, not by the expected {expect_owner} nor a key it was handed to (owners {' '.join(owners)})"
    if expect_recovery is not None and expect_recovery != index.recovery:
        return f"{name}'s recovery key is {index.recovery}, not the expected {expect_recovery}"
    return None


def fetch(registry, name, version, into, expect, expect_signer=None, min_sequence=0, expect_recovery=None,
          operator=None, snapshot_file=None, min_snapshot=0, no_snapshot=False, registry_id=None):
    """Fetch a version. With a pinned operator, the snapshot is checked against this machine's record
    of the snapshots and operator chain it verified (`fresh_snapshot`), and recorded once the fetch
    is decided: after its engine run verified every signature, or a refusal's settled them."""
    fresh = []
    result = fetch_decided(registry, name, version, into, expect, expect_signer, min_sequence, expect_recovery,
                           operator, snapshot_file, min_snapshot, no_snapshot, registry_id, fresh)
    if fresh:
        record_fresh(*fresh[0], with_chain=False)
    return result


def fetch_decided(registry, name, version, into, expect, expect_signer, min_sequence, expect_recovery,
                  operator, snapshot_file, min_snapshot, no_snapshot, registry_id, fresh):
    # Fail closed: a fetch verifies the registry's snapshot against a pinned operator, unless it
    # says it does not (a registry without an operator; only each package's own checks then hold).
    if no_snapshot == (operator is not None) or (no_snapshot and (snapshot_file is not None or min_snapshot)):
        raise CovenError("fetch verifies the registry's snapshot: give --operator, the pinned operator's key ID "
                         "(and optionally --snapshot, --min-snapshot), or --no-snapshot for a registry without an operator")
    if operator is not None:
        checked_operator_id(operator)
    if (operator is None) != (registry_id is None):
        raise CovenError("a pinned operator (--operator) comes with the registry's identifier pinned beside it (--registry-id)")
    if registry_id is not None:
        checked_registry_id(registry_id)
    if expect is not None and RETIRED_DIGEST.fullmatch(expect):
        raise retired_digest(f"--expect {expect} (a locked digest)", "lock")
    if expect is not None and not DIGEST.fullmatch(expect):
        raise CovenError(f"invalid digest {expect!r}: sha384:<96 lowercase hex digits>")
    if expect_signer is not None:
        checked_key_id(expect_signer, "--expect-signer", "owner")
    if expect_recovery is not None and expect_recovery != "none":
        checked_key_id(expect_recovery, "--expect-recovery", "recovery")
    # Every signature this fetch checks is verified by fetch.wy, in its one engine run, before it
    # reads the slot (`deferred`). Without deferral (a fetch decided again after a signature that
    # does not verify, or a caller of this function), every signature it may check is verified
    # ahead in one run of verify.wy (`verify_ahead`); either way each is decided where it is parsed.
    root = registry_root(registry)
    package_dir = root / checked_name(name)
    held_snapshot = signed_input(snapshot_file) if snapshot_file else None
    ahead = [("snapshot", held_snapshot if held_snapshot is not None else root / SNAPSHOT), ("operator-rotation", root / OPERATOR_ROTATIONS),
             ("release", package_dir / checked_version(version) / SIGNATURE), ("index", package_dir / INDEX), ("rotation", package_dir / ROTATIONS)]
    verify_ahead(ahead if operator is not None else ahead[2:])
    snapshot = None
    if operator is not None:
        # One snapshot: the one the client kept for its whole resolve, or the registry's.
        # No older than this machine verified, on an operator chain extending the one it saw.
        snapshot, _, checked = fresh_snapshot(root, operator, registry_id, min_snapshot, held_snapshot)
        fresh.append(checked)
        print(f"{name} {version}: snapshot {snapshot.sequence}", flush=True)
    source = real_slot(slot(registry, name, version))
    if snapshot is not None and name not in snapshot.entries:
        return report(name, version, f"refused: {name} is not in the registry's snapshot {snapshot.sequence}: not published yet, "
                                     f"until the registry's operator signs a snapshot with it")
    if not source.is_dir():
        raise CovenError(f"{name} {version} is not published in {Path(registry).resolve()}")
    before = identity(source)
    # The signature is checked first, over the digest the registry records; fetch.wy then
    # checks the source against that record, and the two must be the same digest.
    recorded = (source / "digest").read_text() if (source / "digest").is_file() and not (source / "digest").is_symlink() else ""
    if RETIRED_DIGEST.fullmatch(recorded):
        raise retired_digest(f"{name} {version}'s recorded digest", "registry")
    signer = signer_of(source, name, version, recorded) if DIGEST.fullmatch(recorded) else None
    # With a snapshot, exactly the index it names for this package, by digest: never whichever
    # index the registry serves as NAME/index now.
    index = snapshot_index(source.parent, name, snapshot) if snapshot is not None else read_index(source.parent, name)
    # And exactly the rotations it binds, never `NAME/rotations` as it is now.
    rotations = snapshot_chain(source.parent, name, snapshot) if snapshot is not None and index else LIVE
    # A pinned owner reaches a rotated package only through rotations checked against the pinned
    # recovery key: without one, the chain would be checked against the index's own claim.
    if index and expect_recovery is not None and expect_recovery != index.recovery:
        return report(name, version, f"refused: {name}'s recovery key is {index.recovery}, not the expected {expect_recovery}")
    if index and expect_signer is not None and expect_signer != index.signer and expect_recovery is None:
        rotated = (source.parent / ROTATIONS).exists() if rotations is LIVE else rotations is not None
        return report(name, version, f"refused: {name} is owned by {index.signer}, not by the expected {expect_signer}"
                                     + ("; following its rotations needs the pinned recovery key (--expect-recovery)" if rotated else ""))
    owners = owner_keys(source.parent, name, index, expect_recovery or index.recovery, rotations) if index else []
    refusal = listing(index, owners, name, version, recorded, signer, min_sequence, expect_signer, expect_recovery)
    if refusal:
        return report(name, version, f"refused: {refusal}")
    entry = index.entries[version] if index else None
    withdrawn = entry[1:] if entry and entry[1] != "active" else None
    # What the index says, verified, before any refusal for withdrawal: a client keeps the floor
    # and owners it has now seen even when this version is refused (adversarial review of acd0582).
    if index:
        print(f"{name} {version}: owner {index.signer}")
        print(f"{name} {version}: owners {' '.join(owners)}")
        print(f"{name} {version}: recovery {index.recovery}")
        print(f"{name} {version}: index {index.sequence}", flush=True)
    # The key the consumer pinned, held outside the registry: a release signed by another key,
    # or not signed, is refused before anything is copied.
    # Withdrawal is enforced here, for every client, before anything is copied: a revoked version
    # is never fetched, and a yanked one only against a digest already locked (automated review).
    if withdrawn and withdrawn[0] == "revoked":
        return report(name, version, f"refused: revoked by its publisher: {withdrawn[1]}")
    if withdrawn and expect is None:
        return report(name, version, f"refused: yanked by its publisher: {withdrawn[1]}; only a lock that already has it may fetch it")
    into = Path(into).resolve()
    # The engine is granted `into` itself, so it must be there. Made for this fetch, it (and its
    # missing parents) is removed again unless fetch.wy decided: if a signature does not verify,
    # fetch.wy reads nothing and the directory is gone again, as if it was never made (a refusal
    # of fetch.wy's own, after every signature verified, leaves it empty, as before deferral).
    made = [part for part in [into, *into.parents] if not os.path.lexists(part)]
    into.mkdir(parents=True, exist_ok=True)
    verdict = None
    try:
        with tempfile.TemporaryDirectory(prefix="coven-") as temp:
            temp = Path(temp).resolve()
            expected = temp / "expected"
            authorized = recorded if DIGEST.fullmatch(recorded) else ""
            expected.write_text("\n".join((name, version, authorized, expect or "")), encoding="ascii")
            verdict = run_program("fetch", {
                "dirs": {"slot": "{ root = %s }" % toml_string(source), "cache": "{ root = %s }" % toml_string(into)},
                "files": {"expected": toml_string(expected)},
            }, temp)
    finally:
        if verdict is None:
            for part in made:
                try:
                    os.rmdir(part)
                except OSError:
                    break
    unchanged(source, before)
    if not verdict.startswith("refused"):
        # The worker judged the format before committing. Check that the published pair
        # still holds those bytes and the same record boundary.
        package, body = (slot_bytes(into / part) for part in ("package", "source.wy"))
        if (verdict != f"verified {recorded}" or package is None or body is None
                or len(package) + len(body) > PACKAGE_BYTES
                or not package.endswith(b"\n\n") or package.find(b"\n\n") != len(package) - 2
                or digest_of(package + body) != recorded):
            for part in ("package", "source.wy"):
                (into / part).unlink(missing_ok=True)
            verdict = "refused: the registry's release is not a release this tool builds from: what was kept is not the release that was verified"
    elif verdict == "refused: the registry's release is not a release this tool builds from":
        # The worker has already refused without writing anything. Preserve the detailed
        # format diagnostic when the slot still contains the same release.
        package, body = (slot_bytes(source / part) for part in ("package", "source.wy"))
        if package is not None and body is not None and len(package) + len(body) <= PACKAGE_BYTES \
                and digest_of(package + body) == recorded:
            try:
                checked_release(package, body, name, version)
            except CovenError as error:
                verdict += f": {error}"
    if not report(name, version, verdict):
        return False
    print(f"{name} {version}: signed by {signer}" if signer else f"{name} {version}: unsigned")
    if withdrawn:
        print(f"{name} {version}: {withdrawn[0]}: {withdrawn[1]}")
    return True


def http():
    # The companion installed with this executable, independent of the project's import path.
    import types
    if not hasattr(http, "module"):
        path = HERE / "coven_http.py"
        module = types.ModuleType("coven_http")
        exec(compile(path.read_bytes(), str(path), "exec"), module.__dict__)
        http.module = module
    return http.module


def public_objects(route):
    """Map a protocol coordinate to a fixed set of public objects, never arbitrary files."""
    if route == ["snapshot"]:
        return {"snapshot": SNAPSHOT, "operators": OPERATOR_ROTATIONS}
    if len(route) < 3 or route[0] != "packages":
        raise CovenError("unknown Coven endpoint")
    name = checked_name(route[1])
    if route[2:] == ["head"]:
        return {"index": f"{name}/{INDEX}", "rotations": f"{name}/{ROTATIONS}"}
    if len(route) != 5:
        raise CovenError("invalid release coordinate")
    version, seq, chain = route[2:]
    if not re.fullmatch(r"0|[1-9][0-9]{0,19}", seq) or not (chain == "none" or DIGEST.fullmatch(chain)):
        raise CovenError("invalid snapshot binding")
    bound = {"index": f"{name}/{INDEXES}/{seq}",
             "rotations": f"{name}/{CHAINS}/{chain.removeprefix('sha384:')}"}
    if version == "index":
        return bound
    slot = f"{name}/{checked_version(version)}"
    return {"package": f"{slot}/package", "source": f"{slot}/source.wy", "digest": f"{slot}/digest",
            "signature": f"{slot}/{SIGNATURE}", **bound}


def received(tree, route, request):
    objects = public_objects(route)
    data = request("/".join(route), objects)
    for key, file in objects.items():
        if data[key] is not None:
            path = tree / file
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(data[key])
    return data


def accept_publication(store, route, payload):
    # Each admission verifies in the engine that publishes. Keep verdicts request-scoped.
    _VERIFIED.clear()
    try:
        if route == ["snapshot"]:
            return http().transaction(store, lambda tree: deferred(lambda: install_signed_snapshot(tree, payload)))
        name, version, data, requires = publication_input(route, payload)
        scope = http().PublicationScope(name, version, requires)
        return http().transaction(
            store, lambda tree: deferred(lambda: admit_package(tree, name, version, data, requires)), scope=scope,
        )
    finally:
        _VERIFIED.clear()


def admit_publication(tree, route, payload):
    return admit_package(tree, *publication_input(route, payload))


def publication_input(route, payload):
    if len(route) != 3 or route[0] != "packages":
        raise CovenError("unknown publication endpoint")
    name, version = checked_name(route[1]), checked_version(route[2])
    data = http().decode(payload, ("snapshot", "base", "index", "package", "source", "signature"))
    if any(data[k] is None for k in data if k != "base"):
        raise CovenError("incomplete signed publication")
    package, source = data["package"], data["source"]
    if len(package) + len(source) > PACKAGE_BYTES:
        raise CovenError("package exceeds the supported size")
    requires = checked_release(package, source, name, version).requires
    return name, version, data, requires


def admit_package(tree, name, version, data, requires):
    package, source = data["package"], data["source"]
    for dependency, exact in requires.items():
        if not (slot(tree, dependency, exact) / "digest").is_file():
            raise CovenError(f"unpublished dependency {dependency} {exact}")
    snapshot = registry_file(tree / SNAPSHOT, signed=True)
    if snapshot is None or data["snapshot"] != digest_of(snapshot).encode():
        raise CovenError("operator snapshot changed; review and retry publication")
    base_snapshot = parse_snapshot(snapshot)
    target = slot(tree, name, version)
    current = read_index(target.parent, name)
    if data["base"] != (digest_of(current.raw).encode() if current else None):
        raise CovenError("publisher index changed; review and retry publication")
    new = parse_index(data["index"], name)
    if current is None and target.parent.is_dir():
        first_entries(target.parent, name, new.signer, publishing=version)
    digest = digest_of(package + source)
    rotations = registry_file(target.parent / ROTATIONS)
    anchored = base_snapshot.entries.get(name, ...)
    bound = snapshot_chain(target.parent, name, base_snapshot) if anchored not in (..., None) else None
    _, refused, _ = admit(target.parent, name, new, anchored, rotations, set(base_snapshot.handed), bound)
    if refused:
        raise CovenError(refused)
    previous = entry_of(current, rotations) if current else ...
    admitted, why, _ = admit(target.parent, name, new, previous, rotations)
    if why or admitted != entry_of(new, rotations) or new.expires < today():
        raise CovenError(why or "publisher index refused")
    if current and (new.signer != current.signer or new.sequence <= current.sequence):
        raise CovenError("publication needs a newer index signed by the current owner")
    entries = dict(current.entries) if current else {}
    if version in entries and entries[version][0] != digest:
        raise CovenError("published version has another digest")
    entries.setdefault(version, (digest, "active", ""))
    if entries != new.entries:
        raise CovenError("publication may only add the signed release to its index")
    target.mkdir(parents=True, exist_ok=True)
    before = registry_file(target / "digest")
    if before is not None and before != digest.encode():
        raise CovenError("existing version differs from publication")
    # Verify the incoming signature for exactly this coordinate and content before publishing.
    with tempfile.TemporaryDirectory(prefix="coven-upload-") as directory:
        tmp = Path(directory).resolve()
        (tmp / SIGNATURE).write_bytes(data["signature"])
        if signer_of(tmp, name, version, digest) != new.signer:
            raise CovenError("release signature differs from the package owner")
        if before is not None or any(target.iterdir()):
            if before is None and {p.name for p in target.iterdir()} != {SIGNATURE}:
                raise CovenError("unclaimed version contains unexpected files")
            if signer_of(target, name, version, digest) != new.signer:
                raise CovenError("version is already claimed by another signer")
        (tmp / "bundle").write_bytes(package + source)
        verdict = run_program("publish", {"files": {"bundle": toml_string(tmp / "bundle")},
                              "dirs": {"slot": "{ root = %s }" % toml_string(target),
                                       "record": "{ root = %s }" % toml_string(target)}}, tmp)
        if verdict.startswith("refused") or verdict.split()[-1:] != [digest]:
            raise CovenError("publication guest refused the release")
    if before is None:
        (target / SIGNATURE).write_bytes(data["signature"])
    (target.parent / INDEX).write_bytes(new.raw)
    return {"digest": digest.encode()}


def remote_publish(args, url, tree, request, release):
    name, version, requires, payload = release
    if not args.key or not args.operator or not args.registry_id:
        raise CovenError("HTTP publish requires a signing key, pinned operator and registry id")
    checked_operator_id(args.operator)
    snap, _, fresh = fresh_snapshot(tree, args.operator, checked_registry_id(args.registry_id), 0)
    settle()
    record_fresh(*fresh)
    public = received(tree, ["packages", name, "head"], request)
    key = signing_key(args.key)
    folder = tree / name
    folder.mkdir(exist_ok=True)
    current = read_index(folder, name)
    prior = snap.entries.get(name, ...)
    _, why, _ = admit(folder, name, current, prior, public["rotations"], set(snap.handed))
    if why:
        raise CovenError("publisher view differs from the signed snapshot: " + why)
    token = REGISTRY_LOCATION.set(url)
    try:
        # The index this key last sent but the registry had not yet acknowledged (`pending`).
        # Sent and accepted, then stopped before it was recorded: the registry serves exactly
        # those bytes, and they become the owner's copy. Otherwise it was refused (or never
        # arrived) and is not built on, but its sequence is never signed again.
        kept = signed_state(folder, name, key.id)
        pending_path = kept.with_name(kept.name + ".pending")
        pending = parse_index(signed_input(pending_path), name) if pending_path.is_file() else None
        if pending is not None and pending.signer != key.id:
            raise CovenError(f"{pending_path} is not an index signed by this key")
        if pending is not None and registry_file(folder / INDEX, signed=True) == pending.raw:
            record_signed_state(folder, name, key.id, pending.raw)
            pending_path.unlink()
            pending = None
        base = base_index(folder, name, key.id)
        if base and (base.signer != key.id or owner_keys(folder, name, base, base.recovery)[-1] != key.id):
            raise CovenError("only the current owner can publish")
        recovery = public_key_file(args.recovery_key) if args.recovery_key else None
        if recovery == key.id or (recovery and base and recovery != base.recovery):
            raise CovenError("recovery key refused")
        # The record and the rest, as the registry stores them (`package`, `source.wy`).
        metadata, contents = release_format().split(payload)
        if len(metadata) + len(contents) > PACKAGE_BYTES:
            raise CovenError("package exceeds the supported size")
        digest = digest_of(metadata + contents)
        entries = dict(base.entries) if base else {}
        if entries.setdefault(version, (digest, "active", ""))[0] != digest:
            raise CovenError("published version has another digest")
        message = release_message(name, version, digest, key.public)
        signature = signed_object(message, witchy_sign("release", key, message))
        sequence = write_index(folder, name, key, max(base.sequence if base else 0, pending.sequence if pending else 0) + 1,
                               base.recovery if base else recovery or "none", entries, VALID_DAYS, keep=False)
        signed_index = signed_input(folder / INDEX)
        # Kept aside until the registry accepts it: a refused index never becomes the base of the
        # owner's next update, and the owner's copy (its anti-rollback floor) only moves forward.
        record_signed_state(folder, name, key.id, signed_index, pending_path)
        result = request(f"packages/{name}/{version}", ["digest"], {
            "snapshot": digest_of(snap.raw).encode(), "base": digest_of(current.raw).encode() if current else None,
            "package": metadata, "source": contents, "signature": signature, "index": signed_index})
        if result["digest"] != digest.encode():
            raise CovenError("registry acknowledged a different package digest")
        record_signed_state(folder, name, key.id, signed_index)
        pending_path.unlink(missing_ok=True)
        print(f"{name} {version}: published {digest}\n{name} {version}: signed by {key.id}\n{name}: index {sequence}")
    finally:
        REGISTRY_LOCATION.reset(token)
    return 0


def install_signed_snapshot(tree, payload):
    wire = http().decode(payload, ("previous", "signed"))
    old = registry_file(tree / SNAPSHOT, signed=True)
    if old is None or wire["previous"] != digest_of(old).encode() or wire["signed"] is None:
        raise CovenError("operator snapshot changed or not bootstrapped")
    base = parse_snapshot(old)
    candidate = parse_snapshot(wire["signed"], base.registry)
    operator_keys(tree, base.signer, candidate.signer, base.registry)
    if candidate.signer != base.signer or candidate.sequence <= base.sequence or candidate.expires <= now():
        raise CovenError("operator or snapshot sequence/expiry refused")
    handed = set(base.handed)
    entries, admitted = snapshot_entries(tree, base.signer, base, handed)
    if entries != candidate.entries or handed != candidate.handed:
        raise CovenError("registry changed since review; snapshot entries or handovers differ")
    settle()
    retain_snapshot_objects(tree, base.signer, entries, admitted, signing=False)
    for name, entry in entries.items():
        if entry is not None:
            snapshot_index(tree / name, name, candidate)
            snapshot_chain(tree / name, name, candidate)
    settle()
    (tree / SNAPSHOT).write_bytes(candidate.raw)
    return {"digest": digest_of(candidate.raw).encode()}


def entry_versions(root, name, entry, path):
    """The versions of the index a snapshot entry names, read from `path` if it holds exactly
    that index; None when it is not there."""
    raw = registry_file(path, signed=True)
    if raw is None or digest_of(raw) != entry[1]:
        return None
    return parse_index(raw, name).entries


def admission_review(admit):
    """The operator's review of a served registry: anyone who can reach the loopback port can
    publish, so every change since the operator's last snapshot is listed, and a package's first
    claim (a name, with its owner and recovery key) is signed only when the operator names it with
    `--admit NAME`. A new version, withdrawal, refresh or rotation of an admitted package needs no
    admission: its owner's signature chain, which `admit` checks, decides those."""
    names = {checked_name(name) for name in admit or ()}

    def review(root, base, entries):
        previous = base.entries if base else {}
        claims = []
        for name, entry in sorted(entries.items()):
            prior = previous.get(name, ...)
            if entry == prior:
                continue
            if prior in (..., None) or entry is None:
                claims.append(name)
                if entry is None:
                    print(f"review: first claim: {name}, unsigned")
                    continue
                versions = entry_versions(root, name, entry, root / name / INDEX)
                listed = ", ".join(f"{v} {state}" for v, (_, state, _) in sorted(versions.items())) if versions is not None else "versions unavailable"
                print(f"review: first claim: {name} by {entry[2]}, recovery {entry[3]}, index {entry[0]}: {listed}")
                continue
            changes = []
            if entry[2] != prior[2]:
                changes.append(f"owner {prior[2]} -> {entry[2]} (rotation)")
            old = entry_versions(root, name, prior, root / name / INDEXES / str(prior[0]))
            new = entry_versions(root, name, entry, root / name / INDEX)
            if old is None or new is None:
                changes.append("versions unavailable")
            else:
                changes += [f"adds {v}" for v in sorted(new) if v not in old]
                changes += [f"{new[v][1]} {v}" for v in sorted(new) if v in old and new[v][1] != old[v][1]]
            print(f"review: {name}: index {prior[0]} -> {entry[0]}" + "".join(f"; {change}" for change in changes))
        unexpected = names - set(claims)
        if unexpected:
            raise CovenError("--admit " + ", ".join(sorted(unexpected)) + ": not a first claim in this snapshot; nothing signed")
        missing = [name for name in claims if name not in names]
        if missing:
            raise CovenError("first claims need the operator's admission; nothing signed. Review them, then give "
                             + " ".join(f"--admit {name}" for name in missing))
    return review


def remote_snapshot(args, url, tree, request):
    if args.first:
        raise CovenError("bootstrap the first operator snapshot with the private server store")
    old = registry_file(tree / SNAPSHOT, signed=True)
    if old is None:
        raise CovenError("operator bootstrap required on the server")
    key = signing_key(args.key, args.public_key)
    base = parse_snapshot(old, args.id)
    operator_keys(tree, key.id, base.signer, base.registry)
    if base.signer != key.id:
        raise CovenError("only the current operator can take the snapshot")
    settle()
    import json
    catalog = request("catalog", ["packages"])
    if not isinstance(catalog["packages"], bytes):
        raise CovenError("missing registry catalog")
    packages = json.loads(catalog["packages"])
    if not isinstance(packages, dict):
        raise CovenError("invalid registry catalog")
    for name, version in packages.items():
        checked_name(name)
        checked_version(version)
        (tree / name / version).mkdir(parents=True)
        received(tree, ["packages", name, "head"], request)
        previous = base.entries.get(name)
        if previous is not None:
            received(tree, ["packages", name, "index", str(previous[0]), previous[4]], request)
    token = REGISTRY_LOCATION.set(url)
    try:
        report = io.StringIO()
        try:
            with contextlib.redirect_stdout(report):
                take_snapshot(tree, key, args.valid_hours, args.id, args.min_base, review=admission_review(args.admit))
        except CovenError:
            sys.stdout.write(report.getvalue())  # the review, nothing signed or sent
            raise
        settle()
        signed = signed_input(tree / SNAPSHOT)
        reply = request("snapshot", ["digest"], {"previous": digest_of(old).encode(), "signed": signed})
        if reply["digest"] != digest_of(signed).encode():
            raise CovenError("registry acknowledged a different snapshot")
        sys.stdout.write(report.getvalue())
    finally:
        REGISTRY_LOCATION.reset(token)
    return 0


@contextlib.contextmanager
def authoring_lock(url, command):
    # Independent CLI launches must not sign competing copies of local owner/operator state.
    if command not in ("snapshot", "publish"):
        yield
        return
    folder = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "coven" / "writing"
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    held = os.open(folder / hashlib.sha384(url.encode()).hexdigest(), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(held, fcntl.LOCK_EX)
        yield
    finally:
        os.close(held)


def remote_command(args, url):
    release = publication_source(args.package, manifest_pin=args.manifest_pin) if args.command == "publish" else None
    host = tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
    with (authoring_lock(url, args.command), tempfile.TemporaryDirectory(prefix="coven-receive-") as scratch,
          http().request_worker(url, build_module, host) as request):
        from copy import copy
        tree = Path(scratch).resolve()
        received(tree, ["snapshot"], request)
        if args.command == "snapshot":
            return remote_snapshot(args, url, tree, request)
        if args.command == "publish":
            return remote_publish(args, url, tree, request, release)
        if args.command == "catalog":
            return 0 if released_catalog(args, tree, request) else 1
        if args.command not in ("fetch", "verify-snapshot"):
            raise CovenError("this administrative operation requires the private server store")
        command = copy(args)
        command.registry = str(tree)
        if args.command == "fetch":
            if not args.operator or not args.registry_id or args.no_snapshot:
                raise CovenError("HTTP fetch requires an operator and registry ID")
            raw = signed_input(args.snapshot) if args.snapshot else None
            snapshot, _, _ = fresh_snapshot(tree, args.operator, args.registry_id, args.min_snapshot, raw)
            settle()
            entry = snapshot.entries.get(checked_name(args.name))
            if entry is not None:
                route = ["packages", args.name, checked_version(args.version), str(entry[0]), entry[4]]
                received(tree, route, request)
            elif args.name in snapshot.entries:
                raise CovenError("HTTP fetch requires a signed package")
        return run_command(command)


def argument_parser():
    cli = shipped_module("coven_cli.py", CLI_DIGEST, "_coven_cli_" + CLI_DIGEST, "command parser")
    return cli.argument_parser(VALID_DAYS, SNAPSHOT_HOURS)


def main(argv=None):
    args = argument_parser().parse_args(argv)
    try:
        if args.command == "tls-prepare":
            from coven_tls_prepare import prepare
            prepare(args, build_module, tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host"))
            return 0
        if args.command == "mirror-check":
            from coven_mirror_check import check
            sys.stdout.write(check(args, tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")))
            return 0
        if args.command == "inspect":
            inspect_release(args.release)
            return 0
        if args.command == "stage":
            import coven_candidate_stage
            import coven_staging
            host = tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
            with coven_candidate_stage.stage_worker(build_module, host, source=args.module, pin=args.module_pin) as stage:
                result = stage(args.staging_dir, args.bundle)
            print(coven_staging.canonical(result).decode("ascii"))
            return 0
        if args.command == "ci":
            if args.action == "serve":
                import coven_ci_service
                coven_ci_service.serve(args, tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host"))
                return 0
            import coven_ci_http
            import coven_staging
            host = tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
            if args.action == "public-key":
                with coven_ci_http.signer_worker(build_module, source=args.signer_module, pin=args.signer_pin) as signer:
                    result = {"key": coven_ci_http.runner_signer(args.key, signer, host, {"mode": "public-key"})}
            else:
                result = coven_ci_http.client(args, build_module, host)
            print(coven_staging.canonical(result).decode("ascii"))
            return 0
        if args.command == "release":
            if args.action == "init":
                from coven_staging_schema import schema_worker
                if (args.module is None) != (args.module_pin is None):
                    raise CovenError("supply --module and --module-pin together")
                host = tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
                with schema_worker(build_module, host, source=args.module, pin=args.module_pin) as initialize:
                    initialize(args.staging_dir)
                return 0
            if args.action in ("backup", "restore"):
                import coven_staging_backup
                from coven_recovery_workers import recovery_workers
                host = tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
                with recovery_workers(build_module, host, manifest=(args.manifest_module, args.manifest_pin),
                                      database=(args.database_module, args.database_pin)) as workers:
                    if args.action == "backup":
                        from coven_staging import canonical
                        result = coven_staging_backup.backup(args.staging_dir, args.out, workers)
                        print(canonical(result).decode("ascii"))
                    else:
                        coven_staging_backup.restore(args.backup, args.backup_pin, args.staging_dir, workers)
                return 0
            if args.action == "review-serve":
                import coven_release_http
                coven_release_http.serve(args, tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host"))
                return 0
            import coven_approval
            import coven_staging
            host = tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
            worker = {"source": args.module, "pin": args.module_pin}
            if (args.module is None) != (args.module_pin is None):
                raise CovenError("supply --module and --module-pin together")
            if args.action in ("enroll-start", "challenge"):
                if ((args.challenge_module is None) != (args.challenge_pin is None)
                        or (args.module is None) != (args.challenge_module is None)):
                    raise CovenError("supply both module paths and their independent pins")
                issuer = {"source": args.challenge_module, "pin": args.challenge_pin}
            if args.action == "set-policy":
                from coven_review_commit import policy_worker
                from coven_staging_schema import schema_worker
                with policy_worker(build_module, host, **worker) as policy:
                    if args.module is None:
                        with schema_worker(build_module, host) as initialize:
                            initialize(args.staging_dir)
                    result = policy(args.staging_dir, args.policy)
            elif args.action == "enroll-start":
                import coven_enrollment
                from coven_review_commit import issuer_worker
                with (issuer_worker(build_module, host, **issuer) as issue,
                      coven_enrollment.enrollment_worker(build_module, host, **worker) as enrollment):
                    result = coven_enrollment.begin(args.staging_dir, args.package, args.replace, issue, enrollment)
            elif args.action == "enroll-finish":
                import coven_enrollment
                with coven_enrollment.enrollment_worker(build_module, host, **worker) as commit:
                    result = coven_enrollment.complete(args.staging_dir, args.response, commit)
            elif args.action == "review-url":
                import coven_release_http
                from coven_review_commit import commit_worker
                with commit_worker(build_module, host, **worker) as reader:
                    print(coven_release_http.review_url(args.staging_dir, args.digest, reader))
                return 0
            elif args.action == "challenge":
                from coven_review_commit import commit_worker, issuer_worker
                with issuer_worker(build_module, host, **issuer) as issue, commit_worker(build_module, host, **worker) as reader:
                    result = coven_approval.challenge(args.staging_dir, args.digest, issue, reader)
            elif args.action == "approve":
                from coven_review_commit import commit_worker
                with commit_worker(build_module, host, **worker) as commit:
                    result = coven_approval.approve(args.staging_dir, args.challenge, args.assertion, commit)
            else:
                from coven_review_commit import receipt_reader
                with receipt_reader(build_module, host, **worker) as read:
                    result = read(args.staging_dir, args.digest)
            print(coven_staging.canonical(result).decode("ascii"))
            return 0
        if args.command == "tuf":
            if args.action in ("sign-package", "seal"):
                import coven_target
                if args.action == "seal":
                    if not DIGEST.fullmatch(args.digest):
                        raise CovenError("expected a staged SHA-384 digest")
                    pins = (args.module, args.module_pin, args.snapshot_module, args.snapshot_pin)
                    if any(value is not None for value in pins) and any(value is None for value in pins):
                        raise CovenError("supply both module paths and their independent pins")
                host = tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
                mode = "publisher" if args.action == "sign-package" else "witness"
                with coven_target.signer_worker(build_module, host, mode, source=args.module, pin=args.module_pin) as signer:
                    if args.action == "sign-package":
                        coven_target.sign_package(args.bundle, args.key, args.registry_id,
                                                  args.out, signer)
                    else:
                        with coven_target.seal_snapshot_worker(
                                build_module, host, source=args.snapshot_module, pin=args.snapshot_pin) as snapshot:
                            coven_target.seal(args.staging_dir, args.digest, args.publisher_signature,
                                              args.trust, args.witness_key, args.out, signer, snapshot)
            elif args.action == "publish":
                import coven_staging
                import coven_tuf_publish
                host = tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
                result = coven_tuf_publish.publish(args, build_module, host, source=args.module, pin=args.module_pin)
                print(coven_staging.canonical(result).decode("ascii"))
            elif args.action == "serve":
                import coven_mirror_service
                return coven_mirror_service.serve(args, tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host"))
            elif args.action in ("fetch", "catalog"):
                from coven_worker import follow_launcher
                follow_launcher()
                import coven_staging
                import coven_tuf
                host = tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
                command = coven_tuf.fetch if args.action == "fetch" else coven_tuf.catalog
                print(coven_staging.canonical(command(args, build_module, host)).decode("ascii"))
            elif args.action == "rotate-policy":
                import coven_staging
                from coven_policy_rotation import rotation_worker
                host = tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
                with rotation_worker(build_module, host, source=args.module, pin=args.module_pin) as rotate:
                    print(coven_staging.canonical(rotate(args)).decode("ascii"))
            else:
                import coven_tuf
                from coven_tuf_sign import delegation_finalizer, delegation_preparer, delegation_signer
                pins = (args.prepare_module, args.prepare_pin, args.signer_module, args.signer_pin,
                        args.finalizer_module, args.finalizer_pin)
                if any(value is not None for value in pins) and any(value is None for value in pins):
                    raise CovenError("supply all three module paths and their independent pins")
                host = tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
                with (delegation_preparer(build_module, host, source=args.prepare_module, pin=args.prepare_pin) as prepare,
                      delegation_signer(build_module, host, source=args.signer_module, pin=args.signer_pin) as signer,
                      delegation_finalizer(build_module, host, source=args.finalizer_module, pin=args.finalizer_pin) as finalize):
                    coven_tuf.authorize(args, prepare, signer, finalize)
            return 0
        if args.command == "pack":
            name, version, requires, bundle = publication_source(args.package, manifest_pin=args.manifest_pin)
            if len(bundle) > PACKAGE_BYTES:
                raise CovenError("package exceeds the supported size")
            sys.stdout.buffer.write(bundle)
            return 0
        if args.command == "web":
            import coven_web
            if args.web_command == "check":
                coven_web.load(args.generation)
                return 0
            if args.web_command == "install":
                coven_web.install_mirror(args.generation, args.mirror)
                return 0
            if args.web_command == "init-tuf":
                checked_registry_id(args.id)
                coven_web.init_tuf_project(args, toml_string)
                print(args.project)
                return 0
            http().endpoint(args.registry)
            checked_operator_id(args.operator)
            checked_registry_id(args.registry_id)
            checked_key_id(args.publisher, "--publisher", "Glamour publisher")
            coven_web.init_project(args.project, args.registry, args.operator, args.registry_id,
                                   args.publisher, toml_string)
            print(args.project)
            return 0
        if args.command == "serve":
            if not 0 <= args.port <= 65535:
                raise CovenError("port must be 0 through 65535")
            web = web_default = None
            if args.web_dir is not None:
                import coven_web
                web = coven_web.load(args.web_dir)
                web_default = coven_web.NO_AMBIENT
            http().serve(args.store, args.port, public_objects, accept_publication,
                         (CovenError, ValueError), build=build_module,
                         host=tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host"),
                         web=web, web_default=web_default)
            return 0
        location = getattr(args, "registry", None)
        if location and "://" in str(location):
            http().endpoint(location)
            return deferred(lambda: remote_command(args, str(location).rstrip("/")))
        if location and (Path(location) / "coven-registry.sqlite3").is_file():
            token = REGISTRY_LOCATION.set(str(Path(location).resolve()))
            try:
                def operate(tree):
                    from copy import copy
                    staged = copy(args)
                    staged.registry = str(tree)
                    staged.review = True  # what the server accepted, reviewed as over HTTP
                    status = deferred(lambda: run_command(staged))
                    if status:
                        raise CovenError("registry transaction refused")
                    return status
                return http().transaction(location, operate)
            finally:
                REGISTRY_LOCATION.reset(token)
        return deferred(lambda: run_command(args))
    except (OSError, ValueError, CovenError) as error:
        print(f"coven: {error}", file=sys.stderr)
        return 1


def run_command(args):
    """Run the command `args` names: its exit status."""
    if args.command == "publish":
        ok = publish(args.package, args.registry, args.key, args.recovery_key, manifest_pin=args.manifest_pin)
    elif args.command in ("yank", "revoke"):
        ok = withdraw(args.registry, args.name, args.version, {"yank": "yanked", "revoke": "revoked"}[args.command], args.reason, args.key)
    elif args.command == "rotate":
        ok = rotate(args.registry, args.name, args.key, args.new_key, args.valid_days, args.min_sequence, args.from_index, args.from_owner,
                    args.operator, args.registry_id, args.min_snapshot, args.no_snapshot)
    elif args.command == "refresh":
        ok = refresh(args.registry, args.name, args.key, args.valid_days)
    elif args.command == "snapshot":
        if args.admit and not getattr(args, "review", False):
            raise CovenError("--admit reviews a served registry's first claims (its URL or server store)")
        ok = take_snapshot(args.registry, signing_key(args.key, args.public_key), args.valid_hours, args.id, args.min_base, args.first,
                           admission_review(args.admit) if getattr(args, "review", False) else None)
    elif args.command in ("key", "operator-key"):
        ok = make_key(args.key, args.out)
    elif args.command == "verify-snapshot":
        ok = check_snapshot(args.registry, args.operator, args.registry_id, args.min_sequence, args.keep)
    elif args.command == "catalog":
        ok = released_catalog(args, registry_root(args.registry))
    elif args.command == "rotate-operator":
        ok = rotate_operator(args.registry, signing_key(args.key, args.public_key), signing_key(args.new_key, args.new_public_key, "--new-key"),
                             args.valid_hours, args.id, args.min_base)
    else:
        ok = fetch(args.registry, args.name, args.version, args.into, args.expect, args.expect_signer, args.min_sequence, args.expect_recovery,
                   args.operator, args.snapshot, args.min_snapshot, args.no_snapshot, args.registry_id)
    return 0 if ok else 1


if __name__ == "__main__":
    try:
        status = main()
    finally:
        if client := sys.modules.get(COMPILER_CLIENT_MODULE):
            client.close()
    sys.exit(status)
