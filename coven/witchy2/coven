NAME = re.compile(r"[a-z][a-z0-9-]{0,63}")
VERSION = re.compile(r"(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})")
# A content digest: SHA-384, named. A `sha256:` digest is from before the witchy-2 profile and
# is refused with what to do (relock, republish), never compared (`retired`).
DIGEST = re.compile(r"sha384:[0-9a-f]{96}")
RETIRED_DIGEST = re.compile(r"sha256:[0-9a-f]{64}")
# An SSH key's fingerprint, which named package owners before the witchy-2 profile: refused.
FINGERPRINT = re.compile(r"SHA256:[A-Za-z0-9+/]{43}")


class CovenError(Exception):
    pass


def tool(variable, name):
    requested = os.environ.get(variable, name)
    path = shutil.which(requested)
    if path is None:
        raise CovenError(f"cannot execute {requested!r}. Set {variable} to the {name} binary")
    return os.path.abspath(path)


# The registry's own files beside its packages: never a package's name (adversarial review of
# c00d6a6: a package `operator-rotations` made every fetch and snapshot fail).
RESERVED = {"snapshot", "operator-rotations"}


def checked_name(name):
    if not isinstance(name, str) or not NAME.fullmatch(name):
        raise CovenError(f"invalid package name {name!r}: lowercase letters, digits and '-', starting with a letter")
    if name in RESERVED:
        raise CovenError(f"{name!r} is reserved for the registry's own files")
    return name


def checked_version(version):
    if not isinstance(version, str) or not VERSION.fullmatch(version):
        raise CovenError(f"invalid version {version!r}: an exact MAJOR.MINOR.PATCH")
    return version


def toml_string(value):
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


