#!/usr/bin/env python3
"""A local, filesystem-backed Coven registry for Witchy 2 packages.

The registry decisions are Witchy 2 programs beside this file, run in Wasmtime with only the
directories and files each needs: publish.wy hashes, stages and claims a version; fetch.wy
verifies a version against its recorded and locked digests before anything leaves the
registry. This launcher is the host bootstrap: it reads TOML, checks names, creates the
version's directory and grants the programs their paths.

Layout: REGISTRY/NAME/VERSION/{digest, package, source.wy} (for a package of several files,
`package` lists each with its length and SHA-384 and `source.wy` holds their bytes in that order:
`witchy-package 2`, witchy_release.py). `package` is the version's record:

    witchy-package 1
    name NAME
    version VERSION
    requires DEPENDENCY VERSION     (one line each, by name; none for a leaf)
    <blank line>

and `digest` is `sha384:<hex>` of `package` followed by `source.wy`, so a digest pins the
name, version and exact requirements as well as the source.

Every signature is the `witchy-2` suite's (ML-DSA-65, computed by the engine's AWS-LC module),
every key is named by its `witchy-2:` key ID (SHA-384 of its public key) and every digest is
SHA-384 (the approved profile, Witchy 2's docs/decisions.md 2026-11-20). Nothing of the
`witchy-1` suite, SHA-256 digests or ssh-keygen signatures is accepted: each is refused with
what to do (README, "The witchy-2 profile").
"""

import os


# The descriptors (3 and up) this process was started with, before it opens any of its own: only
# these can be an operator key's `fd:N` (as Grimoire's secrets).
def _inherited_descriptors():
    import fcntl
    try:
        listed = [int(name) for name in os.listdir("/dev/fd") if name.isdigit()]
    except OSError:
        return frozenset()
    found = set()
    for number in listed:
        try:
            if number >= 3:
                fcntl.fcntl(number, fcntl.F_GETFD)
                found.add(number)
        except OSError:
            pass
    return frozenset(found)


INHERITED_DESCRIPTORS = _inherited_descriptors()

