import "tuf/fetch_scope.wy"
import "tuf/delegated_input.wy"
import "tuf/fetch_generation.wy"
import "tuf/fetch_history.wy"
import "tuf/fetch_refresh.wy"
import "tuf/fetch_roots.wy"
import "tuf/release_trust.wy"
import "tuf/root.wy"
import "tuf/signing_input.wy"
import console
import discard
import fs
import json_tree
import span
import string
import text
import time
import vec

fn main(source: Dir<Read>, input: Console<Read>, output: Console<Write>, clock: Clock, allocator: Allocator):
    let selected = select(&source, &input, &output, clock.now_ms(), &allocator)
    source.close()
    if let Err(code) = selected:
        if code == 2:
            output.line("refused rollback")
        else:
            output.line("refused")

fn select(source: &Dir<Read>, input: &Console<Read>, output: &Console<Write>, now: U64, allocator: &Allocator) -> Result<(), U64>:
    let request = read_signing_request(input, allocator)?
    let result = read_bootstrap(source, input, &request, output, now, allocator)
    request.discard()
    return result

fn read_bootstrap(source: &Dir<Read>, input: &Console<Read>, request: &Json, output: &Console<Write>, now: U64, allocator: &Allocator) -> Result<(), U64>:
    if !count_fields(request, 8):
        return Err(1)
    let root_size = declared_integer(request, "root_size")?
    let trust_size = declared_integer(request, "trust_size")?
    if root_size == 0 || root_size > 512000 || trust_size == 0 || trust_size > 262144:
        return Err(1)
    let bytes = read_signing_bytes(root_size + trust_size, input, allocator)?
    let wire = Span.of(bytes.as_slice())
    let result = with_request(source, request, wire.part(0, root_size), wire.part(root_size, wire.len()), output, now, allocator)
    bytes.close()
    return result

fn with_request(source: &Dir<Read>, request: &Json, initial: Span, trust_wire: Span, output: &Console<Write>, now: U64, allocator: &Allocator) -> Result<(), U64>:
    let selector = request.field("coordinate")?
    let scope = fetch_scope(selector)?
    let trust_pin = string_field(request, "trust")?
    let wire = trust_wire.to_string(allocator)?
    let parsed = parse_pinned_trust(&wire, trust_pin, allocator)
    wire.close()
    let Ok(trust): ReleaseTrust = move parsed else Err(code):
        return Err(code)
    let result = with_trust(source, request, &trust, initial, scope, output, now, allocator)
    trust.close()
    return result

fn parse_pinned_trust(wire: &String, pin: &String, allocator: &Allocator) -> Result<ReleaseTrust, U64>:
    if !matches_delegated_pin(wire, pin, allocator):
        return Err(1)
    let Ok(trust): ReleaseTrust = parse_release_trust(wire, allocator) else Err(error):
        return Err(1)
    return Ok(move trust)

fn with_trust(source: &Dir<Read>, request: &Json, trust: &ReleaseTrust, initial: Span, scope: FetchScope, output: &Console<Write>, now: U64, allocator: &Allocator) -> Result<(), U64>:
    let policy = trust.policy()?
    let registry = string_field(policy, "registry")?
    let expected = string_field(request, "registry")?
    if !registry.eq(expected):
        return Err(1)
    let Ok(reserved): Vec<U8> = trust.reserved_keys(allocator) else Err(error):
        return Err(1)
    let result = with_keys(source, request, initial, reserved.as_slice(), scope, output, now, allocator)
    reserved.close()
    return result

fn with_keys(source: &Dir<Read>, request: &Json, initial: Span, reserved: &[U8], scope: FetchScope, output: &Console<Write>, now: U64, allocator: &Allocator) -> Result<(), U64>:
    let pin = string_field(request, "root")?
    let mode = string_field(request, "mode")?
    let latest = declared_integer(request, "root_version")?
    let wire = read_fetch_history(source, allocator)?
    let result = with_floor(source, initial, pin, latest, wire.span(), reserved, scope, mode, output, now, allocator)
    wire.close()
    return result

fn with_floor(source: &Dir<Read>, initial: Span, pin: &String, latest: U64, wire: Span, reserved: &[U8], scope: FetchScope, mode: &String, output: &Console<Write>, now: U64, allocator: &Allocator) -> Result<(), U64>:
    let floor = read_root_floor(wire, latest)?
    let empty = String.new(allocator)?
    var selected = move empty
    var retired_at: U64 = 1
    let fetched = fetch_root(source, "root_history/", initial, pin, latest, floor, reserved, &mut selected, &mut retired_at, allocator)
    let Ok(root): TrustedRoot = move fetched else Err(code):
        selected.close()
        return Err(code)
    let window = MetadataWindow(floor, latest, retired_at)
    let result = run_stage(source, &root, reserved, scope, mode, output, window, now, allocator)
    root.close()
    if let Ok(done) = result:
        output.write_string(&selected)
        output.print_byte(10)
    selected.close()
    return result

fn run_stage(source: &Dir<Read>, root: &TrustedRoot, reserved: &[U8], scope: FetchScope, mode: &String, output: &Console<Write>, window: MetadataWindow, now: U64, allocator: &Allocator) -> Result<(), U64>:
    if mode.equals_text("root"):
        output.line("root")
        return Ok(())
    if !mode.equals_text("refresh") && !mode.equals_text("select"):
        return Err(1)
    if plan_fetch(source, root, reserved, scope, window, output, now, allocator)?:
        return Ok(())
    if window.floor.version < window.retired_at:
        let empty = window.floor.metadata.part(0, 0)
        return select_fetch(source, root, reserved, scope, output, RootFloor(0, empty, empty), now, allocator)
    return select_fetch(source, root, reserved, scope, output, window.floor, now, allocator)
