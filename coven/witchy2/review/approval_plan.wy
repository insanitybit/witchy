// Recheck the public snapshot under SQLite's write lock before changing state.
import string
import text

pub fn approval_plan(allocator: &Allocator) -> Result<String, U64>:
    let empty = String.with_capacity(allocator, 4096)?
    var plan = move empty
    if let Err(code) = steps(&mut plan, allocator):
        plan.close()
        return Err(code)
    return Ok(move plan)

fn steps(plan: &mut String, allocator: &Allocator) -> Result<(), U64>:
    plan.push_text(allocator, "expect\trelease challenge is unknown, expired, consumed or from an old policy\tSELECT EXISTS(SELECT 1 FROM policy WHERE singleton=1 AND CAST(document AS TEXT)=json_extract(CAST(:blob AS TEXT),'$.policy')) AND EXISTS(SELECT 1 FROM challenges WHERE challenge=:token AND policy=:policy_pin AND expires=:expires AND :now < expires AND CAST(envelope AS TEXT)=json_extract(CAST(:blob AS TEXT),'$.envelope'))\n")?
    plan.push_text(allocator, "expect\trelease challenge does not match the candidate or policy\tSELECT EXISTS(SELECT 1 FROM candidates WHERE digest=:digest AND name=:name AND version=:version)\n")?
    plan.push_text(allocator, "expect\tbrowser approval requires the reviewing credential\tSELECT (:browser=0 AND NOT EXISTS(SELECT 1 FROM browser_approvals WHERE challenge=:token)) OR EXISTS(SELECT 1 FROM browser_approvals WHERE challenge=:token AND credential=:credential)\n")?
    plan.push_text(allocator, "expect\tthis coordinate already has an approval\tSELECT NOT EXISTS(SELECT 1 FROM approvals WHERE name=:name AND version=:version)\n")?
    plan.push_text(allocator, "expect\tmaintainer counter changed during approval\tSELECT (:present=0 AND NOT EXISTS(SELECT 1 FROM counters WHERE credential=:credential)) OR (:present=1 AND EXISTS(SELECT 1 FROM counters WHERE credential=:credential AND public_key=:public_key AND count=:previous))\n")?
    plan.push_text(allocator, "exec\t\tDELETE FROM counters WHERE credential=:credential\n")?
    plan.push_text(allocator, "change\tmaintainer counter was not stored\tINSERT INTO counters (credential,public_key,count) VALUES (:credential,:public_key,:count)\n")?
    plan.push_text(allocator, "change\tapproval receipt was not stored\tINSERT INTO approvals (name,version,digest,receipt) VALUES (:name,:version,:digest,CAST(json_object('approved_at',:now,'assertion',json_extract(CAST(:blob AS TEXT),'$.assertion'),'envelope',json_extract(CAST(:blob AS TEXT),'$.envelope'),'format','coven-approval-1') AS BLOB))\n")?
    plan.push_text(allocator, "exec\t\tDELETE FROM browser_approvals WHERE challenge=:token\n")?
    plan.push_text(allocator, "change\trelease challenge was not consumed\tDELETE FROM challenges WHERE challenge=:token\n")?
    return plan.push_text(allocator, "result\tapproval result is invalid\tSELECT receipt FROM approvals WHERE name=:name AND version=:version AND digest=:digest\n")
