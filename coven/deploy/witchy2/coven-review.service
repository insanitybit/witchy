[Unit]
Description=Coven private maintainer review over Witchy HTTPS

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=20s
User=coven-staging
Group=coven-staging
Environment=WITCHY_WASMTIME_HOST=/opt/coven/bin/witchy-wasmtime-host
EnvironmentFile=/etc/coven/review/pins.env
ExecStart=/opt/coven/bin/coven release review-serve --listen 127.0.0.1:8443 \
    --staging-dir /var/lib/coven-private/staging --mirror /srv/coven/published \
    --chain /etc/coven/review/chain.derlist --tls-key /etc/coven/review/tls.der \
    --trust /etc/coven/review/release-trust.json --trust-pin ${COVEN_RELEASE_TRUST_PIN} \
    --root /etc/coven/review/initial-root.json --root-pin ${COVEN_RELEASE_ROOT_PIN} \
    --module /opt/coven/libexec/coven-private/review.wasm --module-pin ${COVEN_REVIEW_LISTENER_PIN} \
    --challenge-module /opt/coven/libexec/coven-private/review-challenge.wasm --challenge-pin ${COVEN_REVIEW_CHALLENGE_PIN} \
    --inspect-module /opt/coven/libexec/coven-private/review-inspect.wasm --inspect-pin ${COVEN_REVIEW_INSPECT_PIN} \
    --commit-module /opt/coven/libexec/coven-private/review-commit.wasm --commit-pin ${COVEN_REVIEW_COMMIT_PIN} \
    --baseline-module /opt/coven/libexec/coven-private/review-baseline.wasm --baseline-pin ${COVEN_REVIEW_BASELINE_PIN}
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/coven-private/staging
InaccessiblePaths=-/etc/coven/ci -/etc/coven/keys
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
