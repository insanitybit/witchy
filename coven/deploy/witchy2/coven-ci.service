[Unit]
Description=Coven private CI staging over Witchy HTTPS

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=20s
User=coven-staging
Group=coven-staging
Environment=WITCHY_WASMTIME_HOST=/opt/coven/bin/witchy-wasmtime-host
Environment=COVEN_CI_CONFIG=/etc/coven/ci/config.json
Environment=COVEN_CI_JWKS=/etc/coven/ci/github-jwks.json
Environment=COVEN_CI_NONCE_KEY=/etc/coven/ci/nonce.key
Environment=COVEN_CI_STAGING=/var/lib/coven-private/staging
Environment=COVEN_CI_IDENTITY_MODULE=/opt/coven/libexec/coven-private/ci-identity.wasm
EnvironmentFile=/etc/coven/ci/pins.env
ExecStart=/opt/coven/bin/coven ci serve --listen 127.0.0.1:8443 \
    --chain /etc/coven/ci/chain.derlist --tls-key /etc/coven/ci/tls.der \
    --module /opt/coven/libexec/coven-private/ci-https.wasm --module-pin ${COVEN_CI_LISTENER_PIN} \
    --storage-module /opt/coven/libexec/coven-private/ci-commit.wasm --storage-pin ${COVEN_CI_STORAGE_PIN}
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/coven-private/staging
InaccessiblePaths=-/etc/coven/review -/etc/coven/keys -/srv/coven
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
