# RFC-0122 precision telemetry artifact v1
#
# Duration fields are measured samples and intentionally are not pinned to an
# exact wall-clock value. The remaining fields are deterministic counters or
# named checked-analysis evidence. Each phase is rerun in optimized and
# forced-copy mode by rfc0122_timing.

schema=phase,fixture,mode,checker_time_us,execution_time_us,execution_throughput_batches_per_s,peak_memory,loan_edges,subset_edges,no_copy_misses,repair_entries,detachments,materializations,allocations,root_operations
phase=baseline-scalar,fixture=telemetry_reference_return,mode=optimized,checker_time_us=measured,execution_time_us=measured,execution_throughput_batches_per_s=measured,peak_memory=heap_bytes,loan_edges=807,subset_edges=0,no_copy_misses=2,repair_entries=2,detachments=rc_alloc_calls,materializations=reowns,allocations=bump_alloc_calls,root_operations=loan_opens+loan_closes
phase=baseline-scalar,fixture=telemetry_reference_return,mode=forced-copy,checker_time_us=measured,execution_time_us=measured,execution_throughput_batches_per_s=measured,peak_memory=heap_bytes,loan_edges=807,subset_edges=0,no_copy_misses=2,repair_entries=2,detachments=rc_alloc_calls,materializations=reowns,allocations=bump_alloc_calls,root_operations=loan_opens+loan_closes
