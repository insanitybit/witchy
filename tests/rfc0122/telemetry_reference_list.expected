# RFC-0122 aggregate reference telemetry corpus v1
#
# The returned list carries exclusive place references through iteration and a
# nested reborrow. Optimized and forced-copy lowerings must retain identical
# source-loan facts and observable output.

schema=loan_active_points,loan_active_events,loan_opens,loan_closes,loan_return_transfers,loan_shell_mutations,loan_control_flow_edges,loan_subset_edges,boundary_reown_copies,ownership_token_repairs,direct_storage_var_accesses
runtime_schema=heap_bytes,reowns,indirect_ownership_calls,boundary_reown_copies,ownership_token_repairs,direct_storage_var_accesses,destination_candidates_forwarded,rc_alloc_calls,bump_alloc_calls,rc_reuse_calls,rc_free_calls,live_cells
optimized.output=resumed resumed
forced_copy.output=resumed resumed
interpreter.output=resumed resumed
optimized.metrics=4,13,5,7,2,0,824,0,0,0,0
forced_copy.metrics=4,13,5,7,2,0,824,0,0,0,0
optimized.runtime=157,0,0,0,0,0,0,4,4,0,0,4
forced_copy.runtime=157,0,0,0,0,0,0,4,4,0,0,4
