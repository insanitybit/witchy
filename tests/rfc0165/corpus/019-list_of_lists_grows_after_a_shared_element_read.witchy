pub fn build(n: Int) -> List(List(Int)):
    var table = [[0]]
    var i = 1
    while i <= n:
        let above = table.at(i - 1)
        var row = [above.at(0) + 1]
        row.push(i * 10)
        table.push(row)
        i = i + 1
    table

fn main(console: Console):
    let t = build(3)
    console.print("${t.length()} ${t[3][0]} ${t[3][1]} ${t[1][0]}")
