import math

pub fn wrap(n: Int) -> Duration:
    int_to_duration(n * 2)

fn main(console: Console):
    let big = 1000000000.0 * 1000000000.0 * 1000000000.0
    console.print("${math.to_int(math.sqrt(2.25) * 10.0)} ${math.to_int(-7.9)} ${math.to_int(big)} ${math.to_int(0.0 - big)} ${math.to_int(math.to_float(41) + 1.5)}")
    let d = wrap(750)
    console.print("${duration_to_int(d)} ${duration_to_int(d) > 1000} ${d == 1500ms}")
