fn main(console: Console):
    let s = "héllo wörld"
    console.print("[${s.substring(1, 5)}] [${s.substring(7, s.length())}] [${s.substring(3, 3)}] [${s.take(2)}] [${"".substring(0, 0)}]")
    console.print("[${"  \t hi there \n".trim()}] [${"".trim()}] [${"   ".trim()}] [${"x".trim()}] [${"  y ".trim()}]")
    var i = 0
    var acc = ""
    let cs = s.chars()
    while i < 3:
        acc = acc + cs[i].trim()
        i = i + 1
    console.print(acc)
