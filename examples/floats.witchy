// Float math: `sqrt` is a builtin (it can't be written in witchy); `float_abs`,
// `float_min`, `float_max`, and `float_clamp` are the Float counterparts of the Int helpers in
// the bundled `math` module.

import math

fn main(console: Console):
    print(console, "${math.sqrt(16.0)}")
    print(console, "${math.float_abs(-3.5)}")
    print(console, "${math.float_max(2.0, 5.0)}")
    print(console, "${math.float_clamp(9.5, 0.0, 1.0)}")
