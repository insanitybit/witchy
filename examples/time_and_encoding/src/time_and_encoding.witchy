// time_and_encoding — a tiny showcase of the std `time` and `encoding` modules:
// turn a unix timestamp into a civil UTC date, and base64/hex a short payload
// with a decode round-trip. Pure (its footprint is just Console). Run:
//   witchy examples/time_and_encoding.witchy

import time
import encoding

fn main(console: Console):
    let d = time.from_unix(1780000000)
    console.print("date:    " + time.iso8601(d) + " (" + time.weekday_name(d) + ")")
    console.print("layout:  " + time.format(d, "%A, %B %d %Y at %H:%M"))

    // Parsing accepts `Z`, offsets (normalized to UTC), fractional seconds,
    // and bare dates; impossible dates are an Err, not a rollover.
    match time.parse_iso8601("2026-06-08T22:30:00+02:00"):
        Ok(p) -> console.print("parsed:  " + time.iso8601(p))
        Err(e) -> console.print("ERR " + time.time_error_message(e))

    match time.parse_iso8601("2026-02-30T00:00:00Z"):
        Ok(_) -> console.print("BAD: accepted Feb 30")
        Err(e) -> console.print("checked: " + time.time_error_message(e))

    let payload = "witchy 🧙"
    console.print("base64:  " + encoding.base64_encode(payload))
    console.print("hex:     " + encoding.hex_encode(payload))
    match encoding.base64_decode(encoding.base64_encode(payload)):
        Ok(decoded) -> console.print("decoded: " + decoded)
        Err(e) -> console.print("decode failed: " + e)
