// A small JSON API showing the witchy web feel: axum-style routing, tower-style
// middleware, and explicit callable delegation. The `logging` layer can print
// because `main` captured a Console into it (capture is dependency injection).
// Router handlers are ordinary callables, so an API that needs effect-free
// invocation must require `pure fn`; the closed handlers below simply use no
// authority. `serve` holds the listening Net.
// Run: witchy --net 127.0.0.1:8080 examples/serve_api/src/serve_api.witchy

import reflect
from http import Request, Response
from server import Router

// A request logger (a tower Layer: fn(Handler) -> Handler). The inner closure
// runs before-and-after work around `next`, all captured in the closure.
fn logging(console: Console) -> fn(fn(Request) -> Response) -> fn(Request) -> Response:
    fn(next: fn(Request) -> Response):
        fn(req: Request):
            console.print(server.method(req) + " " + server.path(req))
            next(req)

fn home(req: Request) -> Response:
    server.html(200, "<h1>witchy web</h1>")

// Returns a JSON document serialized from an anonymous struct via reflection.
fn greet(req: Request) -> Response:
    server.send(200, .{hello: server.param_or(req, "name", "")})

fn main(console: Console, net: Net):
    let app = server.router().get("/", home).get("/hello/:name", greet).layer(logging(console))

    console.print("serving on 127.0.0.1:8080")
    server.serve(net, "127.0.0.1:8080", app)
