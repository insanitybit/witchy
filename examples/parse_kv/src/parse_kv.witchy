// String slicing and search: split a `key=value` setting using `index_of` to
// find the separator and `substring` to take each side. `index_of` returns
// `Option(Int)` — `Some(i)` at the `=`, `None` when it is absent — so a `match`
// handles the malformed case rather than a -1 sentinel. `substring` is char-based
// and clamps to bounds, so it never panics on a bad index.
fn main(console: Console):
    let setting = "timeout=30"
    match setting.index_of("="):
        Some(eq) ->
            let key = setting.substring(0, eq)
            let value = setting.substring(eq + 1, setting.length())
            console.print(key)
            console.print(value)
            console.print("${setting.ends_with("30")}")
        None ->
            console.print("no `=` in setting")
