// Text processing: the `split`/`replace`/`to_upper` string builtins combined
// with the `list` and `string` standard libraries. Splitting a row, mapping a
// transform over the fields, and re-joining is a few lines.

import list
import string

fn main(console: Console):
    let row = "alice,bob,carol"

    let fields = string.split(row, ",")
    let loud = list.map(fields, fn(name: String): string.to_upper(name))
    print(console, string.join(loud, " | "))

    print(console, string.repeat("=", 3))

    print(console, string.replace(row, "bob", "***"))
