// In-rune tests for `roman`. Each `test_*` function takes no parameters, passes
// by returning, and fails by aborting (the `testing` assertions do that with a
// message). Run them with `witchy test examples/roman`.

import roman
import testing

fn test_to_roman():
    testing.assert_eq(roman.to_roman(4), "IV")
    testing.assert_eq(roman.to_roman(9), "IX")
    testing.assert_eq(roman.to_roman(49), "XLIX")
    testing.assert_eq(roman.to_roman(1994), "MCMXCIV")
    testing.assert_eq(roman.to_roman(2024), "MMXXIV")

fn test_from_roman():
    testing.assert_int_eq(roman.from_roman("IV"), 4)
    testing.assert_int_eq(roman.from_roman("XLIX"), 49)
    testing.assert_int_eq(roman.from_roman("MMXXIV"), 2024)

fn test_round_trip():
    for n in [1, 14, 99, 444, 2024, 3888]:
        testing.assert_int_eq(roman.from_roman(roman.to_roman(n)), n)
