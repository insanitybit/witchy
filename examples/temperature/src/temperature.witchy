// A Fahrenheit-to-Celsius conversion table — the first real program in K&R's
// *The C Programming Language* and a staple of the Go tour, reproduced in
// witchy. `math.format_float` renders each Float with one decimal place in the
// ordinary admitted Wasm run.

import math

pub fn to_celsius(f: Float) -> Float:
    (f - 32.0) * 5.0 / 9.0

fn main(console: Console):
    var f = 0
    while f <= 300:
        let c = to_celsius(math.to_float(f))
        console.print("${f}" + "F = " + math.format_float(c, 1) + "C")
        f = f + 60
