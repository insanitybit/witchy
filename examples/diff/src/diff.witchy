// diff — a line diff by longest common subsequence. We fill the classic LCS
// length table over the two line lists, then backtrack from the bottom-right
// corner: a matching line is unchanged ("  "), otherwise we step in the
// direction of the longer subsequence, emitting a deletion ("- ", only in old)
// or an insertion ("+ ", only in new). Pure (Console only); identical on both
// backends. Run:  witchy examples/diff/src/diff.witchy

import math

fn main(console: Console):
    let old = ["apple", "banana", "cherry", "date", "fig"]
    let new = ["apple", "cherry", "date", "elderberry", "fig"]
    for marked in diff(old, new):
        console.print(marked)

pub fn diff(old: List(String), new: List(String)) -> List(String):
    let table = lcs_table(old, new)
    var out = []
    var i = old.length()
    var j = new.length()
    while i > 0 && j > 0:
        if old.at(i - 1) == new.at(j - 1):
            out.push("  " + old.at(i - 1))
            i = i - 1
            j = j - 1
        else if table.at(i - 1).at(j) >= table.at(i).at(j - 1):
            out.push("- " + old.at(i - 1))
            i = i - 1
        else:
            out.push("+ " + new.at(j - 1))
            j = j - 1
    while i > 0:
        out.push("- " + old.at(i - 1))
        i = i - 1
    while j > 0:
        out.push("+ " + new.at(j - 1))
        j = j - 1
    out.reverse()
    out

// table[i][j] = length of the LCS of old[0..i] and new[0..j], built row by row.
fn lcs_table(old: List(String), new: List(String)) -> List(List(Int)):
    let rows = old.length()
    let cols = new.length()
    var table = [zeros(cols + 1)]
    var i = 1
    while i <= rows:
        let above = table.at(i - 1)
        var row = [0]
        var j = 1
        while j <= cols:
            var value = 0
            if old.at(i - 1) == new.at(j - 1):
                value = above.at(j - 1) + 1
            else:
                value = math.max(row.at(j - 1), above.at(j))
            row.push(value)
            j = j + 1
        table.push(row)
        i = i + 1
    table

fn zeros(n: Int) -> List(Int):
    var out = []
    var k = 0
    while k < n:
        out.push(0)
        k = k + 1
    out
