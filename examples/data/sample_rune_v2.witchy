// A widened version of sample_rune.witchy: `fetch` now also *listens* (it was a
// connect-only client). caps_guard should flag the upgrade as a widening.
pub fn load(dir: Dir[Read], name: String) -> String:
    dir.read(name)

pub fn fetch(net: Net[Connect, Listen], addr: String) -> String:
    net.connect(addr).recv_all()
