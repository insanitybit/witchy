// Capability firewalls: `retain` and `without` carve a region of a function
// where only the capabilities you name remain in scope. It is a compile-time
// guarantee — the type checker hides the bindings, every backend runs the block
// normally — that a slice of code does no more than the authority it asks for,
// even if the surrounding scope holds (or later gains) more. A block can also
// be used as a value: its result crosses the firewall, but the dropped
// capabilities do not. Run from the repo root:
//   witchy examples/firewall.witchy
//   witchy parity examples/firewall.witchy

import list

// A pure validator: it takes no capabilities, so it provably performs no I/O.
fn is_valid(name: String) -> Bool:
    let n = string.length(name)
    n > 0 && n <= 12

fn main(console: Console):
    let names = ["ada", "", "grace", "this_name_is_too_long"]

    // Sealed region: `console` is dropped, so nothing here can print. The work is
    // pure filtering, and the kept list crosses the firewall as the block's value.
    let kept = without console:
        list.filter(names, fn(n: String): is_valid(n))

    print(console, "kept ${list.length(kept)} of " + "${list.length(names)}")
    for n in kept:
        print(console, "  ok: " + n)

    // A fully sealed block: `retain:` with no names drops every capability, so
    // this is pure computation — it cannot reach the console even by accident.
    let total = retain:
        var sum = 0
        for n in kept:
            sum = sum + string.length(n)
        sum
    print(console, "total chars: " + "${total}")
