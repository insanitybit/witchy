// `own` transfers ownership. `into_label` consumes its
// argument, so after `into_label(name)` the caller may not use `name` again — the
// type checker rejects use-after-move. (A `var` could be reassigned to
// re-initialize it.) See examples/conventions/src/conventions.witchy for the full set.
pub fn into_label(own name: String) -> String:
    "[" + name + "]"

fn main(console: Console):
    let name = "witchy"
    console.print(into_label(name))
