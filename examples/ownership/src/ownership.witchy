// `own` marks a consuming parameter. Heap values (List, Dict, records) are
// unusable after the call; a later use is a check-time error. A `var` can be
// reassigned to re-initialize it. See examples/conventions for the full set.
pub fn into_label(own name: String) -> String:
    "[" + name + "]"

fn main(console: Console):
    let name = "witchy"
    console.print(into_label(name))
