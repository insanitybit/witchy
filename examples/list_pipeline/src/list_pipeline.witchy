// A `list` pipeline: map / filter / fold and a comparator-driven sort compose
// over a list. Importing `list` demands no Console, Dir, or Net root. Its
// callback parameters are ordinary delegated behavior, though; the closures in
// this example happen to capture only data.

import list

fn main(console: Console):
    let xs = [5, 3, 8, 1, 9, 2, 7]

    // map then fold: sum of squares = 25+9+64+1+81+4+49 = 233.
    let squares = xs.map(fn(n: Int): n * n)
    console.print("${squares.fold(0, fn(acc: Int, n: Int): acc + n)}")

    // filter the evens, then sort ascending with a comparator closure: [2, 8].
    let evens = xs.filter(fn(n: Int): n % 2 == 0)
    var sorted = evens
    sorted.sort_by(fn(a: Int, b: Int): a < b)
    console.print("${sorted.at(0)}" + " " + "${sorted.at(1)}")

    // A *capturing* closure handed to a library function: `bonus` is closed over
    // and added on every step. sum(xs)=35, plus 7*100 = 735.
    let bonus = 100
    console.print("${xs.fold(0, fn(acc: Int, n: Int): acc + n + bonus)}")
