// Multiple independent server tasks, each with its OWN channel — what a single
// shared channel can't give you. A logger owns a channel and prints; a forwarder
// owns a channel and relays each message to the logger's channel; a driver sends
// to both. Each channel is a separate value, passed where it's needed.
//
// Run:  witchy examples/actors_async.witchy
//       witchy parity examples/actors_async.witchy

import chan

async fn logger(console: Console, rx: Receiver(String)) -> Nil:
    await chan.serve(rx, 1, fn(count, msg):
        print(console, "[${count}] " + msg)
        chan.done(count + 1)
    )

async fn forwarder(rx: Receiver(String), log_tx: Sender(String)) -> Nil:
    await chan.consume(rx, fn(msg): chan.send(log_tx, msg))

async fn driver(log_tx: Sender(String), fwd_tx: Sender(String)) -> Nil:
    await chan.send(log_tx, "direct message")
    await chan.send(fwd_tx, "relayed message")
    await chan.send(log_tx, "another direct")

async fn main(console: Console):
    let (log_tx, log_rx) = await chan.channel(8)
    let (fwd_tx, fwd_rx) = await chan.channel(8)
    let lh = await chan.spawn(logger(console, log_rx))
    let fh = await chan.spawn(forwarder(fwd_rx, log_tx))
    await driver(log_tx, fwd_tx)
    await chan.join(fh)
    await chan.join(lh)
