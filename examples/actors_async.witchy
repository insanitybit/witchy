// Multiple actors with SEPARATE mailboxes, in the async/channel model — the
// replacement for the `actor`/`spawn`/`Subject` system (see
// docs/concurrency-design.md). Compare examples/actors.witchy (Logger + Forwarder).
//
// Each task in `chan.run` gets its own inbox, addressed by its index: a Logger
// (#0), a Forwarder (#1) that relays to the Logger, and a driver (#2) that sends
// to both. `send(target, msg)` routes to a specific actor; `recv()` reads the
// current task's inbox. The state of an actor (here the Logger's count) lives in
// its recursive parameter — no mutable field needed. Cooperative, deterministic,
// byte-identical on both backends.
//
// Run:  witchy examples/actors_async.witchy
//       witchy parity examples/actors_async.witchy

import chan

async fn logger(console: Console, count: Int) -> Nil:
    let msg = await chan.recv()
    print(console, "[${count}] " + msg)
    await logger(console, count + 1)

async fn forwarder() -> Nil:
    let msg = await chan.recv()
    await chan.send(0, msg)
    await forwarder()

async fn driver() -> Nil:
    await chan.send(0, "direct message")
    await chan.send(1, "relayed message")
    await chan.send(0, "another direct")

fn main(console: Console):
    chan.run([logger(console, 1), forwarder(), driver()])
