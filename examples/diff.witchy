// diff — a line diff by longest common subsequence. We fill the classic LCS
// length table over the two line lists, then backtrack from the bottom-right
// corner: a matching line is unchanged ("  "), otherwise we step in the
// direction of the longer subsequence, emitting a deletion ("- ", only in old)
// or an insertion ("+ ", only in new). Pure (Console only); identical on both
// backends. Run:  witchy examples/diff.witchy

import list
import math

fn main(console: Console):
    let old = ["apple", "banana", "cherry", "date", "fig"]
    let new = ["apple", "cherry", "date", "elderberry", "fig"]
    for marked in diff(old, new):
        print(console, marked)

fn diff(old: List(String), new: List(String)) -> List(String):
    let table = lcs_table(old, new)
    var out = []
    var i = list.length(old)
    var j = list.length(new)
    while i > 0 && j > 0:
        if list.at(old, i - 1) == list.at(new, j - 1):
            out = list.push(out, "  " + list.at(old, i - 1))
            i = i - 1
            j = j - 1
        else if list.at(list.at(table, i - 1), j) >= list.at(list.at(table, i), j - 1):
            out = list.push(out, "- " + list.at(old, i - 1))
            i = i - 1
        else:
            out = list.push(out, "+ " + list.at(new, j - 1))
            j = j - 1
    while i > 0:
        out = list.push(out, "- " + list.at(old, i - 1))
        i = i - 1
    while j > 0:
        out = list.push(out, "+ " + list.at(new, j - 1))
        j = j - 1
    list.reverse(out)

// table[i][j] = length of the LCS of old[0..i] and new[0..j], built row by row.
fn lcs_table(old: List(String), new: List(String)) -> List(List(Int)):
    let rows = list.length(old)
    let cols = list.length(new)
    var table = [zeros(cols + 1)]
    var i = 1
    while i <= rows:
        let above = list.at(table, i - 1)
        var row = [0]
        var j = 1
        while j <= cols:
            var value = 0
            if list.at(old, i - 1) == list.at(new, j - 1):
                value = list.at(above, j - 1) + 1
            else:
                value = math.max(list.at(row, j - 1), list.at(above, j))
            row = list.push(row, value)
            j = j + 1
        table = list.push(table, row)
        i = i + 1
    table

fn zeros(n: Int) -> List(Int):
    var out = []
    var k = 0
    while k < n:
        out = list.push(out, 0)
        k = k + 1
    out
