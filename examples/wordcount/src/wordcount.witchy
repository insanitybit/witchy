// A word-frequency count using the Dict associative map. `dict.new()` makes an
// empty map; `.get_or` reads with a default; `.insert` updates a key in place.
// Keys are compared by value, so the same word lands in the same bucket.
fn main(console: Console):
    let text = "the cat the dog the bird"
    let words = text.split(" ")

    var counts = dict.new()
    for w in words:
        counts.insert(w, counts.get_or(w, 0) + 1)

    console.print("${counts.get_or("the", 0)}")
    console.print("${counts.get_or("cat", 0)}")
    console.print("${counts.get_or("missing", 0)}")
    console.print("${counts.length()}")
