// The `Show` trait renders any type as a String — including your own, which the
// built-in `to_string` cannot. A blanket `impl Show for List(a) where a: Show`
// means `say` renders a whole list through each element's Show impl, so it works
// for lists of user types too, and it produces the same output whether
// interpreted or compiled.

import show

type Coord:
    Coord(Int, Int)

impl Show for Coord:
    fn show(self) -> String:
        match self:
            Coord(x, y) -> "(${x}, ${y})"

fn main(console: Console):
    show.say(console, [1, 2, 3])
    show.say(console, [Coord(0, 0), Coord(3, 4)])
