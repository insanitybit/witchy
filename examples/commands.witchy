// Several features working together: an ADT, a `match` over it, an `inout`
// parameter that mutates the caller's variable in place, and the Console
// capability for output. Runs in the interpreter and compiles to WASM.
type Op:
    Inc
    Dec

fn apply(var n: Int, op: Op):
    match op:
        Inc -> n = n + 1
        Dec -> n = n - 1

fn main(console: Console):
    var total = 0
    apply(total, Inc)
    apply(total, Inc)
    apply(total, Dec)
    print(console, "total is " <> to_string(total))
