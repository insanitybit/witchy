// String slicing and search: split a `key=value` setting using `index_of` to
// find the separator and `substring` to take each side. `substring` is char-
// based and clamps to bounds, so it never panics on a bad index.
fn main(console: Console):
    let setting = "timeout=30"
    let eq = string.index_of(setting, "=")

    let key = string.substring(setting, 0, eq)
    let value = string.substring(setting, eq + 1, string.length(setting))

    print(console, key)
    print(console, value)
    print(console, "${string.ends_with(setting, "30")}")
