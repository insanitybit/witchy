// In-rune tests for `app`'s `strutil` library. Each `test_*` function takes no
// parameters, passes by returning, and fails by aborting. Run them with
// `witchy test examples/app`.

import strutil
import testing

fn test_shout():
    testing.assert_eq(strutil.shout("witchy"), "HELLO, witchy")
    testing.assert_eq(strutil.shout(""), "HELLO, ")
