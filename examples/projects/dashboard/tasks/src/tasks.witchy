// tasks — a dashboard widget: a one-line task-completion summary, rendered with
// the shared `bars` base (a path dependency). Pure: no host capabilities.

import bars
import string

// "tasks    [####----]  50%"
pub fn summary(done: Int, total: Int) -> String:
    string.pad_right("tasks", 9, " ") + bars.bar(done, total, 8) + " " + string.pad_left("${bars.pct(done, total)}", 3, " ") + "%"
