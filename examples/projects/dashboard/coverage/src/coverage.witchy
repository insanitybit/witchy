// coverage — a dashboard widget: a one-line test-coverage summary, rendered with
// the shared `bars` base (a path dependency). Pure: no host capabilities.

import bars
import string

// "coverage [######--]  75%"
pub fn summary(passed: Int, total: Int) -> String:
    string.pad_right("coverage", 9, " ") <> bars.bar(passed, total, 8) <> " " <> string.pad_left(int_to_string(bars.pct(passed, total)), 3, " ") <> "%"
