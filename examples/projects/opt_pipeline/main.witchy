mode opt

import stats

// The entry module is `mode opt`, so every module it imports must be too —
// `stats` here is, which is why this compiles. The optimization discipline is
// therefore a guarantee over the whole program, not just this file.
fn main(console: Console):
    // Build the sample in place — O(n) under `mode opt`, not O(n²) copying.
    var xs = []
    for i in [4, 8, 15, 16, 23, 42]:
        xs = list.push(xs, i)

    console.print("n:    ${stats.count(xs)}")
    console.print("sum:  ${stats.total(xs)}")
    console.print("mean: ${stats.mean(xs)}")
