// convertlib — turn CSV text into a JSON array of objects. A pure library rune
// (a path dependency of `csvconvert`) showcasing std `csv` + `json`: it decodes the
// rows, keys each data row by the header (preserving column order), and builds
// real Json values — integers stay numbers, everything else is a string — then
// pretty-prints them. `csv.decode` is fallible (RFC-0044), so this returns a
// `Result` too, propagating a malformed-CSV error with `?`.

import csv
import string
from json import Json

// CSV (with a header row) as pretty-printed JSON: one object per data row.
pub fn csv_to_json(csv_text: String) -> Result(String, String):
    let rows = csv.decode(csv_text)?
    if list.length(rows) == 0:
        Ok("[]")
    else:
        let header = list.at(rows, 0)
        var objects = []
        var i = 1
        while i < list.length(rows):
            objects = list.push(objects, row_object(header, list.at(rows, i)))
            i = i + 1
        Ok(json.encode_pretty(JsonArray(objects)))

// One JSON object, pairing each header column with this row's value.
fn row_object(header: List(String), row: List(String)) -> Json:
    var fields = []
    var c = 0
    while c < list.length(header):
        fields = list.push(fields, (list.at(header, c), to_json_value(list.at(row, c))))
        c = c + 1
    JsonObject(fields)

// An integer-looking field becomes a JSON number; anything else a JSON string.
fn to_json_value(value: String) -> Json:
    match string.parse_int(value):
        Some(n) -> JsonInt(n)
        None -> JsonString(value)
