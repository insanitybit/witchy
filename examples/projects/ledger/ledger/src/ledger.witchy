// ledger — a bank-account actor. `Account` is granted a Console capability at
// spawn (so it may print) and keeps its balance as isolated private state;
// deposits and withdrawals arrive as messages, processed run-to-completion in
// FIFO order. Amounts are formatted by the `money` rune (a local path
// dependency). `witchy caps` shows the whole program needs only `Console`. Run:
//   witchy run

import money

actor Account:
    console: Console
    var cents: Int = 0

impl Account:
    on Deposit(amount: Int):
        cents = cents + amount
        print(console, "deposit  " <> money.format(amount) <> "  -> balance " <> money.format(cents))
    on Withdraw(amount: Int):
        cents = cents - amount
        print(console, "withdraw " <> money.format(amount) <> "  -> balance " <> money.format(cents))

fn main(console: Console):
    let acct = spawn Account(console)
    send(acct, Deposit(1250))
    send(acct, Deposit(375))
    send(acct, Withdraw(500))
    send(acct, Deposit(99))
