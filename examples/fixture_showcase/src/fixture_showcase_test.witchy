import fixture_showcase
import testing

// The pure seam needs no fixture provider.
fn test_release_line():
    testing.assert_eq(fixture_showcase.release_line("api", "staging", 1700000000000), "release api at 1700000000000ms in staging")

// Only the root package may ask the test runner to assemble this authority
// record. Dependencies cannot forge or request it.
capability FixtureWorld:
    console: Console
    clock: Clock
    env: Env
    args: List(String)

fn test_fixture_world(world: FixtureWorld):
    match world:
        FixtureWorld(console, clock, env, args) ->
            fixture_showcase.emit_release(console, clock, env, args)
