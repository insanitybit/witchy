// In-rune tests for `strings`. Each `test_*` function takes no parameters, passes
// by returning, and fails by aborting (the `testing` assertions do that with a
// message). Run them with `witchy test examples/strings`.

import strings
import testing

fn test_shout():
    testing.assert_eq(strings.shout("witchy"), "hello, witchy")
    testing.assert_eq(strings.shout(""), "hello, ")
