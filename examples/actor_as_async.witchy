// An actor, written in the unified async/channel model — the replacement for the
// `actor`/`on`/`ask`/`reply` system (see docs/concurrency-design.md).
//
// The "actor" is just an `async fn` that loops on `recv`. Its STATE lives in the
// recursive parameter `n` (no mutable field needed). A fire-and-forget message
// (`Bump`) is a `send`. A request/reply (`Get` -> `Count`) — what actors call
// `ask`/`reply` — is just sending a reply message back on the channel: no special
// primitive, because async/await and generic channels compose. Cooperative,
// deterministic, and byte-identical on both backends.
//
// Run:  witchy examples/actor_as_async.witchy
//       witchy parity examples/actor_as_async.witchy

import chan

type Msg:
    Bump
    Get
    Count(Int)

async fn counter(n: Int) -> Nil:
    let m = await chan.recv()
    match m:
        Bump -> await counter(n + 1)
        Get ->
            await chan.send(1, Count(n))
            await counter(n)
        Count(_c) -> await counter(n)

async fn client(console: Console) -> Nil:
    await chan.send(0, Bump)
    await chan.send(0, Bump)
    await chan.send(0, Get)
    let r = await chan.recv()
    match r:
        Count(c) -> print(console, "count = ${c}")
        Bump -> print(console, "(unreachable)")
        Get -> print(console, "(unreachable)")

fn main(console: Console):
    chan.run([counter(0), client(console)])
