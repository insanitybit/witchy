// In-rune tests for `lazy_fib`. Each `test_*` function takes no parameters, passes
// by returning, and fails by aborting. Run them with `witchy test examples/lazy_fib`.

import lazy_fib
import iter
import list
import testing

fn test_first_ten():
    let first10: List(Int) = iter.collect(iter.take(lazy_fib.fibs(), 10))
    testing.assert_int_eq(list.length(first10), 10)
    testing.assert_int_eq(list.at(first10, 0), 0)
    testing.assert_int_eq(list.at(first10, 1), 1)
    testing.assert_int_eq(list.at(first10, 6), 8)
    testing.assert_int_eq(list.at(first10, 9), 34)

fn test_even_sum_below_1000():
    let small = iter.take_while(lazy_fib.fibs(), fn(n: Int): n < 1000)
    let evens = iter.filter(small, fn(n: Int): n % 2 == 0)
    testing.assert_int_eq(iter.sum(evens), 798)

fn test_first_above_1000():
    match iter.find(lazy_fib.fibs(), fn(n: Int): n > 1000):
        Some(n) -> testing.assert_int_eq(n, 1597)
        None -> testing.fail_with("expected a fib > 1000")
