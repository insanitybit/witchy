// In-rune tests for `lazy_fib`. Each `test_*` function takes no parameters, passes
// by returning, and fails by aborting. Run them with `witchy test examples/lazy_fib`.

import lazy_fib
import iter
import list
import testing

fn test_first_ten():
    let first10: List(Int) = iter.collect(lazy_fib.fibs().take(10))
    testing.assert_int_eq(first10.length(), 10)
    testing.assert_int_eq(first10.at(0), 0)
    testing.assert_int_eq(first10.at(1), 1)
    testing.assert_int_eq(first10.at(6), 8)
    testing.assert_int_eq(first10.at(9), 34)

fn test_even_sum_below_1000():
    let small = lazy_fib.fibs().take_while(fn(n: Int): n < 1000)
    let evens = small.filter(fn(n: Int): n % 2 == 0)
    testing.assert_int_eq(evens.sum(), 798)

fn test_first_above_1000():
    match lazy_fib.fibs().find(fn(n: Int): n > 1000):
        Some(n) -> testing.assert_int_eq(n, 1597)
        None -> testing.fail_with("expected a fib > 1000")
