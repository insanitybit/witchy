// Lazy infinite sequences with std/iter — witchy's answer to Rust's `Iterator`
// adapter chains (and the kind of thing Go uses channels/generators for).
// `fibs()` is an *infinite* iterator built with `unfold`; the consumers below
// bound it, so only the demanded prefix is ever computed. Runs on both backends
// — witchy's value semantics mean there's no lending-iterator complexity.

import iter
import string

// The Fibonacci numbers 0, 1, 1, 2, 3, 5, 8, ... as an infinite iterator.
// `unfold` threads the pair (current, next) as its state, yielding `current`.
pub fn fibs() -> Iter(Int):
    iter.unfold((0, 1), fn(p: (Int, Int)): fib_step(p))

fn fib_step(p: (Int, Int)) -> Option((Int, (Int, Int))):
    match p:
        (a, b) -> Some((a, (b, a + b)))

fn show(xs: List(Int)) -> String:
    var parts = []
    for x in xs:
        parts = parts.push("${x}")
    parts.join(", ")

fn main(console: Console):
    // The first 10 Fibonacci numbers (take, then collect into a list).
    let first10: List(Int) = iter.collect(iter.take(fibs(), 10))
    console.print("first 10: " + show(first10))

    // The sum of the even Fibonacci numbers below 1000 — take_while / filter /
    // sum, all lazy over the infinite stream.
    let small = iter.take_while(fibs(), fn(n: Int): n < 1000)
    let evens = iter.filter(small, fn(n: Int): n % 2 == 0)
    console.print("even fib sum < 1000: " + "${iter.sum(evens)}")

    // The first Fibonacci number past 1000 — found by scanning an infinite
    // iterator that stops at the first match.
    match iter.find(fibs(), fn(n: Int): n > 1000):
        Some(n) -> console.print("first fib > 1000: " + "${n}")
        None -> console.print("none")
