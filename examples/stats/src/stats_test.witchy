// In-rune tests for `stats`. Each `test_*` function takes no parameters, passes
// by returning, and fails by aborting (the `testing` assertions do that with a
// message). Floats are rendered with `math.format_float` before comparison. Run
// them with `witchy test examples/stats`.

import stats
import math
import testing

fn test_mean():
    let data = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
    testing.assert_eq(math.format_float(stats.mean(data), 2), "5.00")

fn test_variance_and_stddev():
    let data = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
    let avg = stats.mean(data)
    let v = stats.variance(data, avg)
    testing.assert_eq(math.format_float(v, 2), "4.00")
    testing.assert_eq(math.format_float(math.sqrt(v), 2), "2.00")

fn test_min_max():
    let data = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
    testing.assert_eq(math.format_float(stats.minimum(data), 2), "2.00")
    testing.assert_eq(math.format_float(stats.maximum(data), 2), "9.00")
