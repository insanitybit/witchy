// maze — breadth-first shortest path through a grid maze. Walls are `#`, `S` is
// the start and `E` the exit. BFS explores outward from `S` a ring at a time, so
// the first time it reaches `E` it has the shortest route; a `prev` Dict (keyed
// by an encoded `row*width + col` position) records how each cell was reached, so
// the route can be walked back and marked with `*`. Pure (Console only).
// Run:  witchy examples/maze/src/maze.witchy

import string
import dict

fn main(console: Console):
    let maze = ["#########", "#S#   # #", "# # # # #", "#   #   #", "### ### #", "#     #E#", "#########"]

    let width = string.char_count(maze.at(0))
    let start = find(maze, "S", width)
    let goal = find(maze, "E", width)
    let prev = solve(maze, start, goal, width)
    if prev.contains_key(goal):
        render_path(console, maze, prev, start, goal, width)
    else:
        console.print("no path from S to E")

// BFS from `start`, returning the `prev` map (position -> the position we reached
// it from). The goal appears in the map exactly when it is reachable.
fn solve(maze: List(String), start: Int, goal: Int, width: Int) -> Dict(Int, Int):
    var queue = [start]
    var prev = dict.new()
    prev.insert(start, start)
    var found = false
    while queue.length() > 0 && !found:
        let pos = queue.at(0)
        queue = rest(queue)
        if pos == goal:
            found = true
        else:
            for step in steps(maze, pos, width):
                if !prev.contains_key(step):
                    prev.insert(step, pos)
                    queue.push(step)
    prev

// The open (non-wall) neighbours of `pos`, up/down/left/right.
fn steps(maze: List(String), pos: Int, width: Int) -> List(Int):
    let r = pos / width
    let c = pos - r * width
    var out = []
    out = consider(maze, out, r - 1, c, width)
    out = consider(maze, out, r + 1, c, width)
    out = consider(maze, out, r, c - 1, width)
    out = consider(maze, out, r, c + 1, width)
    out

fn consider(maze: List(String), out: List(Int), r: Int, c: Int, width: Int) -> List(Int):
    var result = out
    if r >= 0 && r < maze.length() && c >= 0 && c < width && cell(maze, r, c) != "#":
        result.push(r * width + c)
    result

pub fn cell(maze: List(String), r: Int, c: Int) -> String:
    string.substring(maze.at(r), c, c + 1)

// The position of marker `m` (e.g. "S"), encoded as row*width + col.
pub fn find(maze: List(String), m: String, width: Int) -> Int:
    var pos = 0
    var r = 0
    for row in maze:
        var c = 0
        while c < width:
            if row.substring(c, c + 1) == m:
                pos = r * width + c
            c = c + 1
        r = r + 1
    pos

// Walk `prev` back from goal to start, collecting the route, then render the maze
// with the route marked `*` (start/exit kept as S/E).
fn render_path(console: Console, maze: List(String), prev: Dict(Int, Int), start: Int, goal: Int, width: Int):
    // The set of cells on the chosen route (a Dict used as a set); the goal is on
    // it and renders as `E` regardless.
    var route = dict.new()
    route.insert(goal, 1)
    var at_pos = goal
    var steps_count = 0
    while at_pos != start:
        route.insert(at_pos, 1)
        at_pos = prev.get_or(at_pos, start)
        steps_count = steps_count + 1
    console.print("shortest path: ${steps_count} steps")
    var r = 0
    for row in maze:
        var line = ""
        var c = 0
        while c < width:
            let here = r * width + c
            line = line + glyph(row.substring(c, c + 1), route.contains_key(here))
            c = c + 1
        console.print(line)
        r = r + 1

fn glyph(original: String, on_route: Bool) -> String:
    if original == "S" || original == "E":
        original
    else if on_route:
        "*"
    else:
        original

// Drop the first element of a list (the BFS dequeue).
fn rest(xs: List(Int)) -> List(Int):
    var out = []
    var i = 1
    while i < xs.length():
        out.push(xs.at(i))
        i = i + 1
    out
