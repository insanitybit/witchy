// In-rune tests for `option_std`. Each `test_*` function takes no parameters,
// passes by returning, and fails by aborting (the `testing` assertions do that
// with a message). Run them with `witchy test examples/option_std`.

import option_std
import option
import testing

fn test_first_nonempty():
    testing.assert_int_eq(option.unwrap_or(option_std.first([10, 20, 30]), 0), 10)

fn test_first_empty():
    testing.assert_int_eq(option.unwrap_or(option_std.first([]), 0 - 1), 0 - 1)
