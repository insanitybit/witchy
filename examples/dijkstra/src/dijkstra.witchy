// dijkstra — single-source shortest paths in a weighted directed graph. Nodes
// are indices; the graph is an edge list of (from, to, weight). We keep a
// distance and predecessor per node, repeatedly settle the nearest unsettled
// node (a linear find-min, fine for a small graph), and relax its outgoing
// edges. Afterwards we print every distance and reconstruct one shortest path.
// Pure (Console only); identical interpreted and compiled. Run:
//   witchy examples/dijkstra.witchy

import string
import list

fn main(console: Console):
    let names = ["A", "B", "C", "D", "E"]
    let edges = [(0, 1, 4), (0, 2, 1), (2, 1, 2), (1, 3, 1), (2, 3, 5), (3, 4, 3)]

    let source = 0
    let target = 4
    let (dist, prev) = dijkstra(list.length(names), edges, source)
    print(console, "shortest distances from " + list.at(names, source) + ":")
    var i = 0
    while i < list.length(names):
        print(console, "  " + list.at(names, i) + " = " + "${list.at(dist, i)}")
        i = i + 1
    print(console, "path to " + list.at(names, target) + ": " + string.join(path_to(names, prev, target), " -> "))

// Returns (distance from source, predecessor) for every node. Unreachable nodes
// keep a sentinel distance; predecessors start at -1.
pub fn dijkstra(n: Int, edges: List((Int, Int, Int)), source: Int) -> (List(Int), List(Int)):
    let unreachable = 1000000
    var dist = filled(n, unreachable)
    var prev = filled(n, -1)
    var settled = filled_bool(n, false)
    dist = put(dist, source, 0)
    var step = 0
    while step < n:
        let u = nearest_unsettled(dist, settled)
        if u >= 0:
            settled = put_bool(settled, u, true)
            for edge in edges:
                let (from, to, weight) = edge
                if from == u && list.at(dist, u) + weight < list.at(dist, to):
                    dist = put(dist, to, list.at(dist, u) + weight)
                    prev = put(prev, to, u)
        step = step + 1
    (dist, prev)

// The unsettled node with the smallest tentative distance, or -1 if none remain.
fn nearest_unsettled(dist: List(Int), settled: List(Bool)) -> Int:
    var best = -1
    var best_dist = 0
    var i = 0
    while i < list.length(dist):
        if !list.at(settled, i) && (best < 0 || list.at(dist, i) < best_dist):
            best = i
            best_dist = list.at(dist, i)
        i = i + 1
    best

// Node names along the shortest path to `target`, walking predecessors back to
// the source and reversing.
pub fn path_to(names: List(String), prev: List(Int), target: Int) -> List(String):
    var reversed = []
    var current = target
    while current >= 0:
        reversed = list.push(reversed, list.at(names, current))
        current = list.at(prev, current)
    list.reverse(reversed)

fn put(xs: List(Int), index: Int, value: Int) -> List(Int):
    var out = []
    var i = 0
    for x in xs:
        if i == index:
            out = list.push(out, value)
        else:
            out = list.push(out, x)
        i = i + 1
    out

fn put_bool(xs: List(Bool), index: Int, value: Bool) -> List(Bool):
    var out = []
    var i = 0
    for x in xs:
        if i == index:
            out = list.push(out, value)
        else:
            out = list.push(out, x)
        i = i + 1
    out

fn filled(n: Int, value: Int) -> List(Int):
    var out = []
    var i = 0
    while i < n:
        out = list.push(out, value)
        i = i + 1
    out

fn filled_bool(n: Int, value: Bool) -> List(Bool):
    var out = []
    var i = 0
    while i < n:
        out = list.push(out, value)
        i = i + 1
    out
