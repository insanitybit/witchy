// In-rune tests for `eval`. Each `test_*` function takes no parameters, passes by
// returning, and fails by aborting (the `testing` assertions do that with a
// message). Run them with `witchy test examples/eval`.

import eval
import testing

fn test_literal():
    testing.assert_int_eq(eval.eval(Num(7)), 7)

fn test_add():
    testing.assert_int_eq(eval.eval(Add(Num(2), Num(3))), 5)

fn test_mul():
    testing.assert_int_eq(eval.eval(Mul(Num(4), Num(5))), 20)

fn test_nested():
    // (2 + 3) * 4 = 20
    let e = Mul(Add(Num(2), Num(3)), Num(4))
    testing.assert_int_eq(eval.eval(e), 20)
