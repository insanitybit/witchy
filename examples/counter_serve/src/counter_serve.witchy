// A counter server, written with `chan.serve` — the stateful server loop as a
// combinator. It receives a message, runs the handler to get the next state, and
// repeats, threading `n` through every message so you never write the recv/recurse
// loop yourself. The server holds the Receiver; clients hold a Sender. A `Get`
// carries a reply Sender, so the answer comes back on a channel the client made.
//
// Run:  witchy examples/counter_serve.witchy
//       witchy parity examples/counter_serve.witchy

import chan

type Msg:
    Bump
    Get(Sender(Msg))
    Count(Int)

async fn counter(inbox: Receiver(Msg)) -> Nil:
    chan.serve(inbox, 0, fn(n, m):
        match m:
            Bump -> chan.done(n + 1)
            Get(reply) -> chan.and_then(chan.send(reply, Count(n)), fn(_u): chan.done(n))
            Count(_c) -> chan.done(n)
    ).await

async fn client(console: Console, srv: Sender(Msg)) -> Nil:
    chan.send(srv, Bump).await
    chan.send(srv, Bump).await
    let (reply_tx, reply_rx) = chan.channel(1).await
    chan.send(srv, Get(reply_tx)).await
    let r = chan.recv(reply_rx).await
    match r:
        Some(Count(c)) -> print(console, "count = ${c}")
        Some(Bump) -> print(console, "(unreachable)")
        Some(Get(_s)) -> print(console, "(unreachable)")
        None -> print(console, "(no reply)")

async fn main(console: Console):
    let (srv_tx, srv_rx) = chan.channel(8).await
    let h = chan.spawn(counter(srv_rx)).await
    client(console, srv_tx).await
    chan.join(h).await
