// Generators feeding a running computation: `readings` is an infinite `gen fn`
// (a pseudo-random stream), bounded by `iter.take`, collected into a list, then
// folded into a high-water mark as we print each sample.
import iter

gen fn readings(seed: Int) -> Iter(Int):
    var x = seed
    while true:
        x = (x * 33 + 1) % 97
        yield x

fn main(console: Console):
    let sample: List(Int) = iter.collect(iter.take(readings(1), 6))
    var high = 0
    for r in sample:
        if r > high:
            high = r
        print(console, "reading ${r}  (high ${high})")
