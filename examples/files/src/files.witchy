// Filesystem capability: `main` receives a `Dir` and narrows it to a subdirectory
// before reading a file. Authority flows by passing the capability down, never by
// ambient access — to read elsewhere you would need a `Dir` for that location.
fn main(console: Console, root: Dir):
    let examples = root.subtree("examples")
    let data = examples.subtree("data")
    match data.read("greeting.txt"):
        Ok(text) -> console.print(text)
        Err(e) -> console.print("cannot read the greeting: " + show(e))
