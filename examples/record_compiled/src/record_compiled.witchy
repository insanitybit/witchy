// Records and field access: a Point is a heap record [tag][x][y], and `p.x`
// loads a field by its offset. (The runtime representation behind ordinary
// record syntax — records, like sum-type matches, are values you compute with.)
type Point:
    x: Int
    y: Int

fn dist_squared(p: Point) -> Int:
    p.x * p.x + p.y * p.y

// A spread `Point(x: …, ..p)` also compiles: a new heap record is built, copying
// the base `p`'s slots and substituting the named overrides.
fn shift_x(p: Point, dx: Int) -> Point:
    Point(x: p.x + dx, ..p)

fn main(console: Console):
    let p = Point(3, 4)
    console.print("${dist_squared(shift_x(p, 1))}")
