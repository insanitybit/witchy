// Actor lifetimes: when handlers run, and when the program stops.
//
// `main` is a SETUP phase — every `.Msg()` send only enqueues; no handler runs
// until `main` returns. Then the runtime drains the queue one handler at a time
// (run-to-completion, no preemption), and the program ends when the queue is
// empty — "quiescence". A self-driving actor keeps the drain alive until it
// stops re-sending; an actor never explicitly "stops" or goes out of scope, it
// just becomes inert once nothing messages it.
//
// Run:  witchy examples/actor_lifetime.witchy
actor Logger:
    console: Console

impl Logger:
    on Note(n: Int):
        print(console, "  handling note " + "${n}")

actor Countdown:
    console: Console

impl Countdown:
    on Tick(self, n: Int):
        if n > 0:
            print(console, "  tick " + "${n}")
            self.Tick(n - 1)
        else:
            print(console, "  liftoff (queue drains to quiescence)")

fn main(console: Console):
    let log = spawn Logger(console)
    print(console, "[main] enqueuing 3 notes")
    log.Note(1)
    log.Note(2)
    log.Note(3)

    // A self-driving actor: each Tick handler enqueues the next.
    let cd = spawn Countdown(console)
    cd.Tick(2)

    // This prints BEFORE any handler output: main runs to completion first.
    print(console, "[main] returning — no handler has run yet")
