// life — Conway's Game of Life on a fixed grid. The board is rows of cells
// (`List(List(Bool))`); each generation applies the B3/S23 rule (a cell is born
// with exactly 3 live neighbours and survives with 2 or 3). A glider drifts down
// and to the right. Pure (Console only), so it runs identically on the
// interpreter and compiled to WASM. Run:  witchy examples/life/src/life.witchy
fn main(console: Console):
    var grid = glider(8)
    var generation = 0
    while generation < 4:
        console.print("generation ${generation}:")
        console.print(render(grid))
        grid = step(grid)
        generation = generation + 1

// An `size`x`size` board seeded with a glider in the top-left corner.
pub fn glider(size: Int) -> List(List(Bool)):
    var rows = []
    var r = 0
    while r < size:
        var row = []
        var c = 0
        while c < size:
            row.push(glider_cell(r, c))
            c = c + 1
        rows.push(row)
        r = r + 1
    rows

// The five live cells of a glider:  .#.
//                                   ..#
//                                   ###
fn glider_cell(r: Int, c: Int) -> Bool:
    r == 0 && c == 1 || r == 1 && c == 2 || r == 2 && c == 0 || r == 2 && c == 1 || r == 2 && c == 2

// Advance the board one generation.
pub fn step(grid: List(List(Bool))) -> List(List(Bool)):
    let height = grid.length()
    let width = grid.at(0).length()
    var next = []
    var r = 0
    while r < height:
        var row = []
        var c = 0
        while c < width:
            let n = neighbours(grid, r, c)
            let born_or_survives = if cell_at(grid, r, c): n == 2 || n == 3 else: n == 3
            row.push(born_or_survives)
            c = c + 1
        next.push(row)
        r = r + 1
    next

// The number of live cells in the 8 cells surrounding (r, c).
pub fn neighbours(grid: List(List(Bool)), r: Int, c: Int) -> Int:
    var count = 0
    var dr = -1
    while dr <= 1:
        var dc = -1
        while dc <= 1:
            if !(dr == 0 && dc == 0) && cell_at(grid, r + dr, c + dc):
                count = count + 1
            dc = dc + 1
        dr = dr + 1
    count

// A cell's state, with anything off the board counted as dead.
fn cell_at(grid: List(List(Bool)), r: Int, c: Int) -> Bool:
    if r < 0 || r >= grid.length():
        false
    else:
        let row = grid.at(r)
        if c < 0 || c >= row.length():
            false
        else:
            row.at(c)

pub fn render(grid: List(List(Bool))) -> String:
    var lines = []
    for row in grid:
        var line = ""
        for live in row:
            line = line + if live: "#" else: "."
        lines.push(line)
    lines.join("\n")
