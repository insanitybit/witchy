// `any`/`all` test a predicate (a closure) against a list and short-circuit via
// early return. Generic over the element type.

import list

fn main(console: Console):
    let nums = [2, 4, 6, 8]

    print(console, "${list.all(nums, fn(n: Int): n % 2 == 0)}")
    print(console, "${list.any(nums, fn(n: Int): n > 5)}")
    print(console, "${list.any(nums, fn(n: Int): n > 100)}")
    print(console, "${list.all(nums, fn(n: Int): n > 3)}")
