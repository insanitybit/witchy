// Channels: a producer sends values, a consumer receives them until the channel
// closes (no task can send anymore). Spawning and the channel are independent —
// the producer is `spawn`ed, and the channel is an ordinary value passed to both
// sides, not a task's mailbox. Deterministic and byte-identical on both backends.
//
// Run:  witchy examples/channels.witchy
//       witchy parity examples/channels.witchy

import chan

async fn producer(tx: Sender(Int)) -> Nil:
    for n in [1, 2, 3]:
        chan.send(tx, n).await

async fn consumer(console: Console, rx: Receiver(Int)) -> Nil:
    chan.consume(rx, fn(v): chan.done(print(console, "got ${v}"))).await

async fn main(console: Console):
    let (tx, rx) = chan.channel(4).await
    chan.spawn(producer(tx)).await
    consumer(console, rx).await
    print(console, "channel drained")
