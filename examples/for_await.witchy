// `await` inside a `for` loop: the body runs as a task per element, in order, so
// you iterate with `await` without hand-writing recursion. The producer sends a
// batch with a for-await loop; the worker consumes the channel until it closes.
//
// Run:  witchy examples/for_await.witchy
//       witchy parity examples/for_await.witchy

import chan

type Job:
    Do(Int)

async fn producer(tx: Sender(Job)) -> Nil:
    for n in [2, 3, 4]:
        await chan.send(tx, Do(n))

async fn worker(console: Console, rx: Receiver(Job)) -> Nil:
    await chan.consume(rx, fn(job):
        match job:
            Do(n) -> chan.done(print(console, "n*n = ${n * n}"))
    )

async fn main(console: Console):
    let (tx, rx) = await chan.channel(4)
    await chan.spawn(producer(tx))
    await worker(console, rx)
