// More list combinators from the standard library: membership, search, and
// slicing. `contains`/`index_of` work for any element type (they compare by
// value); `take`/`drop` split a list.

import list

fn main(console: Console):
    let xs = [10, 20, 30, 40]

    print(console, "${xs.contains(30)}")
    print(console, "${xs.index_of(40)}")
    print(console, "${xs.index_of(99)}")

    let head2 = xs.take(2)
    let tail2 = xs.drop(2)
    print(console, "${head2.at(1)}")
    print(console, "${tail2.at(0)}")
