// Request/reply with NO hardcoded addresses. The client learns its own address
// with `chan.address()` and sends it inside the request; the server replies to
// whatever address the request carried. Neither side hardcodes the other's
// position in the `run` list — contrast examples/actor_as_async.witchy, where the
// server replies to a literal `send(1, ...)`. Reorder the `run` list and this
// still works; the literal version would not.
//
// Run:  witchy examples/request_reply.witchy
//       witchy parity examples/request_reply.witchy

import chan

type Msg:
    Square(Int, Int)
    Result(Int)

// `seen` counts requests; the handler replies to the address the request carried
// (`reply_to`) before carrying the count forward.
async fn server() -> Nil:
    await chan.serve(0, fn(seen, m):
        match m:
            Square(n, reply_to) -> chan.and_then(chan.send(reply_to, Result(n * n)), fn(_u): chan.done(seen + 1))
            Result(_r) -> chan.done(seen)
    )

async fn client(console: Console) -> Nil:
    let me = await chan.address()
    await chan.send(0, Square(9, me))
    let r = await chan.recv()
    match r:
        Result(v) -> print(console, "9 squared is ${v}")
        Square(_n, _a) -> print(console, "(unreachable)")

fn main(console: Console):
    chan.run([server(), client(console)])
