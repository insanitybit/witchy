// Request/reply over a reply channel. The client makes its own one-shot channel
// and sends the Sender end inside the request; the server replies on whatever
// channel the request carried. No task indices, no hardcoded addresses — the
// reply path is a first-class value the client chose.
//
// Run:  witchy examples/request_reply.witchy
//       witchy parity examples/request_reply.witchy

import chan

type Msg:
    Square(Int, Sender(Msg))
    Result(Int)

async fn server(inbox: Receiver(Msg)) -> Nil:
    await chan.serve(inbox, 0, fn(seen, m):
        match m:
            Square(n, reply_to) -> chan.and_then(chan.send(reply_to, Result(n * n)), fn(_u): chan.done(seen + 1))
            Result(_r) -> chan.done(seen)
    )

async fn client(console: Console, srv: Sender(Msg)) -> Nil:
    let (reply_tx, reply_rx) = await chan.channel(1)
    await chan.send(srv, Square(9, reply_tx))
    let r = await chan.recv(reply_rx)
    match r:
        Some(Result(v)) -> print(console, "9 squared is ${v}")
        Some(Square(_n, _s)) -> print(console, "(unreachable)")
        None -> print(console, "(no reply)")

async fn main(console: Console):
    let (srv_tx, srv_rx) = await chan.channel(4)
    let h = await chan.spawn(server(srv_rx))
    await client(console, srv_tx)
    await chan.join(h)
