// Several features working together: an ADT, a `match` over it, a `var`
// parameter that mutates the caller's variable in place, and the Console
// capability for output. The ordinary command runs admitted Wasm;
// `witchy parity` can compare it with canonical SafeWIR.
type Op:
    Inc
    Dec

fn apply(var n: Int, op: Op):
    match op:
        Inc -> n = n + 1
        Dec -> n = n - 1

fn main(console: Console):
    var total = 0
    apply(total, Inc)
    apply(total, Inc)
    apply(total, Dec)
    console.print("total is " + "${total}")
