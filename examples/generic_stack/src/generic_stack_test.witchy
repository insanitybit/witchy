// In-rune tests for `generic_stack`. Each `test_*` function takes no parameters,
// passes by returning, and fails by aborting (the `testing` assertions do that
// with a message). Run them with `witchy test examples/generic_stack`.

from generic_stack import Stack
import testing

fn test_size():
    let s = Push(1, Push(2, Push(3, Empty)))
    testing.assert_int_eq(generic_stack.size(s), 3)
    testing.assert_int_eq(generic_stack.size(Empty), 0)

fn test_peek():
    let nums = Push(1, Push(2, Empty))
    testing.assert_eq(generic_stack.show_top_int(nums), "1")
    testing.assert_eq(generic_stack.show_top_int(Empty), "<empty>")

fn test_peek_string():
    let words = Push("first", Push("second", Empty))
    testing.assert_eq(generic_stack.show_top_str(words), "first")

fn test_reverse():
    // After reversing, the bottom element ends up on top.
    let nums = Push(1, Push(2, Push(3, Empty)))
    testing.assert_eq(generic_stack.show_top_int(generic_stack.reverse(nums)), "3")
