// In-rune tests for `anagram`. Each `test_*` function takes no parameters, passes
// by returning, and fails by aborting. Run them with `witchy test examples/anagram`.

import anagram
import string
import testing

fn test_signature():
    testing.assert_eq(anagram.signature("listen"), "eilnst")
    testing.assert_eq(anagram.signature("silent"), "eilnst")
    testing.assert_eq(anagram.signature("cat"), "act")

fn test_index_of():
    testing.assert_int_eq(anagram.index_of(["a", "b", "c"], "b"), 1)
    testing.assert_int_eq(anagram.index_of(["a", "b", "c"], "z"), -1)

fn test_group_anagrams():
    let groups = anagram.group_anagrams(["listen", "silent", "cat", "act"])
    // Two buckets: {listen, silent} and {cat, act}, in first-seen order.
    testing.assert_int_eq(list.length(groups), 2)
    testing.assert_eq(string.join(list.at(groups, 0), ","), "listen,silent")
    testing.assert_eq(string.join(list.at(groups, 1), ","), "cat,act")
