// anagram — group words that are rearrangements of the same letters. Each word
// gets a signature: its characters sorted and rejoined, so anagrams share a
// signature. We bucket words by signature using a parallel list of signatures
// and groups (no Dict, so it compiles on both backends). Exercises sorting
// characters (string `<`) and signature equality (string `==`). Pure (Console
// only); identical interpreted and compiled. Run:  witchy examples/anagram.witchy

import string
import list

fn main(console: Console):
    let words = ["listen", "silent", "enlist", "cat", "act", "dog", "god", "tac"]
    for group in group_anagrams(words):
        print(console, string.join(group, ", "))

pub fn group_anagrams(words: List(String)) -> List(List(String)):
    var signatures = []
    var groups = []
    for word in words:
        let sig = signature(word)
        let index = index_of(signatures, sig)
        if index < 0:
            signatures = list.push(signatures, sig)
            groups = list.push(groups, [word])
        else:
            groups = append_at(groups, index, word)
    groups

// A word's characters sorted and rejoined — equal exactly for anagrams.
pub fn signature(word: String) -> String:
    string.join(list.sort_by(string.chars(word), fn(a: String, b: String): a < b), "")

// The index of `target` in `xs`, or -1 if absent.
pub fn index_of(xs: List(String), target: String) -> Int:
    var i = 0
    var found = -1
    for x in xs:
        if found < 0 && x == target:
            found = i
        i = i + 1
    found

// Append `word` to the group at `index`, returning the updated list of groups.
fn append_at(groups: List(List(String)), index: Int, word: String) -> List(List(String)):
    var out = []
    var i = 0
    for group in groups:
        if i == index:
            out = list.push(out, list.push(group, word))
        else:
            out = list.push(out, group)
        i = i + 1
    out
