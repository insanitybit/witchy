// In-rune tests for `sort`. Each `test_*` function takes no parameters, passes
// by returning, and fails by aborting (the `testing` assertions do that with a
// message). Run them with `witchy test examples/sort`.

import sort
import list
import testing

fn test_show():
    testing.assert_eq(sort.show([3, 1, 4, 1, 5]), "3,1,4,1,5")
    testing.assert_eq(sort.show([]), "")

fn test_sort_by():
    let nums = [3, 1, 4, 1, 5]
    var ascending = nums
    ascending.sort_by(fn(a: Int, b: Int): a < b)
    testing.assert_eq(sort.show(ascending), "1,1,3,4,5")
    var descending = nums
    descending.sort_by(fn(a: Int, b: Int): a > b)
    testing.assert_eq(sort.show(descending), "5,4,3,1,1")
