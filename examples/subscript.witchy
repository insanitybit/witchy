// Subscript indexing: `xs[i]` reads the i-th element of a list — sugar for
// `list.at(xs, i)`. It chains for nested lists (`grid[r][c]`) and accepts any integer
// expression as the index. Pure (only `main` touches the Console), so it runs
// identically interpreted, compiled, and inside the capability sandbox:
//   witchy examples/subscript.witchy
//   witchy parity examples/subscript.witchy
//   witchy sandbox examples/subscript.witchy

import string

// Dot product of two equal-length vectors, read by index.
fn dot(a: List(Int), b: List(Int)) -> Int:
    var sum = 0
    var i = 0
    while i < list.length(a):
        sum = sum + a[i] * b[i]
        i = i + 1
    sum

fn main(console: Console):
    let u = [1, 2, 3]
    let v = [4, 5, 6]
    print(console, "dot = " + "${dot(u, v)}")

    // A 2D grid, indexed row-then-column with chained subscripts.
    let grid = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    print(console, "grid[1][2] = " + "${grid[1][2]}")

    // Sum of the main diagonal: grid[i][i].
    var diag = 0
    var i = 0
    while i < list.length(grid):
        diag = diag + grid[i][i]
        i = i + 1
    print(console, "diagonal sum = " + "${diag}")
