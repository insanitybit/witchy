// A small actor pipeline showing the full message model: Float and String
// fields, a List(String) summary, Float state accumulating across messages,
// and capability delegation — the Router is handed the Reporter's Subject IN
// a message and gains exactly the authority to message it, nothing more.
// Run:  witchy examples/dispatch.witchy
actor Reporter:
    console: Console
    var alerts: Int = 0

impl Reporter:
    on Alert(source: String, value: Float):
        alerts = alerts + 1
        print(console, "[alert ${alerts}] " + source + " at " + "${value}")
    on Summary(lines: List(String)):
        for line in lines:
            print(console, "summary: " + line)

actor Gauge:
    console: Console
    var total: Float = 0.0
    var count: Int = 0

impl Gauge:
    on Sample(x: Float):
        total = total + x
        count = count + 1
        print(console, "mean " + "${total / math.to_float(count)}")

actor Router:
    console: Console

impl Router:
    on Dispatch(dest: Subject, source: String, value: Float):
        print(console, "routing " + source)
        send(dest, Alert(source, value))

// The router was never configured with a reporter — the Subject inside the
// Dispatch message is what introduces them. Note the mailbox ordering: the
// relayed Alert is enqueued while Dispatch runs, so it prints after the
// directly-queued Summary.
fn main(console: Console):
    let reporter = spawn Reporter(console)
    let gauge = spawn Gauge(console)
    let router = spawn Router(console)

    send(gauge, Sample(2.0))
    send(gauge, Sample(4.0))

    send(router, Dispatch(reporter, "thermostat", 99.5))
    send(reporter, Summary(["2 samples", "1 alert"]))
