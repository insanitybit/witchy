// Capability-holding actors: authority enters an actor exactly once, as a
// spawn argument, and each compiled actor's VM links ONLY the host imports
// its fields entitle it to. `Quiet` below holds no Console — its VM has no
// print import to call, physically. The Clock travels as a type-level grant;
// a Dir or Net field would travel as a handle the host translates into the
// new VM's own table (attenuation survives the transfer — see
// examples/files.witchy for `subdir`).
actor Timer:
    console: Console
    clock: Clock

impl Timer:
    on Tick(label: String):
        if now(clock) > 0:
            print(console, "tick: " <> label)
        else:
            print(console, "the clock is broken")

actor Quiet:
    out: Subject

impl Quiet:
    on Relay(n: Int):
        // No Console here: this actor can compute and send, nothing else.
        send(out, Tick("relayed " <> int_to_string(n)))

fn main(console: Console, clock: Clock):
    let timer = spawn Timer(console, clock)
    let quiet = spawn Quiet(timer)
    send(quiet, Relay(7))
    send(timer, Tick("direct"))
