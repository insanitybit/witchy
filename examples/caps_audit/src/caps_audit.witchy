// caps_audit — a tiny capability auditor, written entirely in witchy. It reads a
// witchy source file with a *read-only* Dir capability, asks the compiler for the
// file's capability footprint (`compiler.footprint`, returned as JSON), parses it
// with `std/json`, and prints the total authority the file demands. A self-hosted
// slice of `witchy caps` — proof the toolchain is usable from within witchy. Run:
//   witchy examples/caps_audit/src/caps_audit.witchy

import compiler
from json import Json

fn main(console: Console, root: Dir[Read]):
    let target = "examples/data/sample_rune.witchy"
    let report = compiler.footprint(root.read(target))
    console.print(target + " demands: " + total_of(report))

// Pull the "total" array out of the footprint JSON and render it. Fails closed:
// a compiler error report is surfaced, never rendered as "(none)".
fn total_of(report: String) -> String:
    match json.decode(report):
        Ok(doc) ->
            match json.get(doc, "error"):
                Some(_) -> "compiler error: " + error_message(doc)
                None -> render_total(doc)
        Err(e) -> "parse error: " + json.decode_error_message(e)

fn error_message(doc: Json) -> String:
    match json.get_string(doc, "error"):
        Some(m) -> m
        None -> "source does not compile"

fn render_total(doc: Json) -> String:
    match json.get(doc, "total"):
        Some(total) -> string_items(total).join(", ")
        None -> "(none)"

// Collect a JSON array of strings into a witchy List(String).
fn string_items(j: Json) -> List(String):
    var out = []
    if let Some(items) = json.as_array(j):
        for it in items:
            if let Some(s) = json.as_string(it):
                out.push(s)
    out
