// jq — a tiny JSON query tool. It decodes a document and walks a dotted path into
// it, where each segment is either an object key or (when it parses as a number)
// an array index, then renders the selected value. A practical tour of std/json:
// `decode`, `get` / `index`, and `encode`. Pure (Console only); identical on both
// backends. Run:  witchy examples/jq.witchy

import string
from json import Json

fn main(console: Console):
    let document = "{\"user\":{\"name\":\"Ada\",\"roles\":[\"admin\",\"dev\"]},\"active\":true,\"count\":42}"
    for path in ["user.name", "user.roles", "user.roles.0", "user.roles.1", "count", "active", "user.missing"]:
        console.print(path.pad_right(16, " ") + "=> " + query(document, path))

pub fn query(document: String, path: String) -> String:
    match json.decode(document):
        Ok(value) -> render(navigate(value, path))
        Err(message) -> "parse error: " + json.decode_error_message(message)

fn render(selected: Option(Json)) -> String:
    match selected:
        Some(value) -> json.encode(value)
        None -> "(no such path)"

// Follow `path` (dot-separated). A numeric segment indexes an array; any other
// segment looks up an object key. A miss anywhere yields None.
fn navigate(root: Json, path: String) -> Option(Json):
    var current = Some(root)
    for segment in path.split("."):
        current = descend(current, segment)
    current

fn descend(current: Option(Json), segment: String) -> Option(Json):
    match current:
        Some(value) -> match segment.parse_int():
            Some(i) -> json.index(value, i)
            None -> json.get(value, segment)
        None -> None
