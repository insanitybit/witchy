// In-rune tests for `jq`. Each `test_*` function takes no parameters, passes by
// returning, and fails by aborting (the `testing` assertions do that with a
// message). Run them with `witchy test examples/jq`.

import jq
import testing

let document = "{\"user\":{\"name\":\"Ada\",\"roles\":[\"admin\",\"dev\"]},\"active\":true,\"count\":42}"

fn test_object_key():
    testing.assert_eq(jq.query(document, "user.name"), "\"Ada\"")

fn test_array_index():
    testing.assert_eq(jq.query(document, "user.roles.0"), "\"admin\"")
    testing.assert_eq(jq.query(document, "user.roles.1"), "\"dev\"")

fn test_scalars():
    testing.assert_eq(jq.query(document, "count"), "42")
    testing.assert_eq(jq.query(document, "active"), "true")

fn test_missing_path():
    testing.assert_eq(jq.query(document, "user.missing"), "(no such path)")
