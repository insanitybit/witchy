// matrix — integer matrices as a list of rows. Transpose, multiply, and an
// identity, printed with right-aligned columns. Multiplication is the textbook
// triple loop (dot each row of A with each column of B). Pure (Console only);
// identical on both backends. Run:  witchy examples/matrix.witchy

import string

fn main(console: Console):
    let a = [[1, 2, 3], [4, 5, 6]]
    let b = [[7, 8], [9, 10], [11, 12]]
    print(console, "A x B =")
    show(console, multiply(a, b))
    print(console, "transpose(A) =")
    show(console, transpose(a))
    print(console, "identity(3) =")
    show(console, identity(3))

fn show(console: Console, m: List(List(Int))):
    let width = cell_width(m)
    for row in m:
        var cells = []
        for value in row:
            cells = list.push(cells, string.pad_left("${value}", width, " "))
        print(console, "[ " + string.join(cells, " ") + " ]")

// The widest decimal cell, so every column lines up.
pub fn cell_width(m: List(List(Int))) -> Int:
    var width = 1
    for row in m:
        for value in row:
            let len = string.length("${value}")
            if len > width:
                width = len
    width

pub fn transpose(m: List(List(Int))) -> List(List(Int)):
    let rows = list.length(m)
    let cols = list.length(list.at(m, 0))
    var out = []
    var c = 0
    while c < cols:
        var column = []
        var r = 0
        while r < rows:
            column = list.push(column, list.at(list.at(m, r), c))
            r = r + 1
        out = list.push(out, column)
        c = c + 1
    out

pub fn multiply(a: List(List(Int)), b: List(List(Int))) -> List(List(Int)):
    let rows = list.length(a)
    let cols = list.length(list.at(b, 0))
    let inner = list.length(b)
    var out = []
    var i = 0
    while i < rows:
        var row = []
        var j = 0
        while j < cols:
            var sum = 0
            var k = 0
            while k < inner:
                sum = sum + list.at(list.at(a, i), k) * list.at(list.at(b, k), j)
                k = k + 1
            row = list.push(row, sum)
            j = j + 1
        out = list.push(out, row)
        i = i + 1
    out

pub fn identity(n: Int) -> List(List(Int)):
    var out = []
    var i = 0
    while i < n:
        var row = []
        var j = 0
        while j < n:
            if i == j:
                row = list.push(row, 1)
            else:
                row = list.push(row, 0)
            j = j + 1
        out = list.push(out, row)
        i = i + 1
    out
