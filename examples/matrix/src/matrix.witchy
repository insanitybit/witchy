// matrix — integer matrices as a list of rows. Transpose, multiply, and an
// identity, printed with right-aligned columns. Multiplication is the textbook
// triple loop (dot each row of A with each column of B). Pure (Console only);
// identical on both backends. Run:  witchy examples/matrix.witchy

import string

fn main(console: Console):
    let a = [[1, 2, 3], [4, 5, 6]]
    let b = [[7, 8], [9, 10], [11, 12]]
    console.print("A x B =")
    show(console, multiply(a, b))
    console.print("transpose(A) =")
    show(console, transpose(a))
    console.print("identity(3) =")
    show(console, identity(3))

fn show(console: Console, m: List(List(Int))):
    let width = cell_width(m)
    for row in m:
        var cells = []
        for value in row:
            cells = cells.push(string.pad_left("${value}", width, " "))
        console.print("[ " + cells.join(" ") + " ]")

// The widest decimal cell, so every column lines up.
pub fn cell_width(m: List(List(Int))) -> Int:
    var width = 1
    for row in m:
        for value in row:
            let len = string.length("${value}")
            if len > width:
                width = len
    width

pub fn transpose(m: List(List(Int))) -> List(List(Int)):
    let rows = m.length()
    let cols = list.length(m.at(0))
    var out = []
    var c = 0
    while c < cols:
        var column = []
        var r = 0
        while r < rows:
            column = column.push(list.at(m.at(r), c))
            r = r + 1
        out = out.push(column)
        c = c + 1
    out

pub fn multiply(a: List(List(Int)), b: List(List(Int))) -> List(List(Int)):
    let rows = a.length()
    let cols = list.length(b.at(0))
    let inner = b.length()
    var out = []
    var i = 0
    while i < rows:
        var row = []
        var j = 0
        while j < cols:
            var sum = 0
            var k = 0
            while k < inner:
                sum = sum + list.at(a.at(i), k) * list.at(b.at(k), j)
                k = k + 1
            row = row.push(sum)
            j = j + 1
        out = out.push(row)
        i = i + 1
    out

pub fn identity(n: Int) -> List(List(Int)):
    var out = []
    var i = 0
    while i < n:
        var row = []
        var j = 0
        while j < n:
            if i == j:
                row = row.push(1)
            else:
                row = row.push(0)
            j = j + 1
        out = out.push(row)
        i = i + 1
    out
