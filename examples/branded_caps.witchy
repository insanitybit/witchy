// Branded capabilities — a newtype around a host capability that records intent
// and refines the footprint. `ConfigDir` is a `Dir` you can only obtain through
// `config_dir` (a checked smart constructor); `load` then *statically* demands
// the brand, not just any `Dir`. The capability auditor sees through the brand —
// `ConfigDir` still audits as `Dir`, so authority can't hide — while reporting
// the refinement. Run from the repo root:
//   witchy examples/branded_caps.witchy
//   witchy caps examples/branded_caps.witchy     # load: Dir (refined: ConfigDir)

// A Dir confined to the application's config directory. The only constructor is
// `config_dir`, so a value of this type provably came through that gate.
type ConfigDir:
    ConfigDir(Dir)

// Smart constructor: narrow a granted Dir to its `data/` subtree and brand it.
// (A real one would also verify the directory exists and return an Option.)
// Public, so `witchy caps` lists it: it takes a raw `Dir` (no refinement).
pub fn config_dir(root: Dir) -> ConfigDir:
    ConfigDir(subdir(root, "data"))

// Reads only from the config dir — the signature requires the brand, and the
// `Dir` inside is confined to that subtree, so this can touch nothing else.
// Public, so `witchy caps` shows it auditing as `Dir`, refined as `ConfigDir`.
pub fn load(c: ConfigDir, name: String) -> String:
    match c:
        ConfigDir(dir) -> read(dir, name)

fn main(console: Console, root: Dir):
    let cfg = config_dir(subdir(root, "examples"))
    print(console, "config says: " <> load(cfg, "greeting.txt"))
