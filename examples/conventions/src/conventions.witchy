import list
import chan

fn bump(var n: Int):
    n = n + 1

fn sum_from(let xs: List(Int), i: Int) -> Int:
    if i >= list.length(xs):
        0
    else:
        list.at(xs, i) + sum_from(xs, i + 1)

fn doubled_first(xs: List(Int)) -> Int:
    list.at(xs, 0) * 2

fn drain(own xs: List(Int)) -> Int:
    list.length(xs)

type Bag:
    Bag(List(Int))

impl Bag:
    fn total(let self) -> Int:
        match self:
            Bag(items) -> sum_from(items, 0)

// An accumulator server: its running `sum` threads through `chan.serve`, and each
// batch of numbers arrives as a message (channels move values, so the task owns
// each batch — the `own` convention, made concrete).
async fn adder(console: Console, rx: Receiver(List(Int))) -> Nil:
    chan.serve(rx, 0, fn(sum, batch):
        let running = sum + sum_from(batch, 0)
        print(console, "running sum: " + "${running}")
        chan.done(running)
    ).await

async fn feeder(tx: Sender(List(Int))) -> Nil:
    chan.send(tx, [100, 200]).await
    chan.send(tx, [1, 2, 3]).await

async fn main(console: Console):
    var count = 0
    bump(count)
    bump(count)
    print(console, "count: " + "${count}")

    let nums = [1, 2, 3, 4]
    print(console, "sum: " + "${sum_from(nums, 0)}")
    print(console, "doubled first: " + "${doubled_first(nums)}")
    print(console, "nums still here, length: " + "${list.length(nums)}")

    let bag = Bag([10, 20, 30])
    print(console, "bag total: " + "${bag.total()}")

    let gone = [5, 6, 7]
    print(console, "drained length: " + "${drain(move gone)}")

    let (tx, rx) = chan.channel(4).await
    let h = chan.spawn(adder(console, rx)).await
    feeder(tx).await
    chan.join(h).await
