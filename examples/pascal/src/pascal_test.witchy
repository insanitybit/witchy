// In-rune tests for `pascal`. Each `test_*` function takes no parameters,
// passes by returning, and fails by aborting (the `testing` assertions do that
// with a message). Run them with `witchy test examples/pascal`.

import pascal
import testing

fn test_next_row():
    testing.assert_eq(pascal.show_row(pascal.next_row([1])), "1 1")
    testing.assert_eq(pascal.show_row(pascal.next_row([1, 1])), "1 2 1")
    testing.assert_eq(pascal.show_row(pascal.next_row([1, 2, 1])), "1 3 3 1")

fn test_show_row():
    testing.assert_eq(pascal.show_row([1, 4, 6, 4, 1]), "1 4 6 4 1")
