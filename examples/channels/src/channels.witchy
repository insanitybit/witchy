// A capacity-one channel forces the producer to wait while the consumer drains
// each value. Tasks and the channel are independent: `chan.scope` runs the
// producer and consumer together, and the channel is an ordinary typed value
// passed to both sides, not a task's mailbox. The result is deterministic on both backends.
//
// Run:  witchy examples/channels/src/channels.witchy
//       witchy parity examples/channels/src/channels.witchy

from chan import Receiver, Sender

async fn producer(tx: Sender(Int)):
    for n in [1, 2, 3, 4]:
        chan.send(tx, n).await

async fn consumer(console: Console, rx: Receiver(Int)):
    chan.consume(rx, fn(v): chan.done(console.print("got ${v}"))).await

async fn main(console: Console):
    let (tx, rx) = chan.channel(1).await
    chan.scope([producer(tx), consumer(console, rx)]).await
    console.print("channel drained")
