// Uses the bundled `math` standard library. Like every std module it is pure —
// importing it grants no authority, only computation.

import math

fn main(console: Console):
    print(console, "${math.max(3, 7)}")
    print(console, "${math.abs(-5)}")
    print(console, "${math.clamp(12, 0, 10)}")
    print(console, "${math.pow(2, 10)}")
    print(console, "${math.gcd(24, 36)}")
