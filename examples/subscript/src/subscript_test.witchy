// In-rune tests for `subscript`. Each `test_*` function takes no parameters,
// passes by returning, and fails by aborting (the `testing` assertions do that
// with a message). Run them with `witchy test examples/subscript`.

import subscript
import testing

fn test_dot():
    testing.assert_int_eq(subscript.dot([1, 2, 3], [4, 5, 6]), 32)
    testing.assert_int_eq(subscript.dot([0, 0, 0], [1, 2, 3]), 0)
    testing.assert_int_eq(subscript.dot([2, 2], [3, 3]), 12)
