// Actors and message passing: spawn grants each actor exactly its declared
// capabilities, send is fire-and-forget, and the mailbox drains in order.
actor Logger:
    console: Console
    var count: Int = 0

impl Logger:
    on Log(msg: String):
        count = count + 1
        print(console, "[" <> int_to_string(count) <> "] " <> msg)

actor Forwarder:
    logger: Subject

impl Forwarder:
    on Relay(msg: String):
        send(logger, Log(msg))

fn main(console: Console):
    let logger = spawn Logger(console)
    let fwd = spawn Forwarder(logger)

    send(logger, Log("direct message"))
    send(fwd, Relay("relayed message"))
    send(logger, Log("another direct"))
