// In-rune tests for `tuples`. Each `test_*` function takes no parameters, passes
// by returning, and fails by aborting. Run with `witchy test examples/tuples`.

import tuples
import testing

fn test_divmod_quotient_and_remainder():
    let (q, r) = tuples.divmod(17, 5)
    testing.assert_int_eq(q, 3)
    testing.assert_int_eq(r, 2)

fn test_divmod_by_position():
    testing.assert_int_eq(tuples.divmod(20, 4).0, 5)
    testing.assert_int_eq(tuples.divmod(20, 4).1, 0)
