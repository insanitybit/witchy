// With first-class functions and `push` (which returns a new list with an
// element appended), the usual list combinators are just ordinary witchy
// functions — `map` and `filter` are generic over the element types.
pub fn range(n: Int) -> List(Int):
    var out = []
    var i = 0
    while i < n:
        out = out.push(i)
        i = i + 1
    out

pub fn map(xs: List(a), f: fn(a) -> b) -> List(b):
    var out = []
    for x in xs:
        out = out.push(f(x))
    out

pub fn filter(xs: List(Int), keep: fn(Int) -> Bool) -> List(Int):
    var out = []
    for x in xs:
        if keep(x):
            out = out.push(x)
    out

pub fn sum(xs: List(Int)) -> Int:
    var total = 0
    for x in xs:
        total = total + x
    total

pub fn join(xs: List(String), sep: String) -> String:
    var s = ""
    var first = true
    for x in xs:
        if first:
            s = x
            first = false
        else:
            s = s + sep + x
    s

fn main(console: Console):
    let ns = range(6)
    let squares = map(ns, fn(n: Int): n * n)
    let evens = filter(ns, fn(n: Int): n % 2 == 0)
    print(console, "${sum(squares)}")
    print(console, "${sum(evens)}")
    let labels = map(evens, fn(n: Int): "${n}")
    print(console, join(labels, "-"))
