// With first-class functions and `push` (which returns a new list with an
// element appended), the usual list combinators are just ordinary witchy
// functions — `map` and `filter` are generic over the element types.
fn range(n: Int) -> List(Int):
    var out = []
    var i = 0
    while i < n:
        out = list.push(out, i)
        i = i + 1
    out

fn map(xs: List(a), f: fn(a) -> b) -> List(b):
    var out = []
    for x in xs:
        out = list.push(out, f(x))
    out

fn filter(xs: List(Int), keep: fn(Int) -> Bool) -> List(Int):
    var out = []
    for x in xs:
        if keep(x):
            out = list.push(out, x)
    out

fn sum(xs: List(Int)) -> Int:
    var total = 0
    for x in xs:
        total = total + x
    total

fn join(xs: List(String), sep: String) -> String:
    var s = ""
    var first = true
    for x in xs:
        if first:
            s = x
            first = false
        else:
            s = s <> sep <> x
    s

fn main(console: Console):
    let ns = range(6)
    let squares = map(ns, fn(n: Int): n * n)
    let evens = filter(ns, fn(n: Int): n % 2 == 0)
    print(console, to_string(sum(squares)))
    print(console, to_string(sum(evens)))
    let labels = map(evens, fn(n: Int): to_string(n))
    print(console, join(labels, "-"))
