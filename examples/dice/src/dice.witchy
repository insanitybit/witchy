// Deterministic pseudo-randomness with the std `prng` module: a seed replays
// the same sequence, so this prints the same rolls every run — and identically on
// the interpreter and compiled to WASM. `var Rng` write-back advances the
// explicit state (no hidden global and no capability needed).
// Run: witchy examples/dice/src/dice.witchy

import prng
import string
import list

fn main(console: Console):
    var r = prng.seed(7)
    var rolls = []
    var i = 0
    while i < 10:
        let face = r.next_below(6)
        rolls.push(face + 1)
        i = i + 1
    console.print(list.join(rolls.map(fn(n: Int): "${n}"), " "))
    console.print("total: " + "${rolls.sum()}")
