// Deterministic pseudo-randomness with the std `prng` module: a seed replays
// the same sequence, so this prints the same rolls every run — and identically on
// the interpreter and compiled to WASM. The generator state is threaded
// explicitly through an `Rng` value (no hidden global, no capability needed).
// Run: witchy examples/dice.witchy

import prng
import string
import list

fn main(console: Console):
    var r = prng.seed(7)
    var rolls = []
    var i = 0
    while i < 10:
        let (face, next) = prng.next_below(r, 6)
        rolls = rolls.push(face + 1)
        r = next
        i = i + 1
    print(console, list.join(rolls.map(fn(n: Int): "${n}"), " "))
    print(console, "total: " + "${rolls.sum()}")
