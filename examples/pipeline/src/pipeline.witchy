// Data pipelines compose the list module's transforms; for lazy chains over
// large or infinite data, see std/iter (examples/lazy_fib/src/lazy_fib.witchy).
// is the same UFCS sugar that powers the HTTP builders — `x.f(a)` is just
// `f(x, a)`, resolved to the right `list` function. Data-only, so it runs identically
// on the interpreter and compiled to WASM.
// Run: witchy examples/pipeline/src/pipeline.witchy

import list

fn main(console: Console):
    // Sum of the squares of the even numbers in 0..10.
    let evens = list.range(10).filter(fn(n: Int): n % 2 == 0)
    let total = list.sum(evens.map(fn(n: Int): n * n))

    console.print("${total}")

    // The first five numbers, doubled, rendered and comma-joined.
    let doubled = list.range(5).map(fn(n: Int): n * 2).map(fn(n: Int): "${n}")

    console.print(doubled.join(","))
