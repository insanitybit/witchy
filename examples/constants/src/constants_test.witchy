// In-rune tests for `constants`. Each `test_*` function takes no parameters, passes
// by returning, and fails by aborting. Run them with `witchy test examples/constants`.

import constants
import testing

fn test_to_seconds():
    testing.assert_int_eq(constants.to_seconds(0, 1, 0, 0), 3600)
    testing.assert_int_eq(constants.to_seconds(1, 0, 0, 0), 86400)
    testing.assert_int_eq(constants.to_seconds(1, 2, 3, 4), 93784)

fn test_zero():
    testing.assert_int_eq(constants.to_seconds(0, 0, 0, 0), 0)
