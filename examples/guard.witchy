// `return` exits a function early — handy for guard clauses and for bailing out
// of a loop once you've found an answer.
fn classify(n: Int) -> String:
    if n < 0:
        return "negative"
    if n == 0:
        return "zero"
    "positive"

fn first_even(xs: List(Int)) -> Int:
    for x in xs:
        if x % 2 == 0:
            return x
    0 - 1

fn main(console: Console):
    print(console, classify(-4))
    print(console, classify(0))
    print(console, classify(9))
    print(console, "${first_even([1, 3, 8, 5])}")
    print(console, "${first_even([1, 3, 5])}")
