// A capability-secure, MULTI-CORE web server. The ordinary
// `fn(Request) -> Response` handlers are closed over request data and receive no
// Net/Dir/Console, so they cannot touch the network, filesystem, or console as
// written. Only `main` holds the `Net`, and it hands it to `serve` to listen —
// never to a handler. Use `pure fn` when an API needs a checked effect-free
// callable contract rather than this example's empty handler footprint.
//
// `server.serve` uses ALL cores for free: it runs a prefork pool of worker VMs that
// share the listener, and the kernel load-balances connections across them. You write
// the handlers; the parallelism is automatic. (Use `server.serve_one` for one core.)
// Run: witchy --net 127.0.0.1:8080 examples/serve_hello/src/serve_hello.witchy

from http import Request, Response
from server import Router

fn home(req: Request) -> Response:
    server.text(200, "hello, witchy")

fn show_user(req: Request) -> Response:
    server.text(200, "user " + server.param_or(req, "id", ""))

fn main(console: Console, net: Net):
    let app = server.router()
        .get("/", home)
        .get("/users/:id", show_user)
        .post("/echo", fn(req: Request): server.text(200, server.request_body(req)))
    console.print("serving on 127.0.0.1:8080")
    server.serve(net, "127.0.0.1:8080", app)
