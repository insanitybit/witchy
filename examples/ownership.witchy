// `own` transfers ownership (spelled `sink` in Hylo). `into_label` consumes its
// argument, so after `into_label(name)` the caller may not use `name` again — the
// type checker rejects use-after-move. (A `var` could be reassigned to
// re-initialize it.) See examples/conventions.witchy for the full set.
fn into_label(own name: String) -> String:
    "[" <> name <> "]"

fn main(console: Console):
    let name = "witchy"
    print(console, into_label(name))
