// Roman numerals, both directions. `to_roman` is the classic greedy algorithm:
// walk a value/symbol table (largest first) by subscript, emitting each symbol
// while it still fits. `from_roman` scans characters and applies the subtractive
// rule (a smaller value before a larger one is subtracted). Pure (only `main`
// touches the Console), so it runs identically interpreted, compiled, and inside
// the capability sandbox:
//   witchy examples/roman.witchy
//   witchy parity examples/roman.witchy
//   witchy sandbox examples/roman.witchy

import string

fn to_roman(n: Int) -> String:
    let values = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
    let symbols = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
    var remaining = n
    var result = ""
    var i = 0
    while i < list.length(values):
        while remaining >= values[i]:
            result = result <> symbols[i]
            remaining = remaining - values[i]
        i = i + 1
    result

fn char_value(c: String) -> Int:
    match c:
        "I" -> 1
        "V" -> 5
        "X" -> 10
        "L" -> 50
        "C" -> 100
        "D" -> 500
        "M" -> 1000
        _ -> 0

fn from_roman(s: String) -> Int:
    var total = 0
    var i = 0
    while i < string.length(s):
        let cur = char_value(string.char_at(s, i))
        // A value smaller than the one after it is subtracted (IV = 4, IX = 9).
        if i + 1 < string.length(s) && cur < char_value(string.char_at(s, i + 1)):
            total = total - cur
        else:
            total = total + cur
        i = i + 1
    total

fn main(console: Console):
    for n in [4, 9, 49, 90, 1994, 2024]:
        let r = to_roman(n)
        print(console, to_string(n) <> " = " <> r <> " -> " <> to_string(from_roman(r)))
