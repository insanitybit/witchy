// Uses the bundled standard library. `import list` brings in pure combinators;
// because that module was never handed a capability, it cannot perform effects —
// only `main` (which holds the Console) decides what to print.

import list

fn main(console: Console):
    let ns = list.range(5)
    let squares = list.map(ns, fn(n: Int): n * n)
    let total = list.fold(squares, 0, fn(acc: Int, n: Int): acc + n)
    print(console, "${total}")

    let odds = list.filter(ns, fn(n: Int): n % 2 == 1)
    let rev = list.reverse(odds)
    print(console, "${list.at(rev, 0)}")
