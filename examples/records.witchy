// Records are product types with named fields. They're constructed positionally
// (`Point(2, 3)`) and read by name (`p.x`). Like every value in witchy they are
// plain capability-free data.
type Point:
    x: Int
    y: Int

fn manhattan(p: Point) -> Int:
    p.x + p.y

fn shift(p: Point, dx: Int) -> Point:
    Point(p.x + dx, p.y)

fn main(console: Console):
    let origin = Point(2, 3)
    let moved = shift(origin, 10)
    print(console, "origin.x = " <> to_string(origin.x))
    print(console, "moved = (${moved.x}, ${moved.y})")
    print(console, "manhattan(moved) = " <> to_string(manhattan(moved)))
