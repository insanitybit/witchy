// Compiled to WebAssembly and run on the witchy runtime. main's Int result is
// printed through the `print_int` capability, which the runtime links as a host
// function ONLY when granted. Without the grant, the compiled module cannot even
// instantiate — capability security enforced by the WASM sandbox itself.

fn double(n: Int) -> Int:
    n * 2

fn fib(n: Int) -> Int:
    if n < 2:
        n
    else:
        fib(n - 1) + fib(n - 2)

fn fact(n: Int) -> Int:
    match n:
        0 -> 1
        _ -> n * fact(n - 1)

fn main(console: Console):
    let a = double(21)
    let b = fib(10)
    let c = fact(5)
    print(console, int_to_string(a + b + c))
