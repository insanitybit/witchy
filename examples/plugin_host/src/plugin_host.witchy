// The capability thesis, made concrete. A compute-only plugin has the checked
// type `pure fn(Int) -> Int`. The contract rejects capability operations,
// authority-bearing captures, and opaque ordinary callback invocation. The host
// owns the root authority and decides which narrower operations it delegates.
//
//   witchy examples/plugin_host/src/plugin_host.witchy
//   witchy parity examples/plugin_host/src/plugin_host.witchy     # backends agree
//   witchy sandbox examples/plugin_host/src/plugin_host.witchy    # granted exactly: Console

// --- untrusted plugins: pure, authority-free transforms ---
pure fn double(x: Int) -> Int:
    x * 2

pure fn bonus(x: Int) -> Int:
    x + 10

// The host runs a pipeline of checked `pure fn(Int) -> Int` plugins. An ordinary
// callback would be delegated behavior and is deliberately not accepted here.
pure fn run_pipeline(plugins: List(pure fn(Int) -> Int), x: Int) -> Int:
    var acc = x
    for p in plugins:
        acc = p(acc)
    acc

fn main(console: Console):
    let plugins = [double, bonus]
    for n in [1, 5, 10]:
        console.print("${n}" + " -> " + "${run_pipeline(plugins, n)}")
    // Granting authority is by capture: this logger closes over `console`, so the
    // host can hand out that narrower logging power without surrendering the
    // Console itself. Receiving the ordinary callback is explicit delegation,
    // not a purity promise.
    let log = fn(msg: String): console.print("[log] " + msg)
    log("ran the pipeline")
