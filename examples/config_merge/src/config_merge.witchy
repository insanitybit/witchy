// Layered configuration the witchy way: a base config patched by an environment
// overlay, then rendered for humans. Shows `json.merge` (a shallow per-key
// override) and `json.encode_pretty` from the std `json` module. The builders
// only construct data as written; `main` owns the Console effect. Both backends
// produce the same result.
// Run: witchy examples/config_merge/src/config_merge.witchy

import reflect
from json import Json

fn base() -> Json:
    Json.from(.{host: "localhost", port: 8080, debug: true})

fn production() -> Json:
    Json.from(.{host: "example.com", port: 443, workers: 8})

fn main(console: Console):
    // `production` wins on the keys it sets (host, port) and adds `workers`;
    // `base`'s own `debug` is preserved because the overlay doesn't mention it.
    let merged = json.merge(base(), production())
    console.print(json.encode_pretty(merged))
    console.print(if json.contains_key(merged, "workers"): "has workers" else: "no workers")
