// The standard `list` library now compiles to WebAssembly, not just the
// interpreter: map / filter / fold and a comparator-driven sort all run in the
// compiled backend. The library is pure — `import list` hands it no Console,
// Dir, or Net, so it can only transform data — and the closures you pass to it
// cross the compiled boundary as heap `[code_index][captures...]` records.

import list

fn main(console: Console):
    let xs = [5, 3, 8, 1, 9, 2, 7]

    // map then fold: sum of squares = 25+9+64+1+81+4+49 = 233.
    let squares = list.map(xs, fn(n: Int): n * n)
    print(console, to_string(list.fold(squares, 0, fn(acc: Int, n: Int): acc + n)))

    // filter the evens, then sort ascending with a comparator closure: [2, 8].
    let evens = list.filter(xs, fn(n: Int): n % 2 == 0)
    let sorted = list.sort_by(evens, fn(a: Int, b: Int): a < b)
    print(console, to_string(list.at(sorted, 0)) <> " " <> to_string(list.at(sorted, 1)))

    // A *capturing* closure handed to a library function: `bonus` is closed over
    // and added on every step. sum(xs)=35, plus 7*100 = 735.
    let bonus = 100
    print(console, to_string(list.fold(xs, 0, fn(acc: Int, n: Int): acc + n + bonus)))
