// The standard `Eq` trait gives content-correct equality that holds up in
// compiled code, not just the interpreter. `member` and `index_of` search a
// list by the element type's Eq impl, so they find runtime-built strings and
// your own types — where a generic `==` search would fall back to comparing
// pointers. Built-in impls cover Int, Bool, and String; derive your own by
// implementing `eq`.

import eq

type Color:
    Red
    Green
    Blue

impl Eq for Color:
    fn eq(self, other: Self) -> Bool:
        match self:
            Red -> match other { Red -> true  _ -> false }
            Green -> match other { Green -> true  _ -> false }
            Blue -> match other { Blue -> true  _ -> false }

fn main(console: Console):
    let palette = [Red, Green, Blue]
    print(console, to_string(eq.member(palette, Green)))
    print(console, int_to_string(eq.index_of(palette, Blue)))
    print(console, to_string(eq.member([1, 2, 3], 4)))
    print(console, to_string(ne(Red, Blue)))
