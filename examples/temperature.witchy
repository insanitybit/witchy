// A Fahrenheit-to-Celsius conversion table — the first real program in K&R's
// *The C Programming Language* and a staple of the Go tour, reproduced in
// witchy. It needs real float output: `math.format_float` formats a Float on
// both the interpreter and the compiled WASM backend, where the `to_string`
// builtin can't (no float formatting in codegen yet).

import math

fn to_celsius(f: Float) -> Float:
    (f - 32.0) * 5.0 / 9.0

fn main(console: Console):
    var f = 0
    while f <= 300:
        let c = to_celsius(math.to_float(f))
        print(console, to_string(f) <> "F = " <> math.format_float(c, 1) <> "C")
        f = f + 60
