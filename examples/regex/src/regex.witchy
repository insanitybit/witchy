// regex — a tiny regular-expression matcher in the style of Kernighan & Pike.
// It supports literal characters, `.` (any one character), `*` (zero or more of
// the preceding character), and the `^` / `$` anchors. The match is recursive:
// `match_here` consumes the pattern and text together; `match_star` handles the
// zero-or-more repetition. Every comparison is between two `list.at(..)` characters,
// so it's a thorough both-backends exercise of content comparison. Pure (Console
// only); identical interpreted and compiled. Run:  witchy examples/regex.witchy

import string

fn main(console: Console):
    for probe in cases():
        let (pattern, text) = probe
        let shown = string.pad_right("/" + pattern + "/", 10, " ") + string.pad_right("\"" + text + "\"", 16, " ")
        console.print(shown + verdict(matches(pattern, text)))

fn cases() -> List((String, String)):
    [("abc", "abc"), ("a.c", "axc"), ("a.c", "ac"), ("a*b", "aaab"), ("a*b", "b"), ("^hello", "hello world"), ("world\$", "hello world"), ("^a.*z\$", "abcz"), ("^a.*z\$", "abc")]

pub fn matches(pattern: String, text: String) -> Bool:
    let re = pattern.chars()
    let s = text.chars()
    if re.length() > 0 && re.at(0) == "^":
        match_here(re, 1, s, 0)
    else:
        match_anywhere(re, s)

// The unanchored case: try to match starting at each position in the text.
fn match_anywhere(re: List(String), s: List(String)) -> Bool:
    var start = 0
    var found = match_here(re, 0, s, 0)
    while !found && start < s.length():
        start = start + 1
        if match_here(re, 0, s, start):
            found = true
    found

// Does the pattern from `ri` match the text from `si`?
fn match_here(re: List(String), ri: Int, s: List(String), si: Int) -> Bool:
    if ri >= re.length():
        true
    else if ri + 1 < re.length() && re.at(ri + 1) == "*":
        match_star(re.at(ri), re, ri + 2, s, si)
    else if re.at(ri) == "\$" && ri + 1 == re.length():
        si >= s.length()
    else if si < s.length() && (re.at(ri) == "." || re.at(ri) == s.at(si)):
        match_here(re, ri + 1, s, si + 1)
    else:
        false

// Match zero or more of `c`, then the rest of the pattern — fewest reps first.
fn match_star(c: String, re: List(String), ri: Int, s: List(String), si: Int) -> Bool:
    var i = si
    var done = match_here(re, ri, s, i)
    while !done && i < s.length() && (c == "." || s.at(i) == c):
        i = i + 1
        if match_here(re, ri, s, i):
            done = true
    done

fn verdict(matched: Bool) -> String:
    if matched:
        "match"
    else:
        "no match"
