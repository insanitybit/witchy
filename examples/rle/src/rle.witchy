// rle — run-length encoding and its inverse. A maximal run of one character is
// written as its length followed by the character ("aaab" -> "3a1b"); decoding
// reverses that. We verify the pair forms a true round-trip: decode(encode(s))
// == s for every sample. Data-only string processing (to_chars, char compare, repeat)
// over Console only, so it runs identically on both backends. Run:
//   witchy examples/rle/src/rle.witchy

import ascii

fn main(console: Console):
    for sample in ["aaabbbbc", "wwwwww", "abcdef", "mississippi", ""]:
        let encoded = encode(sample)
        let restored = decode(encoded)
        console.print(render(sample) + " -> " + render(encoded) + "  roundtrip " + yes_no(restored == sample))

// Collapse each maximal run into "<count><char>".
pub fn encode(text: String) -> String:
    let chars = text.chars()
    let n = chars.length()
    var out = ""
    var i = 0
    while i < n:
        let run_char = chars.at(i)
        var count = 0
        while i < n && chars.at(i) == run_char:
            count = count + 1
            i = i + 1
        out = out + "${count}" + run_char
    out

// Expand each "<count><char>" run back to the original characters.
pub fn decode(encoded: String) -> String:
    let chars = encoded.chars()
    let n = chars.length()
    var out = ""
    var i = 0
    while i < n:
        var count = 0
        while i < n && ascii.is_digit(chars.at(i)):
            count = count * 10 + (ascii.to_digit(chars.at(i)) ?? 0)
            i = i + 1
        if i < n:
            out = out + chars.at(i).repeat(count)
            i = i + 1
    out

fn render(s: String) -> String:
    "\"" + s + "\""

fn yes_no(ok: Bool) -> String:
    if ok:
        "ok"
    else:
        "FAILED"
