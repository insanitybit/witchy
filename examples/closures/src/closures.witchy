// Higher-order functions and closures compile to WebAssembly. A function value
// is a heap record `[code_index][captured...]`: a lambda is lifted to its own
// function (whose hidden first parameter is that record), captured variables are
// copied into the record at creation, and a call through a `fn(...)` value
// lowers to `call_indirect` on the code index. So closures — including ones that
// capture their environment — cross the compiled boundary now.
pub fn apply(f: fn(Int) -> Int, x: Int) -> Int:
    f(x)

// `twice` threads a function value through a second higher-order call: the
// `f` parameter (a closure record) is passed straight on to `apply`.
pub fn twice(f: fn(Int) -> Int, x: Int) -> Int:
    apply(f, apply(f, x))

// A *capturing* closure: `adder(by)` returns a function that adds `by`. The
// value of `by` is copied into the returned closure's heap environment at
// creation and read back when the closure later runs.
pub fn adder(by: Int) -> fn(Int) -> Int:
    fn(n: Int): n + by

fn main(console: Console):
    // A non-capturing lambda, lifted and invoked via call_indirect.
    print(console, "${apply(fn(n: Int): n * n, 9)}")
    // The same machinery through two layers of higher-order calls.
    print(console, "${twice(fn(n: Int): n + 3, 10)}")
    // A closure returned from a function, carrying its captured `by = 100`.
    print(console, "${apply(adder(100), 5)}")
