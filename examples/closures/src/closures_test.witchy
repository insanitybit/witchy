// In-rune tests for `closures`. Each `test_*` function takes no parameters, passes
// by returning, and fails by aborting. Run them with `witchy test examples/closures`.

import closures
import testing

fn test_apply():
    testing.assert_int_eq(closures.apply(fn(n: Int): n * n, 9), 81)
    testing.assert_int_eq(closures.apply(fn(n: Int): n + 3, 10), 13)

fn test_twice():
    testing.assert_int_eq(closures.twice(fn(n: Int): n + 3, 10), 16)
    testing.assert_int_eq(closures.twice(fn(n: Int): n * 2, 5), 20)

fn test_adder():
    testing.assert_int_eq(closures.apply(closures.adder(100), 5), 105)
    testing.assert_int_eq(closures.apply(closures.adder(0), 7), 7)
