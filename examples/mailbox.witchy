// Two actors, one message hop: the Forwarder holds only a Subject for the
// Printer — its entire authority is "relay to that one actor". A library of
// actors with no `main`; see actors.witchy or dispatch.witchy for a
// self-driving program.
actor Printer:
    console: Console

impl Printer:
    on Show(n: Int):
        print(console, "printer got " + "${n}")

actor Forwarder:
    target: Subject

impl Forwarder:
    on Relay(n: Int):
        send(target, Show(n))
