// A filesystem capability at the actor level (cap-std style). `main` is the root
// actor: the host grants it the root Dir. It attenuates that to examples/data and
// hands the narrower Dir to a Reader actor, which reads a file using *its* granted
// capability — and cannot reach anything outside the directory it was given.

actor Reader:
    console: Console
    dir: Dir

impl Reader:
    on Read(name: String):
        print(console, read(dir, name))

fn main(console: Console, root: Dir):
    let examples = subdir(root, "examples")
    let data = subdir(examples, "data")
    let reader = spawn Reader(console, data)
    send(reader, Read("greeting.txt"))
