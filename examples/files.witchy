actor Reader:
    console: Console
    dir: Dir

impl Reader:
    on Read(name: String):
        print(console, read(dir, name))

fn main(console: Console, root: Dir):
    let examples = subdir(root, "examples")
    let data = subdir(examples, "data")
    let reader = spawn Reader(console, data)
    send(reader, Read("greeting.txt"))
