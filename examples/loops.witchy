// `for x in list` binds each element of a list in turn. Combined with a mutable
// `var`, it accumulates: here it sums a list of ints and joins a list of words.
fn main(console: Console):
    let nums = [4, 8, 15, 16, 23, 42]
    var sum = 0
    for n in nums:
        sum = sum + n
    print(console, "sum = " + "${sum}")

    var line = ""
    for word in ["witchy", "loops", "work"]:
        line = line + word + " "
    print(console, string.trim(line))
