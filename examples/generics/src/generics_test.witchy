// In-rune tests for `generics`. Each `test_*` function takes no parameters,
// passes by returning, and fails by aborting (the `testing` assertions do that
// with a message). Run them with `witchy test examples/generics`.

import generics
import testing

fn test_swap_int_string():
    let (s, n) = generics.swap((42, "answer"))
    testing.assert_eq(s, "answer")
    testing.assert_int_eq(n, 42)

fn test_swap_is_an_involution():
    let (a, b) = generics.swap(generics.swap(("x", 7)))
    testing.assert_eq(a, "x")
    testing.assert_int_eq(b, 7)
