// In-rune tests for `guard`. Each `test_*` function takes no parameters, passes
// by returning, and fails by aborting (the `testing` assertions do that with a
// message). Run them with `witchy test examples/guard`.

import guard
import testing

fn test_classify():
    testing.assert_eq(guard.classify(-4), "negative")
    testing.assert_eq(guard.classify(0), "zero")
    testing.assert_eq(guard.classify(9), "positive")

fn test_first_even():
    testing.assert_int_eq(guard.first_even([1, 3, 8, 5]), 8)
    testing.assert_int_eq(guard.first_even([2, 4, 6]), 2)
    testing.assert_int_eq(guard.first_even([1, 3, 5]), 0 - 1)
