// brainfuck — a complete interpreter for the eight-instruction language. The
// tape is a contiguous Bytes buffer with a moving data pointer; `[` / `]` are
// matched by scanning with a depth counter (no precomputed jump table). Output
// builds directly into a Bytes buffer. Data-only apart from `main` (root footprint: `Console`);
// identical on both backends. Run:
//   witchy examples/brainfuck/src/brainfuck.witchy

import bytes

fn main(console: Console):
    // The canonical "Hello World!" program.
    console.print(run("++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++."))
    // 8 * 8 = 64, then +1 = 65 = 'A'.
    console.print(run("++++++++[>++++++++<-]>+."))

pub fn run(program: String) -> String:
    let code = bytes.from_string(program)
    let n = bytes.length(code)
    var tape = bytes.repeat(0, 256)
    var ptr = 0
    var pc = 0
    var out_buf = bytes.with_capacity(32)
    while pc < n:
        let op = bytes.at(code, pc)
        if op == 62:
            ptr = ptr + 1
        else if op == 60:
            ptr = ptr - 1
        else if op == 43:
            bytes.set_at(tape, ptr, (bytes.at(tape, ptr) + 1) % 256)
        else if op == 45:
            bytes.set_at(tape, ptr, (bytes.at(tape, ptr) - 1 + 256) % 256)
        else if op == 46:
            let val = bytes.at(tape, ptr)
            if val >= 32 && val <= 126:
                bytes.push(out_buf, val)
        else if op == 91:
            if bytes.at(tape, ptr) == 0:
                pc = match_forward(code, pc)
        else if op == 93:
            if bytes.at(tape, ptr) != 0:
                pc = match_back(code, pc)
        pc = pc + 1
    bytes.to_string(out_buf)

// Index of the `]` matching the `[` at `pos` (depth-balanced forward scan).
fn match_forward(code: Bytes, pos: Int) -> Int:
    let n = bytes.length(code)
    var depth = 0
    var k = pos
    var result = pos
    var done = false
    while k < n && !done:
        let c = bytes.at(code, k)
        if c == 91:
            depth = depth + 1
        else if c == 93:
            depth = depth - 1
            if depth == 0:
                result = k
                done = true
        k = k + 1
    result

// Index of the `[` matching the `]` at `pos` (depth-balanced backward scan).
fn match_back(code: Bytes, pos: Int) -> Int:
    var depth = 0
    var k = pos
    var result = pos
    var done = false
    while k >= 0 && !done:
        let c = bytes.at(code, k)
        if c == 93:
            depth = depth + 1
        else if c == 91:
            depth = depth - 1
            if depth == 0:
                result = k
                done = true
        k = k - 1
    result
