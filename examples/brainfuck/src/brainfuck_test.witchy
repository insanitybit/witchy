// In-rune tests for `brainfuck`. Each `test_*` function takes no parameters,
// passes by returning, and fails by aborting. Run them with
// `witchy test examples/brainfuck`.

import brainfuck
import testing

fn test_hello_world():
    testing.assert_eq(brainfuck.run("++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++."), "Hello World!")

fn test_letter_a():
    // 8 * 8 = 64, then +1 = 65 = 'A'.
    testing.assert_eq(brainfuck.run("++++++++[>++++++++<-]>+."), "A")

fn test_empty_program():
    testing.assert_eq(brainfuck.run(""), "")
