// Result is an ordinary generic type — not built into the language. Its type
// parameters are inferred from the lowercase names in the constructors (`a` is
// the value, `e` the error), and the checker tracks them per use, so `Ok(1)`
// and `Ok("x")` have different `Result` types. Write `Result(Int, String)` to
// pin them.
type Result:
    Ok(a)
    Err(e)

fn safe_div(a: Int, b: Int) -> Result(Int, String):
    match b:
        0 -> Err("divide by zero")
        _ -> Ok(a / b)

fn show(r: Result(Int, String)) -> String:
    match r:
        Ok(n) -> "ok " + "${n}"
        Err(msg) -> "err " + msg

fn main(console: Console):
    print(console, show(safe_div(10, 2)))
    print(console, show(safe_div(10, 0)))
