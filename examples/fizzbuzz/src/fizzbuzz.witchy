// FizzBuzz, showcasing the new iteration and arithmetic: a `while` loop with a
// mutable counter, `%` (modulo), and `if`/`else if`. The Console is threaded in
// from main (the root actor) — fizzbuzz can only print because it was handed it.
fn fizzbuzz(console: Console, n: Int):
    var i = 1
    while i <= n:
        if i % 15 == 0:
            console.print("FizzBuzz")
        else if i % 3 == 0:
            console.print("Fizz")
        else if i % 5 == 0:
            console.print("Buzz")
        else:
            console.print("${i}")
        i = i + 1

fn main(console: Console):
    fizzbuzz(console, 15)
