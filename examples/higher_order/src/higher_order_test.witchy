// In-rune tests for `higher_order`. Each `test_*` function takes no parameters,
// passes by returning, and fails by aborting (the `testing` assertions do that
// with a message). Run them with `witchy test examples/higher_order`.

import higher_order
import testing

fn test_apply():
    testing.assert_int_eq(higher_order.apply(fn(x: Int): x * x, 9), 81)

fn test_make_adder():
    let add10 = higher_order.make_adder(10)
    testing.assert_int_eq(higher_order.apply(add10, 5), 15)

fn test_reduce():
    let nums = [1, 2, 3, 4, 5]
    testing.assert_int_eq(higher_order.reduce(nums, fn(a: Int, b: Int): a + b, 0), 15)
    testing.assert_int_eq(higher_order.reduce(nums, fn(a: Int, b: Int): a * b, 1), 120)
