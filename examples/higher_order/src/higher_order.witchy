// First-class functions. A function can be passed as an argument, returned from
// another function (capturing variables — a closure), and applied. `reduce`
// folds a list with a caller-supplied function.
pub fn apply(f: fn(Int) -> Int, x: Int) -> Int:
    f(x)

pub fn make_adder(n: Int) -> fn(Int) -> Int:
    fn(x: Int): x + n

pub fn reduce(xs: List(Int), f: fn(Int, Int) -> Int, init: Int) -> Int:
    var acc = init
    for x in xs:
        acc = f(acc, x)
    acc

fn main(console: Console):
    let add10 = make_adder(10)
    console.print("${apply(add10, 5)}")
    console.print("${apply(fn(x: Int): x * x, 9)}")

    let nums = [1, 2, 3, 4, 5]
    console.print("${reduce(nums, fn(a: Int, b: Int): a + b, 0)}")
    console.print("${reduce(nums, fn(a: Int, b: Int): a * b, 1)}")
