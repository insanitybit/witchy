#!/usr/bin/env bash
# Repo-local `cargo` that routes build subcommands through the mbx build cache.
#
# Why a shim and not the global rustc-wrapper: mbx needs to wrap the *cargo*
# invocation (it starts a per-command cache agent and sets its own
# RUSTC_WRAPPER for the cargo it launches), so `env -u RUSTC_WRAPPER` in the
# repo's scripts is a no-op under it and the global sccache config is never
# consulted. Scoping the shim to this repo is what `mbx setup` would do
# machine-wide; we do not run that on a shared machine.
#
# Policy (each rule was measured; see scratch/build-cache-eval-2026-09-17.md):
#   - Only build-shaped subcommands go through mbx. Everything else, and any
#     `cargo +toolchain` invocation, goes straight to the real cargo.
#   - The serialized merge gate uses mbx for dependency artifact restore, but
#     keeps Cargo incremental for workspace crates and disables mbx's agent
#     permit pool. A reclaimed target can therefore restore expensive stable
#     dependencies such as Wasmtime and AWS-LC without reducing the gate's own
#     build parallelism or changing its incremental workspace profile.
#   - Queue-tooling tests use mbx too. Since scheduler.tests is enabled, their
#     process-heavy daemon fixtures hold global permits instead of several
#     agents running six fixtures each and turning timing assertions flaky.
#     mbx schedules the command, not nextest's internal worker fanout, so the
#     shim also defaults non-gate nextest and Rust test harnesses to two
#     workers. Focused agent-check runs use normal priority, so they retain a
#     permit ahead of ordinary low-priority background work.
#   - WITCHY_BUILD_CACHE=off is the kill switch. MBX_DISABLE=1 (mbx's own)
#     also works.
#   - The store lives in the repo (state/mbx/store-<version>): an agent
#     sandbox that denies writes to ~/Library/Caches makes mbx silently run
#     uncached, while an in-repo store hits normally.
#   - Cargo 1.100 + mbx-managed default targets replace Witchy's cross-worktree
#     build seed. Registry/Git units copy directly from another checkout and
#     path crates restore through the action cache; edited crates then enter
#     learned incremental mode. Explicit target directories remain private and
#     use the action cache rather than copying checkout-bound Cargo units.
#   - Cold targets cache and share workspace crates like dependencies, and mbx
#     LEARNS which crate you are editing (MBX_LEARNED_INCREMENTAL): a crate
#     that keeps missing with changed content compiles incrementally from
#     then on. The old default (MBX_INCREMENTAL=1: every member incremental
#     and private to its worktree) shared only third-party crates, so in
#     2026-09-23's 3 hours mbx avoided 17.7 of 870 compiler-minutes while
#     witchy_wir/syntax/types/lower (8.6k/4.9k/4.9k/4.5k s) were rebuilt in
#     every worktree. Measured: an unchanged witchy-types in a second
#     worktree 70s -> 3s; editing one crate 54s the first time (no
#     incremental state yet, as before) and 2s per edit after.
#     WITCHY_MBX_MODE=incremental restores the old policy; restore makes
#     every crate a cache lookup and never incremental.
#
# Usage from a script: prepend "$repo/scripts/bin" to PATH, then call `cargo`
# as usual. Ad hoc: ./scripts/bin/cargo build ...
set -u

self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$self_dir/../.." && pwd)"
# The store and the installed binary live under the MAIN checkout's state/,
# not this worktree's: a linked worktree resolving `../..` from its own
# scripts/bin would get a private store and never share with its siblings.
# `--git-common-dir` is the main .git for every worktree.
state_root="$repo_root"
if common="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
    state_root="$(dirname "$common")"
fi

# Resolve the real cargo: first PATH entry that is not this shim's directory.
real_cargo=""
IFS=':' read -r -a path_entries <<< "${PATH:-}"
for dir in "${path_entries[@]}"; do
    [ -n "$dir" ] || continue
    case "$(cd "$dir" 2>/dev/null && pwd)" in "$self_dir") continue ;; esac
    if [ -x "$dir/cargo" ] && [ ! -d "$dir/cargo" ]; then
        real_cargo="$dir/cargo"
        break
    fi
done
[ -n "$real_cargo" ] || { echo "scripts/bin/cargo: no real cargo found on PATH" >&2; exit 127; }

# Keep every route through this shim compatible with the serialized gate's
# target artifacts. This host has a global Cargo rustc-wrapper (sccache), while
# the gate deliberately builds with no Rust wrapper. Cargo includes the wrapper
# in its unit fingerprints, so inheriting the global setting makes a warm seed
# look cold and recompiles dependencies as deep as aws-lc and wasmtime. mbx
# installs its own wrapper around the Cargo process when selected; clearing the
# ambient one here only removes the accidental second build identity.
unset RUSTC_WRAPPER
export CARGO_BUILD_RUSTC_WRAPPER=

# A cross build needs the target's standard library in the compiler's own
# sysroot; PATH cannot supply it. When the resolved cargo's toolchain lacks
# the requested target (Homebrew's rust ships none) but rustup's stable has
# it, build with rustup's toolchain instead, the way scripts/check.sh's wasm
# leg does. Native builds are untouched, so nothing here changes which
# compiler the gate and the build cache see for ordinary work.
cross_target=""
for arg in "$@"; do
    case "$arg" in
        --target=*) cross_target="${arg#--target=}" ;;
        wasm32-*|aarch64-*|x86_64-*) [ "$prev" = "--target" ] && cross_target="$arg" ;;
    esac
    prev="$arg"
done
if [ -n "$cross_target" ] && command -v rustup >/dev/null 2>&1; then
    have_sysroot="$("$(dirname "$real_cargo")/rustc" --print sysroot 2>/dev/null || true)"
    if [ -n "$have_sysroot" ] && [ ! -d "$have_sysroot/lib/rustlib/$cross_target" ]; then
        stable_rustc="$(rustup which --toolchain stable rustc 2>/dev/null || true)"
        if [ -n "$stable_rustc" ] && [ -d "$("$stable_rustc" --print sysroot)/lib/rustlib/$cross_target" ]; then
            tc_bin="$(dirname "$stable_rustc")"
            real_cargo="$tc_bin/cargo"
            export PATH="$tc_bin:$PATH"
            # Name the compiler absolutely: a rustc-wrapper (sccache) resolves
            # a bare `rustc` on its own PATH, not this one.
            export RUSTC="$stable_rustc"
            unset RUSTFLAGS
        fi
    fi
fi

# Frontend-only, lowerer-only, snapshot-tool-only, and structural-WIR selections
# must not inherit native oracle features from unselected workspace packages.
# That inheritance pulls Wasmtime and AWS-LC into otherwise pure builds.
# Native WIR/workspace selections keep the single workspace feature graph;
# these isolated graphs intentionally use their much smaller build identities.
isolated_graph_selected=0
native_owner_selected=0
non_wir_native_owner_selected=0
structural_wir_selected=0
no_default_features=0
package_arg=0
test_arg=0
for arg in "$@"; do
    if [ "$package_arg" -eq 1 ]; then
        case "$arg" in
            witchy-cap-model | witchy-syntax | witchy-canonical-source | \
            witchy-types | witchy-lower | witchy-snapshot-tools) isolated_graph_selected=1 ;;
            witchy) native_owner_selected=1; non_wir_native_owner_selected=1 ;;
            witchy-caps | witchy-interp | witchy-runtime) native_owner_selected=1; non_wir_native_owner_selected=1 ;;
            witchy-wir) native_owner_selected=1 ;;
        esac
        package_arg=0
        continue
    fi
    if [ "$test_arg" -eq 1 ]; then
        [ "$arg" != structural_contracts ] || structural_wir_selected=1
        test_arg=0
        continue
    fi
    case "$arg" in
        -p | --package) package_arg=1 ;;
        --package=witchy-cap-model | --package=witchy-syntax | \
        --package=witchy-canonical-source | --package=witchy-types | \
        --package=witchy-lower | --package=witchy-snapshot-tools) isolated_graph_selected=1 ;;
        --package=witchy) native_owner_selected=1; non_wir_native_owner_selected=1 ;;
        --package=witchy-caps | --package=witchy-interp | --package=witchy-runtime) native_owner_selected=1; non_wir_native_owner_selected=1 ;;
        --package=witchy-wir) native_owner_selected=1 ;;
        --workspace) native_owner_selected=1; non_wir_native_owner_selected=1 ;;
        --no-default-features) no_default_features=1 ;;
        --test) test_arg=1 ;;
        --test=structural_contracts) structural_wir_selected=1 ;;
    esac
done
# `--test structural_contracts` uniquely names witchy-wir's pure inspection
# target. It may omit `-p witchy-wir`, so target identity is the authority;
# only an accompanying root/workspace selection cancels the isolation.
if [ "$structural_wir_selected" -eq 1 ] && [ "$non_wir_native_owner_selected" -eq 0 ]; then
    isolated_graph_selected=1
    native_owner_selected=0
fi
# The serialized pure SafeWIR route explicitly names WIR test targets and
# disables default features. Workspace-wide feature unification would still
# import the root package's native WIR feature, defeating that boundary and
# compiling Wasmtime/AWS-LC. Explicit --features native continues to work: this
# only changes feature unification, never the caller's requested features.
if [ "$no_default_features" -eq 1 ] && [ "$native_owner_selected" -eq 1 ] \
    && [ "$non_wir_native_owner_selected" -eq 0 ]; then
    isolated_graph_selected=1
    native_owner_selected=0
fi
if [ -z "${WITCHY_FEATURE_UNIFICATION+x}" ] \
    && [ "$isolated_graph_selected" -eq 1 ] && [ "$native_owner_selected" -eq 0 ]; then
    export WITCHY_FEATURE_UNIFICATION=off
    unset CARGO_UNSTABLE_FEATURE_UNIFICATION CARGO_RESOLVER_FEATURE_UNIFICATION
fi

# One feature resolution for every other selection (see the sourced file).
# shellcheck source=../feature-unification.sh
. "$self_dir/../feature-unification.sh"

passthrough() { exec "$real_cargo" "$@"; }

# Agent builds yield the CPU to the serialized merge gate. Every landing waits
# on the gate's test build, which took 2m47s at load 12-20 against ~43s wall
# alone (2026-09-25): the gate competed as an equal with every agent's rustc
# and test processes. nice only matters under contention, so an idle machine
# still gives agents every core. The gate (WITCHY_GATE_SCOPE) is not niced;
# WITCHY_AGENT_NICE=off opts out, e.g. to time a build.
if [ -z "${WITCHY_GATE_SCOPE+x}" ] && [ -z "${WITCHY_CARGO_NICED+x}" ] \
    && [ "${WITCHY_AGENT_NICE:-10}" != "off" ] && command -v nice >/dev/null 2>&1; then
    export WITCHY_CARGO_NICED=1
    exec nice -n "${WITCHY_AGENT_NICE:-10}" "$self_dir/cargo" "$@"
fi

# Re-entry guard. mbx runs cargo itself; if that resolved back to this shim we
# would exec mbx again forever (mise strips its dispatch dir for the same
# reason). Two independent guards: a marker variable, and a PATH with this
# directory removed for everything the shim launches.
[ -z "${WITCHY_CARGO_SHIM_ACTIVE+x}" ] || passthrough "$@"
stripped_path=""
for dir in "${path_entries[@]}"; do
    [ -n "$dir" ] || continue
    case "$(cd "$dir" 2>/dev/null && pwd)" in "$self_dir") continue ;; esac
    stripped_path="${stripped_path:+$stripped_path:}$dir"
done
export PATH="$stripped_path"
export WITCHY_CARGO_SHIM_ACTIVE=1
export CARGO="$real_cargo"

# mbx's test scheduling admits the top-level command, but nextest owns its own
# worker pool after admission. On 2026-09-24 an mbx-routed focused run still
# launched ten CPU-heavy Witchy binaries and pushed a 10-core host above load
# 48 while compiler processes starved. Agent-check already uses two workers;
# apply the same default to every repo-shim invocation, including the plain
# Cargo fallback. The serialized gate stays deliberately full-width, and
# explicit caller choices always win.
if [ -z "${WITCHY_GATE_SCOPE+x}" ]; then
    case "${1:-}" in
        nextest) export NEXTEST_TEST_THREADS="${NEXTEST_TEST_THREADS:-2}" ;;
        test|t) export RUST_TEST_THREADS="${RUST_TEST_THREADS:-2}" ;;
    esac
fi

# The native workspace and isolated compiler selections resolve incompatible
# feature graphs for the same Witchy crates. Keeping both in one target makes
# Cargo rebuild the compiler stack whenever an edit loop alternates between a
# lower/WIR check and a native integration test. Give the isolated graph its
# own persistent target. Do this before the build-cache fallback so disabling
# mbx does not restore the feature-graph thrash.
if [ -n "${CARGO_TARGET_DIR:-}" ]; then
    case "$CARGO_TARGET_DIR" in
        /*) effective_target="$CARGO_TARGET_DIR" ;;
        *) effective_target="$PWD/$CARGO_TARGET_DIR" ;;
    esac
else
    effective_target="$repo_root/target"
fi
explicit_target_arg=0
for arg in "$@"; do
    case "$arg" in --target-dir | --target-dir=*) explicit_target_arg=1 ;; esac
done
pure_graph_target=0
if [ "$isolated_graph_selected" -eq 1 ] && [ "$explicit_target_arg" -eq 0 ] \
    && [ -z "${CARGO_BUILD_TARGET_DIR:-}" ]; then
    pure_graph_target=1
    case "$effective_target" in
        *-pure) ;;
        *)
            effective_target="${effective_target}-pure"
            export CARGO_TARGET_DIR="$effective_target"
            ;;
    esac
fi

[ "${WITCHY_BUILD_CACHE:-mbx}" != "off" ] || passthrough "$@"
[ "${MBX_DISABLE:-0}" != "1" ] || passthrough "$@"

# Run the mbx this checkout pins, not a machine-wide "current" one: every
# version installs side by side (scripts/mbx-install.sh), and the policy below
# is written for the version pinned next to it. state/mbx/bin/mbx remains the
# fallback for an install that has not happened yet; the guards below are
# harmless to an older binary and binding on a newer one.
mbx_pinned="$(sed -n 's/^MBX_VERSION="\([^"]*\)".*/\1/p' "$self_dir/../mbx-install.sh" 2>/dev/null | head -1)"
mbx="$state_root/state/mbx/$mbx_pinned/mbx"
[ -n "$mbx_pinned" ] && [ -x "$mbx" ] || mbx="$state_root/state/mbx/bin/mbx"
[ -x "$mbx" ] || passthrough "$@"

# `cargo +toolchain ...` selects a toolchain; leave it to the real cargo.
case "${1:-}" in
    +*) passthrough "$@" ;;
esac

case "${1:-}" in
    build|b|check|c|test|t|nextest|clippy|bench|doc|d|run|r|rustc) ;;
    *) passthrough "$@" ;;
esac

mbx_version="$(basename "$(dirname "$(readlink "$mbx" 2>/dev/null || echo "$mbx")")")"
export MBX_CACHE_DIR="${MBX_CACHE_DIR:-$state_root/state/mbx/store-$mbx_version}"

# The serialized gate is outside the four-CPU agent pool. It still uses mbx as
# an artifact cache: dependencies are shareable while edited workspace crates
# retain the same incremental profile used by the gate target and its prewarm.
if [ -n "${WITCHY_GATE_SCOPE+x}" ]; then
    export WITCHY_MBX_MODE="${WITCHY_MBX_MODE:-incremental}"
    export MBX_SCHEDULER="${MBX_SCHEDULER:-false}"
    export MBX_SCHEDULER_PRIORITY="${MBX_SCHEDULER_PRIORITY:-normal}"
fi

# Ad-hoc and background agent builds yield one quarter of the shared compiler
# pool while a focused validation asks for normal priority. This prevents a
# short presubmit from sitting behind four multi-minute workspace compiles.
# Callers such as agent-check may explicitly promote themselves to normal.
export MBX_SCHEDULER_PRIORITY="${MBX_SCHEDULER_PRIORITY:-low}"

# The pure sidecar restores every crate into an empty target once, then uses
# mbx's learned/shareable mode; edited crates become incremental after a miss.
mbx_mode="${WITCHY_MBX_MODE:-}"
if [ -z "$mbx_mode" ]; then
    if [ "$pure_graph_target" = 1 ] \
        && [ ! -d "$effective_target/debug/.fingerprint" ]; then
        # Learned mode deliberately bypasses crates that agents edit often.
        # On a brand-new pure target that means every Witchy compiler crate,
        # even when an identical artifact is already shareable in MBX. Seed
        # the sidecar in restore mode once; later invocations see the target
        # and return to learned mode so active edits become incremental.
        mbx_mode="restore"
    else
        mbx_mode="learned"
    fi
fi

# One small versioned JSON report per build (mbx's MBX_STATS_REPORT), named
# so the summarizer can group by mode, subcommand, and worktree without the
# report itself carrying that context: <utc-time>-<pid>-<mode>-<subcommand>-<worktree>.json
# `scripts/mbx-report.py` reads them. Reports are ~2 KB each and live under
# the shared state/ with the store.
if [ -z "${MBX_STATS_REPORT+x}" ]; then
    reports_dir="$state_root/state/mbx/reports"
    mkdir -p "$reports_dir" 2>/dev/null || true
    worktree_tag="$(basename "$repo_root" | tr -c 'A-Za-z0-9._-\n' '_')"
    export MBX_STATS_REPORT="$reports_dir/$(date -u +%Y%m%dT%H%M%SZ)-$$-${mbx_mode}-${1}-${worktree_tag}.json"
fi

case "$mbx_mode" in
    restore) ;;
    incremental) export MBX_INCREMENTAL="${MBX_INCREMENTAL:-1}" ;;
    *)
        export MBX_INCREMENTAL="${MBX_INCREMENTAL:-0}"
        export MBX_LEARNED_INCREMENTAL="${MBX_LEARNED_INCREMENTAL:-1}"
        ;;
esac

# Do not wrap build scripts' C compiler. mbx's C cache hands every build
# script HOST_CC=<store>/shims/native/<hash>/mbx-c, and wasmtime's build
# script tracks HOST_CC: a target built through this shim and one built by
# plain cargo (CI or the cache kill switch) then rerun it, rebuilding wasmtime
# and everything above it, and every mbx upgrade changes the path and does the
# same. The C it would cache is a few files.
export MBX_CC="${MBX_CC:-off}"

# Cargo 1.100 lets mbx seed a fresh checkout with registry and Git dependency
# units from another managed target without invoking rustc or the shim once per
# unit. This is the default worktree path: mbx leaves `target` as a symlink, so
# Cargo-facing paths remain stable while deleted checkout storage is reclaimed.
# Explicit CARGO_TARGET_DIR/--target-dir builds (including both gate
# generations) are ineligible for managed placement and retain private targets
# warmed by the action cache.
export MBX_TARGET_VIEWS="${MBX_TARGET_VIEWS:-1}"
export MBX_TARGET_SEED="${MBX_TARGET_SEED:-1}"

# APFS reports CoW clones at their logical size. A logical-size budget can
# therefore evict cheap, useful donors long before they cost that much disk.
# Checkout deletion, per-unit aging, and the 30-day target age still collect
# managed storage; disable only the misleading aggregate size trigger.
export MBX_TARGET_MAX_SIZE="${MBX_TARGET_MAX_SIZE:-none}"

# Bound actions and learned/generated state independently. MBX's combined
# logical cap also budgets managed targets even with TARGET_MAX_SIZE=none:
# it can evict warm CoW targets and leave no allowance for action results.
# The merge coordinator instead guards physical free space (40 GiB low,
# 60 GiB target by default) and reclaims idle caches. Without a coordinator,
# standalone builds must monitor disk space or set an explicit total cap.
# Abandoned-checkout cleanup and age-based collection still apply.
export MBX_GC_MAX_SIZE="${MBX_GC_MAX_SIZE:-8GiB}"
export MBX_GC_INCREMENTAL_MAX_SIZE="${MBX_GC_INCREMENTAL_MAX_SIZE:-8GiB}"
export MBX_GC_MAX_TOTAL_SIZE="${MBX_GC_MAX_TOTAL_SIZE:-none}"

# Never run mbx's garbage collector inside a build. mbx's automatic sweep
# ("gc.auto": sweep after a build when collection is due) runs in the
# FOREGROUND after Cargo has exited, and a build that finds collection due
# also waits on another process's sweep. On this shared store that turned
# the end of a build into a 15-31 minute wait: on 2026-09-26 every merge-gate
# workspace nextest from 04:46Z on (green and red alike), and pool-05's
# `cargo check`, stayed alive 135-1900s after Cargo exited
# (state/mbx/reports: session_duration 30-170s, report written 900-1900s
# later). Two unrelated sessions finished at the same second, one printing
# `mbx[gc]`, and the last lag ended at gc/v1/last-sweep. The gate's step
# then hit MERGE_QUEUE_WORKSPACE_TEST_BUDGET (1800s) after 36s of tests.
# Evidence: state/agents/NOTE-2026-09-26-mbx-failfast-hang.md.
#
# Collection still happens, just never on a build's critical path: at most
# once per WITCHY_MBX_GC_INTERVAL seconds (default 3600) the shim starts
# `mbx gc` detached, in its own session, with stdio on /dev/null so it
# cannot hold a gate log or a caller's pipe open. mbx itself refuses a
# second concurrent collector. WITCHY_MBX_GC=off skips the background sweep
# too; MBX_GC_AUTO set by the caller still wins.
export MBX_GC_AUTO="${MBX_GC_AUTO:-false}"
if [ "${WITCHY_MBX_GC:-on}" != "off" ] && [ "$MBX_GC_AUTO" = "false" ]; then
    gc_stamp="$MBX_CACHE_DIR/.witchy-gc-launched"
    gc_interval="${WITCHY_MBX_GC_INTERVAL:-3600}"
    case "$gc_interval" in '' | *[!0-9]*) gc_interval=3600 ;; esac
    gc_now="$(date +%s)"
    gc_last="$(stat -f %m "$gc_stamp" 2>/dev/null || stat -c %Y "$gc_stamp" 2>/dev/null || echo 0)"
    if [ $((gc_now - gc_last)) -ge "$gc_interval" ] && mkdir -p "$MBX_CACHE_DIR" 2>/dev/null \
        && touch "$gc_stamp" 2>/dev/null; then
        if command -v setsid >/dev/null 2>&1; then
            nohup setsid nice -n 19 "$mbx" gc </dev/null >/dev/null 2>&1 &
        else
            nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or exit 127' \
                nice -n 19 "$mbx" gc </dev/null >/dev/null 2>&1 &
        fi
        disown 2>/dev/null || true
    fi
fi

# Keep mbx's interactive display out of agent logs; plain cargo output.
export CARGO_TERM_PROGRESS_WHEN="${CARGO_TERM_PROGRESS_WHEN:-never}"
export MBX_SAVINGS="${MBX_SAVINGS:-off}"

exec "$mbx" "$@"
