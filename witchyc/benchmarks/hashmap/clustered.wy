import console
import hashmap
import discard

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): HashMap<U64, U64> = HashMap.new(&allocator, 1021) else Err(code):
        return
    var map = move made
    for i in 0..512:
        let key = i * 1021
        match map.insert(key, i):
            Ok:
                continue
            Err(back):
                unreachable
    var hits: U64 = 0
    for i in 0..100000:
        let key = (i % 1024) * 1021
        if let Ok(hit) = map.get(&key):
            hits += 1
    console.print_int(hits)
    map.discard()
