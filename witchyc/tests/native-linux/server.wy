fn main(socket: Socket, file: File<Read>, input: Console<Read>, api: Net, exec: Exec, data: Dir<Write>):
    let c = socket.raw_recv_byte()
    let f = socket.raw_send_byte(U8.truncate(file.raw_read_byte()))
    let i = socket.raw_send_byte(U8.truncate(input.next_byte()))
    api.raw_addr_byte(U8.truncate(49))
    api.raw_addr_byte(U8.truncate(50))
    api.raw_addr_byte(U8.truncate(55))
    api.raw_addr_byte(U8.truncate(46))
    api.raw_addr_byte(U8.truncate(48))
    api.raw_addr_byte(U8.truncate(46))
    api.raw_addr_byte(U8.truncate(48))
    api.raw_addr_byte(U8.truncate(46))
    api.raw_addr_byte(U8.truncate(49))
    api.raw_addr_byte(U8.truncate(58))
    api.raw_addr_byte(U8.truncate(52))
    api.raw_addr_byte(U8.truncate(55))
    api.raw_addr_byte(U8.truncate(48))
    api.raw_addr_byte(U8.truncate(49))
    api.raw_addr_byte(U8.truncate(50))
    let peer = api.raw_connect()
    let asked = peer.raw_send_byte(U8.truncate(c))
    let n = socket.raw_send_byte(U8.truncate(peer.raw_recv_byte()))
    let gone = peer.raw_close()
    exec.raw_name_byte(U8.truncate(103))
    exec.raw_name_byte(U8.truncate(114))
    exec.raw_name_byte(U8.truncate(101))
    exec.raw_name_byte(U8.truncate(101))
    exec.raw_name_byte(U8.truncate(116))
    let run = exec.raw_run()
    if run.raw_status() == 0:
        let e = socket.raw_send_byte(U8.truncate(run.raw_out_byte()))
    data.raw_path_byte(U8.truncate(c))
    let one = socket.raw_send_byte(U8.truncate(48 + data.raw_make_dir()))
    data.raw_path_byte(U8.truncate(c))
    data.raw_path_byte(U8.truncate(50))
    let two = socket.raw_send_byte(U8.truncate(48 + data.raw_make_dir()))
    let done = socket.raw_close()
