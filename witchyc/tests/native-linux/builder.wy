fn main(out: Console<Write>, exec: Exec):
    // Input, an argument, a narrower deadline and output limit; standard output, error, code.
    exec.raw_name_byte(U8.truncate(97))
    exec.raw_name_byte(U8.truncate(110))
    exec.raw_name_byte(U8.truncate(115))
    exec.raw_name_byte(U8.truncate(119))
    exec.raw_name_byte(U8.truncate(101))
    exec.raw_name_byte(U8.truncate(114))
    exec.raw_arg_byte(U8.truncate(120))
    exec.raw_arg_end()
    exec.raw_input_byte(U8.truncate(105))
    exec.raw_input_byte(U8.truncate(110))
    exec.raw_deadline_ms(1500)
    exec.raw_output_limit(200)
    let run = exec.raw_run()
    var byte = run.raw_out_byte()
    while byte < 256:
        out.print_byte(U8.truncate(byte))
        byte = run.raw_out_byte()
    byte = run.raw_err_byte()
    while byte < 256:
        out.print_byte(U8.truncate(byte))
        byte = run.raw_err_byte()
    out.print_int(run.raw_code())
    // Wider than granted (7), no time (2), too little room (3), too little time (6).
    exec.raw_name_byte(U8.truncate(97))
    exec.raw_name_byte(U8.truncate(110))
    exec.raw_name_byte(U8.truncate(115))
    exec.raw_name_byte(U8.truncate(119))
    exec.raw_name_byte(U8.truncate(101))
    exec.raw_name_byte(U8.truncate(114))
    exec.raw_deadline_ms(2001)
    let r0 = exec.raw_run()
    out.print_int(r0.raw_status())
    exec.raw_name_byte(U8.truncate(97))
    exec.raw_name_byte(U8.truncate(110))
    exec.raw_name_byte(U8.truncate(115))
    exec.raw_name_byte(U8.truncate(119))
    exec.raw_name_byte(U8.truncate(101))
    exec.raw_name_byte(U8.truncate(114))
    exec.raw_output_limit(4097)
    let r1 = exec.raw_run()
    out.print_int(r1.raw_status())
    exec.raw_name_byte(U8.truncate(97))
    exec.raw_name_byte(U8.truncate(110))
    exec.raw_name_byte(U8.truncate(115))
    exec.raw_name_byte(U8.truncate(119))
    exec.raw_name_byte(U8.truncate(101))
    exec.raw_name_byte(U8.truncate(114))
    exec.raw_deadline_ms(0)
    let r2 = exec.raw_run()
    out.print_int(r2.raw_status())
    exec.raw_name_byte(U8.truncate(97))
    exec.raw_name_byte(U8.truncate(110))
    exec.raw_name_byte(U8.truncate(115))
    exec.raw_name_byte(U8.truncate(119))
    exec.raw_name_byte(U8.truncate(101))
    exec.raw_name_byte(U8.truncate(114))
    exec.raw_output_limit(5)
    let r3 = exec.raw_run()
    out.print_int(r3.raw_status())
    exec.raw_name_byte(U8.truncate(110))
    exec.raw_name_byte(U8.truncate(97))
    exec.raw_name_byte(U8.truncate(112))
    exec.raw_deadline_ms(200)
    let r4 = exec.raw_run()
    out.print_int(r4.raw_status())
