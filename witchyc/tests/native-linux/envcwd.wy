fn main(out: Console<Write>, exec: Exec, data: Dir<Read>):
    exec.raw_name_byte(U8.truncate(115))
    exec.raw_name_byte(U8.truncate(104))
    exec.raw_name_byte(U8.truncate(111))
    exec.raw_name_byte(U8.truncate(119))
    exec.raw_name_byte(U8.truncate(101))
    exec.raw_name_byte(U8.truncate(110))
    exec.raw_name_byte(U8.truncate(118))
    exec.raw_env_name_byte(U8.truncate(76))
    exec.raw_env_name_byte(U8.truncate(65))
    exec.raw_env_name_byte(U8.truncate(78))
    exec.raw_env_name_byte(U8.truncate(71))
    exec.raw_env_value_byte(U8.truncate(67))
    exec.raw_env_end()
    let r1 = exec.raw_run()
    var br1 = r1.raw_out_byte()
    while br1 < 256:
        out.print_byte(U8.truncate(br1))
        br1 = r1.raw_out_byte()
    exec.raw_name_byte(U8.truncate(115))
    exec.raw_name_byte(U8.truncate(104))
    exec.raw_name_byte(U8.truncate(111))
    exec.raw_name_byte(U8.truncate(119))
    exec.raw_name_byte(U8.truncate(101))
    exec.raw_name_byte(U8.truncate(110))
    exec.raw_name_byte(U8.truncate(118))
    exec.raw_env_name_byte(U8.truncate(72))
    exec.raw_env_name_byte(U8.truncate(79))
    exec.raw_env_name_byte(U8.truncate(77))
    exec.raw_env_name_byte(U8.truncate(69))
    exec.raw_env_value_byte(U8.truncate(120))
    exec.raw_env_end()
    let r2 = exec.raw_run()
    out.print_int(r2.raw_status())
    exec.raw_name_byte(U8.truncate(119))
    exec.raw_name_byte(U8.truncate(104))
    exec.raw_name_byte(U8.truncate(101))
    exec.raw_name_byte(U8.truncate(114))
    exec.raw_name_byte(U8.truncate(101))
    exec.raw_cwd(move data)
    let r3 = exec.raw_run()
    var br3 = r3.raw_out_byte()
    while br3 < 256:
        out.print_byte(U8.truncate(br3))
        br3 = r3.raw_out_byte()
