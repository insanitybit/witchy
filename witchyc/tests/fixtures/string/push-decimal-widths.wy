// Numbers of every width from 1 to 20 digits written into a String, the digits packed into
// words: the last of a word, the first of the next, and the largest U64.
import console
import string
import text

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): String = String.new(&allocator) else Err(e):
        return
    var out = move made
    let _ = out.push_u64(&allocator, 0)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 7)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 9)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 10)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 99)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 100)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 9999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 99999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 9999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 99999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 999999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 9999999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 99999999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 999999999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 9999999999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 99999999999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 999999999999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 9999999999999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 99999999999999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 999999999999999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 9999999999999999999)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 1000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 10000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 100000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 1000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 10000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 100000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 1000000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 10000000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 100000000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 1000000000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 10000000000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 100000000000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 1000000000000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 10000000000000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 100000000000000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 1000000000000000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 10000000000000000000)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 18446744073709551615)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 12345678901234567890)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 1234567)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 87654321)
    let _ = out.push_text(&allocator, " ")
    let _ = out.push_u64(&allocator, 123456789)
    let _ = out.push_text(&allocator, " ")
    let most: U64 = 18446744073709551615
    let none: U64 = 0
    let _ = out.push_format(&allocator, "${most} ${none}")
    console.write_string(&out)
    console.line("")
    out.close()
