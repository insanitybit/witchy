// Refused: the failure arm of a refutable `let` must leave.
import "../../../library/wasm-console.wy"
import "../../../library/wasm-vec.wy"

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(items): Vec<U64> = Vec.new(&allocator, 4) else Err(code):
        console.print_int(code)
    let Ok(more): Vec<U64> = Vec.new(&allocator, 2) else Err(code):
        items.close()
        return
    var list = move items
    list.push_mut(&allocator, 3)
    console.print_int(list.len())
    console.print_int(more.capacity())
    list.close()
    more.close()
