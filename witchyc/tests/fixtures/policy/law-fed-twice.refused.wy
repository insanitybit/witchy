// Refused: a field fed twice (written by hand).
import hash

type Pair:
    a: U64
    b: U64

impl Eq for Pair:
    fn eq(self: &Pair, other: &Pair) -> Bool:
        return (*self).a == (*other).a && (*self).b == (*other).b

impl HashKey for Pair:
    fn feed(self: &Pair, state: &mut HashState):
        (*self).a.feed(state)
        (*self).a.feed(state)

fn main():
    return
