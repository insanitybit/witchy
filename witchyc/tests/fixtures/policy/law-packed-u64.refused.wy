// Only U32 fields are packed into a word: a U64 field's high half would be cut off, so two keys
// differing there would feed alike only by luck of the shift (refused).
import console
import hash
import discard
import keymap

type Key derive(Discard):
    a: U32
    b: U32
    c: U64

impl Eq for Key:
    fn eq(self: &Key, other: &Key) -> Bool:
        return (*self).a == (*other).a && (*self).b == (*other).b && (*self).c == (*other).c

impl HashKey for Key:
    fn feed(self: &Key, state: &mut HashState):
        state.word(U32.to_u64((*self).a) | (U32.to_u64((*self).c) << 32), 8)
        (*self).b.feed(state)

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): KeyMap<Key, U64> = KeyMap.new(&allocator, 4, Fast(1)) else Err(code):
        return
    var map = move made
    console.print_int(map.len())
    map.discard()
