// Refused (adversarial review round 3): an Equivalent between two root types went unread; U8 feeds one byte and U64 eight, and the map missed the key.
import console
import hash
import hashmap
import keymap

impl Equivalent<U64> for U8:
    fn equivalent(self: &U8, key: &U64) -> Bool:
        return U8.to_u64(*self) == *key

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): KeyMap<U64, U64> = KeyMap.new(&allocator, 64, Reference(1)) else Err(code):
        return
    var map = move made
    match map.put(&allocator, 7, 70):
        Ok:
            ()
        Err(entry):
            entry.discard()
    let q: U8 = 7
    let k: U64 = 7
    console.print_int(hash_key(&q, Reference(1)))
    console.print_int(hash_key(&k, Reference(1)))
    if q.equivalent(&k):
        console.print_int(1)
    match map.get(&q):
        Ok(v):
            console.print_int(*v)
        Err(code):
            console.print_int(0)
    map.discard()
