// Refused (adversarial review round 4): a program trait named HashKey renamed the library's, and the key's real HashKey impl went unread.
import console
import hash
import hashmap
import keymap

trait HashKey:
    fn unrelated(self: &Self) -> U64

type Key derive(Discard):
    a: U64
    b: U64

impl Eq for Key:
    fn eq(self: &Key, other: &Key) -> Bool:
        return (*self).a == (*other).a

impl hash.HashKey for Key:
    fn feed(self: &Key, state: &mut HashState):
        (*self).a.feed(state)
        (*self).b.feed(state)

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): KeyMap<Key, U64> = KeyMap.new(&allocator, 64, Reference(1)) else Err(code):
        return
    var map = move made
    match map.put(&allocator, Key(a: 1, b: 2), 70):
        Ok:
            ()
        Err(entry):
            entry.discard()
    if Key(a: 1, b: 3) == Key(a: 1, b: 2):
        console.print_int(1)
    match map.get(&Key(a: 1, b: 2)):
        Ok(v):
            console.print_int(*v)
        Err(code):
            console.print_int(0)
    match map.get(&Key(a: 1, b: 3)):
        Ok(v):
            console.print_int(*v)
        Err(code):
            console.print_int(0)
    map.discard()
