// A query fed field by field for a key that packs two fields into one word: the same bytes,
// but not the same calls, and the law does not lean on how a policy splits its input (refused).
import console
import hash
import discard
import keymap

type Key derive(Discard):
    a: U32
    b: U32

impl Eq for Key:
    fn eq(self: &Key, other: &Key) -> Bool:
        return (*self).a == (*other).a && (*self).b == (*other).b

impl HashKey for Key:
    fn feed(self: &Key, state: &mut HashState):
        state.word(U32.to_u64((*self).a) | (U32.to_u64((*self).b) << 32), 8)

type Probe:
    x: U32
    y: U32

impl Equivalent<Key> for Probe:
    fn equivalent(self: &Probe, key: &Key) -> Bool:
        return (*self).x == (*key).a && (*self).y == (*key).b

impl HashKey for Probe:
    fn feed(self: &Probe, state: &mut HashState):
        (*self).x.feed(state)
        (*self).y.feed(state)

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): KeyMap<Key, U64> = KeyMap.new(&allocator, 4, Fast(1)) else Err(code):
        return
    var map = move made
    if map.contains(&Probe(x: U32.truncate(1), y: U32.truncate(2))):
        console.print_int(1)
    map.discard()
