// Refused (adversarial review round 2): a type parameter tested by eq but not bound by HashKey carried an unchecked, unlawful Eq.
import console
import hash
import hashmap
import keymap
import discard

type Bad derive(Discard):
    x: U64

impl Eq for Bad:
    fn eq(self: &Bad, other: &Bad) -> Bool:
        return false

type Wrap<T, U> derive(Discard):
    a: T
    b: U

impl<T: Any + HashKey, U: Any> HashKey for Wrap<T, U>:
    fn feed(self: &Wrap<T, U>, state: &mut HashState):
        (*self).a.feed(state)

impl<T: Any + Eq, U: Any + Eq> Eq for Wrap<T, U>:
    fn eq(self: &Wrap<T, U>, other: &Wrap<T, U>) -> Bool:
        return (*self).a == (*other).a && (*self).b == (*other).b

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): KeyMap<Wrap<U64, Bad>, U64> = KeyMap.new(&allocator, 64, Reference(1)) else Err(code):
        return
    var map = move made
    let k: Wrap<U64, Bad> = Wrap(a: 7, b: Bad(x: 1))
    match map.put(&allocator, k, 42):
        Ok:
            ()
        Err(entry):
            entry.discard()
    let probe: Wrap<U64, Bad> = Wrap(a: 7, b: Bad(x: 1))
    match map.get(&probe):
        Ok(v):
            console.print_int(*v)
        Err(code):
            console.print_int(0)
    console.print_int(map.len())
    probe.discard()
    map.discard()
