// JSON numbers read as F64 with `Json.number()`: whole numbers, decimals and exponents (the
// tree keeps a decimal's text; `parse_f64` reads it, correctly rounded), and a string, which is
// not a number.
import console
import string
import json_tree
import float

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): String = String.new(&allocator) else Err(c):
        return
    var text = move made
    let _ = text.push_text(&allocator, "[3, 0.1, -2.5, 1e3, 6.02214076e23, 1.7976931348623157e308, 5e-324, 0.30000000000000004, \"7\"]")
    let Ok(doc): Json = json_tree(&text, &allocator) else Err(at):
        console.print("bad json at ${at}")
        text.close()
        return
    var total = 0.0
    match &doc:
        Array(items):
            for item in items:
                match item.number():
                    Ok(value):
                        console.print_int(F64.bits(value))
                        total = total + value
                    Err(code):
                        console.line("not a number")
        _:
            console.line("not an array")
    console.print_f64(total, 3)
    doc.discard()
    text.close()
