// Each name of a two-Span variant keeps the String lent while it is in use: the second
// name alone, used after the String changes, is refused.
import console
import span
import string

type Route:
    One(Span)
    Two(Span, Span)

fn pick(text: Span) -> Route:
    match text.split(32):
        Ok(halves):
            return Two(halves.head, halves.tail)
        Err(whole):
            return One(whole)

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): String = String.new(&allocator) else Err(code):
        return
    var text = move made
    let _ = text.push_text(&allocator, "hello you")
    match pick(text.span()):
        One(name):
            console.print_int(name.len())
        Two(a, b):
            console.print_int(a.len())
            let more = text.push_text(&allocator, "!")
            console.print_int(b.len())
    text.close()
