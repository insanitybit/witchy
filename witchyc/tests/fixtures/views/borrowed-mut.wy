// A `&mut` reference to a record that holds a reference: allowed from step 2 of the design.
import "../../../library/wasm-span.wy"
import "../../../library/wasm-string.wy"

fn size(span: &mut Span) -> U64:
    return 0

fn main(console: Console<Write>, allocator: Allocator):
    var text = match String.new(&allocator):
        Ok(empty):
            move empty
        Err(code):
            return
    text.close()
