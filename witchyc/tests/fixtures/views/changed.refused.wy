// A String cannot change while a Span of it is in use.
import "../../../library/wasm-span.wy"
import "../../../library/wasm-string.wy"

fn main(console: Console<Write>, allocator: Allocator):
    var text = match String.new(&allocator):
        Ok(empty):
            move empty
        Err(code):
            return
    let whole = text.span()
    text.clear()
    console.print_int(whole.len())
    text.close()
