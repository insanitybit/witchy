// Refused: the String a Span was made from stays lent while a proved function is to be given
// the Span, as for any other.
import console
import span
import string

fn length(text: Span) -> U64:
    ensures result <= 18446744073709551615
    return text.len()

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): String = String.new(&allocator) else Err(code):
        return
    var s = move made
    let _ = s.push_text(&allocator, "hello")
    let view = s.span()
    let _ = s.push_text(&allocator, " there")
    console.print_int(length(view))
    s.close()
