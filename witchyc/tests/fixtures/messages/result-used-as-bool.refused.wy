// Refused, saying the call gives a Result to be matched: it said "generic type argument conflict".
import console
import vec

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): Vec<U64> = Vec.new(&allocator, 2) else Err(e):
        return
    var v = move made
    if !v.push_mut(&allocator, 5):
        console.line("full")
    v.close()
