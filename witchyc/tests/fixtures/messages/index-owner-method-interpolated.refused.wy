// Refused, as `index-owner-method`: inside `${...}` it said nothing given fixes `F` (the
// ambiguity is reported after the arguments' own errors now).
import console
import string
import vec
import hash
import discard

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): Vec<String> = Vec.new(&allocator, 4) else Err(e):
        return
    var v = move made
    let Ok(k): String = String.new(&allocator) else Err(e):
        v.discard()
        return
    var key = move k
    console.print("${v[0].eq(&key)}")
    key.close()
    v.discard()
