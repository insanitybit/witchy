// Refused, naming the operations that may overflow and the local they are assigned to.
import console

fn sum(n: U64) -> U64:
    requires n < 100
    ensures true
    proof:
        auto
    var total: U64 = 0
    var i: U64 = 0
    while i < n:
        invariant i <= n
        total = total * 3 + i
        i += 1
    return total

fn main(console: Console<Write>):
    console.print_int(sum(5))
