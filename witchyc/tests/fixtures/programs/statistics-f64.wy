// Statistics in F64: mean, variance and standard deviation of a data set, and a square root by
// Newton's method checked against F64.sqrt.
import console
import float

fn mean(xs: &[F64]) -> F64:
    var sum = 0.0
    for x in xs:
        sum += *x
    return sum / F64.from_u64(xs.len())

fn variance(xs: &[F64]) -> F64:
    let m = mean(xs)
    var sum = 0.0
    for x in xs:
        let d = *x - m
        sum += d * d
    return sum / F64.from_u64(xs.len())

fn newton_sqrt(v: F64) -> F64:
    var guess = v / 2.0
    for step in 0..30:
        guess = (guess + v / guess) / 2.0
    return guess

fn main(console: Console<Write>):
    let data: [F64; 8] = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
    let s = data.slice()
    let v = variance(s)
    console.print_f64(mean(s), 3)
    console.print_f64(v, 3)
    console.print_f64(newton_sqrt(v), 6)
    console.print_f64(F64.sqrt(2.0) - newton_sqrt(2.0), 9)
