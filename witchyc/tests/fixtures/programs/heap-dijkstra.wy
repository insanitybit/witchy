// A binary heap written here, generic over any `T: Before`, used for shortest paths on a
// 5 by 5 grid of costs (Dijkstra): the cheapest path's cost from the top-left corner to the
// bottom-right one.
import console
import sort
import vec
import discard
import discard_core

type Heap<T>:
    items: Vec<T>

impl<T: Any + Before + Discard> Heap<T>:
    pub fn new(allocator: &Allocator) -> Result<Heap<T>, U64>:
        let items: Vec<T> = Vec.new(allocator, 8)?
        return Ok(Heap(move items))

    pub fn len(heap: &Heap<T>) -> U64:
        return heap.items.len()

    // Adds `item`; Err gives it back when there is no room.
    pub fn push(heap: &mut Heap<T>, allocator: &Allocator, item: T) -> Result<(), T>:
        (*heap).items.push_mut(allocator, move item)?
        var at = (*heap).items.len() - 1
        while at > 0:
            let parent = (at - 1) / 2
            if !precedes(&(*heap).items, at, parent):
                return Ok(())
            let _ = (*heap).items.exchange(at, parent)
            at = parent
        return Ok(())

    // The first item by `Before`.
    pub fn pop(heap: &mut Heap<T>) -> Result<T, U64>:
        let count = (*heap).items.len()
        if count == 0:
            return Err(0)
        let _ = (*heap).items.exchange(0, count - 1)
        let first = (*heap).items.take_last_mut()?
        let size = count - 1
        var at: U64 = 0
        while at * 2 + 1 < size:
            var child = at * 2 + 1
            if child + 1 < size && precedes(&(*heap).items, child + 1, child):
                child += 1
            if !precedes(&(*heap).items, child, at):
                return Ok(move first)
            let _ = (*heap).items.exchange(at, child)
            at = child
        return Ok(move first)

    pub fn close(heap: Heap<T>):
        let Heap(items) = move heap
        items.discard()

type Step derive(Discard):
    cost: U64
    cell: U64

impl Before for Step:
    fn before(self: &Step, other: &Step) -> Bool:
        return self.cost < other.cost

fn cheapest(allocator: &Allocator, costs: &[U64], width: U64) -> Result<U64, U64>:
    let cells = costs.len()
    let infinity: U64 = 1000000
    var best: [U64; 25] = [1000000; 25]
    best[0] = 0
    var heap: Heap<Step> = Heap.new(allocator)?
    match heap.push(allocator, Step(0, 0)):
        Ok:
            ()
        Err(back):
            heap.close()
            return Err(1)
    while heap.len() > 0:
        let Ok(step): Step = heap.pop() else Err(code):
            heap.close()
            return Err(2)
        if step.cost > best[step.cell]:
            continue
        let row = step.cell / width
        let column = step.cell % width
        for direction in 0..4:
            var next = cells
            if direction == 0 && row > 0:
                next = step.cell - width
            if direction == 1 && row + 1 < cells / width:
                next = step.cell + width
            if direction == 2 && column > 0:
                next = step.cell - 1
            if direction == 3 && column + 1 < width:
                next = step.cell + 1
            if next < cells:
                let cost = step.cost + costs[next]
                if cost < best[next]:
                    best[next] = cost
                    match heap.push(allocator, Step(cost, next)):
                        Ok:
                            ()
                        Err(back):
                            heap.close()
                            return Err(3)
    heap.close()
    return Ok(best[cells - 1])

fn main(console: Console<Write>, allocator: Allocator):
    let costs: [U64; 25] = [1, 3, 1, 2, 9,
                            1, 5, 1, 9, 1,
                            4, 2, 1, 1, 1,
                            9, 9, 9, 9, 1,
                            1, 1, 1, 1, 1]
    match cheapest(&allocator, &costs, 5):
        Ok(cost):
            console.print_int(cost)
        Err(code):
            console.print_int(1000 + code)
