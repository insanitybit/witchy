// SHA-256 (FIPS 180-4) of a text, with 32-bit words held in U64 and masked: bit operations,
// shifts and rotations end to end. Prints the digest in hex.
import console
import vec

let MASK: U64 = 4294967295

fn rotr(x: U64, n: U64) -> U64:
    return ((x >> n) | (x << (32 - n))) & MASK

fn add(a: U64, b: U64) -> U64:
    return (a + b) & MASK

fn hex(console: &Console<Write>, word: U64):
    let digits: &str = "0123456789abcdef"
    var shift: U64 = 28
    var going = true
    while going:
        console.print_byte(digits.as_bytes()[(word >> shift) & 15])
        if shift == 0:
            going = false
        else:
            shift -= 4

fn digest(console: &Console<Write>, allocator: &Allocator, text: Text):
    let k: [U64; 64] = [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]
    var h: [U64; 8] = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]
    let length = text.byte_len()
    // The message, a 1 bit, zeros, and the length in bits as 64 bits: a multiple of 64 bytes.
    let total = (length + 9 + 63) / 64 * 64
    let zero: U8 = 0
    let Ok(made): Vec<U8> = Vec.filled(allocator, total, zero) else Err(code):
        return
    var bytes = move made
    for i in 0..length:
        match text.byte_at(i):
            Ok(byte):
                bytes[i] = byte
            Err(code):
                bytes.close()
                return
    bytes[length] = 128
    let bits = length * 8
    for i in 0..8:
        bytes[total - 1 - i] = U8.truncate((bits >> (8 * i)) & 255)
    var w: [U64; 64] = [0; 64]
    var block: U64 = 0
    while block < total:
        for t in 0..16:
            let at = block + 4 * t
            w[t] = (U8.to_u64(bytes[at]) << 24) | (U8.to_u64(bytes[at + 1]) << 16) | (U8.to_u64(bytes[at + 2]) << 8) | U8.to_u64(bytes[at + 3])
        for t in 16..64:
            let s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >> 3)
            let s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >> 10)
            w[t] = add(add(w[t - 16], s0), add(w[t - 7], s1))
        var a = h[0]
        var b = h[1]
        var c = h[2]
        var d = h[3]
        var e = h[4]
        var f = h[5]
        var g = h[6]
        var hh = h[7]
        for t in 0..64:
            let big1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let choice = (e & f) ^ (~e & MASK & g)
            let t1 = add(add(add(hh, big1), add(choice, k[t])), w[t])
            let big0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let majority = (a & b) ^ (a & c) ^ (b & c)
            let t2 = add(big0, majority)
            hh = g
            g = f
            f = e
            e = add(d, t1)
            d = c
            c = b
            b = a
            a = add(t1, t2)
        h[0] = add(h[0], a)
        h[1] = add(h[1], b)
        h[2] = add(h[2], c)
        h[3] = add(h[3], d)
        h[4] = add(h[4], e)
        h[5] = add(h[5], f)
        h[6] = add(h[6], g)
        h[7] = add(h[7], hh)
        block += 64
    bytes.close()
    for i in 0..8:
        hex(console, h[i])
    console.print_byte('\n')

fn main(console: Console<Write>, allocator: Allocator):
    digest(&console, &allocator, "")
    digest(&console, &allocator, "abc")
    digest(&console, &allocator, "The quick brown fox jumps over the lazy dog")
    digest(&console, &allocator, "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    digest(&console, &allocator, "0123456789012345678901234567890123456789012345678901234567890123456789")
