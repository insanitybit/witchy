// Sort numbers in place with Vec.swap, overwrite one with Vec.set, and exchange
// an owned String inside a Vec<String> with Vec.replace_mut.
import "../../../library/wasm-console.wy"
import "../../../library/wasm-vec.wy"
import "../../../library/wasm-string.wy"
import "../../../library/wasm-discard.wy"

// Insertion sort.
fn sort(items: &mut Vec<U64>):
    for index in 1..items.len():
        var at = index
        while at > 0:
            let left = match items.get(at - 1):
                Ok(value):
                    value
                Err(code):
                    break
            let right = match items.get(at):
                Ok(value):
                    value
                Err(code):
                    break
            if left <= right:
                break
            let _ = items.swap(at - 1, at)
            at -= 1

fn numbers(console: &Console<Write>, allocator: &Allocator):
    let made: Result<Vec<U64>, U64> = Vec.new(allocator, 0)
    var items = match move made:
        Ok(empty):
            move empty
        Err(code):
            return
    for step in 0..6:
        match items.push_mut(allocator, (step * 7 + 5) % 11):
            Ok:
                continue
            Err(back):
                break
    sort(&mut items)
    if let Err(_) = items.set(0, 100):
        console.line("no first element")
    if let Ok(_) = items.set(6, 1):
        console.line("an index past the end was accepted")
    if let Ok(_) = items.swap(0, 6):
        console.line("an index past the end was accepted")
    for index in 0..items.len():
        match items.get(index):
            Ok(value):
                console.print_int(value)
            Err(code):
                break
    items.close()

fn text(allocator: &Allocator, value: Text) -> Result<String, U64>:
    var made = String.new(allocator)?
    if let Err(_) = made.push_text(allocator, value):
        made.close()
        return Err(1)
    return Ok(move made)

fn names(console: &Console<Write>, allocator: &Allocator) -> Result<(), U64>:
    var items: Vec<String> = Vec.new(allocator, 0)?
    let first = match text(allocator, "first"):
        Ok(made):
            move made
        Err(code):
            items.discard()
            return Err(code)
    match items.push_mut(allocator, move first):
        Ok:
            console.line("pushed")
        Err(back):
            back.close()
    let second = match text(allocator, "second"):
        Ok(made):
            move made
        Err(code):
            items.discard()
            return Err(code)
    // The String that was there comes back and is closed here.
    match items.replace_mut(0, move second):
        Ok(before):
            console.write_string(&before)
            console.line(" replaced")
            before.close()
        Err(back):
            back.close()
    match items.at(0):
        Ok(now):
            console.write_string(now)
            console.line("")
        Err(code):
            console.print_int(code)
    items.discard()
    return Ok(())

fn main(console: Console<Write>, allocator: Allocator):
    numbers(&console, &allocator)
    match names(&console, &allocator):
        Ok:
            console.line("done")
        Err(code):
            console.print_int(code)
