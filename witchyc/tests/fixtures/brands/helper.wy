// A separately written helper, `fn improve<G: Brand>`, used with an opening's rows; no brand is written at the call.
import console

type Graph:
    count: U64

type Node<G>:
    offset: U64

type Nodes<G>:
    count: U64

impl Graph:
    fn nodes<D: Fresh>(self: &Graph) -> Nodes<D>:
        return Nodes(count: (*self).count)

fn first<G: Brand>(nodes: &Nodes<G>) -> Node<G>:
    return Node(offset: 0)

fn last<G: Brand>(nodes: &Nodes<G>) -> Node<G>:
    return Node(offset: (*nodes).count - 1)

fn apart<G: Brand>(a: Node<G>, b: Node<G>) -> U64:
    return b.offset - a.offset

fn improve<G: Brand>(nodes: &Nodes<G>, node: Node<G>, cost: U64) -> U64:
    if cost < node.offset:
        return cost
    return node.offset

fn main(console: Console<Write>):
    let roads = Graph(count: 80)
    brand roads.nodes() as r:
        let home = last(&r)
        console.print_int(improve(&r, home, 5))
