// Refused: a row of `rail` is given with one of `roads`, though both have 80 nodes; the message names both, at the argument.
import console

type Graph:
    count: U64

type Node<G>:
    offset: U64

type Nodes<G>:
    count: U64

impl Graph:
    fn nodes<D: Fresh>(self: &Graph) -> Nodes<D>:
        return Nodes(count: (*self).count)

fn first<G: Brand>(nodes: &Nodes<G>) -> Node<G>:
    return Node(offset: 0)

fn last<G: Brand>(nodes: &Nodes<G>) -> Node<G>:
    return Node(offset: (*nodes).count - 1)

fn apart<G: Brand>(a: Node<G>, b: Node<G>) -> U64:
    return b.offset - a.offset

fn main(console: Console<Write>):
    let roads = Graph(count: 80)
    let rail = Graph(count: 80)
    brand roads.nodes() as r:
        brand rail.nodes() as s:
            let a = first(&r)
            let station = last(&s)
            console.print_int(apart(a, station))
