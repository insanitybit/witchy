// Refused: only the opened call itself gets the new brand; an opening among its arguments does not.
import console

type Graph:
    count: U64

type Node<G>:
    offset: U64

type Nodes<G>:
    count: U64

impl Graph:
    fn nodes<D: Fresh>(self: &Graph) -> Nodes<D>:
        return Nodes(count: (*self).count)

fn first<G: Brand>(nodes: &Nodes<G>) -> Node<G>:
    return Node(offset: 0)

fn last<G: Brand>(nodes: &Nodes<G>) -> Node<G>:
    return Node(offset: (*nodes).count - 1)

fn apart<G: Brand>(a: Node<G>, b: Node<G>) -> U64:
    return b.offset - a.offset

fn pick<G: Brand>(a: Nodes<G>, b: Nodes<G>) -> Nodes<G>:
    return a

fn main(console: Console<Write>):
    let roads = Graph(count: 80)
    let rail = Graph(count: 80)
    brand pick(roads.nodes(), rail.nodes()) as x:
        console.print_int(apart(first(&x), last(&x)))
