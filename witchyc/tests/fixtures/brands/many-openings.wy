fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): Graph = Graph.new(&allocator, 4) else Err(code):
        return
    var roads = move made
    let _ = roads.connect(&allocator, 0, 1)
    match step0(&roads, &allocator):
        Ok(t):
            console.print_int(t)
        Err(code):
            console.line("no room")
    match step1(&roads, &allocator):
        Ok(t):
            console.print_int(t)
        Err(code):
            console.line("no room")
    match step2(&roads, &allocator):
        Ok(t):
            console.print_int(t)
        Err(code):
            console.line("no room")
    match step3(&roads, &allocator):
        Ok(t):
            console.print_int(t)
        Err(code):
            console.line("no room")
    match step4(&roads, &allocator):
        Ok(t):
            console.print_int(t)
        Err(code):
            console.line("no room")
    match step5(&roads, &allocator):
        Ok(t):
            console.print_int(t)
        Err(code):
            console.line("no room")
    match step6(&roads, &allocator):
        Ok(t):
            console.print_int(t)
        Err(code):
            console.line("no room")
    match step7(&roads, &allocator):
        Ok(t):
            console.print_int(t)
        Err(code):
            console.line("no room")
    roads.close()
