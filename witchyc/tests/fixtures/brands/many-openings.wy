// Eight openings, each with its own brand, share one instance of every helper generic over the
// brand (erased after checking: 142 functions before, 65 after; docs/design-brands.md).
import console
import graph

fn improve<G: Brand>(distance: &mut Distances<G>, node: Node<G>, cost: U64):
    if cost < distance.get(node):
        distance.set(node, cost)

fn step0(roads: &Graph, allocator: &Allocator) -> Result<U64, U64>:
    brand roads.nodes() as nodes:
        var distance = nodes.distances(allocator, 1000000)?
        if let Some(home) = nodes.first():
            distance.set(home, 0)
            for next in nodes.neighbors(home):
                improve(&mut distance, next, 1)
        var total: U64 = 0
        for i in 0..nodes.count():
            if let Some(node) = nodes.node(i):
                total += distance.get(node)
        distance.close()
        return Ok(total)

