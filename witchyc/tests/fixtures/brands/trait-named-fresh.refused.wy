// Refused: `Fresh` and `Brand` are the compiler's own; no trait takes their names (review).
import console

type Graph:
    count: U64

type Node<G>:
    offset: U64

type Nodes<G>:
    count: U64

impl Graph:
    fn nodes<D: Fresh>(self: &Graph) -> Nodes<D>:
        return Nodes(count: (*self).count)

fn first<G: Brand>(nodes: &Nodes<G>) -> Node<G>:
    return Node(offset: 0)

fn apart<G: Brand>(a: Node<G>, b: Node<G>) -> U64:
    return b.offset - a.offset

trait Fresh:
    fn z(self: &Self) -> U64
fn main(console: Console<Write>):
    console.print_int(1)
