// Contract clauses that name fields: `pair.left`, `old(two.a.left)`, `*value`.
import "../../../library/wasm-console.wy"

type Pair:
    left: U64
    right: U64

type Small:
    byte: U8
    wide: U64

type Two:
    a: Pair
    b: Pair
    small: Small

// One more on the left; the right is as it was.
fn grow(pair: &mut Pair):
    requires pair.left < 100
    ensures pair.left == old(pair.left) + 1
    ensures pair.right == old(pair.right)
    proof:
        auto
    pair.left += 1

// Changes `a` and says only that one field of `b` is as it was.
fn quiet(two: &mut Two):
    ensures two.b.left == old(two.b.left)
    proof:
        auto
    two.a.right = 5

// No contract: a caller knows nothing of `two` afterwards.
fn loud(two: &mut Two):
    two.a.right = 5

fn peek(value: &U64) -> U64:
    ensures result == *value
    proof:
        auto
    return *value

fn bump(value: &mut U64):
    requires *value < 100
    ensures *value == old(*value) + 1
    proof:
        auto
    *value += 1

fn total(pair: &Pair) -> U64:
    requires pair.left < 100 && pair.right < 100
    ensures result == pair.left + pair.right
    proof:
        auto
    return pair.left + pair.right

// A callee's clauses about `pair` are facts about `two.a`; `two.b` is untouched.
fn grow_a(two: &mut Two):
    requires two.a.left < 50
    ensures two.a.left == old(two.a.left) + 2
    ensures two.a.right == old(two.a.right)
    ensures two.b.left == old(two.b.left)
    ensures two.b.right == old(two.b.right)
    proof:
        auto
    grow(&mut two.a)
    grow(&mut two.a)

// What the callee says of `b.left` is kept; a U8 field is at most 255.
fn hand_on(two: &mut Two):
    ensures two.b.left == old(two.b.left)
    ensures two.small.byte <= 255
    proof:
        auto
    quiet(two)

fn fill(two: &mut Two):
    requires two.b.left < 10
    ensures two.b.left == 10
    proof:
        auto
    while two.b.left < 10:
        invariant two.b.left <= 10
        two.b.left += 1

fn add_b(two: &mut Two):
    requires two.a.left < 50
    requires two.b.left < 50
    ensures two.a.left == old(two.a.left) + old(two.b.left)
    proof:
        auto
    two.a.left += peek(&two.b.left)

fn bump_wide(two: &mut Two):
    requires two.small.wide < 100
    ensures two.small.wide == old(two.small.wide) + 1
    ensures (*two).small.byte == old((*two).small.byte)
    proof:
        auto
    bump(&mut two.small.wide)

// Each call is given a fresh record: after a call, a caller knows of the record only
// what the callee's clauses say, and the next callee's `requires` must follow from that.
fn main(console: Console<Write>):
    var first = Two(Pair(1, 2), Pair(3, 4), Small(5, 6))
    console.print_int(total(&first.a))
    grow_a(&mut first)
    console.print_int(first.a.left)
    var second = Two(Pair(1, 2), Pair(3, 4), Small(5, 6))
    hand_on(&mut second)
    console.print_int(second.a.right)
    var third = Two(Pair(1, 2), Pair(3, 4), Small(5, 6))
    fill(&mut third)
    console.print_int(third.b.left)
    var fourth = Two(Pair(1, 2), Pair(3, 4), Small(5, 6))
    add_b(&mut fourth)
    console.print_int(fourth.a.left)
    var fifth = Two(Pair(1, 2), Pair(3, 4), Small(5, 6))
    bump_wide(&mut fifth)
    console.print_int(fifth.small.wide)
