// A proved binary search: `s[mid]` at `mid = lo + (hi - lo) / 2`, with `lo < hi` and the invariant
// `hi <= s.len()`, is a goal Lean proves, so the read has no test and the function never traps.
import console

fn lower_bound(s: &[U64], want: U64) -> U64:
    ensures result <= s.len()
    proof:
        auto
    var lo: U64 = 0
    var hi = s.len()
    while lo < hi:
        invariant lo <= hi && hi <= s.len()
        let mid = lo + (hi - lo) / 2
        if s[mid] < want:
            lo = mid + 1
        else:
            hi = mid
    return lo

fn main(console: Console<Write>):
    let a: [U64; 8] = [1, 3, 3, 5, 8, 13, 21, 34]
    let s = a.slice()
    console.print("${lower_bound(s, 5)} ${lower_bound(s, 4)} ${lower_bound(s, 100)} ${lower_bound(s, 0)}")
