// A sealed record over a Buffer says how long the slice it returns is (`result.len()`), proved by
// the memory model from `slice_unchecked`'s `to - from` (Astra's next step, 2026-11-22).

import console

sealed type Row<T>:
    data: Buffer<T>
    length: U64
    capacity: U64
    invariant memory.prefix(data, length, capacity)

impl<T: Any> Row<T>:
    fn all(value: &Row<T>) -> &[T]:
        ensures result.len() == value.length
        ensures value.length == old(value.length)
        proof:
            auto
        return memory.slice_unchecked(&(*value).data, 0, (*value).length)

fn main(console: Console<Write>):
    console.print_int(1)
