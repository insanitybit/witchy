// Random puts, removes and take_anys on a small table against a plain array of what should be
// there; every lookup is compared, and at the end every key.
import console
import hashmap
import discard

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(m): HashMap<U64, U64> = HashMap.new(&allocator, 16) else Err(c):
        return
    var map = move m
    // 0 = absent, else value + 1.
    var want: [U64; 48] = [0; 48]
    var held: U64 = 0
    var seed: U64 = 12345
    var wrong: U64 = 0
    for step in 0..20000:
        seed = seed * 48271 % 2147483647
        let key = seed % 48
        let op = (seed / 48) % 7
        if op < 3:
            if want[key] == 0 && held < 11:
                match map.put(&allocator, key, step):
                    Ok:
                        want[key] = step + 1
                        held += 1
                    Err(back):
                        wrong += 1
        else if op < 6:
            match map.remove(&key):
                Ok(entry):
                    if want[key] != entry.value + 1:
                        wrong += 1
                    want[key] = 0
                    held -= 1
                Err(missing):
                    if want[key] != 0:
                        wrong += 1
        else:
            match map.take_any():
                Ok(entry):
                    if entry.key < 48:
                        if want[entry.key] != entry.value + 1:
                            wrong += 1
                        want[entry.key] = 0
                        held -= 1
                Err(none):
                    if held != 0:
                        wrong += 1
        let probe = (seed / 336) % 48
        match map.get(&probe):
            Ok(v):
                if want[probe] != *v + 1:
                    wrong += 1
            Err(missing):
                if want[probe] != 0:
                    wrong += 1
        if map.len() != held:
            wrong += 1
    for key in 0..48:
        match map.get(&key):
            Ok(v):
                if want[key] != *v + 1:
                    wrong += 1
            Err(missing):
                if want[key] != 0:
                    wrong += 1
    console.print("${wrong} wrong, ${held} held")
    map.discard()
