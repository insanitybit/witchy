// The same at a higher load: eight cells, up to six entries.
// A walk (`for entry in &map`) after random puts, removes and take_anys: every 50 steps it must
// visit each key held exactly once, with its value, and nothing else.
import console
import hashmap
import discard

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(m): HashMap<U64, U64> = HashMap.new(&allocator, 8) else Err(c):
        return
    var map = move m
    // 0 = absent, else value + 1.
    var want: [U64; 48] = [0; 48]
    var held: U64 = 0
    var seed: U64 = 12345
    var wrong: U64 = 0
    var walks: U64 = 0
    for step in 0..20000:
        seed = seed * 48271 % 2147483647
        let key = seed % 48
        let op = (seed / 48) % 7
        if op < 3:
            if want[key] == 0 && held < 6:
                match map.put(&allocator, key, step):
                    Ok:
                        want[key] = step + 1
                        held += 1
                    Err(back):
                        wrong += 1
        else if op < 6:
            match map.remove(&key):
                Ok(entry):
                    if want[key] != entry.value + 1:
                        wrong += 1
                    want[key] = 0
                    held -= 1
                Err(missing):
                    if want[key] != 0:
                        wrong += 1
        else:
            match map.take_any():
                Ok(entry):
                    if entry.key < 48:
                        if want[entry.key] != entry.value + 1:
                            wrong += 1
                        want[entry.key] = 0
                        held -= 1
                Err(none):
                    if held != 0:
                        wrong += 1
        let probe = (seed / 336) % 48
        match map.get(&probe):
            Ok(v):
                if want[probe] != *v + 1:
                    wrong += 1
            Err(missing):
                if want[probe] != 0:
                    wrong += 1
        if map.len() != held:
            wrong += 1
        if step % 50 == 0:
            var visits: [U64; 48] = [0; 48]
            var walked: U64 = 0
            for entry in &map:
                walked += 1
                if entry.key >= 48 || want[entry.key] != entry.value + 1:
                    wrong += 1
                else:
                    visits[entry.key] += 1
            for held_key in 0..48:
                if (want[held_key] != 0) != (visits[held_key] == 1) || visits[held_key] > 1:
                    wrong += 1
            if walked != held:
                wrong += 1
            walks += 1
    for key in 0..48:
        match map.get(&key):
            Ok(v):
                if want[key] != *v + 1:
                    wrong += 1
            Err(missing):
                if want[key] != 0:
                    wrong += 1
    console.print("${wrong} wrong, ${walks} walks, ${held} held")
    map.discard()
