// A key whose Eq and Hash read only its id: a probe with other metadata finds the entry, and a
// changed record put under the same id replaces nothing but is found as the same key.
// The hand-written baseline for the derive goal's second example (docs/benchmarks.md).
import console
import hash
import hashmap

type User derive(Discard):
    id: U64
    visits: U64
    level: U8

impl Eq for User:
    fn eq(self: &User, other: &User) -> Bool:
        return (*self).id == (*other).id

impl Hash for User:
    fn hash(self: &User) -> U64:
        return (*self).id.hash()

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): HashMap<User, U64> = HashMap.new(&allocator, 16) else Err(code):
        return
    var map = move made
    for id in 0..10:
        match map.insert(User(id: id, visits: 0, level: 1), id * 100):
            Ok:
                ()
            Err(entry):
                discard(entry)
    // The same ids with every other field changed.
    var found: U64 = 0
    var total: U64 = 0
    for id in 0..12:
        match map.get(&User(id: id, visits: 999, level: 7)):
            Ok(n):
                found += 1
                total += *n
            Err(code):
                ()
    console.print("${map.len()} ${found} ${total}")
    // A second insert under id 3 with new metadata is the same key: refused, handed back.
    match map.insert(User(id: 3, visits: 5, level: 2), 1):
        Ok:
            console.line("added")
        Err(entry):
            console.line("same key")
            discard(entry)
    map.discard()
