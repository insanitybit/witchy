// While an entry is in use the map is lent: it cannot change under the reference.
import "../../../library/wasm-console.wy"
import "../../../library/wasm-hashmap.wy"

fn main(console: Console<Write>, allocator: Allocator):
    let made: Result<HashMap<U64, U64>, U64> = HashMap.new(&allocator, 8)
    var map = match move made:
        Ok(empty):
            move empty
        Err(reason):
            return
    for number in 1..6:
        match map.put(&allocator, number, number * number):
            Ok(done):
                continue
            Err(entry):
                break
    for entry in &map:
        match map.remove(&entry.key):
            Ok(taken):
                console.print_int(taken.value)
            Err(code):
                console.print_int(0)
        console.print_int(entry.value)
    map.discard()
