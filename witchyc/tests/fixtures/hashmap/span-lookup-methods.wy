// A HashMap<String, V> looked up by a Span with the map's own methods: `counts.contains(&word)`,
// `counts.get(&word)`, `counts.get_mut(&word)`. The generic code holds the Span only behind `&`.
import console
import hashmap
import span
import string

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): HashMap<String, U64> = HashMap.new(&allocator, 8) else Err(code):
        return
    var counts = move made
    let Ok(key_made): String = String.new(&allocator) else Err(code):
        counts.discard()
        return
    var key = move key_made
    let _ = key.push_text(&allocator, "beta")
    match counts.insert(move key, 1):
        Ok:
            console.line("inserted")
        Err(back):
            let Entry(k, v) = move back
            k.close()
    let Ok(text_made): String = String.new(&allocator) else Err(code):
        counts.discard()
        return
    var text = move text_made
    let _ = text.push_text(&allocator, "alpha beta gamma")
    let whole = text.span()
    let word = whole.part(6, 10)
    console.print("${word}: ${if counts.contains(&word): 1 else: 0}")
    if let Ok(n) = counts.get_mut(&word):
        *n += 41
    let head = whole.part(0, 5)
    match counts.get(&head):
        Ok(n):
            console.print_int(*n)
        Err(code):
            console.line("alpha absent")
    match counts.get(&word):
        Ok(n):
            console.print_int(*n)
        Err(code):
            console.line("beta absent")
    text.close()
    counts.discard()
