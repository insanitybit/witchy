// Floats written with 0 to 9 places and with many nine-digit chunks: the padded digits go out
// a word at a time (`write_padded`).
import console
import float

fn main(console: Console<Write>):
    console.print_f64(0.0, 0)
    console.print_f64(0.0, 1)
    console.print_f64(0.0, 4)
    console.print_f64(0.0, 8)
    console.print_f64(0.0, 9)
    console.print_f64(1.5, 0)
    console.print_f64(1.5, 1)
    console.print_f64(1.5, 4)
    console.print_f64(1.5, 8)
    console.print_f64(1.5, 9)
    console.print_f64(3.141592653589793, 0)
    console.print_f64(3.141592653589793, 1)
    console.print_f64(3.141592653589793, 4)
    console.print_f64(3.141592653589793, 8)
    console.print_f64(3.141592653589793, 9)
    console.print_f64(1234567890.123, 0)
    console.print_f64(1234567890.123, 1)
    console.print_f64(1234567890.123, 4)
    console.print_f64(1234567890.123, 8)
    console.print_f64(1234567890.123, 9)
    console.print_f64(1.0e300, 0)
    console.print_f64(1.0e300, 1)
    console.print_f64(1.0e300, 4)
    console.print_f64(1.0e300, 8)
    console.print_f64(1.0e300, 9)
    console.print_f64(0.000001234, 0)
    console.print_f64(0.000001234, 1)
    console.print_f64(0.000001234, 4)
    console.print_f64(0.000001234, 8)
    console.print_f64(0.000001234, 9)
    console.print_f64(987654321987654321.0, 0)
    console.print_f64(987654321987654321.0, 1)
    console.print_f64(987654321987654321.0, 4)
    console.print_f64(987654321987654321.0, 8)
    console.print_f64(987654321987654321.0, 9)
    console.print_f64(2.5, 0)
    console.print_f64(2.5, 1)
    console.print_f64(2.5, 4)
    console.print_f64(2.5, 8)
    console.print_f64(2.5, 9)
    console.print_f64(-7.25, 0)
    console.print_f64(-7.25, 1)
    console.print_f64(-7.25, 4)
    console.print_f64(-7.25, 8)
    console.print_f64(-7.25, 9)
