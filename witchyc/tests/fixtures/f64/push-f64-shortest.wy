// String.push_f64 against Python's repr: each line is an F64's bits, written as the shortest
// decimal that reads back as it. Edges (0.1, 1e16 and 1e15 where the form changes, 1e-05,
// the least subnormal and normal, the largest, 2^53, -0.0), random bit patterns (nan, inf),
// random values, short decimals, each exponent's ends (picked from 13,160 compared values).
import console
import string
import float
import text

fn main(console: Console<Write>, input: Console<Read>, allocator: Allocator):
    let Ok(made): String = String.new(&allocator) else Err(e):
        return
    var line = move made
    let Ok(o): String = String.new(&allocator) else Err(e):
        line.close()
        return
    var out = move o
    while true:
        line.clear()
        match input.read_line(&allocator, &mut line):
            .Line:
                match line.parse_u64():
                    Ok(bits):
                        out.clear()
                        if let Ok(_) = out.push_f64(&allocator, F64.from_bits(bits)):
                            console.write_string(&out)
                            console.line("")
                        else:
                            console.line("no room")
                    Err(code):
                        console.line("bad")
            .End:
                break
            .NotText:
                break
            .NoRoom:
                break
    out.close()
    line.close()
