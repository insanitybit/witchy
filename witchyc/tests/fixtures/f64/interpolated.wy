// `${x}` for an F64, through the console and through a String: the shortest text that reads
// back (`Show for F64`), in Python's repr form.
import console
import string
import float

fn main(console: Console<Write>, allocator: Allocator):
    let third = 1.0 / 3.0
    let big = 1.0e300 * 10.0
    console.print("a third is ${third}, a tenth ${0.1}, sum ${0.1 + 0.2}")
    console.print("${big} ${-2.5} ${100.0} ${0.00001} ${1.0e16} ${big * big} ${0.0 - 0.0}")
    let Ok(made): String = String.new(&allocator) else Err(e):
        return
    var text = move made
    if let Ok(_) = text.push_format(&allocator, "[${third}|${-0.0}]"):
        console.write_string(&text)
        console.line("")
    text.close()
