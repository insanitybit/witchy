// An argument cannot consume the value the call borrows.
import "../../../library/wasm-vec.wy"

fn spend(items: Vec<U64>) -> U64:
    let count = items.len()
    items.close()
    return count

fn both(items: &Vec<U64>, count: U64) -> U64:
    return items.len() + count

fn main(console: Console<Write>, allocator: Allocator):
    let made: Result<Vec<U64>, U64> = Vec.new(&allocator, 0)
    match move made:
        Ok(items):
            console.print_int(both(&items, spend(move items)))
        Err(code):
            console.print_int(code)
