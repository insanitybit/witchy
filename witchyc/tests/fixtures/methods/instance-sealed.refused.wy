import "../../../library/wasm-console.wy"
import "../../../library/wasm-vec.wy"

impl Vec<U64>:
    fn cheat(self: &mut Vec<U64>):
        self.length = 99

fn main(console: Console<Write>, allocator: Allocator):
    var numbers: Vec<U64> = match Vec.new(&allocator, 4):
        Ok(made):
            move made
        Err(reason):
            return
    numbers.cheat()
    numbers.close()
