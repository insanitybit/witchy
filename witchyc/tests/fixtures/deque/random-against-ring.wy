// Random pushes and pops at both ends of the library Deque, grown when full, against a ring of
// what it should hold; every pop and a random `get` are compared.
import console
import deque
import discard

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): Deque<U64> = Deque.new(&allocator, 2) else Err(c):
        return
    var d = move made
    var ring: [U64; 256] = [0; 256]
    var head: U64 = 0
    var size: U64 = 0
    var seed: U64 = 5
    var wrong: U64 = 0
    for step in 0..30000:
        seed = seed * 48271 % 2147483647
        let op = seed % 4
        if op < 2 && size < 200:
            if d.len() == d.capacity():
                if let Err(_) = d.reserve_mut(&allocator, d.capacity() * 2):
                    wrong += 1
            if op == 0:
                match d.push_back_mut(step):
                    Ok:
                        ring[(head + size) % 256] = step
                        size += 1
                    Err(back):
                        wrong += 1
            else:
                match d.push_front_mut(step):
                    Ok:
                        head = (head + 255) % 256
                        ring[head] = step
                        size += 1
                    Err(back):
                        wrong += 1
        else if op == 2:
            match d.pop_front_mut():
                Ok(v):
                    if size == 0 || v != ring[head]:
                        wrong += 1
                    head = (head + 1) % 256
                    size -= 1
                Err(e):
                    if size != 0:
                        wrong += 1
        else:
            match d.pop_back_mut():
                Ok(v):
                    if size == 0 || v != ring[(head + size - 1) % 256]:
                        wrong += 1
                    size -= 1
                Err(e):
                    if size != 0:
                        wrong += 1
        if size > 0:
            let at = (seed / 4) % size
            match d.get(at):
                Ok(v):
                    if v != ring[(head + at) % 256]:
                        wrong += 1
                Err(e):
                    wrong += 1
        if d.len() != size:
            wrong += 1
    console.print("${wrong} wrong, ${size} held, capacity ${d.capacity()}")
    d.discard()
