// A fixed array indexed in place lives in the frame and is read at the element's address. An
// index that changes something (here a call that also writes the array) keeps the old order:
// the array is read before the index runs, so `a[bump(&mut a)]` sees the array as it was.
import console

fn bump(a: &mut [U64; 4]) -> U64:
    a[2] = 70
    return 2

fn main(console: Console<Write>):
    var a: [U64; 4] = [10, 20, 30, 40]
    var i: U64 = 3
    var total: U64 = 0
    while i > 0:
        total += a[i] * i
        a[i - 1] = a[i] + 1
        i -= 1
    console.print_int(total)
    console.print_int(a[0])
    let seen = a[bump(&mut a)]
    console.print_int(seen)
    console.print_int(a[2])
