// Duration literals (250ms, 30s, 5m, 2h, 1d, 1w, 1m30s) are Durations (import time): added,
// subtracted and compared with each other, never with a bare number; `.ms()` is the count.
import console
import time

fn main(console: Console<Write>):
    let timeout = 30s
    let total = timeout + 1m30s - 250ms
    console.print_int(total.ms())
    console.print_int(total.seconds())
    if 1s < 2s && 2h > 90m && timeout == 30s:
        console.print_int(1)
    console.print_int(100ms.times(3).ms())
    var waited = 0ms
    for i in 0..4:
        waited += 250ms
    console.print_int(waited.ms())
