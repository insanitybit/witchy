// The loop's increments are bounded, but one after the loop is not: the counter is checked
// everywhere, and that one overflows.
import console

fn main(console: Console<Write>):
    let top: U64 = 18446744073709551615
    var i: U64 = top - 1
    while i < top:
        i += 1
    i += 1
    console.print_int(i)
