// A record passed by value is copied when its argument is evaluated; a later argument
// that writes the record through &mut must not change what the callee's requires is shown of.
import console

type Pair:
    left: U64
    right: U64

fn reset(n: &mut U64) -> U64:
    ensures *n == 0
    ensures result == 0
    proof:
        auto
    *n = 0
    return 0

fn inc(pair: Pair, z: U64) -> U64:
    requires pair.left < 10
    ensures true
    proof:
        auto
    return pair.left + 1

fn over(x: U64) -> U64:
    ensures true
    proof:
        auto
    var p = Pair(x, 0)
    return inc(p, reset(&mut p.left))

fn main(console: Console<Write>):
    console.print_int(over(18446744073709551615))
