// Refused: the array is lent to the generator while the generator is in use.
gen fn all(items: &[U64]) -> U64:
    var index: U64 = 0
    while index < items.len():
        let item: U64 = items[index]
        yield item
        index += 1

fn main():
    var numbers: [U64; 3] = [1, 2, 3]
    var total: U64 = 0
    for n in all(numbers.slice()):
        numbers[0] = 9
        total += n
