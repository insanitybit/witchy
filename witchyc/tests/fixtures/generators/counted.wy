// `yield` inside `for i in a..b`: the counter and the end live between steps, the end is
// read once, and `continue` still moves the counter on.
import console

gen fn odd_squares(limit: U64) -> U64:
    for i in 0..limit:
        if i % 2 == 0:
            continue
        yield i * i
        if i > 6:
            break
    yield 999

gen fn table(rows: U64) -> U64:
    for r in 1..rows + 1:
        for c in 1..3:
            yield r * 10 + c

fn main(console: Console<Write>):
    for v in odd_squares(20):
        console.print_int(v)
    for v in table(2):
        console.print_int(v)
