// A generator method walking a field of its receiver (`self.items`).
import console
import vec

type Bag:
    items: Vec<U64>

impl Bag:
    gen fn evens(self: &Bag) -> U64:
        for x in self.items:
            if *x % 2 == 0:
                yield *x

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): Vec<U64> = Vec.new(&allocator, 3) else Err(e):
        return
    var v = move made
    let a = v.push_mut(&allocator, 4)
    let bag = Bag(items: move v)
    for x in bag.evens():
        console.print_int(x)
    let Bag(items) = move bag
    items.close()
