// Taken apart, shortened and rebuilt: the rebuilt value's invariant is shown, and fails.
import console
import vec

sealed type Shelf:
    items: Vec<U64>
    room: U64
    invariant room <= 64
    invariant items.len() == room

impl Shelf:
    fn new(allocator: &Allocator, room: U64) -> Result<Shelf, U64>:
        requires room <= 64
        ensures true
        proof:
            auto
        let made: Result<Vec<U64>, U64> = Vec.filled(allocator, room, 7)
        let Ok(items): Vec<U64> = move made else Err(code):
            return Err(code)
        return Ok(Shelf(move items, room))

    fn close(shelf: Shelf):
        let Shelf(items, room) = move shelf
        items.close()

    // Taken apart and rebuilt with a shorter Vec: the rebuilt value's invariant is shown, and fails.
    fn rebuild(shelf: Shelf, allocator: &Allocator) -> Result<Shelf, U64>:
        ensures true
        proof:
            auto
        let Shelf(items, room) = move shelf
        var kept = move items
        let _ = kept.take_last_mut()
        return Ok(Shelf(move kept, room))

fn main(console: Console<Write>, allocator: Allocator):
    return
