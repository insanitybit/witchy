// Two kept element references into one Vec at once: the second is refused.
import console
import vec

sealed type Shelf:
    items: Vec<U64>
    room: U64
    invariant room <= 64
    invariant items.len() == room

impl Shelf:
    fn new(allocator: &Allocator, room: U64) -> Result<Shelf, U64>:
        requires room <= 64
        ensures true
        proof:
            auto
        let made: Result<Vec<U64>, U64> = Vec.filled(allocator, room, 7)
        let Ok(items): Vec<U64> = move made else Err(code):
            return Err(code)
        return Ok(Shelf(move items, room))

    fn close(shelf: Shelf):
        let Shelf(items, room) = move shelf
        items.close()

    // Two kept references into the same Vec at once: the borrow rules refuse the second.
    fn poke(shelf: &mut Shelf):
        ensures true
        proof:
            auto
        match (*shelf).items.at_mut(0):
            Ok(one):
                match (*shelf).items.at_mut(1):
                    Ok(two):
                        *two = 1
                    Err(code):
                        ()
                *one = 2
            Err(code):
                ()

fn main(console: Console<Write>, allocator: Allocator):
    return
