// Element writes that keep the length (a kept `at_mut`, `v[i] = x`, `set`, `swap`, `exchange`) keep the invariant over `items.len()`, and an `Err` that cannot happen is `unreachable`, proved.
import console
import vec

sealed type Shelf:
    items: Vec<U64>
    room: U64
    invariant room <= 64
    invariant items.len() == room

impl Shelf:
    fn new(allocator: &Allocator, room: U64) -> Result<Shelf, U64>:
        requires room <= 64
        ensures true
        proof:
            auto
        let made: Result<Vec<U64>, U64> = Vec.filled(allocator, room, 7)
        let Ok(items): Vec<U64> = move made else Err(code):
            return Err(code)
        return Ok(Shelf(move items, room))

    fn close(shelf: Shelf):
        let Shelf(items, room) = move shelf
        items.close()

    // Written through a kept element reference, and by `items[i] = x`, `set`, `swap` and
    // `exchange`: none changes the length, and each says so, so the invariant is shown.
    // `at` is below `room`, which is the length: the `Err` arms are never taken.
    fn poke(shelf: &mut Shelf, at: U64):
        ensures true
        proof:
            auto
        if at >= (*shelf).room:
            return
        match (*shelf).items.at_mut(at):
            Ok(slot):
                *slot = 3
            Err(code):
                unreachable
        (*shelf).items[at] = 40 + at
        let set: Result<(), U64> = (*shelf).items.set(at, 50 + at)
        match move set:
            Ok:
                ()
            Err(code):
                unreachable
        let _ = (*shelf).items.swap(0, at)
        let _ = (*shelf).items.exchange(0, at)

fn main(console: Console<Write>, allocator: Allocator):
    match Shelf.new(&allocator, 3):
        Ok(made):
            var shelf = move made
            shelf.poke(2)
            console.print_int(shelf.items[0] * 100 + shelf.items[2])
            shelf.close()
        Err(code):
            console.print_int(code)
