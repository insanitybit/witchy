import vec
import option

pub sealed type Bag:
    items: Vec<U64>
    held: Option<U64>
    spare: U64
    count: U64
    limit: U64
    invariant count <= limit
    invariant when None = held:
        count == 0

impl Bag:
    pub fn new(items: Vec<U64>) -> Bag:
        ensures result.count == 0
        return Bag(move items, None, 0, 0, 0)
