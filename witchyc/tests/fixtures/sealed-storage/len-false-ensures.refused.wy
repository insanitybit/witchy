// A callee that claims to keep the length and does not is refused by its own proof.
import console
import vec

sealed type Shelf:
    items: Vec<U64>
    room: U64
    invariant room <= 64
    invariant items.len() == room

impl Shelf:
    fn new(allocator: &Allocator, room: U64) -> Result<Shelf, U64>:
        requires room <= 64
        ensures true
        proof:
            auto
        let made: Result<Vec<U64>, U64> = Vec.filled(allocator, room, 7)
        let Ok(items): Vec<U64> = move made else Err(code):
            return Err(code)
        return Ok(Shelf(move items, room))

    fn close(shelf: Shelf):
        let Shelf(items, room) = move shelf
        items.close()

// A callee that grows the Vec and claims its length is unchanged: refused in the callee, by
// its own proof, so no caller ever relies on the claim.
fn grow(vector: &mut Vec<U64>, allocator: &Allocator, item: U64):
    ensures vector.len() == old(vector.len())
    proof:
        auto
    match vector.push_mut(allocator, item):
        Ok:
            ()
        Err(back):
            ()

impl Shelf:
    fn poke(shelf: &mut Shelf, allocator: &Allocator):
        ensures true
        proof:
            auto
        grow(&mut (*shelf).items, allocator, 4)

fn main(console: Console<Write>, allocator: Allocator):
    return
