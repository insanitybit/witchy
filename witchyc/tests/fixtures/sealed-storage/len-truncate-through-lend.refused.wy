// `truncate_mut` says nothing of the length: what is known of it is forgotten, and the invariant is not shown.
import console
import vec

sealed type Shelf:
    items: Vec<U64>
    room: U64
    invariant room <= 64
    invariant items.len() == room

impl Shelf:
    fn new(allocator: &Allocator, room: U64) -> Result<Shelf, U64>:
        requires room <= 64
        ensures true
        proof:
            auto
        let made: Result<Vec<U64>, U64> = Vec.filled(allocator, room, 7)
        let Ok(items): Vec<U64> = move made else Err(code):
            return Err(code)
        return Ok(Shelf(move items, room))

    fn close(shelf: Shelf):
        let Shelf(items, room) = move shelf
        items.close()

    fn cut(shelf: &mut Shelf):
        ensures true
        proof:
            auto
        (*shelf).items.truncate_mut(0)

fn main(console: Console<Write>, allocator: Allocator):
    return
