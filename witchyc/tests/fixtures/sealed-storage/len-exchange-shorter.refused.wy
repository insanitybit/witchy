// The whole Vec exchanged for a shorter one: what is known goes with each value, and the invariant fails.
import console
import vec

sealed type Shelf:
    items: Vec<U64>
    room: U64
    invariant room <= 64
    invariant items.len() == room

impl Shelf:
    fn new(allocator: &Allocator, room: U64) -> Result<Shelf, U64>:
        requires room <= 64
        ensures true
        proof:
            auto
        let made: Result<Vec<U64>, U64> = Vec.filled(allocator, room, 7)
        let Ok(items): Vec<U64> = move made else Err(code):
            return Err(code)
        return Ok(Shelf(move items, room))

    fn close(shelf: Shelf):
        let Shelf(items, room) = move shelf
        items.close()

    fn swap_in(shelf: &mut Shelf, allocator: &Allocator) -> Result<(), U64>:
        ensures true
        proof:
            auto
        let made: Result<Vec<U64>, U64> = Vec.filled(allocator, 1, 0)
        let Ok(other): Vec<U64> = move made else Err(code):
            return Err(code)
        var shorter = move other
        memory.exchange(&mut (*shelf).items, &mut shorter)
        shorter.close()
        return Ok(())

fn main(console: Console<Write>, allocator: Allocator):
    return
