// Refused by the proof: a field lent and kept is unknown from the lend on.
import console

type Pair:
    a: U64
    b: U64

fn poke(slot: &mut U64):
    *slot = 9

fn f(p: &mut Pair) -> U64:
    ensures result == 5
    (*p).a = 5
    let r = &mut (*p).a
    *r = 6
    return (*p).a

fn main(console: Console<Write>):
    console.print_int(1)
