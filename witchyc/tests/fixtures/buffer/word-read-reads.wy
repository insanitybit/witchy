// memory.read_word_unchecked: up to eight byte cells that hold values read as one word, proved;
// nothing changes.
fn read(buffer: &Buffer<U8>, at: U64, count: U64) -> U64:
    requires count <= 8
    requires at + count <= memory.capacity(buffer)
    requires memory.initialized_range(buffer, at, at + count)
    ensures true
    proof:
        auto
    return memory.read_word_unchecked(buffer, at, count)

fn main():
    return
