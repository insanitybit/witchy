// Refused: the cell past the run is unchanged, not filled.
fn fill<T>(buffer: &mut Buffer<T>, count: U64, item: T):
    requires count <= memory.capacity(buffer)
    requires memory.empty_range(buffer, 0, count)
    ensures memory.initialized_range(buffer, 0, count + 1)
    ensures memory.unchanged_from(buffer, old(buffer), count)
    proof:
        auto
    memory.fill_unchecked(buffer, count, item)
    return

fn main():
    return
