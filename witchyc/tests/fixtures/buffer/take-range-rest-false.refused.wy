// Refused: the cell past the run is unchanged, not emptied.
fn clear<T>(buffer: &mut Buffer<T>, count: U64):
    requires count < memory.capacity(buffer)
    requires memory.initialized_range(buffer, 0, count + 1)
    ensures memory.empty_range(buffer, 0, count + 1)
    proof:
        auto
    memory.take_prefix_unchecked(buffer, count)
    return

fn main():
    return
