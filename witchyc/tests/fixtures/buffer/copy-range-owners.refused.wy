// Refused: a copy of an element that holds an owner would be a second owner; a type parameter
// with `Any` may hold one, so only a plain `<T>` (elements without owners) is copied.
fn copy<T: Any>(source: &Buffer<T>, target: &mut Buffer<T>, count: U64):
    requires count <= memory.capacity(source)
    requires count <= memory.capacity(target)
    requires memory.initialized_range(source, 0, count)
    requires memory.empty_range(target, 0, count)
    ensures memory.initialized_range(target, 0, count)
    proof:
        auto
    memory.copy_into_unchecked(source, target, 0, count)
    return

fn main():
    return
