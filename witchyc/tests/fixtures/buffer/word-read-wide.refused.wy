// Refused: it reads bytes, so only from a Buffer<U8>.
// nothing changes.
fn read(buffer: &Buffer<U32>, at: U64, count: U64) -> U64:
    requires count <= 8
    requires at + count <= memory.capacity(buffer)
    requires memory.initialized_range(buffer, at, at + count)
    ensures true
    proof:
        auto
    return memory.read_word_unchecked(buffer, at, count)

