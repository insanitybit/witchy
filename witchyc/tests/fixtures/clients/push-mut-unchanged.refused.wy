// A successful push changes the length.
import "../../../library/wasm-vec.wy"

fn same(items: &mut Vec<U64>, allocator: &Allocator) -> Bool:
    ensures items.len() == old(items.len())
    proof:
        auto
    match items.push_mut(allocator, 1):
        Ok:
            return true
        Err(back):
            return false

fn main(console: Console<Write>):
    console.print_int(0)

