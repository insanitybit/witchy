// A caller must show the callee's `requires`.
fn abs(x: I64) -> I64:
    requires x > -9223372036854775808
    ensures result >= 0
    proof:
        auto
    if x < 0:
        return -x
    return x

fn run(x: I64) -> I64:
    return abs(x)

fn main(console: Console<Write>):
    console.print_int(I64.bits(run(-9)))
