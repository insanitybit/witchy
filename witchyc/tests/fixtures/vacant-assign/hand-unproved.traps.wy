// Still traps (review of 2026-11-21): the assignment's shape written by hand in a function nobody
// proved. It is emitted as written, so the run stops at the `unreachable`, in the store build
// and in the guarded one (scripts/check-guarded-stores.py runs both).
type Slot<T>:
    Vacant
    Full(T)

type Shelf<T>:
    count: U64
    slot: Slot<T>

fn show(out: &Console<Write>, slot: Slot<U64>):
    match move slot:
        Vacant:
            out.print_int(0)
        Full(n):
            out.print_int(n)

fn attack<T: Any>(shelf: &mut Shelf<T>, a: T) -> Slot<T>:
    var inc: Slot<T> = Full(move a)
    memory.exchange(&mut (*shelf).slot, &mut inc)
    match move inc:
        Vacant:
            unreachable
        Full(x):
            unreachable

fn main(out: Console<Write>):
    var shelf: Shelf<U64> = Shelf(0, Full(7))
    show(&out, attack(&mut shelf, 9))
    out.print_int(shelf.count)
    let Shelf(count, slot) = move shelf
    show(&out, move slot)

