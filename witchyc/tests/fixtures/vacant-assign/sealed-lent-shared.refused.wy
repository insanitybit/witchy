// Refused by the checker: the shelf is lent whole (`&*shelf`) while it is half repaired, its
// slot emptied and its count still 1. The callee would assume the invariant of it. A function
// that writes the fields of a `&mut` parameter whose type has an invariant uses that
// parameter only through its fields.
type Slot<T>:
    Vacant
    Full(T)

// A vacant shelf counts nothing: the two fields are linked.
sealed type Shelf<T>:
    count: U64
    slot: Slot<T>
    invariant when Vacant = slot:
        count == 0

impl<T: Any> Shelf<T>:
    // Relies on the invariant: on a vacant shelf a count other than 0 cannot be.
    nopanic fn audit(shelf: &Shelf<T>) -> U64:
        match &(*shelf).slot:
            Vacant:
                if (*shelf).count != 0:
                    unreachable
                return 0
            Full(_):
                return (*shelf).count

    nopanic fn touch(shelf: &mut Shelf<T>) -> U64:
        ensures true
        return 0

    nopanic fn swap_in(shelf: &mut Shelf<T>, item: T) -> Slot<T>:
        var held: Slot<T> = Vacant
        memory.exchange(&mut (*shelf).slot, &mut held)
        (*shelf).count = 1
        let seen = Shelf.audit(&*shelf)
        (*shelf).slot = Full(move item)
        return move held

fn main(out: Console<Write>):
    out.print_int(1)
