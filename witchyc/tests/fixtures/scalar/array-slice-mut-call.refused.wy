// Refused (review): a callee given a mutable slice of the array may change any element.
import console

fn fill(s: &mut [U64]):
    s[0] = 99

fn f() -> U64:
    ensures result == 1
    proof:
        auto
    var xs: [U64; 2] = [1, 2]
    fill(xs.slice_mut())
    return xs[0]

fn main(console: Console<Write>):
    console.print_int(f())
