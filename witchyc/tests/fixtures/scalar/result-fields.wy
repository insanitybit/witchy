// Clauses that read a field of the result, and Bool fields read as propositions.
type Pair:
    low: U64
    high: U64

type Checked:
    pair: Pair
    swapped: Bool

type Flag:
    on: Bool
    count: U64

fn order(a: U64, b: U64) -> Pair:
    ensures result.low <= result.high
    ensures result.low == a || result.low == b
    proof:
        auto
    if a < b:
        return Pair(a, b)
    return Pair(b, a)

// The record is built in a local and changed before it is returned.
fn order_noting(a: U64, b: U64) -> Checked:
    ensures result.pair.low <= result.pair.high
    ensures result.swapped == (b < a)
    proof:
        auto
    var made = Checked(Pair(a, b), false)
    if b < a:
        made.pair.low = b
        made.pair.high = a
        made.swapped = true
    return made

// A callee's result is handed on: its contract is what is known.
fn again(a: U64, b: U64) -> Pair:
    ensures result.low <= result.high
    proof:
        auto
    return order(b, a)

// The subtraction cannot go below zero, by what `order` ensures.
fn gap(a: U64, b: U64) -> U64:
    ensures result >= 0
    proof:
        auto
    let pair = order(a, b)
    return pair.high - pair.low

fn bump(flag: &mut Flag):
    requires flag.count < 10
    ensures flag.on
    ensures flag.count == old(flag.count) + 1
    proof:
        auto
    flag.on = true
    flag.count += 1

fn flip(flag: &mut Flag):
    ensures flag.on != old(flag.on)
    proof:
        auto
    flag.on = !flag.on

fn last(flag: &Flag) -> U64:
    requires flag.on && flag.count > 0
    ensures result < flag.count
    proof:
        auto
    return flag.count - 1

fn use_flag() -> U64:
    ensures result < 3
    proof:
        auto
    var flag = Flag(false, 2)
    bump(&mut flag)
    return last(&flag)

fn main(console: Console<Write>):
    console.print_int(order(9, 4).low)
    let noted = order_noting(9, 4)
    console.print_int(noted.pair.high)
    if noted.swapped:
        console.print_int(1)
    console.print_int(again(3, 8).high)
    console.print_int(gap(9, 4))
    var flag = Flag(true, 0)
    flip(&mut flag)
    if !flag.on:
        console.print_int(use_flag())
