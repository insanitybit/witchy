// The first return has the pair the wrong way round.
type Pair:
    low: U64
    high: U64

fn order(a: U64, b: U64) -> Pair:
    ensures result.low <= result.high
    proof:
        auto
    if a < b:
        return Pair(b, a)
    return Pair(b, a)

fn main(console: Console<Write>):
    console.print_int(order(9, 4).low)
