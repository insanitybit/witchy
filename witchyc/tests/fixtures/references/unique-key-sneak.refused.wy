// The rule rests on this: no `&mut` is made from a `&` argument.
type Pair:
    a: U64
    b: U64

fn pick(pair: &mut Pair, which: &U64) -> &mut U64:
    if *which == 0:
        return &mut (*pair).a
    return &mut (*pair).b

fn sneak(pair: &mut Pair, other: &Pair) -> &mut U64:
    return &mut (*other).a

fn main(console: Console<Write>):
    var pair = Pair(1, 2)
    var which: U64 = 1
    console.print_int(1)
