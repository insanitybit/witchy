// Lending one local with `&mut` keeps what is known of another.
import console

type Shape:
    Rect(U64, U64)
    Dot

type P:
    x: U64
    y: U64

fn f(x: U64) -> U64:
    requires x < 10
    ensures result < 10
    proof:
        auto
    var v = x
    var u = x
    let r = &mut v
    *r = 5000
    return u

fn main(console: Console<Write>):
    console.print_int(f(3))
