// A reference to an `A` cannot point into an argument of another type parameter, whatever
// the two stand for at the call: `k` is free while `seen` is in use.
type Pair:
    a: U64
    b: U64

trait Part:
    fn part(self: &Self) -> &U64

impl Part for Pair:
    fn part(self: &Pair) -> &U64:
        return &(*self).a

fn pick<A, B>(a: &A, b: &B) -> &A:
    return a

fn main(console: Console<Write>):
    var pair = Pair(1, 2)
    var n: U64 = 7
    var k: U64 = 8
    var flag = false
    let seen = pick(&n, &k)
    k = 1
    console.print_int(*seen + k)
