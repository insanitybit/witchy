// Two fields reborrowed through one `&mut` local stand side by side, as through a parameter.
import console

type P:
    x: U64
    y: U64

fn main(console: Console<Write>):
    var p = P(x: 1, y: 1)
    let r = &mut p
    let a = &mut (*r).x
    let b = &mut (*r).y
    *a += 1
    *b += 2
    console.print_int(p.x * 10 + p.y)
