// A `&mut [T]` scratch named by a clause: the decoded part borrows it, and the input is free.
import console
import vec

type Piece:
    Source(&[U64])
    Decoded(&[U64])

fn piece(input: &[U64], scratch: &mut [U64], i: U64) -> Piece:
    borrows Source from input
    borrows Decoded from scratch
    if input.len() > 0:
        scratch[i] = 7
        return Decoded(&*scratch)
    return Source(input)

fn run(console: &Console<Write>, sl: &mut [U64]):
    let a: [U64; 1] = [5]
    match piece(a.slice(), sl, 0):
        Source(t):
            console.print_int(t[0])
        Decoded(t):
            console.print_int(t[0])

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): Vec<U64> = Vec.filled(&allocator, 1, 1) else Err(code):
        return
    var v = move made
    run(&console, v.as_mut_slice())
    v.close()
