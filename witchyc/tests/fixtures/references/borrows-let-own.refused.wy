// Bound with `let`: the arm's own source stays lent.
import console
import "../modules/parts/choose.wy"

fn main(console: Console<Write>):
    var a: U64 = 1
    var b: U64 = 2
    let got = choose(&a, &b, a < b)
    match got:
        Ok(item):
            a = 3
            console.print_int(*item)
        Err(item):
            console.print_int(0)
            console.print_int(*item)
    console.print_int(a)
