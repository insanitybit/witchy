// The same inside a Result: the key is free in the arm that holds the `&mut`.
type Pair:
    a: U64
    b: U64

fn pick(pair: &mut Pair, which: &U64) -> &mut U64:
    if *which == 0:
        return &mut (*pair).a
    return &mut (*pair).b

fn find(pair: &mut Pair, which: &U64) -> Result<&mut U64, U64>:
    if *which == 0:
        return Ok(&mut (*pair).a)
    return Err(1)

fn main(console: Console<Write>):
    var pair = Pair(1, 2)
    var which: U64 = 1
    which = 0
    match find(&mut pair, &which):
        Ok(slot):
            which = 7
            *slot = which
        Err(code):
            ()
    console.print_int(pair.a)
