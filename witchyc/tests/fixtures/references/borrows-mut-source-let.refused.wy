// A result bound with `let` keeps every variant's loans: the scratch stays lent.
import console
import string

type Piece:
    Source(&String)
    Decoded(&String)

fn piece(input: &String, scratch: &mut String, allocator: &Allocator) -> Piece:
    borrows Source from input
    borrows Decoded from scratch
    if input.byte_len() > 3:
        let _ = scratch.push_text(allocator, "decoded")
        return Decoded(&*scratch)
    return Source(input)

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): String = String.new(&allocator) else Err(code):
        return
    var held = move made
    let _ = held.push_text(&allocator, "TEXT")
    let Ok(other): String = String.new(&allocator) else Err(code):
        held.close()
        return
    var space = move other
    let got = piece(&held, &mut space, &allocator)
    space.clear()
    match got:
        Source(text):
            console.write_string(text)
        Decoded(text):
            console.write_string(text)
    held.close()
    space.close()
