// A result that can also hold a `&` keeps the shared arguments lent.
type Pair:
    a: U64
    b: U64

fn pick(pair: &mut Pair, which: &U64) -> &mut U64:
    if *which == 0:
        return &mut (*pair).a
    return &mut (*pair).b

fn both(pair: &mut Pair, which: &U64) -> Result<&mut U64, &U64>:
    if *which == 0:
        return Ok(&mut (*pair).a)
    return Err(which)

fn main(console: Console<Write>):
    var pair = Pair(1, 2)
    var which: U64 = 1
    let got = both(&mut pair, &which)
    which = 4
    match got:
        Ok(slot):
            *slot = 1
        Err(seen):
            console.print_int(*seen)
