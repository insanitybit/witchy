// A type whose invariant speaks of the value in a cell may hand out a `&` reference to it.
sealed type Marked<T>:
    data: Buffer<T>
    length: U64
    capacity: U64
    mark: T
    invariant memory.prefix(data, length, capacity)
    invariant memory.cell(data, 0, mark)

impl<T> Marked<T>:
    fn slot(value: &Marked<T>) -> Result<&T, U64>:
        ensures value.length == old(value.length)
        proof:
            auto
        if 0 < (*value).length:
            return Ok(memory.ref_unchecked(&(*value).data, 0))
        return Err(1)

fn main(console: Console<Write>):
    console.print_int(1)
