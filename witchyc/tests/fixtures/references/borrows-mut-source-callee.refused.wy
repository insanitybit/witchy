// Inside the function, the scratch cannot change while a `&` into it is held.
import console
import string

type Piece:
    Source(&String)
    Decoded(&String)

fn piece(input: &String, scratch: &mut String, allocator: &Allocator) -> Piece:
    borrows Source from input
    borrows Decoded from scratch
    if input.byte_len() > 3:
        let _ = scratch.push_text(allocator, "decoded")
        let t = &*scratch
        scratch.clear()
        return Decoded(t)
    return Source(input)

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): String = String.new(&allocator) else Err(code):
        return
    var held = move made
    let _ = held.push_text(&allocator, "TEXT")
    let Ok(other): String = String.new(&allocator) else Err(code):
        held.close()
        return
    var space = move other
    match piece(&held, &mut space, &allocator):
        Source(text):
            space.clear()
            console.write_string(text)
            console.line("")
        Decoded(text):
            held.clear()
            console.write_string(text)
            console.line("")
    held.close()
    space.close()
