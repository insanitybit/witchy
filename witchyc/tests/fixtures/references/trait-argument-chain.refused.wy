// Refused: the same through two traits. `b.wrap()` gives a `&C` and `C: Leak<A>` gives an
// `&A`, so what a `&B` can lead to follows the bounds transitively.
import console
import vec
import string

trait Leak<X>:
    fn leak(self: &Self) -> &X

type Bag:
    items: Vec<String>

impl Leak<String> for Bag:
    fn leak(self: &Bag) -> &String:
        let items = &(*self).items
        match items.at(0):
            Ok(s):
                return s
            Err(c):
                unreachable

trait Wrap<Y>:
    fn wrap(self: &Self) -> &Y

type Outer:
    bag: Bag

impl Wrap<Bag> for Outer:
    fn wrap(self: &Outer) -> &Bag:
        return &(*self).bag

fn sneak<A: Any, C: Any + Leak<A>, B: Any + Wrap<C>>(b: &B, witness: &C) -> &A:
    let inner: &C = b.wrap()
    return inner.leak()

fn text(allocator: &Allocator, t: Text) -> String:
    let Ok(made): String = String.new(allocator) else Err(code):
        unreachable
    var s = move made
    if let Err(_) = s.push_text(allocator, t):
        unreachable
    return move s

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): Vec<String> = Vec.new(&allocator, 1) else Err(code):
        return
    var names = move made
    match names.push_mut(&allocator, text(&allocator, "victim")):
        Ok:
            console.print_int(1)
        Err(back):
            unreachable
    var bag = Outer(Bag(move names))
    let Ok(other_names): Vec<String> = Vec.new(&allocator, 1) else Err(code):
        unreachable
    let other = Bag(move other_names)
    let seen: &String = sneak(&bag, &other)
    console.print_int(seen.byte_len())
    let Outer(inner) = move bag
    let Bag(gone) = move inner
    gone.discard()
    let Bag(rest) = move other
    rest.discard()
    console.print_int(seen.byte_len())
