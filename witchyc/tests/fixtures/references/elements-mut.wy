// Change elements of a Vec where they are: a number, a String inside a Vec<String>,
// and a Vec inside a Vec.
import "../../../library/wasm-console.wy"
import "../../../library/wasm-string.wy"
import "../../../library/wasm-vec.wy"
import "../../../library/wasm-discard.wy"

fn text(allocator: &Allocator, value: Text) -> Result<String, U64>:
    var made = String.new(allocator)?
    if let Err(_) = made.push_text(allocator, value):
        made.close()
        return Err(1)
    return Ok(move made)

fn names(console: &Console<Write>, allocator: &Allocator) -> Result<(), U64>:
    var items: Vec<String> = Vec.new(allocator, 0)?
    for round in 0..3:
        let made = match text(allocator, "name"):
            Ok(made):
                move made
            Err(code):
                items.discard()
                return Err(code)
        match items.push_mut(allocator, move made):
            Ok:
                continue
            Err(back):
                back.close()
    // Append to the second String where it is.
    match items.at_mut(1):
        Ok(name):
            if let Err(_) = name.push_text(allocator, " changed"):
                console.line("no room")
        Err(code):
            console.print_int(code)
    match items.at_mut(3):
        Ok(name):
            console.line("an index past the end was accepted")
        Err(code):
            console.print_int(code)
    for index in 0..items.len():
        match items.at(index):
            Ok(name):
                console.write_string(name)
                console.line("")
            Err(code):
                console.print_int(code)
    items.discard()
    return Ok(())

fn main(console: Console<Write>, allocator: Allocator):
    let made: Result<Vec<U64>, U64> = Vec.new(&allocator, 0)
    var numbers = match move made:
        Ok(empty):
            move empty
        Err(code):
            return
    for step in 0..4:
        match numbers.push_mut(&allocator, step):
            Ok:
                continue
            Err(back):
                break
    for index in 0..numbers.len():
        match numbers.at_mut(index):
            Ok(item):
                *item = *item * 10 + 1
            Err(code):
                break
    for index in 0..numbers.len():
        match numbers.get(index):
            Ok(value):
                console.print_int(value)
            Err(code):
                break
    numbers.close()
    match names(&console, &allocator):
        Ok:
            console.line("done")
        Err(code):
            console.print_int(code)
