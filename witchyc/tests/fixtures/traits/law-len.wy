// A trait's `pure fn` may be read by its other methods' contracts: `get` requires
// `index < self.len()`. Generic code that asked `len` and did not change the value since meets it.
import console

trait Sized:
    pure fn len(self: &Self) -> U64
    fn get(self: &Self, index: U64) -> U64:
        requires index < self.len()
        ensures result >= index

type Few:
    count: U64
    value: U64

impl Sized for Few:
    pure fn len(self: &Few) -> U64:
        return self.count
    fn get(self: &Few, index: U64) -> U64:
        return index

fn last<T: Sized>(items: &T) -> U64:
    let n = items.len()
    if n == 0:
        return 0
    return items.get(n - 1)

fn main(console: Console<Write>):
    let few = Few(3, 10)
    console.print_int(last(&few))
