// Refused: an impl's trait arguments are types in reach, its own parameters aside.
import "../../../library/wasm-console.wy"

trait Holds<T>:
    fn count(self: &Self) -> U64

type Pair<T>:
    first: T
    second: T

impl<T> Holds<Nope> for Pair<T>:
    fn count(self: &Pair<T>) -> U64:
        return 2

fn main(console: Console<Write>):
    let pair: Pair<U64> = Pair(3, 4)
    console.print_int(pair.count())
