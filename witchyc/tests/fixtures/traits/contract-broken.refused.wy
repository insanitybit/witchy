// An implementation that does not keep its trait method's `ensures` is refused: its proof
// is of the trait's clauses.
import console

trait Score:
    fn score(self: &Self, cap: U64) -> U64:
        requires cap <= 1000
        ensures result <= cap

type Small:
    n: U64

impl Score for Small:
    fn score(self: &Small, cap: U64) -> U64:
        return self.n

fn total<T: Score>(a: &T, b: &T) -> U64:
    ensures result <= 2000
    proof:
        auto
    return a.score(1000) + b.score(1000)

fn main(console: Console<Write>):
    let little = Small(5)
    let big = Small(5000)
    console.print_int(total(&little, &big))
