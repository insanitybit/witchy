// Refused: a bound that gives the trait arguments is not met by an impl with type
// parameters of its own yet; the checker does not read its arguments per instance.
import "../../../library/wasm-console.wy"

trait Holds<T>:
    fn count(self: &Self) -> U64

type Pair<T>:
    first: T
    second: T

impl<T> Holds<T> for Pair<T>:
    fn count(self: &Pair<T>) -> U64:
        return 2

fn total<C: Holds<U64>>(holder: &C) -> U64:
    return holder.count()

fn main(console: Console<Write>):
    let pair: Pair<U64> = Pair(3, 4)
    console.print_int(total(&pair))
