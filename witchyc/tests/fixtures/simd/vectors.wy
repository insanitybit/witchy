import simd

fn main(console: Console<Write>):
    let a8 = U8x16(81985529216486895, 18364758544493064720)
    let b8 = U8x16(9756277979090767343, 72623861691331088)
    let wrapping_add8 = a8.wrapping_add(b8)
    console.print_int(wrapping_add8.low)
    console.print_int(wrapping_add8.high)
    let wrapping_sub8 = a8.wrapping_sub(b8)
    console.print_int(wrapping_sub8.low)
    console.print_int(wrapping_sub8.high)
    let wrapping_mul8 = a8.wrapping_mul(b8)
    console.print_int(wrapping_mul8.low)
    console.print_int(wrapping_mul8.high)
    let cmp_gt8 = a8.cmp_gt(b8)
    console.print_int(cmp_gt8.low)
    console.print_int(cmp_gt8.high)
    let cmp_eq8 = a8.cmp_eq(b8)
    console.print_int(cmp_eq8.low)
    console.print_int(cmp_eq8.high)
    let bit_and8 = a8.bit_and(b8)
    console.print_int(bit_and8.low)
    console.print_int(bit_and8.high)
    let bit_or8 = a8.bit_or(b8)
    console.print_int(bit_or8.low)
    console.print_int(bit_or8.high)
    let bit_xor8 = a8.bit_xor(b8)
    console.print_int(bit_xor8.low)
    console.print_int(bit_xor8.high)
    let min8 = a8.min(b8)
    console.print_int(min8.low)
    console.print_int(min8.high)
    let max8 = a8.max(b8)
    console.print_int(max8.low)
    console.print_int(max8.high)
    console.print_int(U8.to_u64(a8.reverse_lanes().lane(0)))
    console.print_int(U8.to_u64(a8.reduce_sum()))
    var dst8: [U8; 17] = [0; 17]
    a8.store(dst8.slice_mut(), 1)
    let loaded8 = U8x16.load(dst8.slice(), 1)
    console.print_int(loaded8.low)
    console.print_int(loaded8.high)
    console.print_int(a8.bitmask())
