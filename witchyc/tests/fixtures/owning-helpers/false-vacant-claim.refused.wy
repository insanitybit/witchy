// Refused where the helper is checked, by its proof: it says it leaves the slot vacant and
// writes a full one. A caller never sees the claim.
type Slot<T>:
    Vacant
    Full(T)

impl<T: Any> Slot<T>:
    // Empty the slot and hand back what was in it.
    pub nopanic fn drain(slot: &mut Slot<T>) -> Slot<T>:
        var previous: Slot<T> = Vacant
        memory.exchange(&mut *slot, &mut previous)
        return move previous

// A vacant shelf counts nothing: the two fields are linked.
sealed type Shelf<T>:
    count: U64
    slot: Slot<T>
    invariant when Vacant = slot:
        count == 0

nopanic fn stuff<T: Any>(slot: &mut Slot<T>, item: T) -> Slot<T>:
    ensures when Full = *slot:
        false
    var previous: Slot<T> = Full(move item)
    memory.exchange(&mut *slot, &mut previous)
    return move previous

impl<T: Any> Shelf<T>:
    // Relies on the invariant: on a vacant shelf a count other than 0 cannot be.
    nopanic fn audit(shelf: &Shelf<T>) -> U64:
        match &(*shelf).slot:
            Vacant:
                if (*shelf).count != 0:
                    unreachable
                return 0
            Full(_):
                return (*shelf).count

    nopanic fn swap_in(shelf: &mut Shelf<T>, a: T) -> Slot<T>:
        let held = stuff(&mut (*shelf).slot, move a)
        (*shelf).count = 1
        return move held

fn main(out: Console<Write>):
    out.print_int(1)

