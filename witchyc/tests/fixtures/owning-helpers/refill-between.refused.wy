// Refused by the proof: the slot was drained, but a later call is lent the slot and may refill
// it, so what was known of it is gone when the assignment comes.
type Slot<T>:
    Vacant
    Full(T)

impl<T: Any> Slot<T>:
    // Empty the slot and hand back what was in it.
    pub nopanic fn drain(slot: &mut Slot<T>) -> Slot<T>:
        var previous: Slot<T> = Vacant
        memory.exchange(&mut *slot, &mut previous)
        return move previous

// A vacant shelf counts nothing: the two fields are linked.
sealed type Shelf<T>:
    count: U64
    slot: Slot<T>
    invariant when Vacant = slot:
        count == 0

fn stock<T: Any>(slot: &mut Slot<T>, item: T) -> Slot<T>:
    var incoming: Slot<T> = Full(move item)
    if true:
        memory.exchange(&mut *slot, &mut incoming)
    return move incoming

type Both<T>:
    first: Slot<T>
    second: Slot<T>

impl<T: Any> Shelf<T>:
    // Relies on the invariant: on a vacant shelf a count other than 0 cannot be.
    nopanic fn audit(shelf: &Shelf<T>) -> U64:
        match &(*shelf).slot:
            Vacant:
                if (*shelf).count != 0:
                    unreachable
                return 0
            Full(_):
                return (*shelf).count

    nopanic fn swap_in(shelf: &mut Shelf<T>, a: T, b: T) -> Both<T>:
        let held = (*shelf).slot.drain()
        let other = stock(&mut (*shelf).slot, move a)
        (*shelf).count = 1
        (*shelf).slot = Full(move b)
        return Both(move held, move other)

fn main(out: Console<Write>):
    out.print_int(1)

