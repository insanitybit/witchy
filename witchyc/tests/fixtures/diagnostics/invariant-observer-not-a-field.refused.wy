// An invariant that reads a field through a method that is not a projection is refused at the invariant.
import console
import vec

impl U64:
    fn count_ones(value: &U64) -> U64:
        if *value == 0:
            return 0
        return 1

sealed type Shelf:
    items: Vec<U64>
    room: U64
    invariant room <= 64
    invariant items.len() == room
    invariant room.count_ones() <= 64

impl Shelf:
    fn new(allocator: &Allocator, room: U64) -> Result<Shelf, U64>:
        requires room <= 64
        ensures true
        proof:
            auto
        let made: Result<Vec<U64>, U64> = Vec.filled(allocator, room, 7)
        let Ok(items): Vec<U64> = move made else Err(code):
            return Err(code)
        return Ok(Shelf(move items, room))

    fn close(shelf: Shelf):
        let Shelf(items, room) = move shelf
        items.close()

fn main(console: Console<Write>, allocator: Allocator):
    return
