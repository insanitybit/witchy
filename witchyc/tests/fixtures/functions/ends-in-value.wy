// A function with a result may end in its value, through a last if/else or match; a proved
// function too.
import console

type Shape:
    Circle(U64)
    Square(U64)

fn add(a: U64, b: U64) -> U64:
    a + b

fn larger(a: U64, b: U64) -> U64:
    if a > b:
        a
    else:
        b

fn area(shape: Shape) -> U64:
    match shape:
        Circle(r):
            3 * r * r
        Square(s):
            s * s

fn size(n: U64) -> U64:
    match n:
        0:
            0
        1 | 2 | 3:
            1
        4..=100:
            2
        _:
            3

fn bounded(n: U64) -> U64:
    requires n < 1000
    ensures result <= 2000
    proof:
        auto
    n + n

fn main(console: Console<Write>):
    console.print_int(add(2, 3))
    console.print_int(larger(4, 9))
    console.print_int(area(Circle(2)) + area(Square(3)))
    console.print_int(size(50))
    console.print_int(bounded(999))
