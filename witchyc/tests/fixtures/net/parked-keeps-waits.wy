// Review round 32: a task parked by the 1024-report yield, or kept by cancel_all.
// A task waits on two timers (ALSO short, then long); between them it reports 1100 times.
// Expected: woken when the short timer fires (~100 ms). 
import console
import net
import tasks

fn waiter(clock: Clock) suspends:
    let start = clock.now_ms()
    let short = clock.timer(start + 100)
    let long = clock.timer(start + 2500)
    pause(ALSO + short)
    var i: U64 = 0
    while i < 1100:
        report(1)
        i += 1
    let woke = pause_for(long)
    let took = clock.now_ms() - start
    if took < 1000:
        report(7000000)
    else:
        report(9000000)
    clock.end_timer(short)
    clock.end_timer(long)

fn main(console: Console<Write>, listener: Listener, allocator: Allocator, clock: Clock):
    let Ok(made): Waiting = Waiting.new(&allocator, &listener) else Err(code):
        return
    var waiting = move made
    var reported: U64 = 0
    var finished: U64 = 0
    match Task.spawn(&allocator, 4096, waiter, clock.share()):
        Ok(task):
            match waiting.start(&allocator, move task):
                Ok(started):
                    reported += started.reported
                    finished += started.finished
                Err(back):
                    var lost = move back
                    let cancelled = lost.cancel()
                    lost.close()
        Err(input):
            reported += 0
    var rounds: U64 = 0
    while finished == 0 && rounds < 20:
        let stepped = waiting.step_ready(&allocator, &listener)
        reported += stepped.reported
        finished += stepped.finished
        rounds += 1
    console.print_int(reported)
    console.print_int(rounds)
    let cancelled = waiting.cancel_all(&allocator)
    waiting.close()
