// Cancel an exact read after two bytes arrived. The task reports the received prefix
// and closes its socket and buffer.
import console
import net
import tasks
import vec

type Reader:
    socket: Socket
    buffer: Vec<U8>

fn listen(reader: Reader) suspends:
    let Reader(socket, made) = move reader
    var buffer = move made
    match socket.read_exact_async(buffer.as_mut_slice()):
        Ok:
            report(100)
        Err(ReadFailed(failure)):
            if let Cancelled = failure.error:
                report(100 + failure.done)
            else:
                report(2)
        Err(UnexpectedEof(done)):
            report(3)
    socket.close()
    buffer.close()

fn main(console: Console<Write>, net: Net, listener: Listener, allocator: Allocator):
    let Ok(near): Socket = net.connect("127.0.0.1:47614") else Err(error):
        console.line("no connection")
        return
    let Ok(far): Socket = listener.accept() else Err(error):
        near.close()
        return
    let prefix: [U8; 2] = ['a', 'b']
    if let Err(reason) = near.write_all(prefix.slice()):
        near.close()
        far.close()
        return
    let zero: U8 = 0
    let Ok(buffer): Vec<U8> = Vec.filled(&allocator, 16, zero) else Err(code):
        near.close()
        far.close()
        return
    let Ok(made): Task = Task.spawn(&allocator, 2048, listen, Reader(move far, move buffer)) else Err(back):
        let Reader(socket, bytes) = move back
        socket.close()
        bytes.close()
        near.close()
        return
    var task = move made
    // The task waits for the rest of the slice.
    match task.step():
        Ok:
            console.line("finished early")
        Err(token):
            console.print_int(token % 4)
    match task.cancel():
        Ok(reported):
            console.print_int(reported)
        Err(token):
            console.line("still waiting")
    task.close()
    near.close()
