// Review round 32: a task parked by the 1024-report yield, or kept by cancel_all.
// `first` inside a Waiting task: a 100 ms sleeper, a 2500 ms sleeper, and a task that reports
// 1100 times and finishes. Expected: the 100 ms sleeper wins at ~100 ms.
import console
import net
import tasks
import vec

type Nap:
    clock: Clock
    ms: U64

fn sleeper(nap: Nap) suspends:
    let Nap(clock, ms) = move nap
    match clock.sleep(ms):
        Ok:
            report(1)
        Err(error):
            report(0)

fn chatty(nap: Nap) suspends:
    let Nap(clock, ms) = move nap
    var i: U64 = 0
    while i < 1100:
        report(0)
        i += 1
    match clock.sleep(ms):
        Ok:
            report(1)
        Err(error):
            report(0)

fn keep(tasks: &mut Vec<Task>, made: Result<Task, Nap>):
    match move made:
        Ok(task):
            match tasks.push_spare_mut(move task):
                Ok:
                    return
                Err(back):
                    back.close()
        Err(input):
            return

fn keep_n(tasks: &mut Vec<Task>, made: Result<Task, U64>):
    match move made:
        Ok(task):
            match tasks.push_spare_mut(move task):
                Ok:
                    return
                Err(back):
                    back.close()
        Err(input):
            return

type Parent:
    allocator: Allocator
    clock: Clock

fn parent(input: Parent) suspends:
    let Parent(allocator, clock) = move input
    let start = clock.now_ms()
    let Ok(made): Vec<Task> = Vec.new(&allocator, 3) else Err(code):
        return
    var tasks = move made
    keep(&mut tasks, Task.spawn(&allocator, 4096, sleeper, Nap(clock.share(), 100)))
    keep(&mut tasks, Task.spawn(&allocator, 4096, sleeper, Nap(clock.share(), 2500)))
    keep(&mut tasks, Task.spawn(&allocator, 4096, chatty, Nap(clock.share(), 4000)))
    match first(tasks.as_mut_slice()):
        Ok(winner):
            report(1000 + winner)
        Err(why):
            report(999)
    let took = clock.now_ms() - start
    if took < 1000:
        report(7000000)
    else:
        report(9000000)
    tasks.close_all()

fn main(console: Console<Write>, listener: Listener, allocator: Allocator, clock: Clock):
    let Ok(made): Waiting = Waiting.new(&allocator, &listener) else Err(code):
        return
    var waiting = move made
    var reported: U64 = 0
    var finished: U64 = 0
    match Task.spawn(&allocator, 16384, parent, Parent(allocator.share(), clock.share())):
        Ok(task):
            match waiting.start(&allocator, move task):
                Ok(started):
                    reported += started.reported
                    finished += started.finished
                Err(back):
                    var lost = move back
                    let cancelled = lost.cancel()
                    lost.close()
        Err(input):
            reported += 0
    var rounds: U64 = 0
    while finished == 0 && rounds < 20:
        let stepped = waiting.step_ready(&allocator, &listener)
        reported += stepped.reported
        finished += stepped.finished
        rounds += 1
    console.print_int(reported)
    console.print_int(rounds)
    let cancelled = waiting.cancel_all(&allocator)
    waiting.close()
