// A task that waits on two sockets at once: `both` joins a reader per connection, so it waits
// on both connections' entries (one handed on as ALSO) and `Waiting` steps it when either is
// ready. The program dials itself; what each reader received is reported, then printed.
import console
import net
import tasks
import vec


// A connection to drain, and a buffer to drain it into.
type Reader:
    socket: Socket
    buffer: Vec<U8>

// Reads until the other side finishes, and reports how much came.
fn drain(reader: Reader) suspends:
    let Reader(socket, made) = move reader
    var buffer = move made
    var total: U64 = 0
    var more = true
    while more:
        match socket.read(buffer.as_mut_slice()):
            Ok(count):
                if count == 0:
                    more = false
                total += count
            Err(error):
                more = false
    socket.close()
    buffer.close()
    report(total)

// A reader task for `socket`, or nothing (the socket closed) when there is no memory.
fn reader(allocator: &Allocator, socket: Socket) -> Result<Task, U64>:
    let zero: U8 = 0
    let Ok(buffer): Vec<U8> = Vec.filled(allocator, 64, zero) else Err(code):
        socket.close()
        return Err(code)
    match Task.spawn(allocator, 2048, drain, Reader(move socket, move buffer)):
        Ok(task):
            return Ok(move task)
        Err(back):
            let Reader(lost, bytes) = move back
            lost.close()
            bytes.close()
            return Err(1)

fn keep(tasks: &mut Vec<Task>, made: Result<Task, U64>):
    match move made:
        Ok(task):
            match tasks.push_spare_mut(move task):
                Ok:
                    return
                Err(back):
                    back.close()
        Err(code):
            return

fn close_tasks(tasks: Vec<Task>):
    var left = move tasks
    while left.len() > 0:
        match left.take_last_mut():
            Ok(task):
                task.close()
            Err(code):
                unreachable
    left.release_empty()

// Both connections at once: a reader task for each, made by `main` (a task cannot share
// main's allocator), joined.
fn both(readers: Vec<Task>) suspends:
    var tasks = move readers
    let joined = join(tasks.as_mut_slice())
    close_tasks(move tasks)

fn main(console: Console<Write>, net: Net, listener: Listener, allocator: Allocator):
    let Ok(one): Socket = net.connect("127.0.0.1:47613") else Err(error):
        console.line("no first connection")
        return
    let Ok(two): Socket = net.connect("127.0.0.1:47613") else Err(error):
        one.close()
        console.line("no second connection")
        return
    let Ok(first): Socket = listener.accept() else Err(error):
        one.close()
        two.close()
        return
    let Ok(second): Socket = listener.accept() else Err(error):
        first.close()
        one.close()
        two.close()
        return
    let Ok(made): Vec<Task> = Vec.new(&allocator, 2) else Err(code):
        first.close()
        second.close()
        one.close()
        two.close()
        return
    var readers = move made
    keep(&mut readers, reader(&allocator, move first))
    keep(&mut readers, reader(&allocator, move second))
    let Ok(waited): Waiting = Waiting.new(&allocator, &listener) else Err(code):
        close_tasks(move readers)
        one.close()
        two.close()
        return
    var waiting = move waited
    let Ok(task): Task = Task.spawn(&allocator, 4096, both, move readers) else Err(back):
        close_tasks(move back)
        one.close()
        two.close()
        waiting.close()
        return
    // Both readers wait; `both` waits on the two of them.
    var reported: U64 = 0
    var finished: U64 = 0
    match waiting.start(&allocator, move task):
        Ok(started):
            reported += started.reported
            finished += started.finished
        Err(back):
            back.close()
    console.print_int(waiting.len())
    // The second connection speaks first, then the first; each then finishes.
    match two.send("abc"):
        Ok:
            reported += 0
        Err(error):
            console.line("second send failed")
    two.close()
    // Rounds until the second reader has finished (one or two: a short read may be followed by
    // a "nothing yet" before the end shows); `both` then waits on the first alone.
    var rounds: U64 = 0
    while reported < 3 && rounds < 5:
        let round = waiting.step_ready(&allocator, &listener)
        reported += round.reported
        finished += round.finished
        rounds += 1
    console.print_int(reported)
    match one.send("hello"):
        Ok:
            reported += 0
        Err(error):
            console.line("first send failed")
    one.close()
    while finished == 0 && rounds < 20:
        let stepped = waiting.step_ready(&allocator, &listener)
        reported += stepped.reported
        finished += stepped.finished
        rounds += 1
    console.print_int(reported)
    console.print_int(finished)
    waiting.close()
