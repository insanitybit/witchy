// A task that keeps reporting yields after 1024 reports in one turn: `Waiting` parks it on an
// entry that reads ready at once, so other tasks are stepped before it goes on (a review of
// the concurrency semantics found one such task could hold every other one up).
import console
import net
import tasks

fn chatty(n: U64) suspends:
    var i: U64 = 0
    while i < n:
        report(1)
        i += 1

fn main(console: Console<Write>, listener: Listener, allocator: Allocator):
    let Ok(made): Waiting = Waiting.new(&allocator, &listener) else Err(code):
        return
    var waiting = move made
    var reported: U64 = 0
    var finished: U64 = 0
    match Task.spawn(&allocator, 1024, chatty, 1500):
        Ok(task):
            match waiting.start(&allocator, move task):
                Ok(started):
                    reported += started.reported
                    finished += started.finished
                Err(back):
                    var lost = move back
                    let cancelled = lost.cancel()
                    lost.close()
        Err(input):
            reported += 0
    // One turn's worth, and the task still there.
    console.print_int(reported)
    console.print_int(waiting.len())
    var rounds: U64 = 0
    while finished == 0 && rounds < 10:
        let stepped = waiting.step_ready(&allocator, &listener)
        reported += stepped.reported
        finished += stepped.finished
        rounds += 1
    console.print_int(reported)
    console.print_int(rounds)
    waiting.close()
