// A recipe builds its module's `Unit`, though the program declares a `Unit` of the same shape.
import "parts/recipe_shadow.wy"
import console

type Unit:
    v: U64

type T derive(recipe_shadow.Scaled):
    a: U64

fn main(console: Console<Write>):
    let t = T(a: 3)
    console.print("${t.scaled()}")
