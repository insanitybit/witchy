// Refused: a recipe calling a private method of a value of its `For` type (the recipe file's sealed
// `Token`): `t.set(v)` changed it (review round 3).
import "parts/for_private_methods.wy"
import console

type T derive(for_private_methods.Inst(for: for_private_methods.Token)):
    a: U64

fn main(console: Console<Write>):
    let t = T(a: 999)
    let tok = t.made(for_private_methods.mint())
    console.print("${for_private_methods.redeem(&tok)}")
