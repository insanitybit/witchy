pub sealed type Token:
    v: U64

pub fn mint() -> Token:
    return Token(v: 1)

pub fn redeem(t: &Token) -> U64:
    return t.v

trait Poke:
    fn poke(self: &mut Self)

impl Poke for Token:
    fn poke(self: &mut Token):
        self.v = 999

fn poke_it<X: Poke>(x: &mut X):
    x.poke()

pub trait Bump:
    fn bump(self: &mut Self)

pub derive Gen:
    impl Bump for Self:
        fn bump(self: &mut Self):
            static for f in fields:
                poke_it(&mut (*self).f)

pub derive Direct:
    impl Bump for Self:
        fn bump(self: &mut Self):
            static for f in fields:
                (*self).f.poke()
