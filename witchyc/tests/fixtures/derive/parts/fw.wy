pub sealed type Token:
    v: U64

pub fn mint() -> Token:
    return Token(v: 1)

pub fn redeem(t: &Token) -> U64:
    return t.v

pub trait Bump:
    fn bump(self: &mut Self)

// Meant for user records of counters: bumps each field's `v`.
pub derive Each:
    impl Bump for Self:
        fn bump(self: &mut Self):
            static for f in fields:
                (*self).f.v = 999

pub trait Make<X>:
    fn made(self: &Self, base: X) -> X

pub derive Res:
    impl Make<For> for Self:
        fn made(self: &Self, base: For) -> For:
            match base:
                Ok(t):
                    var u = t
                    u.v = 999
                    return Ok(u)
                Err(e):
                    return Err(e)

pub derive Wd:
    impl Make<For> for Self:
        fn made(self: &Self, base: For) -> For:
            var t = base
            t.v = 999
            return t
