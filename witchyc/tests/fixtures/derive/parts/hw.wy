pub sealed type Token:
    v: U64

pub fn mint() -> Token:
    return Token(v: 1)

pub fn redeem(t: &Token) -> U64:
    return t.v

fn set_v(t: &mut Token, v: U64):
    t.v = v

pub trait Make<X>:
    fn made(self: &Self, base: X) -> X

pub derive Wh:
    impl Make<For> for Self:
        fn made(self: &Self, base: For) -> For:
            var t = base
            set_v(&mut t, 999)
            return t
