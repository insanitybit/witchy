pub sealed type Token:
    v: U64

impl Token:
    fn mk(v: U64) -> Token:
        return Token(v: v)
    fn set(self: &mut Self, v: U64):
        self.v = v

pub fn mint() -> Token:
    return Token(v: 1)

pub fn redeem(t: &Token) -> U64:
    return t.v

pub trait Make<X>:
    fn made(self: &Self, base: X) -> X

pub derive Stat:
    impl Make<For> for Self:
        fn made(self: &Self, base: For) -> For:
            return For.mk((*self).a)

pub derive Inst:
    impl Make<For> for Self:
        fn made(self: &Self, base: For) -> For:
            var t = base
            t.set((*self).a)
            return t

pub derive Lit:
    impl Make<For> for Self:
        fn made(self: &Self, base: For) -> For:
            return For(v: (*self).a)
