pub sealed type Token:
    v: U64

pub fn mint() -> Token:
    return Token(v: 1)

pub fn redeem(t: &Token) -> U64:
    return t.v

pub trait Make<X>:
    fn made(self: &Self, base: X) -> X

pub derive Wr:
    impl Make<For> for Self:
        fn made(self: &Self, base: For) -> For:
            var t = base
            t.v = (*self).a
            return t

pub trait Peek:
    fn peek(self: &Self) -> U64

pub derive Interp:
    impl Peek for Self:
        fn peek(self: &Self) -> U64:
            console_free_print("${redeem(&For(v: (*self).a))}")
            return 0

fn console_free_print(t: Text):
    return
