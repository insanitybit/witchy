// An exchange operand reached through a computed index can trap (review 2026-11-21).
nopanic fn f(n: U64) -> U64:
    var arr: [U64; 3] = [1, 2, 3]
    var x: U64 = 9
    memory.exchange(&mut arr[n], &mut x)
    return x

fn main(out: Console<Write>):
    out.print_int(f(1))
    out.print_int(f(5))
