// Over an array of records, `for` gives a reference: fields read through it, `*p` copies it.
import console
import vec

type P:
    x: U64

fn main(console: Console<Write>, allocator: Allocator):
    for p in [P(x: 2), P(x: 5)]:
        console.print_int(p.x)
    let Ok(made): Vec<P> = Vec.new(&allocator, 4) else Err(code):
        return
    var ps = move made
    for p in [P(x: 7), P(x: 8)]:
        match ps.push_mut(&allocator, *p):
            Ok:
                ()
            Err(back):
                ()
    console.print_int(ps.len())
    ps.close()
