// Refused: a public function that may pause and does not say so.
import console

trait Read:
    fn byte(self: &mut Self) -> U64 suspends

type Memory:
    at: U64

type Remote:
    at: U64

impl Read for Memory:
    fn byte(self: &mut Memory) -> U64:
        (*self).at += 1
        return (*self).at

fn wait_for_data(at: U64) -> U64 suspends:
    return at + 100

impl Read for Remote:
    fn byte(self: &mut Remote) -> U64:
        (*self).at += 1
        return wait_for_data((*self).at)


pub fn fetch(at: U64) -> U64:
    return wait_for_data(at)

fn main(console: Console<Write>):
    console.print_int(fetch(1))
