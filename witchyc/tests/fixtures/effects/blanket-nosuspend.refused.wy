// Refused, for the right reason (adversarial review round 24 found it refused for the wrong
// one): the blanket impl of Tick pauses, so `Memory` cannot be a `nosuspend` Tick.
import console
trait Read:
    fn byte(self: &mut Self) -> U64 suspends
type Memory:
    at: U64
type Remote:
    at: U64
impl Read for Memory:
    fn byte(self: &mut Memory) -> U64:
        (*self).at += 1
        return (*self).at
fn wait_for_data(at: U64) -> U64 suspends:
    return at + 100
impl Read for Remote:
    fn byte(self: &mut Remote) -> U64:
        (*self).at += 1
        return wait_for_data((*self).at)

trait Tick:
    fn tick(self: &Self) -> U64 suspends
impl<T: Any> Tick for T:
    fn tick(self: &T) -> U64:
        return wait_for_data(1)
fn quiet<T: Tick nosuspend>(t: &T) -> U64:
    return t.tick()
fn main(console: Console<Write>):
    let m = Memory(0)
    console.print_int(quiet(&m))
