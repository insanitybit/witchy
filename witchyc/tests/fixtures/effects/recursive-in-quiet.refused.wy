// Refused: a recursive function that may pause on its way down (a fixed point, not one level).
import console

trait Read:
    fn byte(self: &mut Self) -> U64 suspends

type Memory:
    at: U64

type Remote:
    at: U64

impl Read for Memory:
    fn byte(self: &mut Memory) -> U64:
        (*self).at += 1
        return (*self).at

fn wait_for_data(at: U64) -> U64 suspends:
    return at + 100

impl Read for Remote:
    fn byte(self: &mut Remote) -> U64:
        (*self).at += 1
        return wait_for_data((*self).at)


fn down(n: U64) -> U64:
    if n == 0:
        return wait_for_data(0)
    return down(n - 1)

fn main(console: Console<Write>):
    nosuspend:
        console.print_int(down(3))
