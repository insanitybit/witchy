// Refused: a closure whose body may pause, called inside `nosuspend:` (through a generic function).
import console

trait Read:
    fn byte(self: &mut Self) -> U64 suspends

type Memory:
    at: U64

type Remote:
    at: U64

impl Read for Memory:
    fn byte(self: &mut Memory) -> U64:
        (*self).at += 1
        return (*self).at

fn wait_for_data(at: U64) -> U64 suspends:
    return at + 100

impl Read for Remote:
    fn byte(self: &mut Remote) -> U64:
        (*self).at += 1
        return wait_for_data((*self).at)


fn apply(f: fn(U64) -> U64, value: U64) -> U64:
    return f(value)

fn main(console: Console<Write>):
    nosuspend:
        console.print_int(apply(fn(n: U64) -> U64: wait_for_data(n), 1))
