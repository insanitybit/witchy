fn copy_second(target: &mut Buffer<U8>, source: &Buffer<U8>, byte: U8):
    requires 0 < memory.capacity(target)
    requires 1 < memory.capacity(source)
    requires memory.empty_range(target, 0, 1)
    requires memory.initialized_range(source, 0, 2)
    requires memory.cell(source, 1, byte)
    ensures memory.cell(target, 0, byte)
    proof:
        auto
    let view = memory.slice_unchecked(source, 0, 2)
    let second = view.part(0, 1)
    memory.init_slice_unchecked(target, 0, second)

fn main():
    return
