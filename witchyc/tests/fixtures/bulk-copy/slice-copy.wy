// `target.copy_from(source)`: the source's elements over a unique slice's, a word at a time and
// then a byte at a time. Every length from 0 to 20 at every start from 0 to 3, for bytes; the
// bytes before and after the part written keep their values. Then U16, U32, U64 and I64.
import console

fn check(console: &Console<Write>, from: U64, count: U64) -> U64:
    var target: [U8; 32] = [0; 32]
    var source: [U8; 32] = [0; 32]
    for i in 0..32:
        target[i] = U8.truncate(200 + i)
        source[i] = U8.truncate(i * 7 + 3)
    target.slice_mut().part(from, from + count).copy_from(source.slice().part(1, 1 + count))
    var wrong: U64 = 0
    for i in 0..32:
        var want = U8.truncate(200 + i)
        if i >= from && i < from + count:
            want = U8.truncate((i - from + 1) * 7 + 3)
        if target[i] != want:
            wrong += 1
    return wrong

fn main(console: Console<Write>):
    var wrong: U64 = 0
    var cases: U64 = 0
    for from in 0..4:
        for count in 0..21:
            wrong += check(&console, from, count)
            cases += 1
    console.print_int(cases)
    console.print_int(wrong)
    var a: [U16; 5] = [1, 2, 3, 4, 5]
    let b: [U16; 5] = [65535, 300, 7, 0, 9]
    a.slice_mut().copy_from(b.slice())
    console.print_int(U16.to_u64(a[0]) + U16.to_u64(a[1]) + U16.to_u64(a[4]))
    var c: [U32; 3] = [1, 2, 3]
    let d: [U32; 3] = [4294967295, 5, 6]
    c.slice_mut().part(0, 2).copy_from(d.slice().part(1, 3))
    console.print_int(U32.to_u64(c[0]) * 100 + U32.to_u64(c[1]) * 10 + U32.to_u64(c[2]))
    var e: [U64; 3] = [1, 2, 3]
    let f: [U64; 3] = [18446744073709551615, 5, 6]
    e.slice_mut().copy_from(f.slice())
    console.print_int(e[0])
    console.print_int(e[1] + e[2])
    // Nothing to copy: both empty.
    e.slice_mut().part(3, 3).copy_from(f.slice().part(0, 0))
    console.print_int(e[2])
