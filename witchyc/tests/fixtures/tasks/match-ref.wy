// A match through a reference whose arm changes the variant, then pauses: going back in
// takes the arm that was taken (adversarial review round 26: it took the new variant's arm,
// skipped everything and finished silently).
import console
import tasks
type State:
    Idle
    Busy(U64)

fn advance(state: &mut State, n: U64)  suspends:
    *state = Busy(n)
    pause(n)

fn drive(console: &Console<Write>, state: &mut State)  suspends:
    match state:
        Idle:
            advance(state, 7)
            console.print_int(1)
        Busy(n):
            console.print_int(*n)
    console.print_int(2)

fn run(console: &Console<Write>, allocator: &Allocator)  suspends:
    var s = Idle
    drive(console, &mut s)
    drive(console, &mut s)

type TaskEnvZ:
    console: Console<Write>
    allocator: Allocator

fn work(env: TaskEnvZ) suspends:
    run(&env.console, &env.allocator)

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): Task = Task.spawn(&allocator, 4096, work, TaskEnvZ(move console, move allocator)) else Err(back):
        return
    var task = move made
    var going = true
    while going:
        match task.step():
            Ok:
                going = false
            Err(token):
                going = true
    task.close()
