// `first` races tasks: the first to finish wins and the others are cancelled, each winding
// down through its own code (reporting 100 + its number here); those after the winner are
// told in its round, those before it in the next. Printed: a wait as itself,
// ALSO e as 1000 + e, a report v as 2000 + v.
import console
import tasks
import vec

fn slow(n: U64) suspends:
    var k: U64 = 0
    while k < n:
        if pause_for(n * 256 + 1) == CANCELLED:
            report(100 + n)
            return
        k += 1
    report(n)

fn close_tasks(tasks: Vec<Task>):
    var left = move tasks
    while left.len() > 0:
        match left.take_last_mut():
            Ok(task):
                task.close()
            Err(code):
                unreachable
    left.release_empty()

fn keep(tasks: &mut Vec<Task>, made: Result<Task, U64>):
    match move made:
        Ok(task):
            match tasks.push_spare_mut(move task):
                Ok:
                    return
                Err(back):
                    back.close()
        Err(input):
            return

fn parent(allocator: Allocator) suspends:
    let Ok(made): Vec<Task> = Vec.new(&allocator, 3) else Err(code):
        return
    var tasks = move made
    keep(&mut tasks, Task.spawn(&allocator, 1024, slow, 3))
    keep(&mut tasks, Task.spawn(&allocator, 1024, slow, 1))
    keep(&mut tasks, Task.spawn(&allocator, 1024, slow, 2))
    match first(tasks.as_mut_slice()):
        Ok(winner):
            report(50 + winner)
        Err(why):
            report(99)
    close_tasks(move tasks)

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): Task = Task.spawn(&allocator, 4096, parent, move allocator) else Err(given):
        return
    var task = move made
    var going = true
    while going:
        match task.step():
            Ok:
                going = false
            Err(token):
                if token >= REPORTED:
                    console.print_int(2000 + token - REPORTED)
                else:
                    if token >= ALSO:
                        console.print_int(1000 + token - ALSO)
                    else:
                        console.print_int(token)
    task.close()
