type ReadPair:
    byte: U8
    word: U64

fn sparse<T>(allocator: &Allocator, item: T) -> Result<Vec<T>, U64>:
    let allocation: Result<Buffer<T>, U64> = memory.try_alloc(allocator, 3)
    match move allocation:
        Ok(input):
            var buffer = move input
            memory.init(&mut buffer, 1, item)
            return Ok(Vec(move buffer, 3, 3))
        Err(code):
            return Err(code)

fn main(console: Console<Write>, allocator: Allocator):
    let byte: U8 = 7
    match sparse(&allocator, byte):
        Ok(input):
            var vector = move input
            match vec_get(&vector, 1):
                Ok(value):
                    console.print_int(U8.to_u64(value))
                Err(code):
                    console.print_int(101)
            match vec_get(&vector, 0):
                Ok(value):
                    console.print_int(102)
                Err(code):
                    console.print_int(10)
            match vec_get(&vector, 3):
                Ok(value):
                    console.print_int(103)
                Err(code):
                    console.print_int(11)
            match vec_get(&vector, 18446744073709551615):
                Ok(value):
                    console.print_int(104)
                Err(code):
                    console.print_int(12)
            vector.length = 99
            vector.capacity = 99
            match vec_get(&vector, 4):
                Ok(value):
                    console.print_int(105)
                Err(code):
                    console.print_int(13)
            match vec_get(&vector, 2):
                Ok(value):
                    console.print_int(106)
                Err(code):
                    console.print_int(14)
            vec_close(move vector)
        Err(code):
            console.print_int(107)
    let word: U64 = 18446744073709551615
    match sparse(&allocator, word):
        Ok(vector):
            match vec_get(&vector, 1):
                Ok(value):
                    console.print_int(value)
                Err(code):
                    console.print_int(108)
            vec_close(move vector)
        Err(code):
            console.print_int(109)
    match sparse(&allocator, true):
        Ok(vector):
            match vec_get(&vector, 1):
                Ok(value):
                    if value:
                        console.print_int(1)
                    else:
                        console.print_int(110)
                Err(code):
                    console.print_int(111)
            vec_close(move vector)
        Err(code):
            console.print_int(112)
    let pair_byte: U8 = 9
    let pair_word: U64 = 4294967296
    match sparse(&allocator, ReadPair(pair_byte, pair_word)):
        Ok(vector):
            match vec_get(&vector, 1):
                Ok(value):
                    console.print_int(U8.to_u64(value.byte))
                    console.print_int(value.word)
                Err(code):
                    console.print_int(113)
            vec_close(move vector)
        Err(code):
            console.print_int(114)
    let empty: Result<Vec<U8>, U64> = vec_new(&allocator, 0)
    match move empty:
        Ok(vector):
            match vec_get(&vector, 0):
                Ok(value):
                    console.print_int(115)
                Err(code):
                    console.print_int(15)
            vec_close(move vector)
        Err(code):
            console.print_int(116)
    let failure: Result<Vec<U8>, U64> = vec_new(&allocator, 18446744073709551615)
    match move failure:
        Ok(vector):
            console.print_int(117)
            vec_close(move vector)
        Err(code):
            console.print_int(16)
