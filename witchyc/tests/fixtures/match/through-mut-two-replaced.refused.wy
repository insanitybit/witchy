// Refused: the whole value is replaced while a name into it is still in use.
import console

type Shape:
    Rect(U64, U64)
    Dot

fn grow(s: &mut Shape):
    match s:
        Rect(w, h):
            *s = Dot
            *w += 1
            *h += 2
        Dot:
            return

fn main(console: Console<Write>):
    var s = Rect(1, 1)
    grow(&mut s)
    match s:
        Rect(w, h):
            console.print_int(w * 10 + h)
        Dot:
            console.print_int(0)
