// The sum is replaced while `left` still refers into the variant it had.
import "../../../library/wasm-console.wy"

type Light:
    Red
    Green(U64)

type Shape:
    Circle(U64)
    Rect(U64, U64)

fn step(light: &mut Light):
    match light:
        Red:
            return
        Green(left):
            *light = Red
            *left = 5

fn main(console: Console<Write>):
    var light = Green(3)
    step(&mut light)
    match light:
        Red:
            console.print_int(0)
        Green(left):
            console.print_int(left)
