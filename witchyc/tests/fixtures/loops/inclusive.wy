// `for i in a..=b:` includes `b`, stops by comparing with `b` (never `b + 1`), so a range that
// ends at the largest U64 ends; an empty range runs nothing; `continue` and `break` work.
import console

fn main(console: Console<Write>):
    var sum: U64 = 0
    for i in 1..=10:
        sum += i
    console.print_int(sum)
    var empty: U64 = 0
    for i in 5..=3:
        empty += 1
    console.print_int(empty)
    for i in 3..=3:
        console.print_int(i)
    for i in 18446744073709551613..=18446744073709551615:
        console.print_int(i)
    var odd: U64 = 0
    for i in 0..=20:
        if i % 2 == 0:
            continue
        if i > 15:
            break
        odd += i
    console.print_int(odd)
