// `for (a, b) in` takes each value apart (a tuple walked by reference is read); `.enumerate()`
// gives each item's index, and `continue` does not skip the count.
import console
import vec

fn main(console: Console<Write>, allocator: Allocator):
    let Ok(made): Vec<U64> = Vec.new(&allocator, 3) else Err(e):
        return
    var v = move made
    let one = v.push_mut(&allocator, 5)
    let two = v.push_mut(&allocator, 7)
    for (i, x) in v.enumerate():
        console.print_int(i * 100 + *x)
    for (i, x) in v.enumerate():
        if i == 0:
            continue
        console.print_int(*x)
    v.close()
