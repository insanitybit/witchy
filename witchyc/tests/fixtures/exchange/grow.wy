// Containers that grow where they are: a Vec and a HashMap behind `&mut`.
import "../../../library/wasm-hashmap.wy"
import "../../../library/wasm-vec.wy"

fn fill(items: &mut Vec<U64>, allocator: &Allocator, count: U64) -> Bool:
    for index in 0..count:
        match items.push_mut(allocator, index * index):
            Ok:
                continue
            Err(back):
                return false
    return true

fn main(console: Console<Write>, allocator: Allocator):
    let made: Result<Vec<U64>, U64> = Vec.new(&allocator, 0)
    match move made:
        Ok(empty):
            var items = move empty
            if fill(&mut items, &allocator, 100):
                console.print_int(items.len())
                console.print_int(items.capacity())
                match items.get(99):
                    Ok(last):
                        console.print_int(last)
                    Err(code):
                        console.print_int(900)
            items.close()
        Err(code):
            console.print_int(code)
    let table: Result<HashMap<U64, U64>, U64> = HashMap.new(&allocator, 0)
    match move table:
        Ok(empty):
            var map = move empty
            var stored: U64 = 0
            for key in 0..50:
                match map.put(&allocator, key * 7, key):
                    Ok:
                        stored += 1
                    Err(back):
                        back.discard()
            console.print_int(stored)
            console.print_int(map.len())
            match map.get(&343):
                Ok(value):
                    console.print_int(*value)
                Err(code):
                    console.print_int(901)
            match map.put(&allocator, 343, 1):
                Ok:
                    console.print_int(902)
                Err(back):
                    console.print_int(back.value)
            map.discard()
        Err(code):
            console.print_int(code)
