// Not yet inside a function whose contract speaks of memory.
type Held<T>:
    data: Buffer<T>
    length: U64

fn trade<T: Any>(held: &mut Held<T>, count: U64):
    ensures memory.same_allocation(held.data, old(held.data))
    proof:
        auto
    var other = count
    memory.exchange(&mut (*held).length, &mut other)

fn main(console: Console<Write>):
    console.print_int(0)
