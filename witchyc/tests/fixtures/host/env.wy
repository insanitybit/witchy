// An environment variable is read through the `Env` capability, and only the names the
// run grants exist. `HOME` is set in the caller's environment but not granted here.
import console
import env

fn show(console: &Console<Write>, env: &Env, allocator: &Allocator, name: Text):
    match env.get(allocator, name):
        Ok(value):
            console.write_string(&value)
            console.line("")
            value.close()
        Err(error):
            console.line("missing")

fn main(console: Console<Write>, env: Env, allocator: Allocator):
    show(&console, &env, &allocator, "GREETING")
    show(&console, &env, &allocator, "HOME")
    show(&console, &env, &allocator, "EMPTY")
