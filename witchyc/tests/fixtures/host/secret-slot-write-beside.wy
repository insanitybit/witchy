// Beside the sealed key's source file, in the same granted directory, the program writes,
// renames and removes its own files and moves a directory that does not hold the key.
import console
import fs
import secret

fn say(console: &Console<Write>, done: Result<(), FsError>):
    match done:
        Ok:
            console.line("ok")
        Err(e):
            console.line("refused")

fn put(dir: &Dir<Write>, path: Text, text: Text) -> Result<(), FsError>:
    let file = dir.create(path)?
    match file.write(text):
        Ok:
            return file.finish()
        Err(e):
            file.abandon()
            return Err(e)

fn main(key: Secret<Seal>, console: Console<Write>, files: Dir<Write>, allocator: Allocator):
    say(&console, put(&files, "notes", "n"))
    say(&console, files.rename("notes", "kept"))
    say(&console, put(&files, "kept", "again"))
    say(&console, files.make_dir("box"))
    say(&console, put(&files, "box/a", "a"))
    say(&console, files.rename("box", "crate"))
    say(&console, files.remove("kept"))
    match key.sign(&allocator, "x"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
