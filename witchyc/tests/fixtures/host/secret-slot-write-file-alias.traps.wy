// Stopped before `main` runs: the file granted to write is a hard link to the sealed key's
// source file. Writing would replace the key where its deployment keeps it.
import console
import fs
import secret

fn main(key: Secret<Seal>, console: Console<Write>, out: File<Write>, allocator: Allocator):
    match out.write("replaced"):
        Ok:
            if out.finish().is_ok():
                console.line("written")
        Err(error):
            out.abandon()
    match key.sign(&allocator, "x"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
