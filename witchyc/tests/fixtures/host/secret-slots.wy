// Fixed secrets as `main`'s parameters, each bound by its name (docs/wasm-capabilities.md,
// "Fixed secrets"). `beta` comes first here and last in the flags, `alpha` the other way
// round: each signs with its own key. The keys and messages are published HMAC-SHA-256
// vectors (RFC 4231 case 2; the "quick brown fox" one). `token` reads its bytes exactly.
import console
import secret

fn endorse(console: &Console<Write>, allocator: &Allocator, key: &Secret<Seal>, message: Text):
    match key.sign(allocator, message):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")

fn main(beta: Secret<Seal>, console: Console<Write>, allocator: Allocator, token: Secret<Reveal>, alpha: Secret<Seal>):
    endorse(&console, &allocator, &alpha, "what do ya want for nothing?")
    endorse(&console, &allocator, &beta, "The quick brown fox jumps over the lazy dog")
    match token.reveal_bytes(&allocator):
        Ok(bytes):
            console.print_int(bytes.len())
            var index: U64 = 0
            while index < bytes.len():
                match bytes.get(index):
                    Ok(byte):
                        console.print_int(U8.to_u64(byte))
                    Err(e):
                        console.line("short")
                index += 1
            bytes.close()
        Err(e):
            console.line("unreadable")
    // Not UTF-8: as text it is refused, not changed.
    match token.reveal(&allocator):
        Ok(text):
            console.line("text")
            text.close()
        Err(NotText):
            console.line("not text")
        Err(_):
            console.line("unreadable")
