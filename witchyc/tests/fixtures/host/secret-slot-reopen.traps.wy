// Stopped before `main` runs: the reveal slot's descriptor is a second open of the sealed key's
// own file, which would read the key back through `token.reveal` (review of 33face12). One
// source, one route: two slots are never the same file or pipe.
import console
import secret

fn main(key: Secret<Seal>, token: Secret<Reveal>, console: Console<Write>, allocator: Allocator):
    match token.reveal(&allocator):
        Ok(text):
            console.write_string(&text)
            console.line("")
            text.close()
        Err(e):
            console.line("unreadable")
    match key.sign(&allocator, "x"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
