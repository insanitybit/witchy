// Stops when the program renames a directory that holds the sealed key's source file:
// the directory is looked through, without following a link, before it moves.
import console
import fs
import secret

fn say(console: &Console<Write>, done: Result<(), FsError>):
    match done:
        Ok:
            console.line("ok")
        Err(e):
            console.line("refused")

fn put(dir: &Dir<Write>, path: Text, text: Text) -> Result<(), FsError>:
    let file = dir.create(path)?
    match file.write(text):
        Ok:
            return file.finish()
        Err(e):
            file.abandon()
            return Err(e)

fn main(key: Secret<Seal>, console: Console<Write>, files: Dir<Write>, allocator: Allocator):
    say(&console, files.rename("keys", "old"))
    say(&console, files.make_dir("keys"))
    say(&console, put(&files, "keys/key", "attacker-key"))
    match key.sign(&allocator, "x"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
