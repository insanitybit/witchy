// Refused: a function given only `Secret<Seal>` has no way to read the key.
import secret
fn leak(key: &Secret<Seal>, allocator: &Allocator) -> U64:
    match key.reveal(allocator):
        Ok(text):
            let n = text.byte_len()
            text.close()
            return n
        Err(e):
            return 0
fn main(secrets: SecretStore):
    return
