// A program the module starts through `Exec` finds none of the run's secrets
// (docs/wasm-capabilities.md, "Fixed secrets"). The engine read `key` from its environment and
// `token` from a descriptor, and was started with one more descriptor no flag names. The child
// (secret-exec-bin/inspect) counts the descriptors it inherited that hold a canary, and the
// canaries in the engine's environment as another process of the same user reads it.
import console
import exec
import secret

fn main(console: Console<Write>, allocator: Allocator, exec: Exec, key: Secret<Seal>, token: Secret<Reveal>):
    match key.sign(&allocator, "inspect"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
    match token.reveal_bytes(&allocator):
        Ok(bytes):
            console.print_int(bytes.len())
            bytes.close()
        Err(e):
            console.line("unreadable")
    match exec.run("inspect"):
        Ok(run):
            match run.read_text(&allocator):
                Ok(text):
                    console.write_string(&text)
                    text.close()
                Err(e):
                    console.line("unreadable")
            console.print_int(run.code())
        Err(e):
            console.line("not run")
