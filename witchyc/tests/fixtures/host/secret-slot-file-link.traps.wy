// Stopped before `main` runs: the granted file is a hard link to the sealed key's source file,
// another name for the same file (review of 33face12).
import console
import fs
import secret

fn main(key: Secret<Seal>, console: Console<Write>, data: File<Read>, allocator: Allocator):
    match data.read_text(&allocator):
        Ok(contents):
            console.write_string(&contents)
            console.line("")
            contents.close()
        Err(error):
            console.line("unreadable")
    match key.sign(&allocator, "x"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
