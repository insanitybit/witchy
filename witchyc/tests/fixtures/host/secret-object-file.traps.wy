// The key reaches the engine on a pipe and `--secret-object` names the file it came from:
// a `--file` grant of that file (here a hard link to it) is refused before `main` runs.
import console
import fs
import secret

fn main(key: Secret<Seal>, console: Console<Write>, data: File<Read>, allocator: Allocator):
    match data.read_text(&allocator):
        Ok(contents):
            console.write_string(&contents)
            console.line("")
            contents.close()
        Err(error):
            console.line("unreadable")
    match key.sign(&allocator, "x"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
