// `--secret-object` only adds: a wrong identity for a slot whose descriptor is the key's
// own file does not take that file off the list, so a `--file` grant of it is still refused.
import console
import fs
import secret

fn main(key: Secret<Seal>, console: Console<Write>, data: File<Read>, allocator: Allocator):
    match data.read_text(&allocator):
        Ok(contents):
            console.write_string(&contents)
            console.line("")
            contents.close()
        Err(error):
            console.line("unreadable")
    match key.sign(&allocator, "x"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
