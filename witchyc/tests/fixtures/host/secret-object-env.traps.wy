// `--secret-object` is for a slot read from a descriptor: an `env:` value has no file.
import console
import secret

fn main(key: Secret<Seal>, console: Console<Write>, allocator: Allocator):
    match key.sign(&allocator, "x"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
