// Stops when the program renames a file of its own onto a symbolic link through which the
// launcher reads the sealed key (review of 499f8240): the key's file is unchanged, but the
// next run would read the program's file at that name. A link that resolves to a source is
// never replaced; another link is not changed while the run has secrets.
import console
import fs
import secret

fn say(console: &Console<Write>, done: Result<(), FsError>):
    match done:
        Ok:
            console.line("ok")
        Err(e):
            console.line("refused")

fn put(dir: &Dir<Write>, path: Text, text: Text) -> Result<(), FsError>:
    let file = dir.create(path)?
    match file.write(text):
        Ok:
            return file.finish()
        Err(e):
            file.abandon()
            return Err(e)

fn main(key: Secret<Seal>, console: Console<Write>, files: Dir<Write>, allocator: Allocator):
    say(&console, put(&files, "evil", "attacker-key"))
    say(&console, files.rename("evil", "cur"))
    match key.sign(&allocator, "x"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
