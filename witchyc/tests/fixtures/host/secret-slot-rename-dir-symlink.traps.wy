// Stops when the program moves a directory holding a symbolic link through which the launcher
// reads the sealed key: the walk does not follow links, but looks at what each resolves to.
import console
import fs
import secret

fn say(console: &Console<Write>, done: Result<(), FsError>):
    match done:
        Ok:
            console.line("ok")
        Err(e):
            console.line("refused")

fn put(dir: &Dir<Write>, path: Text, text: Text) -> Result<(), FsError>:
    let file = dir.create(path)?
    match file.write(text):
        Ok:
            return file.finish()
        Err(e):
            file.abandon()
            return Err(e)

fn main(key: Secret<Seal>, console: Console<Write>, files: Dir<Write>, allocator: Allocator):
    say(&console, files.rename("d", "old"))
    say(&console, files.make_dir("d"))
    say(&console, put(&files, "d/cur", "attacker-key"))
    match key.sign(&allocator, "x"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
