// The inline test spelling, whose value happens to hold `@fd:`: still a name and a value, not a
// descriptor source (review of a3bbee89). Otherwise as secret.wy.
import console
import secret

fn endorse(console: &Console<Write>, allocator: &Allocator, key: &Secret<Seal>):
    match key.sign(allocator, "release 1.0"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")

fn show(console: &Console<Write>, allocator: &Allocator, secret: &Secret<Reveal>):
    match secret.reveal(allocator):
        Ok(text):
            console.print_int(text.byte_len())
            text.close()
        Err(SealedOnly):
            console.line("sealed only")
        Err(_):
            console.line("unreadable")

fn main(console: Console<Write>, allocator: Allocator, secrets: SecretStore):
    match secrets.get("SIGNING_KEY"):
        Ok(key):
            endorse(&console, &allocator, &key)
            show(&console, &allocator, &key)
        Err(e):
            console.line("no key")
    // Granted for signing only: `get` says so, and `get_sealed` gives what the grant allows.
    match secrets.get("TOKEN"):
        Ok(token):
            show(&console, &allocator, &token)
        Err(SealedOnly):
            console.line("sealed only")
        Err(_):
            console.line("no token")
    match secrets.get_sealed("TOKEN"):
        Ok(token):
            endorse(&console, &allocator, &token)
        Err(e):
            console.line("no token")
    match secrets.get("HOME"):
        Ok(home):
            console.line("leaked")
        Err(e):
            console.line("not granted")
