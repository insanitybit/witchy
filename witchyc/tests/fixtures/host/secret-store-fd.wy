// A store's secrets from descriptors (`--secret-seal=NAME@fd:N`, `--secret=NAME@fd:N`), as
// Grimoire hands them over: SIGNING_KEY on a pipe (sign only), TOKEN from a file (read and
// sign). Each signs with its own value; the sealed one is never a full `Secret`; a name the run
// did not grant is not there. No value is printed.
import console
import secret

fn endorse(console: &Console<Write>, allocator: &Allocator, key: &Secret<Seal>):
    match key.sign(allocator, "release 1.0"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")

fn main(console: Console<Write>, allocator: Allocator, secrets: SecretStore):
    match secrets.get_sealed("SIGNING_KEY"):
        Ok(key):
            endorse(&console, &allocator, &key)
        Err(e):
            console.line("no key")
    match secrets.get("SIGNING_KEY"):
        Ok(key):
            console.line("leaked")
        Err(SealedOnly):
            console.line("sealed only")
        Err(_):
            console.line("no key")
    match secrets.get("TOKEN"):
        Ok(token):
            match token.reveal(&allocator):
                Ok(text):
                    console.print_int(text.byte_len())
                    text.close()
                Err(_):
                    console.line("unreadable")
            endorse(&console, &allocator, &token)
        Err(e):
            console.line("no token")
    match secrets.get("HOME"):
        Ok(home):
            console.line("leaked")
        Err(e):
            console.line("not granted")
