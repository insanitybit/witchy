// Stopped before `main` runs: the input is the sealed key's own descriptor, reached again
// through /dev/fd. It would read the key as console input (review of 1b5c0ce6).
import console
import string
import secret

fn main(console: Console<Write>, input: Console<Read>, allocator: Allocator, key: Secret<Seal>):
    let Ok(made): String = String.new(&allocator) else Err(e):
        return
    var line = move made
    match input.read_line(&allocator, &mut line):
        .Line:
            console.write_string(&line)
            console.line("")
        _:
            console.line("no line")
    line.close()
    match key.sign(&allocator, "x"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
