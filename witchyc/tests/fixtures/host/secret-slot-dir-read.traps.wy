// Stops when the program reads, through its granted directory, a hard link to the sealed key's
// source file: the file opened is checked, not its name (review of 33face12). Output is kept
// until the run ends, so nothing is printed.
import console
import fs
import secret

fn main(key: Secret<Seal>, console: Console<Write>, files: Dir<Read>, allocator: Allocator):
    match files.read_text(&allocator, "other"):
        Ok(contents):
            console.write_string(&contents)
            console.line("")
            contents.close()
        Err(error):
            console.line("unreadable")
    match key.sign(&allocator, "x"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
