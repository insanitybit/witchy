// `--secret-object` is given once per slot: a second could not replace the first.
import console
import secret

fn main(key: Secret<Seal>, console: Console<Write>, allocator: Allocator):
    match key.sign(&allocator, "x"):
        Ok(signature):
            console.write_string(&signature)
            console.line("")
            signature.close()
        Err(e):
            console.line("unsigned")
