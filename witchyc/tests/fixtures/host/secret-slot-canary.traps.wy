// Stopped before `main` runs, after `first` was read: `second` is missing. The program would
// print `first`; neither it nor any error repeats the value.
import console
import secret
fn main(first: Secret<Reveal>, second: Secret<Seal>, console: Console<Write>, allocator: Allocator):
    match first.reveal(&allocator):
        Ok(text):
            console.write_string(&text)
            text.close()
        Err(e):
            console.line("unreadable")
