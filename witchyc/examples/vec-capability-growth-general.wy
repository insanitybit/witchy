fn main(out: Console<Write>, token: Console<Write>):
    var witness = memory.alloc(1)
    memory.init(&mut witness, 0, 42)
    let saved = &witness
    let allocation: Result<Vec<Console<Write>>, AllocError> = vec_new(0)
    match allocation:
        Ok(vector):
            match vec_push(move vector, move token):
                Ok(pushed):
                    match vec_reserve(move pushed, 3):
                        Ok(grown):
                            match vec_pop(move grown):
                                Ok(popped):
                                    match popped.item:
                                        Some(recovered):
                                            let restored = move recovered
                                            restored.print_int(73)
                                        None:
                                            out.print_int(90)
                                    match vec_release(move popped.vector):
                                        Ok(done):
                                            out.print_int(74)
                                        Err(kept):
                                            out.print_int(91)
                                            discard(move kept)
                                Err(kept):
                                    out.print_int(92)
                                    discard(move kept)
                        Err(failed):
                            discard(move failed)
                Err(failed):
                    let returned = move failed.item
                    returned.print_int(93)
                    match vec_release(move failed.vector):
                        Ok(done):
                            out.print_int(94)
                        Err(kept):
                            discard(move kept)
        Err(reason):
            discard(move token)
            out.print_int(95)
    out.print_int(memory.read(saved, 0))
    memory.end(saved)
    memory.release(witness)
