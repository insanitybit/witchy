fn main(console: Console<Write>):
    // Fill the cell budget before retaining a loan, so setup itself cannot
    // consume the operation's reserved loan room or trap on initialization.
    let occupied: Buffer<USize> = memory.alloc(65533)
    var witness = memory.alloc(1)
    memory.init(&mut witness, 0, 42)
    var held = memory.alloc(1)
    memory.init(&mut held, 0, 37)
    var offered = memory.alloc(1)
    memory.init(&mut offered, 0, 73)
    let saved = &witness
    let allocation: Result<Vec<Buffer<USize>>, AllocError> = vec_new(0)
    match allocation:
        Ok(vector):
            match vec_push(move vector, move offered):
                Ok(unexpected):
                    discard(move unexpected)
                Err(failed):
                    if failed.reason == AllocError.quota:
                        console.print_int(76)
                    else:
                        if failed.reason == AllocError.metadata:
                            console.print_int(77)
                    let recovered = move failed.item
                    console.print_int(memory.read(&recovered, 0))
                    memory.release(recovered)
                    let measured = vec_len(move failed.vector)
                    console.print_int(measured.length)
                    match vec_release(move measured.vector):
                        Ok(unit):
                            console.print_int(74)
                        Err(kept):
                            discard(move kept)
        Err(reason):
            memory.release(offered)
    console.print_int(memory.read(&held, 0))
    memory.release(held)
    console.print_int(memory.read(saved, 0))
    memory.end(saved)
    memory.release(witness)
    memory.release(occupied)
