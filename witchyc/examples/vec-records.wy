type Pair:
    byte: U8
    word: U64

// This witness's failure cleanup consumes only plain numeric records.
// Every cell is taken before raw release; no all-T destruction policy is assumed.
fn drop_pairs(input: Vec<Pair>):
    requires memory.loan_room(1)
    var vector = move input
    let reader = &mut vector.data
    var i: USize = 0
    while i < vector.length:
        invariant i <= vector.length
        invariant memory.size(vector.data) == vector.capacity
        invariant EmptyBetween(vector.data, 0, i)
        invariant InitializedBetween(vector.data, i, vector.length)
        invariant EmptyBetween(vector.data, vector.length, vector.capacity)
        let item: Pair = memory.take(reader, i)
        discard(move item)
        i += 1
    memory.end(reader)
    memory.release(vector.data)

fn drain(vector: Vec<Pair>, console: Console<Write>):
    requires memory.loan_room(1)
    match vec_pop(move vector):
        Ok(back):
            match back.item:
                Some(item):
                    console.print_int(U8.to_u64(item.byte))
                    console.print_int(item.word)
                    discard(move item)
                None:
                    console.print_int(901)
            match vec_pop(move back.vector):
                Ok(front):
                    match front.item:
                        Some(item):
                            console.print_int(U8.to_u64(item.byte))
                            console.print_int(item.word)
                            discard(move item)
                        None:
                            console.print_int(902)
                    match vec_release(move front.vector):
                        Ok(done):
                            console.print_int(42)
                        Err(kept):
                            drop_pairs(move kept)
                Err(kept):
                    drop_pairs(move kept)
        Err(kept):
            drop_pairs(move kept)

fn replace_and_drain(vector: Vec<Pair>, console: Console<Write>):
    requires memory.loan_room(1)
    let seven: U8 = 7
    match vec_replace(move vector, 0, Pair(seven, 12884901889)):
        Ok(changed):
            console.print_int(U8.to_u64(changed.previous.byte))
            console.print_int(changed.previous.word)
            discard(move changed.previous)
            drain(move changed.vector, move console)
        Err(failed):
            discard(move failed.replacement)
            drop_pairs(move failed.vector)
            discard(move console)

fn fill(vector: Vec<Pair>, console: Console<Write>):
    requires memory.loan_room(1)
    let zero: U8 = 0
    let full: U8 = 255
    match vec_push(move vector, Pair(zero, 4294967297)):
        Ok(once):
            match vec_push(move once, Pair(full, 8589934595)):
                Ok(grown):
                    replace_and_drain(move grown, move console)
                Err(failed):
                    discard(move failed.item)
                    drop_pairs(move failed.vector)
                    discard(move console)
        Err(failed):
            discard(move failed.item)
            drop_pairs(move failed.vector)
            discard(move console)

fn main(console: Console<Write>):
    let allocation: Result<Vec<Pair>, AllocError> = vec_new(0)
    match allocation:
        Ok(vector):
            fill(move vector, move console)
        Err(reason):
            console.print_int(903)
            discard(move console)
