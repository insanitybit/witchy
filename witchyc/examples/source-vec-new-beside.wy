fn main(console: Console<Write>):
    var witness = memory.alloc(1)
    memory.init(&mut witness, 0, 42)
    let saved = &witness
    let allocation: Result<Vec<Bool>, AllocError> = vec_new(1)
    match allocation:
        Ok(vector):
            match vec_push_spare(move vector, true):
                Ok(pushed):
                    var held = memory.alloc(1)
                    memory.init(&mut held, 0, 37)
                    match new_beside(move pushed, 3, move held):
                        Ok(done):
                            console.print_int(done.created.capacity)
                            match vec_release(move done.created):
                                Ok(unit):
                                    console.print_int(73)
                                Err(kept):
                                    discard(move kept)
                            console.print_int(memory.read(&done.held, 0))
                            memory.release(done.held)
                            match vec_pop(move done.previous):
                                Ok(popped):
                                    match popped.item:
                                        Some(item):
                                            if item:
                                                console.print_int(74)
                                        None:
                                            console.print_int(90)
                                    match vec_release(move popped.vector):
                                        Ok(unit):
                                            console.print_int(75)
                                        Err(kept):
                                            discard(move kept)
                                Err(kept):
                                    discard(move kept)
                        Err(failed):
                            console.print_int(76)
                            console.print_int(memory.read(&failed.held, 0))
                            memory.release(failed.held)
                            match vec_pop(move failed.previous):
                                Ok(popped):
                                    match popped.item:
                                        Some(item):
                                            if item:
                                                console.print_int(74)
                                        None:
                                            console.print_int(90)
                                    match vec_release(move popped.vector):
                                        Ok(unit):
                                            console.print_int(75)
                                        Err(kept):
                                            discard(move kept)
                                Err(kept):
                                    discard(move kept)
                Err(failed):
                    discard(move failed)
        Err(reason):
            console.print_int(91)
    console.print_int(memory.read(saved, 0))
    memory.end(saved)
    memory.release(witness)
