fn main(console: Console<Write>):
    var witness = memory.alloc(1)
    memory.init(&mut witness, 0, 42)
    let saved = &witness
    let allocation: Result<Vec<Bool>, AllocError> = vec_new(3)
    match allocation:
        Ok(vector):
            let measured = vec_len(move vector)
            console.print_int(measured.length)
            console.print_int(measured.vector.capacity)
            memory.release(measured.vector.data)
        Err(reason):
            console.print_int(0)
    console.print_int(memory.read(saved, 0))
    memory.end(saved)
    memory.release(witness)
