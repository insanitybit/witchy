import cell_list
import string
import option

fn make(a: &Allocator, label: Text) -> Option<String>:
    match String.with_capacity(a, label.byte_len()):
        Err(code):
            return None
        Ok(blank):
            var s = move blank
            if let Ok(_) = s.push_text(a, label):
                return Some(move s)
            s.close()
            return None

fn add(list: &mut DoublyLinkedList<String>, a: &Allocator, label: Text) -> Bool:
    match make(a, label):
        None:
            return false
        Some(value):
            match list.push_back(a, move value):
                Some(original):
                    original.close()
                    return false
                None:
                    return true

fn show(value: Option<String>, out: &Console<Write>):
    ensures true
    proof:
        auto
    match move value:
        Some(text):
            let count = text.byte_len()
            var i: U64 = 0
            while i < count:
                invariant i <= count
                match text.byte_at(i):
                    Ok(byte):
                        out.print_byte(byte)
                    Err(code):
                        text.close()
                        return
                i += 1
            out.print_byte(10)
            text.close()
        None:
            out.print_int(0)

// The list owns its tail and the caller supplies the replacement. This native
// effect boundary includes allocation refusal, payload transfer and cleanup.
nopanic fn replace_last(list: &mut DoublyLinkedList<String>, a: &Allocator, replacement: String, out: &Console<Write>) -> Option<String>:
    let old = list.tail_address()
    let removed = list.pop_back()
    match list.push_back(a, move replacement):
        Some(original):
            original.close()
        None:
            out.print_int(U32.to_u64(old))
            out.print_int(U32.to_u64(list.tail_address()))
    return move removed

fn reuse(list: &mut DoublyLinkedList<String>, a: &Allocator, out: &Console<Write>):
    if !add(list, a, "kept"):
        return
    match make(a, "new"):
        None:
            return
        Some(replacement):
            let removed = replace_last(list, a, move replacement, out)
            show(move removed, out)

nopanic fn pair_owned(a: &Allocator, out: &Console<Write>, first: String, second: String):
    var list: DoublyLinkedList<String> = DoublyLinkedList.new()
    match list.push_back(a, move first):
        Some(first_back):
            first_back.close()
            second.close()
            list.close()
            return
        None:
            match list.push_back(a, move second):
                Some(second_back):
                    second_back.close()
                None:
                    show(list.pop_back(), out)
                    show(list.pop_back(), out)
                    show(list.pop_back(), out)
    list.close()

fn main(out: Console<Write>, a: Allocator):
    match make(&a, "first"):
        None:
            return
        Some(first):
            match make(&a, "second"):
                None:
                    first.close()
                    return
                Some(second):
                    pair_owned(&a, &out, move first, move second)
    var again: DoublyLinkedList<String> = DoublyLinkedList.new()
    reuse(&mut again, &a, &out)
    again.close()
