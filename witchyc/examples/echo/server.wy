// A concurrent echo server: one thread, a `Group` of connections and `wait` (docs/wasm-net.md,
// docs/design-async.md step 6). It serves `--grant=Load.connections=N` connections, then
// prints how many bytes it echoed. `scripts/bench-echo-concurrent.py` drives it.
import console
import net
import vec

grantable capability Load:
    connections: U64

// Echo every connection until each closes; serve `connections` of them, then stop.
fn main(console: Console<Write>, listener: Listener, allocator: Allocator, load: Load):
    let group = listener.group()
    let zero: U8 = 0
    let Ok(made): Vec<U8> = Vec.filled(&allocator, 16384, zero) else Err(code):
        group.close()
        return
    var buffer = move made
    let Ok(first): Vec<U64> = Vec.filled(&allocator, 1, wait_entry(LISTENER_SLOT, true, false)) else Err(code):
        buffer.close()
        group.close()
        return
    var entries = move first
    var accepted: U64 = 0
    var total: U64 = 0
    var running = true
    while running:
        let ready = group.wait(entries.as_mut_slice())
        if ready == 0:
            running = false
        var i: U64 = 0
        while i < entries.len():
            let entry = entries[i]
            let slot = entry_slot(entry)
            var removed = false
            if entry_readable(entry) || entry_closed(entry):
                if slot == LISTENER_SLOT:
                    var more = true
                    while more:
                        match listener.try_accept():
                            Ok(socket):
                                accepted += 1
                                let at = group.add(move socket)
                                match entries.push_mut(&allocator, wait_entry(at, true, false)):
                                    Ok:
                                        continue
                                    Err(lost):
                                        more = false
                            Err(error):
                                more = false
                else:
                    let socket = group.take(slot)
                    match socket.try_read(buffer.as_mut_slice()):
                        Ok(count):
                            if count == 0:
                                socket.close()
                                removed = true
                            else:
                                let echo = buffer.as_slice()
                                match socket.write_all(echo.part(0, count)):
                                    Ok:
                                        total += count
                                        let _ = entries.set(i, wait_entry(group.add(move socket), true, false))
                                    Err(failure):
                                        socket.close()
                                        removed = true
                        Err(error):
                            match error:
                                WouldBlock:
                                    let _ = entries.set(i, wait_entry(group.add(move socket), true, false))
                                _:
                                    socket.close()
                                    removed = true
            if removed:
                let last = entries.len() - 1
                let _ = entries.swap(i, last)
                let gone = entries.take_last_mut()
            else:
                i += 1
        if accepted >= load.connections && entries.len() == 1:
            running = false
    console.print_int(total)
    entries.close()
    buffer.close()
    group.close()
