fn main(console: Console<Write>):
    var witness = memory.alloc(1)
    memory.init(&mut witness, 0, 42)
    let saved = &witness
    let allocation: Result<Vec<Bool>, AllocError> = vec_new(3)
    match allocation:
        Ok(vector):
            match vec_push_spare(move vector, true):
                Ok(pushed):
                    console.print_int(pushed.length)
                    memory.release(pushed.data)
                Err(failed):
                    if failed.item:
                        console.print_int(73)
                    console.print_int(failed.vector.length)
                    console.print_int(failed.vector.capacity)
                    if failed.reason == AllocError.metadata:
                        console.print_int(11)
                    else:
                        console.print_int(22)
                    memory.release(failed.vector.data)
        Err(reason):
            console.print_int(0)
    console.print_int(memory.read(saved, 0))
    memory.end(saved)
    memory.release(witness)
