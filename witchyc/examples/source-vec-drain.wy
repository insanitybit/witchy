fn main(console: Console<Write>):
    var witness = memory.alloc(1)
    memory.init(&mut witness, 0, 42)
    let saved = &witness
    let allocation: Result<Vec<Bool>, AllocError> = vec_new(3)
    match allocation:
        Ok(vector):
            match vec_push_spare(move vector, true):
                Ok(pushed):
                    match vec_pop(move pushed):
                        Ok(popped):
                            match popped.item:
                                Some(item):
                                    if item:
                                        console.print_int(73)
                                None:
                                    console.print_int(90)
                            match vec_release(move popped.vector):
                                Ok(done):
                                    console.print_int(74)
                                Err(kept):
                                    console.print_int(91)
                                    discard(move kept)
                        Err(kept):
                            console.print_int(92)
                            discard(move kept)
                Err(failed):
                    console.print_int(93)
                    discard(move failed)
        Err(reason):
            console.print_int(94)
    console.print_int(memory.read(saved, 0))
    memory.end(saved)
    memory.release(witness)
