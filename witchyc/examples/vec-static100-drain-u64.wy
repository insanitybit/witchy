fn append(input: Vec<U64>, item: U64) -> Vec<U64>:
    match vec_push(move input, item):
        Ok(grown):
            return move grown
        Err(failed):
            return move failed.vector

fn pop_once(input: Vec<U64>) -> Vec<U64>:
    match vec_pop(move input):
        Ok(popped):
            discard(move popped.item)
            return move popped.vector
        Err(kept):
            return move kept

