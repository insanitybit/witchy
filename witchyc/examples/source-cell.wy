fn main(console: Console<Write>):
    var witness = memory.alloc(1)
    memory.init(&mut witness, 0, 42)
    let saved = &witness
    var data: Buffer<Bool> = memory.alloc(1)
    let writer = &mut data
    memory.init(writer, 0, true)
    assert CellAt(writer, 0, true)
    assert memory.writable(writer)
    let value: Bool = memory.take(writer, 0)
    assert value == true
    assert memory.empty(writer, 0)
    memory.end(writer)
    if value:
        console.print_int(73)
    console.print_int(memory.read(saved, 0))
    memory.end(saved)
    memory.release(data)
    memory.release(witness)
