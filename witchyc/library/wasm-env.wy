// Environment variables through the `Env` capability. The run grants each variable by
// name (`--env=NAME=VALUE`), and a name the run did not grant looks exactly like one
// that is not set.
import "wasm-string.wy"
import "wasm-result.wy"
import "wasm-vec.wy"

pub type EnvError:
    // Not set, or not granted to this run.
    Missing
    // The value's bytes are not UTF-8 text.
    NotText
    // No memory for the value.
    OutOfMemory

impl EnvError:
    // An allocator's error as an EnvError, for `?` (docs/wasm-results.md).
    pub fn from(code: U64) -> EnvError:
        return OutOfMemory

impl Env:
    // The value of the variable `name`.
    pub fn get(env: &Env, allocator: &Allocator, name: &str) -> Result<String, EnvError>:
        let count = name.byte_len()
        var index: U64 = 0
        while index < count:
            match name.byte_at(index):
                Ok(byte):
                    env.raw_name_byte(byte)
                Err(code):
                    return Err(Missing)
            index += 1
        let length = env.raw_lookup()
        if length == 18446744073709551615:
            return Err(Missing)
        let Ok(made): Vec<U8> = Vec.new(allocator, length + 1) else Err(code):
            return Err(OutOfMemory)
        var bytes = move made
        for at in 0..length:
            let byte = env.raw_value_byte(at)
            match bytes.push_mut(allocator, U8.truncate(byte)):
                Ok:
                    continue
                Err(lost):
                    bytes.close()
                    return Err(OutOfMemory)
        match String.from_utf8(move bytes):
            Ok(text):
                return Ok(move text)
            Err(raw):
                raw.close()
                return Err(NotText)
