// Named host secrets through `SecretStore` (book: cookbook-crypto.md, "Signing needs a
// Secret"), or one fixed secret per `main` parameter (`main(signing: Secret<Seal>)`, bound by
// name in the grant document's `[secrets]`). Values reach the engine from its environment or
// a descriptor, never on a command line. A `Secret` has two rights:
//   `Secret<Reveal>` reads its bytes;
//   `Secret<Seal>` signs with it by handle (HMAC-SHA-256 in the engine) and cannot read it.
// A function that only signs takes `Secret<Seal>`, and the checker holds it to that: it has
// no operation that reads the key. A bare `Secret` has both and narrows to either.
import "wasm-string.wy"
import "wasm-vec.wy"

pub type SecretError:
    // The run grants no secret of that name.
    NotGranted
    // The run granted the secret for signing only.
    SealedOnly
    // No memory for the text.
    NoMemory
    // The bytes are not UTF-8: `reveal_bytes` gives them as they are.
    NotText

impl SecretStore:
    fn send_name(store: &SecretStore, name: &str):
        let count = name.byte_len()
        var index: U64 = 0
        while index < count:
            match name.byte_at(index):
                Ok(byte):
                    store.raw_name_byte(byte)
                Err(code):
                    return
            index += 1

    // The secret the run grants under `name`, with both rights. Err(SealedOnly): the run
    // granted it for signing only, so ask with `get_sealed`.
    pub fn get(store: &SecretStore, name: &str) -> Result<Secret, SecretError>:
        store.send_name(name)
        let found = store.raw_get()
        let code = found.raw_status()
        if code == 2:
            return Err(SealedOnly)
        if code != 0:
            return Err(NotGranted)
        return Ok(move found)

    // The secret under `name`, for signing only, however the run granted it.
    pub fn get_sealed(store: &SecretStore, name: &str) -> Result<Secret<Seal>, SecretError>:
        store.send_name(name)
        let found = store.raw_get_sealed()
        if found.raw_status() != 0:
            return Err(NotGranted)
        return Ok(move found)

impl Secret<Reveal>:
    // The secret's bytes, exactly as the host holds them (every byte value, NUL included).
    pub fn reveal_bytes(secret: &Secret<Reveal>, allocator: &Allocator) -> Result<Vec<U8>, SecretError>:
        let Ok(made): Vec<U8> = Vec.new(allocator, 0) else Err(code):
            return Err(NoMemory)
        var bytes = move made
        var index: U64 = 0
        var next = secret.raw_byte(0)
        while next < 256:
            match bytes.push_mut(allocator, U8.truncate(next)):
                Ok:
                    index += 1
                Err(back):
                    bytes.close()
                    return Err(NoMemory)
            next = secret.raw_byte(index)
        if next > 256:
            bytes.close()
            return Err(SealedOnly)
        return Ok(move bytes)

    // The secret's bytes as text. Err(NotText): they are not UTF-8 (a byte is never taken for
    // a character of that number, which would change a byte of 128 or more).
    pub fn reveal(secret: &Secret<Reveal>, allocator: &Allocator) -> Result<String, SecretError>:
        let Ok(bytes): Vec<U8> = secret.reveal_bytes(allocator) else Err(why):
            return Err(why)
        match String.from_utf8(move bytes):
            Ok(text):
                return Ok(move text)
            Err(back):
                back.close()
                return Err(NotText)

impl Secret<Seal>:
    // HMAC-SHA-384 of a message up to 1 MiB into a 48-byte tag. On error the
    // destination is untouched: 2 is a wrong tag length, 3 a long message,
    // and 4 a provider failure.
    pub fn hmac_sha384(secret: &Secret<Seal>, message: &[U8], tag: &mut [U8]) -> Result<(), U64>:
        let status = secret.raw_hmac_sha384(message, tag)
        if status == 0:
            return Ok(())
        return Err(status)

    fn digest_hex(secret: &Secret<Seal>, allocator: &Allocator) -> Result<String, SecretError>:
        let done = secret.raw_hmac()
        let Ok(made): String = String.new(allocator) else Err(code):
            return Err(NoMemory)
        var hex = move made
        var index: U64 = 0
        while index < 32:
            let byte = secret.raw_digest_byte(index)
            let high = byte / 16
            let low = byte % 16
            let first = if high < 10: 48 + high else: 87 + high
            let second = if low < 10: 48 + low else: 87 + low
            if let Err(_) = hex.push(allocator, first):
                hex.close()
                return Err(NoMemory)
            if let Err(_) = hex.push(allocator, second):
                hex.close()
                return Err(NoMemory)
            index += 1
        return Ok(move hex)

    // HMAC-SHA-256 of `message` keyed by the secret, as 64 lowercase hex digits.
    pub fn sign(secret: &Secret<Seal>, allocator: &Allocator, message: &str) -> Result<String, SecretError>:
        let count = message.byte_len()
        var index: U64 = 0
        while index < count:
            match message.byte_at(index):
                Ok(byte):
                    secret.raw_message_byte(byte)
                Err(code):
                    index = count
            index += 1
        return secret.digest_hex(allocator)

    // The same, for a message held in a String.
    pub fn sign_string(secret: &Secret<Seal>, allocator: &Allocator, message: &String) -> Result<String, SecretError>:
        let count = message.byte_len()
        var index: U64 = 0
        while index < count:
            match message.byte_at(index):
                Ok(byte):
                    secret.raw_message_byte(byte)
                Err(code):
                    index = count
            index += 1
        return secret.digest_hex(allocator)
