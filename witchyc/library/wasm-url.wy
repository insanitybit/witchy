// Bounded, borrowed views of HTTP identifiers.
import span

pub type UrlError:
    InvalidScheme
    InvalidHost
    InvalidPort
    InvalidResource

pub sealed type HttpAuthority:
    host: Span
    port: U64

pub sealed type HttpOrigin:
    authority: Span
    host: Span
    port: U64
    secure: Bool

pub sealed type HttpUrl:
    origin: HttpOrigin
    resource: Span

impl HttpAuthority:
    pub fn hostname(self: HttpAuthority) -> Span:
        return self.host

    // Zero means the authority omitted its port.
    pub fn explicit_port(self: HttpAuthority) -> U64:
        return self.port

impl HttpOrigin:
    pub fn authority(self: HttpOrigin) -> Span:
        return self.authority

    pub fn hostname(self: HttpOrigin) -> Span:
        return self.host

    pub fn port(self: HttpOrigin) -> U64:
        return self.port

    pub fn is_https(self: HttpOrigin) -> Bool:
        return self.secure

impl HttpUrl:
    pub fn origin(self: HttpUrl) -> HttpOrigin:
        return self.origin

    // Original path and query bytes, including the query delimiter.
    pub fn resource(self: HttpUrl) -> Span:
        return self.resource

// A lowercase ASCII DNS name (including pre-encoded IDNA labels) and an optional
// decimal port. The caller applies the scheme's default, when relevant.
pub fn parse_authority(input: Span) -> Result<HttpAuthority, UrlError>:
    if input.len() > 259:
        return Err(InvalidHost)
    match input.split(':'):
        Ok(parts):
            if !valid_hostname(parts.head):
                return Err(InvalidHost)
            let port = decimal_port(parts.tail)?
            return Ok(HttpAuthority(parts.head, port))
        Err(host):
            if !valid_hostname(host):
                return Err(InvalidHost)
            return Ok(HttpAuthority(host, 0))

// The serialized origin contains only its scheme and authority. Use one spelling
// per scheme/host/port by omitting the default port.
pub fn parse_origin(input: Span) -> Result<HttpOrigin, UrlError>:
    if input.starts_with_text("https://"):
        return origin_for(input.part(8, input.len()), true, 443)
    if input.starts_with_text("http://"):
        return origin_for(input.part(7, input.len()), false, 80)
    return Err(InvalidScheme)

pub fn parse_url(input: Span) -> Result<HttpUrl, UrlError>:
    if input.len() > 8192:
        return Err(InvalidResource)
    let start = scheme_length(input)?
    let at = resource_at(input, start)
    let origin = parse_origin(input.part(0, at))?
    let resource = input.part(at, input.len())
    if !valid_resource(resource):
        return Err(InvalidResource)
    return Ok(HttpUrl(origin, resource))

fn scheme_length(input: Span) -> Result<U64, UrlError>:
    if input.starts_with_text("https://"):
        return Ok(8)
    if input.starts_with_text("http://"):
        return Ok(7)
    return Err(InvalidScheme)

fn origin_for(input: Span, secure: Bool, default_port: U64) -> Result<HttpOrigin, UrlError>:
    let parts = parse_authority(input)?
    if parts.port == default_port:
        return Err(InvalidPort)
    let port = if parts.port == 0: default_port else: parts.port
    return Ok(HttpOrigin(input, parts.host, port, secure))

fn decimal_port(input: Span) -> Result<U64, UrlError>:
    if input.is_empty() || input.len() > 5 || input.byte_or_end(0) == '0':
        return Err(InvalidPort)
    let Ok(port): U64 = input.parse_u64() else Err(code):
        return Err(InvalidPort)
    if port > 65535:
        return Err(InvalidPort)
    return Ok(port)

fn valid_hostname(host: Span) -> Bool:
    if host.len() > 253:
        return false
    var label: U64 = 0
    var last_hyphen = false
    for byte in host.as_bytes():
        if *byte == '.':
            if label == 0 || last_hyphen:
                return false
            label = 0
            last_hyphen = false
        else:
            if !lower_or_digit(*byte) && (*byte != '-' || label == 0):
                return false
            label += 1
            if label > 63:
                return false
            last_hyphen = *byte == '-'
    return label > 0 && !last_hyphen

fn lower_or_digit(byte: U8) -> Bool:
    return (byte >= 'a' && byte <= 'z') || (byte >= '0' && byte <= '9')

fn resource_at(input: Span, start: U64) -> U64:
    for i in start..input.len():
        let byte = input.byte_or_end(i)
        if byte == '/' || byte == '?':
            return i
    return input.len()

fn valid_resource(input: Span) -> Bool:
    var digits: U64 = 0
    for byte in input.as_bytes():
        if digits != 0:
            if !hex_digit(*byte):
                return false
            digits -= 1
        else if *byte == '%':
            digits = 2
        else if !resource_byte(*byte):
            return false
    return digits == 0

fn hex_digit(byte: U8) -> Bool:
    return (byte >= '0' && byte <= '9') || (byte >= 'A' && byte <= 'F') || (byte >= 'a' && byte <= 'f')

fn resource_byte(byte: U8) -> Bool:
    return (lower_or_digit(byte) || (byte >= 'A' && byte <= 'Z') ||
        byte == '-' || byte == '.' || byte == '_' || byte == '~' ||
        byte == '!' || byte == '$' || byte == '&' || byte == 39 || byte == '(' || byte == ')' ||
        byte == '*' || byte == '+' || byte == ',' || byte == ';' || byte == '=' ||
        byte == ':' || byte == '@' || byte == '/' || byte == '?')
