// The WebAuthn ES256 profile uses a COSE EC2 key with exactly these
// mandatory labels and an uncompressed point.
pub pure fn es256_point(encoded: &[U8], output: &mut [U8; 65]) -> Bool:
    if encoded.len() != 77 || encoded[0] != 165:
        return false
    var index: U64 = 1
    var present: U64 = 0
    (*output)[0] = 4
    for entry in 0..5:
        if encoded.len() - index < 2:
            return false
        let label = encoded[index]
        index += 1
        if label == 1 && encoded[index] == 2 && (present & 1) == 0:
            present = present | 1
        else if label == 3 && encoded[index] == 38 && (present & 2) == 0:
            present = present | 2
        else if label == 32 && encoded[index] == 1 && (present & 4) == 0:
            present = present | 4
        else if label == 33 || label == 34:
            if encoded.len() - index < 34 || encoded[index] != 88 || encoded[index + 1] != 32:
                return false
            let offset: U64 = if label == 33:
                1
            else:
                33
            let bit: U64 = if label == 33:
                8
            else:
                16
            if (present & bit) != 0:
                return false
            present = present | bit
            (*output).slice_mut().part(offset, offset + 32).copy_from(encoded.part(index + 2, index + 34))
            index += 33
        else:
            return false
        index += 1
    return present == 31 && index == encoded.len()
