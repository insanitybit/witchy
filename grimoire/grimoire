def tool_files(name):
    """`grimoire new NAME --tool`: a tool in a pipe, given an argument and standard input."""
    return {
        "witchy.toml": '[run]\nentry = "main.wy"\n'
                       "# Limits, never authority; each is shown as a `limit:` line before the run. Defaults:\n"
                       "# deadline-ms = 1000\n"
                       '# fuel = 1000000           # about 5 KiB of input; or "unmetered"\n'
                       '# input-bytes = 65536      # standard input is a stream: or "unlimited"\n'
                       "# output-bytes = 65536\n"
                       "# heap-pages = 3           # a longer line needs a bigger heap\n\n"
                       '[grants]\ndocument = "main.grants.toml"\noutput = true\nallocator = true\n\n'
                       '[[test]]\nname = "prefixes"\nproject = "."\nargs = ["> "]\nstdin = "one\\ntwo\\n"\nstdout = "> one\\n> two\\n"\n',
        "main.grants.toml": "# Everything a run may reach, bound to main's parameters by name.\n"
                            "[args]\n"
                            "# main(args: Args): the words after `--`, at most one of at most 256 bytes.\n"
                            "args = { count = 1, max-bytes = 256 }\n"
                            "[input]\n"
                            "# main(input: Console<Read>): this launch's standard input, read as the program asks for it.\n"
                            "input = { stdin = true }\n",
        "main.policy": TOOL_POLICY,
        "main.wy": f"// {name}: a tool in a pipe. It writes each line of its standard input with the word it is\n"
                   f"// given before it: printf 'one\\ntwo\\n' | grimoire run {name} -- '> '\n"
                   "import args\nimport console\nimport string\n\n"
                   "fn main(args: Args, input: Console<Read>, console: Console<Write>, allocator: Allocator):\n"
                   "    let Ok(prefix): String = args.get(&allocator, 0) else Err(_):\n"
                   f"        console.line(\"usage: {name} PREFIX < lines\")\n"
                   "        return\n"
                   "    let Ok(made): String = String.new(&allocator) else Err(_):\n"
                   "        prefix.close()\n"
                   "        return\n"
                   "    var line = move made\n"
                   "    while true:\n"
                   "        line.clear()\n"
                   "        match input.read_line(&allocator, &mut line):\n"
                   "            .Line:\n"
                   "                console.write_string(&prefix)\n"
                   "                console.write_string(&line)\n"
                   "                console.line(\"\")\n"
                   "            .End:\n"
                   "                break\n"
                   "            .NotText:\n"
                   "                // A line that is not UTF-8 is skipped.\n"
                   "                continue\n"
                   "            .NoRoom:\n"
                   f"                console.line(\"{name}: a line too long for the heap ([run] heap-pages)\")\n"
                   "                break\n"
                   "    line.close()\n"
                   "    prefix.close()\n",
    }


def new_project(name, library, shape=None):
    """`grimoire new NAME [--lib|--exe|--service|--tool]`: a project that builds and whose test
    passes, with nothing granted that it does not use. An executable gets its manifest, grant
    document, policy and a declared test; a library its manifest, source and a native test. A
    service (`shape="service"`) is run once for each connection, with a native test of its
    answer; a tool (`shape="tool"`) takes an argument and standard input, with a declared test."""
    if not NAME.fullmatch(name):
        raise ProjectError("a project name is a lowercase letter, then up to 63 lowercase letters, digits or `-`")
    root = Path(name)
    if os.path.lexists(root):
        raise ProjectError(f"{name} exists: `grimoire new` writes a new directory and replaces nothing")
    module = name.replace("-", "_")
    if shape == "service":
        files = service_files(name)
    elif shape == "tool":
        files = tool_files(name)
    elif library:
        files = {
            "witchy.toml": f'[package]\nname = "{name}"\nversion = "0.1.0"\nsource = "{module}.wy"\n\n'
                           "# A dependency is a registry package at an exact version:\n# [dependencies]\n# other = \"1.0.0\"\n\n"
                           "# How long one native test case may run (25 to 4000; default 100):\n# [tests]\n# case-deadline-ms = 100\n",
            f"{module}.wy": f"// {name}: what a program that imports \"@{name}\" may call.\n"
                            "pub fn doubled(value: U64) -> U64:\n    return value + value\n",
            "test.wy": f'// Native tests: `grimoire test`. A case may take `&Allocator` (a fresh heap), a `U64`,\n'
                       "// `&Console<Read>`, `&Dir<Read>` or `&Dir<Write>`; see docs/package-tests.md.\n"
                       f'import "{module}.wy"\nimport testing\n\n'
                       f"test fn doubles() -> Result<(), Failure>:\n    return testing.eq_u64({module}.doubled(21), 42)\n",
        }
    else:
        files = {
            "witchy.toml": '[run]\nentry = "main.wy"\n'
                           "# Limits, never authority; each is shown as a `limit:` line before the run. Defaults:\n"
                           '# deadline-ms = 1000        # or "none" for a service\n# fuel = 1000000           # or "unmetered"\n'
                           "# output-bytes = 65536\n# memory-pages = 4\n# net-bytes, file-bytes, fuel-per-connection: with a [listen] or [dirs] grant\n\n"
                           '[grants]\ndocument = "main.grants.toml"\noutput = true\n# allocator = true   # when main takes an Allocator\n\n'
                           f'[[test]]\nname = "greets"\nproject = "."\nstdout = "hello from {name}\\n"\n',
            "main.grants.toml": "# Everything a run may reach, bound to main's parameters by name. Nothing yet.\n"
                                '# [dirs]\n# data = { root = "data", rights = ["Read", "Write"] }   # main(data: Dir)\n'
                                '# [listen]\n# listener = "127.0.0.1:8080"                          # main(listener: Listener)\n'
                                "# [clock]\n# clock = true                                         # main(clock: Clock)\n"
                                "# [input]\n# input = { stdin = true }                             # main(input: Console<Read>, allocator: Allocator); or a file: input = \"requests.txt\"\n",
            "main.policy": SCAFFOLD_POLICY,
            "main.wy": f'import console\n\nfn main(console: Console<Write>):\n    console.line("hello from {name}")\n',
        }
    root.mkdir()
    for filename, text in files.items():
        (root / filename).write_text(text)
    made = list(files)
    if shape == "service":
        # The granted directory: inside the project, so the document's word alone places it.
        (root / "data").mkdir()
        made.append("data/")
    print(f"created {name}/: " + ", ".join(made))
    run = {None: f" && grimoire run {name}", "service": f" && grimoire run {name} (then: curl http://127.0.0.1:8080/)",
           "tool": f" && printf 'one\\ntwo\\n' | grimoire run {name} -- '> '"}[shape]
    print(f"next: grimoire build {name} && grimoire test {name}" + ("" if library else run))


