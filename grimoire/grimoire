# The descriptors (3 and up) this process was started with, before it opens any of its own: only
# these can be a secret's `fd:N`. The listing's own descriptor is closed again by the time each
# number is checked, so it is not among them.
def _inherited_descriptors():
    import fcntl
    try:
        listed = [int(name) for name in os.listdir("/dev/fd") if name.isdigit()]
    except OSError:
        return frozenset()
    found = set()
    for number in listed:
        try:
            if number >= 3:
                fcntl.fcntl(number, fcntl.F_GETFD)
                found.add(number)
        except OSError:
            pass
    return frozenset(found)


INHERITED_DESCRIPTORS = _inherited_descriptors()

