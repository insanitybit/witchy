def shipped_module(filename, digest, imports=None):
    """Load exactly the verified companion bytes from the launcher's installation."""
    import types
    name = "_witchy_compiler_client_" + digest
    if name not in sys.modules:
        path = Path(__file__).resolve().with_name(filename)
        source = path.read_bytes()
        if hashlib.sha384(source).hexdigest() != digest:
            raise OSError(f"{path} differs from the companion shipped with this launcher")
        module = types.ModuleType(name)
        module.__file__ = str(path)
        module.__dict__.update(imports or {})
        exec(compile(source, str(path), "exec"), module.__dict__)
        sys.modules[name] = module
    return sys.modules[name]


