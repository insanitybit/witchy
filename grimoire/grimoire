SAID = "grimoire: "


def say(text):
    """Every line this launcher writes of its own goes through here, and so begins
    `grimoire: `: a grant, a limit, a warning, a refusal. With the engine's `witchy: ` it is
    one of the two beginnings a program's own output is marked for (`--plain-output`), so
    nothing a program prints reads as said by either. No other function writes the launcher's
    words to standard error (a test reads this file for any that does)."""
    text = str(text)
    lines = (text[:-1] if text.endswith("\n") else text).split("\n")
    sys.stderr.write("".join(f"{SAID}{line}\n" for line in lines))
    sys.stderr.flush()


def relay(text):
    """What another tool said on its standard error while building, before the program has
    written anything (the compiler's diagnostics, Coven's account of a fetch), passed on as
    that tool's: without the launcher's prefix, since it is not the launcher's word."""
    text = str(text)
    if text:
        sys.stderr.write(text if text.endswith("\n") else text + "\n")
        sys.stderr.flush()


