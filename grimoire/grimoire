def retired_pin(value):
    """What an older suite's pin is (`an SSH key fingerprint`, `a witchy-1 key ID`, `a sha256
    digest`), or None for anything else."""
    if not isinstance(value, str):
        return None
    return "an SSH key fingerprint" if FINGERPRINT.fullmatch(value) else "a witchy-1 key ID" if RETIRED_KEY.fullmatch(value) \
        else "a sha256 digest" if RETIRED_DIGEST.fullmatch(value) else None


def key_pin(value, where, whose="the registry operator's"):
    """A pinned key ID, or the refusal that names what to pin instead."""
    old = retired_pin(value)
    if old:
        raise ProjectError(f"{where} {value} is {old}, from before the witchy-2 profile: every key signs with witchy-2 only. "
                           f"Pin {whose} key ID, witchy-2:<96 hex> (`coven key` prints it)")
    if not isinstance(value, str) or not KEY_ID.fullmatch(value):
        raise ProjectError(f"{where} is {whose} key ID, witchy-2:<96 hex>")
    return value


def operator_pin(value, where):
    return key_pin(value, where)
