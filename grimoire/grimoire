# Where the operator's streams really are while `shown_plain` stands between: (stdout, stderr).
SHOWN = None
UNSHOWN = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f\u061c\u200b-\u200f\u2028-\u202e\u2060-\u2069\ufeff\ufff9-\ufffb\U000e0000-\U000e007f\ud800-\udfff]")


def plain_text(text):
    """Text for the operator's terminal, by the engine's rule for a program's output
    (`--plain-output`): every control character but newline and tab, every byte that was not
    UTF-8 (a lone surrogate here), and the characters that reorder or hide text, written out as
    `\\xNN` or `\\u{NNNN}`."""
    def written(match):
        code = ord(match[0])
        if 0xDC80 <= code <= 0xDCFF:
            code -= 0xDC00
        return f"\\x{code:02x}" if code < 0x100 else f"\\u{{{code:04x}}}"
    return UNSHOWN.sub(written, text)


@contextlib.contextmanager
def shown_plain():
    """The one place everything Grimoire shows passes through. For the length of a command,
    descriptors 1 and 2 of this process are pipes, and so are those of every tool it starts
    (the compiler, Coven, the test host): what any of them writes, a diagnostic quoting a
    package's source line, a file or package name, a registry's reply, reaches the operator
    only as `plain_text`. No call site chooses, so none can forget, and `--raw-output` does not
    reach it: that flag is about the running program's own standard output, which the engine
    writes to the real stream (`SHOWN`) under its own rule. Files Grimoire writes (`--record`,
    a module, a lock) are not streams and keep their bytes."""
    global SHOWN
    if SHOWN is not None:
        yield
        return
    import codecs
    import threading
    sys.stdout.flush()
    sys.stderr.flush()
    real = (os.dup(1), os.dup(2))

    def relay(reading, target):
        decoder = codecs.getincrementaldecoder("utf-8")(errors="surrogateescape")
        with os.fdopen(reading, "rb", buffering=0) as source:
            while True:
                data = source.read(65536)
                text = plain_text(decoder.decode(data or b"", final=not data)).encode("utf-8")
                try:
                    while text:
                        text = text[os.write(target, text):]
                except OSError:
                    pass
                if not data:
                    return

    threads, streams = [], (sys.stdout, sys.stderr)
    try:
        for descriptor, target in zip((1, 2), real):
            reading, writing = os.pipe()
            os.dup2(writing, descriptor)
            os.close(writing)
            thread = threading.Thread(target=relay, args=(reading, target), daemon=True)
            thread.start()
            threads.append(thread)
        def through(stream, descriptor):
            # Python's own stream for the descriptor goes through the pipe like any tool's
            # writes. One that was pointed elsewhere (a caller collecting it) stays where it
            # was pointed, and is made plain on the way.
            try:
                direct = stream.fileno() == descriptor
            except (OSError, ValueError, AttributeError):
                direct = False
            if direct:
                return open(descriptor, "w", buffering=1, encoding="utf-8", errors="surrogateescape", closefd=False)
            class Plain:
                def write(self, text):
                    stream.write(plain_text(text))
                    return len(text)
                def flush(self):
                    stream.flush()
                def __getattr__(self, name):
                    return getattr(stream, name)
            return Plain()
        sys.stdout, sys.stderr = through(streams[0], 1), through(streams[1], 2)
        SHOWN = real
        yield
    finally:
        for stream in (sys.stdout, sys.stderr):
            with contextlib.suppress(OSError, ValueError):
                stream.flush()
        sys.stdout, sys.stderr = streams
        SHOWN = None
        os.dup2(real[0], 1)
        os.dup2(real[1], 2)
        # Each relay ends when the last writer has closed: every tool is gone by now.
        for thread in threads:
            thread.join(timeout=5)
        os.close(real[0])
        os.close(real[1])


def cli_main(argv, launch):
    with shown_plain():
        return shown_main(argv, launch)


def shown_main(argv, launch):
    # `grimoire run PROJECT -- WORD...`: everything after the first `--` is the program's
    # arguments, for its `Args` and nothing else; no option of this launcher is read there.
    words = []
    if argv[:1] == ["run"] and "--" in argv:
        at = argv.index("--")
        argv, words = argv[:at], argv[at + 1:]
    args = argument_parser(native=argv[:1]==["test"]).parse_args(argv)
    try:
        if args.command == "build":
            build_project(args.project, args.output)
        elif args.command == "web":
            web_builder().build(sys.modules[__name__], args.project)
        elif args.command == "test":
            if args.projects:
                test_project(args.project)
            else:
                try:
                    # One command for a package's whole suite: its native cases (test.wy), then
                    # the executables it declares with [[test]], when no flag selects among the
                    # native ones. Each alone when the package has only that kind.
                    manifest = (args.project / "witchy.toml" if args.project.is_dir() else args.project).resolve()
                    whole = not any(a.startswith("-") for a in argv[1:])
                    project_data = read_manifest(manifest) if whole else None
                    declared = project_data is not None and bool(project_data.get("test"))
                    if declared and not manifest.with_name("test.wy").exists():
                        test_project(manifest, project_data=project_data)
                        return 0
                    status = native_tests().run(args,sys.modules[__name__])
                    if declared:
                        try:
                            test_project(manifest, project_data=project_data)
                        except ProjectError as error:
                            say(f"test: {error}")
                            return status or 1
                    return status
                except (OSError, ValueError, KeyError, ProjectError, subprocess.SubprocessError) as error:
                    say(f"test: {error}")
                    return 2
        elif args.command == "keygen":
            publisher_key(args.key)
        elif args.command == "publish":
            publish_project(args.project, args.key, args.recovery_key)
        elif args.command == "lock":
            lock_project(args.project, args.toolchain, args.trust_first_use, recovery_pin=args.recover_tuf_snapshot)
        elif args.command == "trust":
            trust_project(args.project, args.forget, args.forget_operator, args.forget_unkeyed_floor, args.reestablish_operator, args.reinstate_signer)
        elif args.command == "review":
            if args.accept and args.write_policy:
                raise ProjectError("--accept re-pins a policy that is there; --write-policy writes one that is missing: use one")
            if args.replace and not args.write_policy:
                raise ProjectError("--replace goes with --write-policy: it drafts the policy again over the one that is there")
            return review_project(args.project, args.accept, args.write_policy, args.replace)
        elif args.command == "new":
            new_project(args.name, args.lib, "service" if args.service else "tool" if args.tool else None)
        else:
            run_project(args.project, args.record, args.bind, launch,
                        allowed={"write": args.allow_write_root, "read": args.allow_read_root},
                        raw_output=args.raw_output, allowed_files=args.allow_read_file, words=words,
                        quiet=args.quiet, expected_module_pin=args.module_pin,
                        required_tuf_snapshot=run_snapshot_pin(args.tuf_snapshot), launch_pins=args.launch_pins)
    except subprocess.CalledProcessError as error:
        return error.returncode if error.returncode > 0 else 128 - error.returncode
    except (OSError, ValueError, ProjectError) as error:
        say(f"{error}")
        return 1
    except Exception as error:
        return unexpected(error)
    return 0


@contextlib.contextmanager
def still_working(what, after=2.0):
    """A line on standard error if a step has said nothing for `after` seconds: a first use
    that derives a key or compiles Coven's programs takes 5 to 25 s, and silence that long
    reads as a hang. Nothing is printed for a step that finishes sooner."""
    timer = threading.Timer(after, lambda: say(f"{what} (still working: a first use can take half a minute)"))
    timer.daemon = True
    timer.start()
    try:
        yield
    finally:
        timer.cancel()


def unexpected(error):
    """No command ends in a traceback. An exception no command expected is a defect in Grimoire:
    said in one line, with how to see where, and the command fails closed (status 70; nothing
    it had not already done is done). The operator asks for the traceback at that launch, with
    `GRIMOIRE_DEBUG=1`, read before the launch environment is taken apart."""
    if DEBUG_TRACEBACK:
        import traceback
        say("".join(traceback.format_exception(error)))
    said = " ".join(str(error).split())[:200]
    say(f"stopped by a defect in grimoire itself ({type(error).__name__}{': ' + said if said else ''}); nothing further was done. "
          "Run the same command with GRIMOIRE_DEBUG=1 for the traceback, and report it")
    return 70


if __name__ == "__main__":
    status = 130
    try:
        try:
            status = main()
        except KeyboardInterrupt:
            status = 130
        except Exception as error:
            status = unexpected(error)
    finally:
        if client := sys.modules.get(COMPILER_CLIENT_MODULE):
            try:
                client.close()
            except OSError as error:
                # Ctrl-C reaches the whole group, the compiler's process too, which then ends by
                # the signal: a command already failing or stopped says nothing more of it.
                if not status:
                    status = unexpected(error)
    sys.exit(status)
