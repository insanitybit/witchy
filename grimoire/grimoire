# Fixed secrets (`main(key: Secret<Seal>)`, approved by name in the grant document's [secrets]).
# Grimoire reads each value itself, before anything else runs, and hands it to the engine on a
# pipe of its own: never in an environment, an argument, or any toolchain step.
SLOT = re.compile(r"[A-Za-z0-9_]{1,64}")
SECRET_SOURCE = re.compile(r"env:[A-Za-z_][A-Za-z0-9_]{0,63}|fd:([3-9]|[1-9][0-9]{1,2}|10[01][0-9]|102[0-3])")
SECRET_USES = ("seal", "reveal-bytes")
# The engine's own bounds: a value of at most 64 KiB; a descriptor's writer must close it.
MAX_SECRET = 65_536
SECRET_READ_SECONDS = 5.0


class SecretError(ProjectError):
    """A slot that cannot be had: named by the slot and a kind of failure, never by a value."""
    def __init__(self, slot, failure, source=None):
        super().__init__(f"secret slot {slot}: {failure}" + (f" ({source})" if source else ""))


def read_secret_slots(document, grant=None):
    """The fixed secrets the executable's own grant document declares, in its order:
    {name: (use, from, [also_from...])}. A store table (`store = { TOKEN = "seal" }`) is not one:
    it has neither `use` nor `from` (the compiler's rule); `read_secret_store` reads those."""
    if document is None:
        return {}
    if grant is None:
        grant = tomllib.loads(read_control_file(document).decode("utf-8"))
    secrets = grant.get("secrets", {})
    if not isinstance(secrets, dict):
        raise ProjectError(f"{document}: [secrets] must be a table")
    declared = {}
    for name, entry in secrets.items():
        if not isinstance(entry, dict) or not ("use" in entry or "from" in entry):
            continue
        also = entry.get("also_from", [])
        if not SLOT.fullmatch(name) or not set(entry) <= {"use", "from", "also_from"} or entry.get("use") not in SECRET_USES \
                or not isinstance(entry.get("from"), str) or not isinstance(also, list) \
                or not all(isinstance(s, str) and SECRET_SOURCE.fullmatch(s) for s in [entry["from"], *also]):
            raise ProjectError(f"{document}: [secrets].{name} is not a fixed secret Grimoire can launch: "
                               f"{{ use = \"seal\" or \"reveal-bytes\", from = \"env:NAME\" or \"fd:N\", also_from = [...] }}")
        for source in [entry["from"], *also]:
            # Launcher configuration can reach a toolchain step and cannot also supply a secret.
            variable = source.partition(":")[2] if source.startswith("env:") else None
            if variable in LAUNCHER_ENVIRONMENT:
                raise SecretError(name, f"source {source} is a variable the toolchain is given")
            # The rest of WITCHY_ stays the toolchain's to name later: not a secret's either.
            if variable is not None and variable.startswith("WITCHY_"):
                raise SecretError(name, f"source {source} is a WITCHY_ variable, reserved for the toolchain")
        declared[name] = (entry["use"], entry["from"], list(also))
    return declared


# A `SecretStore`'s secrets (`main(store: SecretStore)`, `[secrets] store = { TOKEN = "seal" }`):
# each is the launch variable of its own name, read by Grimoire before anything runs and handed to
# the engine on a pipe of its own (`--secret-seal=TOKEN@fd:N`), as a fixed secret's is.
STORE_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]{0,63}")
STORE_USES = {"reveal": "--secret=", "seal": "--secret-seal="}


class StoreSecretError(ProjectError):
    """A store's secret that cannot be had: named by the secret and a kind of failure, never by a
    value (the engine's wording: `secret NAME: ...`)."""
    def __init__(self, name, failure, source=None):
        super().__init__(f"secret {name}: {failure}" + (f" ({source})" if source else ""))


def read_secret_store(document, declared, grant=None):
    """The store's secrets the executable's own grant document declares: {NAME: use}, from every
    `[secrets]` table that is not a fixed secret (`declared`). Each NAME is the launch variable
    it is read from, so it follows the rules of a fixed secret's `env:` source: not a variable
    the toolchain is given, not a WITCHY_ one, not one a slot also lists (one source, one route),
    and not ordinary environment through `[env]`. All of it is decided before anything runs."""
    if document is None:
        return {}
    if grant is None:
        grant = tomllib.loads(read_control_file(document).decode("utf-8"))
    store = {}
    for table, entries in grant.get("secrets", {}).items():
        if table in declared:
            continue
        if not isinstance(entries, dict):
            raise ProjectError(f"{document}: [secrets].{table} is neither a fixed secret nor a store's table of NAME = \"seal\" or \"reveal\"")
        for name, use in entries.items():
            if not STORE_NAME.fullmatch(name) or not isinstance(use, str) or use not in STORE_USES:
                raise ProjectError(f"{document}: [secrets].{table}.{name} is not a store's secret Grimoire can launch: "
                                   f"a variable name = \"seal\" or \"reveal\"")
            if name in store:
                raise StoreSecretError(name, "declared twice")
            if name in LAUNCHER_ENVIRONMENT:
                raise StoreSecretError(name, f"source env:{name} is a variable the toolchain is given")
            if name.startswith("WITCHY_"):
                raise StoreSecretError(name, f"source env:{name} is a WITCHY_ variable, reserved for the toolchain")
            for slot, (_, first, also) in declared.items():
                if f"env:{name}" in (first, *also):
                    raise StoreSecretError(name, f"source env:{name} is also slot {slot}'s source")
            store[name] = use
    # A variable granted as ordinary environment would reach the program through `Env` as well;
    # a slot's `env:` source either (the compiler and the engine refuse both, after the fetch).
    env = grant.get("env", {})
    ordinary = {item for entries in (env.values() if isinstance(env, dict) else ()) if isinstance(entries, list)
                for item in entries if isinstance(item, str)}
    for name in store:
        if name in ordinary:
            raise StoreSecretError(name, f"source env:{name} is also granted through [env]")
    for slot, (_, first, also) in declared.items():
        for source in (first, *also):
            if source.startswith("env:") and source[4:] in ordinary:
                raise SecretError(slot, f"source {source} is also granted through [env]")
    return store


def resolve_store(store, launch):
    """Every store secret's value, from the launch environment `main` took out of this process."""
    values = {}
    for name in store:
        if name not in launch:
            raise StoreSecretError(name, "missing input", f"env:{name}")
        if len(launch[name]) > MAX_SECRET:
            raise StoreSecretError(name, "input too large", f"env:{name}")
        values[name] = launch[name]
    return values


def select_secret_sources(declared, binds):
    """{slot: source}: each declared slot's `from`, or the one `--bind NAME=SOURCE` names, which
    must be among its declared `from` and `also_from`. Never a fallback to another source."""
    chosen = {}
    for text in binds:
        name, equals, source = text.partition("=")
        if not equals or not SLOT.fullmatch(name):
            raise ProjectError("--bind takes NAME=SOURCE, a secret slot and one of its declared sources")
        if name in chosen:
            raise SecretError(name, "selected twice")
        if name not in declared:
            raise SecretError(name, "not declared in the grant document's [secrets]")
        use, first, also = declared[name]
        if source not in (first, *also):
            # The source is a selector, never a value; say it only if it has a source's form.
            raise SecretError(name, "source not declared (neither from nor also_from)", source if SECRET_SOURCE.fullmatch(source) else None)
        chosen[name] = source
    for name, (_, first, _) in declared.items():
        chosen.setdefault(name, first)
    seen = {}
    for name, source in chosen.items():
        if source in seen:
            raise SecretError(name, f"source also selected for slot {seen[source]}", source)
        seen[source] = name
    # And by what each descriptor is: two numbers open on the same file or pipe would read one
    # secret into two slots, a sealed key into a reveal slot (review of 33face12).
    source_objects(chosen)
    return chosen


def source_objects(chosen):
    """{(device, inode): slot} for each selected `fd:` source this process was started with,
    refusing two slots on the same object. An `env:` source has no inode; a descriptor that was
    not inherited is left for `read_descriptor` to refuse."""
    objects = {}
    for name, source in chosen.items():
        if not source.startswith("fd:") or int(source[3:]) not in INHERITED_DESCRIPTORS:
            continue
        try:
            status = os.fstat(int(source[3:]))
        except OSError:
            raise SecretError(name, "unreadable descriptor", source) from None
        if (status.st_dev, status.st_ino) in objects:
            raise SecretError(name, f"source is the same file or pipe as slot {objects[(status.st_dev, status.st_ino)]}'s", source)
        objects[(status.st_dev, status.st_ino)] = name
    return objects


def source_files(chosen):
    """{slot: (device, inode)} for each selected `fd:` source that is a regular file, read while
    the descriptors are still open. The engine is given each value on a fresh pipe, so it cannot
    see the file behind it; `--secret-object=SLOT:DEVICE:INODE` tells it, and it then refuses
    every read, write, removal or rename of that file through any grant. An `env:` source and a
    pipe have no file. A wrong identity could only make the engine refuse more."""
    files = {}
    for name, source in chosen.items():
        if not source.startswith("fd:") or int(source[3:]) not in INHERITED_DESCRIPTORS:
            continue
        try:
            status = os.fstat(int(source[3:]))
        except OSError:
            raise SecretError(name, "unreadable descriptor", source) from None
        # Every descriptor source, not only a regular file: a named FIFO (or a device) has a
        # path that can be linked into a grant too, and the flag only ever adds refusals
        # (review of d7b03ec1). As the engine reads it: Rust widens st_dev with `as u64`.
        files[name] = (status.st_dev & 0xFFFF_FFFF_FFFF_FFFF, status.st_ino)
    return files


def take_launch_environment():
    """Every variable outside the launcher allowlist, as bytes, taken out of
    this process before anything else runs: its value is overwritten where the process was
    started with it (what `ps -E` and /proc/PID/environ show another process of the same user,
    such as a toolchain step), then it is unset. Grimoire reads nothing else of its environment;
    a secret's `env:` source is read from what this returns."""
    kept = lambda name: name in LAUNCHER_ENVIRONMENT
    taken = {key.decode("latin-1"): value for key, value in os.environb.items() if not kept(key.decode("latin-1"))}
    try:
        libc = ctypes.CDLL(None)
        if sys.platform == "darwin":
            libc._NSGetEnviron.restype = ctypes.POINTER(ctypes.POINTER(ctypes.POINTER(ctypes.c_char)))
            entries = libc._NSGetEnviron().contents
        else:
            entries = ctypes.POINTER(ctypes.POINTER(ctypes.c_char)).in_dll(libc, "environ")
        index = 0
        while entries[index]:
            text = ctypes.string_at(entries[index])
            name, equals, _ = text.partition(b"=")
            if equals and not kept(name.decode("latin-1")):
                ctypes.memset(ctypes.addressof(entries[index].contents) + len(name) + 1, 0, len(text) - len(name) - 1)
            index += 1
        # On Linux no process of the same user may read this one's memory or initial environment
        # (/proc/PID/mem, environ, ptrace), whatever the Yama setting: PR_SET_DUMPABLE (4) to 0.
        if sys.platform.startswith("linux") and libc.prctl(4, ctypes.c_ulong(0), ctypes.c_ulong(0), ctypes.c_ulong(0), ctypes.c_ulong(0)) != 0:
            raise OSError("prctl")
    except (OSError, AttributeError, ValueError) as error:
        # Fail closed (review of f052cf0): unset alone would leave every value where a step
        # this process starts can read it.
        raise ProjectError(f"cannot take the launch environment out of this process ({type(error).__name__})") from None
    for name in taken:
        os.environ.pop(name, None)
        os.unsetenv(name)
    return taken


def read_descriptor(slot, number, source):
    """Everything descriptor `number` holds, to its end, within the bounds. The descriptor is kept
    open until Grimoire exits (no child inherits it: every step and the engine are started with
    close_fds): a live pipe's identity cannot be reused, and on macOS a closed pipe's inode number
    soon is, so a stale `--secret-object` would match another slot's fresh pipe (review of
    925bb2d)."""
    if number not in INHERITED_DESCRIPTORS:
        raise SecretError(slot, "unreadable descriptor", source)
    try:
        value, until = b"", time.monotonic() + SECRET_READ_SECONDS
        while True:
            ready, _, _ = select.select([number], [], [], max(0.0, until - time.monotonic()))
            if not ready:
                raise SecretError(slot, "descriptor not closed in time", source)
            chunk = os.read(number, 65_536)
            if not chunk:
                return value
            value += chunk
            if len(value) > MAX_SECRET:
                raise SecretError(slot, "input too large", source)
    except OSError:
        raise SecretError(slot, "unreadable descriptor", source) from None


def resolve_secrets(declared, chosen, launch):
    """Every slot's value, read now, before anything is fetched or built: a variable from the
    launch environment `main` took out of this process (`take_launch_environment`), or a
    descriptor this process was started with."""
    values = {}
    for name, source in chosen.items():
        if source.startswith("env:"):
            if source[4:] not in launch:
                raise SecretError(name, "missing input", source)
            values[name] = launch[source[4:]]
        else:
            values[name] = read_descriptor(name, int(source[3:]), source)
        if len(values[name]) > MAX_SECRET:
            raise SecretError(name, "input too large", source)
    # A descriptor a declared source names and this run did not select is closed too.
    for _, first, also in declared.values():
        for source in (first, *also):
            if source.startswith("fd:") and source not in chosen.values() and int(source[3:]) in INHERITED_DESCRIPTORS:
                try:
                    os.close(int(source[3:]))
                except OSError:
                    pass
    return values


@contextlib.contextmanager
def closed_on_failure():
    """A list of descriptors, each closed if the block fails (its own exit included)."""
    held = []
    try:
        yield held
    except BaseException:
        for descriptor in held:
            os.close(descriptor)
        raise


def open_compiled_module(path, limit):
    """Return an owned descriptor and a bounded read of its exact module bytes."""
    with closed_on_failure() as held:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        held.append(descriptor)
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise ProjectError("the built module is not a regular file")
        with os.fdopen(os.dup(descriptor), "rb") as source:
            wire = source.read(limit + 1)
        if len(wire) > limit:
            raise ProjectError("the built module exceeds the module size limit")
        return descriptor, wire


def deliver_secrets(command, values, module):
    """Start the engine with its module, one pipe per secret and a separate lifeline.
    Only the launcher holds the lifeline's write end. Each secret is written after launch,
    then its pipe closes. `values` is keyed by ("slot", NAME) or ("store", NAME)."""
    with closed_on_failure() as held:
        pipes = {}
        for name in values:
            pipes[name] = os.pipe()
            held.extend(pipes[name])
        reading_lifeline, writing_lifeline = os.pipe()
        held.extend((reading_lifeline, writing_lifeline))
        arguments = command(lambda name: pipes[name][0])
        for name, (reading, _) in pipes.items():
            if not 3 <= reading <= 1023:
                raise (SecretError if name[0] == "slot" else StoreSecretError)(name[1], "no descriptor from 3 to 1023 to deliver it on")
        if not 3 <= reading_lifeline <= 1023:
            raise ProjectError("no descriptor from 3 to 1023 for the engine's lifeline")
        arguments.append(f"--lifeline=fd:{reading_lifeline}")
        # The program's output and the engine's own lines go to the operator's real streams:
        # the engine makes the program's output plain itself (or passes it raw, on the
        # operator's word), and it must be able to say its last line after this launcher is gone.
        streams = {"stdout": SHOWN[0], "stderr": SHOWN[1]} if SHOWN is not None else {}
        # Standard input reaches the engine only when the grant document gives it to `main`.
        granted_input = sys.stdin if "--input-stdin" in arguments else subprocess.DEVNULL
        process = subprocess.Popen(arguments, env={}, stdin=granted_input, **streams,
                                   pass_fds=(module, reading_lifeline, *(reading for reading, _ in pipes.values())))
    for reading, _ in pipes.values():
        os.close(reading)
    os.close(reading_lifeline)
    inputs = {name: os.fdopen(writing, "wb", buffering=0) for name, (_, writing) in pipes.items()}

    def write(name):
        try:
            with inputs[name] as pipe:
                view = memoryview(values[name])
                while view:
                    view = view[pipe.write(view):]
        except OSError:
            pass  # the engine stopped first, and says why

    # On a caught signal, ask the engine to stop and wait for it. If this process is killed,
    # the engine sees EOF on the lifeline and runs its own shutdown path.
    def stop(number, frame):
        raise KeyboardInterrupt
    previous = {}
    writers = [threading.Thread(target=write, args=(name,), daemon=True) for name in values]
    try:
        for number in (signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
            previous[number] = signal.signal(number, stop)
        for writer in writers:
            writer.start()
        code = process.wait()
    except KeyboardInterrupt:
        process.terminate()
        process.wait()
        code = 130
    finally:
        os.close(writing_lifeline)
        for number, handler in previous.items():
            signal.signal(number, handler)
        process.wait()
        for writer in writers:
            if writer.ident is not None:
                writer.join()
        for pipe in inputs.values():
            pipe.close()
    if code:
        raise subprocess.CalledProcessError(code, "witchy-wasmtime-host")


def tool(variable, name):
    requested = os.environ.get(variable, name)
    path = shutil.which(requested)
    if path is None:
        raise ProjectError(f"cannot execute {requested!r}. Set {variable} to the {name} binary")
    return os.path.abspath(path)


def project_path(base, value, field):
    if not isinstance(value, str) or not value or "\0" in value:
        raise ProjectError(f"{field} must name a file")
    return base / value


def read_control_file(path, *, nofollow=False):
    """Capture a regular control file without waiting for a pipe or reading beyond its bound."""
    flags = os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC
    if nofollow:
        flags |= os.O_NOFOLLOW
    with os.fdopen(os.open(path, flags), "rb") as stream:
        status = os.fstat(stream.fileno())
        if not stat.S_ISREG(status.st_mode):
            raise ProjectError(f"{path}: expected a regular control file")
        if status.st_size > CONTROL_FILE_BYTES:
            raise ProjectError(f"{path}: control file exceeds {CONTROL_FILE_BYTES} bytes")
        wire = stream.read(status.st_size + 1)
        if len(wire) != status.st_size or os.fstat(stream.fileno()).st_ctime_ns != status.st_ctime_ns:
            raise ProjectError(f"{path}: control file changed while being read")
        return wire


def read_optional_control_file(path):
    try:
        return read_control_file(path)
    except FileNotFoundError:
        return None


def write_control_update(path, wire, expected, operation):
    """Compare and publish under the directory lock shared by control file writers."""
    if len(wire) > CONTROL_FILE_BYTES:
        raise ProjectError(f"{path}: control file exceeds {CONTROL_FILE_BYTES} bytes")
    with tempfile.TemporaryDirectory(prefix=".grimoire-control-", dir=path.parent) as temp:
        staged = Path(temp) / path.name
        staged.write_bytes(wire)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            fcntl.flock(directory, fcntl.LOCK_EX)
            if read_optional_control_file(path) != expected:
                raise ProjectError(f"{path} changed during {operation}")
            if expected is None:
                try:
                    os.link(staged, path)
                except FileExistsError:
                    raise ProjectError(f"{path} changed during {operation}") from None
            else:
                os.replace(staged, path)
        finally:
            os.close(directory)


def read_manifest(manifest):
    return tomllib.loads(read_control_file(manifest).decode("utf-8"))


def read_limits(manifest, *, run=None):
    if run is None:
        run = read_manifest(manifest)["run"]
    return limits_policy.read_limits(run)


def read_project(manifest, *, project=None):
    if project is None:
        project = read_manifest(manifest)
    run = project.get("run")
    if not isinstance(run, dict):
        raise ProjectError(f"{manifest} needs a [run] table with an entry")
    entry = project_path(manifest.parent, run.get("entry"), "run.entry")
    grants = project.get("grants", {})
    if not isinstance(grants, dict):
        raise ProjectError("[grants] must be a table")
    for key, value in grants.items():
        if key == "document":
            continue
        if key not in ("allocator", "output") or not isinstance(value, bool):
            raise ProjectError(f"invalid [grants].{key}. Expected boolean allocator or output, or a document path")
    document = None
    if "document" in grants:
        document = project_path(manifest.parent, grants["document"], "grants.document")
    return entry, document, grants


# A [listen] grant binds one loopback address, written as the literal the engine binds: no name
# to resolve (`localhost` is whatever the resolver says), no wildcard, no other interface. The
# IPv6 one is `[::1]:PORT` in the document; its flag carries `::1:PORT`, the compiler's one
# spelling of it (brackets are glob characters in a flag, and the port follows the last `:`).
LOOPBACK_HOSTS = ("127.0.0.1", "::1")


def check_listener(address):
    """A `--listen=` flag the compiler proposed from the grant document: refused unless it is
    127.0.0.1 or ::1, exactly so written, with an explicit port from 1 to 65535, written plainly.
    Any other spelling of a loopback address (`[::1]`, `0:0:0:0:0:0:0:1`, `::ffff:127.0.0.1`,
    `127.1`) is not what the compiler writes, and is refused with every other address."""
    host, _, port = address.rpartition(":")
    if host not in LOOPBACK_HOSTS or not (port.isascii() and port.isdigit()) or str(int(port)) != port or not 1 <= int(port) <= 65535:
        raise ProjectError(f"listener {address!r}: a [listen] grant is a loopback address with an explicit port, 127.0.0.1:PORT or [::1]:PORT")


def listener_authority(address):
    """A `--listen=` flag's address as a URL and a `Host` header spell it: `[::1]:PORT`."""
    host, _, port = address.rpartition(":")
    return f"[{host}]:{port}" if ":" in host else address


def describe_sizes(sizes, run, flags):
    """The `limit:` lines of the module's own memory. The stack bounds every program; the heap
    and its slots bound an allocator, and set in the manifest for a run that has none they are
    refused, as a budget for any other grant the run does not have is."""
    pages, slots, stack = sizes
    lines = []
    if "--allocator" in flags:
        lines += [f"limit: heap: {pages * 65536 - 98304} bytes, in {pages} pages of 64 KiB of program memory (built into the module)",
                  f"limit: allocations: {slots} alive at once (built into the module)"]
    else:
        for key in ("heap-pages", "slots"):
            if key in run:
                raise ProjectError(f"[run].{key} bounds the allocator grant, and this run has none")
    lines.append(f"limit: stack: {stack} bytes of call frames (built into the module)")
    return lines


def describe_grants(flags, outside=None, outside_files=None):
    """One line for each flag the engine is given: everything the run may reach, and its limits.
    Made from the flags themselves, after every check and after anything Grimoire withholds or
    adds, so what is shown is what is granted. A secret is named with its use and where it is
    read from, never a value. A flag with no description here is shown as it is, not left out."""
    links = "--no-links" in flags
    rights = {"read": "read-only", "write": "write-only", "read,write": "read and write"}
    rights = rights[next((f.partition("=")[2] for f in flags if f.startswith("--dir-rights=")), "read")]
    lines = []
    each = PER_CONNECTION in flags
    for flag in flags:
        name, _, value = flag.partition("=")
        if flag == PER_CONNECTION:
            # Said in the listener's line.
            pass
        elif name == "--args":
            # The words are shown as given, each in quotes and escaped (`shown_word`).
            given = [f[len("--arg="):] for f in flags if f.startswith("--arg=")]
            most, _, room = value.partition(":")
            lines.append(f"grant: arguments: {len(given)} given after `--`" + (": " + " ".join(shown_word(word) for word in given) if given else
                         " (the words an operator writes after `--` at a launch are passed to main's Args, and to nothing else)"))
            lines.append(f"limit: arguments: at most {most} words, {room} bytes in all; a launch with more is refused")
        elif name == "--arg":
            pass
        elif name == "--listen" and each:
            lines.append(f"grant: connections: accepts connections on {listener_authority(value)} (loopback only) and runs the program once for each, "
                         "in a new instance that keeps nothing from the last; dials nothing")
        elif name == "--fuel" and each:
            lines.append(f"limit: each connection: stops after {value} instructions (that connection is closed; the server goes on)")
        elif name == "--connection-deadline-ms":
            lines.append(f"limit: each connection: stops after {value} ms (that connection is closed; the server goes on)")
        elif flag == "--output":
            lines.append("grant: output: the program writes its standard output")
        elif flag == "--allocator":
            lines.append("grant: allocator: heap memory inside the module")
        elif name == "--listen":
            lines.append(f"grant: listener: accepts connections on {listener_authority(value)} (loopback only), and dials nothing")
        elif name == "--dir":
            how = "no symbolic link followed, no other device entered" if links else "no other device entered"
            lines.append(f"grant: directory: {value}, {rights} ({how})" + (f", {outside}" if outside else ""))
        elif name in ("--dir-rights", "--stream-output", "--plain-output", "--dir-id", "--data-only", "--limit-name", "--input-id", "--usage"):
            # Said in the directory's line; and how output is passed on, not a grant.
            pass
        elif name == "--file":
            lines.append(f"grant: file: {value}, read-only" + (f", {outside_files[value]}" if value in (outside_files or {}) else ""))
        elif name == "--sqlite":
            lines.append(f"grant: SQLite database: {json.dumps(value, ensure_ascii=True)}, one transaction")
        elif name in ("--sqlite-read", "--sqlite-insert", "--sqlite-delete", "--sqlite-create"):
            lines.append(f"grant: SQLite tables: {name.removeprefix('--sqlite-')} {value}")
        elif name == "--sqlite-reply-bytes":
            lines.append(f"limit: SQLite reply: {value} bytes")
        elif name == "--input":
            lines.append(f"grant: input: {value}, read whole before the program starts" + (f", {outside_files[value]}" if value in (outside_files or {}) else ""))
        elif flag == "--input-stdin":
            lines.append("grant: input: this launch's standard input, read as the program asks for it")
        elif name == "--input-bytes" and value == "unlimited":
            lines.append('limit: input: UNLIMITED: no bound on the bytes read from standard input ([run] input-bytes = "unlimited"); the deadline and instructions still hold')
        elif name == "--input-bytes" and "--input-stdin" in flags:
            lines.append(f"limit: input: {value} bytes in all; the read past them ends the run")
        elif name == "--input-bytes":
            lines.append(f"limit: input: {value} bytes; a longer input is refused whole")
        elif flag == "--clock":
            lines.append("grant: clock: the time and timers")
        elif name == "--secret-slot":
            slot, use, source = value.split(":", 2)
            lines.append(f"grant: secret {slot}: {use}, read from {source}")
        elif name in ("--secret", "--secret-seal"):
            lines.append(f"grant: store secret {value}: {'read and sign' if name == '--secret' else 'sign only'}, read from the launch variable {value}")
        elif flag == "--no-links":
            if not any(f.startswith("--dir=") for f in flags):
                lines.append("grant: paths: no granted path goes through a symbolic link")
        elif flag == "--deadline-ms=none":
            lines.append("limit: no deadline: runs until it ends, is stopped, or its launcher ends")
        elif name == "--deadline-ms":
            lines.append(f"limit: stops after {value} ms")
        elif name == "--fuel-per-accept":
            lines.append(f"limit: stops after {value} instructions between accepted connections (the count starts again at each, and after each whole wait for one)")
        elif value == "unlimited" and name in ("--net-bytes", "--fs-bytes", "--fs-entries", "--output-bytes"):
            # Loud: the one budget an operator can write with no ceiling, and what still bounds it.
            what, key = {"--net-bytes": ("network", "net-bytes"), "--fs-bytes": ("files", "file-bytes"),
                         "--fs-entries": ("files", "file-entries"), "--output-bytes": ("output", "output-bytes")}[name]
            lines.append(f'limit: {what}: UNLIMITED for the whole run ([run] {key} = "unlimited"): only each connection\'s own {key}-per-connection bounds it')
        elif name == "--net-bytes":
            lines.append(f"limit: network: {value} bytes sent and received in the whole run")
        elif name == "--fs-bytes":
            lines.append(f"limit: files: {value} bytes read and written in the whole run")
        elif name == "--fs-entries":
            lines.append(f"limit: files: {value} files and directories made in the whole run (each one made or moved also costs 256 of the file bytes)")
        elif name == "--output-bytes":
            lines.append(f"limit: output: {value} bytes written in the whole run")
        elif name == "--net-bytes-per-connection":
            lines.append(f"limit: each connection: {value} bytes sent and received (that instance sends and receives no more; the server goes on)")
        elif name == "--fs-bytes-per-connection":
            lines.append(f"limit: each connection: {value} file bytes read and written (that instance reads and writes no more; the server goes on)")
        elif name == "--fs-entries-per-connection":
            lines.append(f"limit: each connection: {value} files and directories made (that instance makes no more; the server goes on)")
        elif name == "--output-bytes-per-connection":
            lines.append(f"limit: each connection: {value} output bytes (that connection is closed; the server goes on)")
        elif name == "--memory-pages":
            lines.append(f"limit: memory: {value} pages of 64 KiB, the program and its heap together")
        elif name == "--module-bytes":
            lines.append(f"limit: module: {value} bytes of code")
        elif name == "--fuel":
            lines.append(f"limit: stops after {value} instructions")
        elif flag == "--unmetered":
            lines.append("limit: instructions are not counted")
        else:
            lines.append(f"grant: {flag}")
    if not any(line.startswith("grant: ") for line in lines):
        lines.insert(0, "grant: nothing: the program reaches nothing outside itself")
    return lines


def check_directory(path, *, retain=False):
    """A `--dir=` flag's directory, before the build: an absolute path with no `.`, `..` or empty
    component, every component of which is a real directory, opened from `/` one at a time
    without following a link. The engine then opens it the same way (`--no-links`, which every
    directory grant gets), so a link swapped in after this check is refused there, not followed."""
    if not os.path.isabs(path) or os.path.normpath(path) != path or path.startswith("//"):
        raise ProjectError(f"granted directory {path}: not a plain absolute path (no `.`, `..` or empty component)")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
    held = os.open("/", flags)
    try:
        walked = ""
        for name in path.split("/")[1:] if path != "/" else []:
            walked += "/" + name
            try:
                inner = os.open(name, flags, dir_fd=held)
            except OSError:
                kind = "missing"
                try:
                    status = os.stat(name, dir_fd=held, follow_symlinks=False)
                    kind = "a symbolic link" if stat.S_ISLNK(status.st_mode) else "not a directory"
                except OSError:
                    pass
                raise ProjectError(f"granted directory {path}: {walked} is {kind}; a directory grant names real directories only, and no link is followed") from None
            os.close(held)
            held = inner
        # Never a descriptor-alias tree (/dev, /dev/fd, /proc), nor a directory holding one: a
        # name there opens a descriptor, a secret's pipe included. Compared by what was opened,
        # device and inode, so no spelling (`/DEV` on a case-insensitive volume, a mount) gets past.
        granted = os.fstat(held)
        for alias in DESCRIPTOR_ALIAS_TREES:
            try:
                tree = os.stat(alias)
            except OSError:
                continue
            if granted.st_dev == tree.st_dev:
                raise ProjectError(f"granted directory {path}: is in the descriptor-alias tree {alias}, refused")
            above = os.path.realpath(alias)
            while True:
                try:
                    status = os.stat(above)
                except OSError:
                    break
                if (status.st_dev, status.st_ino) == (granted.st_dev, granted.st_ino):
                    raise ProjectError(f"granted directory {path}: contains the descriptor-alias tree {alias}, refused")
                if above == "/":
                    break
                above = os.path.dirname(above)
        # On a local disk only: a network or automounted file system (`/net`, NFS, SMB) turns
        # a name opened in it into traffic off this machine (review of d5d6344).
        kind = filesystem_type(held)
        if kind not in LOCAL_FILESYSTEMS:
            raise ProjectError(f"granted directory {path}: is on a {kind or 'unknown'} file system; a directory grant is on a local disk only")
        # And nothing mounted below it: the engine's steps cross mount points, so an autofs or
        # network mount inside the tree (`/System/Volumes/Data/home`, a share in `/Volumes`)
        # would be reached through it (review of ceb5514). By identity, walking up from each
        # mount point's parent (never the mount point itself, which could trigger an automount),
        # so a firmlinked spelling (`/Users` for `/System/Volumes/Data/Users`) is caught too.
        mounts = mount_points()
        if mounts is None:
            raise ProjectError(f"granted directory {path}: this system's mount points cannot be listed, so the grant is refused")
        for mounted in mounts:
            above = os.path.dirname(mounted.rstrip("/")) or "/"
            while True:
                try:
                    status = os.stat(above)
                except OSError:
                    break
                if (status.st_dev, status.st_ino) == (granted.st_dev, granted.st_ino):
                    raise ProjectError(f"granted directory {path}: has a file system mounted below it ({mounted}), refused")
                if above == "/":
                    break
                above = os.path.dirname(above)
        return os.dup(held) if retain else granted
    finally:
        os.close(held)


def read_directory_grants(document, grant):
    """`[dirs]` of the executable's own document: NAME -> (root, rights), the rights as the
    engine spells them ("read", "write" or "read,write"), or None where the entry states none.
    A right this does not know is refused here, naming the entry, before the compiler is asked."""
    dirs = grant.get("dirs", {})
    if not isinstance(dirs, dict):
        raise ProjectError(f"{document}: [dirs] must be a table")
    declared = {}
    for name, entry in dirs.items():
        where = f"{document}: [dirs] {name}"
        if not isinstance(entry, dict) or not isinstance(entry.get("root"), str):
            raise ProjectError(f'{where}: a directory is `{{ root = "path", rights = ["Read"] }}`')
        declared[name] = (entry["root"], directory_rights(where, entry.get("rights")))
    return declared


def directory_rights(where, stated):
    """A directory entry's `rights`, as the engine spells them ("read", "write" or "read,write"),
    or None where the entry states none: one parser for a Wasm run's document and a native
    plan, so the two cannot read one entry differently."""
    if stated is None:
        return None
    if not isinstance(stated, list) or not stated:
        raise ProjectError(f'{where}: rights is a list: ["Read"], ["Write"] or ["Read", "Write"]')
    for right in stated:
        if right not in ("Read", "Write"):
            raise ProjectError(f'{where}: unsupported right {right!r}: a directory grant gives "Read", "Write" or both')
    if len(set(stated)) != len(stated):
        raise ProjectError(f"{where}: a right is stated twice")
    return ",".join(right.lower() for right in sorted(stated))


def identities_above(path):
    """The (device, inode) of `path` and of every directory above it, by its spelling and by
    where its links lead; what does not exist is passed over, so a path not yet made still
    gives the directories it would be made in."""
    found = set()
    for spelling in {os.path.abspath(path), os.path.realpath(path)}:
        while True:
            try:
                status = os.stat(spelling)
                found.add((status.st_dev, status.st_ino))
            except OSError:
                pass
            if spelling == "/":
                break
            spelling = os.path.dirname(spelling)
    return found


def check_writable_root(path, protected, stores):
    """A directory the run may write, after `check_directory`: it neither is nor contains any
    of `protected` (label -> path: what decides the next run's authority, and the tools that
    run it), and is not inside any of `stores` (label -> directory: state a tool keeps). A
    program that could write there could grant itself anything the next time it is run: add a
    line to its policy, replace its lock or its source, forge a trust record or a kept proof.
    By identity, device and inode, never by spelling; a path that does not exist yet protects
    the directories it would be made in."""
    status = os.stat(path)
    granted = (status.st_dev, status.st_ino)
    for label, guarded in list(protected.items()) + list(stores.items()):
        if granted in identities_above(guarded):
            raise ProjectError(f"granted directory {path}: writable, and it holds {label} ({guarded}): a program is never granted "
                               "write access to what decides its own authority or to the tools that check it; grant a directory of its own for data")
    above = identities_above(path)
    for label, store in stores.items():
        try:
            held = os.stat(store)
        except OSError:
            continue
        if (held.st_dev, held.st_ino) in above:
            raise ProjectError(f"granted directory {path}: writable, and it is inside {label} ({store}), refused")


VCS_ENTRIES = (".git", ".hg", ".svn", ".jj", ".bzr")
# The names of a granted directory, one rule for this scan and for the engine (`--data-only`;
# Witchy's docs/wasm-files.md, "Data names"). A data name: 1 to 255 bytes, each an ASCII letter,
# a digit, `-`, `_` or `.`, the first not `.`. A protected name: what a build reads, compared
# without ASCII case. The engine lets a program name only data names, and none that is
# protected where it may write; this scan refuses a writable directory that already holds a
# protected name or one with a character outside ASCII (which a file system may fold onto one).
DATA_NAME = re.compile(r"[A-Za-z0-9_-](?:[A-Za-z0-9._-]{0,253}[A-Za-z0-9_-])?")
ASCII_LOWER = str.maketrans("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz")


# The one hidden entry a writable granted directory may hold: the engine's staging directory,
# where it writes a file before renaming it into place, and what a run killed between the two
# leaves. No program can name it (it begins with `.`); the engine clears it before `main` runs
# and refuses one it did not make, by the checks `check_engine_staging` repeats here.
ENGINE_STAGING = ".witchy-staging"
ENGINE_SIBLING = re.compile(r"\..+\.witchy-[0-9]+-[0-9]+")


def check_engine_staging(root, where):
    """`where` is the engine's staging directory and nothing else: a real directory (not a
    link) on the granted directory's device, this user's, mode 0700 exactly. What it holds is
    not looked at here: a running engine's unfinished writes come and go there, so a look
    without the engine's lock refuses a healthy directory (review of 2026-11-22: 866 of 86,000
    scans beside a working engine). The engine judges the contents itself, under its lock,
    before `main` runs, and refuses anything it did not make."""
    def refused(why):
        return ProjectError(f"granted directory {root}: writable, and its {ENGINE_STAGING} {why}. The engine keeps its unfinished writes there and "
                            f"makes it as its own user's, mode 0700. Do not remove it while a run is using this directory; with none running, "
                            f"remove it (or `chmod 700` one that is yours) and launch again")
    try:
        status = os.lstat(where)
    except FileNotFoundError:
        return
    if not stat.S_ISDIR(status.st_mode) or status.st_dev != os.lstat(root).st_dev:
        raise refused("is not a directory on the granted directory's device")
    if status.st_uid != os.geteuid() or stat.S_IMODE(status.st_mode) & 0o077:
        raise refused("is not this user's alone (owner, and no group or other permission)")


def protected_name(name):
    """Whether a build reads a file of this name: a manifest, lock, policy, package list, grant
    document or Witchy source, whatever the case of its ASCII letters."""
    # Without trailing dots: some file systems open `a.wy.` as `a.wy`.
    name = name.rstrip(".").translate(ASCII_LOWER)
    return name in ("witchy.toml", LOCK) or name.endswith((".wy", ".policy", ".packages", ".grants.toml"))


def data_name(name, writable):
    """Whether the engine lets a program name this entry of a granted directory."""
    return DATA_NAME.fullmatch(name) is not None and not (writable and protected_name(name))
ROOT_ENTRIES = 100000


def same_place(path, other):
    """Whether two paths are one object now (device and inode); False where either is missing."""
    try:
        a, b = os.stat(path), os.stat(other)
    except OSError:
        return False
    return (a.st_dev, a.st_ino) == (b.st_dev, b.st_ino)


class TreeChanged(Exception):
    """An entry of a granted directory was gone between its listing and the look at it."""


SCAN_TRIES = 5


def scan_root(root, writable, protected):
    """`scan_tree`, on a tree that holds still for it. An entry that is listed and then gone
    (removed, or renamed to somewhere this pass may already have been) means the pass did not
    see the tree as it is: nothing is taken as clean on that pass. The whole scan starts again,
    a bounded number of times, and a tree that never settles is refused (fails closed; review
    of 2026-11-22: a vanished entry was skipped, so a directory moved mid-scan went unread).
    The engine's staging directory is not part of this: its contents are never listed here."""
    for attempt in range(SCAN_TRIES):
        try:
            return scan_tree(root, writable, protected)
        except TreeChanged:
            time.sleep(0.01 * (attempt + 1))  # a writer's burst is short: a moment, then look again
    raise ProjectError(f"granted directory {root}: it kept changing while it was checked ({SCAN_TRIES} passes): another program is writing to it. "
                       "Nothing is wrong with what it holds as far as was seen; launch again when it is quiet")


def scan_tree(root, writable, protected):
    """Everything in a granted directory, at launch, without following a link. Any directory:
    no version-control entry at any depth (its configuration holds credentials and, written,
    runs hooks). A writable one also: no entry at its top level whose name begins with `.`,
    but the engine's own staging directory, checked to be that (`check_engine_staging`);
    nothing named as a manifest, lock, policy, package list, grant document or Witchy source,
    in any case of its letters; no name with a character outside ASCII (a file system may
    resolve it as one of those, and the engine never makes one); and no entry that is one of
    the `protected` files under another name (a hard link)."""
    guarded = set()
    for path in protected.values():
        try:
            status = os.stat(path)
            guarded.add((status.st_dev, status.st_ino))
        except OSError:
            pass
    seen, pending = 0, [(root, True)]
    while pending:
        directory, top = pending.pop()
        try:
            listing = os.scandir(directory)
        except FileNotFoundError:
            if directory == root:
                raise
            raise TreeChanged(directory) from None
        with listing as entries:
            for entry in entries:
                seen += 1
                if seen > ROOT_ENTRIES:
                    raise ProjectError(f"granted directory {root}: holds more than {ROOT_ENTRIES} entries, too many to check before a run")
                name, where = entry.name, os.path.join(directory, entry.name)
                if name in VCS_ENTRIES:
                    raise ProjectError(f"granted directory {root}: it holds version-control state ({where}), refused: grant a directory of data alone")
                if writable:
                    if top and name == ENGINE_STAGING:
                        check_engine_staging(root, where)
                        continue
                    if top and name.startswith("."):
                        if ENGINE_SIBLING.fullmatch(name):
                            raise ProjectError(f"granted directory {root}: writable, and it holds {where}: an unfinished write of an engine older than "
                                               f"2026-11-22, which kept them beside the data; remove it once (the engine now keeps and clears its own, in {ENGINE_STAGING})")
                        raise ProjectError(f"granted directory {root}: writable, and it holds {where}: a writable directory holds no entry whose name begins with `.`")
                    if not name.isascii():
                        raise ProjectError(f"granted directory {root}: writable, and it holds {where}: a name with a character outside ASCII, which a file system "
                                           "may resolve as another name (a manifest's, a lock's); the engine makes no such name, so rename or remove it")
                    if protected_name(name):
                        raise ProjectError(f"granted directory {root}: writable, and it holds {where}: a program is never granted write access to "
                                           "a manifest, lock, policy, package list, grant document or source; grant a directory of its own for data")
                    try:
                        status = entry.stat(follow_symlinks=False)
                    except FileNotFoundError:
                        raise TreeChanged(where) from None
                    if (status.st_dev, status.st_ino) in guarded:
                        raise ProjectError(f"granted directory {root}: writable, and {where} is a protected file under another name, refused")
                try:
                    if entry.is_dir(follow_symlinks=False):
                        pending.append((where, False))
                except FileNotFoundError:
                    raise TreeChanged(where) from None


def check_root_place(root, writable, manifest, protected, stores, allowed, launching):
    """Where a granted directory may be, after `check_directory` (so `root` is spelled without a
    link). The rule is positive: a directory strictly inside the project directory (the one
    holding the manifest), on its device, with no component below the project beginning with
    `.`. Anything else needs the operator's word at this launch: `--allow-write-root ROOT` or
    `--allow-read-root ROOT` on the command line, exactly this root, never a document's or a
    dependency's, never remembered. Either way: not `/`, not the home directory or the
    temporary directory nor anything holding them, nothing of `scan_root`, and (for writing) the
    protected paths. Returns (None for a root inside the project, or the words its `grant:` line
    adds for one outside; the device and inode of the directory examined, which the engine is
    told so that it runs only on that very directory)."""
    kind = "write" if writable else "read"
    project = str(manifest.parent)
    home, temporary = os.path.expanduser("~"), tempfile.gettempdir()
    for label, place in (("the file system's root", "/"), ("the home directory", home), ("the temporary directory", temporary)):
        if same_place(project, place):
            raise ProjectError(f"granted directory {root}: the project directory {project} is {label}: no directory is granted to a project kept there; give it a directory of its own")
        status = os.stat(root)
        if (status.st_dev, status.st_ino) in identities_above(place):
            raise ProjectError(f"granted directory {root}: it is or holds {label} ({place}), refused")
    inside = root.startswith(project.rstrip("/") + "/")
    below = root[len(project.rstrip("/")) + 1:] if inside else root
    hidden = next((part for part in below.split("/") if part.startswith(".")), None)
    if hidden is not None:
        raise ProjectError(f"granted directory {root}: the component {hidden} begins with `.`: no hidden directory is granted")
    if inside and os.stat(root).st_dev != os.stat(project).st_dev:
        raise ProjectError(f"granted directory {root}: not on the project directory's device, refused")
    said = None
    if not inside:
        flag = f"--allow-{kind}-root"
        if root in allowed.get(kind, ()):
            said = f"OUTSIDE the project, named by the operator at this launch ({flag})"
        elif launching:
            what = "is the project directory itself" if root == project.rstrip("/") else "is outside the project directory"
            raise ProjectError(f"granted directory {root}: it {what} ({project}). A grant document grants a directory strictly inside its project; "
                               f"any other needs the operator's word at each launch: `grimoire run {flag} {root}`")
        else:
            said = f"OUTSIDE the project: a run is refused unless its command line names it, `grimoire run {flag} {root}`"
    examined = os.stat(root)
    scan_root(root, writable, protected)
    if writable:
        check_writable_root(root, protected, stores)
    return said, (examined.st_dev, examined.st_ino)


def check_file_place(granted, what, manifest, allowed, launching):
    """Where a single granted file (`[files]`, or an `[input]` file) may be: the same rule as a
    granted directory's (`check_root_place`). A grant document grants, on its own word, only a
    file inside its project directory, with no component beginning with `.`, that is not a
    manifest, lock, policy, package list, grant document or Witchy source (by name), and that
    is inside the project where it really is (a link out of the project is outside). Any other
    file (`/etc/hosts`, a key under the home directory) needs the operator's word at this
    launch: `--allow-read-file PATH`, exactly the path the document names, never remembered.
    With it or without, never Grimoire's or Coven's state. Returns None for a file inside the
    project, or the words its `grant:` line adds."""
    project = os.path.realpath(manifest.parent)
    real = os.path.realpath(granted)
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    for label, store in (("Grimoire's state (the trust store)", state / "grimoire"), ("Coven's state", state / "coven"), ("Coven's module cache", cache / "coven")):
        held = os.path.realpath(store)
        if real == held or real.startswith(held.rstrip("/") + "/"):
            raise ProjectError(f"granted {what} {granted}: it is in {label}, refused")
    inside = real.startswith(project.rstrip("/") + "/") and os.path.normpath(granted).startswith(os.path.normpath(str(manifest.parent)).rstrip("/") + "/")
    if inside:
        below = real[len(project.rstrip("/")) + 1:]
        hidden = next((part for part in below.split("/") if part.startswith(".")), None)
        if hidden is not None:
            raise ProjectError(f"granted {what} {granted}: the component {hidden} begins with `.`: no hidden file is granted")
        if protected_name(os.path.basename(real)) or protected_name(os.path.basename(granted)):
            raise ProjectError(f"granted {what} {granted}: a manifest, lock, policy, package list, grant document or source is not data a program is granted; "
                               "grant a file of data")
        return None
    if granted in allowed:
        return "OUTSIDE the project, named by the operator at this launch (--allow-read-file)"
    if launching:
        raise ProjectError(f"granted {what} {granted}: it is outside the project directory ({manifest.parent}). A grant document grants a file inside its project; "
                           f"any other needs the operator's word at each launch: `grimoire run --allow-read-file {granted}`")
    return f"OUTSIDE the project: a run is refused unless its command line names it, `grimoire run --allow-read-file {granted}`"


def declared_sqlite_flags(document, grant):
    if "sqlite" not in grant:
        return []
    entries = grant["sqlite"]
    if not isinstance(entries, dict) or len(entries) != 1:
        raise ProjectError(f"{document}: [sqlite] must name one database parameter")
    name, settings = next(iter(entries.items()))
    error = f"{document}: [sqlite] {name}"
    if not isinstance(settings, dict) or not isinstance(settings.get("file"), str) or not settings["file"]:
        raise ProjectError(f"{error}: expected a database file")
    file = settings["file"]
    if any(ord(char) < 32 or ord(char) == 127 for char in file):
        raise ProjectError(f"{error}: database file contains a control character")
    flags = [f"--sqlite={document.parent / file}"]
    if "reply_bytes" in settings:
        size = settings["reply_bytes"]
        if type(size) is not int or not 1 <= size <= 2_097_152:
            raise ProjectError(f"{error}: reply_bytes must be an integer from 1 to 2097152")
        flags.append(f"--sqlite-reply-bytes={size}")
    rights = set(settings) - {"file", "reply_bytes"}
    if not rights or not rights <= {"read", "insert", "delete", "create"} or ("create" in rights and len(rights) != 1):
        raise ProjectError(f"{error}: name read, insert or delete tables, or grant create separately")
    for right in sorted(rights):
        tables = settings[right]
        if (not isinstance(tables, list) or not 1 <= len(tables) <= 16
                or any(not isinstance(table, str) or not re.fullmatch(r"[a-z][a-z0-9_]{0,63}", table)
                       or table.startswith("sqlite_") for table in tables)
                or len(set(tables)) != len(tables)):
            raise ProjectError(f"{error}: {right} must name 1 to 16 distinct SQLite tables")
        flags.append(f"--sqlite-{right}={','.join(tables)}")
    return flags


def check_sqlite_files(database, manifest, protected, stores):
    # SQLite may touch its journal and WAL alongside the named file. The engine
    # checks private ownership, links and secret inodes at launch and transaction.
    project = manifest.parent.resolve()
    for suffix in ("", "-journal", "-wal", "-shm"):
        path = database + suffix
        if path != os.path.realpath(path):
            raise ProjectError(f"granted SQLite file {shown_word(path)} needs an absolute path without links or aliases")
        if Path(path) == project or not Path(path).is_relative_to(project):
            raise ProjectError(f"granted SQLite file {shown_word(path)} must be inside the project directory")
        check_file_place(path, "SQLite file", manifest, (), True)
        for label, wanted in protected.items():
            if path == os.path.realpath(wanted) or same_place(path, wanted):
                raise ProjectError(f"granted SQLite file {shown_word(path)} is {label}")
        for label, root in stores.items():
            if Path(path).is_relative_to(os.path.realpath(root)):
                raise ProjectError(f"granted SQLite file {shown_word(path)} is in {label}")


def protected_paths(manifest, entry, document, tools, *, project=None):
    """What a writable directory grant may not hold: (files and trees by label, tool state by label)."""
    protected = {"the project's manifest": manifest, "the project's lock": manifest.parent / LOCK,
                 "the executable's entry": entry, "the executable's policy": entry.with_suffix(".policy"),
                 "the executable's package list": entry.with_suffix(".packages")}
    if document is not None:
        protected["the executable's grant document"] = document
    # Every source the build may read: the entry's tree, and each checkout package's file.
    for index, source in enumerate(sorted(entry.parent.rglob("*.wy"))):
        protected.setdefault(f"the project's source {source.relative_to(entry.parent)}", source)
    listing = entry.with_suffix(".packages")
    for line in listing.read_text().splitlines() if listing.is_file() else []:
        line = line.split("#")[0].strip()
        if ":" in line:
            head, target = line.split(":", 1)
            protected[f"the package {head.split()[0]}'s source"] = listing.parent / target.split(";")[0].strip()
    for label, tool_path in tools.items():
        if tool_path:
            protected[label] = Path(tool_path)
    # The toolchain's own inputs, wherever the launch environment puts them.
    for variable in ("WITCHY_WASM_READY_BINDING", "WITCHY_LEAN_BIN", "WITCHY_WASM_LEAN_ROOT", "WITCHY_WASM_NATIVE_HELPER", "SSL_CERT_FILE"):
        if os.environ.get(variable):
            protected[f"the toolchain's {variable}"] = Path(os.environ[variable])
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    stores = {"Grimoire's state (the trust store)": state / "grimoire", "Coven's state": state / "coven",
              "Coven's module cache": cache / "coven"}
    # Grimoire itself and the modules it loads beside it: never in a writable root. (Not "nor
    # inside its directory": a project kept under the installation, an example run in place,
    # may be granted a data directory of its own there.)
    protected["Grimoire"] = Path(__file__).resolve()
    if os.environ.get("WITCHY_PROOF_CACHE"):
        stores["the proof cache"] = Path(os.environ["WITCHY_PROOF_CACHE"])
    # Where Grimoire stages what it builds from, and what runs Grimoire.
    protected["the temporary directory"] = Path(tempfile.gettempdir())
    protected["the home directory"] = Path.home()
    protected["the Python that runs Grimoire"] = Path(os.path.realpath(sys.executable))
    try:
        if project is None:
            project = read_manifest(manifest)
        registry = project.get("registry")
        if isinstance(registry, dict) and isinstance(registry.get("path"), str):
            stores["the project's registry"] = manifest.parent / registry["path"]
            protected["the project's registry"] = manifest.parent / registry["path"]
        if isinstance(registry, dict) and registry.get("protocol") == "tuf":
            fields = {"root": "the TUF root", "trust": "the TUF release trust file", "ca-file": "the registry CA file"}
            for field, label in fields.items():
                if isinstance(registry.get(field), str):
                    protected[label] = manifest.parent / registry[field]
            if "ca-file" not in registry and str(registry.get("url", "")).startswith("https://"):
                from ssl import get_default_verify_paths
                if default_ca := get_default_verify_paths().cafile:
                    protected["the default registry CA file"] = Path(default_ca)
    except (OSError, tomllib.TOMLDecodeError):
        pass
    return protected, stores


# The file systems a directory grant may be on, by the kernel's name (macOS) or magic (Linux).
LOCAL_FILESYSTEMS = ("apfs", "hfs", "ext2/3/4", "xfs", "btrfs", "tmpfs", "zfs", "overlay")
LINUX_MAGIC = {0xEF53: "ext2/3/4", 0x58465342: "xfs", 0x9123683E: "btrfs", 0x01021994: "tmpfs", 0x2FC12FC1: "zfs", 0x794C7630: "overlay"}


def filesystem_type(descriptor):
    """The type of the file system holding an open descriptor, or None when it cannot be told
    (which refuses the grant): `fstatfs` on macOS (its type name, and only when the volume is
    marked local) and Linux (its magic number)."""
    import ctypes
    libc = ctypes.CDLL(None, use_errno=True)
    buffer = ctypes.create_string_buffer(4096)
    if sys.platform == "darwin":
        call = getattr(libc, "fstatfs$INODE64", None) or libc.fstatfs
        if call(descriptor, buffer) != 0:
            return None
        # struct statfs (64-bit inodes): f_flags at 64, f_fstypename[16] at 72. MNT_LOCAL 0x1000.
        flags = int.from_bytes(buffer.raw[64:68], sys.byteorder)
        name = buffer.raw[72:88].split(b"\0", 1)[0].decode("ascii", "replace")
        return name if flags & 0x1000 else f"non-local {name}"
    if sys.platform.startswith("linux"):
        if libc.fstatfs(descriptor, buffer) != 0:
            return None
        # struct statfs: f_type, a long, first.
        return LINUX_MAGIC.get(int.from_bytes(buffer.raw[:ctypes.sizeof(ctypes.c_long)], sys.byteorder) & 0xFFFFFFFF)
    return None


def mount_points():
    """Where each file system is mounted, or None when that cannot be listed (which refuses the
    grant): `getfsstat` on macOS, /proc/self/mountinfo on Linux."""
    import ctypes
    if sys.platform == "darwin":
        libc = ctypes.CDLL(None, use_errno=True)
        call = getattr(libc, "getfsstat$INODE64", None) or libc.getfsstat
        size = 2168  # struct statfs (64-bit inodes); f_mntonname[1024] at 88
        count = call(None, 0, 2)  # MNT_NOWAIT
        if count < 0:
            return None
        buffer = ctypes.create_string_buffer(size * (count + 16))
        count = call(buffer, len(buffer), 2)
        if count < 0:
            return None
        return [buffer.raw[i * size + 88:i * size + 88 + 1024].split(b"\0", 1)[0].decode("utf-8", "surrogateescape") for i in range(count)]
    if sys.platform.startswith("linux"):
        try:
            lines = Path("/proc/self/mountinfo").read_text(errors="surrogateescape").splitlines()
        except OSError:
            return None
        decode = lambda field: re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), field)
        return [decode(line.split(" ")[4]) for line in lines if len(line.split(" ")) > 4]
    return None


# Trees whose names open descriptors (a secret's pipe among them): never in a directory grant.
DESCRIPTOR_ALIAS_TREES = ("/dev", "/dev/fd", "/proc")


class Registry(str):
    """The registry directory; whether every package from it must be signed; the owners the
    project's author declared (`[owners]`: {name: (owner, recovery or None)}); whether every
    package must have a declared owner or a lock pin (`owners-required`), which leaves nothing to
    trust on first use; and the registry operator's key the author declared (`operator`), which
    must sign the registry's snapshot, with the registry identifier (`id`) its snapshots name."""
    def __new__(cls, path, signed, owners=None, owners_required=False, operator=None, registry_id=None):
        made = super().__new__(cls, str(path))
        made.signed, made.owners, made.owners_required, made.operator, made.registry_id = signed, owners or {}, owners_required, operator, registry_id
        return made


class TufRegistry:
    """Explicitly provisioned TUF distribution and release trust."""

    def __init__(self, base, config):
        required = {"protocol", "url", "id", "root", "root-pin", "trust", "trust-pin"}
        if not required <= config.keys() or not config.keys() <= required | {"ca-file", "ca-pin", "resolution-deadline-ms"}:
            raise ProjectError("[registry] protocol = \"tuf\" requires url, id, root, root-pin, trust and trust-pin")
        self.url, self.registry_id = config["url"], config["id"]
        if not isinstance(self.url, str) or not self.url.startswith(("https://", "http://127.0.0.1:")):
            raise ProjectError("[registry] TUF requires an HTTPS origin or explicit loopback test port")
        if not isinstance(self.registry_id, str) or not REGISTRY_ID.fullmatch(self.registry_id):
            raise ProjectError("[registry] invalid TUF registry id")
        self.root_pin, self.trust_pin = config["root-pin"], config["trust-pin"]
        if not all(isinstance(pin, str) and DIGEST.fullmatch(pin) for pin in (self.root_pin, self.trust_pin)):
            raise ProjectError("[registry] TUF trust files require explicit SHA-384 pins")
        self.root = project_path(base, config["root"], "registry.root")
        self.trust = project_path(base, config["trust"], "registry.trust")
        self.ca_file = project_path(base, config["ca-file"], "registry.ca-file") if "ca-file" in config else None
        self.ca_pin = config.get("ca-pin")
        if "ca-pin" in config and (not self.url.startswith("https://")
                or not isinstance(self.ca_pin, str) or not DIGEST.fullmatch(self.ca_pin)):
            raise ProjectError("[registry] ca-pin requires an HTTPS origin and an explicit SHA-384 pin")
        self.resolution_deadline_ms = config.get("resolution-deadline-ms", DEFAULT_TUF_RESOLUTION_MS)
        if (type(self.resolution_deadline_ms) is not int
                or not 1 <= self.resolution_deadline_ms <= 2_147_483_647):
            raise ProjectError("[registry] resolution-deadline-ms must be an integer from 1 to 2147483647")

    def identity(self):
        return {"url": self.url, "id": self.registry_id, "root-pin": self.root_pin, "trust-pin": self.trust_pin}

    def mirror_arguments(self, *, ca_pin=None):
        if ca_pin is not None and self.ca_pin is not None and ca_pin != self.ca_pin:
            raise ProjectError("HTTPS CA bundle differs from the manifest pin")
        ca_pin = ca_pin or self.ca_pin
        arguments = ["--registry", self.url, "--id", self.registry_id,
                     "--root", self.root, "--root-pin", self.root_pin,
                     "--trust", self.trust, "--trust-pin", self.trust_pin]
        if self.ca_file is not None:
            arguments += ["--ca-file", self.ca_file]
        if ca_pin is not None:
            arguments += ["--ca-pin", ca_pin]
        return arguments


def registry_url(value):
    if not isinstance(value, str) or not (match := re.fullmatch(r"http://127\.0\.0\.1:([1-9][0-9]{0,4})/?", value)) or int(match[1]) > 65535:
        raise ProjectError("registry URL must be http://127.0.0.1:PORT")
    return value.rstrip("/")


def registry_identity(registry):
    return str(registry) if str(registry).startswith("http://") else str(Path(registry).resolve())


def read_dependencies(manifest, *, project=None):
    """The registry directory and {name: exact version}, or (None, {}) without dependencies."""
    if project is None:
        project = read_manifest(manifest)
    dependencies = project.get("dependencies", {})
    if not isinstance(dependencies, dict):
        raise ProjectError("[dependencies] must be a table of name = \"MAJOR.MINOR.PATCH\"")
    if not dependencies:
        return None, {}
    registry = project.get("registry")
    for name, version in dependencies.items():
        if not NAME.fullmatch(name):
            raise ProjectError(f"invalid package name {name!r}")
        if not isinstance(version, str) or not VERSION.fullmatch(version):
            raise ProjectError(f"{name} = {version!r}: a dependency names an exact MAJOR.MINOR.PATCH version")
    if isinstance(registry, dict) and registry.get("protocol") == "tuf":
        if "owners" in project:
            raise ProjectError("TUF publisher authority comes from the pinned release trust file")
        return TufRegistry(manifest.parent, registry), dependencies
    if not isinstance(registry, dict) or len({"path", "url"} & registry.keys()) != 1 or not set(registry) <= {"path", "url", "signed", "owners-required", "operator", "id"} \
            or not isinstance(registry.get("signed", False), bool) or not isinstance(registry.get("owners-required", False), bool):
        raise ProjectError("[dependencies] need [registry] url (or a local path), and operator = \"witchy-2:...\", "
                           "signed = true and owners-required = true")
    operator = registry.get("operator")
    if operator is not None:
        operator_pin(operator, "[registry] operator")
    registry_id = registry.get("id")
    if (operator is None) != (registry_id is None) or not (registry_id is None or isinstance(registry_id, str) and REGISTRY_ID.fullmatch(registry_id)):
        raise ProjectError("[registry] operator and id go together: the operator's key ID and the registry identifier its snapshots name")
    # The owners the author expects, from outside the registry: the anchor a new machine has
    # before any lock (`name = "witchy-2:..."` or `name = { owner = "witchy-2:...", recovery = ... }`).
    owners = {}
    declared = project.get("owners", {})
    if not isinstance(declared, dict):
        raise ProjectError("[owners] is a table of name = \"witchy-2:...\" or name = { owner = \"witchy-2:...\", recovery = \"witchy-2:...\" or \"none\" }")
    for name, value in declared.items():
        owner, recovery = (value, None) if isinstance(value, str) else (value.get("owner"), value.get("recovery")) if isinstance(value, dict) and set(value) <= {"owner", "recovery"} else (None, None)
        for pin in (owner, recovery):
            if retired_pin(pin):
                key_pin(pin, f"[owners] {name}:", "the owner's")
        if not NAME.fullmatch(name) or not isinstance(owner, str) or not KEY_ID.fullmatch(owner) \
                or not (recovery is None or recovery == "none" or isinstance(recovery, str) and KEY_ID.fullmatch(recovery)):
            raise ProjectError(f"[owners] {name}: an owner's key ID, witchy-2:..., and optionally its recovery key's, or none")
        owners[name] = (owner, recovery)
    if "url" in registry and not operator:
        raise ProjectError("a Coven URL requires a pinned operator and registry id")
    location = registry_url(registry["url"]) if "url" in registry else project_path(manifest.parent, registry["path"], "registry.path")
    return Registry(location, registry.get("signed", False) or "url" in registry,
                    owners, registry.get("owners-required", False), operator, registry_id), dependencies


def read_lock_bytes(lock, wire=READ_LOCK_FROM_DISK):
    """None records an absent lock. A supplied snapshot never reopens the path."""
    if wire is not READ_LOCK_FROM_DISK:
        return wire
    return read_optional_control_file(lock)


def load_lock(lock, wire):
    wire = read_lock_bytes(lock, wire)
    return None if wire is None else tomllib.loads(wire.decode("utf-8"))


def parse_lock(lock, *, wire=READ_LOCK_FROM_DISK):
    """{name: (version, digest, requires)} from witchy.lock, or None when there is none.

    `requires` is the package's own exact requirements, as `NAME VERSION` strings: the edges of
    the graph, recorded so a reader sees which package brought each one in.
    """
    document = load_lock(lock, wire)
    if document is None:
        return None
    if "tuf" in document:
        raise ProjectError(f"{lock} pins a TUF registry; explicitly replace the lock to switch registries")
    packages = document.get("package", [])
    locked = {}
    for entry in packages if isinstance(packages, list) else [None]:
        if not isinstance(entry, dict) or set(entry) != {"name", "version", "digest", "requires", "signer", "recovery", "index"}:
            raise ProjectError(f"{lock}: each [[package]] has a name, version, digest, requires, signer, recovery and index")
        # A lock from before the witchy-2 profile: none of its pins can verify a witchy-2
        # registry, and none is dropped silently or compared as another algorithm's (no
        # downgrade). It is refused whole, and the user locks again.
        old = next(filter(None, (retired_pin(entry[field]) for field in ("digest", "signer", "recovery"))), None)
        if old:
            raise relock(lock, f"package {entry['name']!r} is pinned by {old}")
        name, version, digest, requires, signer = entry["name"], entry["version"], entry["digest"], entry["requires"], entry["signer"]
        index, recovery = entry["index"], entry["recovery"]
        if type(index) is not int or index < 0 or (index == 0) != (signer == "unsigned"):
            raise ProjectError(f"{lock}: package {name!r} has an invalid index: the sequence of a signed package's index, 0 if unsigned")
        if not isinstance(recovery, str) or not (recovery == "none" or SIGNER.fullmatch(recovery) and recovery != "unsigned") \
                or (signer == "unsigned" and recovery != "none"):
            raise ProjectError(f"{lock}: package {name!r} has an invalid recovery: a key ID, or none")
        if not isinstance(signer, str) or not SIGNER.fullmatch(signer):
            raise ProjectError(f"{lock}: package {name!r} has an invalid signer")
        if not isinstance(name, str) or not NAME.fullmatch(name) or not isinstance(version, str) or not VERSION.fullmatch(version):
            raise ProjectError(f"{lock}: package {name!r} has an invalid name or version")
        if name in locked or not isinstance(digest, str) or not DIGEST.fullmatch(digest):
            raise ProjectError(f"{lock}: package {name!r} is listed twice or has an invalid digest")
        if not isinstance(requires, list) or not all(isinstance(r, str) for r in requires):
            raise ProjectError(f"{lock}: package {name!r} has invalid requires")
        locked[name] = (version, digest, requires, signer, index, recovery)
    return locked


def read_tuf_lock(lock, registry, *, wire=READ_LOCK_FROM_DISK, refresh_ca_pin=False):
    wire = read_lock_bytes(lock, wire)
    if wire is None:
        return None, None, None
    document = tomllib.loads(wire.decode("utf-8"))
    identity = registry.identity()
    pinned = document.get("tuf")
    if ("snapshot" in document or not isinstance(pinned, dict)
            or pinned.keys() - {"ca-pin"} != identity.keys() | {"snapshot", "snapshot-version"}
            or any(pinned[key] != value for key, value in identity.items())):
        raise ProjectError(f"{lock} pins a different registry or trust policy; explicitly replace the lock to change it")
    if "ca-pin" in pinned:
        ca_pin = pinned["ca-pin"]
        if not registry.url.startswith("https://") or not isinstance(ca_pin, str) or not DIGEST.fullmatch(ca_pin):
            raise ProjectError(f"{lock}: invalid HTTPS CA bundle pin")
        if registry.ca_pin is None:
            raise ProjectError(f"{lock} pins the HTTPS CA bundle. Restore ca-pin in the manifest")
        if ca_pin != registry.ca_pin and not refresh_ca_pin:
            raise ProjectError(f"{lock} pins a different HTTPS CA bundle. Run `grimoire lock` to verify the new pin")
    snapshot, version = pinned["snapshot"], pinned["snapshot-version"]
    if not isinstance(snapshot, str) or not DIGEST.fullmatch(snapshot) or not valid_snapshot_version(version):
        raise ProjectError(f"{lock}: invalid TUF snapshot pin")
    rows = document.get("package")
    if not isinstance(rows, list):
        raise ProjectError(f"{lock}: missing TUF package pins")
    packages = {}
    for row in rows:
        if not isinstance(row, dict) or row.keys() != {"name", "version", "digest", "requires", "publisher", "target"}:
            raise ProjectError(f"{lock}: invalid TUF package pin")
        name, exact, requires = row["name"], row["version"], row["requires"]
        if (not isinstance(name, str) or not NAME.fullmatch(name) or name in packages
                or not isinstance(exact, str) or not VERSION.fullmatch(exact)
                or not isinstance(requires, list) or not all(isinstance(item, str) for item in requires)
                or not all(isinstance(row[key], str) and DIGEST.fullmatch(row[key]) for key in ("digest", "publisher", "target"))):
            raise ProjectError(f"{lock}: invalid TUF package pin for {name!r}")
        packages[name] = (exact, row["digest"], requires, row["publisher"], row["target"])
    return packages, (snapshot, version), "sha384:" + hashlib.sha384(wire).hexdigest()


def valid_snapshot_version(version):
    return type(version) is int and 1 <= version < 2**53


def read_lock_snapshot(lock, *, wire=READ_LOCK_FROM_DISK):
    """The lock's `[snapshot]`: (the operator key that signed the snapshot it was made from, that
    snapshot's sequence, the registry identifier it names), or None."""
    pinned = (load_lock(lock, wire) or {}).get("snapshot")
    if pinned is None:
        return None
    if not isinstance(pinned, dict) or set(pinned) != {"operator", "sequence", "registry"} or type(pinned["sequence"]) is not int \
            or pinned["sequence"] < 1 or not isinstance(pinned["registry"], str) or not REGISTRY_ID.fullmatch(pinned["registry"]):
        raise ProjectError(f"{lock}: [snapshot] has the registry operator's key ID, operator = \"witchy-2:...\", the snapshot's sequence and the registry identifier")
    if retired_pin(pinned["operator"]):
        # A lock made before the witchy-2 profile: its pin and floor are of a suite no longer
        # accepted, so they anchor nothing. Refused, not passed over.
        raise relock(lock, f"[snapshot] pins operator {pinned['operator']}, {retired_pin(pinned['operator'])}")
    operator_pin(pinned["operator"], f"{lock}: [snapshot] operator")
    return pinned["operator"], pinned["sequence"], pinned["registry"]


def relock(lock, why):
    """The refusal of a lock made before the witchy-2 profile."""
    return ProjectError(f"{lock} was made before the witchy-2 profile ({why}): no pin of it verifies a witchy-2 registry. "
                        f"Remove it and lock again (`grimoire lock`) against a witchy-2 registry, declaring the new keys in "
                        f"witchy.toml ([registry] operator, [owners])")


def file_digest(path):
    with open(path, "rb") as stream:
        return "sha384:" + hashlib.file_digest(stream, "sha384").hexdigest()


TOOLS = {"compiler": ("WITCHYC", "witchyc"), "host": ("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")}


def host_libraries(host):
    """{file name: digest} of the libraries the host loads from its own directory: the AWS-LC FIPS
    crypto module, a separate file on macOS. The host's own digest does not cover them, so a pin
    of the host alone would let that file be swapped."""
    # The directory the host's loader uses: its real one, not a symlink's (automated review of
    # 7a47e57: a host reached through a link pinned the wrong directory's file).
    folder = Path(os.path.realpath(host)).parent
    return {entry.name: file_digest(entry) for entry in sorted(folder.glob("libaws_lc_fips_*crypto*"))
            if entry.suffix in (".dylib", ".so") or ".so." in entry.name}


def read_toolchain(lock, *, wire=READ_LOCK_FROM_DISK):
    """The `[toolchain]` pins of witchy.lock: {"compiler": digest, "host": digest}, or None."""
    pinned = (load_lock(lock, wire) or {}).get("toolchain")
    if pinned is None:
        return None
    libraries = pinned.get("host-libraries", {}) if isinstance(pinned, dict) else None
    tools = {k: v for k, v in pinned.items() if k != "host-libraries"} if isinstance(pinned, dict) else None
    if tools is not None and isinstance(libraries, dict) and any(retired_pin(d) for d in [*tools.values(), *libraries.values()]):
        raise relock(lock, "[toolchain] is pinned by sha256 digests")
    if tools is None or set(tools) != set(TOOLS) or not all(isinstance(d, str) and DIGEST.fullmatch(d) for d in tools.values()) \
            or not isinstance(libraries, dict) or not all(isinstance(n, str) and "/" not in n and isinstance(d, str) and DIGEST.fullmatch(d) for n, d in libraries.items()):
        raise ProjectError(f"{lock}: [toolchain] pins `compiler` and `host` by digest, and optionally `host-libraries`")
    return {**tools, "host-libraries": dict(libraries)}


def check_toolchain(manifest, *, lock_bytes=READ_LOCK_FROM_DISK):
    """Refuse, before anything is compiled, a compiler or host other than the lock pins."""
    pinned = read_toolchain(manifest.parent / LOCK, wire=lock_bytes)
    for role, (variable, name) in TOOLS.items():
        if pinned and file_digest(tool(variable, name)) != pinned[role]:
            raise ProjectError(f"{LOCK} pins the {role} at {pinned[role]}, and {tool(variable, name)} is not it: "
                               f"use that {role}, or re-pin with `grimoire lock --toolchain`")
    if pinned and host_libraries(tool(*TOOLS["host"])) != pinned["host-libraries"]:
        raise ProjectError(f"{LOCK} pins the host's libraries {pinned['host-libraries'] or '(none)'}, and the host's directory "
                           f"holds {host_libraries(tool(*TOOLS['host'])) or '(none)'}: re-pin with `grimoire lock --toolchain`")


def read_release(into, name, version, digest):
    """The release Coven fetched into `into` (`package`, then `source.wy`), read again here.

    Its two files must hash to `digest`, the one Coven verified against the registry's signed
    record and the lock, and must be the canonical release of this name and version: a registry
    cannot serve one package's files as another's. A release of several files must hold exactly
    the files its record lists, each with its digest, under a path inside the package, and
    nothing its entry does not import (witchy_release.py). Nothing is compiled from a release
    this refuses.
    """
    codec = release_format()
    parts = []
    for part in ("package", "source.wy"):
        try:
            handle = os.open(into / part, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        except OSError:
            raise ProjectError(f"{name} {version}: the fetched package has no `{part}`") from None
        with os.fdopen(handle, "rb") as stream:
            if not stat.S_ISREG(os.fstat(handle).st_mode):
                raise ProjectError(f"{name} {version}: the fetched package's `{part}` is not a file")
            parts.append(stream.read(codec.PAYLOAD_BYTES + 1))
    if "sha384:" + hashlib.sha384(parts[0] + parts[1]).hexdigest() != digest:
        raise ProjectError(f"{name} {version}: the fetched package is not the one verified ({digest})")
    try:
        return codec.parse(parts[0], parts[1], name, version)
    except codec.ReleaseError as error:
        raise ProjectError(f"{name} {version}: the registry's release is refused: {error}") from None


class Staged:
    """One fetched release as a build reads it: `entry`, the file `import "@NAME"` means, in
    `root`, the directory that holds only the package's files. Both formats are written
    from the verified release bytes into a new directory before the compiler reads them."""

    def __init__(self, name, version, release, into):
        self.name, self.version, self.release = name, version, release
        try:
            self.root = Path(release_format().extract(release, into, "files"))
        except ValueError as error:
            raise ProjectError(f"{name} {version}: {error}") from None
        self.entry = self.root / release.entry

    def files(self):
        """[(the name a policy holds the file by, its bytes)]: `@NAME` for the entry and
        `@NAME/PATH` for every other file, as the compiler names them."""
        return [(f"@{self.name}" if path == self.release.entry else f"@{self.name}/{path}", data) for path, data in self.release.files]


class Graph(dict):
    """A resolved graph, {name: (version, digest, requires, directory, signer, index, recovery)},
    with each package's release as staged for a build (`staged[name]`). TUF packages
    store the publisher fingerprint in the signer field. The graph keeps their
    sealed target digests, authenticated snapshot, HTTPS CA pin and input lock digest."""

    def __init__(self):
        super().__init__()
        self.staged = {}
        self.tuf_targets = {}
        self.tuf_snapshot = None
        self.tuf_ca_pin = None
        self.tuf_lock_digest = None


def check_signer(registry, name, version, signer, pinned, frozen):
    """A package keeps its owner. The lock pins its owner key (any version), and Coven, given that
    pin, admits only a package owned by it or by a key it was handed to by a verified rotation; a
    package unsigned after a signed one is refused until its author removes it from the lock on
    purpose. A rotation is reported, and recorded by the next lock."""
    if getattr(registry, "signed", False) and signer == "unsigned":
        raise ProjectError(f"{name} {version} is unsigned, and witchy.toml asks for signed packages ([registry] signed = true)")
    if pinned is None:
        return
    before = pinned[3]
    if before != "unsigned" and signer == "unsigned":
        raise ProjectError(f"{name} {version} is unsigned, and {LOCK} has {name} {describe(before)}: if the change of "
                           f"publisher is expected, remove {name} from {LOCK} and lock again")
    if frozen and before == "unsigned" and signer != before:
        raise ProjectError(f"{name} {version} is now {describe(signer)}, and {LOCK} has it unsigned: run `grimoire lock`")
    if before != "unsigned" and signer != before:
        say(f"{name} was handed by its owner {before} to {signer} (a rotation Coven verified)"
              + ("; `grimoire lock` records it" if frozen else ""))


def check_withdrawn(name, version, withdrawn, kept):
    """A revoked version is refused everywhere. A yanked one is refused for a new pin, and kept,
    with a warning, where the lock already has it: a yank stops new use without breaking builds."""
    if withdrawn is None:
        return
    state, reason = withdrawn
    if state == "revoked":
        raise ProjectError(f"{name} {version} is revoked by its publisher: {reason}")
    if not kept:
        raise ProjectError(f"{name} {version} is yanked by its publisher: {reason}. Choose another version")
    say(f"warning: {name} {version} is yanked by its publisher: {reason}")


def describe(signer):
    return "unsigned" if signer == "unsigned" else f"signed by {signer}"


class TrustStore:
    """What this machine has verified of one registry's packages, kept outside every project and
    the registry, under an exclusive lock while a graph resolves (the research handoff's returning
    consumer). Per package:
      owners       the verified owner-key chain, only ever extended (at either end) unless replaced;
      recovery     its recovery key (a package's never changes), or none;
      index        the highest index sequence verified (a floor);
      retired      every key this machine verified handing the package on: never accepted as its
                   owner again, across projects, stale locks and `grimoire trust --forget`;
                   Each was verified under the entry's recovery key (a package's never
                   changes), so when a forgotten or first-use entry is re-anchored by a project
                   stating another recovery key, all of them go: they came from a record the
                   project contradicts (reviews of 349b07e and e7ebfaf: a poisoned first use,
                   confirmed by its own lock, kept the honest owner refused past a forget);
      provisional  the entry came from a first use, with no lock or declaration behind it.
    And the versions seen revoked, and the registry's operator (`operator`): its verified key
    chain (`keys`, only extended), the keys seen handing the role on and to whom (`retired`, key ->
    successor, or None where this machine no longer knows the successor), the keys a verified
    chain showed before the record's first key (`before`, key -> the keys it may hand the role
    to: the rest of the first chain that showed it, and the record's keys then; no successor of
    theirs is recorded, since only a project's anchor vouched for those links), the keys a record
    without the provenance marker named (`unestablished`: accepted only where a project pins one),
    the hand-overs such a record recorded (`handover`, key -> the keys it may hand the role to) and
    the keys it held retired or before it (`handed_on`: they sign nothing until the user
    re-establishes one), the highest
    snapshot sequence verified per key (`floors`) and unkeyed (`unkeyed`), and whether it came
    from a first use. Each record is written with `provenance` (OPERATOR_PROVENANCE). (This replaced conflict flags and their rules after ten review
    rounds: one refusal of retired keys and one check that a verified chain continues the stored
    one cover rollback, forks and poisoned first use.)"""

    def __init__(self, registry):
        base = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "grimoire" / "trust"
        base.mkdir(parents=True, exist_ok=True)
        # The file's name only (not a pin): kept as it was, so a record from before the witchy-2
        # profile is found and set aside, never mistaken for no record at all.
        self.path = base / (hashlib.sha256(registry_identity(registry).encode()).hexdigest()[:24] + ".json")
        self.held = os.open(base / ".lock", os.O_CREAT | os.O_WRONLY, 0o600)
        fcntl.flock(self.held, fcntl.LOCK_EX)
        try:
            known = json.loads(self.path.read_text()) if self.path.exists() else {"packages": {}, "revoked": {}}
            self.packages, self.revoked = {}, dict(known["revoked"])
            # A store an earlier Grimoire wrote has no operator yet.
            self.operator = known.get("operator")
            held = self.operator
            # Every record written from e77e23b's rules on carries the provenance marker; one
            # without it is migrated below, once (it is saved marked).
            marked = isinstance(held, dict) and "provenance" in held
            migrated = False
            if marked:
                if held["provenance"] not in (1, OPERATOR_PROVENANCE) or type(held["provenance"]) is not int:
                    raise ValueError("operator provenance")
                interim = held["provenance"] == 1
                held = self.operator = {key: value for key, value in held.items() if key != "provenance"}
                # A marked record was written under e77e23b's rules, and no load may weaken a
                # constraint this machine recorded: it may only add constraints or change wording.
                # So nothing of a marked record's retirements is deleted (review of a7a0169).
                # Records marked 1 (0620e18 to 112159d): a key set aside before the record with no
                # key to hand the role to (`before: []`) retires with no successor, the same
                # constraint in today's form (it never signs and hands the role to no one).
                if interim and isinstance(held.get("retired"), dict) and isinstance(held.get("before"), dict):
                    held = self.operator = {**held, "retired": {**{key: None for key, was in held["before"].items() if was == []}, **held["retired"]},
                                            "before": {key: was for key, was in held["before"].items() if was != []}}
                    migrated = True
                as_loaded = held
            if not marked and isinstance(held, dict) and isinstance(held.get("keys"), list) and isinstance(held.get("retired"), list) \
                    and held["keys"] + held["retired"] and all(isinstance(k, str) and retired_pin(k) for k in held["keys"] + held["retired"]):
                # Verified when the operator signed with ssh-keygen or witchy-1: no key of it can
                # sign a snapshot Coven accepts now (witchy-2 only), so the record anchors nothing. It is
                # set aside, and the operator is anchored again by a project's declaration.
                # Kept as forgotten, with its registry identifier, never as no record: a first use
                # is then refused here, as after `--forget-operator`, and a project must declare
                # the operator (review: as `None`, `--trust-first-use` took a writer's own key
                # and registry). Its single floor (`snapshot`) is of the old suite's snapshots, which
                # restart. What it holds of witchy-2 keys is kept, and taken through the steps below
                # as any record without provenance (review of e33b81e: rebuilt from nothing, it lost
                # them): its `before` keys and their hand-overs, its unestablished keys, its floors
                # per witchy-2 key, and its unkeyed floor. An older-suite key signs nothing now, so
                # dropping one, or one a key may hand the role to, refuses no less. A malformed
                # value is kept as it is, and refused below.
                say(f"{self.path}: the registry operator recorded here signed before the witchy-2 profile; set aside as forgotten (witchy-2 only now)")
                current = lambda value: [key for key in value if not retired_pin(key)] if isinstance(value, list) else value
                before, floors = held.get("before", {}), held.get("floors", {})
                if isinstance(before, dict):
                    before = {key: current(was) for key, was in before.items() if not retired_pin(key)}
                if isinstance(floors, dict):
                    floors = {key: floor for key, floor in floors.items() if not retired_pin(key)}
                self.operator = {"keys": [], "retired": {}, "before": current(before), "floors": floors, "unkeyed": held.get("unkeyed", 0), "provisional": True,
                                 "source": "first-use", **({"unestablished": current(held["unestablished"])} if "unestablished" in held else {}),
                                 "registry": held.get("registry") if isinstance(held.get("registry"), str) and REGISTRY_ID.fullmatch(held["registry"]) else None}
            if self.operator is not None:
                held = self.operator
                # The chain an unmarked record holds, before an older step below sets it aside
                # (no `source`): every key it named is set aside too (review of 0620e18).
                chain = list(held["keys"]) if not marked and isinstance(held, dict) and isinstance(held.get("keys"), list) else []
                # A record an earlier Grimoire wrote has one floor (`snapshot`) for the whole record:
                # it moves onto each key the record held, the keys it was raised under. A record
                # forgotten before the upgrade holds no key, and its floor stays `unkeyed`: it binds
                # every chain, as it did then, until the user drops it (`trust --forget-unkeyed-floor`).
                # Moved onto the next chain verified instead, it would go to whichever key a cloned
                # project anchors first, and an older snapshot of the honest key would then pass.
                if isinstance(held, dict) and "snapshot" in held and "floors" not in held:
                    floor, keys = held["snapshot"], held.get("keys")
                    if type(floor) is not int or floor < 0 or not isinstance(keys, list) or not all(isinstance(k, str) for k in keys):
                        raise ValueError("operator")
                    held = self.operator = {**{k: v for k, v in held.items() if k != "snapshot"}, "floors": {key: floor for key in keys if floor > 0},
                                            "unkeyed": 0 if keys else floor}
                if isinstance(held, dict) and "unkeyed" not in held:
                    held = self.operator = {**held, "unkeyed": 0}  # written before unkeyed floors
                # A record an earlier Grimoire wrote lists its retired keys without their successors.
                # A successor its chain still shows is kept; one it no longer shows (forgotten, or a
                # replaced first use) is unknown, and that key may then hand the role on to no one:
                # fail closed, so a project declares the current operator directly (review of
                # ef0fdb0: after `--forget-operator`, a stolen retired key handed the role to a thief).
                if isinstance(held, dict) and isinstance(held.get("retired"), list):
                    keys = held.get("keys") if isinstance(held.get("keys"), list) else []
                    if not all(isinstance(k, str) for k in keys + held["retired"]):
                        raise ValueError("operator")
                    successors = dict(zip(keys, keys[1:]))
                    held = self.operator = {**held, "retired": {key: successors.get(key) for key in held["retired"]}}
                # A record an earlier Grimoire wrote has no `source`, and nothing tells whether a
                # first use or a project's anchors made it: d028c5c and 101f2b4 marked a project's
                # record `provisional` too. Kept as forgotten (fail closed), with its retired keys and
                # its keys' floors, never as a first use that `--trust-first-use` would anchor on
                # (adversarial review of e2280af: a cloned project's writer key vouched for one).
                if isinstance(held, dict) and "source" not in held:
                    if held.get("keys"):
                        say(f"{self.path}: the registry operator recorded here does not say whether a first use or a project "
                              f"made it; set aside as forgotten: a project declares the operator again")
                    retired = held.get("retired")
                    if marked and isinstance(retired, dict):
                        # A marked record never lacked `source`: no constraint of it is dropped. Its
                        # chain's hand-overs and the keys before it retire with no successor, as a
                        # forget does, and its unestablished keys stay so (review of f96d1fe).
                        chain, was_before = held.get("keys", []), held.get("before", [])
                        if not isinstance(chain, list) or not isinstance(was_before, (dict, list)):
                            raise ValueError("operator")  # malformed: fail closed (review of 40defaf)
                        retired = {**{key: None for key in [*chain[:-1], *was_before]}, **retired}
                    held = self.operator = {"keys": [], "retired": retired, "before": {}, "floors": held.get("floors"), "unkeyed": held.get("unkeyed"), "provisional": True,
                                            "source": "first-use", "registry": None,
                                            **({key: held[key] for key in ("unestablished", "handover", "handed_on") if key in held} if marked else {})}
                if isinstance(held, dict) and "before" not in held:
                    held = self.operator = {**held, "before": {}}  # written before `before` was kept
                # A list of keys before the record (5f467cd to d439eca) does not say which record each
                # was before, and a replace may have carried it past that one: each retires with an
                # unknown successor (fail closed), and a project declares the current operator.
                if isinstance(held, dict) and isinstance(held.get("before"), list) and isinstance(held.get("retired"), dict):
                    if not all(isinstance(k, str) for k in held["before"]):
                        raise ValueError("operator")
                    held = self.operator = {**held, "retired": {**{key: None for key in held["before"]}, **held["retired"]}, "before": {}}
                # Decision (settled with Astra): a record that cannot establish where its operator
                # keys came from has the operator pinned again. Before e77e23b a project's chain
                # could fix operator successors and set a whole `keys` chain here, and nothing in
                # such a record tells those from links this machine's own record verified;
                # `--forget-operator` kept them, so a stolen key's history refused your projects
                # pinned to that key for good. A record without the provenance marker therefore
                # keeps only its floors (per key and unkeyed): its keys and successors are
                # dropped, and every key it named is `unestablished`. Such a key is accepted in a
                # verified chain only where this project pins it explicitly ([registry] operator or
                # the lock's pin), for that resolve only; never through a first use, an extend, or a
                # chain the registry's files or a cloned project imply. A pin may start a fresh
                # record (holding only the signer, under e77e23b's rules), but the key stays
                # unestablished for every other project until the user runs `grimoire trust
                # --reestablish-operator KEY`. It fixes no successor. The refusals name no key
                # (none was verified independently).
                if not marked and isinstance(held, dict) and isinstance(held.get("retired"), dict) and isinstance(held.get("before"), dict):
                    # A key before the record hands the role only to the keys listed: a value that
                    # is not a list says nothing of where, and skipped, the key handed the role on
                    # unconstrained (review of e33b81e). Malformed: fail closed.
                    if not all(isinstance(was, list) for was in held["before"].values()):
                        raise ValueError("operator before")
                    # Its floors' keys too: an earlier `--forget-operator` dropped the keys and kept
                    # their floors (review of a9a5b25: a forgotten record's newest key passed).
                    floors = held.get("floors") if isinstance(held.get("floors"), dict) else {}
                    named = [*chain, *(held.get("keys") or []), *held["retired"], *(to for to in held["retired"].values() if to is not None),
                             *held["before"], *(key for was in held["before"].values() for key in was), *floors,
                             *(held.get("unestablished") if isinstance(held.get("unestablished"), list) else [])]
                    named = list(dict.fromkeys(named))
                    if named:
                        say(f"{self.path}: the registry operator record here was written before Grimoire marked where its keys "
                              f"came from; set aside: its {len(named)} key(s) are accepted again only where a project pins one, its "
                              f"floors are kept, and a project pins the operator again")
                    # Decision (coordinator, by the never-weaken rule): every successor the record
                    # holds stays a constraint on where its key may hand the role on (`handover`, key
                    # -> the keys it may hand the role to; [] for none). So a pin of the honest
                    # current key, which has no recorded successor, works with no rotation, and a
                    # planted A -> T refuses A -> B, even pinned or re-established: that project pins
                    # the current operator directly.
                    # Decision (coordinator, review of e33b81e): a key the record holds retired, or
                    # before the record, also keeps the signing refusal it had there (`handed_on`).
                    # Without it, after an honest A -> B a thief holding A signed a snapshot alone, at
                    # or above A's floor, and a project whose stale lock pins A took it. A project's
                    # pin never lifts it: only the user's `grimoire trust --reinstate-signer KEY`.
                    # Non-final keys of its chain too: the record's literal meaning is that they handed
                    # the role on (honest writers also retired them; fail closed for one that did not).
                    handed_on = list(dict.fromkeys([*held["retired"], *held["before"], *chain[:-1], *(held.get("keys") or [])[:-1]]))
                    # Each key may hand the role only to a key every one of its recorded constraints
                    # allows: their intersection, [] where they share none. Never a union (review of
                    # 0e2125b: a retirement and a wider `before` list merged let A hand the role to a
                    # key its retirement refused), nor one constraint chosen over the others (review
                    # of e33b81e: with A -> B in its chain and A retired to X, or before the record
                    # with [X], the one dropped no longer refused). A retirement to None allows no one.
                    allowed = {}
                    for key, was in held["before"].items():
                        allowed.setdefault(key, []).append(was)
                    for links in (zip(held.get("keys") or [], (held.get("keys") or [])[1:]), zip(chain, chain[1:]), held["retired"].items()):
                        for key, to in links:
                            allowed.setdefault(key, []).append([] if to is None else [to])
                    handover = {key: [to for to in dict.fromkeys(first) if all(to in other for other in rest)] for key, (first, *rest) in allowed.items()}
                    held = self.operator = {**held, "keys": [], "retired": {}, "before": {}, "unestablished": named, "handover": handover,
                                            "handed_on": handed_on, "provisional": True, "source": "first-use"}
                    migrated = True
                if isinstance(held, dict) and "unestablished" not in held:
                    held = self.operator = {**held, "unestablished": []}  # an older step above rebuilt the record
                if isinstance(held, dict) and "handover" not in held:
                    held = self.operator = {**held, "handover": {}}  # written before `handover`
                if isinstance(held, dict) and "handed_on" not in held:
                    # Written before `handed_on` (0e2125b to e33b81e migrated without it): every key
                    # given a hand-over then had a recorded successor and signs nothing until the
                    # user re-establishes it. A record without hand-overs adds none.
                    handover = held["handover"] if isinstance(held["handover"], dict) else {}
                    held = self.operator = {**held, "handed_on": list(handover)}
                    migrated = True
                if marked:
                    # Every marked record, after the older shape steps above, so that one in an older
                    # shape is converted first and this sees its retirements (review of a7a0169).
                    # 0620e18 to d52db7b fixed some successors from or onto keys only a pin accepted:
                    # such a retirement keeps its key retired, with no successor, so the key still
                    # hands the role to no one and no unestablished key is a fixed successor. Refusals
                    # word it without naming an unestablished key.
                    loose = held.get("unestablished", []) if isinstance(held, dict) else []
                    if not isinstance(loose, list) or not all(isinstance(key, str) for key in loose):
                        raise ValueError("operator unestablished")
                    if isinstance(held, dict) and isinstance(held.get("retired"), dict):
                        cleaned = {key: (None if key in loose or to in loose else to) for key, to in held["retired"].items()}
                        # d52db7b recorded nothing for a link of the record onto an unestablished key: its
                        # key retires with no successor, as a resolve now does (review of a7a0169).
                        chain = held.get("keys") if isinstance(held.get("keys"), list) else []
                        for key, successor in zip(chain, chain[1:]):
                            if key not in loose and successor in loose:
                                cleaned.setdefault(key, None)
                        if cleaned != held["retired"]:
                            held = self.operator = {**held, "retired": cleaned}
                            migrated = True
                    if held is not as_loaded:
                        migrated = True  # saved once, in today's shape
                if not isinstance(held, dict) or set(held) != {"keys", "retired", "before", "floors", "unkeyed", "provisional", "registry", "source", "unestablished", "handover", "handed_on"} \
                        or not isinstance(held["handed_on"], list) or not all(isinstance(k, str) and OPERATOR_KEY.fullmatch(k) for k in held["handed_on"]) \
                        or not isinstance(held["handover"], dict) or not all(isinstance(k, str) and OPERATOR_KEY.fullmatch(k) and isinstance(v, list)
                                                                             and all(isinstance(t, str) and OPERATOR_KEY.fullmatch(t) for t in v) for k, v in held["handover"].items()) \
                        or not isinstance(held["unestablished"], list) or not all(isinstance(k, str) and OPERATOR_KEY.fullmatch(k) for k in held["unestablished"]) \
                        or type(held["unkeyed"]) is not int or held["unkeyed"] < 0 \
                        or held["source"] not in ("first-use", "project") \
                        or not (held["registry"] is None or isinstance(held["registry"], str) and REGISTRY_ID.fullmatch(held["registry"])) \
                        or not isinstance(held["keys"], list) or not isinstance(held["retired"], dict) \
                        or not isinstance(held["before"], dict) \
                        or not all(isinstance(v, list) and v and all(isinstance(k, str) and OPERATOR_KEY.fullmatch(k) for k in v) for v in held["before"].values()) \
                        or not all(isinstance(k, str) and OPERATOR_KEY.fullmatch(k) for k in held["keys"] + list(held["retired"]) + list(held["before"])) \
                        or not all(v is None or isinstance(v, str) and OPERATOR_KEY.fullmatch(v) for v in held["retired"].values()) \
                        or not isinstance(held["floors"], dict) or not all(isinstance(k, str) and OPERATOR_KEY.fullmatch(k) and type(v) is int and v >= 0
                                                                           for k, v in held["floors"].items()) \
                        or not isinstance(held["provisional"], bool):
                    raise ValueError("operator")
            for name, held in dict(known["packages"]).items():
                owners = held["owners"]
                # An entry an earlier Grimoire wrote: its handed-on keys are retired.
                retired = held.get("retired", owners[:-1] if isinstance(owners, list) else None)
                provisional = held.get("provisional", bool(held.get("forgotten")))
                # A conflict an earlier Grimoire flagged migrates as forgotten: its disputed chain is
                # not followed, and a lock or declaration must anchor it again (reviews of 7bedcf3).
                if held.get("conflict") is True and "provisional" not in held:
                    owners, provisional = [], True
                # Owners verified before the witchy-2 profile (SSH fingerprints): no key of them
                # signs an index Coven accepts now, so they anchor nothing, and their floor is of
                # a registry that restarts. Set aside as forgotten, as the operator's: a project's
                # lock or declaration anchors the package again.
                if isinstance(owners, list) and isinstance(retired, list) and any(retired_pin(o) for o in [*owners, *retired, held.get("recovery")]):
                    say(f"{self.path}: the owners of {name} recorded here signed before the witchy-2 profile; set aside as forgotten")
                    owners, retired, provisional, held = [], [], True, {**held, "recovery": "none", "index": 0}
                if not NAME.fullmatch(name) or not isinstance(owners, list) or not isinstance(retired, list) or type(held["index"]) is not int \
                        or not all(isinstance(o, str) and KEY_ID.fullmatch(o) for o in owners + retired) \
                        or not (held["recovery"] == "none" or KEY_ID.fullmatch(held["recovery"])) or not isinstance(provisional, bool):
                    raise ValueError(name)
                self.packages[name] = {"owners": owners, "recovery": held["recovery"], "index": held["index"], "retired": retired, "provisional": provisional}
        except (OSError, ValueError, KeyError, TypeError) as error:
            self.close()
            raise ProjectError(f"{self.path} is not a trust store Grimoire wrote ({error}): move it aside to start again") from None
        self.registry = registry_identity(registry)
        if migrated:
            self.save()  # the migration runs once, whatever the command

    def raise_floor(self, name, index):
        if name in self.packages:
            self.packages[name]["index"] = max(index, self.packages[name]["index"])

    def accept(self, name, owners, recovery, index, anchored, confirmed=False):
        # `confirmed`: an anchor stated the recovery key, which then equals `recovery` (checked by
        # the caller). Only a stated key replaces or unwinds what the store holds: one the registry
        # served does not (automated review of fcc40a0).
        """Record a chain Coven verified and every check accepted: the keys before the stored first
        owner and after the newest are added, or the chain replaces a forgotten entry or a first use an anchored
        resolve contradicted (dropping what that first use taught). Its handed-on keys retire."""
        held = self.packages.get(name)
        replace = held is None or not held["owners"] or (held["provisional"] and ((confirmed and recovery != held["recovery"]) or (anchored and held["owners"][-1] not in owners)))
        if replace:
            # A replacement of a first use stays provisional: one project's lock or declaration does
            # not make its chain this machine's trusted record (automated review of 7bedcf3); a
            # later anchored resolve that extends it does. A forgotten entry the user re-anchors
            # becomes trusted when the anchor states the recovery key too (automated reviews of
            # 9ceaff3 and 1d1bb93).
            keep = held is not None and not held["owners"]  # forgotten: floor and retired keys stay
            # Retired keys stay, but for those only a first use under another recovery key than the
            # stated one retired (review of cbfa7bb: a reset under the same key dropped a hand-on
            # it had verified, and a thief with that key was accepted). The floor stays too.
            retired = [] if held is None or (confirmed and recovery != held["recovery"]) else list(held["retired"])
            held = {"owners": list(owners), "recovery": recovery, "index": index if held is None else max(index, held["index"]), "retired": retired, "provisional": not confirmed if held is None or keep else True}
        else:
            # The verified chain's keys before the stored first one are recorded too (and so retire):
            # a first use served without its rotations stored a chain that starts late (review of
            # 147c28d: a thief with the earlier key was then accepted).
            first, newest = held["owners"][0], held["owners"][-1]
            earlier = owners[:owners.index(first)] if first in owners else []
            held["owners"] = earlier + held["owners"] + owners[owners.index(newest) + 1:]
            held["index"] = max(index, held["index"])
            # Trusted only once an anchor states the recovery key (review of 349b07e: a bare
            # declaration promoted a poisoned first use).
            held["provisional"] = held["provisional"] and not confirmed
        new = [key for key in held["owners"][:-1] if key not in held["retired"]]
        held["retired"] += new
        self.packages[name] = held

    def close(self):
        if self.held is not None:
            os.close(self.held)
            self.held = None

    def save(self):
        staged = self.path.with_name(f".{self.path.name}.{os.getpid()}")
        known = {"registry": self.registry, "packages": self.packages, "revoked": self.revoked}
        if self.operator is not None:
            known["operator"] = {**self.operator, "provenance": OPERATOR_PROVENANCE}
        staged.write_text(json.dumps(known, indent=1, sort_keys=True) + "\n")
        os.replace(staged, self.path)


def resolve(registry, roots, pins, temp, frozen, snapshot_pin=None, *, catalog_snapshot=None):
    store = TrustStore(registry)
    try:
        snapshot = verify_snapshot(registry, snapshot_pin, store, temp)
        if catalog_snapshot is not None and (file_digest(snapshot[2]), snapshot[0]) != catalog_snapshot:
            raise ProjectError("verified package snapshot differs from the catalog snapshot")
        registry.verified_snapshot = snapshot
        return resolve_with(registry, roots, pins, temp, frozen, store, snapshot)
    finally:
        try:
            store.save()
        finally:
            store.close()


PIN_AGAIN = ("get the current operator's key ID and the registry's identifier from the registry's operator, out of band (not from this "
             "registry's files), check them, then declare them in witchy.toml ([registry] operator and id)")


def declare_operator(newest):
    """How a refused project declares the current operator. Only a key of this machine's record is
    named (its newest); with none, the key is got out of band: the refused chain, its signer and
    any successor it shows may be a thief's, and naming one as the key to declare would have the
    user pin it (review of e77e23b)."""
    declare = (f"check with the registry's operator that it is {newest}, the newest key this machine's record holds (which came from a first "
               f"use or a project's anchor, not from the operator), then set [registry] operator = \"{newest}\" and its id" if newest else PIN_AGAIN)
    return f"{declare}, remove {LOCK} if it pins an older operator key, and run `grimoire lock`"


def verify_snapshot(registry, pin, store, temp):
    """The registry's snapshot for this resolve, verified once and kept: every package is then
    fetched against these same bytes, so a registry writer cannot show one resolve indexes from
    different moments. Returns (sequence, the operator key that signed it, the kept file).

    How the operator is decided, as a package's owner is:
      1. The anchors: the operator declared in `[registry] operator` and the lock's `[snapshot]`.
         Without one, refused unless `lock --trust-first-use`: then the newest operator this
         machine verified, or, with none, whoever the registry's operator chain starts with.
      2. Coven verifies the snapshot: signed by the operator reached from the first anchor through
         rotations each signed by the key handing the role on, no older than the lock's floor, and
         not expired; and no older than this machine's floor for its signer (floors are kept per
         operator key, so no key's snapshots are bound by another key's floor).
      3. Refused if any anchor is missing from the verified chain, if its signer is a key this
         machine saw hand the role on, or if the chain does not contain the newest operator this
         machine verified (a fork), unless that came from a first use an anchor now overrides.
      4. Then the chain extends the store's (or replaces it), the handed-on keys of the record's own chain
         retire; a created or replaced record holds only the signer, and the keys any chain shows before
         the record's first are only marked before it; and
         the signer's floor rises."""
    held = store.operator
    lock_operator, lock_sequence, lock_id = pin or (None, 0, None)
    anchors = list(dict.fromkeys(key for key in (registry.operator, lock_operator) if key))
    stated = {key for key in (registry.registry_id, lock_id) if key}
    if len(stated) > 1:
        raise ProjectError(f"witchy.toml and {LOCK} name different registry identifiers ({', '.join(sorted(stated))})")
    registry_id = stated.pop() if stated else None
    newest = held["keys"][-1] if held and held["keys"] else None
    # The newest key, where a refusal may name it: not one still unestablished, which only a
    # project's pin (perhaps a cloned project's) accepted.
    vouched = newest if newest is not None and newest not in held["unestablished"] else None
    # What this machine recorded is checked, never replaced, by a project's identifier: a snapshot
    # for another registry under the same key is replayed (automated review of c00d6a6).
    if held is not None and held["keys"] and held["registry"] and registry_id and registry_id != held["registry"]:
        raise ProjectError(f"the project names registry {registry_id}, and this machine verified this registry's snapshots as {held['registry']}. "
                           f"If this machine's record is wrong, `grimoire trust --forget-operator`")
    first_use = not anchors
    if first_use and not getattr(registry, "trust_first_use", False) and held is not None:
        # This machine has a record (or forgot one): the key the registry's files name now is only
        # the refused chain's, perhaps a thief's after a theft, so it is not offered to declare
        # (review of 116d62f). Only a key the record holds is named.
        newest_held = vouched
        raise ProjectError("neither this project's [registry] operator nor its lock anchors the registry's operator. "
                           + (f"This machine's record holds {newest_held} ({'a first use' if held['source'] == 'first-use' else 'from a project'}): "
                              f"check with the registry's operator that it is a key of this registry, the current operator or an earlier one "
                              f"that was not stolen (the chain from it is followed), then declare it in witchy.toml:\n  [registry]\n"
                              f"  operator = \"{newest_held}\"\n  id = \"{held['registry'] or '...'}\"\n"
                              + ("or run `grimoire lock --trust-first-use` to anchor on it. " if held["source"] == "first-use" else "")
                              + "If it was stolen, `grimoire trust --forget-operator` and declare the current operator"
                              if newest_held else
                              "This machine holds no operator key it can name (`grimoire trust --forget-operator`, or a record set aside on "
                              "upgrade, one that could not say where its keys came from included): "
                              "get the current operator's key ID and the registry's identifier "
                              "from the registry's operator, out of band (not from this registry's files), check them, then declare them in "
                              "witchy.toml ([registry] operator and id)"))
    if first_use and not getattr(registry, "trust_first_use", False):
        named = coven_snapshot(registry, None, None, 0, None, quiet=True)
        raise ProjectError(f"the registry's snapshot is signed by its operator {named[2][-1] if named else '(unverified)'}, which neither this "
                           f"project's [registry] operator nor its lock anchors. Check that key and the registry's identifier with the "
                           f"registry's operator and declare them in witchy.toml:\n  [registry]\n  operator = \"{named[2][-1] if named else 'witchy-2:...'}\"\n"
                           f"  id = \"{named[1] if named else '...'}\"\n"
                           f"or run `grimoire lock --trust-first-use` to trust the operator the registry names now")
    if held is not None and not held["keys"] and first_use:
        raise ProjectError("this machine forgot the registry's operator (grimoire trust --forget-operator, or a record set aside on upgrade: "
                           "one from before the witchy-2 profile, or one that could not say where its keys came from): "
                           f"{PIN_AGAIN}")
    # One rule for the operator record, on every path: no project's anchors ever create, replace or
    # promote a trusted record (`provisional` stays True), and this machine's record never stands
    # in for a project's anchors. A project's anchors come from the project, every time; the record
    # is a floor, a list of retired keys and a chain that only ever refuses (a fork, a rollback).
    # `source` says whether the chain came from a first use or from a project's anchors: a record
    # a project's anchors made or extended cannot tell whose witchy.toml or lock that was, so it is
    # never what a `--trust-first-use` resolve anchors on (final-state review), and a project
    # contradicting it is refused as a fork rather than replacing it (review of 101f2b4). Only a
    # first use's chain is replaced by a contradicting anchor.
    if held is not None and held["keys"] and held["source"] == "project" and first_use:
        raise ProjectError(f"this machine's record of the registry's operator{f' ({vouched})' if vouched else ''} came from a project's [registry] operator "
                           f"or lock, which does not stand in for this project's: check the operator's key and the registry's identifier "
                           f"with the registry's operator and declare them in [registry] operator and id")
    if first_use and newest is not None:
        registry_id = held["registry"]
    # This machine's floors are kept per operator key: the highest snapshot sequence verified signed
    # by that key. A snapshot must be no older than its signer's floor (checked below, once the
    # chain is verified), and only the signer's floor rises. So a floor a cloned project and a
    # registry writer planted under the writer's key at 2^40, or a stolen retired key under its
    # own, binds no other key's snapshots, and an honest key's floor survives a replaced, migrated
    # or forgotten record (adversarial review of e2280af, and reviews of 6b97913 and 7cfc468).
    # A successor's newer snapshot cannot be hidden behind an older key's: the chain must still
    # contain the newest operator this machine verified. The lock's floor always binds.
    kept = Path(temp) / "snapshot"
    sequence, registry_id, keys = coven_snapshot(registry, anchors[0] if anchors else newest, registry_id, lock_sequence, kept)
    signer = keys[-1]
    # A key a record without the provenance marker named is accepted only where this project pins
    # it: never through a first use, an extend, or links the registry's files show (a thief's
    # A -> T, T named by the old record, is refused unless a project pins T). It is not named:
    # nothing this machine verified on its own vouches for it, and it may be a thief's. Checked
    # before the anchors, whose refusal names the signer (review of bca4a36).
    unpinned = [key for key in keys if held is not None and key in held["unestablished"] and key not in anchors]
    if unpinned:
        raise ProjectError(f"the registry's operator chain holds a key named by this machine's operator record from before Grimoire "
                           f"marked where its keys came from, which this project does not pin. That record was set aside on upgrade, "
                           f"and its keys are accepted only where a project pins one, or once you re-establish one for this machine "
                           f"(`grimoire trust --reestablish-operator KEY`, after checking KEY with the registry's operator out of band). "
                           f"Pin the operator again: {declare_operator(vouched)}")
    for anchor in anchors:
        if anchor not in keys:
            raise ProjectError(f"the registry's snapshot is signed by {'a key' if held is not None and signer in held['unestablished'] else signer} by an operator chain without {anchor}, which "
                               + ("witchy.toml declares" if anchor == registry.operator else f"{LOCK} pins"))
    # A key before the record (`before`) signs nothing either: it handed the role on toward the
    # record's first key.
    if held is not None and (signer in held["retired"] or signer in held["before"]):
        raise ProjectError(f"the registry's snapshot is signed by {'a key' if signer in held['unestablished'] else signer}, a key this machine saw hand "
                           f"the operator role on. Declare the current operator in witchy.toml and lock again: {declare_operator(vouched)}")
    # A key a record without provenance held retired or before it signs nothing either, pinned or
    # not (decision above, review of e33b81e); only the user's re-establishing lifts it. No key is named.
    if held is not None and signer in held["handed_on"]:
        raise ProjectError(f"the registry's snapshot is signed by a key this machine's operator record from before Grimoire marked where its "
                           f"keys came from saw hand the operator role on. A project's pin does not let it sign again; only "
                           f"`grimoire trust --reinstate-signer KEY` does, after checking with the registry's operator out of band that KEY "
                           f"is still its current signing key (not only that it was ever theirs: a key stolen after it handed the role on was). "
                           f"Pin the current operator directly: {declare_operator(vouched)}")
    # A first use is set aside only when the anchors contradict it: none of them is in the chain it
    # verified. An anchor in that chain confirms it, and a chain from there that drops its newest
    # operator is a fork by a key this machine saw hand the role on (review of 2269af1/d902ac6:
    # a stolen, retired key handed the role to a thief, and the fork became the trusted record).
    # A key a verified chain showed before the record's first key (`before`) does not contradict
    # it either: it handed the role on, through that chain, to the record's first key. Without
    # this, a stolen such key's fork replaced the record instead of being refused as a fork.
    replace = held is None or not held["keys"] or (held["source"] == "first-use" and anchors and newest not in keys
                                                   and not any(anchor in held["keys"] or anchor in held["before"] for anchor in anchors))
    if not replace and newest not in keys:
        raise ProjectError(f"the registry's snapshot is signed by {'a key' if signer in held['unestablished'] else signer} by an operator chain that does not continue the one this machine "
                           f"verified{'' if set(held['keys']) & set(held['unestablished']) else ' (' + ' -> '.join(held['keys']) + ')'}: a fork or a rollback. If this machine's record came from a compromised "
                           f"registry, `grimoire trust --forget-operator` and declare the operator in [registry] operator")
    # A retired key hands the role on once, to the successor this machine saw, on every path
    # (create, replace, extend), and its successor survives `--forget-operator` and a replaced
    # record. Checking only the signer let a stolen retired key hand the role to a thief after a
    # forget, or where a first use's chain never held the anchor: the fork check had nothing to
    # compare (review of ef0fdb0). A key whose successor is unknown hands it on to no one.
    # A key before a record (`before`, key -> the rest of the first chain that showed it and the
    # keys of the record it was before) hands the role only to one of those; to any other it is a retired key
    # with an unknown successor. So a stolen one cannot hand the role to a thief while the record
    # stands, nor, after a replace, into the record that replaced it (review of d439eca: A -> W,
    # W the replacing cloned project's key, made A's projects W's), and no successor is fixed.
    for key, successor in zip(keys, keys[1:]):
        # A successor a record without provenance held binds where its key may hand the role on,
        # pinned or re-established (decision above); no key is named.
        if held is not None and key in held["handover"] and successor not in held["handover"][key]:
            raise ProjectError(f"the registry's operator chain has a key hand the role on to a key other than the one this machine's "
                               f"operator record from before Grimoire marked where its keys came from recorded"
                               f"{'' if held['handover'][key] else ' (none)'}. Pin the current operator directly: {declare_operator(vouched)}")
        known = held["retired"] if held is not None else {}
        if key not in known and held is not None and key in held["before"] and successor not in held["before"][key]:
            known = {key: None}
        if key in known and known[key] != successor:
            seen = known[key]
            # Only a key this machine verified in its own record is named: the chain refused here,
            # and so its successor and signer, may be a thief's, and a key named beside the one to
            # declare may be pinned (review of cd8af09: with a record held, the thief's successor
            # was named too).
            # (No retirement is from or onto an unestablished key; guarded all the same.)
            loose = held["unestablished"] if held is not None else []
            handed = (f"to {successor}" if held is not None and successor in held["keys"] and successor not in loose else
                      "on to a key it cannot name" if successor in loose else
                      "on to a key this machine's record does not hold" if newest else "on to a key this machine never verified")
            raise ProjectError(f"the registry's operator chain has {'a key' if key in loose else key} hand the role {handed}, and this machine saw it hand the role "
                               + (f"to {seen}: a fork by a stolen key" if seen and seen not in loose else
                                  "to another key: a fork by a stolen key" if seen else "on to a successor it no longer records")
                               + f". Declare the current operator in witchy.toml and lock again: {declare_operator(vouched)}")
    floors = dict(held["floors"]) if held else {}
    floor = floors.get(signer, 0)
    if sequence < floor:
        raise ProjectError(f"the registry serves snapshot {sequence}, older than snapshot {floor} already seen")
    # A floor from a record forgotten before floors were kept per key binds every chain: nothing
    # says which key it was raised under (see TrustStore).
    if held and sequence < held["unkeyed"]:
        raise ProjectError(f"the registry serves snapshot {sequence}, older than snapshot {held['unkeyed']} this machine saw before its "
                           f"operator record was forgotten (kept for every operator key). If the operator restarted its sequence under a "
                           f"new key, or that record came from a compromised registry, `grimoire trust --forget-unkeyed-floor`")
    # Only the signer's floor rises: a key that handed the role on signs no snapshot any more, and
    # its floor raised by a fork a stolen retired key started would bind the honest chain through
    # it (review of 6b97913). The successor's floor binds every chain holding it.
    floors[signer] = max(sequence, floors.get(signer, 0))
    if replace:
        retired = dict(held["retired"]) if held else {}
        # Every key of the replaced record that handed the role on with no retirement recorded (an
        # unestablished key's hand-over fixes none) retires with no successor, as a forget does:
        # dropped with the record, nothing held it back (review of f96d1fe).
        for key in (held["keys"][:-1] if held else []):
            retired.setdefault(key, None)
        # The keys before the replaced record stay before the record: dropped, a stolen one handed
        # the role on again (review of 5f467cd). Not retired: none of their links fixes a successor,
        # and retired with an unknown one, a project declaring the honest current operator, a
        # cloned one included, made every project declaring such a key refused (review of
        # 88a58ca). Before the record, each still signs nothing, hands the role on only in a chain
        # that reaches the record, and retires with an unknown successor on `--forget-operator`.
        before = {key: was for key, was in held["before"].items() if key not in keys} if held else {}
        # Decision (review of 7228c51, by the Witchy ethos: authority is granted, never assumed):
        # no project's chain fixes a successor, on create, replace or extend. A created or
        # replaced record holds only the key that signed this snapshot; every key the chain shows
        # before it goes before the record. A successor is recorded only from links between keys
        # of this machine's own record, verified in a resolve that extends it. Taken whole, a
        # cloned project's chain from a stolen key B never seen retired (B -> T, or B -> T -> C)
        # fixed B's successor as T, and your projects declaring B were refused past a forget. The
        # cost: after a forget, a project declaring or locked to an older key declares the
        # current operator and locks again; the refusal says so.
        for at, key in enumerate(keys[:-1]):
            before.setdefault(key, list(keys[at + 1:]))
        held = {"keys": [signer], "retired": retired, "before": before, "floors": floors, "unkeyed": held["unkeyed"] if held else 0,
                "provisional": True, "source": "first-use" if first_use else "project", "registry": registry_id,
                "unestablished": list(held["unestablished"]) if held else [], "handover": dict(held["handover"]) if held else {},
                "handed_on": list(held["handed_on"]) if held else []}
    else:
        first = held["keys"][0]
        # Decision (review of ef0fdb0): a first-use record an anchored resolve does not contradict
        # keeps its source and gains no earlier keys. Those links came with the project, whose
        # anchor may be a registry writer's own key (a cloned project declaring W, and W -> A served
        # beside A's snapshot): authority is granted by an anchor, never assumed from one, so they
        # verify for this resolve only. Prepended, they made the record the project's, and an
        # honest `--trust-first-use` was refused until the user forgot it. What is kept, the chain
        # from the record's newest key on, is what a first use from that key verifies too.
        # Nor does a record a project's anchors made (review of 0f9fae6): it cannot tell whose
        # project that was either, and prepended, a thief holding the replaced record's newest key
        # B served B -> T -> C to a project declaring B, after a project declaring C replaced [B],
        # and fixed B's successor as T past a forget (and, through a key before the record,
        # A -> B -> T -> C: review of c411620). No record takes keys before its first
        # one; a created or replaced one holds only its signer (below, decision of 7228c51's review).
        ahead = keys[:keys.index(first)] if first in keys else []
        held["keys"] = held["keys"] + keys[keys.index(newest) + 1:]
        # Decision (review of 83604b5): the links before a first-use record's first key that it
        # does not take fix no successor. Only the project's anchor vouches for them, and it may be
        # a cloned project's: with A -> B honest and a first use from B, a thief holding A served
        # A -> T -> B beside B's snapshot, and the record retired A to T (and T to B), so your own
        # projects declaring A were refused as a fork by a stolen key, past `--forget-operator`.
        # Those keys are kept as before the record instead: an anchor on one does not contradict
        # it, so a stolen one's fork that drops the record's newest key is refused as a fork,
        # rather than replacing the record (review of 40b6650: a stolen A handed the role on).
        # Each may hand the role to the keys after it in this chain or to the record's: a list of
        # the record's keys alone refused an honest A -> X -> B the next time (review of c411620).
        skipped = ahead
        for at, key in enumerate(skipped):
            held["before"].setdefault(key, list(dict.fromkeys(skipped[at + 1:] + held["keys"])))
        held["before"] = {key: was for key, was in held["before"].items() if key not in held["keys"]}
        held["floors"] = floors
        # `provisional` is left as it was: resolving a project never promotes the record, and a
        # first use stays a first use.
        held["registry"] = registry_id
    # A project's pin accepts an unestablished key for this resolve only: a project's anchors never
    # change this machine's trust record, and a cloned project's pin would otherwise clear the mark
    # for every project here. Only the user re-establishes one, with
    # `grimoire trust --reestablish-operator KEY`, after checking it out of band.
    # The record's own chain fixes each successor; links before its first key do not (above). An
    # unestablished key's link fixes nothing: only a project's pin accepted it, for that resolve
    # (review of 112159d: A -> B was fixed for the machine from a pin of A). A link onto one retires
    # its key with no successor: that key handed the role on (it signed so), but only to a key a
    # pin accepted, which is never fixed (review of 3f1ff11: A -> T fixed, and T named). Skipped,
    # nothing recorded the hand-over, and after a forget a thief's A -> X passed (review of d52db7b).
    for key, successor in zip(held["keys"], held["keys"][1:]):
        if key not in held["unestablished"]:
            held["retired"].setdefault(key, None if successor in held["unestablished"] else successor)
    store.operator = held
    if first_use:
        registry.first_used_operator = (signer, registry_id)
    return sequence, signer, kept, registry_id


def verified_legacy_snapshot(registry, pin, folder):
    store = TrustStore(registry)
    try:
        return verify_snapshot(registry, pin, store, folder)
    finally:
        try:
            store.save()
        finally:
            store.close()


def run_coven(command, *, timeout=None):
    tuf = tuple(command[1:3]) in (("tuf", "fetch"), ("tuf", "catalog"))
    env = toolchain_environment(keep_ca=tuf)
    if not tuf:
        return subprocess.run(command, capture_output=True, text=True, env=env, timeout=timeout)
    read_end, write_end = os.pipe()
    try:
        env["WITCHY_COVEN_LIFELINE_FD"] = str(read_end)
        return subprocess.run(command, capture_output=True, text=True, env=env, pass_fds=(read_end,),
                              timeout=timeout)
    finally:
        os.close(write_end)
        os.close(read_end)


def coven_snapshot(registry, operator, registry_id, floor, keep, quiet=False):
    """Coven's verification of the registry's snapshot: (sequence, registry identifier, operator
    keys), its bytes kept in `keep`. `quiet`: only to name the operator in a refusal (None if Coven
    refuses it)."""
    command = [tool("COVEN", "coven"), "verify-snapshot", "--registry", registry, "--min-sequence", str(floor)]
    if operator is not None:
        command += ["--operator", operator, "--registry-id", registry_id]
    if keep is not None:
        command += ["--keep", keep]
    run = run_coven(command)
    lines = run.stdout.splitlines()
    valid = not run.returncode and len(lines) == 4 and re.fullmatch(r"snapshot [1-9][0-9]*", lines[0]) \
        and lines[1].startswith("registry ") and REGISTRY_ID.fullmatch(lines[1][9:]) and (registry_id is None or lines[1][9:] == registry_id) \
        and lines[2].startswith("operators ") and all(OPERATOR_KEY.fullmatch(k) for k in lines[2][10:].split(" ")) \
        and lines[3].startswith("expires ")
    if quiet:
        return (int(lines[0][9:]), lines[1][9:], lines[2][10:].split(" ")) if valid else None
    relay(run.stderr)
    if not valid or int(lines[0][9:]) < floor:
        raise ProjectError("the registry's snapshot is refused")
    return int(lines[0][9:]), lines[1][9:], lines[2][10:].split(" ")


def resolve_with(registry, roots, pins, temp, frozen, store, snapshot):
    """The whole graph from the manifest's dependencies, each package fetched and verified.

    Returns {name: (version, digest, requires, directory)}. A version `pins` holds is fetched
    against its pinned digest.

    How each package's owner is decided (the trust store's docstring has its data):
      1. A version this machine saw revoked is refused.
      2. The anchors: the owner declared in [owners] and the lock's pin, whichever exist; their
         stated recovery keys must agree with each other and with a non-first-use stored entry.
      3. Without anchors: refused with owners-required or after `trust --forget`; otherwise the
         newest stored owner, or a first use.
      4. Coven verifies the chain under that recovery key, above the floor.
      5. Refused if the owner is a key this machine saw rotated away (retired);
      6. or if any anchor is missing from the verified chain;
      7. or if the chain does not contain the newest stored owner (a fork or a rollback), unless
         the stored entry is a first use an anchored resolve now overrides.
      8. Only then are the floor and a revocation kept, even if Coven refuses the version.
      9. On acceptance the chain extends the store's (or replaces a first use) and its handed-on
         keys retire.
    """
    def fetch(name, version, pinned, expect, into, chain):
        if f"{name} {version}" in store.revoked:
            raise ProjectError(f"{name} {version} was revoked by its publisher ({store.revoked[f'{name} {version}']}), as this machine saw: "
                               f"it stays refused here, whatever the registry serves now")
        entry = store.packages.get(name)
        declared, declared_recovery = getattr(registry, "owners", {}).get(name, (None, None))
        lock_owner = pinned[3] if pinned and pinned[3] != "unsigned" else None
        anchors = list(dict.fromkeys(key for key in (declared, lock_owner) if key))
        recovery = refusal = None
        stated = {key for key in (declared_recovery, pinned[5] if lock_owner else None) if key}
        if len(stated) > 1:
            refusal = f"witchy.toml and {LOCK} name different recovery keys for it ({', '.join(sorted(stated))})"
        recovery = stated_recovery = stated.pop() if stated else None
        trusted = entry is not None and bool(entry["owners"]) and not entry["provisional"]
        if trusted and recovery is not None and recovery != entry["recovery"]:
            refusal = (f"this machine verified it under recovery key {entry['recovery']}, and the project names {recovery}. "
                       f"If this machine's record came from a compromised registry, `grimoire trust --forget {name}`: the "
                       f"project's recovery key then replaces this machine's, and the keys it saw rotated away are no longer "
                       f"refused, so first check {recovery} with the publisher")
        if refusal:
            raise ProjectError(f"{name} {version}: {refusal}")
        if anchors:
            held = anchors[0]
            # Without a stated recovery key, a trusted entry's is what Coven checks; a first use's is
            # not (review of 349b07e: a bare declaration followed a poisoned first use's rotation).
            # Then Coven accepts the declared signer alone, and a thief serving another recovery
            # key cannot reset the first use (that needs a stated key; automated review of 1d1bb93).
            recovery = recovery or (entry["recovery"] if trusted else None)
        elif getattr(registry, "owners_required", False):
            raise ProjectError(f"{name} {version} has no owner declared in [owners] and none in {LOCK} (required by {chain[-1]}), "
                               f"and [registry] owners-required = true: declare its owner key")
        elif entry is not None and not entry["owners"]:
            raise ProjectError(f"{name}: this machine forgot its owners (grimoire trust --forget); declare its owner in [owners] "
                               f"or use a lock that pins it")
        else:
            held, recovery = (entry["owners"][-1], entry["recovery"]) if entry else (None, None)
        floor = max(entry["index"] if entry else 0, pinned[4] if pinned else 0)
        fetched = coven_fetch(registry, name, version, into, expect, held, floor, recovery, snapshot)
        if fetched.index:
            # Checked as soon as Coven verified the index, before anything from it is kept.
            # A first use is set aside only when an anchor contradicts it (the anchor is not in its
            # chain); one that holds the anchor keeps its retired keys and continuation check
            # (automated review of 7bedcf3: a stale lock's thief was accepted).
            # Likewise when the verified recovery key differs from a first use's (review of 7bedcf3:
            # a first use under a thief's recovery key outlived an anchored resolve).
            reset = entry is not None and entry["provisional"] and bool(entry["owners"]) and bool(anchors) \
                and (any(a not in entry["owners"] for a in anchors) or (stated_recovery is not None and stated_recovery != entry["recovery"]))
            # As in accept: retirements go when the project states another recovery key than the
            # one they were verified under (a trusted entry was refused above; forget it first).
            retired = entry["retired"] if entry else []
            if entry is not None and stated_recovery is not None and stated_recovery != entry["recovery"]:
                retired = []
            if fetched.owner in retired:
                raise ProjectError(f"{name} {version} is owned by {fetched.owner}, a key this machine saw hand the package on "
                                   f"(under recovery key {entry['recovery']}): a rotated-away key is never its owner again. If this "
                                   f"machine's record came from a compromised registry, `grimoire trust --forget {name}` and state the "
                                   f"package's recovery key in [owners] or the lock")
            # A recovery key the project does not state never differs from the one this machine
            # recorded (automated review of fcc40a0: a bare declaration let a served key replace a
            # first use's).
            # A forgotten entry keeps this too: a served key must not relabel the retirements it
            # holds, which a stated key would then drop (review of 7abeda4).
            if stated_recovery is None and entry is not None and fetched.recovery != entry["recovery"]:
                raise ProjectError(f"{name} {version}: its recovery key is {fetched.recovery}, and this machine recorded {entry['recovery']}"
                                   + (" on a first use" if entry["provisional"] else "") + ": state the package's recovery key in [owners] or the lock")
            for anchor in anchors:
                if anchor not in fetched.owners:
                    raise ProjectError(f"{name} {version} is owned by {fetched.owner} by a chain without {anchor}, which "
                                       + ("witchy.toml declares" if anchor == declared else f"{LOCK} pins"))
            if declared_recovery and fetched.recovery != declared_recovery:
                raise ProjectError(f"{name} {version}: its recovery key is {fetched.recovery}, and witchy.toml declares {declared_recovery}")
            if entry is not None and entry["owners"] and entry["owners"][-1] not in fetched.owners and not reset:
                raise ProjectError(f"{name} {version} is owned by {fetched.owner} by a chain that does not continue the one this "
                                   f"machine verified ({' -> '.join(entry['owners'])}): a fork or a rollback. If this machine's record "
                                   f"came from a compromised registry, `grimoire trust --forget {name}` and declare its owner")
            # A pinned fetch's floor and revocation are kept even when Coven then refuses the version.
            if held is not None:
                store.raise_floor(name, fetched.index)
                if fetched.withdrawn and fetched.withdrawn[0] == "revoked":
                    store.revoked[f"{name} {version}"] = fetched.withdrawn[1]
        if fetched.revoked is not None:
            if held is not None and fetched.index:
                store.revoked[f"{name} {version}"] = fetched.revoked
            raise ProjectError(f"{name} {version} is revoked by its publisher: {fetched.revoked}")
        if not fetched.ok:
            raise ProjectError(f"{name} {version} was not fetched from the registry")
        digest, signer, recovery, withdrawn, index = fetched.digest, fetched.owner, fetched.recovery, fetched.withdrawn, fetched.index
        check_signer(registry, name, version, signer, pinned, frozen)
        # Trust on first use is the author's explicit choice, not a default: a signed package that
        # no declaration, lock pin or trusted record of this machine anchors is refused unless the
        # lock was asked to trust the registry's owners now (`--trust-first-use`). Authority is
        # granted, never assumed (the Witchy ethos).
        # This machine's records never stand in for the project's own anchors: a record cannot tell
        # whose witchy.toml or lock made it, and a cloned project's would otherwise vouch for the
        # user's (reviews of 925bb2d and d15324c). Only this project's declaration or lock pin, or
        # --trust-first-use, lets a signed package in.
        unvouched = True
        if signer != "unsigned" and not anchors and unvouched and not getattr(registry, "trust_first_use", False):
            raise ProjectError(f"{name} {version} is signed by {signer}, which neither this project's [owners] nor its lock anchors "
                               f"(required by {chain[-1]}). Check that key with its publisher and declare it in witchy.toml:\n"
                               f"  [owners]\n  {name} = {{ owner = \"{signer}\", recovery = \"{recovery}\" }}\n"
                               f"or run `grimoire lock --trust-first-use` to trust the owners the registry names now")
        if signer != "unsigned" and not anchors and unvouched:
            # What --trust-first-use actually took, reported by the lock (review of 925bb2d).
            getattr(registry, "first_used", {})[name] = (signer, recovery)
        check_withdrawn(name, version, withdrawn, kept=expect is not None)
        if signer != "unsigned":
            store.accept(name, fetched.owners, recovery, index, anchored=bool(anchors), confirmed=bool(anchors) and stated_recovery is not None)

        release = read_release(into, name, version, digest)
        return release, digest, signer, index, recovery

    return walk_dependencies(roots, pins, temp, frozen, fetch)


def walk_dependencies(roots, pins, temp, frozen, fetch):
    graph = Graph()
    via = {}
    queue = deque((name, version, ("witchy.toml",)) for name, version in sorted(roots.items()))
    while queue:
        name, version, chain = queue.popleft()
        if name in graph:
            if graph[name][0] != version:
                first = " -> ".join(via[name] + (f"{name} {graph[name][0]}",))
                second = " -> ".join(chain + (f"{name} {version}",))
                raise ProjectError(f"{name} is required at two versions: {first}; {second}")
            continue
        pinned = pins.get(name)
        expect = pinned[1] if pinned and pinned[0] == version else None
        if frozen and expect is None:
            raise ProjectError(f"{LOCK} does not pin {name} {version} (required by {chain[-1]}): run `grimoire lock`")
        into = Path(temp) / "packages" / name
        release, digest, signer, index, recovery = fetch(name, version, pinned, expect, into, chain)
        requires = release.requires
        graph.staged[name] = Staged(name, version, release, into)
        graph[name] = (version, digest, requires, into, signer, index, recovery)
        via[name] = chain
        path = chain + (f"{name} {version}",)
        for dependency, exact in sorted(requires.items()):
            queue.append((dependency, exact, path))
    check_dependency_cycles(graph)
    return graph, via


def check_dependency_cycles(graph):
    # The discovery walk visits a package once. Check every edge of the
    # verified graph, including edges between independently discovered roots.
    completed = set()
    for root in graph:
        if root in completed:
            continue
        # Insertion order keeps the current path for diagnostics.
        active = {root: iter(sorted(graph[root][2]))}
        while active:
            name = next(reversed(active))
            dependency = next(active[name], None)
            if dependency is None:
                del active[name]
                completed.add(name)
            elif dependency in active:
                path = [f"{package} {graph[package][0]}" for package in (*active, dependency)]
                chain = " -> ".join(("witchy.toml", *path))
                raise ProjectError(f"{name} {graph[name][0]} requires {dependency}, which requires it: {chain}")
            elif dependency not in completed:
                active[dependency] = iter(sorted(graph[dependency][2]))


def requirement_list(requires):
    return [f"{name} {version}" for name, version in sorted(requires.items())]


def read_coven_receipt(text):
    def unique_fields(pairs):
        result = dict(pairs)
        if len(result) != len(pairs):
            raise ValueError("duplicate field in Coven receipt")
        return result

    def refuse_constant(value):
        raise ValueError(f"invalid JSON constant in Coven receipt: {value}")

    try:
        return json.loads(text, object_pairs_hook=unique_fields, parse_constant=refuse_constant)
    except RecursionError:
        raise ValueError("invalid nested Coven receipt") from None


def fetch_tuf_release(registry, name, version, into, pinned, expect, snapshot_pin, *, ca_pin, timeout):
    into.mkdir(mode=0o700, parents=True)
    output = into / "release"
    command = [tool("COVEN", "coven"), "tuf", "fetch", name, version, "--out", output,
               *registry.mirror_arguments(ca_pin=ca_pin)]
    if expect is not None:
        command += ["--expect", expect, "--expect-target", pinned[4]]
    if snapshot_pin is not None:
        command += ["--expect-snapshot", snapshot_pin]
    run = run_coven(command, timeout=timeout)
    relay(run.stderr)
    if run.returncode:
        raise ProjectError(f"{name} {version} was not fetched from the TUF mirror")
    fields = {"digest", "publisher", "snapshot", "target"}
    if registry.url.startswith("https://"):
        fields.add("ca_pin")
    try:
        facts = read_coven_receipt(run.stdout)
        if (not isinstance(facts, dict) or facts.keys() != fields | {"snapshot_version"}
                or not all(isinstance(facts[key], str) and DIGEST.fullmatch(facts[key]) for key in fields)
                or not valid_snapshot_version(facts["snapshot_version"])):
            raise ValueError
    except ValueError:
        raise ProjectError(f"{name} {version}: invalid Coven TUF fetch result") from None
    if registry.ca_pin is not None and facts["ca_pin"] != registry.ca_pin:
        raise ProjectError(f"{name} {version}: HTTPS CA bundle differs from the manifest pin")
    if pinned is not None and facts["publisher"] != pinned[3]:
        raise ProjectError(f"{name} {version}: publisher differs from {LOCK}")
    if expect is not None and (facts["digest"] != expect or facts["target"] != pinned[4]):
        raise ProjectError(f"{name} {version}: TUF release differs from {LOCK}")

    codec = release_format()
    try:
        handle = os.open(output, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        with os.fdopen(handle, "rb") as stream:
            if not stat.S_ISREG(os.fstat(handle).st_mode):
                raise ValueError("the fetched release is not a file")
            payload = stream.read(codec.PAYLOAD_BYTES + 1)
        release = codec.parse_payload(payload, name, version)
        if release.digest != facts["digest"]:
            raise ValueError("the fetched release's digest differs from the verified digest")
    except (OSError, ValueError) as error:
        raise ProjectError(f"{name} {version}: the TUF release is refused: {error}") from None
    return release, facts


def resolve_tuf(registry, roots, pins, temp, frozen, floor, *, catalog_snapshot=None, catalog_ca_pin=None,
                recovery_pin=None):
    snapshot = None
    ca_pin = catalog_ca_pin
    targets = {}
    budget = registry.resolution_deadline_ms
    deadline = time.monotonic() + budget / 1000
    expired = f"TUF dependency resolution exceeded [registry] resolution-deadline-ms ({budget} ms)"

    def remaining():
        seconds = deadline - time.monotonic()
        if seconds <= 0:
            raise ProjectError(expired)
        return seconds

    def fetch(name, version, pinned, expect, into, _chain):
        nonlocal snapshot, ca_pin
        expected = snapshot or catalog_snapshot
        expected_digest = expected[0] if expected is not None else recovery_pin
        try:
            release, facts = fetch_tuf_release(
                registry, name, version, into, pinned, expect, expected_digest, ca_pin=ca_pin, timeout=remaining())
        except subprocess.TimeoutExpired:
            raise ProjectError(expired) from None
        current = (facts["snapshot"], facts["snapshot_version"])
        if recovery_pin is not None and current[0] != recovery_pin:
            raise ProjectError("verified package snapshot differs from the recovery pin")
        if catalog_snapshot is not None and current != catalog_snapshot:
            raise ProjectError("verified package snapshot differs from the required TUF snapshot")
        if ca_pin is not None and ca_pin != facts.get("ca_pin"):
            raise ProjectError("HTTPS CA bundle changed during dependency resolution")
        if snapshot is None:
            if floor is not None and (current[1] < floor[1] or current[1] == floor[1] and current[0] != floor[0]):
                raise ProjectError(f"verified TUF snapshot rolls back or conflicts with {LOCK}")
            snapshot = current
            ca_pin = facts.get("ca_pin")
        elif snapshot != current:
            raise ProjectError("verified TUF snapshot changed during resolution")
        targets[name] = facts["target"]
        return release, release.digest, facts["publisher"], None, None

    graph, via = walk_dependencies(roots, pins, temp, frozen, fetch)
    remaining()
    graph.tuf_targets = targets
    graph.tuf_snapshot = snapshot
    graph.tuf_ca_pin = ca_pin
    return graph, via


def read_lock(manifest, dependencies, registry, temp, *, catalog_snapshot=None, catalog_ca_pin=None,
              lock_bytes=READ_LOCK_FROM_DISK):
    """The locked graph, fetched and verified, which must be exactly what the manifest requires."""
    lock = manifest.parent / LOCK
    lock_bytes = read_lock_bytes(lock, lock_bytes)
    tuf = isinstance(registry, TufRegistry)
    if tuf:
        locked, snapshot, lock_digest = read_tuf_lock(lock, registry, wire=lock_bytes)
    else:
        locked, snapshot = parse_lock(lock, wire=lock_bytes), read_lock_snapshot(lock, wire=lock_bytes)
    if locked is None:
        raise ProjectError(f"no {LOCK} beside {manifest.name}: run `grimoire lock` to pin the dependencies")
    if tuf:
        graph, _ = resolve_tuf(registry, dependencies, locked, temp, frozen=True, floor=snapshot,
                               catalog_snapshot=catalog_snapshot, catalog_ca_pin=catalog_ca_pin)
        graph.tuf_lock_digest = lock_digest
    else:
        graph, _ = resolve(registry, dependencies, locked, temp, frozen=True, snapshot_pin=snapshot, catalog_snapshot=catalog_snapshot)
    check_locked_graph(lock, locked, graph)
    return graph


def check_locked_graph(lock, locked, graph):
    if set(locked) != set(graph):
        raise ProjectError(f"{lock} pins packages the dependencies do not require: run `grimoire lock`")
    for name, (version, digest, requires, *_) in graph.items():
        if locked[name][2] != requirement_list(requires):
            raise ProjectError(f"{lock}: the requires of {name} {version} are not its record's: run `grimoire lock`")


class Fetched:
    """What Coven verified of one version: `ok` if it was fetched; the index facts (owner, its
    chain, recovery key and sequence) whenever Coven verified them, refused or not."""
    ok, digest, signer, owner, owners, recovery, index, withdrawn, revoked = False, None, "unsigned", "unsigned", [], "none", 0, None, None


def coven_fetch(registry, name, version, into, digest=None, signer=None, min_index=0, recovery=None, snapshot=None):
    """Fetch one package into `into` through Coven. With `signer`, Coven itself refuses a release
    of a package that key never owned, or an unsigned one; with `recovery`, an index naming
    another recovery key; with `min_index`, a package index older than one already seen. The
    package's index is the one `snapshot` (this resolve's, verified once and kept) names."""
    sequence, operator, kept, registry_id = snapshot
    command = [tool("COVEN", "coven"), "fetch", name, version, "--registry", registry, "--into", into, "--min-sequence", str(min_index),
               "--operator", operator, "--registry-id", registry_id, "--snapshot", kept, "--min-snapshot", str(sequence)]
    if digest is not None:
        command += ["--expect", digest]
    if signer is not None:
        command += ["--expect-signer", signer]
    if recovery is not None:
        command += ["--expect-recovery", recovery]
    run = run_coven(command)
    relay(run.stderr)
    if run.returncode and "does not list this version" in run.stderr:
        # The index is the snapshot's, not the newest the owner signed: say what that means.
        say(f"{name} {version}: the index read is the one snapshot {sequence} of the registry names. A version published "
                         "after that snapshot is in no index a consumer sees until the registry's operator signs a snapshot that "
                         "includes it: the operator has not yet snapshotted it (`coven snapshot`), or it was never published. "
                         "Ask the operator, then `grimoire lock` again.\n")
    # Coven's lines, each `N V: ` and one fact, once: `verified D`; `signed by K` or `unsigned`;
    # for a package with an index, `owner K`, `owners K...`, `recovery R` and `index S`, printed
    # before any refusal; and for a withdrawn version, `yanked: REASON` or `revoked: REASON`.
    failed = ProjectError(f"{name} {version} was not fetched from the registry")
    fetched, facts, prefix = Fetched(), {}, f"{name} {version}: "
    for line in run.stdout.splitlines():
        if not line.startswith(prefix):
            raise failed
        line = line[len(prefix):]
        for kind, start in (("snapshot", "snapshot "), ("verified", "verified "), ("signer", "signed by "), ("owners", "owners "), ("owner", "owner "),
                            ("recovery", "recovery "), ("index", "index "), ("yanked", "yanked: "), ("revoked", "revoked: ")):
            if line.startswith(start):
                value = line[len(start):]
                break
        else:
            kind, value = ("signer", "unsigned") if line == "unsigned" else (None, None)
        if kind is None or kind in facts or (kind in ("yanked", "revoked") and ("yanked" in facts or "revoked" in facts)):
            raise failed
        facts[kind] = value
    # Every fact is of this resolve's snapshot, or none is.
    if facts.get("snapshot") != str(sequence):
        raise failed
    if "index" in facts:
        owners = facts.get("owners", "").split(" ")
        if not re.fullmatch(r"[1-9][0-9]*", facts["index"]) or not KEY_ID.fullmatch(facts.get("owner", "")) \
                or not all(KEY_ID.fullmatch(o) for o in owners) or owners[-1] != facts["owner"] \
                or not (facts.get("recovery") == "none" or KEY_ID.fullmatch(facts.get("recovery", ""))) or int(facts["index"]) < min_index:
            raise failed
        fetched.owner, fetched.owners, fetched.recovery, fetched.index = facts["owner"], owners, facts["recovery"], int(facts["index"])
    elif any(kind in facts for kind in ("owner", "owners", "recovery")):
        raise failed
    for kind in ("yanked", "revoked"):
        if kind in facts:
            fetched.withdrawn = (kind, facts[kind])
    revoked = f"{prefix}refused: revoked by its publisher: "
    for line in run.stderr.splitlines():
        if line.startswith(revoked) and run.returncode:
            fetched.revoked = line.removeprefix(revoked)
    if run.returncode:
        return fetched
    verdict, signer_line = facts.get("verified", ""), facts.get("signer", "")
    if not DIGEST.fullmatch(verdict) or not SIGNER.fullmatch(signer_line) or (digest is not None and verdict != digest) \
            or (signer_line == "unsigned") != ("index" not in facts):
        raise failed
    fetched.ok, fetched.digest, fetched.signer = True, verdict, signer_line
    return fetched


def lock_project(project, toolchain=False, trust_first_use=False, *, recovery_pin=None):
    """Pin every package of the graph, with its digest and requirements, in witchy.lock.

    A version the lock already pins keeps its digest: the registry's copy must still have it, so
    one name and version never stands for two contents. Only a new or changed version is pinned
    from the registry as it is now. The lock is replaced whole, or not at all.
    """
    manifest = (project / "witchy.toml" if project.is_dir() else project).resolve()
    recovering = recovery_pin is not None
    if recovering:
        if not DIGEST.fullmatch(recovery_pin):
            raise ProjectError("--recover-tuf-snapshot requires a sha384: digest")
        if toolchain or trust_first_use:
            raise ProjectError("--recover-tuf-snapshot preserves the existing toolchain and trust pins")
    lock = manifest.parent / LOCK
    lock_bytes = read_lock_bytes(lock)
    # Locking verifies through the toolchain (Coven's programs run on it): a pinned one is checked
    # first, unless this lock re-pins it on purpose (final-state review).
    if not toolchain:
        check_toolchain(manifest, lock_bytes=lock_bytes)
    registry, dependencies = read_dependencies(manifest)
    if recovering and not isinstance(registry, TufRegistry):
        raise ProjectError("--recover-tuf-snapshot requires a TUF registry")
    if registry is None:
        # Nothing to resolve: a project with no dependency has no package to pin. Only the
        # toolchain can be locked, and only when asked.
        if not toolchain:
            raise ProjectError("this project declares no [dependencies] and no [registry]: there is no package to lock. "
                               "`grimoire lock --toolchain` pins the compiler and the engine alone")
        pinned = {**{role: file_digest(tool(*TOOLS[role])) for role in TOOLS}, "host-libraries": host_libraries(tool(*TOOLS["host"]))}
        lines = ["# Written by `grimoire lock --toolchain`: this project has no package to pin.",
                 "", "[toolchain]", f'compiler = "{pinned["compiler"]}"', f'host = "{pinned["host"]}"']
        if pinned["host-libraries"]:
            lines += ["", "[toolchain.host-libraries]"] + [f'"{n}" = "{d}"' for n, d in sorted(pinned["host-libraries"].items())]
        write_project_lock(lock, lines, lock_bytes)
        print(f"pinned the compiler {pinned['compiler']} and the host {pinned['host']}")
        return
    registry.trust_first_use, registry.first_used, registry.first_used_operator = trust_first_use, {}, None
    tuf = isinstance(registry, TufRegistry)
    if tuf and trust_first_use:
        raise ProjectError("TUF requires explicit trust pins; --trust-first-use does not apply")
    if tuf:
        previous, snapshot, _ = read_tuf_lock(lock, registry, wire=lock_bytes, refresh_ca_pin=not recovering)
        if recovering and previous is None:
            raise ProjectError(f"--recover-tuf-snapshot requires an existing {LOCK}")
    else:
        previous, snapshot = parse_lock(lock, wire=lock_bytes), read_lock_snapshot(lock, wire=lock_bytes)
    previous = previous or {}
    lines = ["# Written by `grimoire lock`: every package the dependencies require, with its exact",
             "# version, content digest and own requirements. `grimoire run` builds from exactly these."]
    # The toolchain pin is kept as it was, and set (to the binaries in use) only when asked: a
    # new compiler is a change the author makes on purpose, like a new dependency version.
    pinned = {**{role: file_digest(tool(*TOOLS[role])) for role in TOOLS}, "host-libraries": host_libraries(tool(*TOOLS["host"]))} \
        if toolchain else read_toolchain(lock, wire=lock_bytes)
    if pinned:
        lines += ["", "[toolchain]", f'compiler = "{pinned["compiler"]}"', f'host = "{pinned["host"]}"']
        if pinned["host-libraries"]:
            lines += ["", "[toolchain.host-libraries]"] + [f'"{n}" = "{d}"' for n, d in sorted(pinned["host-libraries"].items())]
        if toolchain:
            print(f"pinned the compiler {pinned['compiler']} and the host {pinned['host']}")
    first_use = []
    with tempfile.TemporaryDirectory(prefix="grimoire-") as temp:
        with still_working("verifying the registry's snapshot and each package with Coven"):
            if tuf:
                graph, via = resolve_tuf(registry, dependencies, previous, temp, frozen=recovering,
                                         floor=None if recovering else snapshot, recovery_pin=recovery_pin)
                if recovering:
                    check_locked_graph(lock, previous, graph)
            else:
                graph, via = resolve(registry, dependencies, previous, temp, frozen=False, snapshot_pin=snapshot)
        if tuf:
            digest, version = graph.tuf_snapshot
            lines += ["", "[tuf]", f'snapshot = "{digest}"', f"snapshot-version = {version}"]
            lines += [f"{key} = {json.dumps(value)}" for key, value in registry.identity().items()]
            if registry.ca_pin is not None:
                lines.append(f'ca-pin = "{graph.tuf_ca_pin}"')
        else:
            sequence, operator, _, registry_id = registry.verified_snapshot
            lines += ["", "[snapshot]", f'operator = "{operator}"', f"sequence = {sequence}", f'registry = "{registry_id}"']
        for name, (version, digest, requires, _, signer, index, recovery) in sorted(graph.items()):
            listed = ", ".join(f'"{r}"' for r in requirement_list(requires))
            lines += ["", "[[package]]", f'name = "{name}"', f'version = "{version}"',
                      f'digest = "{digest}"', f"requires = [{listed}]"]
            if tuf:
                lines += [f'publisher = "{signer}"', f'target = "{graph.tuf_targets[name]}"']
            else:
                lines += [f'signer = "{signer}"', f'recovery = "{recovery}"', f"index = {index}"]
            kept = previous.get(name, (None, None))[:2] == (version, digest)
            print(f"{'kept' if kept else 'locked'} {name} {version} {digest} (required by {via[name][-1]})")
            if name in registry.first_used:
                first_use.append(f'{name} = {{ owner = "{signer}", recovery = "{recovery}" }}')
    if registry.first_used_operator:
        operator, registry_id = registry.first_used_operator
        say(f"trusted on first use (--trust-first-use), from the registry alone: its operator {operator}, registry {registry_id}. "
              f"To pin them for every machine, check them with the registry's operator and add to witchy.toml:\n[registry]\n"
              f'operator = "{operator}"\nid = "{registry_id}"')
    if first_use:
        # Owners taken from the registry as it is now, with nothing to check them against: say so,
        # with the lines that pin them for every machine (verify the key IDs with the
        # publisher first).
        say(f"trusted on first use (--trust-first-use), from the registry alone: {len(first_use)} owner(s). To pin them for every "
              f"machine, check these key IDs with their publishers and add to witchy.toml:\n[owners]\n" + "\n".join(first_use))
    write_project_lock(lock, lines, lock_bytes, recovering=recovering)
    if recovering:
        recovered_digest, recovered_version = graph.tuf_snapshot
        print(f"recovered TUF snapshot {recovered_digest} (version {recovered_version}) with the existing package pins")


def write_project_lock(lock, lines, expected, *, recovering=False):
    wire = ("\n".join(lines) + "\n").encode("utf-8")
    operation = "TUF recovery" if recovering else "dependency locking"
    write_control_update(lock, wire, expected, operation)


def shown_path(path):
    """A path as its author would write it from here: relative to the working directory when
    it is inside it, absolute otherwise."""
    path = os.path.abspath(path)
    try:
        relative = os.path.relpath(path)
    except ValueError:
        return path
    return path if relative.startswith("..") else relative


def author_names(pairs):
    """A function that rewrites text the toolchain printed about staged copies into the names
    of the files they were copied from. `pairs`: (staged path, the author's name for it); a
    directory's pair ends both with `/`. Every build goes through a temporary copy (the app
    beside its generated package list, a library's release bytes, each fetched package), which
    is gone when the diagnostic is read: `/var/folders/.../grimoire-XXXX/app/main.wy:50:12`
    names nothing. Each spelling of the copy's path is replaced: as made, and resolved
    (`/private/var/...` on macOS), longest first."""
    table = {}
    for staged, authored in pairs:
        staged = str(staged)
        tail = "/" if staged.endswith("/") else ""
        resolved = os.path.realpath(staged) + tail
        for spelling in {staged, resolved, resolved.removeprefix("/private")}:
            table[spelling] = authored
    ordered = sorted(table.items(), key=lambda pair: -len(pair[0]))
    def rewrite(text):
        for staged, authored in ordered:
            text = text.replace(staged, authored)
        return text
    return rewrite


def package_listing(graph):
    """The package list the compiler reads: each package's entry, and what it may import by
    name. A package's other files are beside its entry, and the compiler lets a package import
    nothing outside its entry's directory."""
    staged = getattr(graph, "staged", {})
    missing = sorted(set(graph) - set(staged))
    if missing:
        # Only a release this run verified and staged is named to the compiler: never a path
        # made from a cache directory's name.
        raise ProjectError(f"{', '.join(missing)}: no verified release was staged for this build")
    return [f"{name} {version}: {staged[name].entry} ; requires {' '.join(sorted(requires))}".rstrip()
               for name, (version, _, requires, *_) in sorted(graph.items())]


def staged_names(graph):
    """`author_names` pairs for the staged copies of a graph's packages: `@NAME-VERSION/`."""
    pairs = [(f"{into}/", f"@{name}-{version}/") for name, (version, _, _, into, *_) in graph.items()]
    pairs += [(f"{staged.root}/", f"@{name}-{staged.version}/") for name, staged in getattr(graph, "staged", {}).items()]
    return pairs


def stage_registry_packages(manifest, entry, temp, require_policy=True, names=None, releases=None, *,
                            catalog_snapshot=None, catalog_ca_pin=None, project=None, lock_bytes=READ_LOCK_FROM_DISK,
                            policy_bytes=READ_POLICY_FROM_DISK, required_tuf_snapshot=None):
    """Return the staged entry and the verified graph it imports, if any.

    The compiler reads `ENTRY.packages` beside the entry, so the app's sources (the .wy files)
    are staged in the temporary directory with a generated list naming the fetched copies.
    """
    owner = manifest.parent
    test_entry = owner / "test.wy"
    native = test_entry.is_file()
    def test_member(path):
        return path.samefile(test_entry) or path.resolve().is_relative_to(owner / "tests")
    if native and test_member(entry):
        raise ProjectError("a production entry cannot be a package test member")
    registry, dependencies = read_dependencies(manifest, project=project)
    if required_tuf_snapshot is not None and (not isinstance(registry, TufRegistry) or not dependencies):
        raise ProjectError("--tuf-snapshot requires locked TUF registry dependencies")
    policy = entry.with_suffix(".policy")
    if policy_bytes is READ_POLICY_FROM_DISK:
        policy_bytes = read_optional_control_file(policy)
    if require_policy and (dependencies or entry.with_suffix(".packages").exists()) and policy_bytes is None:
        # The compiler holds each file to the policy beside the entry. Without one, a package,
        # from the registry or a checkout, would be held to nothing: its review is not optional.
        raise ProjectError(f"{policy.name} is missing: a package runs only under the executable's policy. "
                           f"`grimoire review` drafts one to review")
    if require_policy and policy_bytes is not None:
        unheld = unheld_checkouts(policy_bytes.decode("utf-8"), entry.with_suffix(".packages"))
        if unheld:
            raise ProjectError(f"{policy.name} holds not every listed package: {'; '.join(unheld)}")
    if not dependencies:
        if catalog_snapshot is not None:
            raise ProjectError("the catalog snapshot requires locked registry dependencies")
        return entry, None
    if entry.with_suffix(".packages").exists():
        raise ProjectError(f"{entry.with_suffix('.packages').name} lists local packages and witchy.toml has [dependencies]: use one")
    graph = read_lock(manifest, dependencies, registry, temp, catalog_snapshot=required_tuf_snapshot or catalog_snapshot,
                      catalog_ca_pin=catalog_ca_pin, lock_bytes=lock_bytes)
    if names is not None:
        # `names`: what each staged copy is to its author (`author_names`).
        names.extend(staged_names(graph))
    if releases is not None:
        # `releases`: each package's release as staged, for a review to list and compare.
        releases.update(graph.staged)
    if require_policy:
        # Every file of every release is held to a reviewed digest before anything is compiled:
        # the compiler asks a line only of a file with a function `main` reaches, so a file of
        # constants or types alone would otherwise change with no review.
        unpinned = unpinned_files(policy_bytes.decode("utf-8"), graph.staged)
        if unpinned:
            raise ProjectError(f"{policy.name} does not pin every file of the locked packages: {'; '.join(unpinned)}. "
                               f"Read them (`grimoire review`), then `grimoire review --accept` pins what was reviewed")
    # Each line says what its package requires: the compiler refuses an import of any other
    # package by name, so the lock's edges are the build's (needs Witchy 2 5115d041).
    listing = package_listing(graph)
    app = Path(temp) / "app"
    # Preserve production roles while relocating the registry consumer. The relocated
    # tree has no test members, including aliases that resolve to a test source.
    def excluded(folder,names):
        ignored = []
        for name in names:
            path = Path(folder) / name
            if native and name in (".git", ".hg", ".svn", "target", "__pycache__", ".grimoire"):
                ignored.append(name)
                continue
            if not path.is_dir() and path.suffix != ".wy":
                ignored.append(name)
            elif native and test_member(path):
                ignored.append(name)
            elif native and path.is_symlink():
                raise ProjectError("a production source or directory is a symbolic link")
            elif native and path.is_file() and path.stat().st_nlink != 1:
                raise ProjectError("a production source has multiple filesystem links")
        return ignored
    source_root = owner if native else entry.parent
    if names is not None:
        names.append((f"{app}/", "" if shown_path(source_root) == "." else f"{shown_path(source_root)}/"))
    shutil.copytree(source_root, app, ignore=excluded)
    staged = app / entry.relative_to(source_root)
    staged.with_suffix(".packages").write_text("\n".join(listing) + "\n")
    # The policy goes with the entry: policies name the app's files relative to it, and each
    # package as `@name` wherever its copy is, so the staged build is held to the same lines.
    if policy_bytes is not None:
        staged.with_suffix(".policy").write_bytes(policy_bytes)
    return staged, graph


def shown_sources():
    """Where a copy of each package source a review has shown is kept, named by its SHA-384: the
    text an accepted digest stands for, so the next review can say what changed since. A copy
    is evidence of nothing (it is checked against its name when read) and grants nothing."""
    return Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "grimoire" / "sources"


def reviewed_grants(manifest, document, lines, *, manifest_bytes=None, grant_text=None, lock_bytes=READ_LOCK_FROM_DISK):
    """What `grimoire review --accept` records of a run's grants, and what `grimoire run --quiet`
    compares: the manifest's path and bytes, the grant document's bytes, the lock's bytes (each
    or its absence), and the `grant:` and `limit:` lines exactly as they are shown. Any change in
    any of them, or in what would be shown, is another record."""
    def part(label, data):
        return f"{label} {'none' if data is None else len(data)}\n".encode() + (data or b"")
    manifest_bytes = read_control_file(manifest) if manifest_bytes is None else manifest_bytes
    grant_bytes = grant_text.encode("utf-8") if grant_text is not None else None
    if grant_text is None and document is not None:
        grant_bytes = read_control_file(document)
    return (b"grimoire-reviewed-grants 1\n" + part("manifest-path", str(manifest).encode()) + part("manifest", manifest_bytes)
            + part("grants", grant_bytes) + part("lock", read_lock_bytes(manifest.parent / LOCK, lock_bytes))
            + part("lines", "".join(line + "\n" for line in lines).encode()))


def reviewed_folder():
    return Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "grimoire" / "reviewed"


def record_reviewed(record):
    """Keep a reviewed record in this machine's state, named by its SHA-384. Never in the
    project: a record a project carried would let its author hide its grants from a quiet run."""
    folder = reviewed_folder()
    folder.mkdir(mode=0o700, parents=True, exist_ok=True)
    digest = hashlib.sha384(record).hexdigest()
    kept = folder / digest
    staged = folder / f".{digest}.{os.getpid()}"
    staged.write_bytes(record)
    os.replace(staged, kept)
    return digest


def was_reviewed(record):
    """The record's digest when this machine keeps exactly it; None otherwise. A kept file is
    read without following a link and must hold these very bytes."""
    digest = hashlib.sha384(record).hexdigest()
    try:
        descriptor = os.open(reviewed_folder() / digest, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None
    with os.fdopen(descriptor, "rb") as kept:
        return digest if kept.read(len(record) + 1) == record else None


def show_run_grants(lines, manifest, document, quiet, reviewed=None, *, manifest_bytes=None, grant_text=None, lock_bytes=READ_LOCK_FROM_DISK):
    """A run's `grant:` and `limit:` lines, on standard error before anything is built. With
    `--quiet` (the operator's, on the command line only), one line in their place when
    `grimoire review --accept` on this machine recorded exactly these (`reviewed`: the lines as a
    review shows them, without this launch's words after `--`); otherwise every line, after one
    that says why the run is not quiet. Nothing else is ever left out: warnings, refusals and the
    engine's own lines are not these."""
    if quiet:
        digest = was_reviewed(reviewed_grants(manifest, document, lines if reviewed is None else reviewed,
                                               manifest_bytes=manifest_bytes, grant_text=grant_text, lock_bytes=lock_bytes))
        if digest is not None:
            say(f"grants as reviewed (digest {digest})")
            return
        say("not quiet: no `grimoire review --accept` on this machine recorded these grants and limits for this manifest, grant document and lock")
    for line in lines:
        say(line)


def keep_source(data):
    folder = shown_sources()
    folder.mkdir(mode=0o700, parents=True, exist_ok=True)
    kept = folder / f"{hashlib.sha384(data).hexdigest()}.wy"
    if not kept.exists():
        staged = folder / f".{kept.name}.{os.getpid()}"
        staged.write_bytes(data)
        os.replace(staged, kept)
    return kept


POLICY_PIN = re.compile(r"\s*@([a-z][a-z0-9-]{0,63})/?\s*:[^#]*;\s*digest sha384:([0-9a-f]{96})")


def source_changes(policy_text, listing, releases=None):
    """For each package the policy pins whose listed source is no longer the pinned text: what
    changed since the accepted source, when this machine kept a copy of it. One summary line,
    the functions the changes are in, and the two files to compare in full. A registry
    package (`releases`) is compared file by file (`release_changes`); a checkout's by the
    file its list line names."""
    sources = {}
    releases = releases or {}
    for line in listing.read_text().splitlines() if listing.is_file() else []:
        line = line.split("#")[0].strip()
        if ":" in line:
            head, target = line.split(":", 1)
            sources[head.split()[0]] = (" ".join(head.split()[1:]), listing.parent / target.split(";")[0].strip())
    lines = []
    for pinned in policy_text.splitlines():
        match = POLICY_PIN.match(pinned)
        if not match or match[1] not in sources or match[1] in releases:
            continue
        name, accepted = match[1], match[2]
        version, path = sources[name]
        new = path.read_bytes()
        if hashlib.sha384(new).hexdigest() == accepted:
            continue
        candidate = keep_source(new)
        before = shown_sources() / f"{accepted}.wy"
        try:
            old = before.read_bytes()
        except OSError:
            old = None
        if old is None or hashlib.sha384(old).hexdigest() != accepted:
            lines.append(f"@{name} {version}: differs from the accepted source (sha384:{accepted[:12]}...), of which this machine kept no copy "
                         f"(accepted elsewhere, or before copies were kept): read the new source whole, {candidate}")
            continue
        added, removed, places, touched = text_changes(old, new)
        lines.append(f"@{name} {version}: {added} lines added, {removed} removed in {places} place{'s' if places != 1 else ''} since the accepted source"
                     + (f"; in: {', '.join(touched[:12])}{', ...' if len(touched) > 12 else ''}" if touched else ""))
        lines.append(f"  compare: diff -u {before} {candidate}")
    for name in sorted(releases):
        lines += release_changes(policy_text, releases[name])
    return lines


def policy_rules(policy_text):
    """[(prefix, pinned digest or None)]: a policy's lines as the compiler reads them."""
    rules = []
    for line in policy_text.splitlines():
        line = line.split("#")[0].strip()
        if ": " in line:
            prefix, rest = line.rsplit(": ", 1)
        elif line.endswith(":"):
            prefix, rest = line[:-1], ""
        else:
            continue
        pins = [match[1] for flag in rest.split(";")[1:] if (match := re.fullmatch(r"digest (sha384:[0-9a-f]{96})", flag.strip()))]
        rules.append((prefix.strip(), pins[0] if pins else None))
    return rules


def policy_rule(rules, file):
    """The line `file` is held to, as the compiler chooses it: of those that cover it (a line
    ending in `/` what is under it, and a package's own `@NAME/` its first file `@NAME` too; any
    other line one name exactly), the longest. None: no line."""
    best = None
    for rule in rules:
        prefix = rule[0]
        if prefix.endswith("/"):
            package = prefix.startswith("@") and "/" not in prefix[1:-1]
            covers = file.startswith(prefix) or (package and file == prefix[:-1])
        else:
            covers = file == prefix
        if covers and (best is None or len(prefix) >= len(best[0])):
            best = rule
    return best


def unheld_checkouts(policy_text, listing):
    """Each package of a checkout's package list whose first file is in no line of the policy.
    The compiler asks a line only of a file with a function `main` reaches, so a listed
    package of constants or types alone would be held to nothing. (Its other files, and the
    program's own, are the compiler's to list: Grimoire does not know a checkout's file set.)"""
    rules = policy_rules(policy_text)
    names = []
    for line in listing.read_text().splitlines() if listing.is_file() else []:
        head = line.split("#")[0].split(":", 1)[0].split()
        if head and ":" in line.split("#")[0]:
            names.append(head[0])
    return [f"@{name} is in no line of the policy" for name in names if policy_rule(rules, f"@{name}") is None]


def unpinned_files(policy_text, releases, stale=True):
    """Each file of each staged release that no line of the policy holds to its digest, as a
    refusal: a file in no line, a file whose line has no digest and, with `stale`, a file whose
    line's digest is not of the release's bytes (a file line: the file; a directory line: every
    file of the release it governs, as the compiler computes it). Every file of the verified
    release is asked, whether or not `main` reaches a function in it."""
    rules = policy_rules(policy_text)
    refusals, governed = [], {}
    for name, staged in sorted(releases.items()):
        for file, data in staged.files():
            rule = policy_rule(rules, file)
            if rule is None:
                refusals.append(f"{file} is in no line of the policy")
            elif rule[1] is None:
                refusals.append(f"{file} is held to a line with no digest ({rule[0]})")
            else:
                governed.setdefault(rule, []).append((file, "sha384:" + hashlib.sha384(data).hexdigest()))
    for (prefix, pin), files in governed.items() if stale else ():
        now = "sha384:" + hashlib.sha384(tree_listing(prefix, files)).hexdigest() if prefix.endswith("/") else files[0][1]
        if now != pin:
            refusals.append(f"{prefix} has changed since its line was reviewed: its digest is now {now}")
    return refusals


# The policies `grimoire new` writes. `review --write-policy` may replace exactly one of these
# texts: each is a scaffold, not a policy anyone reviewed.
SCAFFOLD_POLICY = "# What each file of the program may use; every build applies it.\n<standard>/: *\nmain.wy: Console<Write>\n"
SERVICE_POLICY = ("# What each file of the program may use; every build applies it.\n<standard>/: *\n"
                  "main.wy: Allocator, Dir, Socket\nreply.wy: nothing\n")
TOOL_POLICY = "# What each file of the program may use; every build applies it.\n<standard>/: *\nmain.wy: Allocator, Args, Console<Read>, Console<Write>\n"
SCAFFOLD_POLICIES = (SCAFFOLD_POLICY, SERVICE_POLICY, TOOL_POLICY)
OWN_PIN = re.compile(r"\s*;\s*digest sha384:[0-9a-f]{96}")


def own_files_unpinned(draft):
    """A drafted policy without digests on the project's own files. The compiler drafts a digest
    for every file. A pin says "this text is the one that was reviewed", which is what a
    consumer needs of code it did not write: a package (`@NAME`) and the standard library
    (`<standard>/`) keep theirs. The project's own sources are their author's, changed in every
    edit, and what holds them is the capability list on their line: an edit that needs more
    than the line allows is refused, pinned or not. An author who wants a pin on an own file
    writes one, and `--accept` keeps it current."""
    lines = []
    for line in draft.splitlines(keepends=True):
        code, mark, comment = line.partition("#")
        if not code.lstrip().startswith(("@", "<")) and ":" in code:
            code = OWN_PIN.sub("", code)
        lines.append(code + mark + comment)
    return "".join(lines)


def pinned_draft(draft, releases):
    """A drafted policy with a pinned line for each file of a release the compiler drafted none
    for: a file with no function `main` reaches (constants, types). It may use nothing. The
    project's own files are drafted without a digest (`own_files_unpinned`)."""
    draft = own_files_unpinned(draft)
    rules = policy_rules(draft)
    extra = [f"{file}: nothing ; no unchecked ; digest sha384:{hashlib.sha384(data).hexdigest()}"
             for _, staged in sorted(releases.items()) for file, data in staged.files() if policy_rule(rules, file) is None]
    if extra:
        draft = (draft if draft.endswith("\n") or not draft else draft + "\n") \
            + "# No function `main` reaches is in these files (constants, types): pinned all the same.\n" + "\n".join(extra) + "\n"
    return draft


REACHED_FILE = re.compile(r"(\S.*): ([0-9]+) reachable functions?;")


def reached_files(by_file):
    """The files that hold a function `main` reaches, from the compiler's `wasm-caps --by-file`
    listing. (It was taken from the lines of a drafted policy; the compiler now drafts a line
    for every file of the bundle, reached or not, so that said nothing of which are reached,
    and a file of constants alone was left for its author to write a line for.)"""
    return {match[1] for line in by_file.splitlines() if (match := REACHED_FILE.match(line)) and int(match[2]) > 0}


def lines_to_accept(policy_text, by_file):
    """The policy with a `nothing` line for each file of the program (the compiler's by-file
    listing) that no line holds and that has no function `main` reaches. Code the author did
    not write (`<standard>/`, a package) gets a digest to re-pin; the project's own file a
    line without one, as a draft gives it. A file with reached code and no line is left for
    its author: what it may use is theirs to say."""
    rules = policy_rules(policy_text)
    extra = []
    for line in by_file.splitlines():
        match = REACHED_FILE.match(line)
        if match and int(match[2]) == 0 and policy_rule(rules, match[1]) is None:
            pin = f" ; digest sha384:{'0' * 96}" if match[1].startswith(("@", "<")) else ""
            extra.append(f"{match[1]}: nothing ; no unchecked{pin}")
    return policy_text + ("" if policy_text.endswith("\n") or not policy_text else "\n") + "".join(line + "\n" for line in extra)


def pins_to_accept(policy_text, releases, reached):
    """The policy with a digest to re-pin on every line that holds a release's file without one,
    and a line (`nothing`) for each release file in no line that holds no function `main`
    reaches (`reached`: the files that do; those need a line their author writes, as before).
    The digests written here are placeholders: `wasm-caps --repin` sets each to the code."""
    rules = policy_rules(policy_text)
    files = [file for _, staged in sorted(releases.items()) for file, _ in staged.files()]
    bare = {rule[0] for file in files if (rule := policy_rule(rules, file)) is not None and rule[1] is None}
    out = []
    for line in policy_text.splitlines():
        code, mark, comment = line.partition("#")
        stripped = code.strip()
        prefix = stripped.rsplit(": ", 1)[0].strip() if ": " in stripped else stripped[:-1].strip() if stripped.endswith(":") else None
        if prefix in bare and "digest " not in stripped:
            bare.discard(prefix)
            code = f"{code.rstrip()} ; digest sha384:{'0' * 96}" + (" " if mark else "")
        out.append(code + mark + comment)
    extra = [f"{file}: nothing ; no unchecked ; digest sha384:{'0' * 96}" for file in files if policy_rule(rules, file) is None and file not in reached]
    return "\n".join(out + extra) + "\n"


def tree_listing(prefix, files):
    """What a directory line's digest is of (the compiler's `covered_digest`): for each file it
    covers, in name order, its name under the line, NUL, its pin, LF."""
    return "".join(f"{name.removeprefix(prefix)}\0{pin}\n" for name, pin in sorted(files)).encode()


def keep_tree(listing):
    """Keep what a directory line's accepted digest stands for, named by that digest, as
    `keep_source` keeps a file's text: checked against its name when read."""
    folder = shown_sources()
    folder.mkdir(mode=0o700, parents=True, exist_ok=True)
    kept = folder / f"{hashlib.sha384(listing).hexdigest()}.tree"
    if not kept.exists():
        staged = folder / f".{kept.name}.{os.getpid()}"
        staged.write_bytes(listing)
        os.replace(staged, kept)
    return kept


def kept_tree(prefix, pin):
    """{file: pin} for the files a directory line pinned as `pin` covered, if this machine kept
    them and they are what their name says; else None."""
    try:
        listing = (shown_sources() / f"{pin.removeprefix('sha384:')}.tree").read_bytes()
    except OSError:
        return None
    if "sha384:" + hashlib.sha384(listing).hexdigest() != pin:
        return None
    files = {}
    for line in listing.decode("utf-8", "replace").split("\n")[:-1]:
        name, separator, digest = line.partition("\0")
        if not separator or not DIGEST.fullmatch(digest):
            return None
        files[name if name.startswith("@") else prefix + name] = digest
    return files


def text_changes(old, new):
    """(lines added, lines removed, places, the functions the changes are in) between two texts."""
    import difflib
    was, now = old.decode("utf-8", "replace").splitlines(), new.decode("utf-8", "replace").splitlines()
    added = removed = places = 0
    touched = []
    for tag, a, b, c, d in difflib.SequenceMatcher(None, was, now, autojunk=False).get_opcodes():
        if tag == "equal":
            continue
        places += 1
        removed += b - a
        added += d - c
        # The function the change is in: the nearest `fn` at or above it in the new text.
        for at in range(min(d, len(now)) - 1 if d > c else min(c, len(now) - 1), -1, -1):
            found = re.match(r"\s*(?:pub )?(?:test )?fn ([A-Za-z_][A-Za-z0-9_.]*)", now[at]) if now else None
            if found:
                if found[1] not in touched:
                    touched.append(found[1])
                break
    return added, removed, places, touched


def release_changes(policy_text, staged):
    """What changed in one registry package since the files its policy lines accepted, file by
    file: each file added, removed or changed, none left out. The accepted state is what the
    policy's digests pin: a file's line its text, a directory's line (`@NAME/`) the files it
    covered, each kept on this machine when it was accepted (`keep_source`, `keep_tree`) and
    checked against the digest when read. Where no copy was kept, every file that may differ
    is named, to be read whole. Nothing here decides anything: the compiler holds the build to
    the policy's digests, and this says what a mismatch is made of."""
    name, version = staged.name, staged.version
    rules = policy_rules(policy_text)
    pinned = [rule for rule in rules if rule[1] and (rule[0] == f"@{name}" or rule[0].startswith(f"@{name}/"))]
    if not pinned:
        return []
    current = dict(staged.files())
    now = {file: "sha384:" + hashlib.sha384(data).hexdigest() for file, data in current.items()}
    accepted, unknown = {}, []
    for rule in pinned:
        prefix, pin = rule
        if not prefix.endswith("/"):
            accepted[prefix] = pin
            continue
        covered = [(file, digest) for file, digest in now.items() if policy_rule(rules, file) == rule]
        if "sha384:" + hashlib.sha384(tree_listing(prefix, covered)).hexdigest() == pin:
            accepted.update(covered)
            continue
        kept = kept_tree(prefix, pin)
        if kept is None:
            unknown.append((prefix, pin, sorted(file for file, _ in covered)))
        else:
            accepted.update(kept)
    lines = []
    def whole(file):
        return keep_source(current[file])
    for file in sorted(set(accepted) | set(now)):
        if file in accepted and file in now:
            if accepted[file] == now[file]:
                continue
            candidate = whole(file)
            before = shown_sources() / f"{accepted[file].removeprefix('sha384:')}.wy"
            try:
                old = before.read_bytes()
            except OSError:
                old = None
            if old is None or "sha384:" + hashlib.sha384(old).hexdigest() != accepted[file]:
                lines.append(f"{file} {version}: differs from the accepted source ({accepted[file][:19]}...), of which this machine kept no copy "
                             f"(accepted elsewhere, or before copies were kept): read the new source whole, {candidate}")
                continue
            added, removed, places, touched = text_changes(old, current[file])
            lines.append(f"{file} {version}: {added} lines added, {removed} removed in {places} place{'s' if places != 1 else ''} since the accepted source"
                         + (f"; in: {', '.join(touched[:12])}{', ...' if len(touched) > 12 else ''}" if touched else ""))
            lines.append(f"  compare: diff -u {before} {candidate}")
        elif file in now:
            rule = policy_rule(rules, file)
            if rule is not None and any(rule[:2] == known[:2] for known in unknown):
                continue  # named below with its directory
            count = len(current[file].decode("utf-8", "replace").splitlines())
            held = ", in no line of the policy" if rule is None else f", held to a line with no digest ({rule[0]})" if rule[1] is None else ""
            lines.append(f"{file} {version}: a new file ({count} line{'s' if count != 1 else ''}){held}: read it whole, {whole(file)}")
        else:
            lines.append(f"{file}: removed since the accepted source ({accepted[file][:19]}...): {version} has no such file")
    for prefix, pin, covered in unknown:
        lines.append(f"{prefix} {version}: differs from the accepted files ({pin[:19]}...), of which this machine kept no list (accepted elsewhere, "
                     f"or before lists were kept): files may have been added, removed or changed; read each whole:")
        lines += [f"  {file}: {whole(file)}" for file in covered]
    return lines


def release_files(releases):
    """A review's list of every file of each package of several files: what its release holds,
    whether or not `main` reaches a function there."""
    lines = []
    for name, staged in sorted(releases.items()):
        if staged.release.format == 1:
            continue
        lines.append(f"@{name} {staged.version}: {len(staged.release.files)} files in the release {staged.release.digest}")
        entry = staged.release.entry
        lines += [f"  {file}{f' ({entry})' if file == f'@{name}' else ''}: {len(data)} bytes, sha384:{hashlib.sha384(data).hexdigest()}"
                  for file, data in staged.files()]
    return lines


def review_project(project, accept, write_policy=False, replace=False):
    """Show what each file of the locked program uses, against the executable's policy.

    The packages are the verified, locked copies `grimoire run` would build. `--accept` records
    the reviewed code's digests in the policy (`wasm-caps --repin`). It changes no capability, so
    a package that now reaches further is still refused until the author edits its line.
    """
    manifest = (project / "witchy.toml" if project.is_dir() else project).resolve()
    manifest_bytes = read_control_file(manifest)
    project_data = tomllib.loads(manifest_bytes.decode("utf-8"))
    entry, _, _ = read_project(manifest, project=project_data)
    lock_bytes = read_lock_bytes(manifest.parent / LOCK)
    check_toolchain(manifest, lock_bytes=lock_bytes)
    compiler = tool("WITCHYC", "witchyc")
    policy = entry.with_suffix(".policy")
    policy_bytes = read_optional_control_file(policy)
    policy_text = None if policy_bytes is None else policy_bytes.decode("utf-8")
    with tempfile.TemporaryDirectory(prefix="grimoire-") as temp:
        names, releases = [], {}
        staged, _ = stage_registry_packages(manifest, entry, temp, require_policy=False, names=names, releases=releases,
                                             project=project_data, lock_bytes=lock_bytes, policy_bytes=policy_bytes)
        # Run beside the entry, so files are named as the policy names them; a staged copy's
        # path, where one is printed, as its author's.
        caps = lambda *args, check=True, capture_output=False: compiler_client().run(
            [compiler, "wasm-caps", *args], cwd=staged.parent, check=check, capture_output=capture_output,
            env=toolchain_environment(), rewrite=author_names(names))
        def check_policy(*, capture_output=False):
            if read_optional_control_file(policy) != policy_bytes:
                raise ProjectError(f"{policy} changed during policy review")
            result = caps("--policy", policy.name, staged.name, check=False, capture_output=capture_output)
            if read_optional_control_file(policy) != policy_bytes:
                raise ProjectError(f"{policy} changed during policy review")
            return result

        caps("--by-file", staged.name)
        files = release_files(releases)
        if files:
            print("\nEvery file of each package of several files (a file with no line above has no function `main` reaches):\n"
                  + "\n".join(files), flush=True)
        # What the run would be granted, from the executable's grant document, checked as
        # `grimoire run` checks it before it builds. A document a run would refuse shows no
        # grant and fails the review, but the policy is still shown, and `--accept` still pins
        # it: accepting changes no capability and no grant.
        print("\nThe grants of a run (the executable's grant document, as `grimoire run` passes them; each secret"
              "\nfrom its default source, and `run` checks a granted file against the secrets' sources again):", flush=True)
        refused = False
        grant_review = None
        try:
            grant_review = run_project(manifest, review=staged, names=names, manifest_bytes=manifest_bytes,
                                       lock_bytes=lock_bytes)
        except subprocess.CalledProcessError:
            refused = True
            say("a run would be refused: the grant document does not fit `main`")
        except ProjectError as error:
            refused = True
            say(f"a run would be refused: {error}")
        print(flush=True)
        # The draft may take the place of the scaffold `grimoire new` wrote (which nobody
        # reviewed), or of any policy when the author says so in so many words (`--replace`).
        scaffold = policy_text is not None and policy_text.replace("\r\n", "\n") in SCAFFOLD_POLICIES
        if write_policy and (policy_bytes is None or scaffold or replace):
            draft = pinned_draft(caps("--draft-policy", staged.name, capture_output=True).stdout, releases)
            write_control_update(policy, draft.encode("utf-8"), policy_bytes, "policy review")
            what = "in place of the one `grimoire new` wrote" if scaffold else "in place of the policy that was there (--replace)" if replace else "a draft"
            print(f"\nwrote {shown_path(policy)} ({what}): the program fits it now. Review and narrow each line; nothing was accepted for you.")
            return int(refused)
        if policy_bytes is None:
            print(f"\n{policy.name} is missing. A draft the program fits now, to review and narrow (`grimoire review --write-policy` writes it):\n")
            print(pinned_draft(caps("--draft-policy", staged.name, capture_output=True).stdout, releases), end="", flush=True)
            return 1
        if write_policy:
            raise ProjectError(f"{policy.name} exists and has been edited: --write-policy writes a missing policy, or replaces the one `grimoire new` wrote. "
                               "Edit it, `grimoire review --accept` to re-pin its digests, or `grimoire review --write-policy --replace` to draft it again from the program")
        # What changed in each package since the source its policy line accepted.
        changes = source_changes(policy_text, staged.with_suffix(".packages"), releases)
        if changes:
            print("Changed since accepted:\n" + "\n".join(changes) + "\n", flush=True)
        if not accept:
            # A release file no line pins is a refusal of its own: the compiler asks a line only
            # of a file with a function `main` reaches, and so says "fits" without it.
            unpinned = unpinned_files(policy_text, releases, stale=False)
            if not unpinned:
                return check_policy().returncode or int(refused)
            checked = check_policy(capture_output=True)
            shown = "".join(line for line in (checked.stdout or "").splitlines(keepends=True) if line.strip() != "fits the policy")
            print(shown + "\n".join(unpinned) + "\nnot pinned: `grimoire run` refuses these until `grimoire review --accept` pins what was reviewed", flush=True)
            if checked.stderr:
                relay(checked.stderr)
            return 1
        # Repin a copy beside the entry (a policy names files from its own directory), and keep
        # it only if the program then fits: accepting never leaves a policy the program breaks.
        with tempfile.NamedTemporaryFile(prefix=f".{policy.name}.", dir=staged.parent) as scratch:
            work = Path(scratch.name)
            # Accepting pins every file of every release that was shown: a line with no digest
            # gets one, and a file with no function `main` reaches gets a line. So does any
            # other file of the program that is in no line and holds no reached function (a
            # standard-library file a new compiler bundles, the project's own constants): the
            # compiler refuses a file in no line, and a `nothing` line grants nothing.
            listing = caps("--by-file", staged.name, capture_output=True).stdout
            accepted = lines_to_accept(pins_to_accept(policy_text, releases, reached_files(listing)), listing)
            scratch.write(accepted.encode("utf-8"))
            scratch.flush()
            caps("--repin", work.name, staged.name)
            accepted_bytes = read_control_file(work)
            left = unpinned_files(accepted_bytes.decode("utf-8"), releases)
            if left:
                print("\n".join(left), flush=True)
            if caps("--policy", work.name, staged.name, check=False).returncode or left:
                say(f"not accepted: {policy.name} is unchanged")
                return 1
            if read_control_file(work) != accepted_bytes:
                raise ProjectError(f"{policy} changed during policy checking")
            write_control_update(policy, accepted_bytes, policy_bytes, "policy review")
            # Keep the text each accepted digest stands for: the next review compares with it.
            listing = staged.with_suffix(".packages")
            for line in listing.read_text().splitlines() if listing.is_file() else []:
                line = line.split("#")[0].strip()
                if ":" in line:
                    source = listing.parent / line.split(":", 1)[1].split(";")[0].strip()
                    if source.is_file():
                        keep_source(source.read_bytes())
            # And every file of each registry package, with the files each accepted directory
            # line covers: the next review says which were added, removed or changed.
            rules = policy_rules(accepted_bytes.decode("utf-8"))
            for name, release in releases.items():
                pins = {file: "sha384:" + hashlib.sha384(data).hexdigest() for file, data in release.files()}
                for file, data in release.files():
                    keep_source(data)
                for rule in rules:
                    if rule[1] and rule[0].endswith("/") and rule[0].startswith(f"@{name}/"):
                        listed = tree_listing(rule[0], [(file, pin) for file, pin in pins.items() if policy_rule(rules, file) == rule])
                        if "sha384:" + hashlib.sha384(listed).hexdigest() == rule[1]:
                            keep_tree(listed)
            # And the grants it showed, for `grimoire run --quiet` on this machine.
            if grant_review is not None and not refused:
                digest = record_reviewed(grant_review)
                print(f"recorded these grants as reviewed on this machine (digest {digest}): `grimoire run --quiet` shows one line for them")
            return 0


def capture_build_record(manifest, entry, grant_text, flags, module_pin, compiler, host, *, graph=None,
                         manifest_bytes=None, lock_bytes=READ_LOCK_FROM_DISK):
    """Capture the build inputs before dropping the staged sources and module."""
    app = entry.parent
    packages = {}
    tuf_snapshot = graph.tuf_snapshot if graph is not None else None
    if graph is not None:
        # Record the verified releases that supplied these staged files.
        for name, (version, digest, requires, _, signer, *_) in sorted(graph.items()):
            staged = graph.staged[name]
            package = {"source": file_digest(staged.entry), "version": version,
                       "digest": digest, "requires": requirement_list(requires)}
            if tuf_snapshot is not None:
                package.update(publisher=signer, target=graph.tuf_targets[name])
            else:
                package["signer"] = signer
            if len(staged.release.files) > 1:
                package["files"] = {name: file_digest(staged.root / name) for name, _ in staged.release.files}
            packages[name] = package
    else:
        listing = entry.with_suffix(".packages")
        for line in listing.read_text().splitlines() if listing.exists() else []:
            line = line.split("#")[0].strip()
            if not line or ":" not in line:
                continue
            head, target = line.split(":", 1)
            name, *version = head.split()
            source = listing.parent / target.split(";")[0].strip()
            packages[name] = {"source": file_digest(source), "version": version[0] if version else None}
    optional = lambda p: file_digest(p) if p is not None and Path(p).exists() else None
    manifest_bytes = read_control_file(manifest) if manifest_bytes is None else manifest_bytes
    if tuf_snapshot is not None:
        lock_digest = graph.tuf_lock_digest
    else:
        lock_bytes = read_lock_bytes(manifest.parent / LOCK, lock_bytes)
        lock_digest = None if lock_bytes is None else "sha384:" + hashlib.sha384(lock_bytes).hexdigest()
    record = {
        "schema": "grimoire-build-record 1",
        "toolchain": {"compiler": file_digest(compiler), "host": file_digest(host)},
        "manifest": "sha384:" + hashlib.sha384(manifest_bytes).hexdigest(),
        "lock": lock_digest,
        "policy": optional(entry.with_suffix(".policy")),
        "grants": None if grant_text is None else "sha384:" + hashlib.sha384(grant_text.encode("utf-8")).hexdigest(),
        "entry": entry.name,
        "sources": {str(p.relative_to(app)): file_digest(p) for p in sorted(app.rglob("*.wy"))},
        "packages": packages,
        # Never the words of the launch: they are this run's, not the build's, and may be secret.
        "host_flags": [flag for flag in flags if not flag.startswith("--arg=")],
        "module": module_pin,
    }
    if tuf_snapshot is not None:
        digest, version = tuf_snapshot
        record["tuf"] = {"snapshot": digest, "snapshot-version": version}
        if graph.tuf_ca_pin is not None:
            record["tuf"]["ca-pin"] = graph.tuf_ca_pin
    return record


def publish_run_record(path, record):
    with tempfile.TemporaryDirectory(prefix=".grimoire-record-", dir=path.parent) as temp:
        staged = Path(temp) / "record.json"
        staged.write_text(json.dumps(record | {"completed": True}, indent=2) + "\n", encoding="utf-8")
        os.replace(staged, path)


def input_grant(flag, document, takes_secrets, already):
    """The engine flags for the program's one input (`main(input: Console<Read>)`): a file the
    grant document names, or this launch's standard input when it says `{ stdin = true }`. The
    engine reads either whole, within `[run] input-bytes`, before the program starts.

    No input while the program takes secrets, file or standard input (fails closed, as a
    directory is refused): an input's bytes go straight to the program, and a path or an
    unnamed descriptor that reached a secret's source would hand it the secret.

    A file is examined here without following a link, must be a regular file, and is passed
    with its identity (`--input-id=DEVICE:INODE`): the engine opens the path without following
    a link and runs only if what it opened is that file, so one put at the path after this look
    (a link, another file) is refused there, not read. There is no check of the path that the
    engine's open could differ from."""
    if already:
        raise ProjectError("a run is granted one input")
    if takes_secrets:
        raise ProjectError(f"{document}: [input] grants an input: refused while the program takes secrets")
    if flag == "--input-stdin":
        return [flag]
    path = flag[len("--input="):]
    try:
        status = os.lstat(path)
    except OSError:
        status = None
    if status is None or not stat.S_ISREG(status.st_mode):
        raise ProjectError(f"{document}: [input] names {path}, which is not a regular file that is there (a link is not followed)")
    return [flag, f"--input-id={status.st_dev}:{status.st_ino}"]


def check_granted_file(granted, takes_secrets, objects, chosen):
    # A granted file is never a secret's descriptor source, by its name or a hard
    # link (review of 33face12). This is a pre-check, to stop before the build: the
    # file can change between here and the engine's open, so the engine itself also
    # refuses it, given each source file's identity (`--secret-object`, below). With
    # secrets, the check fails closed: a granted file that is not there, or a
    # descriptor alias (/dev/fd, /proc, /dev/std*), is refused rather than looked past
    # (automated review of 3997fa8).
    # Any secret, wherever its value came from, is on one of the engine's pipes, so the
    # gate is whether the program takes secrets at all (automated review of cd653b3);
    # paths are normalized before matching (`/dev//fd/3`).
    aliases = ("/dev/fd/", "/proc/", "/dev/stdin", "/dev/stdout", "/dev/stderr")
    if takes_secrets and (os.path.normpath(granted).startswith(aliases) or os.path.realpath(granted).startswith(aliases)):
        raise ProjectError(f"granted file {granted} is a descriptor alias, refused while the program takes secrets")
    try:
        status = os.stat(granted)
        # With secrets, a granted file must be a regular file: this catches every
        # spelling of a descriptor alias (`/dEv/fd/0` on a case-insensitive volume;
        # review of d7b03ec1), which a prefix match does not.
        if takes_secrets and not stat.S_ISREG(status.st_mode):
            raise ProjectError(f"granted file {granted} is not a regular file, refused while the program takes secrets")
        if (status.st_dev, status.st_ino) in objects:
            slot = objects[(status.st_dev, status.st_ino)]
            raise SecretError(slot, "source is also granted as a file", chosen[slot])
    except FileNotFoundError:
        if takes_secrets:
            raise ProjectError(f"granted file {granted} does not exist, refused while the program takes secrets") from None
    except OSError:
        raise ProjectError(f"granted file {granted} cannot be checked against the secrets' sources") from None


def launch_words(words, grant):
    """The engine's `--arg=` flags for the words an operator gave after `--`, checked against the
    document's `[args]` grant (`grant`: the compiler's `--args=COUNT:BYTES`, or None where `main`
    takes no `Args`). Words for a program granted none are refused, as any grant no parameter
    takes is; so are more words or bytes than granted, a word that is not UTF-8, and a NUL.
    Each word becomes one argument of the engine's, after `--arg=`: no shell reads it, and the
    engine takes everything after the `=` as the word, whatever it looks like."""
    words = list(words or ())
    if grant is None:
        if words:
            raise ProjectError(f"this launch gives {len(words)} argument{'s' if len(words) != 1 else ''} after `--`, and the program takes none "
                               "(main has no Args parameter that its grant document's [args] grants)")
        return []
    most, _, room = grant.partition(":")
    if not (most.isascii() and most.isdigit() and room.isascii() and room.isdigit()):
        raise ProjectError("the compiler proposes an [args] grant this launcher cannot read")
    size = 0
    for word in words:
        try:
            size += len(word.encode("utf-8"))
        except UnicodeEncodeError:
            raise ProjectError("an argument after `--` is not UTF-8 text") from None
        if "\0" in word:
            raise ProjectError("an argument after `--` holds a NUL byte")
    if len(words) > int(most) or size > int(room):
        raise ProjectError(f"this launch gives {len(words)} arguments of {size} bytes after `--`, and the document's [args] grants at most {int(most)} words and {int(room)} bytes")
    return [f"--arg={word}" for word in words]


SHOWN_WORD = 96


def shown_word(word):
    """A word of the launch, for a `grant:` line: in quotes, every character outside printable
    ASCII written as an escape, so a word can neither end the line nor hide or reorder text."""
    shown = json.dumps(word[:SHOWN_WORD], ensure_ascii=True)
    # A run of spaces is written out: padding cannot push later text onto a row of its own
    # where the terminal wraps (review).
    shown = re.sub(r" {2,}", lambda m: "\\u0020" * len(m.group()), shown)
    return shown if len(word) <= SHOWN_WORD else f"{shown}... ({len(word)} characters)"


def run_snapshot_pin(snapshot):
    if snapshot is None:
        return None
    version, digest = snapshot
    if (not re.fullmatch(r"[1-9][0-9]{0,15}", version)
            or not valid_snapshot_version(int(version)) or not DIGEST.fullmatch(digest)):
        raise ProjectError("--tuf-snapshot needs a version from 1 to 2^53−1 and a SHA-384 digest")
    return digest, int(version)


def check_launch_pin(wire, pin, subject):
    if "sha384:" + hashlib.sha384(wire).hexdigest() != pin:
        raise ProjectError(f"{subject} differs from its approved --launch-pins digest")


def run_project(project, record=None, binds=(), launch=None, build_only=False, output=None, review=None, names=None,
                allowed=None, raw_output=False, allowed_files=(), words=None, *, catalog_snapshot=None,
                catalog_ca_pin=None, quiet=False, expected_module_pin=None, required_tuf_snapshot=None,
                captured_inputs=None, manifest_bytes=None, lock_bytes=READ_LOCK_FROM_DISK, launch_pins=None):
    """`review`: the staged entry of a `grimoire review`. The grants are checked as a run's are
    and shown on standard output. The returned receipt binds the displayed grants to
    the manifest, grant document, and lock used for the review. `words`: the arguments this launch gave after `--`. `quiet`: `grimoire run
    --quiet` (`show_run_grants`). A web build supplies the already checked manifest, grant and
    lock bytes."""
    if expected_module_pin is not None and DIGEST.fullmatch(expected_module_pin) is None:
        raise ProjectError("--module-pin needs sha384: followed by 96 lowercase hexadecimal digits")
    if launch_pins is not None and not all(DIGEST.fullmatch(pin) for pin in launch_pins):
        raise ProjectError("--launch-pins needs two sha384: digests with 96 lowercase hexadecimal digits each")
    build_only = build_only or review is not None
    allowed = allowed or {}
    if captured_inputs is None:
        manifest = (project / "witchy.toml" if project.is_dir() else project).resolve()
        manifest_bytes = read_control_file(manifest) if manifest_bytes is None else manifest_bytes
        lock_bytes = read_lock_bytes(manifest.parent / LOCK, lock_bytes)
    else:
        manifest = captured_inputs.manifest
        manifest_bytes = captured_inputs.manifest_bytes
        lock_bytes = captured_inputs.lock_bytes
    if launch_pins is not None:
        check_launch_pin(manifest_bytes, launch_pins[0], "project manifest")
    project_data = tomllib.loads(manifest_bytes.decode("utf-8"))
    entry, document, grants = read_project(manifest, project=project_data)
    own_entry, own_document = entry, document
    run_table = project_data["run"]
    limits = read_limits(manifest, run=run_table)
    module_limit = run_table.get("module-bytes", RUN_LIMITS["module-bytes"][3])
    sizes = read_sizes(run_table)
    # Fixed secrets first, before anything is fetched or built: the executable's own document
    # declares them, the deployment selects among its declared sources, and every value is read
    # now, or the run stops here naming the slot.
    document_base = None
    if captured_inputs is not None:
        grant_bytes = captured_inputs.grant_bytes
    elif document is not None:
        resolved = document.resolve(strict=True)
        document_base = resolved.parent
        grant_bytes = read_control_file(resolved, nofollow=True)
    else:
        grant_bytes = b""
    if launch_pins is not None:
        check_launch_pin(grant_bytes, launch_pins[1], "grant document")
    document_text = grant_bytes.decode("utf-8")
    grant = tomllib.loads(document_text)
    # A document with `[launch]` is a native launch plan: the executable embeds it, and
    # Grimoire builds, reviews and launches that executable (`run_native`).
    if "launch" in grant:
        if catalog_snapshot is not None:
            raise ProjectError("a catalog build requires a Wasm executable")
        if expected_module_pin is not None:
            raise ProjectError("--module-pin requires a Wasm executable")
        if required_tuf_snapshot is not None:
            raise ProjectError("--tuf-snapshot requires a Wasm executable")
        if record is not None or binds:
            raise ProjectError(f"{document}: a native launch plan takes neither --record nor --bind: "
                               "the plan is the executable's whole authority, and its secrets are the manifest's [native] secrets")
        return run_native(manifest, entry, document, grant, launch or {}, build_only=build_only, output=output, review=review,
                          names=names, raw_output=raw_output, words=words or [], allowed=allowed, allowed_files=allowed_files, quiet=quiet,
                          lock_bytes=lock_bytes, project_data=project_data, manifest_bytes=manifest_bytes, document_text=document_text)
    # Outbound connections are not a grant this launcher gives: a `[net]` section is refused
    # whatever `main` takes, before any secret is read or anything built. (Where `main` takes no
    # Net the compiler only warns of an over-grant and would leave the document's grant standing.)
    if "net" in grant:
        raise ProjectError(f"{document}: [net]: grimoire grants no outbound network access")
    sqlite_flags = declared_sqlite_flags(document, grant)
    directories = read_directory_grants(document, grant)
    declared = read_secret_slots(document, grant)
    # And a store's, each the launch variable of its name: declarations checked before any read.
    store = read_secret_store(document, declared, grant)
    chosen = select_secret_sources(declared, binds)
    # Taken while the descriptors are open: a `--file` grant is checked against them below.
    objects = {} if build_only else source_objects(chosen)
    originals = {} if build_only else source_files(chosen)
    values = {}
    if not build_only:
        values.update({("slot", name): value for name, value in resolve_secrets(declared, chosen, launch or {}).items()})
        values.update({("store", name): value for name, value in resolve_store(store, launch or {}).items()})
    compiler = tool("WITCHYC", "witchyc")
    host = None if build_only else tool("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")
    check_toolchain(manifest, lock_bytes=lock_bytes)
    from contextlib import ExitStack
    # The module's descriptor, closed if anything fails before the engine is given it, the
    # temporary directory's removal included (the first context listed exits last).
    with closed_on_failure() as held, tempfile.TemporaryDirectory(prefix="grimoire-") as temp, ExitStack() as requests:
        # Before anything is compiled: every registry package fetched and verified.
        names = [] if names is None else names
        entry, graph = (review, None) if review is not None else stage_registry_packages(
            manifest, entry, temp, names=names, catalog_snapshot=catalog_snapshot, project=project_data,
            catalog_ca_pin=catalog_ca_pin, lock_bytes=lock_bytes, required_tuf_snapshot=required_tuf_snapshot)
        if captured_inputs is not None:
            # Web grants declare stdin only. Both compiler paths can use this exact copy.
            document = Path(temp) / "web.grants.toml"
            document.write_bytes(captured_inputs.grant_bytes)
        elif document is None:
            document = Path(temp) / "empty.grants.toml"
            document.touch()
        if document_base is None:
            document_base = document.parent.resolve(strict=True)
        checked, build = requests.enter_context(compiler_client().reviewed_build(
            compiler, entry, document, toolchain_environment(), document_text, rewrite=author_names(names),
            sizes=None if sizes == tuple(default for *_, default in BUILD_SIZES.values()) else sizes,
            document_base=document_base, module_limit=module_limit))
        # The compiler reviews its proposed grants on stderr. Keep warnings and refusals. Its
        # `grant:` lines describe what it proposes, which is not yet what the engine gets (an
        # output or allocator this project withholds, a slot's selected source, `--no-links`):
        # the grants are shown below, from the flags as they will be passed.
        for line in checked.stderr.splitlines():
            if checked.returncode or not line.startswith("grant: "):
                relay(line)
        checked.check_returncode()
        proposed = checked.stdout.splitlines()
        proposed_sqlite = [flag for flag in proposed if flag.startswith(("--sqlite=", "--sqlite-"))]
        if sorted(proposed_sqlite) != sorted(sqlite_flags):
            raise ProjectError(f"{document}: SQLite grant disagrees with the executable's grant document")
        flags, slots, stored = [], {}, set()
        for flag in proposed:
            if flag in ("--allocator", "--output"):
                # wasm-grants proposes these implicitly, even for heap-free modules.
                if not grants.get(flag[2:]):
                    continue
            elif flag.startswith("--secret-slot="):
                # Exactly a slot Grimoire read, with its declared use and `from`: the compiler and
                # Grimoire must agree on the document, or nothing runs.
                name, _, rest = flag[len("--secret-slot="):].partition(":")
                use, _, source = rest.partition(":")
                if name not in declared or name in slots or declared[name][:2] != (use, source):
                    raise ProjectError(f"secret slot {name}: wasm-grants proposes a slot the grant document does not declare as read")
                slots[name] = use
                flags.append(f"--secret-slot={name}:{use}:{chosen[name]}")
                continue
            elif flag.startswith(("--secret=", "--secret-seal=")):
                # Exactly a store's secret Grimoire read, with its declared use, once.
                prefix, _, name = flag.partition("=")
                if name not in store or name in stored or STORE_USES[store[name]] != prefix + "=":
                    raise ProjectError(f"secret {name.partition('=')[0]}: wasm-grants proposes a store's secret the grant document does not declare as read")
                stored.add(name)
            elif flag.startswith("--listen="):
                # One loopback listener, at the address the executable's document names.
                if any(f.startswith("--listen=") for f in flags):
                    raise ProjectError("a run is granted one listener")
                check_listener(flag[len("--listen="):])
            elif flag.startswith("--args="):
                # `main(args: Args)`, granted by the document's `[args]`: once. The words are
                # this launch's, added below, never the compiler's or the manifest's.
                if any(f.startswith("--args=") for f in flags):
                    raise ProjectError(f"{document}: a run is granted its arguments once")
            elif flag == PER_CONNECTION:
                # `main(connection: Socket)`: only with the one listener, once. Nothing a
                # program holds once or across connections goes with it (the engine refuses
                # them too): no secret, and no input.
                if flag in flags or not any(f.startswith("--listen=") for f in flags):
                    raise ProjectError(f"{document}: the compiler proposes a program for each connection without its one listener")
                if declared or store or any(f.startswith("--input") for f in flags):
                    raise ProjectError(f"{document}: a program run once for each connection (main takes a Socket) is granted no secret and no input")
            elif flag.startswith("--write-dir="):
                # A second directory, for writing, beside one to read: one directory a run.
                raise ProjectError(f"{document}: [dirs]: a run is granted one directory, and main takes one to read and another to write; "
                                   'take one `Dir` with rights = ["Read", "Write"]')
            elif flag.startswith("--dir-rights="):
                # The rights of the one directory, beyond reading: exactly what the executable's
                # own document states for it, in so many words. The compiler gives a `Dir` or
                # `Dir<Write>` parameter its type's rights where the entry states none; here an
                # unstated right to write is refused, so the document a reviewer reads says it.
                root = next((f[len("--dir="):] for f in flags if f.startswith("--dir=")), None)
                if root is None or any(f.startswith("--dir-rights=") for f in flags) or len(directories) != 1:
                    raise ProjectError(f"{document}: [dirs]: a run is granted one directory")
                (name, (_, stated)), = directories.items()
                proposed = flag[len("--dir-rights="):]
                if proposed not in ("write", "read,write"):
                    raise ProjectError(f"{document}: [dirs] {name}: the compiler proposes rights this launcher does not grant")
                if stated != proposed:
                    wanted = '["Read", "Write"]' if proposed == "read,write" else '["Write"]'
                    raise ProjectError(f"{document}: [dirs] {name}: main takes a directory it can write, and the entry "
                                       f"{'states other rights' if stated else 'states no rights'}: write `rights = {wanted}` to grant it")
            elif flag.startswith("--dir="):
                # One directory. The compiler writes `--dir=` alone for a `Dir<Read>`; any right
                # beyond reading follows as `--dir-rights=`, checked above against the document.
                if any(f.startswith("--dir=") for f in flags):
                    raise ProjectError("a run is granted one directory")
                # Decision (automated review of d5d6344): no directory grant while the program
                # takes any secret. A tree can hold a secret's source file under any name or hard
                # link, found only by walking it. The engine does refuse a read of a
                # `--secret-object` file through the directory (`read_whole` checks the opened
                # file's device and inode), but an `env:` or store secret has no file to name,
                # and a pre-check that walks the tree races with it. So this fails closed.
                if declared or store:
                    raise ProjectError(f"granted directory {flag[len('--dir='):]}: refused while the program takes secrets")
                check_directory(flag[len("--dir="):])
            elif flag == "--clock":
                # The wall clock and timers (`main(clock: Clock)`, `[clock] clock = true`).
                if flag in flags:
                    continue
            elif flag == "--no-links":
                # `[paths] links = false`: the engine opens every granted path without a link.
                if flag in flags:
                    continue
            elif flag.startswith("--net="):
                # Outbound connections are not a grant this launcher gives: nothing dials out.
                raise ProjectError("unsupported host grant --net: grimoire grants no outbound network access")
            elif flag.startswith("--input=") or flag == "--input-stdin":
                # The program's one input (`input_grant`): the flag, and for a file its identity.
                flags += input_grant(flag, document, bool(declared or store), any(f.startswith("--input") for f in flags))
                continue
            elif flag in sqlite_flags:
                pass  # Matched the full set of flags against the executable's document above.
            elif not flag.startswith("--file="):
                raise ProjectError(f"{document}: the document grants what this launcher does not (the engine's {flag.partition('=')[0]}): "
                                   "grimoire grants an allocator, output, an input, a clock, one loopback listener, one directory, one file to read, and secrets")
            else:
                check_granted_file(flag[len("--file="):], bool(declared or store), objects, chosen)
            flags.append(flag)
        # The words of this launch, each one engine argument, only where `main` takes them.
        flags += launch_words(words, next((f[len("--args="):] for f in flags if f.startswith("--args=")), None))
        if set(slots) != set(declared):
            missing = sorted(set(declared) - set(slots))[0]
            raise SecretError(missing, "declared, and wasm-grants proposes no slot for it")
        if stored != set(store):
            # A store table no `SecretStore` parameter takes (an over-grant): its values were read
            # for nothing, and nothing runs until the document says what the program takes.
            raise StoreSecretError(sorted(set(store) - stored)[0], "declared, and wasm-grants proposes no store's secret for it")
        # A granted directory is always opened without following a link, at its root and below.
        if any(f.startswith("--dir=") for f in flags) and "--no-links" not in flags:
            flags.append("--no-links")
        # Where the one directory is. Decision (review of 2026-11-22): a list of places a
        # directory must not be cannot be finished (`.git`, `~/.ssh`, a sibling project all
        # passed one), so the rule says where it may be, and anything else is the operator's
        # to name at each launch. The same for a directory only read: what it holds can leave
        # through any channel the program has.
        root = next((f[len("--dir="):] for f in flags if f.startswith("--dir=")), None)
        outside = None
        if root is not None or sqlite_flags:
            tools = {"the compiler": compiler, "the engine": host or shutil.which(os.environ.get("WITCHY_WASMTIME_HOST", "witchy-wasmtime-host")),
                     "Coven": shutil.which(os.environ.get("COVEN", "coven"))}
            protected, stores = protected_paths(manifest, own_entry, document, tools, project=project_data)
        if sqlite_flags:
            check_sqlite_files(sqlite_flags[0].partition("=")[2], manifest, protected, stores)
        if root is not None:
            writable = "write" in next((f.partition("=")[2] for f in flags if f.startswith("--dir-rights=")), "read")
            outside, examined = check_root_place(root, writable, manifest, protected, stores, allowed, not build_only)
            # What was examined is what is granted, and stays data: the engine refuses another
            # directory at that path, any hidden entry, and any name a build would read.
            flags += [f"--dir-id={examined[0]}:{examined[1]}", "--data-only"]
        # A single file is placed by the same rule (`check_file_place`), and a flag that names
        # no file the document grants outside the project grants nothing.
        outside_files = {}
        for flag in flags:
            if flag.startswith(("--file=", "--input=")):
                said = check_file_place(flag.partition("=")[2], "file" if flag.startswith("--file=") else "input", manifest, allowed_files, not build_only)
                if said is not None:
                    outside_files[flag.partition("=")[2]] = said
        for named in allowed_files:
            if named not in outside_files:
                raise ProjectError(f"--allow-read-file {named}: the grant document names no file outside the project at exactly this path; nothing is granted by the flag alone")
        for kind, roots in allowed.items():
            for named in roots:
                if named != root or outside is None or kind != ("write" if writable else "read"):
                    raise ProjectError(f"--allow-{kind}-root {named}: the grant document names no directory outside the project to {kind} at exactly this path; nothing is granted by the flag alone")
        # Output is passed on as it is written, a line at a time, still within its budget: a
        # service's log is seen while it serves, and a run a limit ends shows what it wrote.
        if "--output" in flags:
            flags.append("--stream-output")
            # And made safe to show: control and text-reordering characters written out, a line
            # that begins as this launcher's own do marked. Only the operator, on the command
            # line of this launch, asks for the program's bytes as they are (`--raw-output`):
            # never the manifest, which the program's author writes.
            if not raw_output:
                flags.append("--plain-output")
        flags += applicable_limits(limits, flags, run_table)
        flags += limit_names(flags, run_table)
        # When the run ends the engine says what it used of each limit, in one `limit: used:`
        # line, each count beside the `[run]` key that sets it: what budgets are sized from.
        flags.append("--usage")
        # Everything the executable is granted, a line each, before anything is built or run: on
        # standard error for a run or a build (standard output is the program's, or the module's
        # path), on standard output for a review.
        shown = describe_grants(flags, outside, outside_files) + describe_sizes(sizes, run_table, flags)
        if review is not None:
            # A review's are its standard output (what is read and accepted).
            for line in shown:
                print(line)
            return reviewed_grants(manifest, own_document, shown, manifest_bytes=manifest_bytes,
                                   grant_text=document_text if own_document is not None else None, lock_bytes=lock_bytes)
        # A run's are the launcher's own lines beside the program's output, and begin as all of
        # them do. A review is given no words after `--`: a quiet run compares the lines as a
        # review shows them, and the words are this launch's operator's own.
        reviewed = None
        if quiet:
            reviewed = describe_grants([f for f in flags if not f.startswith("--arg=")], outside, outside_files) + describe_sizes(sizes, run_table, flags)
        show_run_grants(shown, manifest, own_document, quiet, reviewed, manifest_bytes=manifest_bytes,
                        grant_text=document_text if own_document is not None else None, lock_bytes=lock_bytes)

        if build_only:
            module = output or manifest.parent / "target" / (entry.stem + ".wasm")
            if module.suffix != ".wasm":
                raise ProjectError("build output must have the .wasm extension")
            module.parent.mkdir(parents=True, exist_ok=True)
            build(module)
            print(module)
            return
        module = Path(temp) / "program.wasm"
        build(module)
        # The host checks the digest from the same descriptor and compiles its verified bytes.
        module_descriptor, wire = open_compiled_module(module, module_limit)
        held.append(module_descriptor)
        module_pin = "sha384:" + hashlib.sha384(wire).hexdigest()
        del wire
        if expected_module_pin is not None and module_pin != expected_module_pin:
            raise ProjectError(f"rebuilt Wasm does not match --module-pin (expected {expected_module_pin}, got {module_pin})")
        flags.append(f"--module-pin={module_pin}")
        if record is not None:
            # The selected sources, as the deployment chose them; never a value or a pipe.
            record = record.resolve()
            build_record = capture_build_record(manifest, entry, document_text, flags, module_pin, compiler, host,
                                                graph=graph, manifest_bytes=manifest_bytes, lock_bytes=lock_bytes)
        # The engine reads its module from the inherited descriptor, and the whole
        # temporary directory (the staged app and package sources, the kept snapshot, the module) is
        # removed when this block ends, before the engine starts: nothing the run staged is on disk
        # while it runs, so a launcher killed by SIGKILL (no handler, no cleanup) leaves nothing
        # behind. Fails closed: if the directory cannot be removed, nothing runs. (Not a watchdog
        # that removes it afterwards: a signal to the whole group kills the watchdog too.)
    try:
        # Each slot's flag names its own pipe; the engine reads the value from it and nothing else.
        # A slot read from a regular file also names that file's device and inode, never its
        # path or value: the engine checks every grant against it, at open and at each write.
        def engine_command(pipe):
            command = [host, f"--module-fd={module_descriptor}"]
            for flag in flags:
                if flag.startswith("--secret-slot="):
                    name, use, _ = flag[len("--secret-slot="):].split(":", 2)
                    command.append(f"--secret-slot={name}:{use}:fd:{pipe(('slot', name))}")
                    if name in originals:
                        command.append(f"--secret-object={name}:{originals[name][0]}:{originals[name][1]}")
                    continue
                if flag.startswith(("--secret=", "--secret-seal=")):
                    # The store's secret NAME from its own pipe: the engine never reads a variable.
                    command.append(f"{flag}@fd:{pipe(('store', flag.partition('=')[2]))}")
                    continue
                command.append(flag)
            return command
        deliver_secrets(engine_command, values, module_descriptor)
    finally:
        os.close(module_descriptor)
    if record is not None:
        publish_run_record(record, build_record)


# The native target: a manifest-bound executable for this machine (README, "A native executable").
def native_target():
    return {("darwin", "arm64"): "macos-arm64", ("linux", "aarch64"): "linux-arm64"}.get(
        (sys.platform, os.uname().machine))


NATIVE_FLAG = re.compile(r"[a-z][a-z0-9-]{0,31}")


def native_flags(document, grant):
    """The plan's declared arguments, {NAME: (type, secret)}, read only to assemble a launch:
    the compiler checks the plan, and the executable refuses anything it did not declare."""
    launch = grant.get("launch")
    if launch != {"version": 1}:
        raise ProjectError(f"{document}: [launch]: a native launch plan is `[launch] version = 1`")
    flags = grant.get("flags", {})
    if not isinstance(flags, dict):
        raise ProjectError(f"{document}: [flags] must be a table")
    declared = {}
    for name, entry in flags.items():
        kind = entry.get("type") if isinstance(entry, dict) else None
        if not NATIVE_FLAG.fullmatch(name) or kind not in ("path", "fd", "object"):
            raise ProjectError(f"{document}: [flags].{name}: a declared argument is `{{ type = \"path\" | \"fd\" | \"object\" }}`")
        declared[name] = (kind, entry.get("secret") is True)
    return declared


def native_secret_sources(manifest, document, grant, declared, *, project_data=None):
    """{FLAG: SOURCE}: where Grimoire reads each secret the plan takes on a declared descriptor,
    from the manifest's `[native] secrets = { FLAG = "env:NAME" | "fd:N" }`. Every secret
    descriptor is supplied this way, on a pipe of its own, and no other descriptor is: a plan
    whose secret the executable would read from its own environment or an inherited number, or
    whose other descriptors Grimoire would have to pass on, is refused."""
    if project_data is None:
        project_data = read_manifest(manifest)
    native = project_data.get("native", {})
    if not isinstance(native, dict) or not set(native) <= {"secrets"} or not isinstance(native.get("secrets", {}), dict):
        raise ProjectError(f"{manifest}: [native] is `secrets = {{ FLAG = \"env:NAME\" }}`")
    sources = native.get("secrets", {})
    for name, (kind, secret) in declared.items():
        if kind == "fd" and not secret:
            raise ProjectError(f"{document}: [flags].{name}: Grimoire passes a descriptor only for a secret")
        if kind == "fd" and name not in sources:
            raise ProjectError(f"{document}: [flags].{name}: a secret descriptor needs its source in the manifest's [native] secrets")
    for name, source in sources.items():
        if declared.get(name) != ("fd", True):
            raise ProjectError(f"{manifest}: [native] secrets.{name}: the plan declares no secret descriptor --{name}")
        if not isinstance(source, str) or not SECRET_SOURCE.fullmatch(source):
            raise ProjectError(f"{manifest}: [native] secrets.{name}: a source is \"env:NAME\" or \"fd:N\"")
        variable = source[4:] if source.startswith("env:") else None
        if variable is not None and (variable in LAUNCHER_ENVIRONMENT or variable.startswith("WITCHY_")):
            raise ProjectError(f"{manifest}: [native] secrets.{name}: {source} is a variable the toolchain is given")
    if len(set(sources.values())) != len(sources):
        raise ProjectError(f"{manifest}: [native] secrets: one source feeds one descriptor")
    # A secret's variable is never also ordinary environment (review of round 3): it would reach
    # the program as plain `Env`, and other processes of the user through `ps -E`.
    granted = {name for names_ in (grant.get("env") or {}).values() if isinstance(names_, list) for name in names_}
    for name, source in sources.items():
        if source.startswith("env:") and source[4:] in granted:
            raise ProjectError(f"{manifest}: [native] secrets.{name}: {source} is also granted through the plan's [env]")
    for slot, entry in (grant.get("secrets") or {}).items():
        origin = entry.get("from") if isinstance(entry, dict) else None
        if isinstance(entry, dict) and "use" in entry and not (isinstance(origin, dict) and origin.get("from") == "arg"):
            raise ProjectError(f"{document}: [secrets].{slot}: Grimoire delivers a native secret on a declared descriptor: "
                               'write `from = { from = "arg", name = FLAG }` with `[flags] FLAG = { type = "fd", secret = true }`')
    return sources


def native_secret_objects(document, grant, sources):
    """{FLAG: OBJECT_FLAG}: for each secret descriptor, the plan's declared `object` argument of its
    slot (`object = { from = "arg", name = OBJECT_FLAG }`, `type = "object"`), which Grimoire fills
    with the identity of the file an `fd:` source is (review of round 3: the runtime sees only the
    pipe, and would not know the key file a directory grant could reach)."""
    objects = {}
    for slot, entry in (grant.get("secrets") or {}).items():
        origin, obj = (entry.get("from"), entry.get("object")) if isinstance(entry, dict) else (None, None)
        if isinstance(origin, dict) and origin.get("from") == "arg" and origin.get("name") in sources:
            if isinstance(obj, dict) and obj.get("from") == "arg" and isinstance(obj.get("name"), str):
                objects[origin["name"]] = obj["name"]
    for flag, source in sources.items():
        if source.startswith("fd:") and flag not in objects:
            raise ProjectError(f"{document}: the secret on --{flag} is read from {source}: its slot needs "
                               '`object = { from = "arg", name = FLAG }` with `[flags] FLAG = { type = "object" }`, which Grimoire fills with that file\'s identity')
    return objects


def native_words(words, declared, reserved=()):
    """This launch's words, each `--NAME VALUE` or `--NAME=VALUE` for a declared path or object
    argument, at most once: nothing else reaches the executable from the command line."""
    given, at = [], 0
    seen = set()
    while at < len(words):
        word = words[at]
        name, equals, value = word[2:].partition("=") if word.startswith("--") else ("", "", "")
        if not equals:
            if at + 1 >= len(words):
                raise ProjectError(f"launch argument {shown_word(word)}: each is --NAME VALUE for an argument the plan declares")
            value = words[at + 1]
            at += 1
        at += 1
        if declared.get(name, ("fd",))[0] == "fd" or name in seen or name in reserved:
            raise ProjectError(f"launch argument {shown_word(word)}: not a path or object argument the plan declares, or given twice")
        seen.add(name)
        given += [f"--{name}", value]
    return given


def native_review(compiler, entry, document, sources, digest):
    """`witchyc native-plan`, as Grimoire's `grant:` and `limit:` lines, and each secret's source."""
    shown = subprocess.run([compiler, "native-plan", entry, document, f"--manifest-digest={digest}"],
                           env=toolchain_environment(), capture_output=True, text=True, encoding="utf-8")
    if shown.returncode:
        relay(shown.stderr)
        raise ProjectError(f"{document}: the compiler refuses the launch plan")
    lines = []
    for line in shown.stdout.splitlines():
        if line.startswith("limits: "):
            lines += [f"limit: {limit}" for limit in line[len("limits: "):].split(", ")]
        elif line:
            lines.append(f"grant: {line}")
    lines += [f"grant: secret descriptor --{name}: read by Grimoire from {source}, passed on a pipe of its own" for name, source in sorted(sources.items())]
    return lines


def native_source_path(source, manifest, given, declared, where):
    """The path a plan's path source names, as the executable will resolve it, or ("arg", FLAG)
    for a root the operator chooses at launch (none given: its declared default, if any).
    `given`: this launch's words, {FLAG: VALUE}."""
    def plain(base, path):
        # Exactly the path the executable will walk: no `.`, `..` or empty component, so the
        # spelling checked here is the one the kernel resolves (scan of b9e8f58).
        if not isinstance(path, str) or not path or path.startswith("//") or any(part in ("", ".", "..") for part in path.strip("/").split("/")) \
                or path != path.rstrip("/") and path != "/":
            raise ProjectError(f"{where}: {path!r}: a root's path has no `.`, `..` or empty component")
        joined = os.path.join(base, path) if base is not None else path
        if joined != os.path.normpath(joined):
            raise ProjectError(f"{where}: {path!r}: a root's path has no `.`, `..` or empty component")
        return joined
    if isinstance(source, str):
        return plain(None, source) if os.path.isabs(source) else None
    if not isinstance(source, dict):
        return None
    origin = source.get("from")
    if origin == "cwd":
        return plain(str(manifest.parent), source.get("path"))
    if origin == "home":
        import pwd
        return plain(pwd.getpwuid(os.getuid()).pw_dir, source.get("path"))
    if origin == "arg":
        return ("arg", source.get("name"))
    raise ProjectError(f"{where}: Grimoire launches a native plan whose roots are paths (a literal, cwd, home or a declared argument), not `{origin}`")


def native_identity_flags(grant, declared=None, secret_objects=(), where="the launch plan"):
    """The object arguments the plan's roots name as their `identity`: Grimoire's to fill. With
    `declared`, each is checked: a declared `type = "object"` argument that is no secret's,
    no root's path argument, no secret's object and no other root's identity (scan of a9010dc),
    since Grimoire passes it a DEVICE:INODE it examined and nothing else may read that value."""
    names, roots = [], set()
    for section in ("dirs", "files", "input"):
        for entry_ in (grant.get(section) or {}).values():
            if not isinstance(entry_, dict):
                continue
            for key in ("root", "path"):
                source = entry_.get(key)
                if isinstance(source, dict) and source.get("from") == "arg":
                    roots.add(source.get("name"))
            identity = entry_.get("identity")
            if isinstance(identity, dict):
                names.append(identity.get("name"))
    if declared is not None:
        for name in names:
            if not isinstance(name, str) or declared.get(name) != ("object", False) or name in roots \
                    or name in secret_objects or names.count(name) > 1:
                raise ProjectError(f"{where}: identity --{name}: a root's identity is its own declared argument of `type = \"object\"`, "
                                   "not a secret's, a root's path or another root's identity")
    return {name for name in names if isinstance(name, str)}


def native_placement(manifest, entry, document, grant, declared, given, allowed, allowed_files, launching, compiler):
    """The Wasm path's placement rule (`check_root_place`, `check_file_place`) for a native plan's
    directory and file roots: a literal, cwd or home root strictly inside the project, with no
    hidden component and not a build file, VCS or tool state, or named exactly by the operator at
    this launch (`--allow-read-root`, `--allow-write-root`, `--allow-read-file`), shown as OUTSIDE
    the project. A root the operator gives as a declared argument at launch is the operator's
    choice, shown as such. Returns the review's lines."""
    flags = {name: value for name, value in zip(given[::2], given[1::2])}
    flags = {name[2:]: value for name, value in flags.items()}
    tools = {"the compiler": compiler, "Coven": shutil.which(os.environ.get("COVEN", "coven"))}
    protected = None
    lines, used_roots, used_files, bound = [], set(), set(), []
    def opened_identity(path, where):
        """(device, inode) of `path` as opened without following its last component."""
        try:
            fd = os.open(path if os.path.isabs(path) else os.path.join(manifest.parent, path),
                         os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0))
        except OSError:
            raise ProjectError(f"{where}: {path}: cannot be opened without following a link") from None
        try:
            status = os.fstat(fd)
        finally:
            os.close(fd)
        return status.st_dev, status.st_ino

    def same_throughout(where, *identities):
        # What was bound is what every check examined: taken from the opened object before the
        # checks, again after them, and as the checks saw it (review of round 4).
        if len(set(identities)) != 1:
            raise ProjectError(f"{where}: the root changed while it was being checked; refused")
        return identities[0]

    def bind(entry_, path, where, placed, examined_id=None):
        """The root Grimoire checked, bound by identity: the executable refuses any other object
        at that name (scan of b9e8f58). A root Grimoire places must be bindable."""
        identity = entry_.get("identity") if isinstance(entry_, dict) else None
        flag = identity.get("name") if isinstance(identity, dict) and identity.get("from") == "arg" else None
        if flag is None:
            if placed:
                raise ProjectError(f'{where}: Grimoire binds each root it places to what it checked: state `identity = {{ from = "arg", name = ID }}` '
                                   'with `[flags] ID = { type = "object" }`')
            return
        device, inode = examined_id if examined_id is not None else opened_identity(path, where)
        bound.extend([f"--{flag}", f"{device}:{inode}"])
    def resolved(source, where):
        path = native_source_path(source, manifest, flags, declared, where)
        if isinstance(path, tuple):
            name = path[1]
            if name in flags:
                return ("operator", flags[name]), f"chosen by the operator at this launch (--{name} {flags[name]}), not placed by the project's rule"
            default = ((grant.get("flags") or {}).get(name) or {}).get("default")
            if default is None:
                return None, f"chosen by the operator at each launch (--{name}), not placed by the project's rule"
            path = native_source_path(default, manifest, flags, declared, where)
            if path is None or isinstance(path, tuple):
                return None, f"chosen by the operator at each launch (--{name})"
        if path is None:
            raise ProjectError(f"{where}: a root is an absolute path or a source")
        return path, None
    for name, entry_ in (grant.get("dirs") or {}).items():
        where = f"{document}: [dirs].{name}"
        if not isinstance(entry_, dict):
            raise ProjectError(f'{where}: a directory is `{{ root = SOURCE, rights = [...] }}`')
        rights = directory_rights(where, entry_.get("rights"))
        if rights is None:
            raise ProjectError(f'{where}: state its rights (["Read"], ["Write"] or ["Read", "Write"]), so it is placed as what it grants')
        writable = "write" in rights
        path, chosen = resolved(entry_.get("root"), where)
        if isinstance(path, tuple):
            bind(entry_, path[1], where, False)
            path = None
        if path is None:
            lines.append(f"grant: placement: {name}: {chosen}")
            continue
        walked = check_directory(path)
        if protected is None:
            protected = protected_paths(manifest, entry, document, tools)
        said, examined = check_root_place(path, writable, manifest, *protected, allowed, launching)
        again = check_directory(path)
        bind(entry_, path, where, True, same_throughout(where, (walked.st_dev, walked.st_ino), examined, (again.st_dev, again.st_ino)))
        if said is not None:
            used_roots.add(("write" if writable else "read", path))
        lines.append(f"grant: placement: {name}: {path}, {said or 'inside the project'}")
    for section in ("files", "input"):
        for name, entry_ in (grant.get(section) or {}).items():
            if isinstance(entry_, dict) and entry_.get("stdin") is True:
                continue
            source = entry_.get("path") if isinstance(entry_, dict) and "path" in entry_ and "from" not in entry_ else entry_
            where = f"{document}: [{section}].{name}"
            if isinstance(entry_, dict) and entry_.get("mode") is not None:
                raise ProjectError(f"{where}: Grimoire grants no file to write (a written file is made under a writable directory)")
            path, chosen = resolved(source, where)
            holder = entry_ if isinstance(entry_, dict) and "path" in entry_ and "from" not in entry_ else {}
            if isinstance(path, tuple):
                bind(holder, path[1], where, False)
                path = None
            if path is None:
                lines.append(f"grant: placement: {name}: {chosen}")
                continue
            before = opened_identity(path, where)
            said = check_file_place(path, "file" if section == "files" else "input", manifest, allowed_files, launching)
            bind(holder, path, where, True, same_throughout(where, before, opened_identity(path, where)))
            if said is not None:
                used_files.add(path)
            lines.append(f"grant: placement: {name}: {path}, {said or 'inside the project'}")
    # An operator's word that names nothing the plan places outside grants nothing.
    for kind, roots in (allowed or {}).items():
        for named in roots:
            if (kind, named) not in used_roots:
                raise ProjectError(f"--allow-{kind}-root {named}: the launch plan names no directory outside the project to {kind} at exactly this path; nothing is granted by the flag alone")
    for named in allowed_files or ():
        if named not in used_files:
            raise ProjectError(f"--allow-read-file {named}: the launch plan names no file outside the project at exactly this path; nothing is granted by the flag alone")
    return lines, bound


def run_native(manifest, entry, document, grant, launch, build_only, output, review, names, raw_output, words, allowed=None, allowed_files=(), quiet=False,
               *, document_text, lock_bytes=READ_LOCK_FROM_DISK, project_data=None, manifest_bytes=None):
    target = native_target()
    if target is None:
        raise ProjectError(f"{document}: native launch plans require macOS ARM64 or Linux ARM64")
    # Grimoire's own rule holds for every target: it grants no outbound network and runs no program.
    for section, what in (("net", "no outbound network access"), ("exec", "no program to run")):
        if section in grant:
            raise ProjectError(f"{document}: [{section}]: grimoire grants {what}")
    declared = native_flags(document, grant)
    sources = native_secret_sources(manifest, document, grant, declared, project_data=project_data)
    objects = native_secret_objects(document, grant, sources)
    given = [] if review is not None else native_words(words, declared, reserved=set(objects.values()) | native_identity_flags(grant, declared, set(objects.values()), document))
    # Where each root is, by the Wasm path's rule, before anything is read or built; each root
    # placed is bound to what was examined (`identity`).
    placement, bound = native_placement(manifest, entry, document, grant, declared, given, allowed or {}, allowed_files or (),
                                        not build_only and review is None, tool("WITCHYC", "witchyc"))
    given += bound
    values = {}
    if not build_only and review is None:
        chosen = {name: source for name, source in sources.items()}
        source_objects(chosen)
        files = source_files(chosen)
        for flag, (device, inode) in files.items():
            given += [f"--{objects[flag]}", f"{device}:{inode}"]
        values = resolve_secrets({name: ("", source, []) for name, source in chosen.items()}, chosen, launch)
    compiler = tool("WITCHYC", "witchyc")
    digest = hashlib.sha256(document_text.encode("utf-8")).hexdigest()
    lock_bytes = read_lock_bytes(manifest.parent / LOCK, lock_bytes)
    check_toolchain(manifest, lock_bytes=lock_bytes)
    with tempfile.TemporaryDirectory(prefix="grimoire-") as temp:
        names = [] if names is None else names
        staged, _ = (review, None) if review is not None else stage_registry_packages(
            manifest, entry, temp, names=names, project=project_data, lock_bytes=lock_bytes)
        shown = native_review(compiler, staged, document, sources, digest) + placement
        if review is not None:
            for line in shown:
                print(line)
            return reviewed_grants(manifest, document, shown, manifest_bytes=manifest_bytes,
                                   grant_text=document_text, lock_bytes=lock_bytes)
        show_run_grants(shown, manifest, document, quiet, manifest_bytes=manifest_bytes,
                        grant_text=document_text, lock_bytes=lock_bytes)
        binary = output if build_only and output else (manifest.parent / "target" / entry.stem if build_only else Path(temp) / entry.stem)
        if binary.suffix in (".wasm", ".coven"):
            raise ProjectError("a native build's output is an executable, without the .wasm or .coven extension")
        binary.parent.mkdir(parents=True, exist_ok=True)
        build_native(compiler, staged, binary, document, toolchain_environment(), target=target,
                     digest=digest, rewrite=author_names(names))
        if build_only:
            print(binary)
            return
        inputs = grant.get("input") if isinstance(grant.get("input"), dict) else {}
        stdin = any(isinstance(entry, dict) and entry.get("stdin") is True for entry in inputs.values())
        # Only the variables the plan's `[env]` grants, from the launch environment as given.
        granted = [name for names_ in (grant.get("env") or {}).values() if isinstance(names_, list) for name in names_ if isinstance(name, str)]
        environment = {}
        for name in granted:
            value = launch.get(name, os.environb.get(name.encode()))
            if value is not None:
                environment[name.encode()] = value if isinstance(value, bytes) else value.encode()
        launch_native(binary, given, values, stdin, manifest.parent, environment, raw_output)


def build_native(path, entry, output, manifest, env, *, target, digest, rewrite=None):
    """Build a native executable bound to the launch manifest read by Grimoire.
    The resident compiler also checks its input key before publishing the executable."""
    client = compiler_client()
    entry, output, manifest = (Path(os.path.abspath(p)) for p in (entry, output, manifest))
    cmd = [path, "build", entry, "-o", output, f"--target={target}", f"--manifest={manifest}"]
    compiler = client.selected(path, env)
    if compiler is None:
        return client._rewritten([*cmd, f"--manifest-digest={digest}"], env, rewrite, False, True)
    code, key, err, _ = compiler.request(["input-key", str(entry)])
    if code == 0 and output.exists() and output.samefile(entry):
        raise ProjectError("source and executable output must be different files")
    if code == 0:
        with tempfile.TemporaryDirectory(prefix=".witchy-build-", dir=output.parent) as directory:
            stage = Path(directory) / "program"
            code, _, err, _ = compiler.request(["build-native", str(entry), str(stage), str(manifest), key.strip(), digest])
            if code == 0:
                os.replace(stage, output)
    # The reply's standard output is the build's timing record, not a message for the operator.
    return client._result(cmd, (code, "", err, ""), False, True, rewrite)


# The watchdog for a native executable: its whole group, asked to stop (a broker stops a program
# it runs), then killed.
NATIVE_WATCHDOG = """import os, signal, sys, time
for number in (signal.SIGINT, signal.SIGHUP, signal.SIGTERM, signal.SIGQUIT):
    signal.signal(number, signal.SIG_IGN)
while os.read(0, 64):
    pass
for number, pause in ((signal.SIGTERM, 1.0), (signal.SIGKILL, 0)):
    try:
        os.killpg(int(sys.argv[1]), number)
    except OSError:
        break
    time.sleep(pause)
"""


def stop_native_group(process):
    """The executable's group (its session's), asked to stop, given a second to (a broker stops a
    program it runs), then killed; only then is the leader reaped. Its pid is the group's number
    and stays ours until it is reaped, so nothing is signalled by a reused number."""
    def ended():
        try:
            seen = os.waitid(os.P_PID, process.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT)
        except ChildProcessError:
            return True
        return seen is not None
    with contextlib.suppress(OSError):
        os.killpg(process.pid, signal.SIGTERM)
    deadline = time.monotonic() + 1.0
    while time.monotonic() < deadline and not ended():
        time.sleep(0.02)
    # A server's worker or broker may outlive the leader: a moment for it, then the group goes.
    time.sleep(0.05)
    with contextlib.suppress(OSError):
        os.killpg(process.pid, signal.SIGKILL)
    process.wait()


def launch_native(binary, given, values, stdin, cwd, environment, raw_output):
    """The executable, started directly: the declared words, each secret on a fresh pipe named
    by its declared argument (`--FLAG N`), only the variables the plan's `[env]` grants, standard
    input only when the plan grants it, no other descriptor, in the project's directory. Its
    output is made plain and a line that begins as the launcher's or the runtime's is marked
    `| `, unless the operator asked for it raw."""
    pipes = {name: os.pipe() for name in values}
    arguments = [str(binary), *given]
    for name, (reading, _) in pipes.items():
        arguments += [f"--{name}", str(reading)]
    streams = {"stdout": SHOWN[0] if raw_output else subprocess.PIPE, "stderr": SHOWN[1]} if SHOWN is not None else \
              {"stdout": None if raw_output else subprocess.PIPE}
    try:
        # In a session of its own: a socket server's workers and brokers are its group, and are
        # stopped with it (review of round 3).
        process = subprocess.Popen(arguments, env=environment, cwd=cwd, stdin=None if stdin else subprocess.DEVNULL,
                                   close_fds=True, start_new_session=True, pass_fds=tuple(reading for reading, _ in pipes.values()), **streams)
    finally:
        for reading, _ in pipes.values():
            os.close(reading)
    def write(name):
        writing = pipes[name][1]
        try:
            view = memoryview(values[name])
            while view:
                view = view[os.write(writing, view):]
        except OSError:
            pass
        finally:
            os.close(writing)
    writers = [threading.Thread(target=write, args=(name,), daemon=True) for name in values]
    for writer in writers:
        writer.start()
    shown = None
    if not raw_output:
        target = SHOWN[0] if SHOWN is not None else 1
        def show():
            import codecs
            decoder = codecs.getincrementaldecoder("utf-8")(errors="surrogateescape")
            # The start of each line is held until it is a whole line or longer than either
            # marked beginning, so a line written in pieces is judged whole (review of round 3).
            pending = ""
            def emit(text):
                encoded = text.encode("utf-8")
                with contextlib.suppress(OSError):
                    while encoded:
                        encoded = encoded[os.write(target, encoded):]
            def judged(line):
                return ("| " if line.startswith((SAID, "witchy: ")) else "") + plain_text(line)
            longest = max(len(SAID), len("witchy: "))
            for data in iter(lambda: process.stdout.read1(65536), b""):
                pending += decoder.decode(data)
                out = []
                while "\n" in pending:
                    line, pending = pending.split("\n", 1)
                    out.append(judged(line) + "\n")
                if len(pending) >= longest:
                    # Decided: the rest of this line passes as it comes, marked if it began so.
                    out.append(judged(pending))
                    pending = None
                emit("".join(out))
                if pending is None:
                    # Until the next newline, nothing more is judged.
                    rest = ""
                    for more in iter(lambda: process.stdout.read1(65536), b""):
                        text = decoder.decode(more)
                        if "\n" in text:
                            head, rest = text.split("\n", 1)
                            emit(plain_text(head) + "\n")
                            break
                        emit(plain_text(text))
                    pending = rest
                    while "\n" in pending:
                        line, pending = pending.split("\n", 1)
                        emit(judged(line) + "\n")
            if pending:
                emit(judged(pending + decoder.decode(b"", final=True)))
        shown = threading.Thread(target=show, daemon=True)
        shown.start()
    def stop(number, frame):
        raise KeyboardInterrupt
    caught = (signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)
    previous = {number: signal.signal(number, stop) for number in caught}
    # A launcher killed by SIGKILL takes the executable with it (the watchdog, as for the engine).
    lifeline, held = os.pipe()
    try:
        watchdog = subprocess.Popen([sys.executable, "-I", "-S", "-c", NATIVE_WATCHDOG, str(process.pid)], env={},
                                    stdin=lifeline, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except BaseException:
        stop_native_group(process)
        os.close(held)
        raise
    finally:
        os.close(lifeline)
    try:
        # Seen ended but not reaped, so its pid (the group's number) is still ours: whatever of
        # its group is left (a worker of a server that ended) goes too, then it is reaped.
        os.waitid(os.P_PID, process.pid, os.WEXITED | os.WNOWAIT)
        stop_native_group(process)
        code = process.returncode
    except KeyboardInterrupt:
        stop_native_group(process)
        code = 130
    finally:
        watchdog.kill()
        watchdog.wait()
        os.close(held)
        for number, handler in previous.items():
            signal.signal(number, handler)
    for writer in writers:
        writer.join()
    if shown is not None:
        shown.join()
        process.stdout.close()
    if code:
        raise subprocess.CalledProcessError(code, binary.name)


def trust_project(project, forget=None, forget_operator=False, forget_unkeyed_floor=False, reestablish_operator=None, reinstate_signer=None):
    """Show what this machine's trust store holds for the project's registry, or forget one
    package's owners (and its conflict) so that its next resolve anchors afresh on a lock or a
    declaration. Its floor and known revocations are kept: they only ever refuse.

    Each call does one of: re-establish and/or reinstate an operator key, drop the unkeyed floor,
    forget the operator, forget a package. Two of them in one call are refused before anything is
    read or written (each returned after its own change, so a second was silently not done)."""
    acts = [name for name, given in (("--reestablish-operator/--reinstate-signer", reestablish_operator is not None or reinstate_signer is not None),
                                     ("--forget-unkeyed-floor", forget_unkeyed_floor), ("--forget-operator", forget_operator),
                                     ("--forget", forget is not None)) if given]
    if len(acts) > 1:
        raise ProjectError(f"trust: {' and '.join(acts)} are separate acts, one per call; nothing changed")
    manifest = (project / "witchy.toml" if project.is_dir() else project).resolve()
    registry, _ = read_dependencies(manifest)
    if registry is None:
        raise ProjectError(f"{manifest} has no registry dependencies")
    if isinstance(registry, TufRegistry):
        raise ProjectError("grimoire trust manages legacy registry keys; TUF uses provisioned trust and Coven's rollback state")
    store = TrustStore(registry)
    try:
        if reestablish_operator is not None or reinstate_signer is not None:
            held = store.operator
            if reestablish_operator is not None:
                # The user's own act, after checking the key with the registry's operator out of
                # band: a project's pin never re-establishes a key for the machine. It lifts only
                # `unestablished` (a chain may hold the key without a pin): never the signing
                # refusal (`handed_on`), since "was A ours?" is truthfully yes for a key stolen
                # after it handed the role on, nor the key's hand-over constraint.
                if held is None or reestablish_operator not in held["unestablished"]:
                    raise ProjectError("this machine's trust store holds no unestablished operator key by that ID for this registry")
                held = store.operator = dict(held, unestablished=[key for key in held["unestablished"] if key != reestablish_operator])
            if reinstate_signer is not None:
                # A separate act (decision, by the coordinator): the user checked with the registry's
                # operator that KEY is still its current signing key. Only a key already established
                # (or re-established in this same call) is reinstated: fail closed. It lifts only
                # `handed_on`; the key's hand-over constraint stays.
                if held is None or reinstate_signer not in held["handed_on"]:
                    raise ProjectError("this machine's trust store holds no operator key by that ID refused for signing for this registry")
                if reinstate_signer in held["unestablished"]:
                    raise ProjectError("that operator key is unestablished on this machine: re-establish it first "
                                       "(`grimoire trust --reestablish-operator KEY --reinstate-signer KEY`, after checking KEY with the registry's operator out of band)")
                held = store.operator = dict(held, handed_on=[key for key in held["handed_on"] if key != reinstate_signer])
            store.save()
            if reestablish_operator is not None:
                print(f"re-established {reestablish_operator} on this machine: a chain may hold it without a project pinning it"
                      + (" (it still signs nothing until `grimoire trust --reinstate-signer KEY`)" if reestablish_operator in held["handed_on"] else ""))
            if reinstate_signer is not None:
                print(f"reinstated {reinstate_signer} as a signer on this machine: it may sign the registry's snapshots again")
            return
        if forget_unkeyed_floor:
            if store.operator is None or not store.operator["unkeyed"]:
                raise ProjectError("this machine's trust store holds no unkeyed snapshot floor for this registry")
            floor = store.operator["unkeyed"]
            store.operator = dict(store.operator, unkeyed=0)
            store.save()
            print(f"dropped the unkeyed snapshot floor (snapshot {floor}); kept each operator key's floor and the retired keys")
            return
        if forget_operator:
            if store.operator is None or not store.operator["keys"]:
                raise ProjectError("this machine's trust store holds no operator for this registry")
            # Which keys are anchored is forgotten, not their floors: each binds only a chain holding
            # its key, so a floor under a key nobody uses is harmless, and an honest key's floor
            # still refuses an older snapshot of it.
            # The keys before the forgotten record's first key retire with an unknown successor, so
            # they hand the role to no one: their links fixed none (a cloned project's anchor vouched
            # for them), and dropped, a stolen one handed the role on again (review of 5f467cd).
            # `unestablished` keys stay so (review of 0620e18: retired, they were named and said
            # to have handed the role on).
            # A forget may only add constraints (review of a7a0169): an unestablished key before the
            # record retires too, but is not named.
            # So does every key of the record that handed the role on with no retirement recorded:
            # an unestablished key's hand-over fixes no successor, and with the record gone nothing
            # else held it back, so a thief's chain from it passed after the forget the fork
            # refusal advises (review of a7a0169).
            moved = [key for key in [*store.operator["before"], *store.operator["keys"][:-1]] if key not in store.operator["retired"]]
            moved = list(dict.fromkeys(moved))
            retired = {**store.operator["retired"], **{key: None for key in moved}}
            store.operator = dict(store.operator, keys=[], before={}, retired=retired, provisional=True, source="first-use", registry=None)
            store.save()
            named = [key for key in moved if key not in store.operator["unestablished"]]
            unnamed = len(moved) - len(named)
            print("forgot the registry's operator; kept each operator key's snapshot floor and the retired keys"
                  + (f"; {' '.join(named)}, which handed the role on with no successor recorded, now hand the role to no one" if named else "")
                  + (f"; {unnamed} key(s) a record without provenance named, which handed the role on with no successor recorded, now hand the role to no one" if unnamed else ""))
            return
        if forget is not None:
            held = store.packages.get(forget)
            if held is None:
                raise ProjectError(f"this machine's trust store holds no owners for {forget}")
            store.packages[forget] = {"owners": [], "recovery": held["recovery"], "index": held["index"], "retired": held["retired"], "provisional": True}
            store.save()
            print(f"forgot the owners of {forget}; kept its floor (index {held['index']}), its retired keys and known revocations")
            return
        print(f"{store.path} ({store.registry})")
        if store.operator is not None:
            held = store.operator
            state = " (first use)" if held["source"] == "first-use" and held["keys"] else ""
            retired = ", retired " + " ".join(f"{key} (to {to or 'an unrecorded successor'})" for key, to in held["retired"].items()) if held["retired"] else ""
            floor = max((held["floors"].get(key, 0) for key in held["keys"]), default=0)
            retired += ", before the record " + " ".join(f"{key} (hands the role only to {' or '.join(was)})" for key, was in held["before"].items()) if held["before"] else ""
            retired += "".join(f", {key} may hand the role only to {' or '.join(to) or 'no one'}" for key, to in held["handover"].items())
            retired += (", " + " ".join(held["handed_on"]) + " sign nothing (handed the role on in a record set aside on upgrade: "
                        "until `grimoire trust --reinstate-signer KEY`)" if held["handed_on"] else "")
            retired += (", unestablished " + " ".join(held["unestablished"]) + " (named by a record set aside on upgrade: accepted only where a project pins one)"
                        if held["unestablished"] else "")
            kept = "".join(f", floor {key} {held['floors'][key]}" for key in sorted(held["floors"]) if key not in held["keys"])
            kept += f", unkeyed floor {held['unkeyed']}" if held["unkeyed"] else ""
            print(f"operator: {' -> '.join(held['keys']) or '(forgotten)'}{state}, registry {held['registry']}, snapshot {floor}{retired}{kept}")
        for name, held in sorted(store.packages.items()):
            state = " (first use)" if held["provisional"] and held["owners"] else ""
            retired = f", retired {' '.join(held['retired'])}" if held["retired"] else ""
            print(f"{name}: owners {' -> '.join(held['owners']) or '(forgotten)'}{state}, recovery {held['recovery']}, index {held['index']}{retired}")
        for coordinate, reason in sorted(store.revoked.items()):
            print(f"revoked {coordinate}: {reason}")
    finally:
        store.close()


def main():
    # First: nothing of the launch environment beyond the launcher allowlist stays in this
    # process, where a step it starts could read it (/proc/PID/environ, `ps -E`).
    try:
        if sys.argv[1:2] == ["test"] and "--projects" not in sys.argv[2:]:
            try:
                return cli_main(sys.argv[1:], None)
            except (OSError, ValueError) as error:
                say(f"test: {error}")
                return 2
        launch = take_launch_environment()
    except ProjectError as error:
        say(f"{error}")
        return 1
    return cli_main(sys.argv[1:], launch)


def build_project(project, output, *, catalog_snapshot=None):
    manifest = (project / "witchy.toml" if project.is_dir() else project).resolve()
    manifest_bytes = read_control_file(manifest)
    project_data = tomllib.loads(manifest_bytes.decode("utf-8"))
    if "run" in project_data or "package" not in project_data:
        return run_project(manifest, build_only=True, output=output, catalog_snapshot=catalog_snapshot,
                           manifest_bytes=manifest_bytes)
    if catalog_snapshot is not None:
        raise ProjectError("a catalog build requires an executable project")
    # A library ships its signed source payload. Compile an import of those exact bytes
    # under its declared package edges, without granting or running any executable.
    lock_bytes = read_lock_bytes(manifest.parent / LOCK)
    check_toolchain(manifest, lock_bytes=lock_bytes)
    codec = release_format()
    packed = subprocess.run([tool("COVEN", "coven"), "pack", manifest, "--manifest-pin", codec.digest_of(manifest_bytes)],
                            env=toolchain_environment(), stdout=subprocess.PIPE, check=True).stdout
    try:
        release = codec.parse_payload(packed)
    except codec.ReleaseError as error:
        raise ProjectError(f"invalid canonical release payload: {error}") from None
    name, version = release.name, release.version
    declared = project_data["package"]
    if not isinstance(declared, dict) or (name, version) != (declared.get("name"), declared.get("version")):
        raise ProjectError("packed release differs from the captured package coordinate")
    registry, dependencies = read_dependencies(manifest, project=project_data)
    if release.requires != dependencies:
        raise ProjectError("package dependencies changed during build")
    with tempfile.TemporaryDirectory(prefix="grimoire-library-") as directory:
        root = Path(directory).resolve()
        graph = read_lock(manifest, dependencies, registry, directory, lock_bytes=lock_bytes) if dependencies else {}
        if name in graph:
            raise ProjectError("library occurs in its own dependency graph")
        local = root / "package"
        local.mkdir()
        # The release's bytes are compiled from a copy: what is said of it names the author's file.
        authored = project_path(manifest.parent, project_data["package"].get("source"), "package.source")
        staged = Staged(name, version, release, local)
        source = staged.entry
        if release.format == 1:
            names = [(source, shown_path(authored))]
        else:
            names = [(f"{staged.root}/", "" if shown_path(authored.parent) == "." else f"{shown_path(authored.parent)}/")]
        listing = package_listing(graph)
        listing.append(f"{name} {version}: {source} ; requires {' '.join(sorted(dependencies))}".rstrip())
        entry = root / "main.wy"
        entry.write_text(f'import "@{name}"\nfn main():\n    return\n')
        entry.with_suffix(".packages").write_text("\n".join(listing) + "\n")
        names.append((entry, f"<the check that imports @{name}>"))
        names.extend(staged_names(graph))
        compiler_client().run([tool("WITCHYC", "witchyc"), "wasm-check-package", entry],
                              env=toolchain_environment(), check=True, rewrite=author_names(names))
    result = output or manifest.parent / "target" / f"{name}-{version}.coven"
    if result.suffix != ".coven":
        raise ProjectError("library build output must have the .coven extension")
    result.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".grimoire-", dir=result.parent) as directory:
        staged = Path(directory) / "payload"
        staged.write_bytes(packed)
        os.replace(staged, result)
    print(result)


def publisher_key(path):
    """Generate a publisher's local seed and public key, without replacing either file."""
    path = path.absolute()
    public = Path(str(path) + ".pub")
    if os.path.lexists(path) or os.path.lexists(public):
        raise ProjectError("publisher key or public key already exists")
    with tempfile.TemporaryDirectory(prefix=".grimoire-key-", dir=path.parent) as directory:
        seed = Path(directory) / "key"
        fd = os.open(seed, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as stream:
            stream.write(os.urandom(32))
        with still_working("deriving the ML-DSA-65 key pair with Coven"):
            result = run_coven([tool("COVEN", "coven"), "key", "--key", seed])
        if result.returncode:
            raise ProjectError(f"publisher key derivation failed: {result.stderr.strip()}")
        os.link(seed, path)
        try:
            os.link(seed.with_suffix(".pub"), public)
        except OSError:
            if path.samefile(seed):
                path.unlink()
            raise
    sys.stdout.write(result.stdout)


def publish_project(project, key, recovery):
    manifest = (project / "witchy.toml" if project.is_dir() else project).resolve()
    manifest_bytes = read_control_file(manifest)
    registry = tomllib.loads(manifest_bytes.decode("utf-8")).get("registry")
    if not isinstance(registry, dict) or "url" not in registry or "path" in registry:
        raise ProjectError("publish requires [registry] url, operator and id")
    url = registry_url(registry["url"])
    operator = registry.get("operator")
    if not isinstance(operator, str):
        raise ProjectError("publish requires a pinned registry operator")
    operator_pin(operator, "[registry] operator")
    identity = registry.get("id")
    if not isinstance(identity, str) or not REGISTRY_ID.fullmatch(identity):
        raise ProjectError("publish requires a registry id")
    command = [tool("COVEN", "coven"), "publish", manifest, "--manifest-pin", release_format().digest_of(manifest_bytes),
               "--registry", url, "--operator", operator, "--registry-id", identity, "--key", key]
    if recovery:
        command.extend(["--recovery-key", recovery])
    with still_working("signing and publishing with Coven"):
        subprocess.run(command, env=toolchain_environment(), check=True)


def test_project(project, *, project_data=None):
    if project_data is None:
        manifest = (project / "witchy.toml" if project.is_dir() else project).resolve()
        project_data = read_manifest(manifest)
    else:
        manifest = project
    cases = project_data.get("test")
    if not isinstance(cases, list) or not cases:
        raise ProjectError("declare [[test]] with a name, project and exact stdout in witchy.toml")
    seen = set()
    for case in cases:
        given = case.get("args", []) if isinstance(case, dict) else []
        if (not isinstance(case, dict) or case.keys() - {"stdin", "args"} != {"name", "project", "stdout"} or not all(isinstance(v, str) for k, v in case.items() if k != "args")
                or not isinstance(given, list) or not all(isinstance(word, str) for word in given)):
            raise ProjectError("each [[test]] needs string name, project and stdout, and may give a string stdin and a list of strings args")
        name = case["name"]
        if not name or name in seen:
            raise ProjectError("each test needs a distinct name")
        seen.add(name)
        target = project_path(manifest.parent, case["project"], "test.project")
        if not target.resolve().is_relative_to(manifest.parent):
            raise ProjectError("test.project must be within this project")
        # The comparison is of the program's bytes, as it wrote them.
        # Its standard input is the case's `stdin`, or empty: a test never reads the terminal.
        # Its arguments are the case's `args`, given as an operator gives them: after `--`.
        result = subprocess.run([sys.executable, Path(__file__).resolve(), "run", "--raw-output", target, *(["--", *given] if given else [])], stdout=subprocess.PIPE,
                                input=case.get("stdin", "").encode("utf-8"), env=toolchain_environment(keep_ca=True))
        if result.returncode or result.stdout != case["stdout"].encode("utf-8"):
            raise ProjectError(f"test {name} failed (exit {result.returncode}, exact stdout matched: {result.stdout == case['stdout'].encode()})")
        print(f"ok {name}")


def service_files(name):
    """`grimoire new NAME --service`: a program run once for each connection, its state in a
    granted directory, its answer a pure function a native test checks."""
    body = f"hello from {name}\n"
    return {
        "witchy.toml": '[run]\nentry = "main.wy"\n'
                       "# Limits, never authority; each is shown as a `limit:` line before the run.\n"
                       "# A service runs until it is stopped (Ctrl-C, SIGTERM) or its launcher ends.\n"
                       'deadline-ms = "none"\n'
                       "# Each connection's own: reaching one closes that connection, and the service goes on.\n"
                       "fuel-per-connection = 1000000\n"
                       "connection-deadline-ms = 10000\n"
                       "# The byte budgets are the whole run's unless a connection is given its own:\n"
                       "# net-bytes-per-connection = 65536\n"
                       "# file-bytes-per-connection = 65536\n"
                       "# file-entries-per-connection = 16\n"
                       "# output-bytes-per-connection = 4096\n"
                       "# and beside a connection's own, the run's may be \"unlimited\":\n"
                       '# net-bytes = "unlimited"\n'
                       '# file-bytes = "unlimited"\n'
                       "# How many connections' instances run at once (default 1):\n"
                       "# connections-in-parallel = 1\n\n"
                       '[grants]\ndocument = "main.grants.toml"\nallocator = true\n'
                       "# output = true   # with console: Console<Write> in main, for a log on standard output\n",
        "main.grants.toml": "# Everything a run may reach, bound to main's parameters by name.\n"
                            "[listen]\n"
                            "# main(connection: Socket): the engine accepts on this address and runs main once for each connection.\n"
                            'connection = "127.0.0.1:8080"\n'
                            "[dirs]\n"
                            "# main(data: Dir): what outlives a connection. Nothing is kept in memory between them.\n"
                            'data = { root = "data", rights = ["Read", "Write"] }\n',
        "main.policy": SERVICE_POLICY,
        "main.wy": f"// {name}: a service. main takes a Socket, so the engine accepts each connection on the\n"
                   "// granted address and runs main once for it, in a new instance: memory, heap and handles\n"
                   "// are new each time. A connection that traps, or runs out of its instructions or its time,\n"
                   "// ends alone, and the service goes on. State that outlives a connection is kept in `data`.\n"
                   "//\n"
                   "// The other shape is a Listener loop: main(listener: Listener) accepts in a loop of its own,\n"
                   "// in one instance, and may keep state in memory across requests. Choose it only for that.\n"
                   "// Its cost: a trap, a request that spins, or a slow client takes the whole service down,\n"
                   "// since one instance stopped part-way is never run again. Here each connection is isolated,\n"
                   "// and state is only what the granted directory holds.\n"
                   "import fs\nimport net\nimport span\nimport vec\nimport \"reply.wy\"\n\n"
                   "fn main(connection: Socket, data: Dir, allocator: Allocator):\n"
                   "    let zero: U8 = 0\n"
                   "    let Ok(room): Vec<U8> = Vec.filled(&allocator, 1024, zero) else Err(_):\n"
                   "        connection.close()\n"
                   "        return\n"
                   "    var request = move room\n"
                   "    let Ok(got): U64 = connection.read_some(request.as_mut_slice()) else Err(_):\n"
                   "        request.close()\n"
                   "        connection.close()\n"
                   "        return\n"
                   "    let status = reply.status(Span.of(request.as_slice().part(0, got)))\n"
                   "    request.close()\n"
                   "    // What outlives this connection goes to the granted directory: a line for each request.\n"
                   "    if let Ok(log) = data.append(\"requests.log\"):\n"
                   "        let _ = log.write(reply.logged(status))\n"
                   "        let _ = log.finish()\n"
                   "    let _ = connection.send(reply.answer(status))\n"
                   "    connection.close()\n",
        "reply.wy": "// What the service answers, from the request's bytes alone: no connection, no directory.\n"
                    "// test.wy checks it natively.\nimport span\n\n"
                    "// 200 for `GET /`, 404 for another path, 400 for anything else.\n"
                    "pub fn status(request: Span) -> U64:\n"
                    "    if request.starts_with_text(\"GET / \"):\n        return 200\n"
                    "    if request.starts_with_text(\"GET /\"):\n        return 404\n"
                    "    return 400\n\n"
                    "// The whole answer for a status.\n"
                    "pub fn answer(status: U64) -> Text:\n"
                    "    if status == 200:\n"
                    f"        return \"HTTP/1.1 200 OK\\r\\nconnection: close\\r\\ncontent-length: {len(body)}\\r\\n\\r\\nhello from {name}\\n\"\n"
                    "    if status == 404:\n"
                    "        return \"HTTP/1.1 404 Not Found\\r\\nconnection: close\\r\\ncontent-length: 0\\r\\n\\r\\n\"\n"
                    "    return \"HTTP/1.1 400 Bad Request\\r\\nconnection: close\\r\\ncontent-length: 0\\r\\n\\r\\n\"\n\n"
                    "// The line kept in the directory for a status.\n"
                    "pub fn logged(status: U64) -> Text:\n"
                    "    if status == 200:\n        return \"200\\n\"\n"
                    "    if status == 404:\n        return \"404\\n\"\n"
                    "    return \"400\\n\"\n",
        "test.wy": "// Native tests: `grimoire test`. The answer is checked as a function of the request's bytes;\n"
                   "// a case cannot be given a connection (docs/package-tests.md).\n"
                   "import \"reply.wy\"\nimport span\nimport string\nimport testing\n\n"
                   "fn status_of(allocator: &Allocator, request: Text) -> Result<U64, U64>:\n"
                   "    var text = String.new(allocator)?\n"
                   "    if let Err(code) = text.push_text(allocator, request):\n"
                   "        text.close()\n"
                   "        return Err(code)\n"
                   "    let status = reply.status(text.span())\n"
                   "    text.close()\n"
                   "    return Ok(status)\n\n"
                   "test fn answers_the_root(allocator: &Allocator) -> Result<(), Failure>:\n"
                   "    let status = testing.set_up(status_of(allocator, \"GET / HTTP/1.1\\r\\n\\r\\n\"))?\n"
                   "    return testing.eq_u64(status, 200)\n\n"
                   "test fn another_path_is_not_found(allocator: &Allocator) -> Result<(), Failure>:\n"
                   "    let status = testing.set_up(status_of(allocator, \"GET /missing HTTP/1.1\\r\\n\\r\\n\"))?\n"
                   "    return testing.eq_u64(status, 404)\n\n"
