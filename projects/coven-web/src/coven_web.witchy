// coven-web — the secure web frontend server for the coven registry.
//
// 100% witchy on std/server. It serves a zero-dep SPA + the full security-header
// stack (Perfect Types CSP, COOP/COEP/DIP cross-origin isolation, the
// double-iframe `/sandbox-frame` bootstrap) and reverse-proxies coven's read API
// same-origin, so the browser's `connect-src 'self'` is satisfied without CORS.
//
// Handlers are `fn(Request) -> Response` (no ambient authority). The proxy
// handlers are *deliberately* given the `Net` capability via closure capture so
// they can reach the upstream coven; nothing else can phone home.

import server
import http
import string
import ascii
import list
import json
import crypto
import encoding
import webauthn
import oauth
import jwt
import secretstore
import url
import result
import option

fn main(console: Console, net: Net, assets: Dir, secrets: SecretStore, clock: Clock, args: List(String)):
    // The root signing key is the store's `signing` secret (`--signing-key <seed>` is
    // sugar for `--secret-file signing=<path>`); it backs sessions + OAuth state. The
    // GitHub OAuth client secret, when present, is a second named secret.
    let key = secrets.require("signing")
    let listen_addr = if list.length(args) > 0: list.at(args, 0) else: "127.0.0.1:8080"
    let upstream = if list.length(args) > 1: list.at(args, 1) else: "127.0.0.1:8787"
    // The WebAuthn relying-party origin + id the server checks every assertion against.
    let origin = if list.length(args) > 2: list.at(args, 2) else: "http://" + listen_addr
    let rp_id = if list.length(args) > 3: list.at(args, 3) else: "localhost"
    // "Log in with GitHub" config. `gh_client_id` empty => login disabled. The base URLs
    // are overridable (GitHub Enterprise, or a test's mock) and default to github.com.
    let gh_client_id = if list.length(args) > 4: list.at(args, 4) else: ""
    let gh_base = if list.length(args) > 5: list.at(args, 5) else: "https://github.com"
    let gh_api = if list.length(args) > 6: list.at(args, 6) else: "https://api.github.com"
    let gh_redirect = origin + "/auth/github/callback"
    // "Log in with Google" (OIDC) config. `google_client_id` empty => disabled. Google's
    // authorize/token/JWKS live on three different hosts, so each is its own (overridable
    // for a test mock) URL; the issuer is the fixed well-known `accounts.google.com`.
    let google_client_id = if list.length(args) > 7: list.at(args, 7) else: ""
    let google_authorize = if list.length(args) > 8: list.at(args, 8) else: "https://accounts.google.com/o/oauth2/v2/auth"
    let google_token = if list.length(args) > 9: list.at(args, 9) else: "https://oauth2.googleapis.com/token"
    let google_jwks = if list.length(args) > 10: list.at(args, 10) else: "https://www.googleapis.com/oauth2/v3/certs"
    let google_redirect = origin + "/auth/google/callback"

    var app = server.router()
    app = app.get("/", h_index_html(assets))
    app = app.get("/index.html", h_index_html(assets))
    app = app.get("/app.js", h_asset(assets, "app.js", "text/javascript; charset=utf-8"))
    app = app.get("/styles.css", h_asset(assets, "styles.css", "text/css; charset=utf-8"))
    // `source-sandbox.js` is the in-sandbox renderer; the glamour highlighter WASM
    // is base64-INLINED into that bundle at build time (witchy's Dir `read` is
    // UTF-8-only and cannot serve binary; inlining also keeps the wasm riding along
    // with the renderer the parent already fetches same-origin and injects as TEXT,
    // so no new binary route or frame fetch is introduced — `connect-src 'none'`
    // on the frame stays intact). It runs under the pure-compute host, footprint-empty.
    app = app.get("/source-sandbox.js", h_asset(assets, "source-sandbox.js", "text/javascript; charset=utf-8"))
    app = app.get("/sandbox-frame", h_sandbox_frame())
    // A foreign-code COMPARTMENT renderer (RFC-0015): the d3-style "runes over time" chart.
    // Loaded by the glamour host shell into a sandboxed, opaque-origin iframe; served HERE
    // with a locked `connect-src 'none'` compartment CSP (see `csp_for`). The renderer is
    // self-contained (inline script) because an opaque-origin frame can't load external
    // modules — the same reason source-sandbox inlines. Even compromised it is contained.
    app = app.get("/compartments/d3-runes-chart/", h_asset(assets, "compartments/d3-runes-chart/index.html", "text/html; charset=utf-8"))
    // Read API reverse-proxy — one explicit route per allowlisted coven endpoint
    // (the route table IS the SSRF allowlist; query strings are forwarded verbatim).
    app = app.get("/api/coven/index", h_proxy(net, upstream, "/coven/index"))
    app = app.get("/api/coven/catalog", h_proxy(net, upstream, "/coven/catalog"))
    app = app.get("/api/coven/versions", h_proxy(net, upstream, "/coven/versions"))
    app = app.get("/api/coven/record", h_proxy(net, upstream, "/coven/record"))
    app = app.get("/api/coven/source", h_proxy(net, upstream, "/coven/source"))
    app = app.get("/api/coven/doc", h_proxy(net, upstream, "/coven/doc"))
    app = app.get("/api/coven/compartments", h_proxy(net, upstream, "/coven/compartments"))
    app = app.get("/api/coven/rootpub", h_proxy(net, upstream, "/coven/rootpub"))
    app = app.get("/api/coven/snapshot", h_proxy(net, upstream, "/coven/snapshot"))
    app = app.get("/api/coven/timestamp", h_proxy(net, upstream, "/coven/timestamp"))
    // Write endpoints (the only state-changing surface): the two-phase promote and
    // yank. POST, behind the Sec-Fetch CSRF layer below AND a passkey session — a
    // signed-in maintainer's bearer token is required before either reaches coven.
    app = app.post("/api/coven/promote", require_session(key, clock)(h_proxy_post(net, upstream, "/coven/promote")))
    app = app.post("/api/coven/yank", require_session(key, clock)(h_proxy_post(net, upstream, "/coven/yank")))
    // WebAuthn: register a credential, fetch a single-use challenge, sign IN (an
    // assertion the server verifies, minting a session token), and a second-factor
    // promote that verifies the assertion server-side before forwarding.
    app = app.post("/api/webauthn/register", h_wa_register(assets))
    app = app.get("/api/webauthn/challenge", h_wa_challenge(assets, key, clock))
    app = app.post("/api/webauthn/login", h_wa_login(assets, key, clock, origin, rp_id))
    app = app.post("/api/coven/promote-2fa", h_wa_promote(assets, net, upstream, origin, rp_id))
    // "Log in with GitHub" (OAuth2 Authorization Code) — registered only when a client
    // id is configured. `/login` redirects to GitHub with a signed anti-CSRF state;
    // `/callback` verifies the state, trades the code for a token, reads the user, and
    // mints the same bearer session a passkey sign-in would (composition over std/oauth).
    if gh_client_id != "":
        app = app.get("/auth/github/login", h_github_login(key, clock, gh_base, gh_client_id, gh_redirect))
        app = app.get("/auth/github/callback", h_github_callback(net, key, clock, secrets, gh_base, gh_api, gh_client_id, gh_redirect))
    // "Log in with Google" (OIDC) — same shape, but the callback VERIFIES the id_token (a
    // JWT) against Google's JWKS rather than fetching a user endpoint.
    if google_client_id != "":
        app = app.get("/auth/google/login", h_google_login(key, clock, google_authorize, google_client_id, google_redirect))
        app = app.get("/auth/google/callback", h_google_callback(net, key, clock, secrets, google_token, google_jwks, google_client_id, google_redirect))
    // Layer order (innermost -> outermost): spa_fallback rewrites a router 404 on a CLIENT
    // route to the SPA shell (so a deep link / reload of /v/… loads the app, then the glamour
    // rune routes from the URL), sec_fetch_csrf rejects cross-site writes before the handler,
    // and security_headers is outer (so even a 403 carries the full stack).
    app = app.layer(spa_fallback(assets))
    app = app.layer(sec_fetch_csrf())
    app = app.layer(security_headers())

    print(console, "coven-web serving http://" + listen_addr + "  -> coven " + upstream)
    server.serve(net, listen_addr, app)

// ---- Static assets ----------------------------------------------------------

fn h_index_html(assets: Dir) -> fn(Request) -> Response:
    fn(req: Request):
        if exists(assets, "index.html"):
            server.html(200, read(assets, "index.html"))
        else:
            server.not_found()

fn h_asset(assets: Dir, file: String, ctype: String) -> fn(Request) -> Response:
    fn(req: Request):
        if exists(assets, file):
            Response(200, [("content-type", ctype)], read(assets, file))
        else:
            server.not_found()

// ---- The double-iframe sandbox bootstrap ------------------------------------
// Served from a real same-origin URL so it gets its OWN CSP (sandbox CSP with
// `connect-src 'none'`) from the response headers. The outer frame is loaded by
// the parent with `sandbox="allow-scripts"` (opaque origin). This bootstrap then
// creates a second, inner opaque-origin `srcdoc` iframe and relays a MessagePort
// to it; all real rendering traffic flows over the private MessageChannel.
fn h_sandbox_frame() -> fn(Request) -> Response:
    fn(req: Request): server.html(200, sandbox_bootstrap())

fn sandbox_bootstrap() -> String:
    "<!doctype html><html><head><meta charset='utf-8'></head><body><script>if(window.origin!=='null'){document.body.textContent='This page must be loaded inside a sandboxed iframe.';}else{var d=document.documentElement.style;d.margin='0';d.height='100%';d.background='#0f0b16';document.body.style.margin='0';document.body.style.height='100%';window.addEventListener('message',function h(e){if(e.source!==window.parent)return;if(!e.data||e.data.type!=='init'||!e.ports.length)return;window.removeEventListener('message',h);var port=e.ports[0];var f=document.createElement('iframe');f.setAttribute('sandbox','allow-scripts');f.style.cssText='width:100%;height:100%;border:0;display:block';f.addEventListener('load',function(){f.contentWindow.postMessage({type:'port'},'*',[port]);});f.srcdoc=e.data.html;document.body.appendChild(f);});}</script></body></html>"

// ---- Reverse proxy ----------------------------------------------------------

fn h_proxy(net: Net, upstream: String, base: String) -> fn(Request) -> Response:
    fn(req: Request):
        match req:
            Request(_m, _p, _pa, q, _h, _b) ->
                if query_has_control(q):
                    // SEC-021: query values are forwarded verbatim into the upstream HTTP
                    // request line; a CR/LF would inject headers / smuggle a request. Rune
                    // names/versions never contain control characters, so refuse them.
                    server.bad_request("{\"error\":\"invalid query\"}")
                else:
                    let qs = encode_query(q)
                    let path = if qs == "": base else: base + "?" + qs
                    let (host, port) = split_host_port(upstream)
                    match http.try_get(net, host, port, path):
                        Ok(resp) -> server.json(http.status(resp), http.body(resp))
                        Err(_e) -> server.json(502, "{\"error\":\"coven registry unreachable\"}")

// SEC-021: true if any query key/value contains a CR or LF — the bytes that would
// break out of the forwarded request line into header/request smuggling upstream.
fn query_has_control(pairs: List((String, String))) -> Bool:
    var bad = false
    for pair in pairs:
        let (k, v) = pair
        if string.contains(k, "\n") || string.contains(k, "\r") || string.contains(v, "\n") || string.contains(v, "\r"):
            bad = true
    bad

// POST proxy for the write endpoints. The whole request is in the body, so no
// query forwarding is needed. (Like h_proxy, this captures Net deliberately.)
fn h_proxy_post(net: Net, upstream: String, base: String) -> fn(Request) -> Response:
    fn(req: Request):
        let body = server.request_body(req)
        let (host, port) = split_host_port(upstream)
        match http.try_post(net, host, port, base, body):
            Ok(resp) -> server.json(http.status(resp), http.body(resp))
            Err(_e) -> server.json(502, "{\"error\":\"coven registry unreachable\"}")

// ---- WebAuthn 2FA for promote -----------------------------------------------
// Credential + challenge state live in UNROUTED `_wa_*` files in the served Dir
// (no route serves a `_wa_*` file). A challenge is derived from the Secret (so it
// is unforgeable without it) over a Clock reading, and is single-use. The browser
// hex-encodes the assertion's ArrayBuffers; the server re-derives and verifies
// everything via `webauthn.verify_assertion` — trusting nothing from the client.

fn wa_field(doc: Json, name: String) -> String:
    match json.get_string(doc, name):
        Some(s) -> s
        None -> ""

fn decode_or_empty(s: String) -> Json:
    match json.decode(s):
        Ok(doc) -> doc
        Err(_e) -> JsonObject([])

fn h_wa_register(store: Dir) -> fn(Request) -> Response:
    fn(req: Request):
        // SEC-001: registration is UNAUTHENTICATED, so it may only BOOTSTRAP the first
        // passkey — never overwrite an existing one. Otherwise an anonymous attacker could
        // replace the maintainer's credential and then sign in as them. Rotating a passkey
        // requires removing `_wa_cred.json` out-of-band (operator action).
        if exists(store, "_wa_cred.json"):
            server.json(403, "{\"error\":\"a passkey is already registered; rotation requires removing the credential out-of-band\"}")
        else:
            match server.json_body(req):
                Err(_e) -> server.bad_request("{\"error\":\"bad body\"}")
                Ok(doc) ->
                    let cred = wa_field(doc, "credentialId")
                    let pk = wa_field(doc, "publicKey")
                    if cred == "" || pk == "":
                        server.bad_request("{\"error\":\"missing credentialId or publicKey\"}")
                    else:
                        write(store, "_wa_cred.json", json.encode(JsonObject([("credentialId", JsonString(cred)), ("publicKey", JsonString(pk))])))
                        server.json(200, "{\"ok\":true}")

fn h_wa_challenge(store: Dir, key: Secret, clock: Clock) -> fn(Request) -> Response:
    fn(req: Request):
        let raw = crypto.sign(key, "ch:" + "${now(clock)}")
        let ch_hex = string.substring(raw, 0, 64)
        let ch_b64 = encoding.base64url_of_hex(ch_hex)
        write(store, "_wa_challenge.json", json.encode(JsonObject([("b64", JsonString(ch_b64))])))
        server.json(200, json.encode(JsonObject([("challengeHex", JsonString(ch_hex))])))

fn h_wa_promote(store: Dir, net: Net, upstream: String, origin: String, rp_id: String) -> fn(Request) -> Response:
    fn(req: Request):
        match server.json_body(req):
            Err(_e) -> server.bad_request("{\"error\":\"bad body\"}")
            Ok(doc) -> wa_do_promote(store, net, upstream, origin, rp_id, doc)

fn wa_do_promote(store: Dir, net: Net, upstream: String, origin: String, rp_id: String, doc: Json) -> Response:
    if !exists(store, "_wa_cred.json") || !exists(store, "_wa_challenge.json"):
        server.json(403, "{\"error\":\"no registered credential or outstanding challenge\"}")
    else:
        let pk = wa_field(decode_or_empty(read(store, "_wa_cred.json")), "publicKey")
        let ch_b64 = wa_field(decode_or_empty(read(store, "_wa_challenge.json")), "b64")
        match webauthn.verify_assertion(pk, wa_field(doc, "authData"), wa_field(doc, "clientData"), wa_field(doc, "signature"), ch_b64, origin, rp_id, true):
            Err(reason) -> server.json(403, json.encode(JsonObject([("error", JsonString("2FA failed: " + reason))])))
            Ok(_) ->
                write(store, "_wa_challenge.json", "{}")
                let body = json.encode(JsonObject([("name", JsonString(wa_field(doc, "name"))), ("version", JsonString(wa_field(doc, "version"))), ("second_factor", JsonString("webauthn")), ("promoted_by", JsonString(wa_field(doc, "promotedBy")))]))
                let (host, port) = split_host_port(upstream)
                match http.try_post(net, host, port, "/coven/promote", body):
                    Ok(resp) -> server.json(http.status(resp), http.body(resp))
                    Err(_e) -> server.json(502, "{\"error\":\"coven registry unreachable\"}")

// ---- Session auth (passkey sign-in) -----------------------------------------
// A signed-in maintainer holds a short-lived BEARER token. The server mints it
// only after a passkey assertion verifies (h_wa_login), signing it with the
// server Secret over an expiry; every write re-checks that signature. There is no
// server-side session store — the token is self-authenticating (a mini-JWT), so
// nothing to steal at rest and `--signing-key` rotation invalidates all sessions.

fn session_ttl_ms() -> Int:
    1800000

fn issue_session(key: Secret, clock: Clock) -> (String, Int):
    let exp = now(clock) + session_ttl_ms()
    let tok = "${exp}" + "." + crypto.sign(key, "session:" + "${exp}")
    (tok, exp)

// SEC-010: constant-time string compare for MAC/token verification — iterate ALL
// characters with no early exit, so the time does not reveal WHERE a mismatch is and
// an attacker cannot recover a valid session/state signature byte-by-byte by timing.
fn ct_eq(a: String, b: String) -> Bool:
    if string.length(a) != string.length(b):
        false
    else:
        let ca = string.chars(a)
        let cb = string.chars(b)
        var same = true
        var i = 0
        while i < list.length(ca):
            if list.at(ca, i) != list.at(cb, i):
                same = false
            i = i + 1
        same

fn valid_session(key: Secret, clock: Clock, token: String) -> Bool:
    if !string.contains(token, "."):
        false
    else:
        let (exp_s, sig) = string.split_once(token, ".")
        // SEC-024: guard `to_int` (it traps on non-numeric input) before parsing the
        // attacker-supplied expiry half — an `Authorization: Bearer abc.x` would
        // otherwise abort the server VM. `&&` short-circuits, so a bad token is just invalid.
        ascii.all_digits(exp_s) && ct_eq(sig, crypto.sign(key, "session:" + exp_s)) && string.to_int(exp_s) > now(clock)

fn bearer_of(req: Request) -> Option(String):
    match server.request_header(req, "authorization"):
        Some(h) -> if string.starts_with(h, "Bearer "): Some(string.substring(h, 7, string.length(h))) else: None
        None -> None

// Wrap a write handler so it runs only for a request carrying a valid session.
fn require_session(key: Secret, clock: Clock) -> fn(fn(Request) -> Response) -> fn(Request) -> Response:
    fn(inner: fn(Request) -> Response):
        fn(req: Request):
            match bearer_of(req):
                Some(tok) -> if valid_session(key, clock, tok): inner(req) else: server.json(403, "{\"error\":\"invalid or expired session — sign in again\"}")
                None -> server.json(401, "{\"error\":\"sign in with a passkey to manage releases\"}")

fn h_wa_login(store: Dir, key: Secret, clock: Clock, origin: String, rp_id: String) -> fn(Request) -> Response:
    fn(req: Request):
        match server.json_body(req):
            Err(_e) -> server.bad_request("{\"error\":\"bad body\"}")
            Ok(doc) -> wa_do_login(store, key, clock, origin, rp_id, doc)

fn wa_do_login(store: Dir, key: Secret, clock: Clock, origin: String, rp_id: String, doc: Json) -> Response:
    if !exists(store, "_wa_cred.json") || !exists(store, "_wa_challenge.json"):
        server.json(403, "{\"error\":\"no registered passkey or outstanding challenge\"}")
    else:
        let pk = wa_field(decode_or_empty(read(store, "_wa_cred.json")), "publicKey")
        let ch_b64 = wa_field(decode_or_empty(read(store, "_wa_challenge.json")), "b64")
        match webauthn.verify_assertion(pk, wa_field(doc, "authData"), wa_field(doc, "clientData"), wa_field(doc, "signature"), ch_b64, origin, rp_id, true):
            Err(reason) -> server.json(403, json.encode(JsonObject([("error", JsonString("sign-in failed: " + reason))])))
            Ok(_) ->
                write(store, "_wa_challenge.json", "{}")
                let (tok, exp) = issue_session(key, clock)
                server.json(200, json.encode(JsonObject([("token", JsonString(tok)), ("expires", JsonString("${exp}"))])))

// ---- "Log in with GitHub" (OAuth2) ------------------------------------------
// `/login` redirects to GitHub with a signed, expiring anti-CSRF `state`; `/callback`
// re-checks it, exchanges the code for an access token (std/oauth, over HTTPS), reads
// the GitHub user, and mints the same self-authenticating bearer session a passkey
// sign-in issues. The OAuth client secret is the store's `github_client_secret`.

fn state_ttl_ms() -> Int:
    600000

// A signed, expiring OAuth `state` — the same HMAC-over-the-Secret shape as a session
// token. GitHub echoes it back to `/callback`, where the signature proves we issued it.
fn sign_state(key: Secret, clock: Clock) -> String:
    let exp = now(clock) + state_ttl_ms()
    "${exp}" + "." + crypto.sign(key, "oauth-state:" + "${exp}")

fn valid_state(key: Secret, clock: Clock, state: String) -> Bool:
    if !string.contains(state, "."):
        false
    else:
        let (exp_s, sig) = string.split_once(state, ".")
        // SEC-024: guard `to_int` against the attacker-supplied state half (see valid_session).
        ascii.all_digits(exp_s) && ct_eq(sig, crypto.sign(key, "oauth-state:" + exp_s)) && string.to_int(exp_s) > now(clock)

fn h_github_login(key: Secret, clock: Clock, gh_base: String, client_id: String, redirect_uri: String) -> fn(Request) -> Response:
    fn(req: Request):
        let state = sign_state(key, clock)
        server.redirect(oauth.authorize_url(gh_base + "/login/oauth/authorize", client_id, redirect_uri, "read:user", state))

fn h_github_callback(net: Net, key: Secret, clock: Clock, secrets: SecretStore, gh_base: String, gh_api: String, client_id: String, redirect_uri: String) -> fn(Request) -> Response:
    fn(req: Request):
        github_callback(net, key, clock, secrets, gh_base, gh_api, client_id, redirect_uri, server.query(req, "code"), server.query(req, "state"))

fn github_callback(net: Net, key: Secret, clock: Clock, secrets: SecretStore, gh_base: String, gh_api: String, client_id: String, redirect_uri: String, code: String, state: String) -> Response:
    if code == "" || !valid_state(key, clock, state):
        server.json(403, "{\"error\":\"invalid OAuth state or missing code\"}")
    else:
        match secretstore.get(secrets, "github_client_secret"):
            None -> server.json(500, "{\"error\":\"github login is misconfigured (no client secret)\"}")
            Some(sec) ->
                match oauth.exchange_code(net, gh_base + "/login/oauth/access_token", client_id, crypto.reveal(sec), code, redirect_uri):
                    Err(_) -> server.json(502, json.encode(JsonObject([("error", JsonString("token exchange failed"))])))
                    Ok(token) -> github_finish(net, key, clock, gh_api, token)

fn github_finish(net: Net, key: Secret, clock: Clock, gh_api: String, token: String) -> Response:
    match oauth.bearer_get_json(net, gh_api + "/user", token):
        Err(_) -> server.json(502, json.encode(JsonObject([("error", JsonString("user fetch failed"))])))
        Ok(user) ->
            let login = wa_field(user, "login")
            session_redirect(key, clock, login)

// ---- "Log in with Google" (OIDC) --------------------------------------------
// Like GitHub, but the token endpoint returns an OIDC `id_token` (a JWT) whose signature
// we verify against Google's published JWKS — read the user's `email` from the VERIFIED
// claims, never from anything client-supplied. The issuer is the fixed well-known value.

fn h_google_login(key: Secret, clock: Clock, authorize_url: String, client_id: String, redirect_uri: String) -> fn(Request) -> Response:
    fn(req: Request):
        let state = sign_state(key, clock)
        server.redirect(oauth.authorize_url(authorize_url, client_id, redirect_uri, "openid email", state))

fn h_google_callback(net: Net, key: Secret, clock: Clock, secrets: SecretStore, token_url: String, jwks_url: String, client_id: String, redirect_uri: String) -> fn(Request) -> Response:
    fn(req: Request):
        google_callback(net, key, clock, secrets, token_url, jwks_url, client_id, redirect_uri, server.query(req, "code"), server.query(req, "state"))

fn google_callback(net: Net, key: Secret, clock: Clock, secrets: SecretStore, token_url: String, jwks_url: String, client_id: String, redirect_uri: String, code: String, state: String) -> Response:
    if code == "" || !valid_state(key, clock, state):
        server.json(403, "{\"error\":\"invalid OAuth state or missing code\"}")
    else:
        match secretstore.get(secrets, "google_client_secret"):
            None -> server.json(500, "{\"error\":\"google login is misconfigured (no client secret)\"}")
            Some(sec) ->
                match oauth.exchange_code_id_token(net, token_url, client_id, crypto.reveal(sec), code, redirect_uri):
                    Err(_) -> server.json(502, json.encode(JsonObject([("error", JsonString("token exchange failed"))])))
                    Ok(id_token) -> google_verify(net, key, clock, jwks_url, client_id, id_token)

fn google_verify(net: Net, key: Secret, clock: Clock, jwks_url: String, client_id: String, id_token: String) -> Response:
    match http.get_url(net, jwks_url):
        Err(_) -> server.json(502, json.encode(JsonObject([("error", JsonString("JWKS fetch failed"))])))
        Ok(resp) ->
            match json.decode(http.body(resp)):
                Err(_) -> server.json(502, json.encode(JsonObject([("error", JsonString("JWKS is not JSON"))])))
                Ok(jwks) -> google_finish(key, clock, jwks, client_id, id_token)

// Google may send `email_verified` as a JSON boolean or the string "true".
fn email_is_verified(claims: Json) -> Bool:
    match json.get_bool(claims, "email_verified"):
        Some(b) -> b
        None -> wa_field(claims, "email_verified") == "true"

fn google_finish(key: Secret, clock: Clock, jwks: Json, client_id: String, id_token: String) -> Response:
    match select_and_verify(clock, jwks, client_id, id_token):
        Err(_) -> server.json(403, json.encode(JsonObject([("error", JsonString("id_token rejected"))])))
        Ok(claims) ->
            // SEC-008: admit only a VERIFIED Google email — otherwise an account asserting
            // an unverified email equal to a maintainer's would be let in as that maintainer.
            let email = wa_field(claims, "email")
            if email != "" && email_is_verified(claims):
                session_redirect(key, clock, email)
            else:
                server.json(403, json.encode(JsonObject([("error", JsonString("Google account email is not verified"))])))

// Pick the signing key for the token's `kid` from the JWKS and verify it (signature +
// issuer `accounts.google.com` + audience = our client id + expiry). Returns the claims.
fn select_and_verify(clock: Clock, jwks: Json, client_id: String, id_token: String) -> Result(Json, String):
    let key_id = jwt.kid(id_token).ok_or("id_token header has no `kid`")?
    let der = jwt.rsa_key_for_kid(jwks, key_id)?
    // JWT `exp`/`nbf` are unix SECONDS; `now(clock)` is milliseconds.
    jwt.verify_oidc(id_token, der, "https://accounts.google.com", client_id, now(clock) / 1000)

// Mint a bearer session for `who` and hand it to the SPA in the URL fragment (kept out of
// logs/Referer) — the shared tail of every social-login callback.
fn session_redirect(key: Secret, clock: Clock, who: String) -> Response:
    let (sess, _exp) = issue_session(key, clock)
    server.redirect("/#token=" + url.encode(sess) + "&login=" + url.encode(who))

fn split_host_port(hp: String) -> (String, Int):
    let (h, p) = string.split_once(hp, ":")
    (h, string.to_int(p))

fn encode_query(pairs: List((String, String))) -> String:
    var s = ""
    var first = true
    for pair in pairs:
        let (k, v) = pair
        let seg = k + "=" + v
        if first:
            s = seg
            first = false
        else:
            s = s + "&" + seg
    s

// ---- Security headers (the `.layer()` middleware) ---------------------------

fn security_headers() -> fn(fn(Request) -> Response) -> fn(Request) -> Response:
    fn(inner: fn(Request) -> Response):
        fn(req: Request):
            let resp = inner(req)
            with_headers(resp, headers_for(server.path(req)))

// SPA history fallback: the client routes the glamour rune owns (/, /v/…, /d/…, /s/…, /trust)
// are NOT server routes, so a direct load or reload of one would 404. This layer rewrites that
// 404 to the SPA shell (index.html, 200) for GETs on a client-route prefix only — every real
// asset/API route still matches first, and anything else (a typo, a missing asset with an
// extension) keeps its honest 404. security_headers (outer) then stamps the app CSP by path.
fn is_client_route(p: String) -> Bool:
    p == "/" || string.starts_with(p, "/v/") || string.starts_with(p, "/d/") || string.starts_with(p, "/s/") || string.starts_with(p, "/trust")

fn spa_fallback(assets: Dir) -> fn(fn(Request) -> Response) -> fn(Request) -> Response:
    fn(inner: fn(Request) -> Response):
        fn(req: Request):
            let resp = inner(req)
            match resp:
                Response(code, _h, _b) ->
                    if code == 404 && server.method(req) == "GET" && is_client_route(server.path(req)) && exists(assets, "index.html"):
                        server.html(200, read(assets, "index.html"))
                    else:
                        resp

// Sec-Fetch CSRF defense for state-changing requests. A browser stamps cross-site
// requests with `sec-fetch-site: cross-site|same-site`; we admit only `same-origin` and
// refuse both cross-site AND absent (SEC-020): a missing header means a non-browser
// client, which must opt in with an explicit `Sec-Fetch-Site: same-origin`. Safe methods
// (GET/HEAD) pass through untouched.
fn sec_fetch_csrf() -> fn(fn(Request) -> Response) -> fn(Request) -> Response:
    fn(inner: fn(Request) -> Response):
        fn(req: Request):
            if is_state_changing(server.method(req)):
                match server.request_header(req, "sec-fetch-site"):
                    Some(site) -> if site == "same-origin": inner(req) else: server.forbidden("cross-site request refused")
                    // Fail closed when absent (SEC-020): a browser always sends sec-fetch-site,
                    // so a missing header is a non-browser client — which must opt in explicitly
                    // (`Sec-Fetch-Site: same-origin`) rather than silently bypassing CSRF defense.
                    None -> server.forbidden("missing sec-fetch-site on a state-changing request")
            else:
                inner(req)

fn is_state_changing(method: String) -> Bool:
    method == "POST" || method == "PUT" || method == "DELETE" || method == "PATCH"

fn with_headers(resp: Response, hs: List((String, String))) -> Response:
    var r = resp
    for h in hs:
        let (k, v) = h
        r = server.with_header(r, k, v)
    r

fn headers_for(p: String) -> List((String, String)):
    let xfo = if p == "/sandbox-frame": "SAMEORIGIN" else: "DENY"
    [("content-security-policy", csp_for(p)),
     ("x-content-type-options", "nosniff"),
     ("x-frame-options", xfo),
     ("referrer-policy", "no-referrer"),
     // HARD INVARIANT — strict cross-origin isolation on EVERY response, never relax:
     // COOP same-origin + COEP require-corp + CORP same-origin (the strictest standard
     // values) => a cross-origin-isolated, own-process document (anti-Spectre) and the
     // strongest iframe isolation. DIP isolate-and-require-corp reinforces it.
     ("cross-origin-opener-policy", "same-origin"),
     ("cross-origin-embedder-policy", "require-corp"),
     ("cross-origin-resource-policy", "same-origin"),
     ("document-isolation-policy", "isolate-and-require-corp"),
     ("permissions-policy", permissions_policy()),
     ("x-permitted-cross-domain-policies", "none"),
     // SEC-014: pin this origin to HTTPS (the fronting TLS proxy terminates it). Browsers
     // ignore HSTS over plain HTTP, so sending it always is safe and upgrades the rest.
     ("strict-transport-security", "max-age=31536000; includeSubDomains; preload"),
     ("cache-control", "no-store")]

fn csp_for(p: String) -> String:
    if p == "/sandbox-frame":
        sandbox_csp()
    else if string.starts_with(p, "/compartments/"):
        compartment_csp()
    else if string.starts_with(p, "/api/"):
        api_csp()
    else:
        app_csp()

// A foreign-code compartment renderer: its inline script may run, but it has NO network
// (`connect-src 'none'`) and is force-sandboxed to an opaque origin (`sandbox
// allow-scripts`, no `allow-same-origin`), so even a compromised renderer cannot exfiltrate
// or reach the parent. `'unsafe-inline'` is scoped to this opaque-origin box — exactly the
// tradeoff `sandbox_csp` makes for the source sandbox.
fn compartment_csp() -> String:
    "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; sandbox allow-scripts"

// The app shell is now ONE capability-pure glamour rune compiled to WASM and inlined into
// `app.js`; its host shell (glamour-dom.mjs) builds the DOM with createElement/textContent
// ONLY — there is no HTML-string sink anywhere — so the app is XSS-immune by construction.
// `trusted-types 'none'` keeps that browser-enforced: the shell creates NO Trusted Types
// policy, so any string->HTML sink (a future bug, an injected script) still throws.
// `'wasm-unsafe-eval'` is added to `script-src` SOLELY so the parent can compile that trusted
// app module — it permits WebAssembly compilation, NOT JS `eval()`/`Function()` (a strictly
// narrower grant than `'unsafe-eval'`), and the only module the bootstrap ever compiles is
// our own inlined rune. `connect-src 'self'` keeps every fetch same-origin (the proxy is why
// coven is reachable, and there are no ambient cookies — auth is a bearer capability).
fn app_csp() -> String:
    "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self'; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types 'none'"

// The sandbox frame intentionally OMITS Perfect Types so the bootstrap can set
// `srcdoc` and the renderer can use innerHTML — safe because the frame is
// opaque-origin (no allow-same-origin) and `connect-src 'none'` (network firewall).
//
// `'wasm-unsafe-eval'` is added to `script-src` HERE — and ONLY here — so the
// frame may instantiate the glamour syntax-highlighter WASM (RFC-0007's
// pure-compute target). This is the RFC-0007-sanctioned tradeoff: the WASM runs
// inside this CONTAINED sandbox (opaque origin + `connect-src 'none'`), never in
// the trusted parent — `app_csp()` deliberately keeps NO `wasm-unsafe-eval`. The
// wasm bytes are base64-INLINED into `source-sandbox.js` at build time, so they
// ride along with the renderer the parent already fetches same-origin and injects
// as TEXT; the frame itself never fetches anything (`connect-src 'none'` holds).
// The highlighter rune's capability footprint is empty, and the pure-compute host
// denies every capability import, so the module is I/O-incapable by construction
// even before the frame's network firewall.
fn sandbox_csp() -> String:
    "default-src 'none'; script-src 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'unsafe-inline'; connect-src 'none'; worker-src 'none'; form-action 'none'; base-uri 'none'; sandbox allow-scripts; frame-ancestors 'self'"

fn api_csp() -> String:
    "default-src 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'"

fn permissions_policy() -> String:
    // Deny everything except WebAuthn, which the 2FA promote needs. `(self)` grants
    // it to this origin only — NOT delegated to the opaque-origin sandbox iframes.
    "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(self), publickey-credentials-create=(self), screen-wake-lock=(), sync-xhr=(), usb=(), xr-spatial-tracking=()"
