// gm_engine — the effectful package-manager engine of the grimoire client (RFC-0004):
// the capability-holding machinery that resolves versions, fetches and verifies
// records over the network, vendors sources, maintains the lockfile, runs the TUF
// chain, gates capability widening, drives sandboxed build steps, and uploads/installs
// artifacts. It sits above the pure gm_core and below the thin CLI command handlers
// in grimoire.witchy — commands call the engine; the engine never calls a command.

import crypto
import encoding
import bytes
import compiler
import exec
import fs
import rights
import error
import convert
import coven_proto
import coven_artifact
from http import Response
from json import Json
from semver import Version, Req
from toml import Toml
from gm_core import BuildOptions, FootprintError, LockIntegrityError, LockPinError, RecordFootprintError, RegistryRootKeyError, TufError, VendoredRecordError, VersionResolveError
from gm_core import add_unique, arg, basename, build_exec_child_paths, build_exec_programs, build_footprint, canonical_version, check_path_identity, closure_has, content_hash, conventional_entry, cooling, cooling_remaining, declared_caps, dep_flag_owned, dep_req, dep_source, entry_alias, entry_is_registry, entry_source, exact_record_state, field, first_witchy, flatten_argv, footprint_toml, footprint_values, grant_flags, granted_build_kinds, has_dep, has_flag, has_grants_section, jget, join_path, latest_label, lock_baseline, lock_rune_entries, locked_hash, locked_registry_alias, manifest_upsert_dep, module_name, module_stem, normalize_path, optional_lock_string, package_owner_flag, parse_origin, parse_vendored_record, pick_version_cooled, pinned_registry_trust, project_data_dir, record_matches_coordinate, record_payload, record_signature_valid, recorded_field, recorded_hash, registry_get, registry_origin, registry_placeholder, registry_post, released_version_records, required_lock_field, required_manifest_coordinate, resp_field, runtime_net_flags, signed_canonical, signed_field, signed_field_int, signed_field_str, signed_valid, snapshot_schema_ok, source_files, strict_footprint, strip_net_flags, target_digest, timestamp_schema_ok, union_all, valid_registry_rootpub, validate_source_files, verified_snapshot_line, verify_record_signature, version_records, version_satisfies, wire

pub fn build_project_target(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, entry: String, deps: List(String), build_flags: List(String), options: BuildOptions) -> Int:
    if options.target == "trusted-publisher":
        let manifest = join_path(dir, "witchy.toml")
        let configured = if options.out.is_empty(): trusted_output(root, dir, options.mode) else: options.out
        let target_flags = ["--target", "trusted-publisher", "--manifest", manifest, "--out", configured, "--${options.mode}"]
        run_compiler(console, runner, bin, "build", flatten_argv(["compile", entry], flatten_argv(deps, flatten_argv(build_flags, target_flags))))
    else if !options.out.is_empty():
        console.print("--out is supported by `build --target trusted-publisher`; portable project builds remain verification-only")
        1
    else:
        run_compiler(console, runner, bin, "build", flatten_argv(["compile", entry], flatten_argv(deps, build_flags)))

pub fn trusted_output(root: Dir, dir: String, mode: String) -> String:
    let manifest = root.read(join_path(dir, "witchy.toml"))
    let name = field(manifest, "rune.name")
    join_path(join_path(join_path(dir, "target"), mode), module_name(name))

// Link a project's entry + vendored deps to a wasm under <dir>/target, then run
// that wasm. Two compiler invocations: `compile --dep ... --out` (link) then a
// run of the wasm (which carries exactly its own footprint). The artifact goes
// under the project's own tree so it is named through the project Dir.
//
// The run step is granted a `Dir` rooted at the PROJECT directory (`--dir <dir>`),
// NOT pm's own working directory. This keeps the program's runtime authority
// confined to its own tree while still letting the *compile* step reach a sibling
// path-dependency (`../lib`), which is named relative to pm's Dir (a workspace
// that holds both the app and its siblings). Without the explicit `--dir`, the
// program's data Dir would default to pm's cwd — too wide when pm runs from a
// workspace root, and missing the project's data files (e.g. `tasks.md`).
pub fn run_project(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, app_args: List(String)) -> Int:
    match ensure_lock_integrity(root, dir):
        // BUG-094: verify vendored sources against their signed records before
        // linking + running, so a tampered vendored rune never executes.
        Err(e) ->
            console.print(e.show())
            2
        Ok(_) ->
            match project_entry(root, dir):
                None ->
                    console.print("no entry source under ${join_path(dir, "src")}")
                    1
                Some(entry) ->
                    let steps = build_step_flags(console, runner, root, bin, dir)
                    if steps.0 != 0:
                        steps.0
                    else:
                        compile_then_run(console, runner, root, bin, dir, entry, steps.1, app_args)

// `build`/`run` use a lock on every project path. A path-only development project
// gets its first lock automatically, matching the documented "writes/uses the
// lock" contract. Registry dependencies can only be locked by `add`, because that
// operation obtains the signed record and trust pins; never synthesize a weaker
// registry lock during a build.
pub fn ensure_lock_integrity(root: Dir, dir: String) -> Result(Nil, LockIntegrityError):
    let lockpath = join_path(dir, "witchy.lock")
    if !root.exists(lockpath):
        let manifest = root.read(join_path(dir, "witchy.toml"))
        let problems = lock_problems(root, dir, manifest)
        if list.length(problems) > 0:
            Err(LockCannotCreate(list.join(problems, "; ")))
        else:
            match generate_lock(root, dir):
                Err(e) -> Err(LockCannotCreate(e.show()))
                Ok(lock) ->
                    root.write(lockpath, lock)
                    verify_lock_integrity(root, dir)
    else:
        verify_lock_integrity(root, dir)

// One offline integrity contract shared by `build`, `run`, and `verify`:
//
// * every path dependency still matches the hash pinned in the lock;
// * every registry lock entry has a corresponding vendored rune;
// * the vendored record verifies under the root key pinned in the lock;
// * signed name/version/hash agree with the lock entry; and
// * the current source tree hashes to that same signed and locked hash.
//
// No network state participates. Online TUF freshness is the optional second
// phase of `verify --online`.
pub fn verify_lock_integrity(root: Dir, dir: String) -> Result(Nil, LockIntegrityError):
    let lockpath = join_path(dir, "witchy.lock")
    if !root.exists(lockpath):
        Err(LockMissing)
    else:
        let lock = root.read(lockpath)
        let path_bad = hash_mismatches(root, dir, lock)?
        if list.length(path_bad) > 0:
            Err(LockPathHashMismatch(path_bad))
        else:
            verify_registry_lock_entries(root, dir, lock)

pub fn verify_registry_lock_entries(root: Dir, dir: String, lock: String) -> Result(Nil, LockIntegrityError):
    let rootpub: String = match pinned_registry_trust(lock):
        Err(e) -> return Err(LockEntryMalformed(e.show()))
        Ok(None) -> ""
        Ok(Some(trust)) -> trust.1

    var aliases = []
    for entry in lock_rune_entries(lock)?:
        match entry_source(entry):
            Some(source) ->
                if source == "coven":
                    let name = required_lock_field(entry, "name")?
                    let version = required_lock_field(entry, "version")?
                    let hash = required_lock_field(entry, "hash")?
                    let alias = entry_alias(entry)
                    if alias.is_empty():
                        return Err(LockEntryMalformed("registry entry `${name}` has no local alias"))
                    else if aliases.contains(alias):
                        return Err(LockDuplicateAlias(alias))
                    aliases.push(alias)
                    if rootpub.is_empty():
                        return Err(LockRootKeyMissing)
                    let rune_dir = join_path(join_path(dir, "vendor"), alias)
                    let record_path = join_path(rune_dir, "coven.json")
                    if !root.exists(record_path):
                        return Err(LockVendorMissing(alias))
                    else if !root.exists(join_path(rune_dir, "witchy.toml")):
                        return Err(LockVendorManifestMissing(alias))
                    let record_text = root.read(record_path)
                    match verify_record_signature(rootpub, record_text):
                        Err(e) -> return Err(LockRecordInvalid(alias, e.show()))
                        Ok(_doc) -> Nil

                    let record = match parse_vendored_record(record_text):
                        Err(e) -> return Err(LockRecordInvalid(alias, e.show()))
                        Ok(record) -> record

                    if record.name != name:
                        return Err(LockRecordCoordinateMismatch(alias, "name", name, record.name))
                    else if record.version != version:
                        return Err(LockRecordCoordinateMismatch(alias, "version", version, record.version))
                    else if record.hash != hash:
                        return Err(LockRecordCoordinateMismatch(alias, "hash", hash, record.hash))
                    else if rune_hash(root, rune_dir) != hash:
                        return Err(LockSourceHashMismatch(alias))
                else if source.starts_with("path:"):
                    let name = required_lock_field(entry, "name")?
                    if !is_locked_path_dependency(root, dir, name):
                        return Err(LockEntryMalformed("path entry `${name}` is not in the manifest dependency closure"))
                else:
                    return Err(LockEntryMalformed("unsupported dependency source `${source}`"))
            None -> return Err(LockEntryMalformed("a [[rune]] entry has no `source` field"))
    Ok(Nil)

pub fn is_locked_path_dependency(root: Dir, dir: String, name: String) -> Bool:
    for dep_name, _dep_dir in path_closure(root, dir):
        if dep_name == name:
            return true
    false

pub fn compile_then_run(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, entry: String, build_flags: List(String), app_args: List(String)) -> Int:
    let outdir = join_path(dir, "target")
    if !root.exists(outdir):
        root.make_dir(outdir)
    let wasm = join_path(outdir, "app.wasm")
    match dep_flags(root, dir):
        Err(e) ->
            console.print(e.show())
            2
        Ok(dep_argv) ->
            compile_then_run_deps(console, runner, root, bin, dir, entry, wasm, flatten_argv(dep_argv, build_flags), app_args)

// The tail of `compile_then_run` once the lockfile `--dep` flags are resolved:
// compile the entry + deps to `wasm`, then sandbox-run it. Split out so the
// lockfile-decode `Result` is handled once at the boundary above.
pub fn compile_then_run_deps(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, entry: String, wasm: String, deps: List(String), app_args: List(String)) -> Int:
    let argv = flatten_argv(["compile", entry], flatten_argv(deps, ["--out", wasm]))
    let built = exec.run_args(runner, bin, "witchy", argv)
    if built.0 != 0:
        console.print(built.1)
        built.0
    else:
        // BUG-406: runtime `--net <addr>` grants (forwarded by the front-end as trailing
        // args) must sit in the sandbox-flags position (before the wasm), not as the app's
        // own argv. BUG-102: the program's remaining argv still follows the sandboxed wasm.
        let net_flags = runtime_net_flags(app_args)
        let real_args = strip_net_flags(app_args)
        let sandbox_head = flatten_argv(["sandbox", "--dir", project_data_dir(dir)], flatten_argv(net_flags, [wasm]))
        run_compiler(console, runner, bin, "run", flatten_argv(sandbox_head, real_args))

// The project's entry source: the conventional `src/<module_name(rune.name)>.witchy`
// (BUG-086), falling back to the first `.witchy` under <dir>/src for a rune with a
// non-conventional layout. Identical resolution to `module_in_src`.
pub fn project_entry(root: Dir, dir: String) -> Option(String):
    module_in_src(root, dir)

// One `--dep name=path` token per dependency (TRANSITIVELY), mapping the `import
// <name>` any linked module uses to the source the compiler should link. The
// compiler links a flat set of modules, so a *diamond* — `app` → {`tasks`,
// `coverage`} → `bars` — needs every rune in the graph passed as a `--dep`, not
// just the app's direct dependencies. Deduplicated by name (a shared base like
// `bars` appears once). A registry dependency is served from its vendored tree
// (`vendor/<name>/src/*.witchy`, pinned by the lock); a path dependency is
// resolved from its manifest's `path =`, relative to the depending rune's dir, so
// a sibling-library workspace builds without vendoring. Path wins when both are
// present (the manifest is the source of truth for a path dep).
pub fn dep_flags(root: Dir, dir: String) -> Result(List(String), LockIntegrityError):
    let manifest_path = join_path(dir, "witchy.toml")
    if !root.exists(manifest_path):
        Err(LockEntryMalformed("project has no witchy.toml for authenticated package ownership"))
    else:
        let manifest = root.read(manifest_path)
        let name = required_manifest_coordinate(manifest, "rune.name")?
        let version = required_manifest_coordinate(manifest, "rune.version")?
        collect_deps(root, dir, package_owner_flag([], "workspace", name, version, module_name(name)))

// Accumulate `--dep` flags for the rune at `dir` and, recursively, the path
// dependencies it declares — skipping any already present so the graph is walked
// once per rune (cycles and diamonds both terminate). A malformed lockfile is an
// explicit error (BUG-373), never a silently-incomplete `--dep` set that would
// mis-resolve imports.
pub fn collect_deps(root: Dir, dir: String, flags: List(String)) -> Result(List(String), LockIntegrityError):
    var acc = flags
    if root.exists(join_path(dir, "witchy.toml")):
        let manifest = root.read(join_path(dir, "witchy.toml"))
        for pair in toml.table(manifest, "dependencies"):
            acc = push_path_dep(root, dir, acc, pair)?
    let lockpath = join_path(dir, "witchy.lock")
    if root.exists(lockpath):
        let lock = root.read(lockpath)
        let rootpub: String = match pinned_registry_trust(lock):
            Err(e) -> return Err(LockEntryMalformed(e.show()))
            Ok(None) -> ""
            Ok(Some(trust)) -> trust.1

        for entry in lock_rune_entries(lock)?:
            // The import key is the local alias (basename), distinct from the lock's
            // registry identity `name` (BUG-099). Old-format locks have no `alias`,
            // so fall back to the basename of `name`.
            let alias = entry_alias(entry)
            if entry_is_registry(entry) && !alias.is_empty() && !has_dep(acc, alias):
                if let Some(src) = vendored_module(root, dir, alias):
                    if rootpub.is_empty():
                        return Err(LockRootKeyMissing)
                    let package = required_lock_field(entry, "name")?
                    let version = required_lock_field(entry, "version")?
                    acc = dep_flag_owned(acc, alias, src, "registry:${rootpub}", package, version, module_name(package))
    Ok(acc)

// Append a `--dep <name>=<path>` for a manifest path dependency (no-op otherwise),
// then recurse into that dependency's own directory so its transitive path deps
// are collected too. Already-resolved names are skipped (the diamond's shared base
// resolves once).
pub fn push_path_dep(root: Dir, dir: String, flags: List(String), pair: (String, String)) -> Result(List(String), LockIntegrityError):
    let (name, inline) = pair
    if has_dep(flags, name):
        Ok(flags)
    else:
        match toml.inline_get(inline, "path"):
            // BUG-415: a declared path dependency whose `src/` has no
            // module is broken. Don't silently drop the `--dep` — that
            // lets `import <name>` mis-resolve to `<consumer>/src/<name>.witchy`
            // and fail naming the CONSUMER's tree. Point the compiler at the
            // dependency's own conventional entry (which is missing) so the
            // error names the actual broken dependency directory.
            Some(rel) ->
                let dep_dir = normalize_path(join_path(dir, rel))
                let owner = workspace_dependency_owner(root, dep_dir)?
                match module_in_src(root, dep_dir):
                    Some(src) -> collect_deps(root, dep_dir, dep_flag_owned(flags, name, src, owner.0, owner.1, owner.2, owner.3))
                    None ->
                        Ok(dep_flag_owned(flags, name, conventional_entry(dep_dir, name), owner.0, owner.1, owner.2, owner.3))
            None -> Ok(flags)

pub fn workspace_dependency_owner(root: Dir, dep_dir: String) -> Result((String, String, String, String), LockIntegrityError):
    let manifest_path = join_path(dep_dir, "witchy.toml")
    if !root.exists(manifest_path):
        Err(LockEntryMalformed("path dependency `${dep_dir}` has no witchy.toml for authenticated ownership"))
    else:
        let manifest = root.read(manifest_path)
        let package = required_manifest_coordinate(manifest, "rune.name")?
        let version = required_manifest_coordinate(manifest, "rune.version")?
        Ok(("workspace", package, version, module_name(package)))

pub fn dependency_owner(root: Dir, dir: String, alias: String, depdir: String) -> Result((String, String, String), LockIntegrityError):
    let lockpath = join_path(dir, "witchy.lock")
    if root.exists(lockpath):
        let lock = root.read(lockpath)
        for entry in lock_rune_entries(lock)?:
            if entry_is_registry(entry) && entry_alias(entry) == alias:
                let rootpub = match pinned_registry_trust(lock):
                    Err(e) -> return Err(LockEntryMalformed(e.show()))
                    Ok(None) -> return Err(LockRootKeyMissing)
                    Ok(Some(trust)) -> trust.1

                return Ok(("registry:${rootpub}", required_lock_field(entry, "name")?, required_lock_field(entry, "version")?))

    let owner = workspace_dependency_owner(root, depdir)?
    Ok((owner.0, owner.1, owner.2))

// The vendored source file for dependency `name`: vendor/<name>/src/<first>.witchy.
pub fn vendored_module(root: Dir, dir: String, name: String) -> Option(String):
    module_in_src(root, join_path(join_path(dir, "vendor"), name))

// The entry `.witchy` under `<base>/src`, as a path the compiler can read. BUG-086:
// prefer the conventional `src/<module_name(rune.name)>.witchy` (the launcher's
// `project_entry_file` convention) so a rune with several modules compiles its real
// entry, not whichever file happens to sort first. Falls back to the first `.witchy`
// in listing order for a rune whose entry does not follow the convention.
pub fn module_in_src(root: Dir, base: String) -> Option(String):
    let srcdir = join_path(base, "src")
    if !root.exists(srcdir):
        None
    else:
        let conventional = manifest_entry(root, base)
        if !conventional.is_empty() && root.exists(conventional):
            Some(conventional)
        else:
            match first_witchy(root.subtree(srcdir).list()):
                Some(file) -> Some(join_path(srcdir, file))
                None -> None

// The conventional entry-source path derived from the rune's own manifest identity
// (`<base>/src/<module_name(rune.name)>.witchy`), or "" when there is no manifest /
// no `rune.name`. BUG-086.
pub fn manifest_entry(root: Dir, base: String) -> String:
    let manifest_path = join_path(base, "witchy.toml")
    if !root.exists(manifest_path):
        ""
    else:
        match toml.get(root.read(manifest_path), "rune.name"):
            Some(nm) -> conventional_entry(base, nm)
            None -> ""

// Exec the compiler with `argv`, printing its output and returning its exit code.
pub fn run_compiler(console: Console, runner: Exec, bin: Dir, label: String, argv: List(String)) -> Int:
    let result = exec.run_args(runner, bin, "witchy", argv)
    console.print(result.1)
    result.0

// Drive the compiler (`witchy`) with `argv`, confined to the toolchain-`bin` Dir
// via the `Exec` capability (you can only run a binary you can read). Prints the
// compiler's output and returns its exit code. The shared core of
// run/typecheck/fmt/test/doc — the CLI front-end driving the compiler, RFC-0004's
// cargo→rustc split.
// --- build steps (§7.1) -----------------------------------------------------
// A dependency may ship a `src/build.witchy` that GENERATES source the consumer
// then imports. Running it is dangerous — generated code is still code — so the
// front-end gates it default-deny, twice over (the policy mirrors the Rust
// `run_dep_build_step`, src/pm/cli.rs:500-703): EXECUTION itself must be consented
// (a `[build.grants."name"]` section must exist), and any build capability the
// step demands beyond the confined `BuildOut` sandbox must be named in it. The
// confined EXECUTION + sandboxing is the compiler's (`witchy build-step`, the
// TCB); the front-end only decides POLICY and drives it via `Exec`.
//
// Returns (exit_code, extra_dep_flags): a nonzero code aborts the build; the flags
// are `--dep <module>=<path>` per generated file, joined into the compile.
pub fn build_step_flags(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String) -> (Int, List(String)):
    match dep_dirs(root, dir):
        Err(e) ->
            console.print("BLOCK: cannot read witchy.lock — ${e.show()}")
            (1, [])
        Ok(deps) ->
            var code = 0
            var flags = []
            for name, depdir in deps:
                if has_build_step(root, depdir):
                    let outcome = run_one_build_step(console, runner, root, bin, dir, name, depdir)
                    if outcome.0 != 0:
                        code = outcome.0
                    else:
                        flags = flatten_argv(flags, outcome.1)
            (code, flags)

// Each dependency as (name, dir): the consumer's path dependencies (resolved
// relative to the project) and its vendored registry dependencies (`vendor/<name>`).
pub fn dep_dirs(root: Dir, dir: String) -> Result(List((String, String)), LockIntegrityError):
    var out = []
    if root.exists(join_path(dir, "witchy.toml")):
        let manifest = root.read(join_path(dir, "witchy.toml"))
        for name, inline in toml.table(manifest, "dependencies"):
            if let Some(rel) = toml.inline_get(inline, "path"):
                out.push((name, normalize_path(join_path(dir, rel))))
    let vendor = join_path(dir, "vendor")
    if root.exists(vendor):
        let lockpath = join_path(dir, "witchy.lock")
        let lock = if root.exists(lockpath): root.read(lockpath) else: ""
        for name in root.subtree(vendor).list():
            let rune_dir = join_path(vendor, name)
            // BUG-095: only treat a vendored subdir as a real dependency (and thus
            // run its build step) when it carries provenance (coven.json) AND is
            // pinned in witchy.lock. A stray directory dropped under vendor/, or an
            // unpinned partial add, must not have its build step executed.
            if root.exists(join_path(rune_dir, "coven.json")) && locked_registry_alias(lock, name)?:
                out.push((name, rune_dir))
    Ok(out)

// Whether a dependency ships a `build` step (`src/build.witchy` defining `build`).
pub fn has_build_step(root: Dir, depdir: String) -> Bool:
    let path = join_path(join_path(depdir, "src"), "build.witchy")
    root.exists(path) && root.read(path).contains("fn build")

// Run one dependency's build step under its grant, returning (code, dep_flags).
// Default-deny layer 1: refuse unless the consumer accepted execution with a
// `[build.grants."name"]` section. Layer 2: the demanded build caps must all be
// granted. Then cache-or-exec, audit the generated source, and emit `--dep` flags.
pub fn run_one_build_step(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, name: String, depdir: String) -> (Int, List(String)):
    let manifest = root.read(join_path(dir, "witchy.toml"))
    if !has_grants_section(manifest, name):
        console.print("`${name}` ships a build step, and build-time code execution is denied by default.")
        console.print("  Add a [build.grants.\"${name}\"] section to accept it — an empty section permits only the confined output sandbox (BuildOut); name read/exec/env/net to grant more.")
        (1, [])
    else:
        let buildfile = join_path(join_path(depdir, "src"), "build.witchy")
        let demanded = match build_footprint(root.read(buildfile)):
            Err(e) ->
                console.print("`${name}` build step has no trustworthy capability footprint: ${e.show()}")
                return (1, [])
            Ok(caps) -> caps

        let granted = granted_build_kinds(manifest, name)
        let missing = rights.uncovered(granted, demanded)
        if list.length(missing) > 0:
            console.print("`${name}` build step demands build capabilities you have not granted: ${list.join(missing, ", ")}")
            console.print("  add them to [build.grants.\"${name}\"] (read/exec/env/net).")
            (1, [])
        else:
            exec_build_step(console, runner, root, bin, dir, name, depdir, manifest)

// Generate (or reuse cached) source, audit it, and return its `--dep` flags.
pub fn exec_build_step(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, name: String, depdir: String, manifest: String) -> (Int, List(String)):
    let gendir = join_path(join_path(dir, "build-out"), name)
    let buildfile = join_path(join_path(depdir, "src"), "build.witchy")
    let key = build_cache_key(root, dir, manifest, name, root.read(buildfile))
    if !cache_hit(root, gendir, key):
        let argv = flatten_argv(["build-step", buildfile, "--out", gendir], grant_flags(manifest, name, dir))
        let result = exec.run_args(runner, bin, "witchy", argv)
        if result.0 != 0:
            console.print("`${name}` build step failed:")
            console.print(result.1)
            return (1, [])
        root.write(join_path(gendir, ".witchy-build-cache"), key)
    audit_then_flags(console, root, dir, name, depdir, gendir)

// Post-generation audit (the smuggle gate): the dependency's footprint over its
// shipped source PLUS the generated source must not widen beyond what it shipped.
// Generated code cannot introduce authority the version was not accepted with.
pub fn audit_then_flags(console: Console, root: Dir, dir: String, name: String, depdir: String, gendir: String) -> (Int, List(String)):
    let shipped = match rune_footprint(root, depdir):
        Err(e) ->
            console.print("`${name}` has no trustworthy shipped capability footprint: ${e.show()}")
            return (1, [])
        Ok(caps) -> caps

    let owner = match dependency_owner(root, dir, name, depdir):
        Err(e) ->
            console.print(e.show())
            return (1, [])
        Ok(value) -> value

    var generated = []
    var flags = []
    for f in root.subtree(gendir).list():
        if f.ends_with(".witchy"):
            let path = join_path(gendir, f)
            let caps = match footprint_values(compiler.footprint(root.read(path)), "total"):
                Err(e) ->
                    console.print("`${name}` generated `${path}` without a trustworthy capability footprint: ${e.show()}")
                    return (1, [])
                Ok(values) -> values

            for c in caps:
                generated = add_unique(generated, c)
            let module = module_stem(f)
            flags = dep_flag_owned(flags, module, path, owner.0, owner.1, owner.2, module)
    let widened = rights.uncovered(shipped, generated)
    if list.length(widened) > 0:
        console.print("`${name}`'s build step generated source that WIDENS its footprint (+ ${list.join(widened, ", ")}) beyond the locked baseline — refusing. Generated code is still code; it cannot smuggle in authority the version was not accepted with.")
        (1, [])
    else:
        (0, flags)

// A deterministic build step is a function of its build source AND the inputs
// it reads. BUG-082: keying the cache on the build source alone would serve stale
// output when a granted read INPUT (not the build.witchy) changes. Key on the build
// source, the recursive contents of every granted `--read` input, and the grant
// surface (env keys / exec tools) — so any input change invalidates the cache. (The
// compiler confines the step; env/exec VALUE non-determinism stays out of scope.)
// idiom-exempt: concatenation below defines the cache-key byte format.
pub fn build_cache_key(root: Dir, dir: String, manifest: String, name: String, build_src: String) -> String:
    var material = "build-src\n" + build_src
    let section = "build.grants.\"${name}\""
    for p in toml.get_array(manifest, section + ".read"):
        material = material + "\nread " + p + "=" + read_input_digest(root, normalize_path(join_path(dir, p)))
    for k in toml.get_array(manifest, section + ".env"):
        material = material + "\nenv " + k
    for t in build_exec_programs(manifest, section):
        material = material + "\nexec " + t
    for p in build_exec_child_paths(manifest, section):
        material = material + "\nexec-child " + p
    "witchy-build-cache-v2:" + crypto.sha256(material)

// The content digest of a granted read input — a single file, or (a read grant is a
// directory root) the recursive contents of a directory. Absent inputs hash to a
// stable sentinel so a later-appearing input still flips the key.
pub fn read_input_digest(root: Dir, path: String) -> String:
    if !root.exists(path):
        "(absent)"
    else if root.is_dir(path):
        var material = ""
        for rel, contents in fs.collect_files(root, path, "", ""):
            material = material + rel + "=" + crypto.sha256(contents) + "\n"
        crypto.sha256(material)
    else:
        crypto.sha256(root.read(path))

pub fn cache_hit(root: Dir, gendir: String, key: String) -> Bool:
    let keyfile = join_path(gendir, ".witchy-build-cache")
    root.exists(keyfile) && root.read(keyfile) == key

// --- audit: the footprint a single file demands -----------------------------
pub fn report_check(console: Console, undeclared: List(String), unused: List(String)) -> Int:
    if !list.join(undeclared, ", ").is_empty():
        console.print("BLOCK: code demands authority not admitted by [capabilities]: ${list.join(undeclared, ", ")}")
        2
    else:
        if !list.join(unused, ", ").is_empty():
            console.print("OK (lint): declared but unused: ${list.join(unused, ", ")}")
        else:
            console.print("OK: declared footprint admits the code, nothing unused")
        0

// --- guard: block an upgrade that widens authority --------------------------
pub fn tree_children(console: Console, root: Dir, dir: String, indent: String, seen: List(String)):
    if root.exists(join_path(dir, "witchy.toml")):
        for name, inline in toml.table(root.read(join_path(dir, "witchy.toml")), "dependencies"):
            console.print("${indent}${name} (${dep_source(inline)})")
            if let Some(rel) = toml.inline_get(inline, "path"):
                if !seen.contains(name):
                    var next_seen = seen
                    next_seen.push(name)
                    tree_children(console, root, normalize_path(join_path(dir, rel)), "${indent}  ", next_seen)

// vendor <dir> — materialize path dependencies' sources into <dir>/vendor/<name>
// for offline, auditable builds. Copies each dep's src/*.witchy and manifest.
// Vendor the path-dependency closure rooted at `base` into `vendor/<name>`, walking
// each dep's own manifest recursively. Threads a visited set (import aliases already
// vendored) and a running file count.
pub fn vendor_closure(root: Dir, base: String, vendor: String, seen: List(String), count: Int) -> (List(String), Int):
    var visited = seen
    var total = count
    if root.exists(join_path(base, "witchy.toml")):
        for name, inline in toml.table(root.read(join_path(base, "witchy.toml")), "dependencies"):
            if let Some(rel) = toml.inline_get(inline, "path"):
                if !visited.contains(name):
                    visited.push(name)
                    let dep_dir = normalize_path(join_path(base, rel))
                    total = total + vendor_one(root, dep_dir, vendor, name)
                    let (v2, c2) = vendor_closure(root, dep_dir, vendor, visited, total)
                    visited = v2
                    total = c2
    (visited, total)

// Copy one dependency's `src/**/*.witchy` (+ its manifest) into `vendor/<name>`,
// returning the number of source files written.
pub fn vendor_one(root: Dir, dep_dir: String, vendor: String, name: String) -> Int:
    let dest = join_path(vendor, name)
    if !root.exists(dest):
        root.make_dir(dest)
    if !root.exists(join_path(dest, "src")):
        root.make_dir(join_path(dest, "src"))
    var count = 0
    for relpath, contents in fs.collect_files(root, join_path(dep_dir, "src"), "src", ".witchy"):
        fs.ensure_dir(root, join_path(dest, fs.parent_dir(relpath) ?? ""))
        root.write(join_path(dest, relpath), contents)
        count = count + 1
    if root.exists(join_path(dep_dir, "witchy.toml")):
        root.write(join_path(dest, "witchy.toml"), root.read(join_path(dep_dir, "witchy.toml")))
    count

// publish <dir> [host:port] [identity] — stage a rune to a coven registry. Reads
// the manifest + full src tree, builds the coven publish envelope, and POSTs it.
// The server recomputes the footprint and refuses an under-declared rune; a
// published version lands STAGED (not resolvable until a separate `promote`).
// (RFC-0095) The artifact manifest a publisher ships beside witchy.toml, or None
// for a source-only rune. It is uploaded verbatim; coven validates and freezes it.
pub fn read_optional_artifact(root: Dir, dir: String) -> Option(String):
    let path = join_path(dir, "artifact.json")
    if root.exists(path):
        Some(root.read(path))
    else:
        None

// The wire envelope POST once the manifest has been validated. Split out of
// `cmd_publish` so its `else` arm stays shallow (the WASM codegen recurses per
// nesting level).
pub fn publish_checked(console: Console, net: Net, root: Dir, dir: String, manifest: String, origin: String, identity: String, env: Env) -> Int:
    let files = publish_files(root, dir, manifest)
    let token = id_token_from_env(env)
    // (RFC-0095) An application release ships an `artifact.json` manifest beside
    // its witchy.toml (a target -> trusted-publisher map). Attach it if present; a
    // source-only rune omits it and the record stays coven-v1.
    let artifact = read_optional_artifact(root, dir)
    let resp = registry_post(net, origin, "/coven/publish", coven_proto.publish_body(manifest, files, identity, token, artifact))
    let status = http.status(resp)
    let response_body = http.body(resp)
    let error = resp_field(response_body, "error")
    let detail = if error.is_empty(): "" else: " error=${error}"
    console.print("publish: ${status} state=${resp_field(response_body, "state")}${detail}")
    if status >= 200 && status < 300:
        upload_artifacts(console, net, root, dir, manifest, origin, artifact)
    else:
        1

// (RFC-0095) After an application release publishes, upload each built trusted-publisher
// in `<dir>/artifacts/` (one file per target, filename = target triple). The server
// re-hashes each against the signed manifest, so a wrong/corrupt file is refused.
// Source-only runes (no artifact manifest) have nothing to upload.
pub fn upload_artifacts(console: Console, net: Net, root: Dir, dir: String, manifest: String, origin: String, artifact: Option(String)) -> Int:
    match artifact:
        None -> 0
        Some(_m) -> upload_artifact_dir(console, net, root, dir, manifest, origin)

pub fn upload_artifact_dir(console: Console, net: Net, root: Dir, dir: String, manifest: String, origin: String) -> Int:
    let art_dir = join_path(dir, "artifacts")
    if !root.exists(art_dir):
        0
    else:
        let name = field(manifest, "rune.name")
        let version = field(manifest, "rune.version")
        var failed = 0
        for target in root.subtree(art_dir).list():
            let data = root.read_bytes(join_path(art_dir, target))
            let resp = upload_artifact_chunked(net, origin, name, version, target, data)
            let st = http.status(resp)
            if st >= 200 && st < 300:
                console.print("  artifact ${target}: ${st}")
            else:
                console.print("  artifact ${target}: ${st} error=${resp_field(http.body(resp), "error")}")
                failed = 1
        failed

// (RFC-0095) Upload one target's bytes in BYTE ranges: each chunk's bytes are
// base64-ed on their own (never the whole blob — that would exceed the runtime's
// string limits) and POSTed under the net recv cap. Returns the finalize response
// (or the first failing chunk's). A single-chunk artifact posts seq=0,last=true.
pub fn upload_artifact_chunked(net: Net, origin: String, name: String, version: String, target: String, data: Bytes) -> Response:
    let chunk = 6291456
    let total = bytes.length(data)
    let n = if total <= chunk: 1 else: (total + chunk - 1) / chunk
    upload_chunk_seq(net, origin, name, version, target, data, chunk, total, n, 0)

pub fn upload_chunk_seq(net: Net, origin: String, name: String, version: String, target: String, data: Bytes, chunk: Int, total: Int, n: Int, i: Int) -> Response:
    let off = i * chunk
    let end = if off + chunk > total: total else: off + chunk
    let piece = encoding.base64_encode_bytes(bytes.slice(data, off, end))
    let last = i >= n - 1
    let resp = registry_post(net, origin, "/coven/artifact/bytes?name=${wire(name)}&version=${version}&target=${target}&seq=${i}&last=${last}", piece)
    if last || http.status(resp) < 200 || http.status(resp) >= 300:
        resp
    else:
        upload_chunk_seq(net, origin, name, version, target, data, chunk, total, n, i + 1)

// The trusted-publishing identity token from COVEN_ID_TOKEN (a compact OIDC JWT), passed
// through opaquely; None when unset (an anonymous `uploaded_by` publish). This is the
// trusted-publishing CLIENT flow: the server verifies the token against its per-namespace
// trust policy.
pub fn id_token_from_env(env: Env) -> Option(String):
    env.get_env("COVEN_ID_TOKEN")

// The coven registry address: the explicit arg if given, else `COVEN_URL` from
// the environment (the Rust CLI's convention), else the default. The scheme is
// PRESERVED — `https://coven.example` stays an https origin; a bare `host:port`
// keeps meaning http (loopback compat). The bootstrap auto-grants Net to
// `COVEN_URL` so no explicit `--net` is needed.
pub fn coven_addr(env: Env, arg_addr: String) -> String:
    if !arg_addr.is_empty():
        arg_addr
    else:
        match env.get_env("COVEN_URL"):
            Some(u) -> u
            None -> "127.0.0.1:8787"

// promote <name> <version> [host:port] [identity] — release a staged version.
// Trusted registries require COVEN_ID_TOKEN to carry an IdP-attested MFA/WebAuthn
// `amr`; the body marker below is only confirmation for anonymous local mode.
pub fn report_dep_version(console: Console, net: Net, origin: String, pair: (String, String)):
    let (name, inline) = pair
    if let Some(req) = toml.dep_requirement(inline):
        let resp = registry_get(net, origin, "/coven/versions?name=${wire(name)}")
        console.print("${name}: req ${req}, ${latest_label(http.body(resp), http.status(resp))}")

// yank <name> <version> [host:port] — flag a released version (re-signs the
// record as yanked); existing locks still resolve it, new resolutions skip it.
pub fn print_versions(console: Console, name: String, body: String) -> Int:
    var any = false
    for rec in version_records(body):
        any = true
        console.print("${name}@${jget(rec, "version")} ${jget(rec, "state")}")
    if !any:
        console.print("${name}: no versions")
    0

// The manifest plus every `src/**/*.witchy`, as (path, contents) — the source
// tree the registry content-addresses and footprints.
pub fn publish_files(root: Dir, dir: String, manifest: String) -> List((String, String)):
    var out = [("witchy.toml", manifest)]
    for f in fs.collect_files(root, join_path(dir, "src"), "src", ".witchy"):
        out.push(f)
    out

// why <dir> <name> — explain a dependency's presence in the rune. BUG-134: reports
// a transitive dependency too, tracing the path from the root to it (`app -> lib ->
// name`), not only a direct match.
// The dependency path from `dir` down to `target` (import names joined by ` -> `),
// or None if `target` is not reachable through the path-dependency closure.
pub fn why_path(root: Dir, dir: String, target: String, seen: List(String)) -> Option(String):
    var found = None
    if root.exists(join_path(dir, "witchy.toml")):
        for name, inline in toml.table(root.read(join_path(dir, "witchy.toml")), "dependencies"):
            if found.is_none():
                if name == target:
                    found = Some(name)
                else:
                    if let Some(rel) = toml.inline_get(inline, "path"):
                        if !seen.contains(name):
                            var next_seen = seen
                            next_seen.push(name)
                            if let Some(sub) = why_path(root, normalize_path(join_path(dir, rel)), target, next_seen):
                                found = Some("${name} -> ${sub}")
    found

// why-cap <dir> <Cap> — which dependencies introduce a capability into the tree.
// The transitive path-dependency closure of the rune at `dir`, as (import-name,
// resolved-dir) pairs. Walks each dependency's own manifest, deduplicated by import
// name so a diamond/cycle terminates. Resolved dirs are relative to the project Dir.
pub fn path_closure(root: Dir, dir: String) -> List((String, String)):
    path_closure_rec(root, dir, [])

pub fn path_closure_rec(root: Dir, base: String, acc: List((String, String))) -> List((String, String)):
    var out = acc
    if root.exists(join_path(base, "witchy.toml")):
        for name, inline in toml.table(root.read(join_path(base, "witchy.toml")), "dependencies"):
            if let Some(rel) = toml.inline_get(inline, "path"):
                if !closure_has(out, name):
                    let dep_dir = normalize_path(join_path(base, rel))
                    out.push((name, dep_dir))
                    out = path_closure_rec(root, dep_dir, out)
    out

// Validate every dependency BEFORE `pm lock` turns it into lock evidence, returning
// a `BLOCK:` diagnostic per offending dependency (empty = OK to lock):
//   * a registry (non-path) dependency cannot be locked by `pm lock` — it is
//     resolved and pinned by `pm add` (BUG-194: no unresolved `source = "coven"`
//     placeholder written as success);
//   * a path dependency whose manifest omits `rune.version` (BUG-192: no `(none)`
//     sentinel serialized as a version);
//   * a path dependency whose declared key disagrees with the dependency's own
//     `rune.name` identity (BUG-193: the manifest is the identity, not the key).
pub fn lock_problems(root: Dir, dir: String, manifest: String) -> List(String):
    var out = []
    for name, inline in toml.table(manifest, "dependencies"):
        match toml.inline_get(inline, "path"):
            None ->
                out.push("BLOCK: `${name}` is a registry dependency — `grimoire lock` locks path dependencies only; run `grimoire add ${name}` to resolve and pin it")
            Some(rel) ->
                let dep_toml = join_path(normalize_path(join_path(dir, rel)), "witchy.toml")
                if !root.exists(dep_toml):
                    out.push("BLOCK: path dependency `${name}` has no witchy.toml at ${rel}")
                else:
                    let dep_manifest = root.read(dep_toml)
                    out = check_path_identity(out, name, rel, dep_manifest)
    out

// --- verify: offline lock/signature/provenance verification ------------------
// The default command is deliberately network-independent: it applies the same
// complete lock-integrity gate as build/run. `--online` adds a second TUF
// freshness/rollback phase against the configured registry; it never substitutes
// for the offline source + signed-record checks.
// --- TUF chain verification (client side) ------------------------------------
// `add` pins the registry's TUF snapshot version into the lock; `verify --online` re-fetches
// the signed snapshot + timestamp roles and re-checks the whole chain against the
// registry root key, refusing a tampered role or a rollback. The registry only
// PRODUCES these roles (coven_meta); the front-end is the verifier. Checks (the
// signature, content-binding, version-match, rollback, AND freshness/`expires`
// links are all enforced — the front-end holds a Clock, so the previously-omitted
// expiry check now runs):
//   1. timestamp signed by the root key
//   2. snapshot signed by the root key
//   3. sha256(canonical(snapshot)) == timestamp.snapshot_hash   (content binding)
//   4. snapshot.version == timestamp.snapshot_version           (role agreement)
//   5. snapshot.version >= the version pinned in witchy.lock    (no rollback)
//   6. each vendored registry dep's record digest is the snapshot's target digest
pub fn verify_tuf(console: Console, net: Net, root: Dir, env: Env, clock: Clock, dir: String, lock: String) -> Int:
    match pinned_registry_trust(lock):
        // BUG-204/572: malformed or incomplete trust state is a lockfile
        // diagnostic, never an internal trap or a downgrade to unpinned trust.
        Err(e) ->
            console.print("BLOCK: ${e.show()}")
            2
        // No registry deps were added, so there is no registry trust state to verify.
        Ok(None) -> 0
        Ok(Some(trust)) ->
            let pinned = trust.0
            let pinned_pub = trust.1
            match parse_origin(coven_addr(env, "")):
                Err(m) ->
                    console.print("invalid registry address: ${m}")
                    2
                Ok(shp) ->
                    let (scheme, host, port) = shp
                    let origin = registry_origin(scheme, host, port)
                    verify_chain(console, net, root, dir, origin, pinned, pinned_pub, clock)

pub fn verify_chain(console: Console, net: Net, root: Dir, dir: String, origin: String, pinned: Int, pinned_pub: String, clock: Clock) -> Int:
    match fetch_registry_rootpub(net, origin):
        Err(e) ->
            console.print("FAIL: TUF chain — ${e.show()}")
            2
        Ok(rootpub) ->
            // SEC-002: the root key is the trust anchor for the whole chain. Refuse
            // one different from the complete trust record in witchy.lock.
            if pinned_pub != rootpub:
                console.print("FAIL: TUF chain — registry root key does not match the key pinned in witchy.lock (possible MITM / hostile mirror)")
                2
            else:
                let snap_resp = registry_get(net, origin, "/coven/snapshot")
                let ts_resp = registry_get(net, origin, "/coven/timestamp")
                if http.status(snap_resp) != 200 || http.status(ts_resp) != 200:
                    console.print("FAIL: TUF chain — registry served no snapshot/timestamp role")
                    2
                else:
                    check_chain(console, root, dir, rootpub, http.body(snap_resp), http.body(ts_resp), pinned, clock)

pub fn check_chain(console: Console, root: Dir, dir: String, rootpub: String, snap_env: String, ts_env: String, pinned: Int, clock: Clock) -> Int:
    let snap_signed = signed_canonical(snap_env)
    let ts_signed = signed_canonical(ts_env)
    if !signed_valid(rootpub, ts_env):
        console.print("FAIL: TUF chain — the timestamp role is not validly signed by the registry root key (tampered)")
        2
    else if !signed_valid(rootpub, snap_env):
        console.print("FAIL: TUF chain — the snapshot role is not validly signed by the registry root key (tampered)")
        2
    else if !snapshot_schema_ok(snap_env):
        // BUG-386: a role can be validly signed yet structurally incomplete. Reject a
        // snapshot missing an integer `version` or an object `targets` BEFORE the
        // version/rollback comparisons, so a missing field can't default to 0 and
        // compare equal to a pinned 0 (nor pass with an empty vendor tree).
        console.print("FAIL: TUF chain — the snapshot role is structurally malformed (needs an integer `version` and an object `targets`) — refusing")
        2
    else if !timestamp_schema_ok(ts_env):
        console.print("FAIL: TUF chain — the timestamp role is structurally malformed (needs an integer `snapshot_version`, a string `snapshot_hash`, and an integer `expires`) — refusing")
        2
    else if "sha256:${crypto.sha256(snap_signed)}" != signed_field_str(ts_env, "snapshot_hash"):
        console.print("FAIL: TUF chain — the snapshot does not match the timestamp's pinned hash (tampered)")
        2
    else if signed_field_int(snap_env, "version") != signed_field_int(ts_env, "snapshot_version"):
        console.print("FAIL: TUF chain — snapshot and timestamp disagree on the snapshot version (tampered)")
        2
    else if signed_field_int(snap_env, "version") < pinned:
        console.print("FAIL: TUF chain — the registry's snapshot version ${signed_field_int(snap_env, "version")} is older than the pinned ${pinned}: the metadata has been rolled back")
        2
    else if signed_field_int(ts_env, "expires") < clock.now() / 1000:
        // SEC-017: TUF freshness — refuse a stale-but-validly-signed timestamp (a freeze /
        // replay of old metadata up to the pinned floor). coven sets `expires` 24h out; the
        // front-end holds a Clock, so the check that was previously omitted now runs.
        console.print("FAIL: TUF chain — the registry timestamp role expired at ${signed_field_int(ts_env, "expires")} (now ${clock.now() / 1000}): stale metadata (freeze/replay)")
        2
    else:
        check_targets(console, root, dir, snap_env)

// Every vendored registry dep's signed-record digest must equal the snapshot's
// target digest for its `name@version` — a dep whose record was swapped out from
// under the snapshot is rejected.
pub fn check_targets(console: Console, root: Dir, dir: String, snap_env: String) -> Int:
    let targets = signed_field(snap_env, "targets")
    var bad = []
    for entry in vendored_runes(root, dir):
        let coven = root.read(join_path(entry, "coven.json"))
        // BUG-275: a vendored record that exists but does not parse cannot be
        // compared to the snapshot target — fail closed, don't silently skip it.
        match json.decode(coven):
            Ok(doc) ->
                let key = "${jget(doc, "name")}@${jget(doc, "version")}"
                let want = target_digest(targets, key)
                match record_payload(doc):
                    Some(payload) ->
                        let have = "sha256:${crypto.sha256(payload)}"
                        if want != have:
                            bad.push(key)
                    None ->
                        bad.push("${key} (malformed coven.json)")
            Err(_e) ->
                bad.push("${entry} (unparseable coven.json)")
    if list.length(bad) == 0:
        console.print("OK: TUF chain verified (snapshot + timestamp signatures, content binding, no rollback)")
        0
    else:
        console.print("FAIL: TUF chain — vendored record digest does not match the snapshot target for: ${list.join(bad, ", ")}")
        2

// The vendored rune directories (those carrying a coven.json) under <dir>/vendor.
pub fn vendored_runes(root: Dir, dir: String) -> List(String):
    var out = []
    let vendor = join_path(dir, "vendor")
    if root.exists(vendor):
        for entry in root.subtree(vendor).list():
            let rune_dir = join_path(vendor, entry)
            if root.exists(join_path(rune_dir, "coven.json")):
                out.push(rune_dir)
    out

// The pinned registry root for network trust checks. A project with no lock or a
// path-only lock is unpinned; any partial/malformed registry trust record is Err.
pub fn pinned_registry_rootpub(root: Dir) -> Result(String, LockPinError):
    if !root.exists("witchy.lock"):
        Ok("")
    else:
        match pinned_registry_trust(root.read("witchy.lock")):
            Err(e) -> Err(e)
            Ok(None) -> Ok("")
            Ok(Some(trust)) -> Ok(trust.1)

// The path-dependency names whose recomputed hash differs from the lockfile's.
// BUG-047/135: walks the full transitive path-dep closure, not just the direct
// manifest entries — a tampered (or unpinned) transitive dep is caught too. A
// closure member absent from the lock recomputes to a hash that can't match the
// "(absent)" sentinel, so it is reported.
pub fn hash_mismatches(root: Dir, dir: String, lock: String) -> Result(List(String), LockIntegrityError):
    var bad = []
    for name, dep_dir in path_closure(root, dir):
        if rune_hash(root, dep_dir) != locked_hash(lock, name)?:
            bad.push(name)
    Ok(bad)

// RFC-0120: the staged (unreleased) pins a lockfile records — each a `[[rune]]`
// carrying `staged = "true"`, written when it was accepted via `--allow-staged`.
// Returned as (name, version) so callers can warn or refuse. A malformed lock
// yields no pins (the integrity commands report that fault separately).
pub fn staged_lock_pins(root: Dir, lock_rel: String) -> List((String, String)):
    var out = []
    if root.exists(lock_rel):
        match lock_rune_entries(root.read(lock_rel)):
            Err(_e) -> Nil
            Ok(entries) ->
                for entry in entries:
                    if optional_lock_string(entry, "staged", "") == "true":
                        out.push((optional_lock_string(entry, "name", "?"), optional_lock_string(entry, "version", "?")))
    out

// Warn (loudly, on every lock-consuming command) about each staged pin. A staged
// pin is a standing property of the project, so the reminder is repeated and never
// becomes invisible.
pub fn warn_staged_lock_pins(console: Console, root: Dir):
    for name, version in staged_lock_pins(root, "witchy.lock"):
        console.print("! using STAGED ${name}@${version} (unreleased; accepted via --allow-staged)")

// Staged pins from a lock rendered as `name@version` labels, for a refusal message.
pub fn staged_pin_labels(root: Dir, lock_rel: String) -> List(String):
    staged_lock_pins(root, lock_rel).map(fn(pin: (String, String)): "${pin.0}@${pin.1}")

// --- gate: block any dependency that demands new authority -------------------
// The supply-chain gate (§10), rights-aware. It recomputes the footprint the
// dependency sources actually demand and blocks any capability the lockfile's
// recorded baseline doesn't already admit — the upgrade/tamper that quietly
// widens authority. Capabilities listed after <dir> are accepted (like
// `--allow-cap`), folding into the baseline so an intended widening passes.
pub fn report_gate(console: Console, root: Dir, dir: String, widened: List(String)) -> Int:
    if list.length(widened) == 0:
        console.print("OK: dependencies demand no authority beyond witchy.lock")
        0
    else:
        console.print("BLOCK: dependencies demand new authority: ${list.join(widened, ", ")}")
        for cap in widened:
            match gate_contributors(root, dir, cap):
                Ok(who) -> console.print("  ${cap} <- ${list.join(who, ", ")}")
                Err(e) -> console.print("  ${cap} <- inspection error: ${e.show()}")

        2

// The aggregate authority the current dependency sources demand. BUG-080: the whole
// transitive path-dep closure (not just direct entries), each dep's footprint being
// the union over ALL its src modules (rune_footprint, BUG-085) — matching coven's
// computed_footprint, so the local gate can't miss a capability a transitive dep or
// a non-entry module reaches for.
pub fn resolution_footprint(root: Dir, dir: String) -> Result(List(String), FootprintError):
    var out = []
    for _name, dep_dir in path_closure(root, dir):
        let caps = rune_footprint(root, dep_dir)?
        for cap in caps:
            out = add_unique(out, cap)
    Ok(out)

// The dependencies whose own footprint covers `cap` — who introduced it. Walks the
// transitive closure (BUG-080/134), so `why-cap` names a deep contributor too.
pub fn gate_contributors(root: Dir, dir: String, cap: String) -> Result(List(String), FootprintError):
    var who = []
    for name, dep_dir in path_closure(root, dir):
        let caps = rune_footprint(root, dep_dir)?
        if rights.any_covers(caps, cap):
            who.push(name)
    Ok(who)

// The canonical lockfile text for a rune: a `[[rune]]` block per dependency,
// pinning its resolved version, source, content hash, and runtime footprint.
// BUG-047/101/135: pins the FULL transitive path-dependency closure — a diamond
// (`app -> {a,b} -> base`) locks `base` once, not never. Direct registry deps get
// an informational placeholder (pm lock is path-only; `lock_problems` blocks them
// before this runs, but the marker is kept for completeness).
// idiom-exempt: concatenation in this section is canonical lockfile serialization.
pub fn generate_lock(root: Dir, dir: String) -> Result(String, FootprintError):
    let manifest = root.read(join_path(dir, "witchy.toml"))
    var out = "# witchy.lock — generated by `grimoire lock`. Pins every dependency by content\n# hash. Regenerate with `grimoire lock`; verify with `grimoire verify`. Do not edit by hand.\n"
    for name, inline in toml.table(manifest, "dependencies"):
        if toml.inline_get(inline, "path").is_none():
            out = out + registry_placeholder(name)
    for name, dep_dir in path_closure(root, dir):
        let entry = closure_path_entry(root, name, dep_dir)?
        out = out + entry
    Ok(out)

// A `[[rune]]` block for a resolved path-closure member. `dep_dir` is the resolved
// directory (relative to the project); the `source` records it so the entry is
// self-describing. `hash`/`runtime_footprint` are recomputed from the dep's source.
pub fn closure_path_entry(root: Dir, name: String, dep_dir: String) -> Result(String, FootprintError):
    let dep_manifest = root.read(join_path(dep_dir, "witchy.toml"))
    let version = field(dep_manifest, "rune.version")
    let hash = rune_hash(root, dep_dir)
    let caps = rune_footprint(root, dep_dir)?
    let fp = footprint_toml(caps)
    Ok("\n[[rune]]\nname = \"" + name + "\"\nversion = \"" + version + "\"\nsource = \"path:" + dep_dir + "\"\nhash = \"" + hash + "\"\nruntime_footprint = [" + fp + "]\n")

// The rune's content address: the canonical hash over `witchy.toml` plus every
// `src/**/*.witchy` (recursively), matching coven's store byte-for-byte (so a
// witchy-checked lock agrees with a coven-generated one).
pub fn rune_hash(root: Dir, dir: String) -> String:
    var files = [("witchy.toml", root.read(join_path(dir, "witchy.toml")))]
    for f in fs.collect_files(root, join_path(dir, "src"), "src", ".witchy"):
        files.push(f)
    content_hash(files)

// --- update: re-resolve vendored deps to the latest released version ---------
// `update [name]` walks the project's `vendor/` tree (each vendored rune carries
// its signed `coven.json`, naming the full `ns/name` and pinned version), queries
// the registry for the latest released version of each, and re-fetches the ones
// that moved (verifying signature + hash), then regenerates `witchy.lock`. With a
// `name` argument only that rune is updated; the others stay pinned at their
// vendored version. Run from a project directory (cwd is the project Dir).
pub fn update_vendored(console: Console, net: Net, root: Dir, origin: String, only: String, allowed: List(String), cooldown: (Int, Int, Bool), manifest: String) -> Int:
    var changed = 0
    var blocked = false
    var failed = false
    for entry in root.subtree("vendor").list():
        if only.is_empty() || entry == only:
            let outcome = update_one(console, net, root, origin, entry, allowed, cooldown, manifest)
            changed = changed + outcome.0
            if outcome.1:
                blocked = true
            if outcome.2:
                failed = true
    if blocked:
        // Leave the vendored tree + lock untouched: a widening upgrade is the
        // supply-chain attack the gate exists to stop.
        2
    else if failed:
        // BUG-371/569: a resolution, refetch, or verification failed. Do NOT repin
        // the registry root key or rewrite the lock as if the update succeeded — a
        // partial/failed update must not mint fresh trust metadata.
        console.print("BLOCK: an update failed to resolve, fetch, or verify — leaving witchy.lock and the pinned registry key untouched")
        1
    else:
        // SEC-048: before repinning, re-gate the FULL re-resolved closure now on
        // disk against the project's previously accepted baseline (its declared caps
        // ∪ the lock's recorded footprints, still the OLD lock at this point) ∪ the
        // caps consented to with `--allow-cap`. `update` re-resolves the WHOLE closure,
        // so a moved rune — or a NEW transitive dependency a moved rune pulled in —
        // can widen authority even when every single-rune record gate passed (a
        // record's footprint is single-rune). Any widening not consented BLOCKS,
        // leaving `witchy.lock` and the pinned registry key untouched. Gating here (at
        // the commit point, not per-rune) also closes the re-run hole: a prior blocked
        // update leaves the tree mutated, and a later no-op `update` must not silently
        // repin that widened tree.
        match update_closure_gate(console, root, allowed):
            Some(code) -> code
            None ->
                match lock_trust_pins(net, root, origin):
                    Err(e) ->
                        console.print("BLOCK: cannot pin registry metadata — ${e.show()}")
                        2
                    Ok(pins) ->
                        match vendor_lock(root, pins):
                            Err(e) ->
                                console.print("BLOCK: cannot regenerate witchy.lock — ${e.show()}")
                                2
                            Ok(lock) ->
                                root.write("witchy.lock", lock)
                                console.print("updated ${changed} dependencies -> witchy.lock")
                                0

// SEC-048: the widening gate `update` applies to the whole re-resolved vendored
// closure before repinning the lock. `Some(code)` BLOCKS the update (leaving the lock
// + pinned key untouched); `None` is a clean closure that may proceed to repin. The
// baseline is the project's previously accepted authority (declared caps ∪ the OLD
// lock's recorded footprints) ∪ the caps consented to with `--allow-cap` — the same
// baseline `add` diffs a new dependency against.
pub fn update_closure_gate(console: Console, root: Dir, allowed: List(String)) -> Option(Int):
    match project_baseline(root):
        Err(e) ->
            console.print("BLOCK: cannot read witchy.lock to re-gate the updated dependency closure — ${e.show()}")
            Some(2)
        Ok(recorded) ->
            match closure_widening(root, union_all(recorded, allowed)):
                Err(e) ->
                    console.print("BLOCK: an updated dependency has no trustworthy capability footprint: ${e.show()}")
                    Some(2)
                Ok(widened) ->
                    if list.length(widened) > 0:
                        console.print("BLOCK: this update would widen your project's capability footprint through its dependency closure: ${list.join(widened, ", ")}")
                        console.print("  re-run with --allow-cap ${list.join(widened, " --allow-cap ")} to consent to the whole updated dependency tree")
                        Some(2)
                    else:
                        None

// Re-fetch one vendored rune if the registry has a newer eligible version than the
// one currently vendored. Returns (changed, blocked, failed): `changed` is 1 if it
// moved, `blocked` is true if the newer version WIDENS authority beyond the baseline
// (the gate), `failed` is true if resolution, fetch, or verification failed. The
// target version is resolved WITHIN the consumer's declared requirement (BUG-092)
// and past the staging cooldown (BUG-090).
pub fn update_one(console: Console, net: Net, root: Dir, origin: String, entry: String, allowed: List(String), cooldown: (Int, Int, Bool), manifest: String) -> (Int, Bool, Bool):
    let rune_dir = join_path("vendor", entry)
    if !root.exists(join_path(rune_dir, "coven.json")):
        (0, false, false)
    else:
        let vendored = match parse_vendored_record(root.read(join_path(rune_dir, "coven.json"))):
            Err(e) ->
                console.print("BLOCK: cannot update `${entry}` — ${e.show()}")
                return (0, false, true)
            Ok(record) -> record

        let fullname = vendored.name
        let current = vendored.version
        let req = dep_req(manifest, fullname, entry)
        match resolve_version(net, origin, fullname, req, cooldown):
            // Cooling and no-match mean there is no eligible update today. Every
            // other resolver error means the registry/manifest could not be
            // trusted, so preserve the lock and report a failed update (BUG-569).
            Err(VersionCooling(_req, _secs)) -> (0, false, false)
            Err(VersionNoMatch(_req)) -> (0, false, false)
            Err(e) ->
                console.print("BLOCK: cannot resolve an update for ${fullname}: ${e.show()}")
                (0, false, true)
            Ok(latest) ->
                if latest.is_empty() || latest == current:
                    (0, false, false)
                else:
                    gated_refetch(console, net, root, origin, fullname, current, latest, vendored.runtime_footprint, allowed, cooldown)

// The capability gate: compare the incoming version's declared footprint (from its
// signed registry record) against the vendored baseline ∪ the consented caps. Any
// capability the baseline doesn't already admit is a widening of authority — BLOCK.
// Only on a clean (non-widening) upgrade do we re-fetch.
pub fn gated_refetch(console: Console, net: Net, root: Dir, origin: String, fullname: String, current: String, latest: String, baseline_footprint: List(String), allowed: List(String), cooldown: (Int, Int, Bool)) -> (Int, Bool, Bool):
    let baseline = union_all(baseline_footprint, allowed)
    // BUG-232: the widening gate must diff against a VERIFIED footprint, not a raw
    // `/coven/record` body. A hostile mirror could otherwise serve an under-declared
    // (or wrong-coordinate) record to sneak the gate, then serve matching malicious
    // source. Verify the signed record against the pinned root key and bind its
    // coordinate before trusting its footprint; a verification failure blocks.
    match verified_incoming_footprint(net, root, origin, fullname, latest):
        Err(e) ->
            console.print("BLOCK: cannot verify the registry record for ${fullname}@${latest} — ${e.show()}")
            (0, true, false)
        Ok(incoming) ->
            let widened = rights.uncovered(baseline, incoming)
            if list.length(widened) > 0:
                console.print("BLOCK: upgrading ${fullname} ${current} -> ${latest} widens authority: ${list.join(widened, ", ")}")
                console.print("  re-run with --allow-cap ${list.join(widened, " --allow-cap ")} to consent")
                (0, true, false)
            else:
                refetch(console, net, root, origin, fullname, latest, current, cooldown, allowed)

// The runtime footprint a registry version declares, read from its signed record at
// `/coven/record` ONLY AFTER the record is verified against the registry root key
// (bound to any key pinned in the lock) and its identity is bound to the requested
// coordinate (BUG-232/266). `Err` on any failure so the gate blocks rather than
// trusting an unverified/under-declared footprint.
pub fn verified_incoming_footprint(net: Net, root: Dir, origin: String, name: String, version: String) -> Result(List(String), RecordFootprintError):
    let rootpub = fetch_registry_rootpub(net, origin)?
    let pinned_pub = pinned_registry_rootpub(root)?
    if pinned_pub != "" && pinned_pub != rootpub:
        Err(RecordRootKeyMismatch)
    else:
        let resp = registry_get(net, origin, "/coven/record?name=${wire(name)}&version=${version}")
        if http.status(resp) != 200:
            Err(RecordMissing)
        else if !record_signature_valid(rootpub, http.body(resp)):
            Err(RecordBadSignature)
        else if !record_matches_coordinate(http.body(resp), name, version):
            Err(RecordCoordinateMismatch)
        else:
            strict_footprint(http.body(resp))

// Returns (changed, blocked, failed). BUG-091: after a clean re-fetch, recurse into
// the new version's OWN dependency closure (`add_deps`), so a release that GAINED a
// transitive dependency has it fetched + vendored too — an update is not just the
// single rune. BUG-371: a failed fetch/verify (or a failed transitive fetch) reports
// `failed` so the caller does not repin registry metadata.
pub fn refetch(console: Console, net: Net, root: Dir, origin: String, fullname: String, latest: String, current: String, cooldown: (Int, Int, Bool), allowed: List(String)) -> (Int, Bool, Bool):
    let code = fetch_source(console, net, root, origin, fullname, latest, "vendor", false)
    if code != 0:
        (0, false, true)
    else if add_deps(console, net, root, origin, fullname, "vendor", cooldown, allowed) != 0:
        (0, false, true)
    else:
        console.print("updated ${fullname} ${current} -> ${latest}")
        (1, false, false)

// (RFC-0095) `pm install <pkg>[@ver] [host] --target <triple>` — install a released
// application's trusted-publisher. The FULL trust chain, reusing the same verified pieces
// `add` uses: resolve the released version, verify the signed record against the
// (pinned) registry root key, read the coven-v2 artifact_digest, fetch + digest-verify
// the manifest, select the host target, fetch the bytes and check their sha256, then
// write the executable into the project's `.witchy/bin/`. Every step fails closed.
// (Host-target auto-detection and installing into $WITCHY_HOME are Cut 4 — this slice
// takes an explicit --target and installs project-relative, inside the confined Dir.)
pub fn install_resolve(console: Console, net: Net, root: Dir, env: Env, clock: Clock, origin: String, name: String, req: String, target: String, args: List(String)) -> Int:
    match resolve_version(net, origin, name, req, cooldown_now(env, clock, args)):
        Err(e) ->
            console.print("${name}: ${e.show()}")
            1
        Ok(chosen) ->
            match install_verified_record(net, root, origin, name, chosen):
                Err(m) ->
                    console.print("BLOCK: ${m}")
                    1
                Ok(doc) -> install_artifact(console, net, root, clock, origin, name, chosen, target, doc)

// Fetch + verify the signed record against the (pinned) root key and bind its
// coordinate — the same trust `verified_incoming_footprint` enforces for `add`.
pub fn install_verified_record(net: Net, root: Dir, origin: String, name: String, version: String) -> Result(Json, String):
    let rootpub = fetch_registry_rootpub(net, origin).map_err(fn(e: RegistryRootKeyError): "${e}")?
    let pinned = pinned_registry_rootpub(root).map_err(fn(e: LockPinError): "${e}")?
    if pinned != "" && pinned != rootpub:
        Err("registry root key does not match the key pinned in witchy.lock — refusing to install")
    else:
        let resp = registry_get(net, origin, "/coven/record?name=${wire(name)}&version=${version}")
        if http.status(resp) != 200:
            Err("registry has no record for ${name}@${version}")
        else:
            match verify_record_signature(rootpub, http.body(resp)):
                Err(e) -> Err(e.show())
                Ok(doc) ->
                    if jget(doc, "name") != name || jget(doc, "version") != version:
                        Err("record coordinate mismatch — the registry served the wrong record")
                    else if jget(doc, "state") != "released":
                        Err("${name}@${version} is `${jget(doc, "state")}`, not released — refusing to install an unreleased version")
                    else:
                        Ok(doc)

pub fn install_artifact(console: Console, net: Net, root: Dir, clock: Clock, origin: String, name: String, version: String, target: String, doc: Json) -> Int:
    let digest = jget(doc, "artifact_digest")
    if digest.is_empty():
        console.print("BLOCK: ${name}@${version} is a source-only release — it ships no installable artifact")
        1
    else:
        match install_selected_entry(net, origin, name, version, digest, target):
            Err(m) ->
                console.print("BLOCK: ${m}")
                1
            Ok(entry) ->
                let (command, sha, size) = entry
                install_fetch_and_write(console, net, root, clock, origin, name, version, target, command, sha, size)

// Fetch the artifact manifest, verify its digest matches the SIGNED record, and
// select the host target's (command, sha256). A tampered manifest fails the digest.
pub fn install_selected_entry(net: Net, origin: String, name: String, version: String, digest: String, target: String) -> Result((String, String, Int), String):
    let resp = registry_get(net, origin, "/coven/artifact?name=${wire(name)}&version=${version}")
    if http.status(resp) != 200:
        Err("registry has no artifact manifest for ${name}@${version}")
    else:
        match coven_artifact.parse(http.body(resp)):
            Err(e) -> Err("artifact manifest is malformed: ${coven_artifact.artifact_error_message(e)}")
            Ok(mani) ->
                if coven_artifact.manifest_digest(mani) != digest:
                    Err("artifact manifest digest does not match the signed record (tampered mirror?)")
                else:
                    match coven_artifact.select(mani, target):
                        None -> Err("no artifact for target `${target}` (available: ${list.join(coven_artifact.targets(mani), ", ")})")
                        Some(entry) -> Ok((entry.command, entry.sha256, entry.size))

pub fn install_fetch_and_write(console: Console, net: Net, home: Dir, clock: Clock, origin: String, name: String, version: String, target: String, command: String, sha: String, size: Int) -> Int:
    // `home` is the granted $WITCHY_HOME provider; installs land in its `bin/` so an
    // added-to-PATH launcher finds them. Stream the artifact chunk by chunk straight
    // to disk (append_bytes) — a real trusted-publisher is 100+ MB and can neither traverse
    // one HTTP body nor be held whole in memory, so nothing ever accumulates the whole
    // in the guest. Then read the written file back once to verify its sha256.
    fs.ensure_dir(home, "bin")
    let binpath = join_path("bin", command)
    // Download into a fresh non-executable staging file. The live command is
    // replaced only after the complete byte stream matches the signed digest.
    // `create_new` also keeps concurrent installs from sharing a staging file.
    let staged = join_path("bin", ".${command}.install-${clock.now()}")
    if !home.create_new(staged, ""):
        console.print("BLOCK: could not create a fresh staging file for ${command}")
        return 1
    // state: 0 = downloading, 1 = complete, 2 = transport/decode error,
    //        3 = no artifact, 4 = exceeds the signed size
    var idx = 0
    var state = 0
    var written = 0
    while state == 0:
        let resp = registry_get(net, origin, "/coven/artifact/bytes?name=${wire(name)}&version=${version}&target=${target}&chunk=${idx}")
        if http.status(resp) != 200:
            state = if idx == 0: 3 else: 2
        else:
            let body = http.body(resp)
            if body.length() == 0:
                state = 1
            else:
                match encoding.base64_decode_bytes_string(body):
                    Err(_e) -> state = 2
                    Ok(piece) ->
                        // Bound the stream by the manifest's SIGNED `size` (digest-bound to
                        // the signed record) BEFORE writing, so a hostile/broken mirror that
                        // streams past the attested length cannot exhaust the disk — the
                        // sha256 check that follows only runs once the stream ends.
                        if written + bytes.length(piece) > size:
                            state = 4
                        else:
                            home.append_bytes(staged, piece)
                            written = written + bytes.length(piece)
                            idx = idx + 1
    if state == 3:
        console.print("BLOCK: registry has no artifact bytes for ${name}@${version} target `${target}`")
        1
    else if state == 2:
        console.print("BLOCK: failed to download the artifact for ${name}@${version} target `${target}`")
        1
    else if state == 4:
        console.print("BLOCK: artifact for ${name}@${version} target `${target}` streamed more than its signed ${size} bytes — refusing (tampered/hostile mirror?)")
        1
    else if crypto.sha256_bytes(home.read_bytes(staged)) != sha:
        console.print("BLOCK: fetched artifact bytes do not match the signed sha256 (tampered mirror?)")
        1
    else:
        // The verified trusted-publisher is written non-executable; flip it runnable so the
        // installed command can be launched directly from $WITCHY_HOME/bin.
        home.set_executable(staged)
        home.rename(staged, binpath)
        console.print("installed ${command} -> \$WITCHY_HOME/bin/${command}")
        0

// Whether a staged-install prompt should be auto-confirmed (RFC-0120): the
// `--yes` flag, or `PM_ASSUME_YES=1`/`true` in the environment. In CI a prompt
// must never hang, so `--allow-staged` there is paired with one of these; without
// either, an unconfirmed staged install refuses rather than blocking on stdin.
pub fn assume_yes(env: Env, args: List(String)) -> Bool:
    if has_flag(args, "--yes"):
        true
    else:
        match env.get_env("PM_ASSUME_YES"):
            Some(v) -> v == "1" || v == "true"
            None -> false

// A direct `add` is the consumer's deliberate choice to take on a dependency, so
// it is gated: if the rune — OR ANY rune in its resolved dependency closure (SEC-006) —
// introduces a capability the project does not already admit (its own declared caps ∪
// what the lock already records ∪ the caps the consumer consented to with `--allow-cap`),
// the add is BLOCKED. A registry record's footprint is single-rune, so the direct gate
// alone would miss a transitive dep's capabilities; we re-gate the whole vendored closure.
pub fn add_pkg_gated(console: Console, net: Net, root: Dir, origin: String, name: String, req: String, cooldown: (Int, Int, Bool), allowed: List(String), allow_staged: Bool, yes: Bool) -> Int:
    // RFC-0120: `--allow-staged` opts into installing an unreleased (staged) version.
    // It requires an EXACT version, prompts for confirmation, and refuses yanked. The
    // released-only default path (no flag / any range) is unchanged.
    if allow_staged:
        match resolve_staged_exact(net, origin, name, req):
            Err(e) ->
                console.print("${name}: ${e.show()}")
                1
            Ok(resolved) ->
                let (chosen, is_staged) = resolved
                if is_staged && !yes:
                    console.print("! ${name}@${chosen} is STAGED, not released — its authors have not blessed it for release.")
                    console.print("  It is immutable and signed, but may never be released, or may be yanked.")
                    console.print("  refusing to install an unreleased version without confirmation — re-run with --yes (or PM_ASSUME_YES=1) to accept it")
                    1
                else:
                    if is_staged:
                        console.print("! installing STAGED ${name}@${chosen} (unreleased, accepted via --allow-staged --yes)")
                    add_pkg_after_resolve(console, net, root, origin, name, req, chosen, cooldown, allowed, is_staged)
    else:
        match resolve_version(net, origin, name, req, cooldown):
            Err(e) ->
                console.print("${name}: ${e.show()}")
                1
            Ok(chosen) ->
                add_pkg_after_resolve(console, net, root, origin, name, req, chosen, cooldown, allowed, false)

// The capability-widening gate + finalize, shared by the released and staged
// resolution paths. BUG-232: gate on a VERIFIED, coordinate-bound record footprint.
pub fn add_pkg_after_resolve(console: Console, net: Net, root: Dir, origin: String, name: String, req: String, chosen: String, cooldown: (Int, Int, Bool), allowed: List(String), allow_staged: Bool) -> Int:
    match project_baseline(root):
        Err(e) ->
            console.print("BLOCK: cannot read witchy.lock — ${e.show()}")
            2
        Ok(recorded) ->
            let baseline = union_all(recorded, allowed)
            match verified_incoming_footprint(net, root, origin, name, chosen):
                Err(e) ->
                    console.print("BLOCK: cannot verify the registry record for ${name}@${chosen} — ${e.show()}")
                    2
                Ok(incoming) ->
                    add_pkg_gate_widen(console, net, root, origin, name, req, chosen, cooldown, baseline, rights.uncovered(baseline, incoming), allow_staged)

pub fn add_pkg_gate_widen(console: Console, net: Net, root: Dir, origin: String, name: String, req: String, chosen: String, cooldown: (Int, Int, Bool), baseline: List(String), widened: List(String), allow_staged: Bool) -> Int:
    if list.length(widened) > 0:
        console.print("BLOCKED: adding `${name}` would widen your project's capability footprint: ${list.join(widened, ", ")}")
        console.print("  re-run with --allow-cap ${list.join(widened, " --allow-cap ")} to consent")
        2
    else:
        // A staged install (RFC-0120) fetches the EXACT resolved version and permits
        // the `staged` state; a normal add re-resolves `req` against released
        // versions. Either way the dependency closure that follows is released-only —
        // `--allow-staged` opts in only the one version the user named.
        let code = if allow_staged: fetch_then_deps(console, net, root, origin, name, chosen, "vendor", cooldown, [], true) else: add_rune(console, net, root, origin, name, req, "vendor", cooldown, [])
        if code != 0:
            code
        else:
            // SEC-006: re-gate on the FULL vendored closure now on disk — a
            // transitive dep can carry a capability the direct rune's footprint
            // never showed. Blocked here, the files stay vendored but unpinned;
            // re-running with `--allow-cap` consents and completes the add.
            match closure_widening(root, baseline):
                Err(e) ->
                    console.print("BLOCKED: a dependency of `${name}` has no trustworthy capability footprint: ${e.show()}")
                    2
                Ok(closure_widened) ->
                    if list.length(closure_widened) > 0:
                        console.print("BLOCKED: a dependency of `${name}` would widen your project's capability footprint: ${list.join(closure_widened, ", ")}")
                        console.print("  re-run with --allow-cap ${list.join(closure_widened, " --allow-cap ")} to consent to the whole dependency tree")
                        2
                    else:
                        // The manifest records the REQUIREMENT (the lock pins the
                        // exact version). A bare `add` (`req == "*"`) records a caret
                        // of the resolved version — cargo's `add` behavior: it
                        // documents the version added while still letting `update`
                        // move within the compatible range. An explicit `@<req>`
                        // is recorded verbatim.
                        let constraint = if req == "*": "^${chosen}" else: req
                        add_pkg_finalize(console, net, root, origin, name, constraint)

// Complete a gated `add`: pin the registry metadata into `witchy.lock`, and — only
// once locking succeeds — record the dependency in the project manifest's
// `[dependencies]` so the manifest-reading commands (`tree`/`why`/`outdated`) see
// it (RFC-0117 Lane A). Ordering it after the lock means a failed pin never leaves
// a manifest entry with no matching lock pin.
pub fn add_pkg_finalize(console: Console, net: Net, root: Dir, origin: String, name: String, constraint: String) -> Int:
    let code = pin_lock(console, net, root, origin, name)
    if code == 0:
        record_manifest_dep(root, name, constraint)
    code

// Record a registry dependency in the project manifest's `[dependencies]` table, in
// the SAME inline shape a hand-written registry dep uses and that
// `tree`/`why`/`outdated`/`build` already read: `"<alias>" = { version = "<req>" }`,
// keyed by the import alias (the rune's basename). The value is the version
// REQUIREMENT (the lock, not the manifest, pins the exact resolved version — the
// cargo split, and what `pm update`'s `dep_req` re-resolves within). Vendor + lock
// have already happened; this closes the manifest gap so the "see your tree's
// authority" story works for registry deps. Idempotent (a re-add replaces the
// entry, never duplicates). With no project manifest there is nothing to record
// against, so it is a no-op.
pub fn record_manifest_dep(root: Dir, name: String, version: String):
    if root.exists("witchy.toml"):
        root.write("witchy.toml", manifest_upsert_dep(root.read("witchy.toml"), basename(name), version))

// The capability authority the project already admits: its own declared runtime
// caps (from witchy.toml, if any) plus every capability the lockfile already
// records for a vendored dependency — the baseline a new direct `add` diffs
// against, so adding a same-or-narrower rune is silent and a widening one gates.
pub fn project_baseline(root: Dir) -> Result(List(String), LockIntegrityError):
    var out = []
    if root.exists("witchy.toml"):
        for c in declared_caps(root.read("witchy.toml")):
            out = add_unique(out, c)
    if root.exists("witchy.lock"):
        out = union_all(out, lock_baseline(root.read("witchy.lock"))?)
    Ok(out)

// Record the resolved dependency in the project's `witchy.lock`: a `[[rune]]`
// entry pinning the vendored rune's name, resolved version, source (coven), and
// content hash, so `build`/`run` can map `import <basename>` to its vendored
// source and `verify`/`gate` can re-check it. Idempotently rewrites the lock from
// every currently-vendored rune so repeated `add`s accumulate, not clobber.
pub fn pin_lock(console: Console, net: Net, root: Dir, origin: String, name: String) -> Int:
    match lock_trust_pins(net, root, origin):
        Err(e) ->
            console.print("BLOCK: cannot pin registry metadata for ${basename(name)} — ${e.show()}")
            2
        Ok(pins) ->
            match vendor_lock(root, pins):
                Err(e) ->
                    console.print("BLOCK: cannot regenerate witchy.lock — ${e.show()}")
                    2
                Ok(lock) ->
                    root.write("witchy.lock", lock)
                    console.print("locked ${basename(name)} -> witchy.lock")
                    0

// Fetch and verify the snapshot plus its signing key as one operation before lock
// serialization. The exact root key that verifies the snapshot is the one emitted;
// there is no second fetch that can race and pin a different key (BUG-571/572).
pub fn lock_trust_pins(net: Net, root: Dir, origin: String) -> Result(String, TufError):
    let pins = snapshot_pin(net, root, origin)?
    Ok(pins.0 + "registry_rootpub = \"" + pins.1 + "\"\n")

// The `registry_snapshot_version = N` top-level line pinning the registry's current
// TUF snapshot version into the lock — the rollback baseline `verify` enforces.
// BUG-233: the version is pinned ONLY from a VERIFIED snapshot role — the snapshot
// and timestamp must be validly signed by the registry root key (bound to any key
// already pinned in the lock), structurally well-formed, hash-bound, and in version
// agreement — so a malformed/unsigned/split response cannot under- or over-pin the
// rollback floor. An unavailable snapshot is an error: treating it as "nothing to
// pin" would erase an existing rollback floor during lock regeneration.
pub fn snapshot_pin(net: Net, root: Dir, origin: String) -> Result((String, String), TufError):
    let snap_resp = registry_get(net, origin, "/coven/snapshot")
    if http.status(snap_resp) != 200:
        Err(SnapshotUnavailable(http.status(snap_resp)))
    else:
        let rootpub = fetch_registry_rootpub(net, origin)?
        let pinned_pub = pinned_registry_rootpub(root)?
        if pinned_pub != "" && pinned_pub != rootpub:
            Err(RootKeyMismatch)
        else:
            let ts_resp = registry_get(net, origin, "/coven/timestamp")
            if http.status(ts_resp) != 200:
                Err(SnapshotWithoutTimestamp)
            else:
                let snapshot = verified_snapshot_line(rootpub, http.body(snap_resp), http.body(ts_resp))?
                Ok((snapshot, rootpub))

pub fn fetch_registry_rootpub(net: Net, origin: String) -> Result(String, RegistryRootKeyError):
    let resp = registry_get(net, origin, "/coven/rootpub")
    if http.status(resp) != 200:
        Err(RegistryRootKeyUnavailable(http.status(resp)))
    else if !valid_registry_rootpub(http.body(resp)):
        Err(RegistryRootKeyMalformed)
    else:
        Ok(http.body(resp))

// The lockfile text generated from the vendored tree: one `[[rune]]` block per
// vendored rune (those carrying a coven.json), pinning name/version/hash from the
// signed record kept beside the source. `snapshot_line` is the TUF snapshot pin
// (a top-level key, emitted BEFORE any `[[rune]]` array-table per TOML rules).
// idiom-exempt: concatenation in this section is canonical lockfile serialization.
pub fn vendor_lock(root: Dir, snapshot_line: String) -> Result(String, VendoredRecordError):
    var out = "# witchy.lock — generated by `grimoire add`. Pins every vendored dependency\n# by content hash. Regenerate with `grimoire add`. Do not edit by hand.\n" + snapshot_line
    if root.exists("vendor"):
        for entry in root.subtree("vendor").list():
            let rune_dir = join_path("vendor", entry)
            if root.exists(join_path(rune_dir, "coven.json")):
                match vendor_lock_entry(root, entry, rune_dir):
                    Err(e) -> return Err(e)
                    Ok(lock_entry) -> out = out + lock_entry
    Ok(out)

// `name` is the vendor directory basename (the local import alias); the signed
// record carries the FULL registry package identity (e.g. `acme/http`). BUG-099:
// the lock `name` is the registry identity from the signed record, and `alias`
// records the basename import key separately — the two are no longer collapsed.
pub fn vendor_lock_entry(root: Dir, alias: String, rune_dir: String) -> Result(String, VendoredRecordError):
    let record = parse_vendored_record(root.read(join_path(rune_dir, "coven.json")))?
    let fp = footprint_toml(record.runtime_footprint)
    // RFC-0120: mark a staged pin so `pm build`/`run`/`verify` re-warn every run and
    // `pm publish` can refuse it. The marker self-heals: once the version is released,
    // a re-vendor rewrites the record's state and this line disappears.
    let staged_marker = if record.state == "staged": "staged = \"true\"\n" else: ""
    Ok("\n[[rune]]\nname = \"" + record.name + "\"\nalias = \"" + alias + "\"\nversion = \"" + record.version + "\"\nsource = \"coven\"\nhash = \"" + record.hash + "\"\n" + staged_marker + "runtime_footprint = [" + fp + "]\n")

// Resolve + fetch one rune and its transitive deps. Already-vendored runes (their
// coven.json is present) are skipped — the dedup + cycle break. But a rune already
// vendored under this basename whose FULL name differs is a collision: two distinct
// runes (`a/util` and `b/util`) would vendor to the same `vendor/util`, so the
// second silently shadows the first. Refuse it — `import util` cannot name both.
pub fn add_rune(console: Console, net: Net, root: Dir, origin: String, name: String, req: String, dest: String, cooldown: (Int, Int, Bool), allowed: List(String)) -> Int:
    let vendored = join_path(dest, basename(name))
    if root.exists(join_path(vendored, "coven.json")):
        match parse_vendored_record(root.read(join_path(vendored, "coven.json"))):
            Err(e) ->
                console.print("BLOCK: cannot reuse `${vendored}` — ${e.show()}")
                2
            Ok(existing) ->
                if existing.name != name:
                    console.print("BLOCK: module name collision — `${name}` and `${existing.name}` both vendor to `${vendored}` (same basename `${basename(name)}`)")
                    2
                else if !version_satisfies(existing.version, req):
                    // CJ-05: a diamond/version conflict — this dep is already
                    // vendored at a version that does NOT satisfy the current
                    // requester's requirement. Fail loud (pm does not unify or
                    // backtrack) rather than silently keeping the first version.
                    console.print("BLOCK: version conflict for `${name}` — already vendored at ${existing.version}, but `${req}` is also required and ${existing.version} does not satisfy it; reconcile the conflicting requirements (grimoire does not auto-unify)")
                    2
                else:
                    0
    else:
        match resolve_version(net, origin, name, req, cooldown):
            Ok(chosen) -> fetch_then_deps(console, net, root, origin, name, chosen, dest, cooldown, allowed, false)
            Err(e) ->
                console.print("${name}: ${e.show()}")
                1

// Resolve `req` against the registry's released versions, honoring the staging
// cooldown: a release younger than the cooldown window is not resolvable (the
// compromised-release window, §8) unless `--allow-fresh` was passed. If the only
// matching versions are still cooling, the error explains the window + override.
pub fn resolve_version(net: Net, origin: String, name: String, req: String, cooldown: (Int, Int, Bool)) -> Result(String, VersionResolveError):
    let resp = registry_get(net, origin, "/coven/versions?name=${wire(name)}")
    if http.status(resp) != 200:
        Err(VersionRegistryFetchFailed(http.status(resp)))
    else:
        let body = http.body(resp)
        let records = released_version_records(body)?
        match pick_version_cooled(records, req, cooldown):
            Ok(v) -> Ok(v)
            Err(e) ->
                match cooling_remaining(records, req, cooldown):
                    Some(secs) -> Err(VersionCooling(req, secs))
                    None -> Err(e)

// RFC-0120: resolve an EXACT staged-or-released version for `--allow-staged`. The
// requirement MUST be a single canonical `X.Y.Z` — staged never satisfies a range,
// so nothing can float onto an unreleased version. Returns `(version, is_staged)`;
// a `yanked` record for that coordinate is always refused, with or without the flag.
pub fn resolve_staged_exact(net: Net, origin: String, name: String, req: String) -> Result((String, Bool), VersionResolveError):
    match canonical_version(req):
        None -> Err(VersionBadRequirement(req, "--allow-staged requires an exact version `name@X.Y.Z` (it never satisfies a range)"))
        Some(_v) ->
            let resp = registry_get(net, origin, "/coven/versions?name=${wire(name)}")
            if http.status(resp) != 200:
                Err(VersionRegistryFetchFailed(http.status(resp)))
            else:
                match exact_record_state(http.body(resp), req):
                    Err(e) -> Err(e)
                    Ok(state) ->
                        if state == "yanked":
                            Err(VersionYanked(req))
                        else:
                            Ok((req, state == "staged"))

// Fetch a resolved version, then recurse into the version deps its manifest
// declares. The exit code is the first failure (0 if the whole tree resolves).
pub fn fetch_then_deps(console: Console, net: Net, root: Dir, origin: String, name: String, version: String, dest: String, cooldown: (Int, Int, Bool), allowed: List(String), allow_staged: Bool) -> Int:
    // `allow_staged` applies to THIS (top-level) package only; the dependency
    // closure `add_deps` walks is always resolved against released versions.
    let code = fetch_source(console, net, root, origin, name, version, dest, allow_staged)
    if code != 0:
        code
    else:
        add_deps(console, net, root, origin, name, dest, cooldown, allowed)

pub fn add_deps(console: Console, net: Net, root: Dir, origin: String, name: String, dest: String, cooldown: (Int, Int, Bool), allowed: List(String)) -> Int:
    let manifest = root.read(join_path(join_path(dest, basename(name)), "witchy.toml"))
    var code = 0
    for depname, inline in toml.table(manifest, "dependencies"):
        if let Some(depreq) = toml.dep_requirement(inline):
            let sub = add_rune(console, net, root, origin, depname, depreq, dest, cooldown, allowed)
            if sub != 0:
                code = sub
    code

// The cooldown context for this `add`: (now_unix_secs, window_secs, allow_fresh).
// The window is `WITCHY_COOLDOWN_SECS` (Env; default 72h); `--allow-fresh` accepts
// a still-cooling release. The wall clock comes from the `Clock` capability (ms →
// seconds, matching the registry's `released_at` unit).
pub fn cooldown_now(env: Env, clock: Clock, args: List(String)) -> (Int, Int, Bool):
    (clock.now() / 1000, cooldown_window(env), has_flag(args, "--allow-fresh"))

pub fn cooldown_window(env: Env) -> Int:
    match env.get_env("WITCHY_COOLDOWN_SECS"):
        Some(v) -> v.to_int()
        None -> 259200

// Fetch a version, verifying the full trust chain before writing anything: the
// registry's record must be validly signed by its root key, and the fetched
// source must hash to that signed hash. An untrusted mirror cannot swap the
// bytes — content addressing + the signature, not the transport, are trusted.
pub fn fetch_source(console: Console, net: Net, root: Dir, origin: String, name: String, version: String, dest: String, allow_staged: Bool) -> Int:
    match pinned_registry_rootpub(root):
        Err(e) ->
            console.print("BLOCK: ${e.show()}")
            1
        Ok(pinned_pub) -> match fetch_registry_rootpub(net, origin):
            Err(e) ->
                console.print("BLOCK: cannot fetch registry root key for ${name}@${version} — ${e.show()}")
                1
            Ok(rootpub) -> fetch_source_with_root(console, net, root, origin, name, version, dest, rootpub, pinned_pub, allow_staged)

pub fn fetch_source_with_root(console: Console, net: Net, root: Dir, origin: String, name: String, version: String, dest: String, rootpub: String, pinned_pub: String, allow_staged: Bool) -> Int:
    // SEC-002: enforce the complete lock trust record on fetch/add too, before
    // source is vendored or a signed record's footprint is trusted.
    if pinned_pub != "" && pinned_pub != rootpub:
        console.print("BLOCK: registry root key for ${name}@${version} does not match the key pinned in witchy.lock (possible MITM / hostile mirror)")
        1
    else:
        let record = registry_get(net, origin, "/coven/record?name=${wire(name)}&version=${version}")
        if http.status(record) != 200:
            console.print("registry has no record for ${name}@${version}")
            1
        else if !record_signature_valid(rootpub, http.body(record)):
            console.print("BLOCK: registry record for ${name}@${version} has an invalid signature — refusing to trust it")
            1
        else if !record_matches_coordinate(http.body(record), name, version):
            // BUG-266: the signature proves the record is authentic, not that it is the
            // record we ASKED for. Bind the record's own `name`/`version` to the requested
            // coordinate, so a registry/mirror cannot answer a request for `good@1.0.0`
            // with a validly-signed record for a DIFFERENT coordinate (a mix-up/substitution
            // that would vendor the wrong rune under this basename).
            console.print("BLOCK: registry returned a record for `${recorded_field(http.body(record), "name")}@${recorded_field(http.body(record), "version")}` when `${name}@${version}` was requested — refusing (coordinate mismatch)")
            1
        else:
            fetch_verified(console, net, root, origin, name, version, dest, http.body(record), allow_staged)

pub fn fetch_verified(console: Console, net: Net, root: Dir, origin: String, name: String, version: String, dest: String, record: String, allow_staged: Bool) -> Int:
    let resp = registry_get(net, origin, "/coven/source?name=${wire(name)}&version=${version}")
    if http.status(resp) != 200:
        console.print("registry has no source for ${name}@${version}")
        1
    else:
        match source_files(http.body(resp)):
            Err(e) ->
                console.print("BLOCK: malformed source response for ${name}@${version} — ${e.show()}")
                1
            Ok(files) ->
                if content_hash(files) != recorded_hash(record):
                    console.print("BLOCK: integrity failure — fetched source for ${name}@${version} does not match the signed hash (tampered mirror?)")
                    1
                else if recorded_field(record, "state") == "yanked":
                    // A yanked version is never installable, with or without --allow-staged.
                    console.print("BLOCK: registry record for ${name}@${version} is `yanked` — a yanked version is never installable")
                    1
                else if !allow_staged && recorded_field(record, "state") != "released":
                    console.print("BLOCK: registry record for ${name}@${version} is `${recorded_field(record, "state")}`, not `released` — refusing to vendor an unreleased version (re-run with `--allow-staged name@${version}` to opt in to this exact staged version)")
                    1
                else:
                    write_vendored_source(console, root, dest, name, version, files, record)

// Validate the fetched file set, then materialize it beside its signed record.
// BUG-089: a registry/mirror response is untrusted structure. Even though the set
// is content-bound to the signed hash, refuse a malformed set BEFORE writing —
// a `..`/absolute/empty path would trap the confined Dir write (aborting pm), and
// a duplicated path is an ambiguous rune. Only `witchy.toml` + `src/**.witchy`
// (coven's publish contract) are accepted.
pub fn write_vendored_source(console: Console, root: Dir, dest: String, name: String, version: String, files: List((String, String)), record: String) -> Int:
    match validate_source_files(files):
        // Keep the signed record next to the source, so the vendored rune
        // carries its own provenance and can be re-verified offline.
        Err(e) ->
            console.print(e.show())
            1
        Ok(_) ->
            let base = join_path(dest, basename(name))
            for path, text in files:
                let full = join_path(base, path)
                fs.ensure_dir(root, fs.parent_dir(full) ?? "")
                root.write(full, text)
            root.write(join_path(base, "coven.json"), record)
            console.print("added ${name}@${version} -> ${base}")
            0

// --- verify-rune: offline re-verification of a vendored rune -----------------
// A rune fetched by `add` carries its signed coven.json. Given the registry's
// root public key (TOFU-pinned), re-verify it with no network: the record must
// be validly signed, and the on-disk source must still hash to the signed hash.
pub fn verdict_vendor(console: Console, total: Int, failed: Int) -> Int:
    if total == 0:
        console.print("no vendored runes (no coven.json) found")
        1
    else if failed == 0:
        console.print("OK: all ${total} vendored runes verified")
        0
    else:
        console.print("BLOCK: ${failed} of ${total} vendored runes failed verification")
        2

pub fn report_rune_verify(console: Console, root: Dir, dir: String, rootpub: String, record: String) -> Int:
    match verify_record_signature(rootpub, record):
        Err(_e) ->
            console.print("BLOCK: ${dir}/coven.json is not validly signed by that root key — refusing")
            2
        Ok(doc) -> report_rune_hash_verify(console, root, dir, doc)

pub fn report_rune_hash_verify(console: Console, root: Dir, dir: String, doc: Json) -> Int:
    if rune_hash(root, dir) != jget(doc, "hash"):
        console.print("BLOCK: ${dir} source no longer matches its signed hash (tampered)")
        2
    else:
        console.print("OK: ${jget(doc, "name")}@${jget(doc, "version")} verified (signature + content), no network")
        0

// --- new: scaffold a rune ----------------------------------------------------
pub fn src_stub(let name: String) -> String:
    "fn main(console: Console):\n    console.print(\"hello from " + name + "\")\n"

// --- footprint helpers -------------------------------------------------------

// The capabilities the rune's source actually demands: the UNION over every
// `src/**/*.witchy` module's footprint (BUG-085) — matching coven's
// `computed_footprint`. Footprinting only the first module would miss a capability
// a non-entry helper module reaches for (an under-report a supply-chain attacker
// could hide behind).
pub fn rune_footprint(root: Dir, dir: String) -> Result(List(String), FootprintError):
    var out = []
    for relpath, text in fs.collect_files(root, join_path(dir, "src"), "src", ".witchy"):
        let values = match footprint_values(compiler.footprint(text), "total"):
            Err(e) -> return Err(FootprintSourceError(relpath, e.show()))
            Ok(caps) -> caps

        for cap in values:
            out = add_unique(out, cap)
    Ok(out)

// SEC-006: the union footprint of EVERY vendored rune — the full resolved closure. A
// registry record's footprint is single-rune, so a direct add's gate never sees a
// transitive dep's capabilities; summing the on-disk closure does.
pub fn vendored_closure_footprint(root: Dir) -> Result(List(String), FootprintError):
    var out = []
    if root.exists("vendor"):
        for entry in root.subtree("vendor").list():
            let rune_dir = join_path("vendor", entry)
            if root.exists(join_path(rune_dir, "coven.json")):
                let caps = rune_footprint(root, rune_dir)?
                for cap in caps:
                    out = add_unique(out, cap)
    Ok(out)

// SEC-006/SEC-048: the capabilities the FULL vendored closure now on disk demands
// beyond `baseline` — the transitive re-gate BOTH `add` and `update` apply after a
// fetch mutates `vendor/`. A signed registry record's footprint is single-rune, so
// the per-record gate alone never sees a NEW transitive dependency's authority;
// walking the whole vendored tree does. An empty result means the closure is clean;
// `Err` on an un-footprintable dep so the caller blocks rather than trusting a
// silent empty closure.
pub fn closure_widening(root: Dir, baseline: List(String)) -> Result(List(String), FootprintError):
    Ok(rights.uncovered(baseline, vendored_closure_footprint(root)?))
