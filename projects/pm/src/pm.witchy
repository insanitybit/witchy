// pm — the witchy package manager, written in witchy. It reads `witchy.toml`
// manifests, audits a rune's capability footprint, checks that the declared
// footprint *admits* what the code actually demands (rights-precisely), and
// guards an upgrade against any widening of authority. The capability work goes
// through `compiler` (a host introspection intrinsic) and host capabilities; the
// embedded `witchy pm` command runs this front-end on the compiled WASM tier.
// It is the package manager's heart, self-hosted.
//
//   witchy pm <command> [args]
//
// Commands:
//   info  <dir>          summarize a rune (name, version, declared vs. actual caps)
//   audit <file>         print the capability footprint a source file demands
//   check <dir>          verify the manifest's declared footprint admits the code
//   guard <old> <new>    BLOCK if <new> widens the footprint of <old>
//   new   <name>         scaffold a new rune (manifest + src stub)
//   help                 show this message

import bytes
import compiler
import coven_proto
import crypto
import encoding
import exec
import fs
import rights
import show
import error
import convert
from http import Response
from json import Json
from semver import Version, Req
from toml import Toml

pub fn registry_origin(scheme: String, host: String, port: Int) -> String:
    "${scheme}://${host}:${port}"

fn registry_get(net: Net[Connect, Tcp], origin: String, path: String) -> Response:
    http.get(net.fetch(origin), origin + path)

fn registry_post(net: Net[Connect, Tcp], origin: String, path: String, body: String) -> Response:
    http.post(net.fetch(origin), origin + path, body)

// `main` takes two `Dir` grants positionally: `root` (handle 0) is the project
// tree the PM reads/writes; `bin` (handle 1) is where the compiler lives, used
// only by `run`, which drives it through the `Exec` capability. See
// rfcs/0004-self-hosted-cli.md.
fn main(console: Console, args: List(String), root: Dir, bin: Dir, runner: Exec, net: Net, env: Env, clock: Clock) -> Int:
    let cmd = arg(args, 0)
    if cmd == "info":
        cmd_info(console, root, arg(args, 1))
        0
    else if cmd == "run":
        cmd_run(console, runner, root, bin, env, clock, args)
    else if cmd == "build":
        cmd_build(console, runner, root, bin, env, args)
    else if cmd == "typecheck":
        cmd_drive(console, runner, bin, "typecheck", ["check", arg(args, 1)])
    else if cmd == "fmt":
        cmd_drive(console, runner, bin, "fmt", ["fmt", arg(args, 1)])
    else if cmd == "test":
        cmd_drive(console, runner, bin, "test", ["test", arg(args, 1)])
    else if cmd == "doc":
        cmd_drive(console, runner, bin, "doc", ["doc", arg(args, 1)])
    else if cmd == "add":
        cmd_add(console, net, root, env, clock, args)
    else if cmd == "publish":
        cmd_publish(console, net, root, env, args)
    else if cmd == "promote":
        cmd_promote(console, net, env, args)
    else if cmd == "yank":
        cmd_yank(console, net, env, args)
    else if cmd == "list":
        cmd_list(console, net, env, args)
    else if cmd == "outdated":
        cmd_outdated(console, net, root, args)
    else if cmd == "update":
        cmd_update(console, net, root, env, clock, args)
    else if cmd == "audit":
        cmd_audit(console, root, arg(args, 1))
        0
    else if cmd == "verify":
        cmd_verify(console, net, root, env, clock, args)
    else:
        dispatch_more(console, root, args, cmd)

// The rest of the command table, split out of `main` so neither `if`/`else if`
// chain nests deeply enough to overflow the compiler's stack while lowering it
// (the WASM codegen recurses per nesting level). These commands need only
// Console + the project Dir.
fn dispatch_more(console: Console, root: Dir, args: List(String), cmd: String) -> Int:
    if cmd == "check":
        cmd_check(console, root, arg(args, 1))
    else if cmd == "guard":
        cmd_guard(console, root, arg(args, 1), arg(args, 2))
    else if cmd == "deps":
        cmd_deps(console, root, arg(args, 1))
        0
    else if cmd == "tree":
        cmd_tree(console, root, arg(args, 1))
        0
    else if cmd == "init":
        cmd_init(console, root, arg(args, 1))
    else if cmd == "why":
        cmd_why(console, root, arg(args, 1), arg(args, 2))
    else if cmd == "why-cap":
        cmd_why_cap(console, root, arg(args, 1), arg(args, 2))
    else if cmd == "vendor":
        cmd_vendor(console, root, arg(args, 1))
    else if cmd == "lock":
        cmd_lock(console, root, arg(args, 1))
    else if cmd == "gate":
        cmd_gate(console, root, args)
    else if cmd == "verify-rune":
        cmd_verify_rune(console, root, arg(args, 1), arg(args, 2))
    else if cmd == "verify-vendor":
        cmd_verify_vendor(console, root, arg(args, 1), arg(args, 2))
    else if cmd == "new":
        cmd_new(console, root, arg(args, 1))
    else if cmd == "" || cmd == "help":
        usage(console)
        0
    else:
        unknown(console, cmd)

// --- info: a one-screen summary of a rune -----------------------------------
fn cmd_info(console: Console, root: Dir, dir: String):
    if dir.is_empty():
        console.print("usage: pm info <dir>")
    else:
        let manifest = root.read(join_path(dir, "witchy.toml"))
        console.print("name:     ${field(manifest, "rune.name")}")
        console.print("version:  ${field(manifest, "rune.version")}")
        console.print("declared: ${list.join(declared_caps(manifest), ", ")}")
        match rune_footprint(root, dir):
            Ok(actual) -> console.print("actual:   ${list.join(actual, ", ")}")
            Err(e) -> console.print("actual:   ERROR — ${footprint_error_message(e)}")

// run <file|dir> — compile and run a program by driving the compiler. Given a
// project directory (or, with no argument, the current directory) that carries a
// `witchy.toml`, it links the entry with its vendored dependencies (`witchy
// compile --dep ... --out`) and then runs the resulting wasm; given a bare file
// it runs that one module directly. This is the project-level `run` of RFC-0004 —
// the front-end decides *what* to compile (entry + deps from the lock) and
// `witchyc` does the compiling/running.
fn cmd_run(console: Console, runner: Exec, root: Dir, bin: Dir, env: Env, clock: Clock, args: List(String)) -> Int:
    let target = arg(args, 1)
    let dir = if target.is_empty(): "." else: target
    // BUG-102: everything after `run <file|dir>` is the program's own argv and must
    // be forwarded to the sandboxed run, not dropped.
    let app_args = args_from(args, 2)
    if root.exists(join_path(dir, "witchy.toml")):
        run_project(console, runner, root, bin, dir, app_args)
    else if target.is_empty():
        console.print("usage: pm run <file|dir>")
        1
    else:
        run_compiler(console, runner, bin, "run", flatten_argv([target], app_args))

type BuildOptions:
    dir: String
    target: String
    out: String
    mode: String
    error: String

// Parse build argv once into a typed value. Flags may precede or follow the
// optional project directory; the compiler never has to guess from nth tokens.
fn build_options(args: List(String)) -> BuildOptions:
    var dir = "."
    var target = "wasm"
    var out = ""
    var mode = "debug"
    var error = ""
    var positional = false
    var pending = ""
    var index = 0
    for value in args:
        if index == 0:
            Nil
        else if !pending.is_empty():
            if pending == "target":
                target = value
            else:
                out = value
            pending = ""
        else if value == "--target":
            pending = "target"
        else if value == "--out":
            pending = "out"
        else if value == "--release":
            mode = "release"
        else if value == "--debug":
            mode = "debug"
        else if value.starts_with("--"):
            error = "unknown build option `${value}`"
        else if positional:
            error = "build accepts at most one <file|dir>"
        else:
            dir = value
            positional = true
        index = index + 1
    if !pending.is_empty():
        error = "--${pending} needs a value"
    BuildOptions(dir, target, out, mode, error)

// build <file|dir> — compile a program (and its vendored deps) to verify it builds.
fn cmd_build(console: Console, runner: Exec, root: Dir, bin: Dir, env: Env, args: List(String)) -> Int:
    let options = build_options(args)
    let dir = options.dir
    if !options.error.is_empty():
        console.print("usage: pm build [--target trusted-exe] [--out <path>] [--release|--debug] [<dir>]")
        console.print(options.error)
        1
    else if options.target != "wasm" && options.target != "trusted-exe":
        console.print("unknown build target `${options.target}` (expected `wasm` or `trusted-exe`)")
        1
    else if root.exists(join_path(dir, "witchy.toml")):
        match ensure_lock_integrity(root, dir):
            // BUG-094: refuse to link a vendored dependency whose on-disk source
            // no longer matches its signed record — before any compile.
            Err(e) ->
                console.print(lock_integrity_error_message(e))
                2
            Ok(_) ->
                match project_entry(root, dir):
                    Some(entry) ->
                        let built = build_step_flags(console, runner, root, bin, dir)
                        if built.0 != 0:
                            built.0
                        else:
                            match dep_flags(root, dir):
                                Err(e) ->
                                    console.print(lock_integrity_error_message(e))
                                    2
                                Ok(deps) ->
                                    build_project_target(console, runner, root, bin, dir, entry, deps, built.1, options)
                    None ->
                        console.print("no entry source under ${join_path(dir, "src")}")
                        1
    else if options.target == "trusted-exe":
        console.print("trusted-exe builds require a project directory containing witchy.toml")
        1
    else:
        run_compiler(console, runner, bin, "build", ["compile", dir])

fn build_project_target(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, entry: String, deps: List(String), build_flags: List(String), options: BuildOptions) -> Int:
    if options.target == "trusted-exe":
        let manifest = join_path(dir, "witchy.toml")
        let configured = if options.out.is_empty(): trusted_output(root, dir, options.mode) else: options.out
        let target_flags = ["--target", "trusted-exe", "--manifest", manifest, "--out", configured, "--${options.mode}"]
        run_compiler(console, runner, bin, "build", flatten_argv(["compile", entry], flatten_argv(deps, flatten_argv(build_flags, target_flags))))
    else if !options.out.is_empty():
        console.print("--out is supported by `build --target trusted-exe`; portable project builds remain verification-only")
        1
    else:
        run_compiler(console, runner, bin, "build", flatten_argv(["compile", entry], flatten_argv(deps, build_flags)))

fn trusted_output(root: Dir, dir: String, mode: String) -> String:
    let manifest = root.read(join_path(dir, "witchy.toml"))
    let name = field(manifest, "rune.name")
    join_path(join_path(join_path(dir, "target"), mode), module_name(name))

// Link a project's entry + vendored deps to a wasm under <dir>/target, then run
// that wasm. Two compiler invocations: `compile --dep ... --out` (link) then a
// run of the wasm (which carries exactly its own footprint). The artifact goes
// under the project's own tree so it is named through the project Dir.
//
// The run step is granted a `Dir` rooted at the PROJECT directory (`--dir <dir>`),
// NOT pm's own working directory. This keeps the program's runtime authority
// confined to its own tree while still letting the *compile* step reach a sibling
// path-dependency (`../lib`), which is named relative to pm's Dir (a workspace
// that holds both the app and its siblings). Without the explicit `--dir`, the
// program's data Dir would default to pm's cwd — too wide when pm runs from a
// workspace root, and missing the project's data files (e.g. `tasks.md`).
fn run_project(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, app_args: List(String)) -> Int:
    match ensure_lock_integrity(root, dir):
        // BUG-094: verify vendored sources against their signed records before
        // linking + running, so a tampered vendored rune never executes.
        Err(e) ->
            console.print(lock_integrity_error_message(e))
            2
        Ok(_) ->
            match project_entry(root, dir):
                None ->
                    console.print("no entry source under ${join_path(dir, "src")}")
                    1
                Some(entry) ->
                    let steps = build_step_flags(console, runner, root, bin, dir)
                    if steps.0 != 0:
                        steps.0
                    else:
                        compile_then_run(console, runner, root, bin, dir, entry, steps.1, app_args)

// `build`/`run` use a lock on every project path. A path-only development project
// gets its first lock automatically, matching the documented "writes/uses the
// lock" contract. Registry dependencies can only be locked by `add`, because that
// operation obtains the signed record and trust pins; never synthesize a weaker
// registry lock during a build.
fn ensure_lock_integrity(root: Dir, dir: String) -> Result(Nil, LockIntegrityError):
    let lockpath = join_path(dir, "witchy.lock")
    if !root.exists(lockpath):
        let manifest = root.read(join_path(dir, "witchy.toml"))
        let problems = lock_problems(root, dir, manifest)
        if list.length(problems) > 0:
            Err(LockCannotCreate(list.join(problems, "; ")))
        else:
            match generate_lock(root, dir):
                Err(e) -> Err(LockCannotCreate(footprint_error_message(e)))
                Ok(lock) ->
                    root.write(lockpath, lock)
                    verify_lock_integrity(root, dir)
    else:
        verify_lock_integrity(root, dir)

// One offline integrity contract shared by `build`, `run`, and `verify`:
//
// * every path dependency still matches the hash pinned in the lock;
// * every registry lock entry has a corresponding vendored rune;
// * the vendored record verifies under the root key pinned in the lock;
// * signed name/version/hash agree with the lock entry; and
// * the current source tree hashes to that same signed and locked hash.
//
// No network state participates. Online TUF freshness is the optional second
// phase of `verify --online`.
fn verify_lock_integrity(root: Dir, dir: String) -> Result(Nil, LockIntegrityError):
    let lockpath = join_path(dir, "witchy.lock")
    if !root.exists(lockpath):
        Err(LockMissing)
    else:
        let lock = root.read(lockpath)
        let path_bad = hash_mismatches(root, dir, lock)?
        if list.length(path_bad) > 0:
            Err(LockPathHashMismatch(path_bad))
        else:
            verify_registry_lock_entries(root, dir, lock)

// The `[[rune]]` entries of a lockfile, decoded through the ONE structured TOML
// parser (`toml.decode` + `toml.array_of_tables`). A malformed lockfile — or a
// `rune` value that is not an array-of-tables — is an explicit
// `LockEntryMalformed`, never a silently-empty dependency set (BUG-373): this is
// the single lockfile boundary every reader below shares, so dependency
// resolution, capability baselines, hash verification, `update`, and `why` all
// consume the same decoded model.
fn lock_rune_entries(lock: String) -> Result(List(Toml), LockIntegrityError):
    match toml.decode(lock):
        Err(e) -> Err(LockEntryMalformed(toml.decode_error_message(e)))
        Ok(doc) ->
            match toml.array_of_tables(doc, "rune"):
                Err(e) -> Err(LockEntryMalformed(toml.decode_error_message(e)))
                Ok(entries) -> Ok(entries)

fn verify_registry_lock_entries(root: Dir, dir: String, lock: String) -> Result(Nil, LockIntegrityError):
    let rootpub: String = match pinned_registry_trust(lock):
        Err(e) -> return Err(LockEntryMalformed(lock_pin_error_message(e)))
        Ok(None) -> ""
        Ok(Some(trust)) -> trust.1

    var aliases = []
    for entry in lock_rune_entries(lock)?:
        match entry_source(entry):
            Some(source) ->
                if source == "coven":
                    let name = required_lock_field(entry, "name")?
                    let version = required_lock_field(entry, "version")?
                    let hash = required_lock_field(entry, "hash")?
                    let alias = entry_alias(entry)
                    if alias.is_empty():
                        return Err(LockEntryMalformed("registry entry `${name}` has no local alias"))
                    else if aliases.contains(alias):
                        return Err(LockDuplicateAlias(alias))
                    aliases.push(alias)
                    if rootpub.is_empty():
                        return Err(LockRootKeyMissing)
                    let rune_dir = join_path(join_path(dir, "vendor"), alias)
                    let record_path = join_path(rune_dir, "coven.json")
                    if !root.exists(record_path):
                        return Err(LockVendorMissing(alias))
                    else if !root.exists(join_path(rune_dir, "witchy.toml")):
                        return Err(LockVendorManifestMissing(alias))
                    let record_text = root.read(record_path)
                    match verify_record_signature(rootpub, record_text):
                        Err(e) -> return Err(LockRecordInvalid(alias, record_verify_error_message(e)))
                        Ok(_doc) -> Nil

                    let record = match parse_vendored_record(record_text):
                        Err(e) -> return Err(LockRecordInvalid(alias, vendored_record_error_message(e)))
                        Ok(record) -> record

                    if record.name != name:
                        return Err(LockRecordCoordinateMismatch(alias, "name", name, record.name))
                    else if record.version != version:
                        return Err(LockRecordCoordinateMismatch(alias, "version", version, record.version))
                    else if record.hash != hash:
                        return Err(LockRecordCoordinateMismatch(alias, "hash", hash, record.hash))
                    else if rune_hash(root, rune_dir) != hash:
                        return Err(LockSourceHashMismatch(alias))
                else if source.starts_with("path:"):
                    let name = required_lock_field(entry, "name")?
                    if !is_locked_path_dependency(root, dir, name):
                        return Err(LockEntryMalformed("path entry `${name}` is not in the manifest dependency closure"))
                else:
                    return Err(LockEntryMalformed("unsupported dependency source `${source}`"))
            None -> return Err(LockEntryMalformed("a [[rune]] entry has no `source` field"))
    Ok(Nil)

fn is_locked_path_dependency(root: Dir, dir: String, name: String) -> Bool:
    for dep_name, _dep_dir in path_closure(root, dir):
        if dep_name == name:
            return true
    false

// A required string field of a decoded `[[rune]]` entry. Delegates to the
// structured `toml.required_string`, which distinguishes a MISSING field, an
// EMPTY field, and a WRONG-KIND value (e.g. `name = 42`) — all mapped to
// `LockEntryMalformed` so lock verification fails closed with a precise message.
fn required_lock_field(entry: Toml, field: String) -> Result(String, LockIntegrityError):
    match toml.required_string(entry, field, "a registry [[rune]] entry"):
        Err(e) -> Err(LockEntryMalformed(toml.decode_error_message(e)))
        Ok(value) -> Ok(value)

// The `source` field of a decoded `[[rune]]` entry, or None when absent. A
// wrong-kind `source` reads as None (treated as a missing source by the caller).
fn entry_source(entry: Toml) -> Option(String):
    match toml.optional_string(entry, "source"):
        Ok(s) -> s
        Err(_) -> None

type LockIntegrityError:
    LockMissing
    LockCannotCreate(String)
    LockPathHashMismatch(List(String))
    LockRootKeyMissing
    LockEntryMalformed(String)
    LockDuplicateAlias(String)
    LockVendorMissing(String)
    LockVendorManifestMissing(String)
    LockRecordInvalid(String, String)
    LockRecordCoordinateMismatch(String, String, String, String)
    LockSourceHashMismatch(String)

fn lock_integrity_error_message(e: LockIntegrityError) -> String:
    match e:
        LockMissing -> "BLOCK: no witchy.lock — run `witchy lock` or `witchy add` before verification"
        LockCannotCreate(reason) -> "BLOCK: cannot create witchy.lock before build: ${reason}"
        LockPathHashMismatch(names) -> "BLOCK: lock no longer matches source for: ${list.join(names, ", ")}"
        LockRootKeyMissing -> "BLOCK: witchy.lock has registry dependencies but no pinned registry_rootpub"
        LockEntryMalformed(reason) -> "BLOCK: malformed witchy.lock — ${reason}"
        LockDuplicateAlias(alias) -> "BLOCK: witchy.lock maps more than one registry dependency to vendor/${alias}"
        LockVendorMissing(alias) -> "BLOCK: locked registry dependency vendor/${alias} is missing"
        LockVendorManifestMissing(alias) -> "BLOCK: locked registry dependency vendor/${alias} has no witchy.toml"
        LockRecordInvalid(alias, reason) -> "BLOCK: vendor/${alias}/coven.json failed pinned-root verification — ${reason}"
        LockRecordCoordinateMismatch(alias, field, expected, actual) -> "BLOCK: vendor/${alias}/coven.json `${field}` is `${actual}`, but witchy.lock pins `${expected}`"
        LockSourceHashMismatch(alias) -> "BLOCK: vendor/${alias} source no longer matches its signed and locked hash"

impl Show for LockIntegrityError:
    fn show(self) -> String:
        lock_integrity_error_message(self)

impl Error for LockIntegrityError

impl From(LockIntegrityError) for String:
    fn from(value: LockIntegrityError) -> Self:
        lock_integrity_error_message(value)

fn compile_then_run(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, entry: String, build_flags: List(String), app_args: List(String)) -> Int:
    let outdir = join_path(dir, "target")
    if !root.exists(outdir):
        root.make_dir(outdir)
    let wasm = join_path(outdir, "app.wasm")
    match dep_flags(root, dir):
        Err(e) ->
            console.print(lock_integrity_error_message(e))
            2
        Ok(dep_argv) ->
            compile_then_run_deps(console, runner, root, bin, dir, entry, wasm, flatten_argv(dep_argv, build_flags), app_args)

// The tail of `compile_then_run` once the lockfile `--dep` flags are resolved:
// compile the entry + deps to `wasm`, then sandbox-run it. Split out so the
// lockfile-decode `Result` is handled once at the boundary above.
fn compile_then_run_deps(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, entry: String, wasm: String, deps: List(String), app_args: List(String)) -> Int:
    let argv = flatten_argv(["compile", entry], flatten_argv(deps, ["--out", wasm]))
    let built = exec.run_args(runner, bin, "witchy", argv)
    if built.0 != 0:
        console.print(built.1)
        built.0
    else:
        // BUG-406: runtime `--net <addr>` grants (forwarded by the front-end as trailing
        // args) must sit in the sandbox-flags position (before the wasm), not as the app's
        // own argv. BUG-102: the program's remaining argv still follows the sandboxed wasm.
        let net_flags = runtime_net_flags(app_args)
        let real_args = strip_net_flags(app_args)
        let sandbox_head = flatten_argv(["sandbox", "--dir", project_data_dir(dir)], flatten_argv(net_flags, [wasm]))
        run_compiler(console, runner, bin, "run", flatten_argv(sandbox_head, real_args))

// BUG-406: extract the runtime `--net <addr>` grants from the front-end argv as a flat
// `["--net", addr, ...]` list, so the inner sandbox run keeps the Net authority the user
// granted (the front-end forwards them as trailing args precisely so they can be spliced back).
fn runtime_net_flags(args: List(String)) -> List(String):
    var out = []
    var take = false
    for a in args:
        if take:
            out.push("--net")
            out.push(a)
            take = false
        else if a == "--net":
            take = true
    out

// The app's own argv with the `--net <addr>` grant pairs removed (they become sandbox flags).
fn strip_net_flags(args: List(String)) -> List(String):
    var out = []
    var skip = false
    for a in args:
        if skip:
            skip = false
        else if a == "--net":
            skip = true
        else:
            out.push(a)
    out

// The directory backing the program's runtime `Dir` grant — the project itself
// (`.` when pm is run from inside the project, `<dir>` when run from a workspace
// root). Data files (`tasks.md`, `config.kv`, `output.json`, …) live here.
fn project_data_dir(dir: String) -> String:
    if dir.is_empty() || dir == ".":
        "."
    else:
        dir

// The project's entry source: the conventional `src/<module_name(rune.name)>.witchy`
// (BUG-086), falling back to the first `.witchy` under <dir>/src for a rune with a
// non-conventional layout. Identical resolution to `module_in_src`.
fn project_entry(root: Dir, dir: String) -> Option(String):
    module_in_src(root, dir)

// One `--dep name=path` token per dependency (TRANSITIVELY), mapping the `import
// <name>` any linked module uses to the source the compiler should link. The
// compiler links a flat set of modules, so a *diamond* — `app` → {`tasks`,
// `coverage`} → `bars` — needs every rune in the graph passed as a `--dep`, not
// just the app's direct dependencies. Deduplicated by name (a shared base like
// `bars` appears once). A registry dependency is served from its vendored tree
// (`vendor/<name>/src/*.witchy`, pinned by the lock); a path dependency is
// resolved from its manifest's `path =`, relative to the depending rune's dir, so
// a sibling-library workspace builds without vendoring. Path wins when both are
// present (the manifest is the source of truth for a path dep).
fn dep_flags(root: Dir, dir: String) -> Result(List(String), LockIntegrityError):
    let manifest_path = join_path(dir, "witchy.toml")
    if !root.exists(manifest_path):
        Err(LockEntryMalformed("project has no witchy.toml for authenticated package ownership"))
    else:
        let manifest = root.read(manifest_path)
        let name = required_manifest_coordinate(manifest, "rune.name")?
        let version = required_manifest_coordinate(manifest, "rune.version")?
        collect_deps(root, dir, package_owner_flag([], "workspace", name, version, module_name(name)))

// Accumulate `--dep` flags for the rune at `dir` and, recursively, the path
// dependencies it declares — skipping any already present so the graph is walked
// once per rune (cycles and diamonds both terminate). A malformed lockfile is an
// explicit error (BUG-373), never a silently-incomplete `--dep` set that would
// mis-resolve imports.
fn collect_deps(root: Dir, dir: String, flags: List(String)) -> Result(List(String), LockIntegrityError):
    var acc = flags
    if root.exists(join_path(dir, "witchy.toml")):
        let manifest = root.read(join_path(dir, "witchy.toml"))
        for pair in toml.table(manifest, "dependencies"):
            acc = push_path_dep(root, dir, acc, pair)?
    let lockpath = join_path(dir, "witchy.lock")
    if root.exists(lockpath):
        let lock = root.read(lockpath)
        let rootpub: String = match pinned_registry_trust(lock):
            Err(e) -> return Err(LockEntryMalformed(lock_pin_error_message(e)))
            Ok(None) -> ""
            Ok(Some(trust)) -> trust.1

        for entry in lock_rune_entries(lock)?:
            // The import key is the local alias (basename), distinct from the lock's
            // registry identity `name` (BUG-099). Old-format locks have no `alias`,
            // so fall back to the basename of `name`.
            let alias = entry_alias(entry)
            if entry_is_registry(entry) && !alias.is_empty() && !has_dep(acc, alias):
                if let Some(src) = vendored_module(root, dir, alias):
                    if rootpub.is_empty():
                        return Err(LockRootKeyMissing)
                    let package = required_lock_field(entry, "name")?
                    let version = required_lock_field(entry, "version")?
                    acc = dep_flag_owned(acc, alias, src, "registry:${rootpub}", package, version, module_name(package))
    Ok(acc)

// Append a `--dep <name>=<path>` for a manifest path dependency (no-op otherwise),
// then recurse into that dependency's own directory so its transitive path deps
// are collected too. Already-resolved names are skipped (the diamond's shared base
// resolves once).
fn push_path_dep(root: Dir, dir: String, flags: List(String), pair: (String, String)) -> Result(List(String), LockIntegrityError):
    let (name, inline) = pair
    if has_dep(flags, name):
        Ok(flags)
    else:
        match toml.inline_get(inline, "path"):
            // BUG-415: a declared path dependency whose `src/` has no
            // module is broken. Don't silently drop the `--dep` — that
            // lets `import <name>` mis-resolve to `<consumer>/src/<name>.witchy`
            // and fail naming the CONSUMER's tree. Point the compiler at the
            // dependency's own conventional entry (which is missing) so the
            // error names the actual broken dependency directory.
            Some(rel) ->
                let dep_dir = normalize_path(join_path(dir, rel))
                let owner = workspace_dependency_owner(root, dep_dir)?
                match module_in_src(root, dep_dir):
                    Some(src) -> collect_deps(root, dep_dir, dep_flag_owned(flags, name, src, owner.0, owner.1, owner.2, owner.3))
                    None ->
                        Ok(dep_flag_owned(flags, name, conventional_entry(dep_dir, name), owner.0, owner.1, owner.2, owner.3))
            None -> Ok(flags)

fn dep_flag(flags: List(String), name: String, src: String) -> List(String):
    var out = flags
    out.push("--dep")
    out.push("${name}=${src}")
    out

fn package_owner_flag(flags: List(String), source: String, package: String, version: String, module: String) -> List(String):
    var out = flags
    out.push("--package-owner")
    out.push(source)
    out.push(package)
    out.push(version)
    out.push(module)
    out

fn dep_flag_owned(flags: List(String), alias: String, src: String, source: String, package: String, version: String, module: String) -> List(String):
    var out = dep_flag(flags, alias, src)
    out.push("--dep-owner")
    out.push(alias)
    out.push(source)
    out.push(package)
    out.push(version)
    out.push(module)
    out

fn required_manifest_coordinate(manifest: String, path: String) -> Result(String, LockIntegrityError):
    match toml.get(manifest, path):
        Some(value) ->
            if value.is_empty():
                Err(LockEntryMalformed("manifest `${path}` is empty"))
            else:
                Ok(value)
        None -> Err(LockEntryMalformed("manifest is missing `${path}`"))

fn workspace_dependency_owner(root: Dir, dep_dir: String) -> Result((String, String, String, String), LockIntegrityError):
    let manifest_path = join_path(dep_dir, "witchy.toml")
    if !root.exists(manifest_path):
        Err(LockEntryMalformed("path dependency `${dep_dir}` has no witchy.toml for authenticated ownership"))
    else:
        let manifest = root.read(manifest_path)
        let package = required_manifest_coordinate(manifest, "rune.name")?
        let version = required_manifest_coordinate(manifest, "rune.version")?
        Ok(("workspace", package, version, module_name(package)))

fn dependency_owner(root: Dir, dir: String, alias: String, depdir: String) -> Result((String, String, String), LockIntegrityError):
    let lockpath = join_path(dir, "witchy.lock")
    if root.exists(lockpath):
        let lock = root.read(lockpath)
        for entry in lock_rune_entries(lock)?:
            if entry_is_registry(entry) && entry_alias(entry) == alias:
                let rootpub = match pinned_registry_trust(lock):
                    Err(e) -> return Err(LockEntryMalformed(lock_pin_error_message(e)))
                    Ok(None) -> return Err(LockRootKeyMissing)
                    Ok(Some(trust)) -> trust.1

                return Ok(("registry:${rootpub}", required_lock_field(entry, "name")?, required_lock_field(entry, "version")?))

    let owner = workspace_dependency_owner(root, depdir)?
    Ok((owner.0, owner.1, owner.2))

// Whether a `--dep <name>=...` flag is already present.
fn has_dep(flags: List(String), name: String) -> Bool:
    var found = false
    for f in flags:
        if f.contains("=") && f.split_once("=").0 == name:
            found = true
    found

// The vendored source file for dependency `name`: vendor/<name>/src/<first>.witchy.
fn vendored_module(root: Dir, dir: String, name: String) -> Option(String):
    module_in_src(root, join_path(join_path(dir, "vendor"), name))

// The entry `.witchy` under `<base>/src`, as a path the compiler can read. BUG-086:
// prefer the conventional `src/<module_name(rune.name)>.witchy` (the launcher's
// `project_entry_file` convention) so a rune with several modules compiles its real
// entry, not whichever file happens to sort first. Falls back to the first `.witchy`
// in listing order for a rune whose entry does not follow the convention.
fn module_in_src(root: Dir, base: String) -> Option(String):
    let srcdir = join_path(base, "src")
    if !root.exists(srcdir):
        None
    else:
        let conventional = manifest_entry(root, base)
        if !conventional.is_empty() && root.exists(conventional):
            Some(conventional)
        else:
            match first_witchy(root.subtree(srcdir).list()):
                Some(file) -> Some(join_path(srcdir, file))
                None -> None

// The conventional entry-source path derived from the rune's own manifest identity
// (`<base>/src/<module_name(rune.name)>.witchy`), or "" when there is no manifest /
// no `rune.name`. BUG-086.
fn manifest_entry(root: Dir, base: String) -> String:
    let manifest_path = join_path(base, "witchy.toml")
    if !root.exists(manifest_path):
        ""
    else:
        match toml.get(root.read(manifest_path), "rune.name"):
            Some(nm) -> conventional_entry(base, nm)
            None -> ""

// The conventional entry-source path for a rune at `base` whose module stem is
// `name`: `<base>/src/<module_name(name)>.witchy` (the launcher's
// `project_entry_file` convention). Used to name a MISSING source (BUG-415).
fn conventional_entry(base: String, name: String) -> String:
    join_path(join_path(base, "src"), "${module_name(name)}.witchy")

// Concatenate the leading argv with the trailing `--dep` flags into one argv.
fn flatten_argv(head: List(String), tail: List(String)) -> List(String):
    var out = []
    for a in head:
        out.push(a)
    for b in tail:
        out.push(b)
    out

// Exec the compiler with `argv`, printing its output and returning its exit code.
fn run_compiler(console: Console, runner: Exec, bin: Dir, label: String, argv: List(String)) -> Int:
    let result = exec.run_args(runner, bin, "witchy", argv)
    console.print(result.1)
    result.0

// Drive the compiler (`witchy`) with `argv`, confined to the toolchain-`bin` Dir
// via the `Exec` capability (you can only run a binary you can read). Prints the
// compiler's output and returns its exit code. The shared core of
// run/typecheck/fmt/test/doc — the CLI front-end driving the compiler, RFC-0004's
// cargo→rustc split.
fn cmd_drive(console: Console, runner: Exec, bin: Dir, verb: String, argv: List(String)) -> Int:
    if list.at(argv, list.length(argv) - 1).is_empty():
        console.print("usage: pm ${verb} <file>")
        1
    else:
        let result = exec.run_args(runner, bin, "witchy", argv)
        console.print(result.1)
        result.0

// --- build steps (§7.1) -----------------------------------------------------
// A dependency may ship a `src/build.witchy` that GENERATES source the consumer
// then imports. Running it is dangerous — generated code is still code — so the
// front-end gates it default-deny, twice over (the policy mirrors the Rust
// `run_dep_build_step`, src/pm/cli.rs:500-703): EXECUTION itself must be consented
// (a `[build.grants."name"]` section must exist), and any build capability the
// step demands beyond the confined `BuildOut` sandbox must be named in it. The
// confined EXECUTION + sandboxing is the compiler's (`witchy build-step`, the
// TCB); the front-end only decides POLICY and drives it via `Exec`.
//
// Returns (exit_code, extra_dep_flags): a nonzero code aborts the build; the flags
// are `--dep <module>=<path>` per generated file, joined into the compile.
fn build_step_flags(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String) -> (Int, List(String)):
    match dep_dirs(root, dir):
        Err(e) ->
            console.print("BLOCK: cannot read witchy.lock — ${lock_integrity_error_message(e)}")
            (1, [])
        Ok(deps) ->
            var code = 0
            var flags = []
            for name, depdir in deps:
                if has_build_step(root, depdir):
                    let outcome = run_one_build_step(console, runner, root, bin, dir, name, depdir)
                    if outcome.0 != 0:
                        code = outcome.0
                    else:
                        flags = flatten_argv(flags, outcome.1)
            (code, flags)

// Each dependency as (name, dir): the consumer's path dependencies (resolved
// relative to the project) and its vendored registry dependencies (`vendor/<name>`).
fn dep_dirs(root: Dir, dir: String) -> Result(List((String, String)), LockIntegrityError):
    var out = []
    if root.exists(join_path(dir, "witchy.toml")):
        let manifest = root.read(join_path(dir, "witchy.toml"))
        for name, inline in toml.table(manifest, "dependencies"):
            if let Some(rel) = toml.inline_get(inline, "path"):
                out.push((name, normalize_path(join_path(dir, rel))))
    let vendor = join_path(dir, "vendor")
    if root.exists(vendor):
        let lockpath = join_path(dir, "witchy.lock")
        let lock = if root.exists(lockpath): root.read(lockpath) else: ""
        for name in root.subtree(vendor).list():
            let rune_dir = join_path(vendor, name)
            // BUG-095: only treat a vendored subdir as a real dependency (and thus
            // run its build step) when it carries provenance (coven.json) AND is
            // pinned in witchy.lock. A stray directory dropped under vendor/, or an
            // unpinned partial add, must not have its build step executed.
            if root.exists(join_path(rune_dir, "coven.json")) && locked_registry_alias(lock, name)?:
                out.push((name, rune_dir))
    Ok(out)

// Whether the lock records a `[[rune]]` whose local import alias is `alias` — the
// gate for a vendored dependency to count as resolved (BUG-095). A malformed
// lockfile is an explicit error (BUG-373), never a silent `false` that would
// treat a vendored, pinned dependency as unresolved.
fn locked_registry_alias(lock: String, alias: String) -> Result(Bool, LockIntegrityError):
    var found = false
    for entry in lock_rune_entries(lock)?:
        if entry_is_registry(entry) && entry_alias(entry) == alias:
            found = true
    Ok(found)

fn entry_is_registry(entry: Toml) -> Bool:
    match entry_source(entry):
        Some(source) -> source == "coven"
        None -> false

// Whether a dependency ships a `build` step (`src/build.witchy` defining `build`).
fn has_build_step(root: Dir, depdir: String) -> Bool:
    let path = join_path(join_path(depdir, "src"), "build.witchy")
    root.exists(path) && root.read(path).contains("fn build")

// Run one dependency's build step under its grant, returning (code, dep_flags).
// Default-deny layer 1: refuse unless the consumer accepted execution with a
// `[build.grants."name"]` section. Layer 2: the demanded build caps must all be
// granted. Then cache-or-exec, audit the generated source, and emit `--dep` flags.
fn run_one_build_step(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, name: String, depdir: String) -> (Int, List(String)):
    let manifest = root.read(join_path(dir, "witchy.toml"))
    if !has_grants_section(manifest, name):
        console.print("`${name}` ships a build step, and build-time code execution is denied by default.")
        console.print("  Add a [build.grants.\"${name}\"] section to accept it — an empty section permits only the confined output sandbox (BuildOut); name read/exec/env/net to grant more.")
        (1, [])
    else:
        let buildfile = join_path(join_path(depdir, "src"), "build.witchy")
        let demanded = match build_footprint(root.read(buildfile)):
            Err(e) ->
                console.print("`${name}` build step has no trustworthy capability footprint: ${footprint_error_message(e)}")
                return (1, [])
            Ok(caps) -> caps

        let granted = granted_build_kinds(manifest, name)
        let missing = rights.uncovered(granted, demanded)
        if list.length(missing) > 0:
            console.print("`${name}` build step demands build capabilities you have not granted: ${list.join(missing, ", ")}")
            console.print("  add them to [build.grants.\"${name}\"] (read/exec/env/net).")
            (1, [])
        else:
            exec_build_step(console, runner, root, bin, dir, name, depdir, manifest)

// Generate (or reuse cached) source, audit it, and return its `--dep` flags.
fn exec_build_step(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, name: String, depdir: String, manifest: String) -> (Int, List(String)):
    let gendir = join_path(join_path(dir, "build-out"), name)
    let buildfile = join_path(join_path(depdir, "src"), "build.witchy")
    let key = build_cache_key(root, dir, manifest, name, root.read(buildfile))
    if !cache_hit(root, gendir, key):
        let argv = flatten_argv(["build-step", buildfile, "--out", gendir], grant_flags(manifest, name, dir))
        let result = exec.run_args(runner, bin, "witchy", argv)
        if result.0 != 0:
            console.print("`${name}` build step failed:")
            console.print(result.1)
            return (1, [])
        root.write(join_path(gendir, ".witchy-build-cache"), key)
    audit_then_flags(console, root, dir, name, depdir, gendir)

// Post-generation audit (the smuggle gate): the dependency's footprint over its
// shipped source PLUS the generated source must not widen beyond what it shipped.
// Generated code cannot introduce authority the version was not accepted with.
fn audit_then_flags(console: Console, root: Dir, dir: String, name: String, depdir: String, gendir: String) -> (Int, List(String)):
    let shipped = match rune_footprint(root, depdir):
        Err(e) ->
            console.print("`${name}` has no trustworthy shipped capability footprint: ${footprint_error_message(e)}")
            return (1, [])
        Ok(caps) -> caps

    let owner = match dependency_owner(root, dir, name, depdir):
        Err(e) ->
            console.print(lock_integrity_error_message(e))
            return (1, [])
        Ok(value) -> value

    var generated = []
    var flags = []
    for f in root.subtree(gendir).list():
        if f.ends_with(".witchy"):
            let path = join_path(gendir, f)
            let caps = match footprint_values(compiler.footprint(root.read(path)), "total"):
                Err(e) ->
                    console.print("`${name}` generated `${path}` without a trustworthy capability footprint: ${footprint_error_message(e)}")
                    return (1, [])
                Ok(values) -> values

            for c in caps:
                generated = add_unique(generated, c)
            let module = module_stem(f)
            flags = dep_flag_owned(flags, module, path, owner.0, owner.1, owner.2, module)
    let widened = rights.uncovered(shipped, generated)
    if list.length(widened) > 0:
        console.print("`${name}`'s build step generated source that WIDENS its footprint (+ ${list.join(widened, ", ")}) beyond the locked baseline — refusing. Generated code is still code; it cannot smuggle in authority the version was not accepted with.")
        (1, [])
    else:
        (0, flags)

// A deterministic build step is a pure function of its build source AND the inputs
// it reads. BUG-082: keying the cache on the build source alone would serve stale
// output when a granted read INPUT (not the build.witchy) changes. Key on the build
// source, the recursive contents of every granted `--read` input, and the grant
// surface (env keys / exec tools) — so any input change invalidates the cache. (The
// compiler confines the step; env/exec VALUE non-determinism stays out of scope.)
// idiom-exempt: concatenation below defines the cache-key byte format.
fn build_cache_key(root: Dir, dir: String, manifest: String, name: String, build_src: String) -> String:
    var material = "build-src\n" + build_src
    let section = "build.grants.\"${name}\""
    for p in toml.get_array(manifest, section + ".read"):
        material = material + "\nread " + p + "=" + read_input_digest(root, normalize_path(join_path(dir, p)))
    for k in toml.get_array(manifest, section + ".env"):
        material = material + "\nenv " + k
    for t in build_exec_programs(manifest, section):
        material = material + "\nexec " + t
    for p in build_exec_child_paths(manifest, section):
        material = material + "\nexec-child " + p
    "witchy-build-cache-v2:" + crypto.sha256(material)

// The content digest of a granted read input — a single file, or (a read grant is a
// directory root) the recursive contents of a directory. Absent inputs hash to a
// stable sentinel so a later-appearing input still flips the key.
fn read_input_digest(root: Dir, path: String) -> String:
    if !root.exists(path):
        "(absent)"
    else if root.is_dir(path):
        var material = ""
        for rel, contents in fs.collect_files(root, path, "", ""):
            material = material + rel + "=" + crypto.sha256(contents) + "\n"
        crypto.sha256(material)
    else:
        crypto.sha256(root.read(path))

fn cache_hit(root: Dir, gendir: String, key: String) -> Bool:
    let keyfile = join_path(gendir, ".witchy-build-cache")
    root.exists(keyfile) && root.read(keyfile) == key

// Whether the consumer manifest carries a `[build.grants."name"]` section at all —
// the explicit consent to ANY build-time execution (an empty section is consent to
// a BuildOut-only step). A structured check over PARSED section headers, not a raw
// substring: a commented (`# [build.grants."x"]`) or quoted (`k = "[build.grants."x"]"`)
// line that merely LOOKS like the header is not consent (BUG-097). This mirrors
// std/toml's own header grammar — a header is a line that trims to `[...]`.
fn has_grants_section(manifest: String, name: String) -> Bool:
    let target = "build.grants.\"${name}\""
    var found = false
    for line in manifest.lines():
        let t = line.trim()
        if t.starts_with("[") && t.ends_with("]"):
            let inner = t.strip_prefix("[").strip_suffix("]").trim()
            if inner == target:
                found = true
    found

// The build capabilities a `[build.grants."name"]` section grants. The mere section
// (even empty) grants `BuildOut`; named read/exec/env/net arrays grant the others.
fn granted_build_kinds(manifest: String, name: String) -> List(String):
    var out = ["BuildOut"]
    let section = "build.grants.\"${name}\""
    if list.length(toml.get_array(manifest, section + ".read")) > 0:
        out.push("BuildRead")
    if list.length(build_exec_programs(manifest, section)) > 0:
        out.push("BuildExec")
    if list.length(toml.get_array(manifest, section + ".env")) > 0:
        out.push("BuildEnv")
    if list.length(toml.get_array(manifest, section + ".net")) > 0:
        out.push("BuildNet")
    out

// Translate a `[build.grants."name"]` section into `witchy build-step` flags:
// each granted read path (resolved relative to the project) → `--read`, env key →
// `--env`, exec tool → `--exec`, inherited child need → `--child-path`.
// (BuildOut needs no flag — it is the default.)
fn grant_flags(manifest: String, name: String, dir: String) -> List(String):
    var out = []
    let section = "build.grants.\"${name}\""
    for p in toml.get_array(manifest, section + ".read"):
        out.push("--read")
        out.push(normalize_path(join_path(dir, p)))
    for k in toml.get_array(manifest, section + ".env"):
        out.push("--env")
        out.push(k)
    for t in build_exec_programs(manifest, section):
        out.push("--exec")
        out.push(t)
    for p in build_exec_child_paths(manifest, section):
        out.push("--child-path")
        out.push(if p == "~" || p.starts_with("~/"): p else: normalize_path(join_path(dir, p)))
    // BUG-081: a granted BuildNet host must be plumbed to the confined build step
    // just like read/env/exec — one `--net <host:port>` per allowed address. (The
    // matching consumer of this flag in the compiler's `build-step` command is the
    // Rust TCB half; without it the grant is inert, but the policy plumbing is here.)
    for h in toml.get_array(manifest, section + ".net"):
        out.push("--net")
        out.push(h)
    out

// Preserve the original `exec = ["protoc"]` grant while accepting RFC-0103's
// richer `exec = { programs = [...], child-paths = [...] }` declaration.
fn build_exec_programs(manifest: String, section: String) -> List(String):
    match toml.get(manifest, section + ".exec"):
        Some(raw) ->
            if raw.trim().starts_with("{"):
                toml.inline_get_array(raw, "programs")
            else:
                toml.get_array(manifest, section + ".exec")
        None -> []

fn build_exec_child_paths(manifest: String, section: String) -> List(String):
    match toml.get(manifest, section + ".exec"):
        Some(raw) ->
            if raw.trim().starts_with("{"):
                toml.inline_get_array(raw, "child-paths")
            else:
                []
        None -> []

// The build-axis footprint of a source: the build capabilities its `build`
// entrypoint demands (`compiler.footprint`'s `build` array).
fn build_footprint(source: String) -> Result(List(String), FootprintError):
    footprint_values(compiler.footprint(source), "build")

// `greet.witchy` → module name `greet`.
fn module_stem(file: String) -> String:
    file.strip_suffix(".witchy")

// --- audit: the footprint a single file demands -----------------------------
fn cmd_audit(console: Console, root: Dir, file: String):
    if file.is_empty():
        console.print("usage: pm audit <file>")
    else:
        let report = compiler.footprint(root.read(file))
        match footprint_values(report, "total"):
            Ok(caps) -> console.print("${file} demands: ${list.join(caps, ", ")}")
            Err(e) -> console.print("${file} footprint error: ${footprint_error_message(e)}")

// --- check: declared footprint must admit the actual footprint ---------------
// The manifest's declared caps are *not trusted*: pm recomputes the footprint
// from source and fails if the code reaches for authority the manifest never
// admits — rights-precisely, so a declared `Net[Connect]` does NOT admit a
// demanded full `Net` (the under-declaration a supply-chain attacker relies on).
fn cmd_check(console: Console, root: Dir, dir: String) -> Int:
    if dir.is_empty():
        console.print("usage: pm check <dir>")
        1
    else:
        let manifest = root.read(join_path(dir, "witchy.toml"))
        let declared = declared_caps(manifest)
        let demanded = match rune_footprint(root, dir):
            Err(e) ->
                console.print("BLOCK: cannot compute the code's capability footprint: ${footprint_error_message(e)}")
                return 2
            Ok(caps) -> caps

        let undeclared = rights.uncovered(declared, demanded)
        let unused = unused_caps(declared, demanded)
        report_check(console, undeclared, unused)

fn report_check(console: Console, undeclared: List(String), unused: List(String)) -> Int:
    if !list.join(undeclared, ", ").is_empty():
        console.print("BLOCK: code demands authority not admitted by [capabilities]: ${list.join(undeclared, ", ")}")
        2
    else:
        if !list.join(unused, ", ").is_empty():
            console.print("OK (lint): declared but unused: ${list.join(unused, ", ")}")
        else:
            console.print("OK: declared footprint admits the code, nothing unused")
        0

// Declared capabilities that admit nothing the code demands.
fn unused_caps(declared: List(String), demanded: List(String)) -> List(String):
    var extra = []
    for d in declared:
        if !admits_any(d, demanded):
            extra.push(d)
    extra

fn admits_any(declared: String, demanded: List(String)) -> Bool:
    var any = false
    for c in demanded:
        if rights.covers(declared, c):
            any = true
    any

// --- guard: block an upgrade that widens authority --------------------------
fn cmd_guard(console: Console, root: Dir, old: String, new: String) -> Int:
    if old.is_empty() || new.is_empty():
        console.print("usage: pm guard <old-file> <new-file>")
        1
    else:
        match footprint_diff_values(compiler.diff(root.read(old), root.read(new))):
            Err(e) ->
                console.print("error: ${footprint_error_message(e)}")
                1
            Ok(diff) ->
                if diff.0:
                    console.print("BLOCK: upgrade widens authority by ${list.join(diff.1, ", ")}")
                    2
                else:
                    console.print("OK: no new authority")
                    0

// --- deps: list a rune's dependencies ---------------------------------------
fn cmd_deps(console: Console, root: Dir, dir: String):
    if dir.is_empty():
        console.print("usage: pm deps <dir>")
    else:
        let manifest = root.read(join_path(dir, "witchy.toml"))
        let deps = toml.table(manifest, "dependencies")
        if list.length(deps) == 0:
            console.print("(no dependencies)")
        else:
            for name, inline in deps:
                console.print("${name} -> ${dep_source(inline)}")

// tree <dir> — the rune and its dependency tree, indented. BUG-134: recurses into
// path dependencies (the transitive closure), not just the direct line; a registry
// dependency is a leaf (its own subtree lives in the registry, not on disk). A
// diamond/cycle terminates via the visited set.
fn cmd_tree(console: Console, root: Dir, dir: String):
    if dir.is_empty():
        console.print("usage: pm tree <dir>")
    else:
        let manifest = root.read(join_path(dir, "witchy.toml"))
        console.print(field(manifest, "rune.name"))
        if list.length(toml.table(manifest, "dependencies")) == 0:
            console.print("  (no dependencies)")
        else:
            tree_children(console, root, dir, "  ", [])

fn tree_children(console: Console, root: Dir, dir: String, indent: String, seen: List(String)):
    if root.exists(join_path(dir, "witchy.toml")):
        for name, inline in toml.table(root.read(join_path(dir, "witchy.toml")), "dependencies"):
            console.print("${indent}${name} (${dep_source(inline)})")
            if let Some(rel) = toml.inline_get(inline, "path"):
                if !seen.contains(name):
                    var next_seen = seen
                    next_seen.push(name)
                    tree_children(console, root, normalize_path(join_path(dir, rel)), "${indent}  ", next_seen)

// vendor <dir> — materialize path dependencies' sources into <dir>/vendor/<name>
// for offline, auditable builds. Copies each dep's src/*.witchy and manifest.
fn cmd_vendor(console: Console, root: Dir, dir: String) -> Int:
    if dir.is_empty():
        console.print("usage: pm vendor <dir>")
        1
    else:
        let vendor = join_path(dir, "vendor")
        if !root.exists(vendor):
            root.make_dir(vendor)
        // BUG-136: materialize the whole resolved PATH-dependency closure, not just
        // the direct manifest entries — a transitive path dep (`app -> lib -> base`)
        // must be vendored too, or an offline build can't resolve it. Deduplicated by
        // vendored name so a diamond/cycle terminates.
        let (_seen, count) = vendor_closure(root, dir, vendor, [], 0)
        console.print("vendored ${count} file(s) into ${vendor}")
        0

// Vendor the path-dependency closure rooted at `base` into `vendor/<name>`, walking
// each dep's own manifest recursively. Threads a visited set (import aliases already
// vendored) and a running file count.
fn vendor_closure(root: Dir, base: String, vendor: String, seen: List(String), count: Int) -> (List(String), Int):
    var visited = seen
    var total = count
    if root.exists(join_path(base, "witchy.toml")):
        for name, inline in toml.table(root.read(join_path(base, "witchy.toml")), "dependencies"):
            if let Some(rel) = toml.inline_get(inline, "path"):
                if !visited.contains(name):
                    visited.push(name)
                    let dep_dir = normalize_path(join_path(base, rel))
                    total = total + vendor_one(root, dep_dir, vendor, name)
                    let (v2, c2) = vendor_closure(root, dep_dir, vendor, visited, total)
                    visited = v2
                    total = c2
    (visited, total)

// Copy one dependency's `src/**/*.witchy` (+ its manifest) into `vendor/<name>`,
// returning the number of source files written.
fn vendor_one(root: Dir, dep_dir: String, vendor: String, name: String) -> Int:
    let dest = join_path(vendor, name)
    if !root.exists(dest):
        root.make_dir(dest)
    if !root.exists(join_path(dest, "src")):
        root.make_dir(join_path(dest, "src"))
    var count = 0
    for relpath, contents in fs.collect_files(root, join_path(dep_dir, "src"), "src", ".witchy"):
        fs.ensure_dir(root, join_path(dest, fs.parent_dir(relpath) ?? ""))
        root.write(join_path(dest, relpath), contents)
        count = count + 1
    if root.exists(join_path(dep_dir, "witchy.toml")):
        root.write(join_path(dest, "witchy.toml"), root.read(join_path(dep_dir, "witchy.toml")))
    count

// publish <dir> [host:port] [identity] — stage a rune to a coven registry. Reads
// the manifest + full src tree, builds the coven publish envelope, and POSTs it.
// The server recomputes the footprint and refuses an under-declared rune; a
// published version lands STAGED (not resolvable until a separate `promote`).
fn cmd_publish(console: Console, net: Net, root: Dir, env: Env, args: List(String)) -> Int:
    let dir = arg(args, 1)
    if dir.is_empty():
        console.print("usage: pm publish <dir> [host:port] [identity]")
        1
    else:
        let addr = coven_addr(env, arg(args, 2))
        let identity = if arg(args, 3).is_empty(): "ci-bot" else: arg(args, 3)
        match parse_origin(addr):
            Err(m) ->
                console.print("invalid registry address: ${m}")
                1
            Ok(shp) ->
                let (scheme, host, port) = shp
                let origin = registry_origin(scheme, host, port)
                let manifest = root.read(join_path(dir, "witchy.toml"))
                if has_path_dependency(manifest):
                    console.print("BLOCK: a published rune must be self-contained — it cannot have a path dependency (a published rune resolves only registry deps): ${list.join(path_deps(manifest), ", ")}")
                    1
                else:
                    publish_checked(console, net, root, dir, manifest, origin, identity, env)

// The wire envelope POST once the manifest has been validated. Split out of
// `cmd_publish` so its `else` arm stays shallow (the WASM codegen recurses per
// nesting level).
fn publish_checked(console: Console, net: Net, root: Dir, dir: String, manifest: String, origin: String, identity: String, env: Env) -> Int:
    let files = publish_files(root, dir, manifest)
    let token = id_token_from_env(env)
    let resp = registry_post(net, origin, "/coven/publish", coven_proto.publish_body(manifest, files, identity, token))
    let status = http.status(resp)
    let response_body = http.body(resp)
    let error = resp_field(response_body, "error")
    let detail = if error.is_empty(): "" else: " error=${error}"
    console.print("publish: ${status} state=${resp_field(response_body, "state")}${detail}")
    if status >= 200 && status < 300:
        0
    else:
        1

// Whether the manifest declares any path dependency (`{ path = ... }`). A published
// rune must be self-contained / registry-only, so publish refuses these.
fn has_path_dependency(manifest: String) -> Bool:
    list.length(path_deps(manifest)) > 0

// The names of the manifest's path dependencies, for the refusal message.
fn path_deps(manifest: String) -> List(String):
    var out = []
    for name, inline in toml.table(manifest, "dependencies"):
        if let Some(_rel) = toml.inline_get(inline, "path"):
            out.push(name)
    out

// The trusted-publishing identity token from COVEN_ID_TOKEN (a compact OIDC JWT), passed
// through opaquely; None when unset (an anonymous `uploaded_by` publish). This is the
// trusted-publishing CLIENT flow: the server verifies the token against its per-namespace
// trust policy.
fn id_token_from_env(env: Env) -> Option(String):
    env.get_env("COVEN_ID_TOKEN")

// The coven registry address: the explicit arg if given, else `COVEN_URL` from
// the environment (the Rust CLI's convention), else the default. The scheme is
// PRESERVED — `https://coven.example` stays an https origin; a bare `host:port`
// keeps meaning http (loopback compat). The bootstrap auto-grants Net to
// `COVEN_URL` so no explicit `--net` is needed.
fn coven_addr(env: Env, arg_addr: String) -> String:
    if !arg_addr.is_empty():
        arg_addr
    else:
        match env.get_env("COVEN_URL"):
            Some(u) -> u
            None -> "127.0.0.1:8787"

// promote <name> <version> [host:port] [identity] — release a staged version.
// Trusted registries require COVEN_ID_TOKEN to carry an IdP-attested MFA/WebAuthn
// `amr`; the body marker below is only confirmation for anonymous local mode.
fn cmd_promote(console: Console, net: Net, env: Env, args: List(String)) -> Int:
    let name = arg(args, 1)
    let version = arg(args, 2)
    if name.is_empty() || version.is_empty():
        console.print("usage: pm promote <name> <version> [host:port] [identity]")
        1
    else:
        let addr = coven_addr(env, arg(args, 3))
        let identity = if arg(args, 4).is_empty(): "release-human" else: arg(args, 4)
        match parse_origin(addr):
            Err(m) ->
                console.print("invalid registry address: ${m}")
                1
            Ok(shp) ->
                let (scheme, host, port) = shp
                let origin = registry_origin(scheme, host, port)
                let body = coven_proto.promote_body(name, version, "local-confirmation", identity, id_token_from_env(env))
                let resp = registry_post(net, origin, "/coven/promote", body)
                console.print("promote: ${http.status(resp)}")
                if http.status(resp) >= 200 && http.status(resp) < 300:
                    0
                else:
                    1

// outdated <dir> <coven-host:port> — for each registry dependency, show its
// requirement and the latest released version available. Flattened into shallow
// helpers (deep `for`/`if`/`match` nesting in one fn overflowed codegen).
fn cmd_outdated(console: Console, net: Net, root: Dir, args: List(String)) -> Int:
    let dir = arg(args, 1)
    let addr = arg(args, 2)
    if dir.is_empty() || addr.is_empty():
        console.print("usage: pm outdated <dir> <coven-host:port>")
        1
    else:
        match parse_origin(addr):
            Err(m) ->
                console.print("invalid registry address: ${m}")
                1
            Ok(shp) ->
                let (scheme, host, port) = shp
                let origin = registry_origin(scheme, host, port)
                let manifest = root.read(join_path(dir, "witchy.toml"))
                for pair in toml.table(manifest, "dependencies"):
                    report_dep_version(console, net, origin, pair)
                0

fn report_dep_version(console: Console, net: Net, origin: String, pair: (String, String)):
    let (name, inline) = pair
    if let Some(req) = toml.inline_get(inline, "version"):
        let resp = registry_get(net, origin, "/coven/versions?name=${wire(name)}")
        console.print("${name}: req ${req}, ${latest_label(http.body(resp), http.status(resp))}")

fn latest_label(body: String, status: Int) -> String:
    if status != 200:
        "registry error"
    else:
        match released_version_records(body):
            Err(e) -> version_resolve_error_message(e)
            Ok(records) -> latest_label_of(latest_version(list.map(records, fn(record: (Version, Int)): record.0)))

fn latest_label_of(v: Option(Version)) -> String:
    match v:
        Some(ver) -> "latest ${semver.format(ver)}"
        None -> "no released versions"

fn latest_version(versions: List(Version)) -> Option(Version):
    var best = None
    for v in versions:
        let take = match best:
            None -> true
            Some(b) -> semver.less(b, v)

        if take:
            best = Some(v)
    best

// yank <name> <version> [host:port] — flag a released version (re-signs the
// record as yanked); existing locks still resolve it, new resolutions skip it.
fn cmd_yank(console: Console, net: Net, env: Env, args: List(String)) -> Int:
    let name = arg(args, 1)
    let version = arg(args, 2)
    if name.is_empty() || version.is_empty():
        console.print("usage: pm yank <name> <version> [host:port]")
        1
    else:
        let addr = coven_addr(env, arg(args, 3))
        match parse_origin(addr):
            Err(m) ->
                console.print("invalid registry address: ${m}")
                1
            Ok(shp) ->
                let (scheme, host, port) = shp
                let origin = registry_origin(scheme, host, port)
                let resp = registry_post(net, origin, "/coven/yank", coven_proto.yank_body(name, version, id_token_from_env(env)))
                console.print("yank: ${http.status(resp)}")
                if http.status(resp) >= 200 && http.status(resp) < 300:
                    0
                else:
                    1

// list <name> [host:port] — every version of a rune the registry knows, with its
// lifecycle state (staged / released / yanked). The registry comes from the
// explicit arg or COVEN_URL. Reads /coven/versions and prints `<version> <state>`
// per record so a consumer can see what is resolvable before adding.
fn cmd_list(console: Console, net: Net, env: Env, args: List(String)) -> Int:
    let name = arg(args, 1)
    if name.is_empty():
        console.print("usage: pm list <name> [host:port]")
        1
    else:
        let addr = coven_addr(env, arg(args, 2))
        match parse_origin(addr):
            Err(m) ->
                console.print("invalid registry address: ${m}")
                1
            Ok(shp) ->
                let (scheme, host, port) = shp
                let origin = registry_origin(scheme, host, port)
                let resp = registry_get(net, origin, "/coven/versions?name=${wire(name)}")
                if http.status(resp) != 200:
                    console.print("registry error listing ${name}")
                    1
                else:
                    print_versions(console, name, http.body(resp))

fn print_versions(console: Console, name: String, body: String) -> Int:
    var any = false
    for rec in version_records(body):
        any = true
        console.print("${name}@${jget(rec, "version")} ${jget(rec, "state")}")
    if !any:
        console.print("${name}: no versions")
    0

// Presentation-only projection for `pm list`: an unavailable or malformed
// response renders as no rows. Install/update decisions use the strict typed
// `released_version_records` boundary below.
fn version_records(body: String) -> List(Json):
    var out = []
    if let Ok(doc) = json.decode(body):
        if let Some(records) = json.get(doc, "records"):
            if let Some(items) = json.as_array(records):
                out = items
    out

// The manifest plus every `src/**/*.witchy`, as (path, contents) — the source
// tree the registry content-addresses and footprints.
fn publish_files(root: Dir, dir: String, manifest: String) -> List((String, String)):
    var out = [("witchy.toml", manifest)]
    for f in fs.collect_files(root, join_path(dir, "src"), "src", ".witchy"):
        out.push(f)
    out

fn resp_field(text: String, key: String) -> String:
    match json.decode(text):
        Ok(doc) -> match json.get_string(doc, key):
            Some(v) -> v
            None -> "?"
        Err(_e) -> "?"

// why <dir> <name> — explain a dependency's presence in the rune. BUG-134: reports
// a transitive dependency too, tracing the path from the root to it (`app -> lib ->
// name`), not only a direct match.
fn cmd_why(console: Console, root: Dir, dir: String, name: String) -> Int:
    if dir.is_empty() || name.is_empty():
        console.print("usage: pm why <dir> <name>")
        1
    else:
        let manifest = root.read(join_path(dir, "witchy.toml"))
        var direct = false
        for dep, inline in toml.table(manifest, "dependencies"):
            if dep == name:
                direct = true
                console.print("${name} — direct dependency (${dep_source(inline)})")
        if !direct:
            match why_path(root, dir, name, []):
                Some(chain) -> console.print("${name} — transitive dependency (${chain})")
                None -> console.print("${name} is not a dependency of this rune (directly or transitively)")

        0

// The dependency path from `dir` down to `target` (import names joined by ` -> `),
// or None if `target` is not reachable through the path-dependency closure.
fn why_path(root: Dir, dir: String, target: String, seen: List(String)) -> Option(String):
    var found = None
    if root.exists(join_path(dir, "witchy.toml")):
        for name, inline in toml.table(root.read(join_path(dir, "witchy.toml")), "dependencies"):
            if found.is_none():
                if name == target:
                    found = Some(name)
                else:
                    if let Some(rel) = toml.inline_get(inline, "path"):
                        if !seen.contains(name):
                            var next_seen = seen
                            next_seen.push(name)
                            if let Some(sub) = why_path(root, normalize_path(join_path(dir, rel)), target, next_seen):
                                found = Some("${name} -> ${sub}")
    found

// why-cap <dir> <Cap> — which dependencies introduce a capability into the tree.
fn cmd_why_cap(console: Console, root: Dir, dir: String, cap: String) -> Int:
    if dir.is_empty() || cap.is_empty():
        console.print("usage: pm why-cap <dir> <Cap>")
        1
    else:
        match gate_contributors(root, dir, cap):
            Err(e) ->
                console.print("cannot inspect dependency authority: ${footprint_error_message(e)}")
                1
            Ok(who) ->
                if list.length(who) == 0:
                    console.print("no dependency demands ${cap}")
                else:
                    for name in who:
                        console.print("${name} demands ${cap}")
                0

// init [name] — add a manifest + src stub to the CURRENT directory (vs `new`,
// which creates a new subdirectory). No-op if it is already a rune.
fn cmd_init(console: Console, root: Dir, dir: String) -> Int:
    let name = if dir.is_empty(): "app" else: dir
    if !valid_scaffold_name(name):
        // BUG-200: same up-front validation as `pm new`.
        console.print(scaffold_name_error(name))
        1
    else if root.exists("witchy.toml"):
        console.print("already a rune: witchy.toml")
        0
    else:
        if !root.exists("src"):
            root.make_dir("src")
        root.write("witchy.toml", manifest_stub(name))
        let stub = join_path("src", "${module_name(name)}.witchy")
        if !root.exists(stub):
            root.write(stub, src_stub(name))
        console.print("initialized rune `${name}` in the current directory")
        0

fn dep_source(let inline: String) -> String:
    match toml.inline_get(inline, "path"):
        Some(p) -> "path:${p}"
        None -> version_source(inline)

fn version_source(let inline: String) -> String:
    match toml.inline_get(inline, "version"):
        Some(v) -> "version:${v}"
        None -> "(unspecified)"

// --- lock: pin every dependency by content hash ------------------------------
// The lockfile is regenerated from source, so it can never disagree with the
// bytes on disk: `lock` writes the hashes, `verify` recomputes and compares.
fn cmd_lock(console: Console, root: Dir, dir: String) -> Int:
    if dir.is_empty():
        console.print("usage: pm lock <dir>")
        1
    else:
        let manifest = root.read(join_path(dir, "witchy.toml"))
        let problems = lock_problems(root, dir, manifest)
        if list.length(problems) > 0:
            // BUG-192/193/194: fail at the manifest boundary rather than serialize a
            // sentinel version, a mismatched identity, or an unresolved registry
            // placeholder and still report success.
            for p in problems:
                console.print(p)
            2
        else:
            // BUG-047/101/135: pin the full transitive path-dep closure — count what
            // was actually locked, not just the direct manifest entries.
            match generate_lock(root, dir):
                Err(e) ->
                    console.print("BLOCK: cannot lock an uninspectable dependency: ${footprint_error_message(e)}")
                    2
                Ok(lock) ->
                    let n = list.length(path_closure(root, dir))
                    let lockpath = join_path(dir, "witchy.lock")
                    root.write(lockpath, lock)
                    console.print("locked ${n} dependencies -> ${lockpath}")
                    0

// The transitive path-dependency closure of the rune at `dir`, as (import-name,
// resolved-dir) pairs. Walks each dependency's own manifest, deduplicated by import
// name so a diamond/cycle terminates. Resolved dirs are relative to the project Dir.
fn path_closure(root: Dir, dir: String) -> List((String, String)):
    path_closure_rec(root, dir, [])

fn path_closure_rec(root: Dir, base: String, acc: List((String, String))) -> List((String, String)):
    var out = acc
    if root.exists(join_path(base, "witchy.toml")):
        for name, inline in toml.table(root.read(join_path(base, "witchy.toml")), "dependencies"):
            if let Some(rel) = toml.inline_get(inline, "path"):
                if !closure_has(out, name):
                    let dep_dir = normalize_path(join_path(base, rel))
                    out.push((name, dep_dir))
                    out = path_closure_rec(root, dep_dir, out)
    out

fn closure_has(xs: List((String, String)), name: String) -> Bool:
    var found = false
    for x in xs:
        if x.0 == name:
            found = true
    found

// Validate every dependency BEFORE `pm lock` turns it into lock evidence, returning
// a `BLOCK:` diagnostic per offending dependency (empty = OK to lock):
//   * a registry (non-path) dependency cannot be locked by `pm lock` — it is
//     resolved and pinned by `pm add` (BUG-194: no unresolved `source = "coven"`
//     placeholder written as success);
//   * a path dependency whose manifest omits `rune.version` (BUG-192: no `(none)`
//     sentinel serialized as a version);
//   * a path dependency whose declared key disagrees with the dependency's own
//     `rune.name` identity (BUG-193: the manifest is the identity, not the key).
fn lock_problems(root: Dir, dir: String, manifest: String) -> List(String):
    var out = []
    for name, inline in toml.table(manifest, "dependencies"):
        match toml.inline_get(inline, "path"):
            None ->
                out.push("BLOCK: `${name}` is a registry dependency — `pm lock` locks path dependencies only; run `pm add ${name}` to resolve and pin it")
            Some(rel) ->
                let dep_toml = join_path(normalize_path(join_path(dir, rel)), "witchy.toml")
                if !root.exists(dep_toml):
                    out.push("BLOCK: path dependency `${name}` has no witchy.toml at ${rel}")
                else:
                    let dep_manifest = root.read(dep_toml)
                    out = check_path_identity(out, name, rel, dep_manifest)
    out

fn check_path_identity(problems: List(String), name: String, rel: String, dep_manifest: String) -> List(String):
    var out = problems
    match toml.get(dep_manifest, "rune.version"):
        None ->
            out.push("BLOCK: path dependency `${name}` (${rel}) has no rune.version in its witchy.toml — cannot pin a version")
        Some(_v) -> out = out
    match toml.get(dep_manifest, "rune.name"):
        None ->
            out.push("BLOCK: path dependency `${name}` (${rel}) has no rune.name in its witchy.toml")
        Some(realname) ->
            if realname != name && basename(realname) != name:
                out.push("BLOCK: path dependency key `${name}` does not match its manifest identity `${realname}` (${rel})")
    out

// --- verify: offline lock/signature/provenance verification ------------------
// The default command is deliberately network-independent: it applies the same
// complete lock-integrity gate as build/run. `--online` adds a second TUF
// freshness/rollback phase against the configured registry; it never substitutes
// for the offline source + signed-record checks.
fn cmd_verify(console: Console, net: Net, root: Dir, env: Env, clock: Clock, args: List(String)) -> Int:
    let first = arg(args, 1)
    let target: String = if first == "--online": "" else: first
    let dir = if target.is_empty(): "." else: target
    let online = first == "--online" || arg(args, 2) == "--online"
    match verify_lock_integrity(root, dir):
        Err(e) ->
            console.print(lock_integrity_error_message(e))
            2
        Ok(_) ->
            console.print("OK: every locked hash matches the dependency sources")
            if online:
                let lock = root.read(join_path(dir, "witchy.lock"))
                verify_tuf(console, net, root, env, clock, dir, lock)
            else:
                0

// --- TUF chain verification (client side) ------------------------------------
// `add` pins the registry's TUF snapshot version into the lock; `verify --online` re-fetches
// the signed snapshot + timestamp roles and re-checks the whole chain against the
// registry root key, refusing a tampered role or a rollback. The registry only
// PRODUCES these roles (coven_meta); the front-end is the verifier. Checks (the
// signature, content-binding, version-match, rollback, AND freshness/`expires`
// links are all enforced — the front-end holds a Clock, so the previously-omitted
// expiry check now runs):
//   1. timestamp signed by the root key
//   2. snapshot signed by the root key
//   3. sha256(canonical(snapshot)) == timestamp.snapshot_hash   (content binding)
//   4. snapshot.version == timestamp.snapshot_version           (role agreement)
//   5. snapshot.version >= the version pinned in witchy.lock    (no rollback)
//   6. each vendored registry dep's record digest is the snapshot's target digest
fn verify_tuf(console: Console, net: Net, root: Dir, env: Env, clock: Clock, dir: String, lock: String) -> Int:
    match pinned_registry_trust(lock):
        // BUG-204/572: malformed or incomplete trust state is a lockfile
        // diagnostic, never an internal trap or a downgrade to unpinned trust.
        Err(e) ->
            console.print("BLOCK: ${lock_pin_error_message(e)}")
            2
        // No registry deps were added, so there is no registry trust state to verify.
        Ok(None) -> 0
        Ok(Some(trust)) ->
            let pinned = trust.0
            let pinned_pub = trust.1
            match parse_origin(coven_addr(env, "")):
                Err(m) ->
                    console.print("invalid registry address: ${m}")
                    2
                Ok(shp) ->
                    let (scheme, host, port) = shp
                    let origin = registry_origin(scheme, host, port)
                    verify_chain(console, net, root, dir, origin, pinned, pinned_pub, clock)

fn verify_chain(console: Console, net: Net, root: Dir, dir: String, origin: String, pinned: Int, pinned_pub: String, clock: Clock) -> Int:
    match fetch_registry_rootpub(net, origin):
        Err(e) ->
            console.print("FAIL: TUF chain — ${registry_root_key_error_message(e)}")
            2
        Ok(rootpub) ->
            // SEC-002: the root key is the trust anchor for the whole chain. Refuse
            // one different from the complete trust record in witchy.lock.
            if pinned_pub != rootpub:
                console.print("FAIL: TUF chain — registry root key does not match the key pinned in witchy.lock (possible MITM / hostile mirror)")
                2
            else:
                let snap_resp = registry_get(net, origin, "/coven/snapshot")
                let ts_resp = registry_get(net, origin, "/coven/timestamp")
                if http.status(snap_resp) != 200 || http.status(ts_resp) != 200:
                    console.print("FAIL: TUF chain — registry served no snapshot/timestamp role")
                    2
                else:
                    check_chain(console, root, dir, rootpub, http.body(snap_resp), http.body(ts_resp), pinned, clock)

fn check_chain(console: Console, root: Dir, dir: String, rootpub: String, snap_env: String, ts_env: String, pinned: Int, clock: Clock) -> Int:
    let snap_signed = signed_canonical(snap_env)
    let ts_signed = signed_canonical(ts_env)
    if !signed_valid(rootpub, ts_env):
        console.print("FAIL: TUF chain — the timestamp role is not validly signed by the registry root key (tampered)")
        2
    else if !signed_valid(rootpub, snap_env):
        console.print("FAIL: TUF chain — the snapshot role is not validly signed by the registry root key (tampered)")
        2
    else if !snapshot_schema_ok(snap_env):
        // BUG-386: a role can be validly signed yet structurally incomplete. Reject a
        // snapshot missing an integer `version` or an object `targets` BEFORE the
        // version/rollback comparisons, so a missing field can't default to 0 and
        // compare equal to a pinned 0 (nor pass with an empty vendor tree).
        console.print("FAIL: TUF chain — the snapshot role is structurally malformed (needs an integer `version` and an object `targets`) — refusing")
        2
    else if !timestamp_schema_ok(ts_env):
        console.print("FAIL: TUF chain — the timestamp role is structurally malformed (needs an integer `snapshot_version`, a string `snapshot_hash`, and an integer `expires`) — refusing")
        2
    else if "sha256:${crypto.sha256(snap_signed)}" != signed_field_str(ts_env, "snapshot_hash"):
        console.print("FAIL: TUF chain — the snapshot does not match the timestamp's pinned hash (tampered)")
        2
    else if signed_field_int(snap_env, "version") != signed_field_int(ts_env, "snapshot_version"):
        console.print("FAIL: TUF chain — snapshot and timestamp disagree on the snapshot version (tampered)")
        2
    else if signed_field_int(snap_env, "version") < pinned:
        console.print("FAIL: TUF chain — the registry's snapshot version ${signed_field_int(snap_env, "version")} is older than the pinned ${pinned}: the metadata has been rolled back")
        2
    else if signed_field_int(ts_env, "expires") < clock.now() / 1000:
        // SEC-017: TUF freshness — refuse a stale-but-validly-signed timestamp (a freeze /
        // replay of old metadata up to the pinned floor). coven sets `expires` 24h out; the
        // front-end holds a Clock, so the check that was previously omitted now runs.
        console.print("FAIL: TUF chain — the registry timestamp role expired at ${signed_field_int(ts_env, "expires")} (now ${clock.now() / 1000}): stale metadata (freeze/replay)")
        2
    else:
        check_targets(console, root, dir, snap_env)

// Every vendored registry dep's signed-record digest must equal the snapshot's
// target digest for its `name@version` — a dep whose record was swapped out from
// under the snapshot is rejected.
fn check_targets(console: Console, root: Dir, dir: String, snap_env: String) -> Int:
    let targets = signed_field(snap_env, "targets")
    var bad = []
    for entry in vendored_runes(root, dir):
        let coven = root.read(join_path(entry, "coven.json"))
        // BUG-275: a vendored record that exists but does not parse cannot be
        // compared to the snapshot target — fail closed, don't silently skip it.
        match json.decode(coven):
            Ok(doc) ->
                let key = "${jget(doc, "name")}@${jget(doc, "version")}"
                let want = target_digest(targets, key)
                match record_payload(doc):
                    Some(payload) ->
                        let have = "sha256:${crypto.sha256(payload)}"
                        if want != have:
                            bad.push(key)
                    None ->
                        bad.push("${key} (malformed coven.json)")
            Err(_e) ->
                bad.push("${entry} (unparseable coven.json)")
    if list.length(bad) == 0:
        console.print("OK: TUF chain verified (snapshot + timestamp signatures, content binding, no rollback)")
        0
    else:
        console.print("FAIL: TUF chain — vendored record digest does not match the snapshot target for: ${list.join(bad, ", ")}")
        2

// The vendored rune directories (those carrying a coven.json) under <dir>/vendor.
fn vendored_runes(root: Dir, dir: String) -> List(String):
    var out = []
    let vendor = join_path(dir, "vendor")
    if root.exists(vendor):
        for entry in root.subtree(vendor).list():
            let rune_dir = join_path(vendor, entry)
            if root.exists(join_path(rune_dir, "coven.json")):
                out.push(rune_dir)
    out

// The digest a snapshot pins for `key` (`name@version`), or "" if absent.
fn target_digest(targets: Json, key: String) -> String:
    match json.get(targets, key):
        Some(j) -> match json.as_string(j):
            Some(s) -> s
            None -> ""
        None -> ""

// A `Signed{signed, sig}` envelope's canonical bytes — `json.encode` of the
// `signed` member, byte-identical to what coven signed (coven signs `encode(role)`
// and json round-trips key order, so re-encoding the decoded role reproduces it).
fn signed_canonical(envelope: String) -> String:
    match json.decode(envelope):
        Ok(doc) -> match json.get(doc, "signed"):
            Some(signed) -> json.encode(signed)
            None -> ""
        Err(_e) -> ""

// Verify a `Signed{signed, sig}` envelope against the root pubkey over its canonical bytes.
fn signed_valid(rootpub: String, envelope: String) -> Bool:
    match json.decode(envelope):
        Ok(doc) ->
            match crypto.ed25519_verify(rootpub, signed_canonical(envelope), jget(doc, "sig")):
                Ok(true) -> true
                Ok(false) -> false
                Err(_e) -> false
        Err(_e) -> false

// A string field of the `signed` member of a `Signed{...}` envelope.
fn signed_field_str(envelope: String, key: String) -> String:
    match json.decode(envelope):
        Ok(doc) -> match json.get(doc, "signed"):
            Some(signed) -> match json.get_string(signed, key):
                Some(s) -> s
                None -> ""
            None -> ""
        Err(_e) -> ""

// An int field of the `signed` member of a `Signed{...}` envelope.
fn signed_field_int(envelope: String, key: String) -> Int:
    match json.decode(envelope):
        Ok(doc) -> match json.get(doc, "signed"):
            Some(signed) -> match json.get_int(signed, key):
                Some(n) -> n
                None -> 0
            None -> 0
        Err(_e) -> 0

// A Json field of the `signed` member of a `Signed{...}` envelope (e.g. `targets`).
fn signed_field(envelope: String, key: String) -> Json:
    match json.decode(envelope):
        Ok(doc) -> match json.get(doc, "signed"):
            Some(signed) -> json.get(signed, key).unwrap_or(JsonNull)
            None -> JsonNull
        Err(_e) -> JsonNull

// The decoded `signed` payload of a `Signed{...}` envelope, or None. The strict
// counterpart the schema checks below build on (BUG-386): unlike `signed_field*`,
// which default a missing field to 0/""/JsonNull, these distinguish "absent or
// wrong-typed" from "present and correctly typed".
fn signed_payload(envelope: String) -> Option(Json):
    match json.decode(envelope):
        Ok(doc) -> json.get(doc, "signed")
        Err(_e) -> None

fn signed_has_int(envelope: String, key: String) -> Bool:
    match signed_payload(envelope):
        None -> false
        Some(signed) -> match json.get(signed, key):
            Some(j) -> match json.as_int(j):
                Some(_n) -> true
                None -> false
            None -> false

fn signed_has_str(envelope: String, key: String) -> Bool:
    match signed_payload(envelope):
        None -> false
        Some(signed) -> match json.get(signed, key):
            Some(j) -> match json.as_string(j):
                Some(_s) -> true
                None -> false
            None -> false

fn signed_has_object(envelope: String, key: String) -> Bool:
    match signed_payload(envelope):
        None -> false
        Some(signed) -> match json.get(signed, key):
            Some(j) -> match json.as_object(j):
                Some(_o) -> true
                None -> false
            None -> false

// The signed snapshot role must carry an integer `version` and an object `targets`;
// the signed timestamp role an integer `snapshot_version`, a string `snapshot_hash`,
// and an integer `expires`. Enforced after the signatures verify, so a signed but
// structurally incomplete role fails closed instead of flowing through with
// defaulted fields (BUG-386).
fn snapshot_schema_ok(envelope: String) -> Bool:
    signed_has_int(envelope, "version") && signed_has_object(envelope, "targets")

fn timestamp_schema_ok(envelope: String) -> Bool:
    signed_has_int(envelope, "snapshot_version") && signed_has_str(envelope, "snapshot_hash") && signed_has_int(envelope, "expires")

// Registry trust is one atomic lock invariant: either neither pin exists (a
// path-only project), or a non-negative snapshot version and a 32-byte Ed25519
// root key exist together. Treating either half as optional silently degrades an
// existing registry lock back to trust-on-first-use (BUG-572).
fn pinned_registry_trust(lock: String) -> Result(Option((Int, String)), LockPinError):
    let snapshot = toml.get(lock, "registry_snapshot_version")
    let rootpub = toml.get(lock, "registry_rootpub")
    match snapshot:
        None -> match rootpub:
            None -> Ok(None)
            Some(_key) -> Err(LockPinRootWithoutSnapshot)
        Some(raw_version) -> match rootpub:
            None -> Err(LockPinSnapshotWithoutRoot)
            Some(key) ->
                let version = parse_snapshot_pin(raw_version)?
                if valid_registry_rootpub(key):
                    Ok(Some((version, key)))
                else:
                    Err(LockPinRootMalformed)

fn parse_snapshot_pin(value: String) -> Result(Int, LockPinError):
    match value.parse_int():
        Some(n) ->
            if n < 0:
                Err(LockPinNegative(value))
            else:
                Ok(n)
        None -> Err(LockPinNotInteger(value))

fn valid_registry_rootpub(value: String) -> Bool:
    match encoding.hex_decode_bytes(value):
        Ok(decoded) -> bytes.length(decoded) == 32
        Err(_e) -> false

// The pinned registry root for network trust checks. A project with no lock or a
// path-only lock is unpinned; any partial/malformed registry trust record is Err.
fn pinned_registry_rootpub(root: Dir) -> Result(String, LockPinError):
    if !root.exists("witchy.lock"):
        Ok("")
    else:
        match pinned_registry_trust(root.read("witchy.lock")):
            Err(e) -> Err(e)
            Ok(None) -> Ok("")
            Ok(Some(trust)) -> Ok(trust.1)

type LockPinError:
    LockPinNegative(String)
    LockPinNotInteger(String)
    LockPinSnapshotWithoutRoot
    LockPinRootWithoutSnapshot
    LockPinRootMalformed

fn lock_pin_error_message(e: LockPinError) -> String:
    match e:
        LockPinNegative(v) -> "invalid witchy.lock registry_snapshot_version `${v}` (must not be negative)"
        LockPinNotInteger(v) -> "invalid witchy.lock registry_snapshot_version `${v}` (not an integer)"
        LockPinSnapshotWithoutRoot -> "invalid witchy.lock registry trust: registry_snapshot_version is present but registry_rootpub is missing"
        LockPinRootWithoutSnapshot -> "invalid witchy.lock registry trust: registry_rootpub is present but registry_snapshot_version is missing"
        LockPinRootMalformed -> "invalid witchy.lock registry_rootpub (expected a 32-byte Ed25519 public key encoded as hex)"

impl Show for LockPinError:
    fn show(self) -> String:
        lock_pin_error_message(self)

impl Error for LockPinError

impl From(LockPinError) for String:
    fn from(value: LockPinError) -> Self:
        lock_pin_error_message(value)

type RegistryRootKeyError:
    RegistryRootKeyUnavailable(Int)
    RegistryRootKeyMalformed

fn registry_root_key_error_message(e: RegistryRootKeyError) -> String:
    match e:
        RegistryRootKeyUnavailable(status) -> "registry root key is unavailable (HTTP ${status})"
        RegistryRootKeyMalformed -> "registry root key is malformed (expected a 32-byte Ed25519 public key encoded as hex)"

impl Show for RegistryRootKeyError:
    fn show(self) -> String:
        registry_root_key_error_message(self)

impl Error for RegistryRootKeyError

impl From(RegistryRootKeyError) for String:
    fn from(value: RegistryRootKeyError) -> Self:
        registry_root_key_error_message(value)

// The path-dependency names whose recomputed hash differs from the lockfile's.
// BUG-047/135: walks the full transitive path-dep closure, not just the direct
// manifest entries — a tampered (or unpinned) transitive dep is caught too. A
// closure member absent from the lock recomputes to a hash that can't match the
// "(absent)" sentinel, so it is reported.
fn hash_mismatches(root: Dir, dir: String, lock: String) -> Result(List(String), LockIntegrityError):
    var bad = []
    for name, dep_dir in path_closure(root, dir):
        if rune_hash(root, dep_dir) != locked_hash(lock, name)?:
            bad.push(name)
    Ok(bad)

// The `hash` field of the `[[rune]]` entry named `name`, or "(absent)". A
// malformed lockfile is an explicit error (BUG-373), never a silent "(absent)"
// that would let hash verification pass on a corrupted lock.
fn locked_hash(lock: String, name: String) -> Result(String, LockIntegrityError):
    var found = "(absent)"
    for entry in lock_rune_entries(lock)?:
        if entry_name(entry) == name:
            found = entry_hash(entry)
    Ok(found)

fn entry_name(entry: Toml) -> String:
    optional_lock_string(entry, "name", "")

// The local import alias (basename) of a `[[rune]]` lock entry: the explicit
// `alias` field written by `pm add` (BUG-099), or — for older locks / path
// entries that carry no `alias` — the basename of the registry `name`.
fn entry_alias(entry: Toml) -> String:
    let alias = optional_lock_string(entry, "alias", "")
    if alias.is_empty():
        basename(entry_name(entry))
    else:
        alias

// A best-effort string field of a decoded `[[rune]]` entry for the advisory
// (non-verifying) readers: the value when present and a string, else `fallback`.
// A wrong-kind value reads as the fallback — these readers cannot fail, and the
// verifying path (`required_lock_field`) is where a wrong kind becomes an error.
fn optional_lock_string(entry: Toml, field: String, fallback: String) -> String:
    match toml.optional_string(entry, field):
        Ok(Some(s)) -> s
        Ok(None) -> fallback
        Err(_) -> fallback

fn entry_hash(entry: Toml) -> String:
    optional_lock_string(entry, "hash", "(no-hash)")

// --- gate: block any dependency that demands new authority -------------------
// The supply-chain gate (§10), rights-aware. It recomputes the footprint the
// dependency sources actually demand and blocks any capability the lockfile's
// recorded baseline doesn't already admit — the upgrade/tamper that quietly
// widens authority. Capabilities listed after <dir> are accepted (like
// `--allow-cap`), folding into the baseline so an intended widening passes.
fn cmd_gate(console: Console, root: Dir, args: List(String)) -> Int:
    let dir = arg(args, 1)
    if dir.is_empty():
        console.print("usage: pm gate <dir> [allowed-cap..]")
        1
    else if !root.exists(join_path(dir, "witchy.lock")):
        console.print("no witchy.lock — run `pm lock ${dir}` first")
        1
    else:
        let lock = root.read(join_path(dir, "witchy.lock"))
        match lock_baseline(lock):
            Err(e) ->
                console.print("BLOCK: cannot read witchy.lock — ${lock_integrity_error_message(e)}")
                2
            Ok(recorded) ->
                let baseline = union_all(recorded, args_from(args, 2))
                match resolution_footprint(root, dir):
                    Err(e) ->
                        console.print("BLOCK: cannot inspect dependency authority: ${footprint_error_message(e)}")
                        2
                    Ok(demanded) -> report_gate(console, root, dir, rights.uncovered(baseline, demanded))

fn report_gate(console: Console, root: Dir, dir: String, widened: List(String)) -> Int:
    if list.length(widened) == 0:
        console.print("OK: dependencies demand no authority beyond witchy.lock")
        0
    else:
        console.print("BLOCK: dependencies demand new authority: ${list.join(widened, ", ")}")
        for cap in widened:
            match gate_contributors(root, dir, cap):
                Ok(who) -> console.print("  ${cap} <- ${list.join(who, ", ")}")
                Err(e) -> console.print("  ${cap} <- inspection error: ${footprint_error_message(e)}")

        2

// The capabilities the lockfile already records (union of every [[rune]] entry's
// runtime_footprint) — the baseline the gate diffs a new resolution against. A
// malformed lockfile is an explicit error (BUG-373), never a silently-empty
// baseline: an empty baseline would make the gate treat EVERY demanded capability
// as new authority (or, worse, mask a corrupted lock), so the gate must fail
// closed with the parse error instead.
fn lock_baseline(lock: String) -> Result(List(String), LockIntegrityError):
    var out = []
    for entry in lock_rune_entries(lock)?:
        match toml.string_array_field(entry, "runtime_footprint"):
            Err(e) -> return Err(LockEntryMalformed(toml.decode_error_message(e)))
            Ok(caps) ->
                for cap in caps:
                    out = add_unique(out, cap)
    Ok(out)

// The aggregate authority the current dependency sources demand. BUG-080: the whole
// transitive path-dep closure (not just direct entries), each dep's footprint being
// the union over ALL its src modules (rune_footprint, BUG-085) — matching coven's
// computed_footprint, so the local gate can't miss a capability a transitive dep or
// a non-entry module reaches for.
fn resolution_footprint(root: Dir, dir: String) -> Result(List(String), FootprintError):
    var out = []
    for _name, dep_dir in path_closure(root, dir):
        let caps = rune_footprint(root, dep_dir)?
        for cap in caps:
            out = add_unique(out, cap)
    Ok(out)

// The dependencies whose own footprint covers `cap` — who introduced it. Walks the
// transitive closure (BUG-080/134), so `why-cap` names a deep contributor too.
fn gate_contributors(root: Dir, dir: String, cap: String) -> Result(List(String), FootprintError):
    var who = []
    for name, dep_dir in path_closure(root, dir):
        let caps = rune_footprint(root, dep_dir)?
        if rights.any_covers(caps, cap):
            who.push(name)
    Ok(who)

// The arguments at index `start` and beyond (a positional slice). Used both to
// collect a gate's trailing accepted-cap list and to forward a program's own argv
// after `pm run <file|dir>` (BUG-102).
fn args_from(let args: List(String), start: Int) -> List(String):
    var out = []
    var i = 0
    for a in args:
        if i >= start:
            out.push(a)
        i = i + 1
    out

fn union_all(a: List(String), b: List(String)) -> List(String):
    var out = a
    for x in b:
        out = add_unique(out, x)
    out

fn add_unique(xs: List(String), x: String) -> List(String):
    if xs.contains(x):
        xs
    else:
        var out = xs
        out.push(x)
        out

// The canonical lockfile text for a rune: a `[[rune]]` block per dependency,
// pinning its resolved version, source, content hash, and runtime footprint.
// BUG-047/101/135: pins the FULL transitive path-dependency closure — a diamond
// (`app -> {a,b} -> base`) locks `base` once, not never. Direct registry deps get
// an informational placeholder (pm lock is path-only; `lock_problems` blocks them
// before this runs, but the marker is kept for completeness).
// idiom-exempt: concatenation in this section is canonical lockfile serialization.
fn generate_lock(root: Dir, dir: String) -> Result(String, FootprintError):
    let manifest = root.read(join_path(dir, "witchy.toml"))
    var out = "# witchy.lock — generated by `pm lock`. Pins every dependency by content\n# hash. Regenerate with `pm lock`; verify with `pm verify`. Do not edit by hand.\n"
    for name, inline in toml.table(manifest, "dependencies"):
        if toml.inline_get(inline, "path").is_none():
            out = out + registry_placeholder(name)
    for name, dep_dir in path_closure(root, dir):
        let entry = closure_path_entry(root, name, dep_dir)?
        out = out + entry
    Ok(out)

fn registry_placeholder(name: String) -> String:
    "\n[[rune]]\nname = \"" + name + "\"\nsource = \"coven\"\n# unresolved: registry deps need coven (pm publish/fetch)\n"

// A `[[rune]]` block for a resolved path-closure member. `dep_dir` is the resolved
// directory (relative to the project); the `source` records it so the entry is
// self-describing. `hash`/`runtime_footprint` are recomputed from the dep's source.
fn closure_path_entry(root: Dir, name: String, dep_dir: String) -> Result(String, FootprintError):
    let dep_manifest = root.read(join_path(dep_dir, "witchy.toml"))
    let version = field(dep_manifest, "rune.version")
    let hash = rune_hash(root, dep_dir)
    let caps = rune_footprint(root, dep_dir)?
    let fp = footprint_toml(caps)
    Ok("\n[[rune]]\nname = \"" + name + "\"\nversion = \"" + version + "\"\nsource = \"path:" + dep_dir + "\"\nhash = \"" + hash + "\"\nruntime_footprint = [" + fp + "]\n")

// The rune's content address: the canonical hash over `witchy.toml` plus every
// `src/**/*.witchy` (recursively), matching coven's store byte-for-byte (so a
// witchy-checked lock agrees with a coven-generated one).
fn rune_hash(root: Dir, dir: String) -> String:
    var files = [("witchy.toml", root.read(join_path(dir, "witchy.toml")))]
    for f in fs.collect_files(root, join_path(dir, "src"), "src", ".witchy"):
        files.push(f)
    content_hash(files)

fn footprint_toml(caps: List(String)) -> String:
    var parts = []
    for c in caps:
        parts.push("\"" + c + "\"")
    list.join(parts, ", ")

// Collapse `a/b/../c` to `a/c`, dropping `.` and empty segments — the confined
// Dir capability rejects `..`, so a relative dep path must be resolved first.
// Lexically normalize a relative path, preserving leading `..` segments. A `..`
// that has a real prior segment to cancel pops it; a `..` with nothing left to
// pop (the path escapes its starting directory) is KEPT, so a sibling reference
// like `todo/../tasklib` normalizes to `tasklib` while `../tasklib` (from the
// workspace root) stays `../tasklib`. Dropping the leading `..` would silently
// rewrite a sibling path-dependency into a non-existent same-directory one.
fn normalize_path(let p: String) -> String:
    var stack = []
    for seg in p.split("/"):
        if seg == "..":
            if can_pop(stack):
                stack = drop_last(stack)
            else:
                stack.push("..")
        else if seg != "" && seg != ".":
            stack.push(seg)
    list.join(stack, "/")

// Whether the last segment of `stack` is a real directory `..` can cancel (i.e.
// not itself a leading `..`).
fn can_pop(stack: List(String)) -> Bool:
    let n = list.length(stack)
    n > 0 && list.at(stack, n - 1) != ".."

fn drop_last(xs: List(String)) -> List(String):
    var out = []
    let last = list.length(xs) - 1
    var i = 0
    for x in xs:
        if i < last:
            out.push(x)
        i = i + 1
    out

// --- update: re-resolve vendored deps to the latest released version ---------
// `update [name]` walks the project's `vendor/` tree (each vendored rune carries
// its signed `coven.json`, naming the full `ns/name` and pinned version), queries
// the registry for the latest released version of each, and re-fetches the ones
// that moved (verifying signature + hash), then regenerates `witchy.lock`. With a
// `name` argument only that rune is updated; the others stay pinned at their
// vendored version. Run from a project directory (cwd is the project Dir).
fn cmd_update(console: Console, net: Net, root: Dir, env: Env, clock: Clock, args: List(String)) -> Int:
    let allowed = allowed_caps(args)
    let positional = update_positionals(args)
    let only = list.at(positional, 0)
    let addr = coven_addr(env, list.at(positional, 1))
    match parse_origin(addr):
        // BUG-090: honor the staging cooldown on re-resolution (a fresh
        // release inside its cooldown is not resolvable without --allow-fresh),
        // the same compromised-release protection `add` applies.
        Err(m) ->
            console.print("invalid registry address: ${m}")
            1
        Ok(shp) ->
            let (scheme, host, port) = shp
            let origin = registry_origin(scheme, host, port)
            if !root.exists("vendor"):
                console.print("no vendored dependencies to update")
                0
            else:
                let cooldown = cooldown_now(env, clock, args)
                let manifest = if root.exists("witchy.toml"): root.read("witchy.toml") else: ""
                update_vendored(console, net, root, origin, only, allowed, cooldown, manifest)

// `update`'s positional args (`[only, addr]`), skipping the command word and any
// `--allow-cap <Cap>` flag pairs. Always length 2 (absent positionals are ""), so
// the caller can index freely.
fn update_positionals(args: List(String)) -> List(String):
    var out = ["", ""]
    var idx = 0
    var first = true
    var take = false
    for a in args:
        if first:
            first = false
        else if take:
            take = false
        else if a == "--allow-cap":
            take = true
        else if idx < 2:
            out = set_at(out, idx, a)
            idx = idx + 1
    out

// The capabilities a `--allow-cap <Cap>` flag consents to (so an intended widening
// passes the gate) — every value following an `--allow-cap` token.
fn allowed_caps(args: List(String)) -> List(String):
    var out = []
    var take = false
    for a in args:
        if take:
            out.push(a)
            take = false
        else if a == "--allow-cap":
            take = true
    out

fn set_at(xs: List(String), i: Int, v: String) -> List(String):
    var out = []
    var j = 0
    for x in xs:
        if j == i:
            out.push(v)
        else:
            out.push(x)
        j = j + 1
    out

fn update_vendored(console: Console, net: Net, root: Dir, origin: String, only: String, allowed: List(String), cooldown: (Int, Int, Bool), manifest: String) -> Int:
    var changed = 0
    var blocked = false
    var failed = false
    for entry in root.subtree("vendor").list():
        if only.is_empty() || entry == only:
            let outcome = update_one(console, net, root, origin, entry, allowed, cooldown, manifest)
            changed = changed + outcome.0
            if outcome.1:
                blocked = true
            if outcome.2:
                failed = true
    if blocked:
        // Leave the vendored tree + lock untouched: a widening upgrade is the
        // supply-chain attack the gate exists to stop.
        2
    else if failed:
        // BUG-371/569: a resolution, refetch, or verification failed. Do NOT repin
        // the registry root key or rewrite the lock as if the update succeeded — a
        // partial/failed update must not mint fresh trust metadata.
        console.print("BLOCK: an update failed to resolve, fetch, or verify — leaving witchy.lock and the pinned registry key untouched")
        1
    else:
        match lock_trust_pins(net, root, origin):
            Err(e) ->
                console.print("BLOCK: cannot pin registry metadata — ${tuf_error_message(e)}")
                2
            Ok(pins) ->
                match vendor_lock(root, pins):
                    Err(e) ->
                        console.print("BLOCK: cannot regenerate witchy.lock — ${vendored_record_error_message(e)}")
                        2
                    Ok(lock) ->
                        root.write("witchy.lock", lock)
                        console.print("updated ${changed} dependencies -> witchy.lock")
                        0

// Re-fetch one vendored rune if the registry has a newer eligible version than the
// one currently vendored. Returns (changed, blocked, failed): `changed` is 1 if it
// moved, `blocked` is true if the newer version WIDENS authority beyond the baseline
// (the gate), `failed` is true if resolution, fetch, or verification failed. The
// target version is resolved WITHIN the consumer's declared requirement (BUG-092)
// and past the staging cooldown (BUG-090).
fn update_one(console: Console, net: Net, root: Dir, origin: String, entry: String, allowed: List(String), cooldown: (Int, Int, Bool), manifest: String) -> (Int, Bool, Bool):
    let rune_dir = join_path("vendor", entry)
    if !root.exists(join_path(rune_dir, "coven.json")):
        (0, false, false)
    else:
        let vendored = match parse_vendored_record(root.read(join_path(rune_dir, "coven.json"))):
            Err(e) ->
                console.print("BLOCK: cannot update `${entry}` — ${vendored_record_error_message(e)}")
                return (0, false, true)
            Ok(record) -> record

        let fullname = vendored.name
        let current = vendored.version
        let req = dep_req(manifest, fullname, entry)
        match resolve_version(net, origin, fullname, req, cooldown):
            // Cooling and no-match mean there is no eligible update today. Every
            // other resolver error means the registry/manifest could not be
            // trusted, so preserve the lock and report a failed update (BUG-569).
            Err(VersionCooling(_req)) -> (0, false, false)
            Err(VersionNoMatch(_req)) -> (0, false, false)
            Err(e) ->
                console.print("BLOCK: cannot resolve an update for ${fullname}: ${version_resolve_error_message(e)}")
                (0, false, true)
            Ok(latest) ->
                if latest.is_empty() || latest == current:
                    (0, false, false)
                else:
                    gated_refetch(console, net, root, origin, fullname, current, latest, vendored.runtime_footprint, allowed, cooldown)

// The version requirement the consumer's manifest declares for a vendored dep,
// matched by full registry identity or basename alias; `*` (latest) when the
// manifest names no requirement (BUG-092). `update` resolves WITHIN this bound
// rather than jumping to the absolute latest.
fn dep_req(manifest: String, fullname: String, alias: String) -> String:
    var req = "*"
    for name, inline in toml.table(manifest, "dependencies"):
        if name == fullname || basename(name) == alias:
            if let Some(v) = toml.inline_get(inline, "version"):
                req = v
    req

// The capability gate: compare the incoming version's declared footprint (from its
// signed registry record) against the vendored baseline ∪ the consented caps. Any
// capability the baseline doesn't already admit is a widening of authority — BLOCK.
// Only on a clean (non-widening) upgrade do we re-fetch.
fn gated_refetch(console: Console, net: Net, root: Dir, origin: String, fullname: String, current: String, latest: String, baseline_footprint: List(String), allowed: List(String), cooldown: (Int, Int, Bool)) -> (Int, Bool, Bool):
    let baseline = union_all(baseline_footprint, allowed)
    // BUG-232: the widening gate must diff against a VERIFIED footprint, not a raw
    // `/coven/record` body. A hostile mirror could otherwise serve an under-declared
    // (or wrong-coordinate) record to sneak the gate, then serve matching malicious
    // source. Verify the signed record against the pinned root key and bind its
    // coordinate before trusting its footprint; a verification failure blocks.
    match verified_incoming_footprint(net, root, origin, fullname, latest):
        Err(e) ->
            console.print("BLOCK: cannot verify the registry record for ${fullname}@${latest} — ${record_footprint_error_message(e)}")
            (0, true, false)
        Ok(incoming) ->
            let widened = rights.uncovered(baseline, incoming)
            if list.length(widened) > 0:
                console.print("BLOCK: upgrading ${fullname} ${current} -> ${latest} widens authority: ${list.join(widened, ", ")}")
                console.print("  re-run with --allow-cap ${list.join(widened, " --allow-cap ")} to consent")
                (0, true, false)
            else:
                refetch(console, net, root, origin, fullname, latest, current, cooldown, allowed)

// The runtime footprint a registry version declares, read from its signed record at
// `/coven/record` ONLY AFTER the record is verified against the registry root key
// (bound to any key pinned in the lock) and its identity is bound to the requested
// coordinate (BUG-232/266). `Err` on any failure so the gate blocks rather than
// trusting an unverified/under-declared footprint.
fn verified_incoming_footprint(net: Net, root: Dir, origin: String, name: String, version: String) -> Result(List(String), RecordFootprintError):
    let rootpub = fetch_registry_rootpub(net, origin)?
    let pinned_pub = pinned_registry_rootpub(root)?
    if pinned_pub != "" && pinned_pub != rootpub:
        Err(RecordRootKeyMismatch)
    else:
        let resp = registry_get(net, origin, "/coven/record?name=${wire(name)}&version=${version}")
        if http.status(resp) != 200:
            Err(RecordMissing)
        else if !record_signature_valid(rootpub, http.body(resp)):
            Err(RecordBadSignature)
        else if !record_matches_coordinate(http.body(resp), name, version):
            Err(RecordCoordinateMismatch)
        else:
            strict_footprint(http.body(resp))

// Matchable errors for the verified registry-record footprint boundary. The
// widening gate trusts this result, so every verification and decode failure is
// typed before the CLI renders it into the existing BLOCK diagnostic.
type RecordFootprintError:
    RecordLockPin(LockPinError)
    RecordRootKeyFetch(RegistryRootKeyError)
    RecordRootKeyMismatch
    RecordMissing
    RecordBadSignature
    RecordCoordinateMismatch
    RecordInvalidJson
    RecordMissingRuntimeFootprint
    RecordRuntimeFootprintNotArray
    RecordRuntimeFootprintNonString

fn record_footprint_error_message(e: RecordFootprintError) -> String:
    match e:
        RecordLockPin(error) -> lock_pin_error_message(error)
        RecordRootKeyFetch(error) -> registry_root_key_error_message(error)
        RecordRootKeyMismatch -> "registry root key does not match the key pinned in witchy.lock (possible MITM / hostile mirror)"
        RecordMissing -> "registry has no record"
        RecordBadSignature -> "the record is not validly signed by the registry root key"
        RecordCoordinateMismatch -> "the record identity does not match the requested coordinate"
        RecordInvalidJson -> "the signed record is not valid JSON"
        RecordMissingRuntimeFootprint -> "the signed record has no `runtime_footprint` field"
        RecordRuntimeFootprintNotArray -> "the record's `runtime_footprint` is not an array"
        RecordRuntimeFootprintNonString -> "the record's `runtime_footprint` has a non-string element"

impl Show for RecordFootprintError:
    fn show(self) -> String:
        record_footprint_error_message(self)

impl Error for RecordFootprintError

impl From(RecordFootprintError) for String:
    fn from(value: RecordFootprintError) -> Self:
        record_footprint_error_message(value)

impl From(LockPinError) for RecordFootprintError:
    fn from(value: LockPinError) -> Self:
        RecordLockPin(value)

impl From(RegistryRootKeyError) for RecordFootprintError:
    fn from(value: RegistryRootKeyError) -> Self:
        RecordRootKeyFetch(value)

// The `runtime_footprint` array of a VERIFIED signed record, decoded strictly: a
// malformed record, a missing/non-array `runtime_footprint`, or a non-string
// element is an `Err`, never a silent empty list (BUG-499). This is the footprint
// the widening gate trusts, so an under-decoded field must block the upgrade
// rather than read as "demands no authority" and slip past the gate.
fn strict_footprint(record: String) -> Result(List(String), RecordFootprintError):
    match json.decode(record):
        Err(_e) -> Err(RecordInvalidJson)
        Ok(doc) ->
            match json.get(doc, "runtime_footprint"):
                None -> Err(RecordMissingRuntimeFootprint)
                Some(field) ->
                    match json.as_array(field):
                        None -> Err(RecordRuntimeFootprintNotArray)
                        Some(items) -> strict_strings(items)

fn strict_strings(items: List(Json)) -> Result(List(String), RecordFootprintError):
    var out = []
    for it in items:
        match json.as_string(it):
            None -> return Err(RecordRuntimeFootprintNonString)
            Some(s) ->
                out.push(s)
    Ok(out)

// Returns (changed, blocked, failed). BUG-091: after a clean re-fetch, recurse into
// the new version's OWN dependency closure (`add_deps`), so a release that GAINED a
// transitive dependency has it fetched + vendored too — an update is not just the
// single rune. BUG-371: a failed fetch/verify (or a failed transitive fetch) reports
// `failed` so the caller does not repin registry metadata.
fn refetch(console: Console, net: Net, root: Dir, origin: String, fullname: String, latest: String, current: String, cooldown: (Int, Int, Bool), allowed: List(String)) -> (Int, Bool, Bool):
    let code = fetch_source(console, net, root, origin, fullname, latest, "vendor")
    if code != 0:
        (0, false, true)
    else if add_deps(console, net, root, origin, fullname, "vendor", cooldown, allowed) != 0:
        (0, false, true)
    else:
        console.print("updated ${fullname} ${current} -> ${latest}")
        (1, false, false)

// --- add: resolve + fetch a rune (and its deps) from a coven registry --------
// Resolves a version requirement against the registry's released versions
// (std/semver), fetches the chosen version's source (verifying its signed
// record + content hash), materializes it, and then resolves the fetched rune's
// own version dependencies transitively. The vendored tree under <dest> doubles
// as the visited-set: a rune already carrying its coven.json is never re-fetched,
// which makes a diamond or a dependency cycle terminate. This command needs the
// network.
// A `--path` argument means "add a local path dependency". That is not wired up
// here yet (registry `add` is), and without this guard the path string is mistaken
// for a `host:port` and `hostport` aborts with an opaque "cannot parse" — so report
// it clearly and point at the working manual route.
fn has_path_flag(args: List(String)) -> Bool:
    var found = false
    for a in args:
        if a == "--path" || a.starts_with("--path="):
            found = true
    found

fn cmd_add(console: Console, net: Net, root: Dir, env: Env, clock: Clock, args: List(String)) -> Int:
    if has_path_flag(args):
        console.print("`add --path` is not supported yet. Add the path dependency to witchy.toml by hand, under [dependencies]:")
        console.print("    \"<name>\" = { path = \"<relative-path>\" }")
        console.print("then run `witchy build`.")
        1
    else:
        cmd_add_dispatch(console, net, root, env, clock, args)

fn cmd_add_dispatch(console: Console, net: Net, root: Dir, env: Env, clock: Clock, args: List(String)) -> Int:
    let pos = positionals(args)
    if arg(pos, 3).is_empty():
        cmd_add_pkg(console, net, root, env, clock, args)
    else:
        let name = arg(pos, 1)
        let req = arg(pos, 2)
        let addr = arg(pos, 3)
        let dest = arg(pos, 4)
        match parse_origin(addr):
            Err(m) ->
                console.print("invalid registry address: ${m}")
                1
            Ok(shp) ->
                let (scheme, host, port) = shp
                let origin = registry_origin(scheme, host, port)
                add_rune(console, net, root, origin, name, req, dest, cooldown_now(env, clock, args), [])

// Cargo-like `add <pkg>[@<ver>]`: resolve the registry from COVEN_URL (or an
// explicit second `<host:port>` argument), default the requirement to the latest
// released version when no `@<ver>` is given, fetch+verify, vendor into the
// project's `vendor/<basename>`, and pin the resolved version in `witchy.lock`.
// Run from a project directory (cwd is the project Dir). This is the cargo-style
// front-end `add` of RFC-0004 — a stable vendor/lock layout the project `build`/
// `run` then resolves through `witchy compile --dep`.
fn cmd_add_pkg(console: Console, net: Net, root: Dir, env: Env, clock: Clock, args: List(String)) -> Int:
    let pos = positionals(args)
    let spec = arg(pos, 1)
    if spec.is_empty():
        console.print("usage: pm add <pkg>[@<ver>] [host:port] [--allow-cap <Cap>]... [--allow-fresh]")
        1
    else:
        let (name, req) = split_spec(spec)
        let addr = coven_addr(env, arg(pos, 2))
        match parse_origin(addr):
            Err(m) ->
                console.print("invalid registry address: ${m}")
                1
            Ok(shp) ->
                let (scheme, host, port) = shp
                let origin = registry_origin(scheme, host, port)
                add_pkg_gated(console, net, root, origin, name, req, cooldown_now(env, clock, args), allowed_caps(args))

// A direct `add` is the consumer's deliberate choice to take on a dependency, so
// it is gated: if the rune — OR ANY rune in its resolved dependency closure (SEC-006) —
// introduces a capability the project does not already admit (its own declared caps ∪
// what the lock already records ∪ the caps the consumer consented to with `--allow-cap`),
// the add is BLOCKED. A registry record's footprint is single-rune, so the direct gate
// alone would miss a transitive dep's capabilities; we re-gate the whole vendored closure.
fn add_pkg_gated(console: Console, net: Net, root: Dir, origin: String, name: String, req: String, cooldown: (Int, Int, Bool), allowed: List(String)) -> Int:
    match resolve_version(net, origin, name, req, cooldown):
        // BUG-232: gate on a VERIFIED, coordinate-bound record footprint.
        Err(e) ->
            console.print("${name}: ${version_resolve_error_message(e)}")
            1
        Ok(chosen) ->
            match project_baseline(root):
                Err(e) ->
                    console.print("BLOCK: cannot read witchy.lock — ${lock_integrity_error_message(e)}")
                    2
                Ok(recorded) ->
                    let baseline = union_all(recorded, allowed)
                    match verified_incoming_footprint(net, root, origin, name, chosen):
                        Err(e) ->
                            console.print("BLOCK: cannot verify the registry record for ${name}@${chosen} — ${record_footprint_error_message(e)}")
                            2
                        Ok(incoming) ->
                            add_pkg_gate_widen(console, net, root, origin, name, req, cooldown, baseline, rights.uncovered(baseline, incoming))

fn add_pkg_gate_widen(console: Console, net: Net, root: Dir, origin: String, name: String, req: String, cooldown: (Int, Int, Bool), baseline: List(String), widened: List(String)) -> Int:
    if list.length(widened) > 0:
        console.print("BLOCKED: adding `${name}` would widen your project's capability footprint: ${list.join(widened, ", ")}")
        console.print("  re-run with --allow-cap ${list.join(widened, " --allow-cap ")} to consent")
        2
    else:
        let code = add_rune(console, net, root, origin, name, req, "vendor", cooldown, [])
        if code != 0:
            code
        else:
            // SEC-006: re-gate on the FULL vendored closure now on disk — a
            // transitive dep can carry a capability the direct rune's footprint
            // never showed. Blocked here, the files stay vendored but unpinned;
            // re-running with `--allow-cap` consents and completes the add.
            match vendored_closure_footprint(root):
                Err(e) ->
                    console.print("BLOCKED: a dependency of `${name}` has no trustworthy capability footprint: ${footprint_error_message(e)}")
                    2
                Ok(closure) ->
                    let closure_widened = rights.uncovered(baseline, closure)
                    if list.length(closure_widened) > 0:
                        console.print("BLOCKED: a dependency of `${name}` would widen your project's capability footprint: ${list.join(closure_widened, ", ")}")
                        console.print("  re-run with --allow-cap ${list.join(closure_widened, " --allow-cap ")} to consent to the whole dependency tree")
                        2
                    else:
                        pin_lock(console, net, root, origin, name)

// The capability authority the project already admits: its own declared runtime
// caps (from witchy.toml, if any) plus every capability the lockfile already
// records for a vendored dependency — the baseline a new direct `add` diffs
// against, so adding a same-or-narrower rune is silent and a widening one gates.
fn project_baseline(root: Dir) -> Result(List(String), LockIntegrityError):
    var out = []
    if root.exists("witchy.toml"):
        for c in declared_caps(root.read("witchy.toml")):
            out = add_unique(out, c)
    if root.exists("witchy.lock"):
        out = union_all(out, lock_baseline(root.read("witchy.lock"))?)
    Ok(out)

// Split `<pkg>[@<ver>]` into a (name, requirement); an absent `@<ver>` resolves to
// `*` (the latest released version). A leading-`@` namespace is not split.
fn split_spec(spec: String) -> (String, String):
    if spec.contains("@"):
        let (name, ver) = spec.rsplit_once("@")
        if name.is_empty():
            (spec, "*")
        else:
            (name, ver)
    else:
        (spec, "*")

// Record the resolved dependency in the project's `witchy.lock`: a `[[rune]]`
// entry pinning the vendored rune's name, resolved version, source (coven), and
// content hash, so `build`/`run` can map `import <basename>` to its vendored
// source and `verify`/`gate` can re-check it. Idempotently rewrites the lock from
// every currently-vendored rune so repeated `add`s accumulate, not clobber.
fn pin_lock(console: Console, net: Net, root: Dir, origin: String, name: String) -> Int:
    match lock_trust_pins(net, root, origin):
        Err(e) ->
            console.print("BLOCK: cannot pin registry metadata for ${basename(name)} — ${tuf_error_message(e)}")
            2
        Ok(pins) ->
            match vendor_lock(root, pins):
                Err(e) ->
                    console.print("BLOCK: cannot regenerate witchy.lock — ${vendored_record_error_message(e)}")
                    2
                Ok(lock) ->
                    root.write("witchy.lock", lock)
                    console.print("locked ${basename(name)} -> witchy.lock")
                    0

// Matchable failures from the TUF pinning gate. `add`/`update` only write a
// registry_snapshot_version lock pin after this boundary verifies signatures,
// schemas, content hash binding, and role version agreement.
type TufError:
    TufLockPin(LockPinError)
    TufRootKeyFetch(RegistryRootKeyError)
    RootKeyMismatch
    SnapshotUnavailable(Int)
    SnapshotWithoutTimestamp
    TimestampBadSignature
    SnapshotBadSignature
    SnapshotMalformed
    TimestampMalformed
    SnapshotHashMismatch
    SnapshotVersionMismatch

fn tuf_error_message(e: TufError) -> String:
    match e:
        TufLockPin(error) -> lock_pin_error_message(error)
        TufRootKeyFetch(error) -> registry_root_key_error_message(error)
        RootKeyMismatch -> "registry root key does not match the key pinned in witchy.lock (possible MITM / hostile mirror)"
        SnapshotUnavailable(status) -> "registry snapshot is unavailable (HTTP ${status})"
        SnapshotWithoutTimestamp -> "registry served a snapshot but no timestamp role — cannot verify the TUF chain"
        TimestampBadSignature -> "the timestamp role is not validly signed by the registry root key"
        SnapshotBadSignature -> "the snapshot role is not validly signed by the registry root key"
        SnapshotMalformed -> "the snapshot role is structurally malformed (needs an integer `version` and an object `targets`)"
        TimestampMalformed -> "the timestamp role is structurally malformed (needs an integer `snapshot_version`, a string `snapshot_hash`, and an integer `expires`)"
        SnapshotHashMismatch -> "the snapshot does not match the timestamp's pinned hash"
        SnapshotVersionMismatch -> "the snapshot and timestamp disagree on the snapshot version"

impl Show for TufError:
    fn show(self) -> String:
        tuf_error_message(self)

impl Error for TufError

impl From(TufError) for String:
    fn from(value: TufError) -> Self:
        tuf_error_message(value)

impl From(LockPinError) for TufError:
    fn from(value: LockPinError) -> Self:
        TufLockPin(value)

impl From(RegistryRootKeyError) for TufError:
    fn from(value: RegistryRootKeyError) -> Self:
        TufRootKeyFetch(value)

// Fetch and verify the snapshot plus its signing key as one operation before lock
// serialization. The exact root key that verifies the snapshot is the one emitted;
// there is no second fetch that can race and pin a different key (BUG-571/572).
fn lock_trust_pins(net: Net, root: Dir, origin: String) -> Result(String, TufError):
    let pins = snapshot_pin(net, root, origin)?
    Ok(pins.0 + "registry_rootpub = \"" + pins.1 + "\"\n")

// The `registry_snapshot_version = N` top-level line pinning the registry's current
// TUF snapshot version into the lock — the rollback baseline `verify` enforces.
// BUG-233: the version is pinned ONLY from a VERIFIED snapshot role — the snapshot
// and timestamp must be validly signed by the registry root key (bound to any key
// already pinned in the lock), structurally well-formed, hash-bound, and in version
// agreement — so a malformed/unsigned/split response cannot under- or over-pin the
// rollback floor. An unavailable snapshot is an error: treating it as "nothing to
// pin" would erase an existing rollback floor during lock regeneration.
fn snapshot_pin(net: Net, root: Dir, origin: String) -> Result((String, String), TufError):
    let snap_resp = registry_get(net, origin, "/coven/snapshot")
    if http.status(snap_resp) != 200:
        Err(SnapshotUnavailable(http.status(snap_resp)))
    else:
        let rootpub = fetch_registry_rootpub(net, origin)?
        let pinned_pub = pinned_registry_rootpub(root)?
        if pinned_pub != "" && pinned_pub != rootpub:
            Err(RootKeyMismatch)
        else:
            let ts_resp = registry_get(net, origin, "/coven/timestamp")
            if http.status(ts_resp) != 200:
                Err(SnapshotWithoutTimestamp)
            else:
                let snapshot = verified_snapshot_line(rootpub, http.body(snap_resp), http.body(ts_resp))?
                Ok((snapshot, rootpub))

// Run the signature + schema + hash-binding + version-agreement checks over a
// snapshot/timestamp pair (the same gate `verify`/`check_chain` applies) and, only
// if they all pass, produce the `registry_snapshot_version` line for the verified
// snapshot version. Freshness (`expires`) is enforced at `verify` time, not pinned.
fn verified_snapshot_line(rootpub: String, snap_env: String, ts_env: String) -> Result(String, TufError):
    if !signed_valid(rootpub, ts_env):
        Err(TimestampBadSignature)
    else if !signed_valid(rootpub, snap_env):
        Err(SnapshotBadSignature)
    else if !snapshot_schema_ok(snap_env):
        Err(SnapshotMalformed)
    else if !timestamp_schema_ok(ts_env):
        Err(TimestampMalformed)
    else if "sha256:${crypto.sha256(signed_canonical(snap_env))}" != signed_field_str(ts_env, "snapshot_hash"):
        Err(SnapshotHashMismatch)
    else if signed_field_int(snap_env, "version") != signed_field_int(ts_env, "snapshot_version"):
        Err(SnapshotVersionMismatch)
    else:
        Ok("registry_snapshot_version = ${signed_field_int(snap_env, "version")}\n")

fn fetch_registry_rootpub(net: Net, origin: String) -> Result(String, RegistryRootKeyError):
    let resp = registry_get(net, origin, "/coven/rootpub")
    if http.status(resp) != 200:
        Err(RegistryRootKeyUnavailable(http.status(resp)))
    else if !valid_registry_rootpub(http.body(resp)):
        Err(RegistryRootKeyMalformed)
    else:
        Ok(http.body(resp))

// The lockfile text generated from the vendored tree: one `[[rune]]` block per
// vendored rune (those carrying a coven.json), pinning name/version/hash from the
// signed record kept beside the source. `snapshot_line` is the TUF snapshot pin
// (a top-level key, emitted BEFORE any `[[rune]]` array-table per TOML rules).
// idiom-exempt: concatenation in this section is canonical lockfile serialization.
fn vendor_lock(root: Dir, snapshot_line: String) -> Result(String, VendoredRecordError):
    var out = "# witchy.lock — generated by `pm add`. Pins every vendored dependency\n# by content hash. Regenerate with `pm add`. Do not edit by hand.\n" + snapshot_line
    if root.exists("vendor"):
        for entry in root.subtree("vendor").list():
            let rune_dir = join_path("vendor", entry)
            if root.exists(join_path(rune_dir, "coven.json")):
                match vendor_lock_entry(root, entry, rune_dir):
                    Err(e) -> return Err(e)
                    Ok(lock_entry) -> out = out + lock_entry
    Ok(out)

// `name` is the vendor directory basename (the local import alias); the signed
// record carries the FULL registry package identity (e.g. `acme/http`). BUG-099:
// the lock `name` is the registry identity from the signed record, and `alias`
// records the basename import key separately — the two are no longer collapsed.
fn vendor_lock_entry(root: Dir, alias: String, rune_dir: String) -> Result(String, VendoredRecordError):
    let record = parse_vendored_record(root.read(join_path(rune_dir, "coven.json")))?
    let fp = footprint_toml(record.runtime_footprint)
    Ok("\n[[rune]]\nname = \"" + record.name + "\"\nalias = \"" + alias + "\"\nversion = \"" + record.version + "\"\nsource = \"coven\"\nhash = \"" + record.hash + "\"\nruntime_footprint = [" + fp + "]\n")

// The strict subset of a signed coven record needed by update and lock
// regeneration. Local vendor metadata is trust state: malformed fields are an
// error, never empty identity/hash/authority defaults (BUG-570).
type VendoredRecord:
    name: String
    version: String
    state: String
    hash: String
    runtime_footprint: List(String)

type VendoredRecordError:
    VendoredRecordInvalidJson(String)
    VendoredRecordMissingString(String)
    VendoredRecordEmptyString(String)
    VendoredRecordInvalidVersion(String)
    VendoredRecordInvalidState(String)
    VendoredRecordInvalidHash(String)
    VendoredRecordMissingFootprint
    VendoredRecordFootprintNotArray
    VendoredRecordFootprintNonString

fn vendored_record_error_message(e: VendoredRecordError) -> String:
    match e:
        VendoredRecordInvalidJson(reason) -> "vendored coven.json is not valid JSON: ${reason}"
        VendoredRecordMissingString(field) -> "vendored coven.json has no string `${field}` field"
        VendoredRecordEmptyString(field) -> "vendored coven.json has an empty `${field}` field"
        VendoredRecordInvalidVersion(version) -> "vendored coven.json has noncanonical version `${version}`"
        VendoredRecordInvalidState(state) -> "vendored coven.json has non-released state `${state}`"
        VendoredRecordInvalidHash(hash) -> "vendored coven.json has malformed content hash `${hash}`"
        VendoredRecordMissingFootprint -> "vendored coven.json has no `runtime_footprint` field"
        VendoredRecordFootprintNotArray -> "vendored coven.json `runtime_footprint` is not an array"
        VendoredRecordFootprintNonString -> "vendored coven.json `runtime_footprint` contains a non-string value"

impl Show for VendoredRecordError:
    fn show(self) -> String:
        vendored_record_error_message(self)

impl Error for VendoredRecordError

impl From(VendoredRecordError) for String:
    fn from(value: VendoredRecordError) -> Self:
        vendored_record_error_message(value)

fn parse_vendored_record(text: String) -> Result(VendoredRecord, VendoredRecordError):
    match json.decode(text):
        Err(e) -> Err(VendoredRecordInvalidJson(json.decode_error_message(e)))
        Ok(doc) ->
            let name = required_vendored_string(doc, "name")?
            let version = required_vendored_string(doc, "version")?
            let state = required_vendored_string(doc, "state")?
            let hash = required_vendored_string(doc, "hash")?
            let runtime_footprint = required_vendored_footprint(doc)?
            match canonical_version(version):
                None -> Err(VendoredRecordInvalidVersion(version))
                Some(_parsed) ->
                    if state != "released":
                        Err(VendoredRecordInvalidState(state))
                    else if !hash.starts_with("sha256:"):
                        Err(VendoredRecordInvalidHash(hash))
                    else:
                        Ok(VendoredRecord(name, version, state, hash, runtime_footprint))

fn required_vendored_string(doc: Json, field: String) -> Result(String, VendoredRecordError):
    match json.get_string(doc, field):
        None -> Err(VendoredRecordMissingString(field))
        Some(value) ->
            if value.is_empty():
                Err(VendoredRecordEmptyString(field))
            else:
                Ok(value)

fn required_vendored_footprint(doc: Json) -> Result(List(String), VendoredRecordError):
    match json.get(doc, "runtime_footprint"):
        None -> Err(VendoredRecordMissingFootprint)
        Some(field) ->
            match json.as_array(field):
                None -> Err(VendoredRecordFootprintNotArray)
                Some(items) -> vendored_footprint_strings(items)

fn vendored_footprint_strings(items: List(Json)) -> Result(List(String), VendoredRecordError):
    var out = []
    for item in items:
        let value = match json.as_string(item):
            None -> return Err(VendoredRecordFootprintNonString)
            Some(value) -> value

        out.push(value)
    Ok(out)

fn recorded_field(record: String, key: String) -> String:
    match json.decode(record):
        Ok(doc) -> jget(doc, key)
        Err(_e) -> ""

// Resolve + fetch one rune and its transitive deps. Already-vendored runes (their
// coven.json is present) are skipped — the dedup + cycle break. But a rune already
// vendored under this basename whose FULL name differs is a collision: two distinct
// runes (`a/util` and `b/util`) would vendor to the same `vendor/util`, so the
// second silently shadows the first. Refuse it — `import util` cannot name both.
fn add_rune(console: Console, net: Net, root: Dir, origin: String, name: String, req: String, dest: String, cooldown: (Int, Int, Bool), allowed: List(String)) -> Int:
    let vendored = join_path(dest, basename(name))
    if root.exists(join_path(vendored, "coven.json")):
        match parse_vendored_record(root.read(join_path(vendored, "coven.json"))):
            Err(e) ->
                console.print("BLOCK: cannot reuse `${vendored}` — ${vendored_record_error_message(e)}")
                2
            Ok(existing) ->
                if existing.name != name:
                    console.print("BLOCK: module name collision — `${name}` and `${existing.name}` both vendor to `${vendored}` (same basename `${basename(name)}`)")
                    2
                else:
                    0
    else:
        match resolve_version(net, origin, name, req, cooldown):
            Ok(chosen) -> fetch_then_deps(console, net, root, origin, name, chosen, dest, cooldown, allowed)
            Err(e) ->
                console.print("${name}: ${version_resolve_error_message(e)}")
                1

// Resolve `req` against the registry's released versions, honoring the staging
// cooldown: a release younger than the cooldown window is not resolvable (the
// compromised-release window, §8) unless `--allow-fresh` was passed. If the only
// matching versions are still cooling, the error explains the window + override.
fn resolve_version(net: Net, origin: String, name: String, req: String, cooldown: (Int, Int, Bool)) -> Result(String, VersionResolveError):
    let resp = registry_get(net, origin, "/coven/versions?name=${wire(name)}")
    if http.status(resp) != 200:
        Err(VersionRegistryFetchFailed(http.status(resp)))
    else:
        let body = http.body(resp)
        let records = released_version_records(body)?
        match pick_version_cooled(records, req, cooldown):
            Ok(v) -> Ok(v)
            Err(e) ->
                if has_cooling_match(records, req, cooldown):
                    Err(VersionCooling(req))
                else:
                    Err(e)

// Matchable failures from the registry version-resolution boundary. This is the
// first PM decision point after untrusted registry data, semver parsing, and
// staging-cooldown policy are combined; keep it typed until the CLI renders it.
type VersionResolveError:
    VersionRegistryFetchFailed(Int)
    VersionMalformedResponse(String)
    VersionBadRequirement(String, String)
    VersionCooling(String)
    VersionNoMatch(String)

fn version_resolve_error_message(e: VersionResolveError) -> String:
    match e:
        VersionRegistryFetchFailed(_status) -> "registry error fetching versions"
        VersionMalformedResponse(reason) -> "registry returned a malformed versions response: ${reason}"
        VersionBadRequirement(req, cause) -> "bad requirement `${req}`: ${cause}"
        VersionCooling(req) -> "a release satisfying `${req}` is inside its staging cooldown and not resolvable yet (compromised-release protection) — re-run with --allow-fresh to accept it now"
        VersionNoMatch(req) -> "no released version satisfies `${req}`"

impl Show for VersionResolveError:
    fn show(self) -> String:
        version_resolve_error_message(self)

impl Error for VersionResolveError

impl From(VersionResolveError) for String:
    fn from(value: VersionResolveError) -> Self:
        version_resolve_error_message(value)

// Fetch a resolved version, then recurse into the version deps its manifest
// declares. The exit code is the first failure (0 if the whole tree resolves).
fn fetch_then_deps(console: Console, net: Net, root: Dir, origin: String, name: String, version: String, dest: String, cooldown: (Int, Int, Bool), allowed: List(String)) -> Int:
    let code = fetch_source(console, net, root, origin, name, version, dest)
    if code != 0:
        code
    else:
        add_deps(console, net, root, origin, name, dest, cooldown, allowed)

fn add_deps(console: Console, net: Net, root: Dir, origin: String, name: String, dest: String, cooldown: (Int, Int, Bool), allowed: List(String)) -> Int:
    let manifest = root.read(join_path(join_path(dest, basename(name)), "witchy.toml"))
    var code = 0
    for depname, inline in toml.table(manifest, "dependencies"):
        if let Some(depreq) = toml.inline_get(inline, "version"):
            let sub = add_rune(console, net, root, origin, depname, depreq, dest, cooldown, allowed)
            if sub != 0:
                code = sub
    code

// The highest released-and-eligible version satisfying `req`, or an explanatory
// error. A release still inside its staging cooldown is excluded (unless
// `--allow-fresh`) — `resolve_version` distinguishes "none satisfy" from "the
// only match is cooling" for a clearer message.
fn pick_version_cooled(records: List((Version, Int)), req: String, cooldown: (Int, Int, Bool)) -> Result(String, VersionResolveError):
    match semver.parse_req(req):
        Ok(r) -> choose(eligible_versions(records, cooldown), r, req)
        Err(e) -> Err(VersionBadRequirement(req, semver.semver_error_message(e)))

fn choose(versions: List(Version), r: Req, req: String) -> Result(String, VersionResolveError):
    match semver.best(versions, r):
        Some(v) -> Ok(semver.format(v))
        None -> Err(VersionNoMatch(req))

// Released versions that are resolvable now: state `released` AND past the staging
// cooldown window (or `--allow-fresh`). A record's `released_at` (unix seconds, in
// the signed payload so it can't be tampered away) plus the window must be ≤ now.
fn eligible_versions(records: List((Version, Int)), cooldown: (Int, Int, Bool)) -> List(Version):
    var out = []
    for version, released_at in records:
        if !cooling(released_at, cooldown):
            out.push(version)
    out

// Parse a registry version string, but ONLY if it is already the canonical SemVer
// coordinate (BUG-391). `semver.parse` normalizes `01.2.3`/`1.2` and trims
// whitespace away, so the resolver would otherwise select one released record
// and then fetch a DIFFERENT `&version=` coordinate. Requiring
// `format(parse(raw)) == raw` keeps the resolved coordinate byte-identical to the
// record it came from; the boundary reports noncanonical strings as corruption.
fn canonical_version(raw: String) -> Option(Version):
    match semver.parse(raw):
        Ok(v) -> if semver.format(v) == raw: Some(v) else: None
        Err(_e) -> None

// Whether any released version satisfying `req` exists but is still cooling — so
// the caller can say "blocked by cooldown" instead of "no version".
fn has_cooling_match(records: List((Version, Int)), req: String, cooldown: (Int, Int, Bool)) -> Bool:
    match semver.parse_req(req):
        Err(_e) -> false
        Ok(r) ->
            var found = false
            for version, released_at in records:
                if cooling(released_at, cooldown) && semver.matches(r, version):
                    found = true
            found

// Parse the registry response once into the only fields version decisions use.
// Malformed JSON, response shape, states, coordinates, or release timestamps are
// a typed boundary error — never an empty registry or an ordinary no-match.
fn released_version_records(body: String) -> Result(List((Version, Int)), VersionResolveError):
    match json.decode(body):
        Err(e) -> Err(VersionMalformedResponse(json.decode_error_message(e)))
        Ok(doc) ->
            match json.get(doc, "records"):
                None -> Err(VersionMalformedResponse("missing `records` array"))
                Some(field) ->
                    match json.as_array(field):
                        None -> Err(VersionMalformedResponse("`records` is not an array"))
                        Some(items) -> parse_version_records(items)

fn parse_version_records(items: List(Json)) -> Result(List((Version, Int)), VersionResolveError):
    var out = []
    var index = 0
    for rec in items:
        let state = match json.get_string(rec, "state"):
            None -> return Err(VersionMalformedResponse("record ${index} has no string `state`"))
            Some(s) -> s

        if state != "staged" && state != "released" && state != "yanked":
            return Err(VersionMalformedResponse("record ${index} has unknown state `${state}`"))
        let raw = match json.get_string(rec, "version"):
            None -> return Err(VersionMalformedResponse("record ${index} has no string `version`"))
            Some(s) -> s

        let version = match canonical_version(raw):
            None -> return Err(VersionMalformedResponse("record ${index} has noncanonical version `${raw}`"))
            Some(v) -> v

        if state == "released":
            let released_at = match json.get_int(rec, "released_at"):
                None -> return Err(VersionMalformedResponse("released record ${index} has no integer `released_at`"))
                Some(n) -> n

            if released_at < 0:
                return Err(VersionMalformedResponse("released record ${index} has negative `released_at`"))
            out.push((version, released_at))
        index = index + 1
    Ok(out)

// Whether a released record is still inside its staging cooldown window. A
// `released_at` of 0 (legacy/unstamped) is treated as past any window; with
// `--allow-fresh` nothing cools. `cooldown` is (now_unix_secs, window_secs,
// allow_fresh).
fn cooling(released_at: Int, cooldown: (Int, Int, Bool)) -> Bool:
    let (now_secs, window, allow_fresh) = cooldown
    if allow_fresh || released_at == 0:
        false
    else:
        now_secs < released_at + window

// The cooldown context for this `add`: (now_unix_secs, window_secs, allow_fresh).
// The window is `WITCHY_COOLDOWN_SECS` (Env; default 72h); `--allow-fresh` accepts
// a still-cooling release. The wall clock comes from the `Clock` capability (ms →
// seconds, matching the registry's `released_at` unit).
fn cooldown_now(env: Env, clock: Clock, args: List(String)) -> (Int, Int, Bool):
    (clock.now() / 1000, cooldown_window(env), has_flag(args, "--allow-fresh"))

fn cooldown_window(env: Env) -> Int:
    match env.get_env("WITCHY_COOLDOWN_SECS"):
        Some(v) -> v.to_int()
        None -> 259200

fn has_flag(args: List(String), flag: String) -> Bool:
    var found = false
    for a in args:
        if a == flag:
            found = true
    found

// The positional arguments (no `--flag` and no `--flag value` pairs). `--allow-cap`
// takes a value (the consented capability); `--allow-fresh` / `--dry-run` are bare.
fn positionals(args: List(String)) -> List(String):
    var out = []
    var skip = false
    for a in args:
        if skip:
            skip = false
        else if a == "--allow-cap" || a == "--allow-build-cap":
            skip = true
        else if !a.starts_with("--"):
            out.push(a)
    out

// Fetch a version, verifying the full trust chain before writing anything: the
// registry's record must be validly signed by its root key, and the fetched
// source must hash to that signed hash. An untrusted mirror cannot swap the
// bytes — content addressing + the signature, not the transport, are trusted.
fn fetch_source(console: Console, net: Net, root: Dir, origin: String, name: String, version: String, dest: String) -> Int:
    match pinned_registry_rootpub(root):
        Err(e) ->
            console.print("BLOCK: ${lock_pin_error_message(e)}")
            1
        Ok(pinned_pub) -> match fetch_registry_rootpub(net, origin):
            Err(e) ->
                console.print("BLOCK: cannot fetch registry root key for ${name}@${version} — ${registry_root_key_error_message(e)}")
                1
            Ok(rootpub) -> fetch_source_with_root(console, net, root, origin, name, version, dest, rootpub, pinned_pub)

fn fetch_source_with_root(console: Console, net: Net, root: Dir, origin: String, name: String, version: String, dest: String, rootpub: String, pinned_pub: String) -> Int:
    // SEC-002: enforce the complete lock trust record on fetch/add too, before
    // source is vendored or a signed record's footprint is trusted.
    if pinned_pub != "" && pinned_pub != rootpub:
        console.print("BLOCK: registry root key for ${name}@${version} does not match the key pinned in witchy.lock (possible MITM / hostile mirror)")
        1
    else:
        let record = registry_get(net, origin, "/coven/record?name=${wire(name)}&version=${version}")
        if http.status(record) != 200:
            console.print("registry has no record for ${name}@${version}")
            1
        else if !record_signature_valid(rootpub, http.body(record)):
            console.print("BLOCK: registry record for ${name}@${version} has an invalid signature — refusing to trust it")
            1
        else if !record_matches_coordinate(http.body(record), name, version):
            // BUG-266: the signature proves the record is authentic, not that it is the
            // record we ASKED for. Bind the record's own `name`/`version` to the requested
            // coordinate, so a registry/mirror cannot answer a request for `good@1.0.0`
            // with a validly-signed record for a DIFFERENT coordinate (a mix-up/substitution
            // that would vendor the wrong rune under this basename).
            console.print("BLOCK: registry returned a record for `${recorded_field(http.body(record), "name")}@${recorded_field(http.body(record), "version")}` when `${name}@${version}` was requested — refusing (coordinate mismatch)")
            1
        else:
            fetch_verified(console, net, root, origin, name, version, dest, http.body(record))

// Whether a signed record's own identity fields match the coordinate it was fetched
// for — the anti-substitution binding for BUG-266.
fn record_matches_coordinate(record: String, name: String, version: String) -> Bool:
    recorded_field(record, "name") == name && recorded_field(record, "version") == version

fn fetch_verified(console: Console, net: Net, root: Dir, origin: String, name: String, version: String, dest: String, record: String) -> Int:
    let resp = registry_get(net, origin, "/coven/source?name=${wire(name)}&version=${version}")
    if http.status(resp) != 200:
        console.print("registry has no source for ${name}@${version}")
        1
    else:
        match source_files(http.body(resp)):
            Err(e) ->
                console.print("BLOCK: malformed source response for ${name}@${version} — ${source_response_error_message(e)}")
                1
            Ok(files) ->
                if content_hash(files) != recorded_hash(record):
                    console.print("BLOCK: integrity failure — fetched source for ${name}@${version} does not match the signed hash (tampered mirror?)")
                    1
                else if recorded_field(record, "state") != "released":
                    console.print("BLOCK: registry record for ${name}@${version} is `${recorded_field(record, "state")}`, not `released` — refusing to vendor an unreleased version")
                    1
                else:
                    write_vendored_source(console, root, dest, name, version, files, record)

// Validate the fetched file set, then materialize it beside its signed record.
// BUG-089: a registry/mirror response is untrusted structure. Even though the set
// is content-bound to the signed hash, refuse a malformed set BEFORE writing —
// a `..`/absolute/empty path would trap the confined Dir write (aborting pm), and
// a duplicated path is an ambiguous rune. Only `witchy.toml` + `src/**.witchy`
// (coven's publish contract) are accepted.
fn write_vendored_source(console: Console, root: Dir, dest: String, name: String, version: String, files: List((String, String)), record: String) -> Int:
    match validate_source_files(files):
        // Keep the signed record next to the source, so the vendored rune
        // carries its own provenance and can be re-verified offline.
        Err(e) ->
            console.print(source_file_set_error_message(e))
            1
        Ok(_) ->
            let base = join_path(dest, basename(name))
            for path, text in files:
                let full = join_path(base, path)
                fs.ensure_dir(root, fs.parent_dir(full) ?? "")
                root.write(full, text)
            root.write(join_path(base, "coven.json"), record)
            console.print("added ${name}@${version} -> ${base}")
            0

// Fail on the first unexpected/traversing or duplicated path. Successful
// validation proves the whole fetched file set is well-formed and unique.
fn validate_source_files(files: List((String, String))) -> Result(Nil, SourceFileSetError):
    var seen = []
    for path, _text in files:
        if !path_shape_ok(path):
            return Err(SourcePathInvalid(path))
        else if seen.contains(path):
            return Err(SourcePathDuplicated(path))
        seen.push(path)
    Ok(Nil)

type SourceFileSetError:
    SourcePathInvalid(String)
    SourcePathDuplicated(String)

fn source_file_set_error_message(e: SourceFileSetError) -> String:
    match e:
        SourcePathInvalid(path) -> "BLOCK: fetched source carries an unexpected path `${path}` — a vendored rune may only ship `witchy.toml` and `src/**.witchy` (no absolute or `..` paths)"
        SourcePathDuplicated(path) -> "BLOCK: fetched source lists `${path}` more than once — refusing an ambiguous/duplicated file set"

impl Show for SourceFileSetError:
    fn show(self) -> String:
        source_file_set_error_message(self)

impl Error for SourceFileSetError

impl From(SourceFileSetError) for String:
    fn from(value: SourceFileSetError) -> Self:
        source_file_set_error_message(value)

// Whether a fetched source path is confined and conventional: `witchy.toml`, or a
// `src/...` file ending in `.witchy`, with no absolute prefix or `..` traversal.
fn path_shape_ok(path: String) -> Bool:
    if path.is_empty() || path.starts_with("/") || path.contains(".."):
        false
    else:
        path == "witchy.toml" || path.starts_with("src/") && path.ends_with(".witchy")

// Matchable failures from the `/coven/source` response boundary. This response is
// untrusted registry/mirror structure; malformed JSON or a wrong-shaped `files`
// field must fail closed before hashing or writing, not become an empty file set.
type SourceResponseError:
    SourceInvalidJson(String)
    SourceMissingFiles
    SourceFilesNotArray
    SourceFileEntryMalformed

fn source_response_error_message(e: SourceResponseError) -> String:
    match e:
        SourceInvalidJson(reason) -> "response is not valid JSON: ${reason}"
        SourceMissingFiles -> "response has no `files` field"
        SourceFilesNotArray -> "`files` is not an array"
        SourceFileEntryMalformed -> "`files` contains an entry that is not `[path, text]` strings"

impl Show for SourceResponseError:
    fn show(self) -> String:
        source_response_error_message(self)

impl Error for SourceResponseError

impl From(SourceResponseError) for String:
    fn from(value: SourceResponseError) -> Self:
        source_response_error_message(value)

fn source_files(body: String) -> Result(List((String, String)), SourceResponseError):
    var out = []
    match json.decode(body):
        Err(e) -> Err(SourceInvalidJson(json.decode_error_message(e)))
        Ok(doc) ->
            match json.get(doc, "files"):
                None -> Err(SourceMissingFiles)
                Some(files) ->
                    match json.as_array(files):
                        None -> Err(SourceFilesNotArray)
                        Some(items) ->
                            for entry in items:
                                match source_file_entry(entry):
                                    Err(e) -> return Err(e)
                                    Ok(pair) ->
                                        out.push(pair)
                            Ok(out)

fn source_file_entry(entry: Json) -> Result((String, String), SourceResponseError):
    match json.as_array(entry):
        None -> Err(SourceFileEntryMalformed)
        Some(parts) ->
            if list.length(parts) != 2:
                Err(SourceFileEntryMalformed)
            else:
                match json.as_string(list.at(parts, 0)):
                    None -> Err(SourceFileEntryMalformed)
                    Some(path) ->
                        match json.as_string(list.at(parts, 1)):
                            None -> Err(SourceFileEntryMalformed)
                            Some(text) -> Ok((path, text))

// The content address of an in-memory rune source (matches coven / crypto.rune_hash).
fn content_hash(files: List((String, String))) -> String:
    var paths = []
    var texts = []
    for p, t in files:
        paths.push(p)
        texts.push(t)
    crypto.rune_hash(paths, texts)

fn recorded_hash(text: String) -> String:
    match json.decode(text):
        Ok(doc) -> jget(doc, "hash")
        Err(e) -> ""

// --- verify-rune: offline re-verification of a vendored rune -----------------
// A rune fetched by `add` carries its signed coven.json. Given the registry's
// root public key (TOFU-pinned), re-verify it with no network: the record must
// be validly signed, and the on-disk source must still hash to the signed hash.
fn cmd_verify_rune(console: Console, root: Dir, dir: String, rootpub: String) -> Int:
    if dir.is_empty() || rootpub.is_empty():
        console.print("usage: pm verify-rune <vendored-rune-dir> <registry-root-pubkey-hex>")
        1
    else if !root.exists(join_path(dir, "coven.json")):
        console.print("no coven.json in ${dir} — not a rune fetched with provenance")
        1
    else:
        report_rune_verify(console, root, dir, rootpub, root.read(join_path(dir, "coven.json")))

// --- verify-vendor: re-verify a whole vendored tree offline ------------------
// Walk every rune under <dir> that carries a coven.json and re-verify it (the
// same signature + content check as verify-rune). A CI gate over an entire
// vendored dependency graph; exits 2 if any rune fails.
fn cmd_verify_vendor(console: Console, root: Dir, dir: String, rootpub: String) -> Int:
    if dir.is_empty() || rootpub.is_empty():
        console.print("usage: pm verify-vendor <vendor-dir> <registry-root-pubkey-hex>")
        1
    else if !root.exists(dir):
        console.print("no such directory: ${dir}")
        1
    else:
        var total = 0
        var failed = 0
        for entry in root.subtree(dir).list():
            let rune_dir = join_path(dir, entry)
            if root.exists(join_path(rune_dir, "coven.json")):
                total = total + 1
                if report_rune_verify(console, root, rune_dir, rootpub, root.read(join_path(rune_dir, "coven.json"))) != 0:
                    failed = failed + 1
        verdict_vendor(console, total, failed)

fn verdict_vendor(console: Console, total: Int, failed: Int) -> Int:
    if total == 0:
        console.print("no vendored runes (no coven.json) found")
        1
    else if failed == 0:
        console.print("OK: all ${total} vendored runes verified")
        0
    else:
        console.print("BLOCK: ${failed} of ${total} vendored runes failed verification")
        2

fn report_rune_verify(console: Console, root: Dir, dir: String, rootpub: String, record: String) -> Int:
    match verify_record_signature(rootpub, record):
        Err(_e) ->
            console.print("BLOCK: ${dir}/coven.json is not validly signed by that root key — refusing")
            2
        Ok(doc) -> report_rune_hash_verify(console, root, dir, doc)

fn report_rune_hash_verify(console: Console, root: Dir, dir: String, doc: Json) -> Int:
    if rune_hash(root, dir) != jget(doc, "hash"):
        console.print("BLOCK: ${dir} source no longer matches its signed hash (tampered)")
        2
    else:
        console.print("OK: ${jget(doc, "name")}@${jget(doc, "version")} verified (signature + content), no network")
        0

// Matchable errors for offline signed-record verification. The CLI still renders
// the stable BLOCK line, but the trust boundary no longer collapses malformed
// JSON, malformed payload shape, malformed verifier input, and bad signatures
// into an uninspectable Bool.
type RecordVerifyError:
    RecordVerifyInvalidJson(String)
    RecordVerifyPayloadInjectedNewline
    RecordVerifyPayloadMalformed
    RecordVerifySignatureInput(String)
    RecordVerifyBadSignature

fn record_verify_error_message(e: RecordVerifyError) -> String:
    match e:
        RecordVerifyInvalidJson(reason) -> "coven.json is not valid JSON: ${reason}"
        RecordVerifyPayloadInjectedNewline -> "coven.json signed payload contains an embedded newline"
        RecordVerifyPayloadMalformed -> "coven.json cannot be projected into its signed payload"
        RecordVerifySignatureInput(reason) -> "record signature input is malformed: ${reason}"
        RecordVerifyBadSignature -> "record signature is invalid"

impl Show for RecordVerifyError:
    fn show(self) -> String:
        record_verify_error_message(self)

impl Error for RecordVerifyError

impl From(RecordVerifyError) for String:
    fn from(value: RecordVerifyError) -> Self:
        record_verify_error_message(value)

// Verify a registry record is signed by the root key over coven's canonical
// payload. A malformed `runtime_footprint` cannot be projected into a payload.
fn verify_record_signature(rootpub: String, text: String) -> Result(Json, RecordVerifyError):
    match json.decode(text):
        Err(e) -> Err(RecordVerifyInvalidJson(json.decode_error_message(e)))
        Ok(doc) ->
            if record_field_has_newline(doc):
                Err(RecordVerifyPayloadInjectedNewline)
            else:
                match record_payload(doc):
                    None -> Err(RecordVerifyPayloadMalformed)
                    Some(payload) ->
                        match crypto.ed25519_verify(rootpub, payload, jget(doc, "sig")):
                            Err(e) -> Err(RecordVerifySignatureInput(crypto.verify_error_message(e)))
                            Ok(false) -> Err(RecordVerifyBadSignature)
                            Ok(true) -> Ok(doc)

fn record_signature_valid(rootpub: String, text: String) -> Bool:
    match verify_record_signature(rootpub, text):
        Ok(_doc) -> true
        Err(_e) -> false

// SEC-013: refuse a record whose free-form fields embed the payload line separator
// (`\n`) — a crafted value could inject a sibling `key=` line, making the canonical
// signing payload ambiguous. coven refuses to sign such a record; reject it on the
// consumer side too (defense in depth against a hostile/buggy registry).
fn record_field_has_newline(doc: Json) -> Bool:
    jget(doc, "uploaded_by").contains("\n") || jget(doc, "promoted_by").contains("\n") || jget(doc, "second_factor").contains("\n") || jget(doc, "provenance").contains("\n")

// idiom-exempt: concatenation defines the signed coven-v1 payload byte format.
fn record_payload(doc: Json) -> Option(String):
    match string_list_payload(doc, "runtime_footprint"):
        None -> None
        Some(rt) -> Some("coven-v1\nname=" + jget(doc, "name") + "\nversion=" + jget(doc, "version") + "\nstate=" + jget(doc, "state") + "\nhash=" + jget(doc, "hash") + "\nrt=" + rt + "\nbuild=\nuploaded_by=" + jget(doc, "uploaded_by") + "\npromoted_by=" + jget(doc, "promoted_by") + "\nfactor=" + jget(doc, "second_factor") + "\nprovenance=" + jget(doc, "provenance") + "\nreleased_at=" + "${jget_int(doc, "released_at")}")

fn string_list_payload(doc: Json, key: String) -> Option(String):
    match json.get(doc, key):
        None -> None
        Some(field) ->
            match field:
                JsonArray(items) ->
                    var out: List(Json) = []
                    for item in items:
                        if let JsonString(s) = item:
                            out.push(JsonString(s))
                        else:
                            return None
                    Some(json.encode(JsonArray(out)))
                _ -> None

fn jget_int(doc: Json, key: String) -> Int:
    match json.get(doc, key):
        Some(j) -> match json.as_int(j):
            Some(n) -> n
            None -> 0
        None -> 0

// --- registry/url helpers ----------------------------------------------------
// Parse a registry address TOTALLY (BUG-199) into its (scheme, origin) origin
// parts. Accepts `https://host[:port][/]`, `http://host[:port][/]`, and bare
// `host:port` (scheme http — loopback compat). A scheme-carrying address without a
// port defaults it from the scheme (https -> 443, http -> 80); a bare address still
// requires an explicit port. Every ill-formed address — unknown scheme, empty host,
// missing/duplicate/non-numeric/overflowing/out-of-range port — is a caller-level
// `Err`, never a `string.to_int` runtime abort. A single trailing `/` (a common
// `COVEN_URL` spelling like `https://coven.example/`) is tolerated, matching the
// Rust launcher's auto-grant normalization.
pub fn parse_origin(addr: String) -> Result((String, String, Int), HostPortError):
    let trimmed = addr.trim()
    if trimmed.starts_with("https://"):
        parse_authority(addr, "https", trimmed.strip_prefix("https://"), 443)
    else if trimmed.starts_with("http://"):
        parse_authority(addr, "http", trimmed.strip_prefix("http://"), 80)
    else if trimmed.contains("://"):
        let (scheme, _rest) = trimmed.split_once("://")
        Err(HostPortUnknownScheme(addr, scheme))
    else if !trimmed.strip_suffix("/").contains(":"):
        Err(HostPortMissingPort(addr))
    else:
        parse_authority(addr, "http", trimmed, 80)

// The `host[:port][/]` authority of an already-recognized scheme; `default_port`
// fills in when the authority carries none.
fn parse_authority(addr: String, scheme: String, raw_authority: String, default_port: Int) -> Result((String, String, Int), HostPortError):
    let authority = raw_authority.strip_suffix("/")
    if authority.is_empty():
        Err(HostPortEmptyHost(addr))
    else if !authority.contains(":"):
        Ok((scheme, authority, default_port))
    else:
        let (host, portstr) = authority.split_once(":")
        if host.is_empty():
            Err(HostPortEmptyHost(addr))
        else if portstr.contains(":"):
            Err(HostPortMultipleColons(addr))
        else:
            match portstr.parse_int():
                None -> Err(HostPortNonNumeric(addr, portstr))
                Some(p) ->
                    if p < 1 || p > 65535:
                        Err(HostPortOutOfRange(addr, portstr))
                    else:
                        Ok((scheme, host, p))

type HostPortError:
    HostPortMissingPort(String)
    HostPortEmptyHost(String)
    HostPortMultipleColons(String)
    HostPortNonNumeric(String, String)
    HostPortOutOfRange(String, String)
    HostPortUnknownScheme(String, String)

fn host_port_error_message(e: HostPortError) -> String:
    match e:
        HostPortMissingPort(addr) -> "`${addr}` is not a host:port (missing `:<port>`)"
        HostPortEmptyHost(addr) -> "`${addr}` has an empty host"
        HostPortMultipleColons(addr) -> "`${addr}` has more than one `:` (expected host:port)"
        HostPortNonNumeric(addr, port) -> "`${addr}` has a non-numeric port `${port}`"
        HostPortOutOfRange(addr, port) -> "`${addr}` port ${port} is out of range (1-65535)"
        HostPortUnknownScheme(addr, scheme) -> "`${addr}` has an unsupported scheme `${scheme}` (expected http or https)"

impl Show for HostPortError:
    fn show(self) -> String:
        host_port_error_message(self)

impl Error for HostPortError

impl From(HostPortError) for String:
    fn from(value: HostPortError) -> Self:
        host_port_error_message(value)

// Rune names contain `/`; the wire encodes it as `~` for a query value.
fn wire(name: String) -> String:
    name.split("/").join("~")

fn basename(name: String) -> String:
    if name.contains("/"):
        let (_ns, base) = name.rsplit_once("/")
        base
    else:
        name

fn jget(doc: Json, key: String) -> String:
    match json.get(doc, key):
        Some(j) -> match json.as_string(j):
            Some(s) -> s
            None -> ""
        None -> ""

fn json_index_str(j: Json, i: Int) -> String:
    match json.index(j, i):
        Some(v) -> match json.as_string(v):
            Some(s) -> s
            None -> ""
        None -> ""

// --- new: scaffold a rune ----------------------------------------------------
fn cmd_new(console: Console, root: Dir, name: String) -> Int:
    if name.is_empty():
        console.print("usage: pm new <name>")
        1
    else if !valid_scaffold_name(name):
        // BUG-200: reject a name that would be spliced unescaped into the generated
        // TOML + source (a `"`, space, newline, ...) BEFORE writing any files, so
        // `pm new` never produces a project that cannot parse.
        console.print(scaffold_name_error(name))
        1
    else:
        let srcdir = join_path(name, "src")
        fs.ensure_dir(root, srcdir)
        let srcfile = join_path(srcdir, "${module_name(name)}.witchy")
        root.write(join_path(name, "witchy.toml"), manifest_stub(name))
        root.write(srcfile, src_stub(name))
        console.print("created rune `${name}`:")
        console.print("  ${join_path(name, "witchy.toml")}")
        console.print("  ${srcfile}")
        0

// The module identifier for a rune's entry source: the name's basename with `-`
// mapped to `_` (a module name is an identifier), matching the launcher's
// `project_entry_file` mapping. `acme/http` -> `http`, `my-rune` -> `my_rune`.
fn module_name(name: String) -> String:
    basename(name).replace("-", "_")

// A local scaffold-name grammar (BUG-200): a bare `name` or a `namespace/name`,
// each segment non-empty and made of lowercase ASCII letters, digits, `-`, or `_`,
// with at most one `/` and no `..` traversal. This is the same shape coven accepts
// for registry names, minus the mandatory namespace (a local rune may be bare). It
// admits the documented valid names and rejects any character that would break the
// generated `witchy.toml` or `src/<name>.witchy`.
fn valid_scaffold_name(name: String) -> Bool:
    if name.is_empty() || name.contains("..") || name.starts_with("/") || name.ends_with("/"):
        false
    else:
        let parts = name.split("/")
        if list.length(parts) > 2:
            false
        else:
            var ok = true
            for p in parts:
                if !valid_name_segment(p):
                    ok = false
            ok

fn valid_name_segment(s: String) -> Bool:
    if s.is_empty():
        false
    else:
        var ok = true
        for ch in s.chars():
            if !name_char_ok(ch):
                ok = false
        ok

fn name_char_ok(ch: String) -> Bool:
    ch >= "a" && ch <= "z" || ch >= "0" && ch <= "9" || ch == "-" || ch == "_"

fn scaffold_name_error(name: String) -> String:
    "invalid rune name `${name}`: use lowercase letters, digits, `-`, `_`, and at most one `/` for a namespace (e.g. `myrune` or `acme/myrune`)"

// idiom-exempt: these are generated TOML/source bytes, not presentation strings.
fn manifest_stub(let name: String) -> String:
    "[rune]\nname = \"" + name + "\"\nversion = \"0.1.0\"\n\n[capabilities]\nruntime = [\"Console\"]\n\n[dependencies]\n"

fn src_stub(let name: String) -> String:
    "fn main(console: Console):\n    console.print(\"hello from " + name + "\")\n"

// --- footprint helpers -------------------------------------------------------

// The capabilities the rune's source actually demands: the UNION over every
// `src/**/*.witchy` module's footprint (BUG-085) — matching coven's
// `computed_footprint`. Footprinting only the first module would miss a capability
// a non-entry helper module reaches for (an under-report a supply-chain attacker
// could hide behind).
fn rune_footprint(root: Dir, dir: String) -> Result(List(String), FootprintError):
    var out = []
    for relpath, text in fs.collect_files(root, join_path(dir, "src"), "src", ".witchy"):
        let values = match footprint_values(compiler.footprint(text), "total"):
            Err(e) -> return Err(FootprintSourceError(relpath, footprint_error_message(e)))
            Ok(caps) -> caps

        for cap in values:
            out = add_unique(out, cap)
    Ok(out)

// SEC-006: the union footprint of EVERY vendored rune — the full resolved closure. A
// registry record's footprint is single-rune, so a direct add's gate never sees a
// transitive dep's capabilities; summing the on-disk closure does.
fn vendored_closure_footprint(root: Dir) -> Result(List(String), FootprintError):
    var out = []
    if root.exists("vendor"):
        for entry in root.subtree("vendor").list():
            let rune_dir = join_path("vendor", entry)
            if root.exists(join_path(rune_dir, "coven.json")):
                let caps = rune_footprint(root, rune_dir)?
                for cap in caps:
                    out = add_unique(out, cap)
    Ok(out)

fn first_witchy(let files: List(String)) -> Option(String):
    var found = None
    for f in files:
        if found.is_none() && f.ends_with(".witchy"):
            found = Some(f)
    found

// Matchable failures at the compiler-footprint consumer boundary. The compiler
// reports source rejection as JSON too; callers must not confuse either form of
// failure with a valid program that demands no authority.
type FootprintError:
    FootprintCompilerRejected(String)
    FootprintMalformedReport(String)
    FootprintSourceError(String, String)

fn footprint_error_message(e: FootprintError) -> String:
    match e:
        FootprintCompilerRejected(reason) -> "compiler rejected the source: ${reason}"
        FootprintMalformedReport(reason) -> "compiler returned a malformed footprint report: ${reason}"
        FootprintSourceError(path, reason) -> "`${path}`: ${reason}"

impl Show for FootprintError:
    fn show(self) -> String:
        footprint_error_message(self)

impl Error for FootprintError

impl From(FootprintError) for String:
    fn from(value: FootprintError) -> Self:
        footprint_error_message(value)

// Pull a required string-array field from a compiler footprint report. Reports
// shaped as {"error": "..."}, malformed JSON, missing/wrong-shaped arrays, and
// non-string elements all remain errors at every authority decision.
fn footprint_values(let report: String, field: String) -> Result(List(String), FootprintError):
    let doc = compiler_report_document(report)?
    footprint_string_field(doc, field)

fn footprint_diff_values(let report: String) -> Result((Bool, List(String)), FootprintError):
    let doc = compiler_report_document(report)?
    let widened = match json.get(doc, "widened"):
        None -> return Err(FootprintMalformedReport("missing `widened` boolean"))
        Some(raw) ->
            match json.as_bool(raw):
                None -> return Err(FootprintMalformedReport("`widened` is not a boolean"))
                Some(value) -> value

    let added = footprint_string_field(doc, "added")?
    Ok((widened, added))

fn compiler_report_document(let report: String) -> Result(Json, FootprintError):
    match json.decode(report):
        Err(e) -> Err(FootprintMalformedReport(json.decode_error_message(e)))
        Ok(doc) ->
            match json.get_string(doc, "error"):
                Some(reason) -> Err(FootprintCompilerRejected(reason))
                None -> Ok(doc)

fn footprint_string_field(doc: Json, field: String) -> Result(List(String), FootprintError):
    match json.get(doc, field):
        None -> Err(FootprintMalformedReport("missing `${field}` array"))
        Some(raw) ->
            match json.as_array(raw):
                None -> Err(FootprintMalformedReport("`${field}` is not an array"))
                Some(items) -> footprint_string_values(items, field)

fn footprint_string_values(items: List(Json), field: String) -> Result(List(String), FootprintError):
    var out = []
    var index = 0
    for item in items:
        // idiom-exempt (BUG-575): match-arm method write-back is discarded.
        match json.as_string(item):
            None -> return Err(FootprintMalformedReport("`${field}` item ${index} is not a string"))
            // idiom-exempt (BUG-575): match-arm method write-back is discarded.
            Some(value) -> list.push(out, value)

        index = index + 1
    Ok(out)

fn declared_caps(let manifest: String) -> List(String):
    toml.get_array(manifest, "capabilities.runtime")

fn field(let manifest: String, path: String) -> String:
    match toml.get(manifest, path):
        Some(v) -> v
        None -> "(none)"

// --- small generic helpers ---------------------------------------------------
fn arg(let args: List(String), i: Int) -> String:
    if i < list.length(args):
        list.at(args, i)
    else:
        ""

fn join_path(let a: String, b: String) -> String:
    // idiom-exempt: path joining is a byte-exact operation.
    a + "/" + b

fn usage(console: Console):
    console.print("pm — the witchy package manager")
    console.print("usage: pm <command> [args]")
    console.print("  info  <dir>         summarize a rune")
    console.print("  audit <file>        footprint a source file demands")
    console.print("  check <dir>         declared footprint must admit the code")
    console.print("  guard <old> <new>   BLOCK if <new> widens authority")
    console.print("  deps  <dir>         list a rune's dependencies")
    console.print("  lock  <dir>         pin dependencies by content hash -> witchy.lock")
    console.print("  verify [<dir>] [--online]  verify lock, signatures, and provenance offline; optionally check live TUF freshness")
    console.print("  gate  <dir> [cap..] BLOCK if deps demand authority beyond the lock")
    console.print("  why   <dir> <name>  explain a dependency's presence")
    console.print("  why-cap <dir> <Cap> which deps introduce a capability")
    console.print("  add <pkg>[@<ver>] [host:port]    fetch + vendor a rune, pin it in witchy.lock")
    console.print("  add <name> <req> <coven> <dest>  resolve + fetch a rune into <dest> (explicit)")
    console.print("  publish <dir> [host:port] [id]    stage a rune to a coven registry")
    console.print("  promote <name> <ver> [host:port] [id]  release staged (trusted: COVEN_ID_TOKEN with MFA amr)")
    console.print("  yank  <name> <ver> [host:port]   flag a released version as yanked")
    console.print("  list  <name> [host:port]         every version of a rune and its state")
    console.print("  outdated <dir> <host:port>       latest released version of each dep")
    console.print("  update [name] [host:port]        re-fetch vendored deps to their latest release")
    console.print("  verify-rune <dir> <rootpub>  re-verify a vendored rune offline (coven.json)")
    console.print("  verify-vendor <dir> <rootpub>  re-verify every vendored rune offline")
    console.print("  vendor <dir>        materialize path deps into <dir>/vendor")
    console.print("  new   <name>        scaffold a new rune")
    console.print("  init  [name]        add a manifest to an existing directory")
    console.print("  tree  <dir>         show a rune and its dependencies")
    console.print("  run   <file|dir>    compile and run a program/project (drives the compiler)")
    console.print("  build [--target trusted-exe] [--out path] [file|dir]  verify or emit a trusted native app")
    console.print("  typecheck <file>    type-check a program")
    console.print("  test  <dir>         run a rune's tests")
    console.print("  fmt   <file>        format a source file")
    console.print("  doc   <file>        render a module's documentation")

fn unknown(console: Console, cmd: String) -> Int:
    console.print("unknown command: ${cmd}")
    usage(console)
    1
