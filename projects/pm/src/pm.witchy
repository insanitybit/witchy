// pm — the witchy package manager, written in witchy. It reads `witchy.toml`
// manifests, audits a rune's capability footprint, checks that the declared
// footprint *admits* what the code actually demands (rights-precisely), and
// guards an upgrade against any widening of authority. The capability work goes
// through `compiler` (a host introspection intrinsic), so pm runs on the
// interpreter — the way a build tool is allowed to. It is the package manager's
// heart, self-hosted.
//
//   witchy projects/pm/src/pm.witchy <command> [args]
//
// Commands:
//   info  <dir>          summarize a rune (name, version, declared vs. actual caps)
//   audit <file>         print the capability footprint a source file demands
//   check <dir>          verify the manifest's declared footprint admits the code
//   guard <old> <new>    BLOCK if <new> widens the footprint of <old>
//   new   <name>         scaffold a new rune (manifest + src stub)
//   help                 show this message

import compiler
import crypto
import exec
import fs
import http
import json
import rights
import semver
import string
import toml

// `main` takes two `Dir` grants positionally: `root` (handle 0) is the project
// tree the PM reads/writes; `bin` (handle 1) is where the compiler lives, used
// only by `run`, which drives it through the `Exec` capability. See
// rfcs/0004-self-hosted-cli.md.
fn main(console: Console, args: List(String), root: Dir, bin: Dir, runner: Exec, net: Net, env: Env, clock: Clock) -> Int:
    let cmd = arg(args, 0)
    if cmd == "info":
        cmd_info(console, root, arg(args, 1))
        0
    else if cmd == "run":
        cmd_run(console, runner, root, bin, env, clock, args)
    else if cmd == "build":
        cmd_build(console, runner, root, bin, env, args)
    else if cmd == "typecheck":
        cmd_drive(console, runner, bin, "typecheck", ["check", arg(args, 1)])
    else if cmd == "fmt":
        cmd_drive(console, runner, bin, "fmt", ["fmt", arg(args, 1)])
    else if cmd == "test":
        cmd_drive(console, runner, bin, "test", ["test", arg(args, 1)])
    else if cmd == "doc":
        cmd_drive(console, runner, bin, "doc", ["doc", arg(args, 1)])
    else if cmd == "add":
        cmd_add(console, net, root, env, clock, args)
    else if cmd == "publish":
        cmd_publish(console, net, root, env, args)
    else if cmd == "promote":
        cmd_promote(console, net, env, args)
    else if cmd == "yank":
        cmd_yank(console, net, env, args)
    else if cmd == "list":
        cmd_list(console, net, env, args)
    else if cmd == "outdated":
        cmd_outdated(console, net, root, args)
    else if cmd == "update":
        cmd_update(console, net, root, env, args)
    else if cmd == "audit":
        cmd_audit(console, root, arg(args, 1))
        0
    else if cmd == "verify":
        cmd_verify(console, net, root, env, args)
    else:
        dispatch_more(console, root, args, cmd)

// The rest of the command table, split out of `main` so neither `if`/`else if`
// chain nests deeply enough to overflow the compiler's stack while lowering it
// (the WASM codegen recurses per nesting level). These commands need only
// Console + the project Dir.
fn dispatch_more(console: Console, root: Dir, args: List(String), cmd: String) -> Int:
    if cmd == "check":
        cmd_check(console, root, arg(args, 1))
    else if cmd == "guard":
        cmd_guard(console, root, arg(args, 1), arg(args, 2))
    else if cmd == "deps":
        cmd_deps(console, root, arg(args, 1))
        0
    else if cmd == "tree":
        cmd_tree(console, root, arg(args, 1))
        0
    else if cmd == "init":
        cmd_init(console, root, arg(args, 1))
        0
    else if cmd == "why":
        cmd_why(console, root, arg(args, 1), arg(args, 2))
    else if cmd == "why-cap":
        cmd_why_cap(console, root, arg(args, 1), arg(args, 2))
    else if cmd == "vendor":
        cmd_vendor(console, root, arg(args, 1))
    else if cmd == "lock":
        cmd_lock(console, root, arg(args, 1))
    else if cmd == "gate":
        cmd_gate(console, root, args)
    else if cmd == "verify-rune":
        cmd_verify_rune(console, root, arg(args, 1), arg(args, 2))
    else if cmd == "verify-vendor":
        cmd_verify_vendor(console, root, arg(args, 1), arg(args, 2))
    else if cmd == "new":
        cmd_new(console, root, arg(args, 1))
        0
    else if cmd == "" || cmd == "help":
        usage(console)
        0
    else:
        unknown(console, cmd)

// --- info: a one-screen summary of a rune -----------------------------------
fn cmd_info(console: Console, root: Dir, dir: String):
    if string.is_empty(dir):
        print(console, "usage: pm info <dir>")
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        print(console, "name:     " + field(manifest, "rune.name"))
        print(console, "version:  " + field(manifest, "rune.version"))
        print(console, "declared: " + string.join(declared_caps(manifest), ", "))
        print(console, "actual:   " + string.join(rune_footprint(root, dir), ", "))

// run <file|dir> — compile and run a program by driving the compiler. Given a
// project directory (or, with no argument, the current directory) that carries a
// `witchy.toml`, it links the entry with its vendored dependencies (`witchy
// compile --dep ... --out`) and then runs the resulting wasm; given a bare file
// it runs that one module directly. This is the project-level `run` of RFC-0004 —
// the front-end decides *what* to compile (entry + deps from the lock) and
// `witchyc` does the compiling/running.
fn cmd_run(console: Console, runner: Exec, root: Dir, bin: Dir, env: Env, clock: Clock, args: List(String)) -> Int:
    let target = arg(args, 1)
    let dir = if string.is_empty(target): "." else: target
    if exists(root, join_path(dir, "witchy.toml")):
        run_project(console, runner, root, bin, dir)
    else if string.is_empty(target):
        print(console, "usage: pm run <file|dir>")
        1
    else:
        run_compiler(console, runner, bin, "run", [target])

// build <file|dir> — compile a program (and its vendored deps) to verify it builds.
fn cmd_build(console: Console, runner: Exec, root: Dir, bin: Dir, env: Env, args: List(String)) -> Int:
    let target = arg(args, 1)
    let dir = if string.is_empty(target): "." else: target
    if exists(root, join_path(dir, "witchy.toml")):
        match project_entry(root, dir):
            Some(entry) ->
                let built = build_step_flags(console, runner, root, bin, dir)
                if built.0 != 0:
                    built.0
                else:
                    run_compiler(console, runner, bin, "build", flatten_argv(["compile", entry], flatten_argv(dep_flags(root, dir), built.1)))
            None ->
                print(console, "no entry source under " + join_path(dir, "src"))
                1
    else if string.is_empty(target):
        print(console, "usage: pm build <file|dir>")
        1
    else:
        run_compiler(console, runner, bin, "build", ["compile", target])

// Link a project's entry + vendored deps to a wasm under <dir>/target, then run
// that wasm. Two compiler invocations: `compile --dep ... --out` (link) then a
// run of the wasm (which carries exactly its own footprint). The artifact goes
// under the project's own tree so it is named through the project Dir.
//
// The run step is granted a `Dir` rooted at the PROJECT directory (`--dir <dir>`),
// NOT pm's own working directory. This keeps the program's runtime authority
// confined to its own tree while still letting the *compile* step reach a sibling
// path-dependency (`../lib`), which is named relative to pm's Dir (a workspace
// that holds both the app and its siblings). Without the explicit `--dir`, the
// program's data Dir would default to pm's cwd — too wide when pm runs from a
// workspace root, and missing the project's data files (e.g. `tasks.md`).
fn run_project(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String) -> Int:
    match project_entry(root, dir):
        None ->
            print(console, "no entry source under " + join_path(dir, "src"))
            1
        Some(entry) ->
            let steps = build_step_flags(console, runner, root, bin, dir)
            if steps.0 != 0:
                steps.0
            else:
                compile_then_run(console, runner, root, bin, dir, entry, steps.1)

fn compile_then_run(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, entry: String, build_flags: List(String)) -> Int:
    let outdir = join_path(dir, "target")
    if !exists(root, outdir):
        make_dir(root, outdir)
    let wasm = join_path(outdir, "app.wasm")
    let deps = flatten_argv(dep_flags(root, dir), build_flags)
    let argv = flatten_argv(["compile", entry], flatten_argv(deps, ["--out", wasm]))
    let built = exec.run_args(runner, bin, "witchy", argv)
    if built.0 != 0:
        print(console, built.1)
        built.0
    else:
        run_compiler(console, runner, bin, "run", ["sandbox", "--dir", project_data_dir(dir), wasm])

// The directory backing the program's runtime `Dir` grant — the project itself
// (`.` when pm is run from inside the project, `<dir>` when run from a workspace
// root). Data files (`tasks.md`, `config.kv`, `output.json`, …) live here.
fn project_data_dir(dir: String) -> String:
    if string.is_empty(dir) || dir == ".":
        "."
    else:
        dir

// The project's entry source: the first `.witchy` under <dir>/src, prefixed back
// to a path the compiler can read relative to the project Dir.
fn project_entry(root: Dir, dir: String) -> Option(String):
    let srcdir = join_path(dir, "src")
    if !exists(root, srcdir):
        None
    else:
        match first_witchy(list(subdir(root, srcdir))):
            Some(file) -> Some(join_path(srcdir, file))
            None -> None

// One `--dep name=path` token per dependency (TRANSITIVELY), mapping the `import
// <name>` any linked module uses to the source the compiler should link. The
// compiler links a flat set of modules, so a *diamond* — `app` → {`tasks`,
// `coverage`} → `bars` — needs every rune in the graph passed as a `--dep`, not
// just the app's direct dependencies. Deduplicated by name (a shared base like
// `bars` appears once). A registry dependency is served from its vendored tree
// (`vendor/<name>/src/*.witchy`, pinned by the lock); a path dependency is
// resolved from its manifest's `path =`, relative to the depending rune's dir, so
// a sibling-library workspace builds without vendoring. Path wins when both are
// present (the manifest is the source of truth for a path dep).
fn dep_flags(root: Dir, dir: String) -> List(String):
    collect_deps(root, dir, [])

// Accumulate `--dep` flags for the rune at `dir` and, recursively, the path
// dependencies it declares — skipping any already present so the graph is walked
// once per rune (cycles and diamonds both terminate).
fn collect_deps(root: Dir, dir: String, flags: List(String)) -> List(String):
    var acc = flags
    if exists(root, join_path(dir, "witchy.toml")):
        let manifest = read(root, join_path(dir, "witchy.toml"))
        for pair in toml.table(manifest, "dependencies"):
            acc = push_path_dep(root, dir, acc, pair)
    let lockpath = join_path(dir, "witchy.lock")
    if exists(root, lockpath):
        let lock = read(root, lockpath)
        for block in toml.array_tables(lock, "rune"):
            let name = entry_name(block)
            if !string.is_empty(name) && !has_dep(acc, name):
                if let Some(src) = vendored_module(root, dir, name):
                    acc = dep_flag(acc, name, src)
    acc

// Append a `--dep <name>=<path>` for a manifest path dependency (no-op otherwise),
// then recurse into that dependency's own directory so its transitive path deps
// are collected too. Already-resolved names are skipped (the diamond's shared base
// resolves once).
fn push_path_dep(root: Dir, dir: String, flags: List(String), pair: (String, String)) -> List(String):
    let (name, inline) = pair
    if has_dep(flags, name):
        flags
    else:
        match toml.inline_get(inline, "path"):
            Some(rel) ->
                let dep_dir = normalize_path(join_path(dir, rel))
                match module_in_src(root, dep_dir):
                    Some(src) -> collect_deps(root, dep_dir, dep_flag(flags, name, src))
                    None -> flags
            None -> flags

fn dep_flag(flags: List(String), name: String, src: String) -> List(String):
    list.push(list.push(flags, "--dep"), name + "=" + src)

// Whether a `--dep <name>=...` flag is already present.
fn has_dep(flags: List(String), name: String) -> Bool:
    var found = false
    for f in flags:
        if string.contains(f, "=") && string.split_once(f, "=").0 == name:
            found = true
    found

// The vendored source file for dependency `name`: vendor/<name>/src/<first>.witchy.
fn vendored_module(root: Dir, dir: String, name: String) -> Option(String):
    module_in_src(root, join_path(join_path(dir, "vendor"), name))

// The first `.witchy` under `<base>/src`, as a path the compiler can read.
fn module_in_src(root: Dir, base: String) -> Option(String):
    let srcdir = join_path(base, "src")
    if !exists(root, srcdir):
        None
    else:
        match first_witchy(list(subdir(root, srcdir))):
            Some(file) -> Some(join_path(srcdir, file))
            None -> None

// Concatenate the leading argv with the trailing `--dep` flags into one argv.
fn flatten_argv(head: List(String), tail: List(String)) -> List(String):
    var out = []
    for a in head:
        out = list.push(out, a)
    for b in tail:
        out = list.push(out, b)
    out

// Exec the compiler with `argv`, printing its output and returning its exit code.
fn run_compiler(console: Console, runner: Exec, bin: Dir, label: String, argv: List(String)) -> Int:
    let result = exec.run_args(runner, bin, "witchy", argv)
    print(console, result.1)
    result.0

// Drive the compiler (`witchy`) with `argv`, confined to the toolchain-`bin` Dir
// via the `Exec` capability (you can only run a binary you can read). Prints the
// compiler's output and returns its exit code. The shared core of
// run/typecheck/fmt/test/doc — the CLI front-end driving the compiler, RFC-0004's
// cargo→rustc split.
fn cmd_drive(console: Console, runner: Exec, bin: Dir, verb: String, argv: List(String)) -> Int:
    if string.is_empty(list.at(argv, list.length(argv) - 1)):
        print(console, "usage: pm " + verb + " <file>")
        1
    else:
        let result = exec.run_args(runner, bin, "witchy", argv)
        print(console, result.1)
        result.0

// --- build steps (§7.1) -----------------------------------------------------
// A dependency may ship a `src/build.witchy` that GENERATES source the consumer
// then imports. Running it is dangerous — generated code is still code — so the
// front-end gates it default-deny, twice over (the policy mirrors the Rust
// `run_dep_build_step`, src/pm/cli.rs:500-703): EXECUTION itself must be consented
// (a `[build.grants."name"]` section must exist), and any build capability the
// step demands beyond the confined `BuildOut` sandbox must be named in it. The
// confined EXECUTION + sandboxing is the compiler's (`witchy build-step`, the
// TCB); the front-end only decides POLICY and drives it via `Exec`.
//
// Returns (exit_code, extra_dep_flags): a nonzero code aborts the build; the flags
// are `--dep <module>=<path>` per generated file, joined into the compile.
fn build_step_flags(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String) -> (Int, List(String)):
    var code = 0
    var flags = []
    for entry in dep_dirs(root, dir):
        let (name, depdir) = entry
        if has_build_step(root, depdir):
            let outcome = run_one_build_step(console, runner, root, bin, dir, name, depdir)
            if outcome.0 != 0:
                code = outcome.0
            else:
                flags = flatten_argv(flags, outcome.1)
    (code, flags)

// Each dependency as (name, dir): the consumer's path dependencies (resolved
// relative to the project) and its vendored registry dependencies (`vendor/<name>`).
fn dep_dirs(root: Dir, dir: String) -> List((String, String)):
    var out = []
    if exists(root, join_path(dir, "witchy.toml")):
        let manifest = read(root, join_path(dir, "witchy.toml"))
        for pair in toml.table(manifest, "dependencies"):
            let (name, inline) = pair
            if let Some(rel) = toml.inline_get(inline, "path"):
                out = list.push(out, (name, normalize_path(join_path(dir, rel))))
    let vendor = join_path(dir, "vendor")
    if exists(root, vendor):
        for name in list(subdir(root, vendor)):
            out = list.push(out, (name, join_path(vendor, name)))
    out

// Whether a dependency ships a `build` step (`src/build.witchy` defining `build`).
fn has_build_step(root: Dir, depdir: String) -> Bool:
    let path = join_path(join_path(depdir, "src"), "build.witchy")
    exists(root, path) && string.contains(read(root, path), "fn build")

// Run one dependency's build step under its grant, returning (code, dep_flags).
// Default-deny layer 1: refuse unless the consumer accepted execution with a
// `[build.grants."name"]` section. Layer 2: the demanded build caps must all be
// granted. Then cache-or-exec, audit the generated source, and emit `--dep` flags.
fn run_one_build_step(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, name: String, depdir: String) -> (Int, List(String)):
    let manifest = read(root, join_path(dir, "witchy.toml"))
    if !has_grants_section(manifest, name):
        print(console, "`" + name + "` ships a build step, and build-time code execution is denied by default.")
        print(console, "  Add a [build.grants.\"" + name + "\"] section to accept it — an empty section permits only the confined output sandbox (BuildOut); name read/exec/env/net to grant more.")
        (1, [])
    else:
        let buildfile = join_path(join_path(depdir, "src"), "build.witchy")
        let demanded = build_footprint(read(root, buildfile))
        let granted = granted_build_kinds(manifest, name)
        let missing = rights.uncovered(granted, demanded)
        if list.length(missing) > 0:
            print(console, "`" + name + "` build step demands build capabilities you have not granted: " + string.join(missing, ", "))
            print(console, "  add them to [build.grants.\"" + name + "\"] (read/exec/env/net).")
            (1, [])
        else:
            exec_build_step(console, runner, root, bin, dir, name, depdir, manifest)

// Generate (or reuse cached) source, audit it, and return its `--dep` flags.
fn exec_build_step(console: Console, runner: Exec, root: Dir, bin: Dir, dir: String, name: String, depdir: String, manifest: String) -> (Int, List(String)):
    let gendir = join_path(join_path(dir, "build-out"), name)
    let buildfile = join_path(join_path(depdir, "src"), "build.witchy")
    let key = build_cache_key(read(root, buildfile))
    if !cache_hit(root, gendir, key):
        let argv = flatten_argv(["build-step", buildfile, "--out", gendir], grant_flags(manifest, name, dir))
        let result = exec.run_args(runner, bin, "witchy", argv)
        if result.0 != 0:
            print(console, "`" + name + "` build step failed:")
            print(console, result.1)
            return (1, [])
        write(root, join_path(gendir, ".witchy-build-cache"), key)
    audit_then_flags(console, root, dir, name, depdir, gendir)

// Post-generation audit (the smuggle gate): the dependency's footprint over its
// shipped source PLUS the generated source must not widen beyond what it shipped.
// Generated code cannot introduce authority the version was not accepted with.
fn audit_then_flags(console: Console, root: Dir, dir: String, name: String, depdir: String, gendir: String) -> (Int, List(String)):
    let shipped = rune_footprint(root, depdir)
    var generated = []
    var flags = []
    for f in list(subdir(root, gendir)):
        if string.ends_with(f, ".witchy"):
            let path = join_path(gendir, f)
            for c in footprint_total(compiler.footprint(read(root, path))):
                generated = add_unique(generated, c)
            flags = dep_flag(flags, module_stem(f), path)
    let widened = rights.uncovered(shipped, generated)
    if list.length(widened) > 0:
        print(console, "`" + name + "`'s build step generated source that WIDENS its footprint (+ " + string.join(widened, ", ") + ") beyond the locked baseline — refusing. Generated code is still code; it cannot smuggle in authority the version was not accepted with.")
        (1, [])
    else:
        (0, flags)

// A deterministic build step is a pure function of its build source, so its output
// is cached by a hash of that source: a re-build with an unchanged step reuses the
// prior generated files instead of re-running. (The compiler confines the step;
// non-deterministic steps that read env/exec/net are out of scope for these runes.)
fn build_cache_key(build_src: String) -> String:
    "witchy-build-cache-v1:" + crypto.sha256(build_src)

fn cache_hit(root: Dir, gendir: String, key: String) -> Bool:
    let keyfile = join_path(gendir, ".witchy-build-cache")
    exists(root, keyfile) && read(root, keyfile) == key

// Whether the consumer manifest carries a `[build.grants."name"]` section at all —
// the explicit consent to ANY build-time execution (an empty section is consent to
// a BuildOut-only step).
fn has_grants_section(manifest: String, name: String) -> Bool:
    string.contains(manifest, "[build.grants.\"" + name + "\"]")

// The build capabilities a `[build.grants."name"]` section grants. The mere section
// (even empty) grants `BuildOut`; named read/exec/env/net arrays grant the others.
fn granted_build_kinds(manifest: String, name: String) -> List(String):
    var out = ["BuildOut"]
    let section = "build.grants.\"" + name + "\""
    if list.length(toml.get_array(manifest, section + ".read")) > 0:
        out = list.push(out, "BuildRead")
    if list.length(toml.get_array(manifest, section + ".exec")) > 0:
        out = list.push(out, "BuildExec")
    if list.length(toml.get_array(manifest, section + ".env")) > 0:
        out = list.push(out, "BuildEnv")
    if list.length(toml.get_array(manifest, section + ".net")) > 0:
        out = list.push(out, "BuildNet")
    out

// Translate a `[build.grants."name"]` section into `witchy build-step` flags:
// each granted read path (resolved relative to the project) → `--read`, env key →
// `--env`, exec tool → `--exec`. (BuildOut needs no flag — it is the default.)
fn grant_flags(manifest: String, name: String, dir: String) -> List(String):
    var out = []
    let section = "build.grants.\"" + name + "\""
    for p in toml.get_array(manifest, section + ".read"):
        out = list.push(list.push(out, "--read"), normalize_path(join_path(dir, p)))
    for k in toml.get_array(manifest, section + ".env"):
        out = list.push(list.push(out, "--env"), k)
    for t in toml.get_array(manifest, section + ".exec"):
        out = list.push(list.push(out, "--exec"), t)
    out

// The build-axis footprint of a source: the build capabilities its `build`
// entrypoint demands (`compiler.footprint`'s `build` array).
fn build_footprint(source: String) -> List(String):
    build_total(source)

fn build_total(source: String) -> List(String):
    match json.decode(compiler.footprint(source)):
        Ok(doc) -> json.get_strings(doc, "build")
        Err(_e) -> []

// `greet.witchy` → module name `greet`.
fn module_stem(file: String) -> String:
    string.strip_suffix(file, ".witchy")

// --- audit: the footprint a single file demands -----------------------------
fn cmd_audit(console: Console, root: Dir, file: String):
    if string.is_empty(file):
        print(console, "usage: pm audit <file>")
    else:
        let report = compiler.footprint(read(root, file))
        print(console, file + " demands: " + string.join(footprint_total(report), ", "))

// --- check: declared footprint must admit the actual footprint ---------------
// The manifest's declared caps are *not trusted*: pm recomputes the footprint
// from source and fails if the code reaches for authority the manifest never
// admits — rights-precisely, so a declared `Net[Connect]` does NOT admit a
// demanded full `Net` (the under-declaration a supply-chain attacker relies on).
fn cmd_check(console: Console, root: Dir, dir: String) -> Int:
    if string.is_empty(dir):
        print(console, "usage: pm check <dir>")
        1
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        let declared = declared_caps(manifest)
        let demanded = rune_footprint(root, dir)
        let undeclared = rights.uncovered(declared, demanded)
        let unused = unused_caps(declared, demanded)
        report_check(console, undeclared, unused)

fn report_check(console: Console, undeclared: List(String), unused: List(String)) -> Int:
    if !string.is_empty(string.join(undeclared, ", ")):
        print(console, "BLOCK: code demands authority not admitted by [capabilities]: " + string.join(undeclared, ", "))
        2
    else:
        if !string.is_empty(string.join(unused, ", ")):
            print(console, "OK (lint): declared but unused: " + string.join(unused, ", "))
        else:
            print(console, "OK: declared footprint admits the code, nothing unused")
        0

// Declared capabilities that admit nothing the code demands.
fn unused_caps(declared: List(String), demanded: List(String)) -> List(String):
    var extra = []
    for d in declared:
        if !admits_any(d, demanded):
            extra = list.push(extra, d)
    extra

fn admits_any(declared: String, demanded: List(String)) -> Bool:
    var any = false
    for c in demanded:
        if rights.covers(declared, c):
            any = true
    any

// --- guard: block an upgrade that widens authority --------------------------
fn cmd_guard(console: Console, root: Dir, old: String, new: String) -> Int:
    if string.is_empty(old) || string.is_empty(new):
        print(console, "usage: pm guard <old-file> <new-file>")
        1
    else:
        let report = compiler.diff(read(root, old), read(root, new))
        print(console, verdict(report))
        exit_for(report)

fn verdict(report: String) -> String:
    match json.decode(report):
        Ok(doc) -> if widened(doc): "BLOCK: upgrade widens authority by " + added(doc) else: "OK: no new authority"
        Err(e) -> "error: " + e

fn exit_for(report: String) -> Int:
    match json.decode(report):
        Ok(doc) -> if widened(doc): 2 else: 0
        Err(e) -> 1

// --- deps: list a rune's dependencies ---------------------------------------
fn cmd_deps(console: Console, root: Dir, dir: String):
    if string.is_empty(dir):
        print(console, "usage: pm deps <dir>")
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        let deps = toml.table(manifest, "dependencies")
        if list.length(deps) == 0:
            print(console, "(no dependencies)")
        else:
            for pair in deps:
                let (name, inline) = pair
                print(console, name + " -> " + dep_source(inline))

// tree <dir> — the rune and its direct dependencies, indented.
fn cmd_tree(console: Console, root: Dir, dir: String):
    if string.is_empty(dir):
        print(console, "usage: pm tree <dir>")
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        print(console, field(manifest, "rune.name"))
        let deps = toml.table(manifest, "dependencies")
        if list.length(deps) == 0:
            print(console, "  (no dependencies)")
        else:
            for pair in deps:
                let (name, inline) = pair
                print(console, "  " + name + " (" + dep_source(inline) + ")")

// vendor <dir> — materialize path dependencies' sources into <dir>/vendor/<name>
// for offline, auditable builds. Copies each dep's src/*.witchy and manifest.
fn cmd_vendor(console: Console, root: Dir, dir: String) -> Int:
    if string.is_empty(dir):
        print(console, "usage: pm vendor <dir>")
        1
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        let vendor = join_path(dir, "vendor")
        if !exists(root, vendor):
            make_dir(root, vendor)
        var count = 0
        for pair in toml.table(manifest, "dependencies"):
            let (name, inline) = pair
            if let Some(rel) = toml.inline_get(inline, "path"):
                let dep_dir = normalize_path(join_path(dir, rel))
                let dest = join_path(vendor, name)
                if !exists(root, dest):
                    make_dir(root, dest)
                if !exists(root, join_path(dest, "src")):
                    make_dir(root, join_path(dest, "src"))
                for f in fs.collect_files(root, join_path(dep_dir, "src"), "src", ".witchy"):
                    let (relpath, contents) = f
                    write(root, join_path(dest, relpath), contents)
                    count = count + 1
                if exists(root, join_path(dep_dir, "witchy.toml")):
                    write(root, join_path(dest, "witchy.toml"), read(root, join_path(dep_dir, "witchy.toml")))
        print(console, "vendored ${count} file(s) into " + vendor)
        0

// publish <dir> [host:port] [identity] — stage a rune to a coven registry. Reads
// the manifest + full src tree, builds the coven publish envelope, and POSTs it.
// The server recomputes the footprint and refuses an under-declared rune; a
// published version lands STAGED (not resolvable until a separate `promote`).
fn cmd_publish(console: Console, net: Net, root: Dir, env: Env, args: List(String)) -> Int:
    let dir = arg(args, 1)
    if string.is_empty(dir):
        print(console, "usage: pm publish <dir> [host:port] [identity]")
        1
    else:
        let addr = coven_addr(env, arg(args, 2))
        let identity = if string.is_empty(arg(args, 3)): "ci-bot" else: arg(args, 3)
        let (host, port) = hostport(addr)
        let manifest = read(root, join_path(dir, "witchy.toml"))
        if has_path_dependency(manifest):
            print(console, "BLOCK: a published rune must be self-contained — it cannot have a path dependency (a published rune resolves only registry deps): " + string.join(path_deps(manifest), ", "))
            1
        else:
            publish_checked(console, net, root, dir, manifest, host, port, identity, env)

// The wire envelope POST once the manifest has been validated. Split out of
// `cmd_publish` so its `else` arm stays shallow (the WASM codegen recurses per
// nesting level).
fn publish_checked(console: Console, net: Net, root: Dir, dir: String, manifest: String, host: String, port: Int, identity: String, env: Env) -> Int:
    let files = publish_files(root, dir, manifest)
    let token = id_token_from_env(env)
    let resp = http.post(net, host, port, "/coven/publish", publish_body(manifest, files, identity, token))
    print(console, "publish: ${http.status(resp)} state=" + resp_field(http.body(resp), "state"))
    if http.status(resp) >= 200 && http.status(resp) < 300: 0 else: 1

// Whether the manifest declares any path dependency (`{ path = ... }`). A published
// rune must be self-contained / registry-only, so publish refuses these.
fn has_path_dependency(manifest: String) -> Bool:
    list.length(path_deps(manifest)) > 0

// The names of the manifest's path dependencies, for the refusal message.
fn path_deps(manifest: String) -> List(String):
    var out = []
    for pair in toml.table(manifest, "dependencies"):
        let (name, inline) = pair
        if let Some(_rel) = toml.inline_get(inline, "path"):
            out = list.push(out, name)
    out

// The trusted-publishing identity token from COVEN_ID_TOKEN (a coven id-token JSON
// envelope), parsed; None when unset/unparseable (an anonymous `uploaded_by`
// publish). This is the trusted-publishing CLIENT flow: the server verifies the
// token's claims against its per-namespace trust policy.
fn id_token_from_env(env: Env) -> Option(Json):
    match get_env(env, "COVEN_ID_TOKEN"):
        Some(raw) -> json_ok(json.decode(raw))
        None -> None

fn json_ok(r: Result(Json, String)) -> Option(Json):
    match r:
        Ok(tok) -> Some(tok)
        Err(_e) -> None

// The coven registry host:port: the explicit arg if given, else `COVEN_URL` from
// the environment (the Rust CLI's convention), else the default. The bootstrap
// auto-grants Net to `COVEN_URL` so no explicit `--net` is needed.
fn coven_addr(env: Env, arg_addr: String) -> String:
    if !string.is_empty(arg_addr):
        arg_addr
    else:
        match get_env(env, "COVEN_URL"):
            Some(u) -> strip_scheme(u)
            None -> "127.0.0.1:8787"

fn strip_scheme(u: String) -> String:
    string.replace(string.replace(u, "https://", ""), "http://", "")

// promote <name> <version> [host:port] [identity] — release a staged version
// (the out-of-band second factor; must be a DISTINCT identity from the uploader).
fn cmd_promote(console: Console, net: Net, env: Env, args: List(String)) -> Int:
    let name = arg(args, 1)
    let version = arg(args, 2)
    if string.is_empty(name) || string.is_empty(version):
        print(console, "usage: pm promote <name> <version> [host:port] [identity]")
        1
    else:
        let addr = coven_addr(env, arg(args, 3))
        let identity = if string.is_empty(arg(args, 4)): "release-human" else: arg(args, 4)
        let (host, port) = hostport(addr)
        let body = promote_body(name, version, "webauthn", identity, id_token_from_env(env))
        let resp = http.post(net, host, port, "/coven/promote", body)
        print(console, "promote: ${http.status(resp)}")
        if http.status(resp) >= 200 && http.status(resp) < 300: 0 else: 1

// outdated <dir> <coven-host:port> — for each registry dependency, show its
// requirement and the latest released version available. Flattened into shallow
// helpers (deep `for`/`if`/`match` nesting in one fn overflowed codegen).
fn cmd_outdated(console: Console, net: Net, root: Dir, args: List(String)) -> Int:
    let dir = arg(args, 1)
    let addr = arg(args, 2)
    if string.is_empty(dir) || string.is_empty(addr):
        print(console, "usage: pm outdated <dir> <coven-host:port>")
        1
    else:
        let (host, port) = hostport(addr)
        let manifest = read(root, join_path(dir, "witchy.toml"))
        for pair in toml.table(manifest, "dependencies"):
            report_dep_version(console, net, host, port, pair)
        0

fn report_dep_version(console: Console, net: Net, host: String, port: Int, pair: (String, String)):
    let (name, inline) = pair
    if let Some(req) = toml.inline_get(inline, "version"):
        let resp = http.get(net, host, port, "/coven/versions?name=" + wire(name))
        print(console, name + ": req " + req + ", " + latest_label(http.body(resp), http.status(resp)))

fn latest_label(body: String, status: Int) -> String:
    if status != 200:
        "registry error"
    else:
        latest_label_of(latest_version(released_versions(body)))

fn latest_label_of(v: Option(Version)) -> String:
    match v:
        Some(ver) -> "latest " + semver.format(ver)
        None -> "no released versions"

fn latest_version(versions: List(Version)) -> Option(Version):
    var best = None
    for v in versions:
        let take = match best:
            None -> true
            Some(b) -> semver.lt(b, v)
        if take:
            best = Some(v)
    best

// yank <name> <version> [host:port] — flag a released version (re-signs the
// record as yanked); existing locks still resolve it, new resolutions skip it.
fn cmd_yank(console: Console, net: Net, env: Env, args: List(String)) -> Int:
    let name = arg(args, 1)
    let version = arg(args, 2)
    if string.is_empty(name) || string.is_empty(version):
        print(console, "usage: pm yank <name> <version> [host:port]")
        1
    else:
        let addr = coven_addr(env, arg(args, 3))
        let (host, port) = hostport(addr)
        let resp = http.post(net, host, port, "/coven/yank", yank_body(name, version))
        print(console, "yank: ${http.status(resp)}")
        if http.status(resp) >= 200 && http.status(resp) < 300: 0 else: 1

fn yank_body(name: String, version: String) -> String:
    json.encode(JsonObject([("name", JsonString(name)), ("version", JsonString(version))]))

// list <name> [host:port] — every version of a rune the registry knows, with its
// lifecycle state (staged / released / yanked). The registry comes from the
// explicit arg or COVEN_URL. Reads /coven/versions and prints `<version> <state>`
// per record so a consumer can see what is resolvable before adding.
fn cmd_list(console: Console, net: Net, env: Env, args: List(String)) -> Int:
    let name = arg(args, 1)
    if string.is_empty(name):
        print(console, "usage: pm list <name> [host:port]")
        1
    else:
        let addr = coven_addr(env, arg(args, 2))
        let (host, port) = hostport(addr)
        let resp = http.get(net, host, port, "/coven/versions?name=" + wire(name))
        if http.status(resp) != 200:
            print(console, "registry error listing " + name)
            1
        else:
            print_versions(console, name, http.body(resp))

fn print_versions(console: Console, name: String, body: String) -> Int:
    var any = false
    for rec in version_records(body):
        any = true
        print(console, name + "@" + jget(rec, "version") + " " + jget(rec, "state"))
    if !any:
        print(console, name + ": no versions")
    0

// The `records` array of a /coven/versions response, as raw Json values.
fn version_records(body: String) -> List(Json):
    var out = []
    if let Ok(doc) = json.decode(body):
        if let Some(records) = json.get(doc, "records"):
            if let Some(items) = json.as_array(records):
                out = items
    out

// The manifest plus every `src/**/*.witchy`, as (path, contents) — the source
// tree the registry content-addresses and footprints.
fn publish_files(root: Dir, dir: String, manifest: String) -> List((String, String)):
    var out = [("witchy.toml", manifest)]
    for f in fs.collect_files(root, join_path(dir, "src"), "src", ".witchy"):
        out = list.push(out, f)
    out

// Replicate coven's (unsigned) publish/promote wire envelopes (see
// projects/coven/src/coven_proto.witchy) — the front-end is a client, so it
// rebuilds the shape rather than depending on the server rune.
fn publish_body(manifest: String, files: List((String, String)), identity: String, id_token: Option(Json)) -> String:
    let base = [("manifest_toml", JsonString(manifest)), ("source", JsonObject([("files", JsonArray(file_jsons(files)))])), ("uploaded_by", JsonString(identity))]
    let fields = match id_token:
        Some(tok) -> list.push(base, ("id_token", tok))
        None -> base
    json.encode(JsonObject(fields))

fn promote_body(name: String, version: String, factor: String, promoter: String, id_token: Option(Json)) -> String:
    let base = [("name", JsonString(name)), ("version", JsonString(version)), ("second_factor", JsonString(factor)), ("promoted_by", JsonString(promoter))]
    let fields = match id_token:
        Some(tok) -> list.push(base, ("id_token", tok))
        None -> base
    json.encode(JsonObject(fields))

fn file_jsons(files: List((String, String))) -> List(Json):
    var out = []
    for path, text in files:
        out = list.push(out, JsonArray([JsonString(path), JsonString(text)]))
    out

fn resp_field(text: String, key: String) -> String:
    match json.decode(text):
        Ok(doc) -> match json.get_string(doc, key):
            Some(v) -> v
            None -> "?"
        Err(_e) -> "?"

// why <dir> <name> — explain a dependency's presence in the rune.
fn cmd_why(console: Console, root: Dir, dir: String, name: String) -> Int:
    if string.is_empty(dir) || string.is_empty(name):
        print(console, "usage: pm why <dir> <name>")
        1
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        var found = false
        for pair in toml.table(manifest, "dependencies"):
            let (dep, inline) = pair
            if dep == name:
                found = true
                print(console, name + " — direct dependency (" + dep_source(inline) + ")")
        if !found:
            print(console, name + " is not a dependency of this rune")
        0

// why-cap <dir> <Cap> — which dependencies introduce a capability into the tree.
fn cmd_why_cap(console: Console, root: Dir, dir: String, cap: String) -> Int:
    if string.is_empty(dir) || string.is_empty(cap):
        print(console, "usage: pm why-cap <dir> <Cap>")
        1
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        let who = gate_contributors(root, dir, manifest, cap)
        if list.length(who) == 0:
            print(console, "no dependency demands " + cap)
        else:
            for name in who:
                print(console, name + " demands " + cap)
        0

// init [name] — add a manifest + src stub to the CURRENT directory (vs `new`,
// which creates a new subdirectory). No-op if it is already a rune.
fn cmd_init(console: Console, root: Dir, dir: String):
    let name = if string.is_empty(dir): "app" else: dir
    if exists(root, "witchy.toml"):
        print(console, "already a rune: witchy.toml")
    else:
        if !exists(root, "src"):
            make_dir(root, "src")
        write(root, "witchy.toml", manifest_stub(name))
        let stub = join_path("src", name + ".witchy")
        if !exists(root, stub):
            write(root, stub, src_stub(name))
        print(console, "initialized rune `" + name + "` in the current directory")

fn dep_source(let inline: String) -> String:
    match toml.inline_get(inline, "path"):
        Some(p) -> "path:" + p
        None -> version_source(inline)

fn version_source(let inline: String) -> String:
    match toml.inline_get(inline, "version"):
        Some(v) -> "version:" + v
        None -> "(unspecified)"

// --- lock: pin every dependency by content hash ------------------------------
// The lockfile is regenerated from source, so it can never disagree with the
// bytes on disk: `lock` writes the hashes, `verify` recomputes and compares.
fn cmd_lock(console: Console, root: Dir, dir: String) -> Int:
    if string.is_empty(dir):
        print(console, "usage: pm lock <dir>")
        1
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        let n = list.length(toml.table(manifest, "dependencies"))
        let lockpath = join_path(dir, "witchy.lock")
        write(root, lockpath, generate_lock(root, dir))
        print(console, "locked ${n} dependencies -> ${lockpath}")
        0

// --- verify: every locked hash must still match its source, AND the registry's
// TUF chain must verify (no tampered/rolled-back metadata) -------------------
// Parses the lockfile's `[[rune]]` entries and recomputes each path dependency's
// content hash, so it validates *any* witchy.lock — including one coven wrote.
// A mismatch (or a missing entry) means the pinned bytes no longer match disk:
// tampering or a stale lock. Then, if the lock pins a `registry_snapshot_version`
// (written by `add`), it re-fetches + re-verifies the registry's signed TUF
// snapshot + timestamp roles and refuses a tampered chain or a rollback to an
// older snapshot version than the one the lock pinned. Exits 2 on any discrepancy.
fn cmd_verify(console: Console, net: Net, root: Dir, env: Env, args: List(String)) -> Int:
    let target = arg(args, 1)
    let dir = if string.is_empty(target): "." else: target
    if !exists(root, join_path(dir, "witchy.lock")):
        print(console, "no witchy.lock — run `pm lock " + dir + "` first")
        1
    else:
        let lock = read(root, join_path(dir, "witchy.lock"))
        let manifest = read(root, join_path(dir, "witchy.toml"))
        let hash_code = report_verify(console, hash_mismatches(root, dir, manifest, lock))
        let tuf_code = verify_tuf(console, net, root, env, dir, lock)
        if hash_code != 0: hash_code else: tuf_code

fn report_verify(console: Console, bad: List(String)) -> Int:
    if list.length(bad) == 0:
        print(console, "OK: every locked hash matches the dependency sources")
        0
    else:
        print(console, "BLOCK: lock no longer matches source for: " + string.join(bad, ", "))
        2

// --- TUF chain verification (client side) ------------------------------------
// `add` pins the registry's TUF snapshot version into the lock; `verify` re-fetches
// the signed snapshot + timestamp roles and re-checks the whole chain against the
// registry root key, refusing a tampered role or a rollback. The registry only
// PRODUCES these roles (coven_meta); the front-end is the verifier. Checks (the
// freshness/`expires` check is the one chain link omitted here — it needs a wall
// clock the confined front-end does not hold; the security-relevant signature,
// content-binding, version-match and rollback links are all enforced):
//   1. timestamp signed by the root key
//   2. snapshot signed by the root key
//   3. sha256(canonical(snapshot)) == timestamp.snapshot_hash   (content binding)
//   4. snapshot.version == timestamp.snapshot_version           (role agreement)
//   5. snapshot.version >= the version pinned in witchy.lock    (no rollback)
//   6. each vendored registry dep's record digest is the snapshot's target digest
fn verify_tuf(console: Console, net: Net, root: Dir, env: Env, dir: String, lock: String) -> Int:
    let pinned = pinned_snapshot_version(lock)
    if pinned < 0:
        // No registry deps were added (no pinned snapshot) — nothing to verify.
        0
    else:
        let addr = coven_addr(env, "")
        let (host, port) = hostport(addr)
        verify_chain(console, net, root, dir, host, port, pinned)

fn verify_chain(console: Console, net: Net, root: Dir, dir: String, host: String, port: Int, pinned: Int) -> Int:
    let rootpub = http.body(http.get(net, host, port, "/coven/rootpub"))
    let snap_resp = http.get(net, host, port, "/coven/snapshot")
    let ts_resp = http.get(net, host, port, "/coven/timestamp")
    if http.status(snap_resp) != 200 || http.status(ts_resp) != 200:
        print(console, "FAIL: TUF chain — registry served no snapshot/timestamp role")
        2
    else:
        check_chain(console, root, dir, rootpub, http.body(snap_resp), http.body(ts_resp), pinned)

fn check_chain(console: Console, root: Dir, dir: String, rootpub: String, snap_env: String, ts_env: String, pinned: Int) -> Int:
    let snap_signed = signed_canonical(snap_env)
    let ts_signed = signed_canonical(ts_env)
    if !signed_valid(rootpub, ts_env):
        print(console, "FAIL: TUF chain — the timestamp role is not validly signed by the registry root key (tampered)")
        2
    else if !signed_valid(rootpub, snap_env):
        print(console, "FAIL: TUF chain — the snapshot role is not validly signed by the registry root key (tampered)")
        2
    else if "sha256:" + crypto.sha256(snap_signed) != signed_field_str(ts_env, "snapshot_hash"):
        print(console, "FAIL: TUF chain — the snapshot does not match the timestamp's pinned hash (tampered)")
        2
    else if signed_field_int(snap_env, "version") != signed_field_int(ts_env, "snapshot_version"):
        print(console, "FAIL: TUF chain — snapshot and timestamp disagree on the snapshot version (tampered)")
        2
    else if signed_field_int(snap_env, "version") < pinned:
        print(console, "FAIL: TUF chain — the registry's snapshot version ${signed_field_int(snap_env, "version")} is older than the pinned ${pinned}: the metadata has been rolled back")
        2
    else:
        check_targets(console, root, dir, snap_env)

// Every vendored registry dep's signed-record digest must equal the snapshot's
// target digest for its `name@version` — a dep whose record was swapped out from
// under the snapshot is rejected.
fn check_targets(console: Console, root: Dir, dir: String, snap_env: String) -> Int:
    let targets = signed_field(snap_env, "targets")
    var bad = []
    for entry in vendored_runes(root, dir):
        let coven = read(root, join_path(entry, "coven.json"))
        if let Ok(doc) = json.decode(coven):
            let key = jget(doc, "name") + "@" + jget(doc, "version")
            let want = target_digest(targets, key)
            let have = "sha256:" + crypto.sha256(record_payload(doc))
            if want != have:
                bad = list.push(bad, key)
    if list.length(bad) == 0:
        print(console, "OK: TUF chain verified (snapshot + timestamp signatures, content binding, no rollback)")
        0
    else:
        print(console, "FAIL: TUF chain — vendored record digest does not match the snapshot target for: " + string.join(bad, ", "))
        2

// The vendored rune directories (those carrying a coven.json) under <dir>/vendor.
fn vendored_runes(root: Dir, dir: String) -> List(String):
    var out = []
    let vendor = join_path(dir, "vendor")
    if exists(root, vendor):
        for entry in list(subdir(root, vendor)):
            let rune_dir = join_path(vendor, entry)
            if exists(root, join_path(rune_dir, "coven.json")):
                out = list.push(out, rune_dir)
    out

// The digest a snapshot pins for `key` (`name@version`), or "" if absent.
fn target_digest(targets: Json, key: String) -> String:
    match json.get(targets, key):
        Some(j) -> match json.as_string(j):
            Some(s) -> s
            None -> ""
        None -> ""

// A `Signed{signed, sig}` envelope's canonical bytes — `json.encode` of the
// `signed` member, byte-identical to what coven signed (coven signs `encode(role)`
// and json round-trips key order, so re-encoding the decoded role reproduces it).
fn signed_canonical(envelope: String) -> String:
    match json.decode(envelope):
        Ok(doc) -> match json.get(doc, "signed"):
            Some(signed) -> json.encode(signed)
            None -> ""
        Err(_e) -> ""

// Verify a `Signed{signed, sig}` envelope against the root pubkey over its canonical bytes.
fn signed_valid(rootpub: String, envelope: String) -> Bool:
    match json.decode(envelope):
        Ok(doc) -> crypto.ed25519_verify(rootpub, signed_canonical(envelope), jget(doc, "sig"))
        Err(_e) -> false

// A string field of the `signed` member of a `Signed{...}` envelope.
fn signed_field_str(envelope: String, key: String) -> String:
    match json.decode(envelope):
        Ok(doc) -> match json.get(doc, "signed"):
            Some(signed) -> match json.get_string(signed, key):
                Some(s) -> s
                None -> ""
            None -> ""
        Err(_e) -> ""

// An int field of the `signed` member of a `Signed{...}` envelope.
fn signed_field_int(envelope: String, key: String) -> Int:
    match json.decode(envelope):
        Ok(doc) -> match json.get(doc, "signed"):
            Some(signed) -> match json.get_int(signed, key):
                Some(n) -> n
                None -> 0
            None -> 0
        Err(_e) -> 0

// A Json field of the `signed` member of a `Signed{...}` envelope (e.g. `targets`).
fn signed_field(envelope: String, key: String) -> Json:
    match json.decode(envelope):
        Ok(doc) -> match json.get(doc, "signed"):
            Some(signed) -> json.get(signed, key).unwrap_or(JsonNull)
            None -> JsonNull
        Err(_e) -> JsonNull

// The `registry_snapshot_version` pinned in the lock, or -1 if none (no registry deps).
fn pinned_snapshot_version(lock: String) -> Int:
    match toml.get(lock, "registry_snapshot_version"):
        Some(v) -> string.to_int(v)
        None -> -1

// The path-dependency names whose recomputed hash differs from the lockfile's.
fn hash_mismatches(root: Dir, dir: String, manifest: String, lock: String) -> List(String):
    var bad = []
    for pair in toml.table(manifest, "dependencies"):
        let (name, inline) = pair
        if let Some(rel) = toml.inline_get(inline, "path"):
            let dep_dir = normalize_path(join_path(dir, rel))
            if rune_hash(root, dep_dir) != locked_hash(lock, name):
                bad = list.push(bad, name)
    bad

// The `hash` field of the `[[rune]]` entry named `name`, or "(absent)".
fn locked_hash(lock: String, name: String) -> String:
    var found = "(absent)"
    for block in toml.array_tables(lock, "rune"):
        if entry_name(block) == name:
            found = entry_hash(block)
    found

fn entry_name(block: String) -> String:
    match toml.get(block, "name"):
        Some(n) -> n
        None -> ""

fn entry_hash(block: String) -> String:
    match toml.get(block, "hash"):
        Some(h) -> h
        None -> "(no-hash)"

// --- gate: block any dependency that demands new authority -------------------
// The supply-chain gate (§10), rights-aware. It recomputes the footprint the
// dependency sources actually demand and blocks any capability the lockfile's
// recorded baseline doesn't already admit — the upgrade/tamper that quietly
// widens authority. Capabilities listed after <dir> are accepted (like
// `--allow-cap`), folding into the baseline so an intended widening passes.
fn cmd_gate(console: Console, root: Dir, args: List(String)) -> Int:
    let dir = arg(args, 1)
    if string.is_empty(dir):
        print(console, "usage: pm gate <dir> [allowed-cap..]")
        1
    else if !exists(root, join_path(dir, "witchy.lock")):
        print(console, "no witchy.lock — run `pm lock " + dir + "` first")
        1
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        let lock = read(root, join_path(dir, "witchy.lock"))
        let baseline = union_all(lock_baseline(lock), allowed_from(args, 2))
        let demanded = resolution_footprint(root, dir, manifest)
        report_gate(console, root, dir, manifest, rights.uncovered(baseline, demanded))

fn report_gate(console: Console, root: Dir, dir: String, manifest: String, widened: List(String)) -> Int:
    if list.length(widened) == 0:
        print(console, "OK: dependencies demand no authority beyond witchy.lock")
        0
    else:
        print(console, "BLOCK: dependencies demand new authority: " + string.join(widened, ", "))
        for cap in widened:
            print(console, "  " + cap + " <- " + string.join(gate_contributors(root, dir, manifest, cap), ", "))
        2

// The capabilities the lockfile already records (union of every [[rune]] entry's
// runtime_footprint) — the baseline the gate diffs a new resolution against.
fn lock_baseline(lock: String) -> List(String):
    var out = []
    for block in toml.array_tables(lock, "rune"):
        for cap in toml.get_array(block, "runtime_footprint"):
            out = add_unique(out, cap)
    out

// The aggregate authority the current dependency sources demand.
fn resolution_footprint(root: Dir, dir: String, manifest: String) -> List(String):
    var out = []
    for pair in toml.table(manifest, "dependencies"):
        let (name, inline) = pair
        if let Some(rel) = toml.inline_get(inline, "path"):
            for cap in rune_footprint(root, normalize_path(join_path(dir, rel))):
                out = add_unique(out, cap)
    out

// The dependencies whose own footprint covers `cap` — who introduced it.
fn gate_contributors(root: Dir, dir: String, manifest: String, cap: String) -> List(String):
    var who = []
    for pair in toml.table(manifest, "dependencies"):
        let (name, inline) = pair
        if let Some(rel) = toml.inline_get(inline, "path"):
            if rights.covered(rune_footprint(root, normalize_path(join_path(dir, rel))), cap):
                who = list.push(who, name)
    who

fn allowed_from(let args: List(String), start: Int) -> List(String):
    var out = []
    var i = 0
    for a in args:
        if i >= start:
            out = list.push(out, a)
        i = i + 1
    out

fn union_all(a: List(String), b: List(String)) -> List(String):
    var out = a
    for x in b:
        out = add_unique(out, x)
    out

fn add_unique(xs: List(String), x: String) -> List(String):
    if has(xs, x):
        xs
    else:
        list.push(xs, x)

// The canonical lockfile text for a rune: a `[[rune]]` block per dependency,
// pinning its resolved version, source, content hash, and runtime footprint.
fn generate_lock(root: Dir, dir: String) -> String:
    let manifest = read(root, join_path(dir, "witchy.toml"))
    var out = "# witchy.lock — generated by `pm lock`. Pins every dependency by content\n# hash. Regenerate with `pm lock`; verify with `pm verify`. Do not edit by hand.\n"
    for pair in toml.table(manifest, "dependencies"):
        let (name, inline) = pair
        out = out + lock_entry(root, dir, name, inline)
    out

fn lock_entry(root: Dir, dir: String, name: String, inline: String) -> String:
    match toml.inline_get(inline, "path"):
        Some(rel) -> path_entry(root, dir, name, rel)
        None -> "\n[[rune]]\nname = \"" + name + "\"\nsource = \"coven\"\n# unresolved: registry deps need coven (pm publish/fetch)\n"

fn path_entry(root: Dir, dir: String, name: String, rel: String) -> String:
    let dep_dir = normalize_path(join_path(dir, rel))
    let dep_manifest = read(root, join_path(dep_dir, "witchy.toml"))
    let version = field(dep_manifest, "rune.version")
    let hash = rune_hash(root, dep_dir)
    let fp = footprint_toml(rune_footprint(root, dep_dir))
    "\n[[rune]]\nname = \"" + name + "\"\nversion = \"" + version + "\"\nsource = \"path:" + rel + "\"\nhash = \"" + hash + "\"\nruntime_footprint = [" + fp + "]\n"

// The rune's content address: the canonical hash over `witchy.toml` plus every
// `src/**/*.witchy` (recursively), matching coven's store byte-for-byte (so a
// witchy-checked lock agrees with a coven-generated one).
fn rune_hash(root: Dir, dir: String) -> String:
    var files = [("witchy.toml", read(root, join_path(dir, "witchy.toml")))]
    for f in fs.collect_files(root, join_path(dir, "src"), "src", ".witchy"):
        files = list.push(files, f)
    content_hash(files)

fn footprint_toml(caps: List(String)) -> String:
    var parts = []
    for c in caps:
        parts = list.push(parts, "\"" + c + "\"")
    string.join(parts, ", ")

// Collapse `a/b/../c` to `a/c`, dropping `.` and empty segments — the confined
// Dir capability rejects `..`, so a relative dep path must be resolved first.
// Lexically normalize a relative path, preserving leading `..` segments. A `..`
// that has a real prior segment to cancel pops it; a `..` with nothing left to
// pop (the path escapes its starting directory) is KEPT, so a sibling reference
// like `todo/../tasklib` normalizes to `tasklib` while `../tasklib` (from the
// workspace root) stays `../tasklib`. Dropping the leading `..` would silently
// rewrite a sibling path-dependency into a non-existent same-directory one.
fn normalize_path(let p: String) -> String:
    var stack = []
    for seg in string.split(p, "/"):
        if seg == "..":
            if can_pop(stack):
                stack = drop_last(stack)
            else:
                stack = list.push(stack, "..")
        else if seg != "" && seg != ".":
            stack = list.push(stack, seg)
    string.join(stack, "/")

// Whether the last segment of `stack` is a real directory `..` can cancel (i.e.
// not itself a leading `..`).
fn can_pop(stack: List(String)) -> Bool:
    let n = list.length(stack)
    n > 0 && list.at(stack, n - 1) != ".."

fn drop_last(xs: List(String)) -> List(String):
    var out = []
    let last = list.length(xs) - 1
    var i = 0
    for x in xs:
        if i < last:
            out = list.push(out, x)
        i = i + 1
    out

// --- update: re-resolve vendored deps to the latest released version ---------
// `update [name]` walks the project's `vendor/` tree (each vendored rune carries
// its signed `coven.json`, naming the full `ns/name` and pinned version), queries
// the registry for the latest released version of each, and re-fetches the ones
// that moved (verifying signature + hash), then regenerates `witchy.lock`. With a
// `name` argument only that rune is updated; the others stay pinned at their
// vendored version. Run from a project directory (cwd is the project Dir).
fn cmd_update(console: Console, net: Net, root: Dir, env: Env, args: List(String)) -> Int:
    let allowed = allowed_caps(args)
    let positional = update_positionals(args)
    let only = list.at(positional, 0)
    let addr = coven_addr(env, list.at(positional, 1))
    let (host, port) = hostport(addr)
    if !exists(root, "vendor"):
        print(console, "no vendored dependencies to update")
        0
    else:
        update_vendored(console, net, root, host, port, only, allowed)

// `update`'s positional args (`[only, addr]`), skipping the command word and any
// `--allow-cap <Cap>` flag pairs. Always length 2 (absent positionals are ""), so
// the caller can index freely.
fn update_positionals(args: List(String)) -> List(String):
    var out = ["", ""]
    var idx = 0
    var first = true
    var take = false
    for a in args:
        if first:
            first = false
        else if take:
            take = false
        else if a == "--allow-cap":
            take = true
        else if idx < 2:
            out = set_at(out, idx, a)
            idx = idx + 1
    out

// The capabilities a `--allow-cap <Cap>` flag consents to (so an intended widening
// passes the gate) — every value following an `--allow-cap` token.
fn allowed_caps(args: List(String)) -> List(String):
    var out = []
    var take = false
    for a in args:
        if take:
            out = list.push(out, a)
            take = false
        else if a == "--allow-cap":
            take = true
    out

fn set_at(xs: List(String), i: Int, v: String) -> List(String):
    var out = []
    var j = 0
    for x in xs:
        if j == i:
            out = list.push(out, v)
        else:
            out = list.push(out, x)
        j = j + 1
    out

fn update_vendored(console: Console, net: Net, root: Dir, host: String, port: Int, only: String, allowed: List(String)) -> Int:
    var changed = 0
    var blocked = false
    for entry in list(subdir(root, "vendor")):
        if string.is_empty(only) || entry == only:
            let outcome = update_one(console, net, root, host, port, entry, allowed)
            changed = changed + outcome.0
            if outcome.1:
                blocked = true
    if blocked:
        // Leave the vendored tree + lock untouched: a widening upgrade is the
        // supply-chain attack the gate exists to stop.
        2
    else:
        write(root, "witchy.lock", vendor_lock(root, snapshot_pin(net, host, port)))
        print(console, "updated ${changed} dependencies -> witchy.lock")
        0

// Re-fetch one vendored rune if the registry has a newer released version than the
// one currently vendored. Returns (changed, blocked): `changed` is 1 if it moved,
// `blocked` is true if the newer version WIDENS the rune's capability footprint
// beyond the vendored baseline (the gate) — in which case nothing is re-fetched.
fn update_one(console: Console, net: Net, root: Dir, host: String, port: Int, entry: String, allowed: List(String)) -> (Int, Bool):
    let rune_dir = join_path("vendor", entry)
    if !exists(root, join_path(rune_dir, "coven.json")):
        (0, false)
    else:
        let record = read(root, join_path(rune_dir, "coven.json"))
        let fullname = recorded_field(record, "name")
        let current = recorded_field(record, "version")
        let latest = latest_released(net, host, port, fullname)
        if string.is_empty(latest) || latest == current:
            (0, false)
        else:
            gated_refetch(console, net, root, host, port, fullname, current, latest, record, allowed)

// The capability gate: compare the incoming version's declared footprint (from its
// signed registry record) against the vendored baseline ∪ the consented caps. Any
// capability the baseline doesn't already admit is a widening of authority — BLOCK.
// Only on a clean (non-widening) upgrade do we re-fetch.
fn gated_refetch(console: Console, net: Net, root: Dir, host: String, port: Int, fullname: String, current: String, latest: String, baseline_record: String, allowed: List(String)) -> (Int, Bool):
    let baseline = union_all(recorded_footprint(baseline_record), allowed)
    let incoming = incoming_footprint(net, host, port, fullname, latest)
    let widened = rights.uncovered(baseline, incoming)
    if list.length(widened) > 0:
        print(console, "BLOCK: upgrading " + fullname + " " + current + " -> " + latest + " widens authority: " + string.join(widened, ", "))
        print(console, "  re-run with --allow-cap " + string.join(widened, " --allow-cap ") + " to consent")
        (0, true)
    else:
        (refetch(console, net, root, host, port, fullname, latest, current), false)

// The runtime footprint a registry version declares, from its signed record at
// `/coven/record` — the incoming authority the gate diffs against the baseline.
fn incoming_footprint(net: Net, host: String, port: Int, name: String, version: String) -> List(String):
    let resp = http.get(net, host, port, "/coven/record?name=" + wire(name) + "&version=" + version)
    if http.status(resp) != 200:
        []
    else:
        recorded_footprint(http.body(resp))

// The `runtime_footprint` array of a signed coven record (JSON), as capability strings.
fn recorded_footprint(record: String) -> List(String):
    match json.decode(record):
        Ok(doc) -> json.get_strings(doc, "runtime_footprint")
        Err(_e) -> []

fn refetch(console: Console, net: Net, root: Dir, host: String, port: Int, fullname: String, latest: String, current: String) -> Int:
    let code = fetch_source(console, net, root, host, port, fullname, latest, "vendor")
    if code != 0:
        0
    else:
        print(console, "updated " + fullname + " " + current + " -> " + latest)
        1

// The highest released version of `name` in the registry, or "" if none.
fn latest_released(net: Net, host: String, port: Int, name: String) -> String:
    let resp = http.get(net, host, port, "/coven/versions?name=" + wire(name))
    if http.status(resp) != 200:
        ""
    else:
        match latest_version(released_versions(http.body(resp))):
            Some(v) -> semver.format(v)
            None -> ""

// --- add: resolve + fetch a rune (and its deps) from a coven registry --------
// Resolves a version requirement against the registry's released versions
// (std/semver), fetches the chosen version's source (verifying its signed
// record + content hash), materializes it, and then resolves the fetched rune's
// own version dependencies transitively. The vendored tree under <dest> doubles
// as the visited-set: a rune already carrying its coven.json is never re-fetched,
// which makes a diamond or a dependency cycle terminate. This command needs the
// network.
fn cmd_add(console: Console, net: Net, root: Dir, env: Env, clock: Clock, args: List(String)) -> Int:
    let pos = positionals(args)
    if string.is_empty(arg(pos, 3)):
        cmd_add_pkg(console, net, root, env, clock, args)
    else:
        let name = arg(pos, 1)
        let req = arg(pos, 2)
        let addr = arg(pos, 3)
        let dest = arg(pos, 4)
        let (host, port) = hostport(addr)
        add_rune(console, net, root, host, port, name, req, dest, cooldown_now(env, clock, args), [])

// Cargo-like `add <pkg>[@<ver>]`: resolve the registry from COVEN_URL (or an
// explicit second `<host:port>` argument), default the requirement to the latest
// released version when no `@<ver>` is given, fetch+verify, vendor into the
// project's `vendor/<basename>`, and pin the resolved version in `witchy.lock`.
// Run from a project directory (cwd is the project Dir). This is the cargo-style
// front-end `add` of RFC-0004 — a stable vendor/lock layout the project `build`/
// `run` then resolves through `witchy compile --dep`.
fn cmd_add_pkg(console: Console, net: Net, root: Dir, env: Env, clock: Clock, args: List(String)) -> Int:
    let pos = positionals(args)
    let spec = arg(pos, 1)
    if string.is_empty(spec):
        print(console, "usage: pm add <pkg>[@<ver>] [host:port] [--allow-cap <Cap>]... [--allow-fresh]")
        1
    else:
        let (name, req) = split_spec(spec)
        let addr = coven_addr(env, arg(pos, 2))
        let (host, port) = hostport(addr)
        add_pkg_gated(console, net, root, host, port, name, req, cooldown_now(env, clock, args), allowed_caps(args))

// A direct `add` is the consumer's deliberate choice to take on a dependency, so
// it is gated: if the rune introduces a capability the project does not already
// admit (its own declared caps ∪ what the lock already records ∪ the caps the
// consumer consented to with `--allow-cap`), the add is BLOCKED. The transitive
// closure a consented direct add pulls in is NOT re-gated — consenting to a rune
// is consenting to its declared dependency tree (which the registry footprinted).
fn add_pkg_gated(console: Console, net: Net, root: Dir, host: String, port: Int, name: String, req: String, cooldown: (Int, Int, Bool), allowed: List(String)) -> Int:
    match resolve_version(net, host, port, name, req, cooldown):
        Err(msg) ->
            print(console, name + ": " + msg)
            1
        Ok(chosen) ->
            let baseline = union_all(project_baseline(root), allowed)
            let incoming = incoming_footprint(net, host, port, name, chosen)
            let widened = rights.uncovered(baseline, incoming)
            if list.length(widened) > 0:
                print(console, "BLOCKED: adding `" + name + "` would widen your project's capability footprint: " + string.join(widened, ", "))
                print(console, "  re-run with --allow-cap " + string.join(widened, " --allow-cap ") + " to consent")
                2
            else:
                let code = add_rune(console, net, root, host, port, name, req, "vendor", cooldown, [])
                if code != 0:
                    code
                else:
                    pin_lock(console, net, root, host, port, name)

// The capability authority the project already admits: its own declared runtime
// caps (from witchy.toml, if any) plus every capability the lockfile already
// records for a vendored dependency — the baseline a new direct `add` diffs
// against, so adding a same-or-narrower rune is silent and a widening one gates.
fn project_baseline(root: Dir) -> List(String):
    var out = []
    if exists(root, "witchy.toml"):
        for c in declared_caps(read(root, "witchy.toml")):
            out = add_unique(out, c)
    if exists(root, "witchy.lock"):
        out = union_all(out, lock_baseline(read(root, "witchy.lock")))
    out

// Split `<pkg>[@<ver>]` into a (name, requirement); an absent `@<ver>` resolves to
// `*` (the latest released version). A leading-`@` namespace is not split.
fn split_spec(spec: String) -> (String, String):
    if string.contains(spec, "@"):
        let (name, ver) = string.rsplit_once(spec, "@")
        if string.is_empty(name): (spec, "*") else: (name, ver)
    else:
        (spec, "*")

// Record the resolved dependency in the project's `witchy.lock`: a `[[rune]]`
// entry pinning the vendored rune's name, resolved version, source (coven), and
// content hash, so `build`/`run` can map `import <basename>` to its vendored
// source and `verify`/`gate` can re-check it. Idempotently rewrites the lock from
// every currently-vendored rune so repeated `add`s accumulate, not clobber.
fn pin_lock(console: Console, net: Net, root: Dir, host: String, port: Int, name: String) -> Int:
    write(root, "witchy.lock", vendor_lock(root, snapshot_pin(net, host, port)))
    print(console, "locked " + basename(name) + " -> witchy.lock")
    0

// The `registry_snapshot_version = N` top-level line pinning the registry's current
// TUF snapshot version into the lock — the rollback baseline `verify` enforces. The
// snapshot role is signed; we record the version the `add` resolved against. An
// empty string when the registry serves no snapshot (nothing to pin).
fn snapshot_pin(net: Net, host: String, port: Int) -> String:
    let resp = http.get(net, host, port, "/coven/snapshot")
    if http.status(resp) != 200:
        ""
    else:
        let v = signed_field_int(http.body(resp), "version")
        "registry_snapshot_version = ${v}\n"

// The lockfile text generated from the vendored tree: one `[[rune]]` block per
// vendored rune (those carrying a coven.json), pinning name/version/hash from the
// signed record kept beside the source. `snapshot_line` is the TUF snapshot pin
// (a top-level key, emitted BEFORE any `[[rune]]` array-table per TOML rules).
fn vendor_lock(root: Dir, snapshot_line: String) -> String:
    var out = "# witchy.lock — generated by `pm add`. Pins every vendored dependency\n# by content hash. Regenerate with `pm add`. Do not edit by hand.\n" + snapshot_line
    if exists(root, "vendor"):
        for entry in list(subdir(root, "vendor")):
            let rune_dir = join_path("vendor", entry)
            if exists(root, join_path(rune_dir, "coven.json")):
                out = out + vendor_lock_entry(root, entry, rune_dir)
    out

fn vendor_lock_entry(root: Dir, name: String, rune_dir: String) -> String:
    let record = read(root, join_path(rune_dir, "coven.json"))
    let version = recorded_field(record, "version")
    let hash = recorded_field(record, "hash")
    let fp = footprint_toml(recorded_footprint(record))
    "\n[[rune]]\nname = \"" + name + "\"\nversion = \"" + version + "\"\nsource = \"coven\"\nhash = \"" + hash + "\"\nruntime_footprint = [" + fp + "]\n"

fn recorded_field(record: String, key: String) -> String:
    match json.decode(record):
        Ok(doc) -> jget(doc, key)
        Err(_e) -> ""

// Resolve + fetch one rune and its transitive deps. Already-vendored runes (their
// coven.json is present) are skipped — the dedup + cycle break. But a rune already
// vendored under this basename whose FULL name differs is a collision: two distinct
// runes (`a/util` and `b/util`) would vendor to the same `vendor/util`, so the
// second silently shadows the first. Refuse it — `import util` cannot name both.
fn add_rune(console: Console, net: Net, root: Dir, host: String, port: Int, name: String, req: String, dest: String, cooldown: (Int, Int, Bool), allowed: List(String)) -> Int:
    let vendored = join_path(dest, basename(name))
    if exists(root, join_path(vendored, "coven.json")):
        let existing = recorded_field(read(root, join_path(vendored, "coven.json")), "name")
        if !string.is_empty(existing) && existing != name:
            print(console, "BLOCK: module name collision — `" + name + "` and `" + existing + "` both vendor to `" + vendored + "` (same basename `" + basename(name) + "`)")
            2
        else:
            0
    else:
        match resolve_version(net, host, port, name, req, cooldown):
            Ok(chosen) -> fetch_then_deps(console, net, root, host, port, name, chosen, dest, cooldown, allowed)
            Err(e) ->
                print(console, name + ": " + e)
                1

// Resolve `req` against the registry's released versions, honoring the staging
// cooldown: a release younger than the cooldown window is not resolvable (the
// compromised-release window, §8) unless `--allow-fresh` was passed. If the only
// matching versions are still cooling, the error explains the window + override.
fn resolve_version(net: Net, host: String, port: Int, name: String, req: String, cooldown: (Int, Int, Bool)) -> Result(String, String):
    let resp = http.get(net, host, port, "/coven/versions?name=" + wire(name))
    if http.status(resp) != 200:
        Err("registry error fetching versions")
    else:
        let body = http.body(resp)
        match pick_version_cooled(body, req, cooldown):
            Ok(v) -> Ok(v)
            Err(e) ->
                if has_cooling_match(body, req, cooldown):
                    Err("a release satisfying `" + req + "` is inside its staging cooldown and not resolvable yet (compromised-release protection) — re-run with --allow-fresh to accept it now")
                else:
                    Err(e)

// Fetch a resolved version, then recurse into the version deps its manifest
// declares. The exit code is the first failure (0 if the whole tree resolves).
fn fetch_then_deps(console: Console, net: Net, root: Dir, host: String, port: Int, name: String, version: String, dest: String, cooldown: (Int, Int, Bool), allowed: List(String)) -> Int:
    let code = fetch_source(console, net, root, host, port, name, version, dest)
    if code != 0:
        code
    else:
        add_deps(console, net, root, host, port, name, dest, cooldown, allowed)

fn add_deps(console: Console, net: Net, root: Dir, host: String, port: Int, name: String, dest: String, cooldown: (Int, Int, Bool), allowed: List(String)) -> Int:
    let manifest = read(root, join_path(join_path(dest, basename(name)), "witchy.toml"))
    var code = 0
    for pair in toml.table(manifest, "dependencies"):
        let (depname, inline) = pair
        if let Some(depreq) = toml.inline_get(inline, "version"):
            let sub = add_rune(console, net, root, host, port, depname, depreq, dest, cooldown, allowed)
            if sub != 0:
                code = sub
    code

// The highest released-and-eligible version satisfying `req`, or an explanatory
// error. A release still inside its staging cooldown is excluded (unless
// `--allow-fresh`) — `resolve_version` distinguishes "none satisfy" from "the
// only match is cooling" for a clearer message.
fn pick_version_cooled(body: String, req: String, cooldown: (Int, Int, Bool)) -> Result(String, String):
    match semver.parse_req(req):
        Ok(r) -> choose(eligible_versions(body, cooldown), r, req)
        Err(e) -> Err("bad requirement `" + req + "`: " + e)

fn choose(versions: List(Version), r: Req, req: String) -> Result(String, String):
    match semver.best(versions, r):
        Some(v) -> Ok(semver.format(v))
        None -> Err("no released version satisfies `" + req + "`")

// The released versions in a /coven/versions response, parsed (cooldown-agnostic;
// used by `outdated`/`update` which report the latest, not resolve-for-install).
fn released_versions(body: String) -> List(Version):
    eligible_versions(body, (0, 0, true))

// Released versions that are resolvable now: state `released` AND past the staging
// cooldown window (or `--allow-fresh`). A record's `released_at` (unix seconds, in
// the signed payload so it can't be tampered away) plus the window must be ≤ now.
fn eligible_versions(body: String, cooldown: (Int, Int, Bool)) -> List(Version):
    var out = []
    for rec in released_records(body):
        if !cooling(rec, cooldown):
            if let Ok(v) = semver.parse(jget(rec, "version")):
                out = list.push(out, v)
    out

// Whether any released version satisfying `req` exists but is still cooling — so
// the caller can say "blocked by cooldown" instead of "no version".
fn has_cooling_match(body: String, req: String, cooldown: (Int, Int, Bool)) -> Bool:
    match semver.parse_req(req):
        Err(_e) -> false
        Ok(r) ->
            var found = false
            for rec in released_records(body):
                if cooling(rec, cooldown):
                    if let Ok(v) = semver.parse(jget(rec, "version")):
                        if semver.matches(r, v):
                            found = true
            found

// The `released`-state records of a /coven/versions response, as raw Json.
fn released_records(body: String) -> List(Json):
    var out = []
    if let Ok(doc) = json.decode(body):
        if let Some(records) = json.get(doc, "records"):
            if let Some(items) = json.as_array(records):
                for rec in items:
                    if jget(rec, "state") == "released":
                        out = list.push(out, rec)
    out

// Whether a released record is still inside its staging cooldown window. A
// `released_at` of 0 (legacy/unstamped) is treated as past any window; with
// `--allow-fresh` nothing cools. `cooldown` is (now_unix_secs, window_secs,
// allow_fresh).
fn cooling(rec: Json, cooldown: (Int, Int, Bool)) -> Bool:
    let (now_secs, window, allow_fresh) = cooldown
    let released_at = jget_int(rec, "released_at")
    if allow_fresh || released_at == 0:
        false
    else:
        now_secs < released_at + window

// The cooldown context for this `add`: (now_unix_secs, window_secs, allow_fresh).
// The window is `WITCHY_COOLDOWN_SECS` (Env; default 72h); `--allow-fresh` accepts
// a still-cooling release. The wall clock comes from the `Clock` capability (ms →
// seconds, matching the registry's `released_at` unit).
fn cooldown_now(env: Env, clock: Clock, args: List(String)) -> (Int, Int, Bool):
    (now(clock) / 1000, cooldown_window(env), has_flag(args, "--allow-fresh"))

fn cooldown_window(env: Env) -> Int:
    match get_env(env, "WITCHY_COOLDOWN_SECS"):
        Some(v) -> string.to_int(v)
        None -> 259200

fn has_flag(args: List(String), flag: String) -> Bool:
    var found = false
    for a in args:
        if a == flag:
            found = true
    found

// The positional arguments (no `--flag` and no `--flag value` pairs). `--allow-cap`
// takes a value (the consented capability); `--allow-fresh` / `--dry-run` are bare.
fn positionals(args: List(String)) -> List(String):
    var out = []
    var skip = false
    for a in args:
        if skip:
            skip = false
        else if a == "--allow-cap" || a == "--allow-build-cap":
            skip = true
        else if !string.starts_with(a, "--"):
            out = list.push(out, a)
    out

// Fetch a version, verifying the full trust chain before writing anything: the
// registry's record must be validly signed by its root key, and the fetched
// source must hash to that signed hash. An untrusted mirror cannot swap the
// bytes — content addressing + the signature, not the transport, are trusted.
fn fetch_source(console: Console, net: Net, root: Dir, host: String, port: Int, name: String, version: String, dest: String) -> Int:
    let rootpub = http.body(http.get(net, host, port, "/coven/rootpub"))
    let record = http.get(net, host, port, "/coven/record?name=" + wire(name) + "&version=" + version)
    if http.status(record) != 200:
        print(console, "registry has no record for " + name + "@" + version)
        1
    else if !record_signature_valid(rootpub, http.body(record)):
        print(console, "BLOCK: registry record for " + name + "@" + version + " has an invalid signature — refusing to trust it")
        1
    else:
        fetch_verified(console, net, root, host, port, name, version, dest, http.body(record))

fn fetch_verified(console: Console, net: Net, root: Dir, host: String, port: Int, name: String, version: String, dest: String, record: String) -> Int:
    let resp = http.get(net, host, port, "/coven/source?name=" + wire(name) + "&version=" + version)
    if http.status(resp) != 200:
        print(console, "registry has no source for " + name + "@" + version)
        1
    else:
        let files = source_files(http.body(resp))
        if content_hash(files) != recorded_hash(record):
            print(console, "BLOCK: integrity failure — fetched source for " + name + "@" + version + " does not match the signed hash (tampered mirror?)")
            1
        else:
            let base = join_path(dest, basename(name))
            for f in files:
                let (path, text) = f
                let full = join_path(base, path)
                fs.ensure_dir(root, fs.parent_dir(full))
                write(root, full, text)
            // Keep the signed record next to the source, so the vendored rune
            // carries its own provenance and can be re-verified offline.
            write(root, join_path(base, "coven.json"), record)
            print(console, "added " + name + "@" + version + " -> " + base)
            0

fn source_files(body: String) -> List((String, String)):
    var out = []
    if let Ok(doc) = json.decode(body):
        if let Some(files) = json.get(doc, "files"):
            if let Some(items) = json.as_array(files):
                for entry in items:
                    out = list.push(out, (json_index_str(entry, 0), json_index_str(entry, 1)))
    out

// The content address of an in-memory rune source (matches coven / crypto.rune_hash).
fn content_hash(files: List((String, String))) -> String:
    var paths = []
    var texts = []
    for f in files:
        let (p, t) = f
        paths = list.push(paths, p)
        texts = list.push(texts, t)
    crypto.rune_hash(paths, texts)

fn recorded_hash(text: String) -> String:
    match json.decode(text):
        Ok(doc) -> jget(doc, "hash")
        Err(e) -> ""

// --- verify-rune: offline re-verification of a vendored rune -----------------
// A rune fetched by `add` carries its signed coven.json. Given the registry's
// root public key (TOFU-pinned), re-verify it with no network: the record must
// be validly signed, and the on-disk source must still hash to the signed hash.
fn cmd_verify_rune(console: Console, root: Dir, dir: String, rootpub: String) -> Int:
    if string.is_empty(dir) || string.is_empty(rootpub):
        print(console, "usage: pm verify-rune <vendored-rune-dir> <registry-root-pubkey-hex>")
        1
    else if !exists(root, join_path(dir, "coven.json")):
        print(console, "no coven.json in " + dir + " — not a rune fetched with provenance")
        1
    else:
        report_rune_verify(console, root, dir, rootpub, read(root, join_path(dir, "coven.json")))

// --- verify-vendor: re-verify a whole vendored tree offline ------------------
// Walk every rune under <dir> that carries a coven.json and re-verify it (the
// same signature + content check as verify-rune). A CI gate over an entire
// vendored dependency graph; exits 2 if any rune fails.
fn cmd_verify_vendor(console: Console, root: Dir, dir: String, rootpub: String) -> Int:
    if string.is_empty(dir) || string.is_empty(rootpub):
        print(console, "usage: pm verify-vendor <vendor-dir> <registry-root-pubkey-hex>")
        1
    else if !exists(root, dir):
        print(console, "no such directory: " + dir)
        1
    else:
        var total = 0
        var failed = 0
        for entry in list(subdir(root, dir)):
            let rune_dir = join_path(dir, entry)
            if exists(root, join_path(rune_dir, "coven.json")):
                total = total + 1
                if report_rune_verify(console, root, rune_dir, rootpub, read(root, join_path(rune_dir, "coven.json"))) != 0:
                    failed = failed + 1
        verdict_vendor(console, total, failed)

fn verdict_vendor(console: Console, total: Int, failed: Int) -> Int:
    if total == 0:
        print(console, "no vendored runes (no coven.json) found")
        1
    else if failed == 0:
        print(console, "OK: all ${total} vendored runes verified")
        0
    else:
        print(console, "BLOCK: ${failed} of ${total} vendored runes failed verification")
        2

fn report_rune_verify(console: Console, root: Dir, dir: String, rootpub: String, record: String) -> Int:
    if !record_signature_valid(rootpub, record):
        print(console, "BLOCK: " + dir + "/coven.json is not validly signed by that root key — refusing")
        2
    else if rune_hash(root, dir) != recorded_hash(record):
        print(console, "BLOCK: " + dir + " source no longer matches its signed hash (tampered)")
        2
    else:
        match json.decode(record):
            Ok(doc) -> print(console, "OK: " + jget(doc, "name") + "@" + jget(doc, "version") + " verified (signature + content), no network")
            Err(e) -> print(console, "OK: verified")

        0

// Verify a registry record is signed by the root key over its canonical payload
// (byte-identical to coven's Record signing payload).
fn record_signature_valid(rootpub: String, text: String) -> Bool:
    match json.decode(text):
        Ok(doc) -> crypto.ed25519_verify(rootpub, record_payload(doc), jget(doc, "sig"))
        Err(e) -> false

fn record_payload(doc: Json) -> String:
    "coven-v1\nname=" + jget(doc, "name") + "\nversion=" + jget(doc, "version") + "\nstate=" + jget(doc, "state") + "\nhash=" + jget(doc, "hash") + "\nrt=" + string.join(json.get_strings(doc, "runtime_footprint"), ",") + "\nbuild=\nuploaded_by=" + jget(doc, "uploaded_by") + "\npromoted_by=" + jget(doc, "promoted_by") + "\nfactor=" + jget(doc, "second_factor") + "\nprovenance=" + jget(doc, "provenance") + "\nreleased_at=" + "${jget_int(doc, "released_at")}"

fn jget_int(doc: Json, key: String) -> Int:
    match json.get(doc, key):
        Some(j) -> match json.as_int(j):
            Some(n) -> n
            None -> 0
        None -> 0

// --- registry/url helpers ----------------------------------------------------
fn hostport(addr: String) -> (String, Int):
    let (host, portstr) = string.split_once(addr, ":")
    (host, string.to_int(portstr))

// Rune names contain `/`; the wire encodes it as `~` for a query value.
fn wire(name: String) -> String:
    string.join(string.split(name, "/"), "~")

fn basename(name: String) -> String:
    if string.contains(name, "/"):
        let (_ns, base) = string.rsplit_once(name, "/")
        base
    else:
        name

fn jget(doc: Json, key: String) -> String:
    match json.get(doc, key):
        Some(j) -> match json.as_string(j):
            Some(s) -> s
            None -> ""
        None -> ""

fn json_index_str(j: Json, i: Int) -> String:
    match json.index(j, i):
        Some(v) -> match json.as_string(v):
            Some(s) -> s
            None -> ""
        None -> ""

// --- new: scaffold a rune ----------------------------------------------------
fn cmd_new(console: Console, root: Dir, name: String):
    if string.is_empty(name):
        print(console, "usage: pm new <name>")
    else:
        make_dir(root, name)
        make_dir(root, join_path(name, "src"))
        write(root, join_path(name, "witchy.toml"), manifest_stub(name))
        write(root, join_path(join_path(name, "src"), name + ".witchy"), src_stub(name))
        print(console, "created rune `" + name + "`:")
        print(console, "  " + join_path(name, "witchy.toml"))
        print(console, "  " + join_path(join_path(name, "src"), name + ".witchy"))

fn manifest_stub(let name: String) -> String:
    "[rune]\nname = \"" + name + "\"\nversion = \"0.1.0\"\n\n[capabilities]\nruntime = [\"Console\"]\n\n[dependencies]\n"

fn src_stub(let name: String) -> String:
    "fn main(console: Console):\n    print(console, \"hello from " + name + "\")\n"

// --- footprint helpers -------------------------------------------------------

// The capabilities the rune's source actually demands. The source is the first
// `.witchy` under <dir>/src — found by listing, so the file name need not match
// the rune name.
fn rune_footprint(root: Dir, dir: String) -> List(String):
    let src = subdir(root, join_path(dir, "src"))
    match first_witchy(list(src)):
        Some(file) -> footprint_total(compiler.footprint(read(src, file)))
        None -> []

fn first_witchy(let files: List(String)) -> Option(String):
    var found = None
    for f in files:
        if is_none(found) && string.ends_with(f, ".witchy"):
            found = Some(f)
    found

// Pull the "total" array out of a footprint JSON report.
fn footprint_total(let report: String) -> List(String):
    match json.decode(report):
        Ok(doc) -> json.get_strings(doc, "total")
        Err(e) -> []

fn declared_caps(let manifest: String) -> List(String):
    toml.get_array(manifest, "capabilities.runtime")

fn field(let manifest: String, path: String) -> String:
    match toml.get(manifest, path):
        Some(v) -> v
        None -> "(none)"

// --- compiler.diff JSON helpers ---------------------------------------------
fn widened(doc: Json) -> Bool:
    match json.get(doc, "widened"):
        Some(w) -> bool_or(w, false)
        None -> false

fn bool_or(j: Json, default: Bool) -> Bool:
    match json.as_bool(j):
        Some(b) -> b
        None -> default

fn added(doc: Json) -> String:
    string.join(json.get_strings(doc, "added"), ", ")

// --- small generic helpers ---------------------------------------------------
fn arg(let args: List(String), i: Int) -> String:
    if i < list.length(args):
        list.at(args, i)
    else:
        ""

fn has(let xs: List(String), x: String) -> Bool:
    var found = false
    for it in xs:
        if it == x:
            found = true
    found

fn join_path(let a: String, b: String) -> String:
    a + "/" + b

fn is_none(o: Option(String)) -> Bool:
    match o:
        Some(_) -> false
        None -> true

fn usage(console: Console):
    print(console, "pm — the witchy package manager")
    print(console, "usage: pm <command> [args]")
    print(console, "  info  <dir>         summarize a rune")
    print(console, "  audit <file>        footprint a source file demands")
    print(console, "  check <dir>         declared footprint must admit the code")
    print(console, "  guard <old> <new>   BLOCK if <new> widens authority")
    print(console, "  deps  <dir>         list a rune's dependencies")
    print(console, "  lock  <dir>         pin dependencies by content hash -> witchy.lock")
    print(console, "  verify <dir>        witchy.lock must match the dependency sources")
    print(console, "  gate  <dir> [cap..] BLOCK if deps demand authority beyond the lock")
    print(console, "  why   <dir> <name>  explain a dependency's presence")
    print(console, "  why-cap <dir> <Cap> which deps introduce a capability")
    print(console, "  add <pkg>[@<ver>] [host:port]    fetch + vendor a rune, pin it in witchy.lock")
    print(console, "  add <name> <req> <coven> <dest>  resolve + fetch a rune into <dest> (explicit)")
    print(console, "  publish <dir> [host:port] [id]    stage a rune to a coven registry")
    print(console, "  promote <name> <ver> [host:port] [id]  release a staged version")
    print(console, "  yank  <name> <ver> [host:port]   flag a released version as yanked")
    print(console, "  list  <name> [host:port]         every version of a rune and its state")
    print(console, "  outdated <dir> <host:port>       latest released version of each dep")
    print(console, "  update [name] [host:port]        re-fetch vendored deps to their latest release")
    print(console, "  verify-rune <dir> <rootpub>  re-verify a vendored rune offline (coven.json)")
    print(console, "  verify-vendor <dir> <rootpub>  re-verify every vendored rune offline")
    print(console, "  vendor <dir>        materialize path deps into <dir>/vendor")
    print(console, "  new   <name>        scaffold a new rune")
    print(console, "  init  [name]        add a manifest to an existing directory")
    print(console, "  tree  <dir>         show a rune and its dependencies")
    print(console, "  run   <file|dir>    compile and run a program/project (drives the compiler)")
    print(console, "  build <file|dir>    compile a program/project to verify it builds")
    print(console, "  typecheck <file>    type-check a program")
    print(console, "  test  <dir>         run a rune's tests")
    print(console, "  fmt   <file>        format a source file")
    print(console, "  doc   <file>        render a module's documentation")

fn unknown(console: Console, cmd: String) -> Int:
    print(console, "unknown command: " + cmd)
    usage(console)
    1
