// pm — the witchy package manager, written in witchy. It reads `witchy.toml`
// manifests, audits a rune's capability footprint, checks that the declared
// footprint *admits* what the code actually demands (rights-precisely), and
// guards an upgrade against any widening of authority. The capability work goes
// through `compiler` (a host introspection intrinsic), so pm runs on the
// interpreter — the way a build tool is allowed to. It is the package manager's
// heart, self-hosted.
//
//   witchy projects/pm/src/pm.witchy <command> [args]
//
// Commands:
//   info  <dir>          summarize a rune (name, version, declared vs. actual caps)
//   audit <file>         print the capability footprint a source file demands
//   check <dir>          verify the manifest's declared footprint admits the code
//   guard <old> <new>    BLOCK if <new> widens the footprint of <old>
//   new   <name>         scaffold a new rune (manifest + src stub)
//   help                 show this message

import compiler
import crypto
import fs
import http
import json
import rights
import semver
import string
import toml

fn main(console: Console, args: List(String), root: Dir, net: Net) -> Int:
    let cmd = arg(args, 0)
    if cmd == "info":
        cmd_info(console, root, arg(args, 1))
        0
    else if cmd == "add":
        cmd_add(console, net, root, args)
    else if cmd == "audit":
        cmd_audit(console, root, arg(args, 1))
        0
    else if cmd == "check":
        cmd_check(console, root, arg(args, 1))
    else if cmd == "guard":
        cmd_guard(console, root, arg(args, 1), arg(args, 2))
    else if cmd == "deps":
        cmd_deps(console, root, arg(args, 1))
        0
    else if cmd == "lock":
        cmd_lock(console, root, arg(args, 1))
    else if cmd == "verify":
        cmd_verify(console, root, arg(args, 1))
    else if cmd == "gate":
        cmd_gate(console, root, args)
    else if cmd == "verify-rune":
        cmd_verify_rune(console, root, arg(args, 1), arg(args, 2))
    else if cmd == "verify-vendor":
        cmd_verify_vendor(console, root, arg(args, 1), arg(args, 2))
    else if cmd == "new":
        cmd_new(console, root, arg(args, 1))
        0
    else if cmd == "" || cmd == "help":
        usage(console)
        0
    else:
        unknown(console, cmd)

// --- info: a one-screen summary of a rune -----------------------------------
fn cmd_info(console: Console, root: Dir, dir: String):
    if string.is_empty(dir):
        print(console, "usage: pm info <dir>")
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        print(console, "name:     " + field(manifest, "rune.name"))
        print(console, "version:  " + field(manifest, "rune.version"))
        print(console, "declared: " + string.join(declared_caps(manifest), ", "))
        print(console, "actual:   " + string.join(rune_footprint(root, dir), ", "))

// --- audit: the footprint a single file demands -----------------------------
fn cmd_audit(console: Console, root: Dir, file: String):
    if string.is_empty(file):
        print(console, "usage: pm audit <file>")
    else:
        let report = compiler.footprint(read(root, file))
        print(console, file + " demands: " + string.join(footprint_total(report), ", "))

// --- check: declared footprint must admit the actual footprint ---------------
// The manifest's declared caps are *not trusted*: pm recomputes the footprint
// from source and fails if the code reaches for authority the manifest never
// admits — rights-precisely, so a declared `Net[Connect]` does NOT admit a
// demanded full `Net` (the under-declaration a supply-chain attacker relies on).
fn cmd_check(console: Console, root: Dir, dir: String) -> Int:
    if string.is_empty(dir):
        print(console, "usage: pm check <dir>")
        1
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        let declared = declared_caps(manifest)
        let demanded = rune_footprint(root, dir)
        let undeclared = rights.uncovered(declared, demanded)
        let unused = unused_caps(declared, demanded)
        report_check(console, undeclared, unused)

fn report_check(console: Console, undeclared: List(String), unused: List(String)) -> Int:
    if !string.is_empty(string.join(undeclared, ", ")):
        print(console, "BLOCK: code demands authority not admitted by [capabilities]: " + string.join(undeclared, ", "))
        2
    else:
        if !string.is_empty(string.join(unused, ", ")):
            print(console, "OK (lint): declared but unused: " + string.join(unused, ", "))
        else:
            print(console, "OK: declared footprint admits the code, nothing unused")
        0

// Declared capabilities that admit nothing the code demands.
fn unused_caps(declared: List(String), demanded: List(String)) -> List(String):
    var extra = []
    for d in declared:
        if !admits_any(d, demanded):
            extra = list.push(extra, d)
    extra

fn admits_any(declared: String, demanded: List(String)) -> Bool:
    var any = false
    for c in demanded:
        if rights.covers(declared, c):
            any = true
    any

// --- guard: block an upgrade that widens authority --------------------------
fn cmd_guard(console: Console, root: Dir, old: String, new: String) -> Int:
    if string.is_empty(old) || string.is_empty(new):
        print(console, "usage: pm guard <old-file> <new-file>")
        1
    else:
        let report = compiler.diff(read(root, old), read(root, new))
        print(console, verdict(report))
        exit_for(report)

fn verdict(report: String) -> String:
    match json.decode(report):
        Ok(doc) -> if widened(doc): "BLOCK: upgrade widens authority by " + added(doc) else: "OK: no new authority"
        Err(e) -> "error: " + e

fn exit_for(report: String) -> Int:
    match json.decode(report):
        Ok(doc) -> if widened(doc): 2 else: 0
        Err(e) -> 1

// --- deps: list a rune's dependencies ---------------------------------------
fn cmd_deps(console: Console, root: Dir, dir: String):
    if string.is_empty(dir):
        print(console, "usage: pm deps <dir>")
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        let deps = toml.table(manifest, "dependencies")
        if list.length(deps) == 0:
            print(console, "(no dependencies)")
        else:
            for pair in deps:
                let (name, inline) = pair
                print(console, name + " -> " + dep_source(inline))

fn dep_source(let inline: String) -> String:
    match toml.inline_get(inline, "path"):
        Some(p) -> "path:" + p
        None -> version_source(inline)

fn version_source(let inline: String) -> String:
    match toml.inline_get(inline, "version"):
        Some(v) -> "version:" + v
        None -> "(unspecified)"

// --- lock: pin every dependency by content hash ------------------------------
// The lockfile is regenerated from source, so it can never disagree with the
// bytes on disk: `lock` writes the hashes, `verify` recomputes and compares.
fn cmd_lock(console: Console, root: Dir, dir: String) -> Int:
    if string.is_empty(dir):
        print(console, "usage: pm lock <dir>")
        1
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        let n = list.length(toml.table(manifest, "dependencies"))
        let lockpath = join_path(dir, "witchy.lock")
        write(root, lockpath, generate_lock(root, dir))
        print(console, "locked ${n} dependencies -> ${lockpath}")
        0

// --- verify: every locked hash must still match its source ------------------
// Parses the lockfile's `[[rune]]` entries and recomputes each path dependency's
// content hash, so it validates *any* witchy.lock — including one coven wrote.
// A mismatch (or a missing entry) means the pinned bytes no longer match disk:
// tampering or a stale lock. Exits 2 on any discrepancy.
fn cmd_verify(console: Console, root: Dir, dir: String) -> Int:
    if string.is_empty(dir):
        print(console, "usage: pm verify <dir>")
        1
    else if !exists(root, join_path(dir, "witchy.lock")):
        print(console, "no witchy.lock — run `pm lock " + dir + "` first")
        1
    else:
        let lock = read(root, join_path(dir, "witchy.lock"))
        let manifest = read(root, join_path(dir, "witchy.toml"))
        report_verify(console, hash_mismatches(root, dir, manifest, lock))

fn report_verify(console: Console, bad: List(String)) -> Int:
    if list.length(bad) == 0:
        print(console, "OK: every locked hash matches the dependency sources")
        0
    else:
        print(console, "BLOCK: lock no longer matches source for: " + string.join(bad, ", "))
        2

// The path-dependency names whose recomputed hash differs from the lockfile's.
fn hash_mismatches(root: Dir, dir: String, manifest: String, lock: String) -> List(String):
    var bad = []
    for pair in toml.table(manifest, "dependencies"):
        let (name, inline) = pair
        if let Some(rel) = toml.inline_get(inline, "path"):
            let dep_dir = normalize_path(join_path(dir, rel))
            if rune_hash(root, dep_dir) != locked_hash(lock, name):
                bad = list.push(bad, name)
    bad

// The `hash` field of the `[[rune]]` entry named `name`, or "(absent)".
fn locked_hash(lock: String, name: String) -> String:
    var found = "(absent)"
    for block in toml.array_tables(lock, "rune"):
        if entry_name(block) == name:
            found = entry_hash(block)
    found

fn entry_name(block: String) -> String:
    match toml.get(block, "name"):
        Some(n) -> n
        None -> ""

fn entry_hash(block: String) -> String:
    match toml.get(block, "hash"):
        Some(h) -> h
        None -> "(no-hash)"

// --- gate: block any dependency that demands new authority -------------------
// The supply-chain gate (§10), rights-aware. It recomputes the footprint the
// dependency sources actually demand and blocks any capability the lockfile's
// recorded baseline doesn't already admit — the upgrade/tamper that quietly
// widens authority. Capabilities listed after <dir> are accepted (like
// `--allow-cap`), folding into the baseline so an intended widening passes.
fn cmd_gate(console: Console, root: Dir, args: List(String)) -> Int:
    let dir = arg(args, 1)
    if string.is_empty(dir):
        print(console, "usage: pm gate <dir> [allowed-cap..]")
        1
    else if !exists(root, join_path(dir, "witchy.lock")):
        print(console, "no witchy.lock — run `pm lock " + dir + "` first")
        1
    else:
        let manifest = read(root, join_path(dir, "witchy.toml"))
        let lock = read(root, join_path(dir, "witchy.lock"))
        let baseline = union_all(lock_baseline(lock), allowed_from(args, 2))
        let demanded = resolution_footprint(root, dir, manifest)
        report_gate(console, root, dir, manifest, rights.uncovered(baseline, demanded))

fn report_gate(console: Console, root: Dir, dir: String, manifest: String, widened: List(String)) -> Int:
    if list.length(widened) == 0:
        print(console, "OK: dependencies demand no authority beyond witchy.lock")
        0
    else:
        print(console, "BLOCK: dependencies demand new authority: " + string.join(widened, ", "))
        for cap in widened:
            print(console, "  " + cap + " <- " + string.join(gate_contributors(root, dir, manifest, cap), ", "))
        2

// The capabilities the lockfile already records (union of every [[rune]] entry's
// runtime_footprint) — the baseline the gate diffs a new resolution against.
fn lock_baseline(lock: String) -> List(String):
    var out = []
    for block in toml.array_tables(lock, "rune"):
        for cap in toml.get_array(block, "runtime_footprint"):
            out = add_unique(out, cap)
    out

// The aggregate authority the current dependency sources demand.
fn resolution_footprint(root: Dir, dir: String, manifest: String) -> List(String):
    var out = []
    for pair in toml.table(manifest, "dependencies"):
        let (name, inline) = pair
        if let Some(rel) = toml.inline_get(inline, "path"):
            for cap in rune_footprint(root, normalize_path(join_path(dir, rel))):
                out = add_unique(out, cap)
    out

// The dependencies whose own footprint covers `cap` — who introduced it.
fn gate_contributors(root: Dir, dir: String, manifest: String, cap: String) -> List(String):
    var who = []
    for pair in toml.table(manifest, "dependencies"):
        let (name, inline) = pair
        if let Some(rel) = toml.inline_get(inline, "path"):
            if rights.covered(rune_footprint(root, normalize_path(join_path(dir, rel))), cap):
                who = list.push(who, name)
    who

fn allowed_from(let args: List(String), start: Int) -> List(String):
    var out = []
    var i = 0
    for a in args:
        if i >= start:
            out = list.push(out, a)
        i = i + 1
    out

fn union_all(a: List(String), b: List(String)) -> List(String):
    var out = a
    for x in b:
        out = add_unique(out, x)
    out

fn add_unique(xs: List(String), x: String) -> List(String):
    if has(xs, x):
        xs
    else:
        list.push(xs, x)

// The canonical lockfile text for a rune: a `[[rune]]` block per dependency,
// pinning its resolved version, source, content hash, and runtime footprint.
fn generate_lock(root: Dir, dir: String) -> String:
    let manifest = read(root, join_path(dir, "witchy.toml"))
    var out = "# witchy.lock — generated by `pm lock`. Pins every dependency by content\n# hash. Regenerate with `pm lock`; verify with `pm verify`. Do not edit by hand.\n"
    for pair in toml.table(manifest, "dependencies"):
        let (name, inline) = pair
        out = out + lock_entry(root, dir, name, inline)
    out

fn lock_entry(root: Dir, dir: String, name: String, inline: String) -> String:
    match toml.inline_get(inline, "path"):
        Some(rel) -> path_entry(root, dir, name, rel)
        None -> "\n[[rune]]\nname = \"" + name + "\"\nsource = \"coven\"\n# unresolved: registry deps need coven (pm publish/fetch)\n"

fn path_entry(root: Dir, dir: String, name: String, rel: String) -> String:
    let dep_dir = normalize_path(join_path(dir, rel))
    let dep_manifest = read(root, join_path(dep_dir, "witchy.toml"))
    let version = field(dep_manifest, "rune.version")
    let hash = rune_hash(root, dep_dir)
    let fp = footprint_toml(rune_footprint(root, dep_dir))
    "\n[[rune]]\nname = \"" + name + "\"\nversion = \"" + version + "\"\nsource = \"path:" + rel + "\"\nhash = \"" + hash + "\"\nruntime_footprint = [" + fp + "]\n"

// The rune's content address: the canonical hash over `witchy.toml` plus every
// `src/**/*.witchy` (recursively), matching coven's store byte-for-byte (so a
// witchy-checked lock agrees with a coven-generated one).
fn rune_hash(root: Dir, dir: String) -> String:
    var files = [("witchy.toml", read(root, join_path(dir, "witchy.toml")))]
    for f in fs.collect_files(root, join_path(dir, "src"), "src", ".witchy"):
        files = list.push(files, f)
    content_hash(files)

fn footprint_toml(caps: List(String)) -> String:
    var parts = []
    for c in caps:
        parts = list.push(parts, "\"" + c + "\"")
    string.join(parts, ", ")

// Collapse `a/b/../c` to `a/c`, dropping `.` and empty segments — the confined
// Dir capability rejects `..`, so a relative dep path must be resolved first.
fn normalize_path(let p: String) -> String:
    var stack = []
    for seg in string.split(p, "/"):
        if seg == "..":
            stack = drop_last(stack)
        else if seg != "" && seg != ".":
            stack = list.push(stack, seg)
    string.join(stack, "/")

fn drop_last(xs: List(String)) -> List(String):
    var out = []
    let last = list.length(xs) - 1
    var i = 0
    for x in xs:
        if i < last:
            out = list.push(out, x)
        i = i + 1
    out

// --- add: resolve + fetch a rune (and its deps) from a coven registry --------
// Resolves a version requirement against the registry's released versions
// (std/semver), fetches the chosen version's source (verifying its signed
// record + content hash), materializes it, and then resolves the fetched rune's
// own version dependencies transitively. The vendored tree under <dest> doubles
// as the visited-set: a rune already carrying its coven.json is never re-fetched,
// which makes a diamond or a dependency cycle terminate. This command needs the
// network.
fn cmd_add(console: Console, net: Net, root: Dir, args: List(String)) -> Int:
    let name = arg(args, 1)
    let req = arg(args, 2)
    let addr = arg(args, 3)
    let dest = arg(args, 4)
    if string.is_empty(name) || string.is_empty(req) || string.is_empty(addr) || string.is_empty(dest):
        print(console, "usage: pm add <name> <req> <coven-host:port> <dest-dir>")
        1
    else:
        let (host, port) = hostport(addr)
        add_rune(console, net, root, host, port, name, req, dest)

// Resolve + fetch one rune and its transitive deps. Already-vendored runes (their
// coven.json is present) are skipped — the dedup + cycle break.
fn add_rune(console: Console, net: Net, root: Dir, host: String, port: Int, name: String, req: String, dest: String) -> Int:
    if exists(root, join_path(join_path(dest, basename(name)), "coven.json")):
        0
    else:
        let versions = http.get(net, host, port, "/coven/versions?name=" + wire(name))
        if http.status(versions) != 200:
            print(console, "registry error fetching versions for " + name)
            1
        else:
            match pick_version(http.body(versions), req):
                Ok(chosen) -> fetch_then_deps(console, net, root, host, port, name, chosen, dest)
                Err(e) ->
                    print(console, name + ": " + e)
                    1

// Fetch a resolved version, then recurse into the version deps its manifest
// declares. The exit code is the first failure (0 if the whole tree resolves).
fn fetch_then_deps(console: Console, net: Net, root: Dir, host: String, port: Int, name: String, version: String, dest: String) -> Int:
    let code = fetch_source(console, net, root, host, port, name, version, dest)
    if code != 0:
        code
    else:
        add_deps(console, net, root, host, port, name, dest)

fn add_deps(console: Console, net: Net, root: Dir, host: String, port: Int, name: String, dest: String) -> Int:
    let manifest = read(root, join_path(join_path(dest, basename(name)), "witchy.toml"))
    var code = 0
    for pair in toml.table(manifest, "dependencies"):
        let (depname, inline) = pair
        if let Some(depreq) = toml.inline_get(inline, "version"):
            let sub = add_rune(console, net, root, host, port, depname, depreq, dest)
            if sub != 0:
                code = sub
    code

// The highest released version satisfying `req`, or an explanatory error.
fn pick_version(body: String, req: String) -> Result(String, String):
    match semver.parse_req(req):
        Ok(r) -> choose(released_versions(body), r, req)
        Err(e) -> Err("bad requirement `" + req + "`: " + e)

fn choose(versions: List(Version), r: Req, req: String) -> Result(String, String):
    match semver.best(versions, r):
        Some(v) -> Ok(semver.format(v))
        None -> Err("no released version satisfies `" + req + "`")

// The released versions in a /coven/versions response, parsed.
fn released_versions(body: String) -> List(Version):
    var out = []
    if let Ok(doc) = json.decode(body):
        if let Some(records) = json.get(doc, "records"):
            if let Some(items) = json.as_array(records):
                for rec in items:
                    if jget(rec, "state") == "released":
                        if let Ok(v) = semver.parse(jget(rec, "version")):
                            out = list.push(out, v)
    out

// Fetch a version, verifying the full trust chain before writing anything: the
// registry's record must be validly signed by its root key, and the fetched
// source must hash to that signed hash. An untrusted mirror cannot swap the
// bytes — content addressing + the signature, not the transport, are trusted.
fn fetch_source(console: Console, net: Net, root: Dir, host: String, port: Int, name: String, version: String, dest: String) -> Int:
    let rootpub = http.body(http.get(net, host, port, "/coven/rootpub"))
    let record = http.get(net, host, port, "/coven/record?name=" + wire(name) + "&version=" + version)
    if http.status(record) != 200:
        print(console, "registry has no record for " + name + "@" + version)
        1
    else if !record_signature_valid(rootpub, http.body(record)):
        print(console, "BLOCK: registry record for " + name + "@" + version + " has an invalid signature — refusing to trust it")
        1
    else:
        fetch_verified(console, net, root, host, port, name, version, dest, http.body(record))

fn fetch_verified(console: Console, net: Net, root: Dir, host: String, port: Int, name: String, version: String, dest: String, record: String) -> Int:
    let resp = http.get(net, host, port, "/coven/source?name=" + wire(name) + "&version=" + version)
    if http.status(resp) != 200:
        print(console, "registry has no source for " + name + "@" + version)
        1
    else:
        let files = source_files(http.body(resp))
        if content_hash(files) != recorded_hash(record):
            print(console, "BLOCK: integrity failure — fetched source for " + name + "@" + version + " does not match the signed hash (tampered mirror?)")
            1
        else:
            let base = join_path(dest, basename(name))
            for f in files:
                let (path, text) = f
                let full = join_path(base, path)
                fs.ensure_dir(root, fs.parent_dir(full))
                write(root, full, text)
            // Keep the signed record next to the source, so the vendored rune
            // carries its own provenance and can be re-verified offline.
            write(root, join_path(base, "coven.json"), record)
            print(console, "added " + name + "@" + version + " -> " + base)
            0

fn source_files(body: String) -> List((String, String)):
    var out = []
    if let Ok(doc) = json.decode(body):
        if let Some(files) = json.get(doc, "files"):
            if let Some(items) = json.as_array(files):
                for entry in items:
                    out = list.push(out, (json_index_str(entry, 0), json_index_str(entry, 1)))
    out

// The content address of an in-memory rune source (matches coven / crypto.rune_hash).
fn content_hash(files: List((String, String))) -> String:
    var paths = []
    var texts = []
    for f in files:
        let (p, t) = f
        paths = list.push(paths, p)
        texts = list.push(texts, t)
    crypto.rune_hash(paths, texts)

fn recorded_hash(text: String) -> String:
    match json.decode(text):
        Ok(doc) -> jget(doc, "hash")
        Err(e) -> ""

// --- verify-rune: offline re-verification of a vendored rune -----------------
// A rune fetched by `add` carries its signed coven.json. Given the registry's
// root public key (TOFU-pinned), re-verify it with no network: the record must
// be validly signed, and the on-disk source must still hash to the signed hash.
fn cmd_verify_rune(console: Console, root: Dir, dir: String, rootpub: String) -> Int:
    if string.is_empty(dir) || string.is_empty(rootpub):
        print(console, "usage: pm verify-rune <vendored-rune-dir> <registry-root-pubkey-hex>")
        1
    else if !exists(root, join_path(dir, "coven.json")):
        print(console, "no coven.json in " + dir + " — not a rune fetched with provenance")
        1
    else:
        report_rune_verify(console, root, dir, rootpub, read(root, join_path(dir, "coven.json")))

// --- verify-vendor: re-verify a whole vendored tree offline ------------------
// Walk every rune under <dir> that carries a coven.json and re-verify it (the
// same signature + content check as verify-rune). A CI gate over an entire
// vendored dependency graph; exits 2 if any rune fails.
fn cmd_verify_vendor(console: Console, root: Dir, dir: String, rootpub: String) -> Int:
    if string.is_empty(dir) || string.is_empty(rootpub):
        print(console, "usage: pm verify-vendor <vendor-dir> <registry-root-pubkey-hex>")
        1
    else if !exists(root, dir):
        print(console, "no such directory: " + dir)
        1
    else:
        var total = 0
        var failed = 0
        for entry in list(subdir(root, dir)):
            let rune_dir = join_path(dir, entry)
            if exists(root, join_path(rune_dir, "coven.json")):
                total = total + 1
                if report_rune_verify(console, root, rune_dir, rootpub, read(root, join_path(rune_dir, "coven.json"))) != 0:
                    failed = failed + 1
        verdict_vendor(console, total, failed)

fn verdict_vendor(console: Console, total: Int, failed: Int) -> Int:
    if total == 0:
        print(console, "no vendored runes (no coven.json) found")
        1
    else if failed == 0:
        print(console, "OK: all ${total} vendored runes verified")
        0
    else:
        print(console, "BLOCK: ${failed} of ${total} vendored runes failed verification")
        2

fn report_rune_verify(console: Console, root: Dir, dir: String, rootpub: String, record: String) -> Int:
    if !record_signature_valid(rootpub, record):
        print(console, "BLOCK: " + dir + "/coven.json is not validly signed by that root key — refusing")
        2
    else if rune_hash(root, dir) != recorded_hash(record):
        print(console, "BLOCK: " + dir + " source no longer matches its signed hash (tampered)")
        2
    else:
        match json.decode(record):
            Ok(doc) -> print(console, "OK: " + jget(doc, "name") + "@" + jget(doc, "version") + " verified (signature + content), no network")
            Err(e) -> print(console, "OK: verified")

        0

// Verify a registry record is signed by the root key over its canonical payload
// (byte-identical to coven's Record signing payload).
fn record_signature_valid(rootpub: String, text: String) -> Bool:
    match json.decode(text):
        Ok(doc) -> crypto.ed25519_verify(rootpub, record_payload(doc), jget(doc, "sig"))
        Err(e) -> false

fn record_payload(doc: Json) -> String:
    "coven-v1\nname=" + jget(doc, "name") + "\nversion=" + jget(doc, "version") + "\nstate=" + jget(doc, "state") + "\nhash=" + jget(doc, "hash") + "\nrt=" + string.join(json.get_strings(doc, "runtime_footprint"), ",") + "\nbuild=\nuploaded_by=" + jget(doc, "uploaded_by") + "\npromoted_by=" + jget(doc, "promoted_by") + "\nfactor=" + jget(doc, "second_factor") + "\nprovenance=" + jget(doc, "provenance") + "\nreleased_at=" + "${jget_int(doc, "released_at")}"

fn jget_int(doc: Json, key: String) -> Int:
    match json.get(doc, key):
        Some(j) -> match json.as_int(j):
            Some(n) -> n
            None -> 0
        None -> 0

// --- registry/url helpers ----------------------------------------------------
fn hostport(addr: String) -> (String, Int):
    let (host, portstr) = string.split_once(addr, ":")
    (host, string.to_int(portstr))

// Rune names contain `/`; the wire encodes it as `~` for a query value.
fn wire(name: String) -> String:
    string.join(string.split(name, "/"), "~")

fn basename(name: String) -> String:
    if string.contains(name, "/"):
        let (_ns, base) = string.rsplit_once(name, "/")
        base
    else:
        name

fn jget(doc: Json, key: String) -> String:
    match json.get(doc, key):
        Some(j) -> match json.as_string(j):
            Some(s) -> s
            None -> ""
        None -> ""

fn json_index_str(j: Json, i: Int) -> String:
    match json.index(j, i):
        Some(v) -> match json.as_string(v):
            Some(s) -> s
            None -> ""
        None -> ""

// --- new: scaffold a rune ----------------------------------------------------
fn cmd_new(console: Console, root: Dir, name: String):
    if string.is_empty(name):
        print(console, "usage: pm new <name>")
    else:
        make_dir(root, name)
        make_dir(root, join_path(name, "src"))
        write(root, join_path(name, "witchy.toml"), manifest_stub(name))
        write(root, join_path(join_path(name, "src"), name + ".witchy"), src_stub(name))
        print(console, "created rune `" + name + "`:")
        print(console, "  " + join_path(name, "witchy.toml"))
        print(console, "  " + join_path(join_path(name, "src"), name + ".witchy"))

fn manifest_stub(let name: String) -> String:
    "[rune]\nname = \"" + name + "\"\nversion = \"0.1.0\"\n\n[capabilities]\nruntime = [\"Console\"]\n\n[dependencies]\n"

fn src_stub(let name: String) -> String:
    "fn main(console: Console):\n    print(console, \"hello from " + name + "\")\n"

// --- footprint helpers -------------------------------------------------------

// The capabilities the rune's source actually demands. The source is the first
// `.witchy` under <dir>/src — found by listing, so the file name need not match
// the rune name.
fn rune_footprint(root: Dir, dir: String) -> List(String):
    let src = subdir(root, join_path(dir, "src"))
    match first_witchy(list(src)):
        Some(file) -> footprint_total(compiler.footprint(read(src, file)))
        None -> []

fn first_witchy(let files: List(String)) -> Option(String):
    var found = None
    for f in files:
        if is_none(found) && string.ends_with(f, ".witchy"):
            found = Some(f)
    found

// Pull the "total" array out of a footprint JSON report.
fn footprint_total(let report: String) -> List(String):
    match json.decode(report):
        Ok(doc) -> json.get_strings(doc, "total")
        Err(e) -> []

fn declared_caps(let manifest: String) -> List(String):
    toml.get_array(manifest, "capabilities.runtime")

fn field(let manifest: String, path: String) -> String:
    match toml.get(manifest, path):
        Some(v) -> v
        None -> "(none)"

// --- compiler.diff JSON helpers ---------------------------------------------
fn widened(doc: Json) -> Bool:
    match json.get(doc, "widened"):
        Some(w) -> bool_or(w, false)
        None -> false

fn bool_or(j: Json, default: Bool) -> Bool:
    match json.as_bool(j):
        Some(b) -> b
        None -> default

fn added(doc: Json) -> String:
    string.join(json.get_strings(doc, "added"), ", ")

// --- small generic helpers ---------------------------------------------------
fn arg(let args: List(String), i: Int) -> String:
    if i < list.length(args):
        list.at(args, i)
    else:
        ""

fn has(let xs: List(String), x: String) -> Bool:
    var found = false
    for it in xs:
        if it == x:
            found = true
    found

fn join_path(let a: String, b: String) -> String:
    a + "/" + b

fn is_none(o: Option(String)) -> Bool:
    match o:
        Some(_) -> false
        None -> true

fn usage(console: Console):
    print(console, "pm — the witchy package manager")
    print(console, "usage: pm <command> [args]")
    print(console, "  info  <dir>         summarize a rune")
    print(console, "  audit <file>        footprint a source file demands")
    print(console, "  check <dir>         declared footprint must admit the code")
    print(console, "  guard <old> <new>   BLOCK if <new> widens authority")
    print(console, "  deps  <dir>         list a rune's dependencies")
    print(console, "  lock  <dir>         pin dependencies by content hash -> witchy.lock")
    print(console, "  verify <dir>        witchy.lock must match the dependency sources")
    print(console, "  gate  <dir> [cap..] BLOCK if deps demand authority beyond the lock")
    print(console, "  add <name> <req> <coven> <dest>  resolve + fetch a rune and its deps")
    print(console, "  verify-rune <dir> <rootpub>  re-verify a vendored rune offline (coven.json)")
    print(console, "  verify-vendor <dir> <rootpub>  re-verify every vendored rune offline")
    print(console, "  new   <name>        scaffold a new rune")

fn unknown(console: Console, cmd: String) -> Int:
    print(console, "unknown command: " + cmd)
    usage(console)
    1
