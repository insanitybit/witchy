// coven_artifact — the target-indexed artifact manifest a released application
// version commits to (RFC-0095). A manifest maps a canonical target triple to the
// publisher-built trusted-publisher for that host: its command name, the SHA-256 of the
// DECODED executable bytes, its size, and the trusted-publisher binding-plan digest plus
// rendered authority. Coven authenticates and freezes these; it does not build them.
// The rendered authority is audit information, NOT a claim that a native publisher
// is sandboxed from the user.

import crypto
import encoding
import bytes
import show
import error
import convert
from json import Json

// One target's artifact. `command` is a single portable filename component
// (validated: non-empty, no separators, no `.`/`..`). `sha256`/`size` describe the
// DECODED executable bytes — not any base64/JSON transport encoding.
type ArtifactEntry:
    kind: String
    command: String
    sha256: String
    size: Int
    binding_plan_sha256: String
    authority: List(String)

// A separately compiled library module. Both digests name decoded bytes: the
// Wasm body and the *external* RFC-0167 export-contract sidecar. The latter is
// deliberately not a Wasm custom section; its digest is committed by this
// manifest, whose digest is in turn signed by the release record. V3 adds the
// exact decoded lengths and an admitted kind, so a package client can bound a
// hostile mirror before it writes either blob to disk.
type LibraryEntry:
    kind: String
    wasm_sha256: String
    wasm_size: Int
    opt_callable_export_sha256: String
    opt_callable_export_size: Int

// Decoded-byte limits. The sidecar stays at the checker decoder's existing
// 1 MiB ceiling; changing that ceiling requires its own resource review.
let max_precompiled_wasm_bytes = 67108864

let max_precompiled_sidecar_bytes = 1048576

// The versioned manifest. Version 1 is the historical target -> application
// artifact map. Version 2 retained a digest-only library history. Version 3
// adds the admitted, bounded precompiled-library form keyed by logical module
// path (`src/foo`, without `.witchy`). V2 remains parseable for signed history
// but is deliberately not selectable for loading.
type ArtifactManifest:
    version: Int
    artifacts: List((String, ArtifactEntry))
    libraries: List((String, LibraryEntry))

// Matchable manifest faults. Malformed wire (JSON/shape) is kept distinct from a
// semantically-invalid target/command/digest.
type ArtifactError:
    ManifestJson(String)
    ManifestShape(String)
    BadCommand(String)
    BadTarget(String)
    BadModule(String)
    BadLibraryKind(String)
    BadSize(String)
    BadDigest(String)
    DuplicateLibrary(String)

pub fn artifact_error_message(e: ArtifactError) -> String:
    match e:
        ManifestJson(r) -> "artifact manifest is not valid JSON: " + r
        ManifestShape(r) -> "artifact manifest has the wrong shape: " + r
        BadCommand(c) -> "artifact command name `" + c + "` is not a single safe filename component"
        BadTarget(t) -> "artifact target `" + t + "` is not a valid target triple"
        BadModule(m) -> "library module `" + m + "` is not a valid logical module path"
        BadLibraryKind(k) -> "library kind `" + k + "` is not supported"
        BadSize(s) -> "artifact size `" + s + "` is outside its fixed signed limit"
        BadDigest(d) -> "artifact digest `" + d + "` is malformed (need 64 lowercase hex)"
        DuplicateLibrary(m) -> "artifact manifest repeats library module `" + m + "`"

impl Show for ArtifactError:
    fn show(self) -> String:
        artifact_error_message(self)

impl Error for ArtifactError

impl From(ArtifactError) for String:
    fn from(value: ArtifactError) -> Self:
        artifact_error_message(value)

// A command name must be a single portable filename component: non-empty, no path
// separators, and not `.`/`..`. This is what stops a manifest from writing outside
// the install Dir or supplying an untrusted platform suffix (RFC-0095).
pub fn valid_command(name: String) -> Bool:
    !name.is_empty() && !name.contains("/") && !name.contains("\\") && name != "." && name != ".." && !name.contains(" ")

// A conservative target-triple shape check: non-empty, `-`-separated, no path
// traversal or whitespace. The installer selects the host target ITSELF and never
// trusts a manifest to pick a foreign one, so this is a hygiene gate, not the
// authority for target selection.
pub fn valid_target(t: String) -> Bool:
    !t.is_empty() && t.contains("-") && !t.contains("/") && !t.contains("\\") && !t.contains(" ") && !t.contains("..")

// A module key is a logical source module identity, never a filesystem path:
// it begins with `src/`, contains no empty/current/parent segments, and omits
// the source extension. The resolver separately compares this spelling with
// the authenticated `ModuleLoadIdentity`; this shape check prevents ambiguous
// canonical manifest lines before that comparison.
pub fn valid_library_module(module: String) -> Bool:
    if !module.starts_with("src/") || module.ends_with(".witchy") || module.contains("\\") || module.contains("\n") || module.contains("\r") || module.contains("\t") || module.contains(" "):
        false
    else:
        var valid = true
        for segment in module.split("/"):
            if segment.is_empty() || segment == "." || segment == "..":
                valid = false
        valid

// One package ABI is admitted in this cut. A future ABI needs a new kind and
// verifier, rather than reusing this route for an arbitrary caller string.
pub fn valid_library_kind(kind: String) -> Bool:
    kind == "precompiled"

// A 64-char lowercase-hex digest (validated by decoding to exactly 32 bytes).
fn valid_digest(d: String) -> Bool:
    match encoding.hex_decode_bytes(d):
        Ok(b) -> bytes.length(b) == 32
        Err(_e) -> false

// Parse + validate a manifest's JSON. Every target/command/digest is checked; a
// malformed one is a typed error, never silently dropped.
pub fn parse(text: String) -> Result(ArtifactManifest, ArtifactError):
    match json.decode(text):
        Err(e) -> Err(ManifestJson(json.decode_error_message(e)))
        Ok(doc) ->
            let version = doc.get_int("version") ?? 0
            match doc.get("artifacts"):
                None -> Err(ManifestShape("missing `artifacts` object"))
                Some(arts) ->
                    match arts.as_object():
                        None -> Err(ManifestShape("`artifacts` is not an object"))
                        Some(entries) ->
                            match parse_entries(entries, []):
                                Err(e) -> Err(e)
                                Ok(artifacts) -> parse_libraries(doc, version, artifacts)

fn parse_entries(entries: List((String, Json)), acc: List((String, ArtifactEntry))) -> Result(List((String, ArtifactEntry)), ArtifactError):
    match entries:
        [] -> Ok(acc)
        [pair, ..rest] ->
            let (target, ev) = pair
            if !valid_target(target):
                Err(BadTarget(target))
            else:
                match parse_entry(ev):
                    Err(e) -> Err(e)
                    Ok(entry) -> parse_entries(rest, acc.concat([(target, entry)]))

fn parse_libraries(doc: Json, version: Int, artifacts: List((String, ArtifactEntry))) -> Result(ArtifactManifest, ArtifactError):
    if version == 1:
        if doc.contains_key("libraries"):
            Err(ManifestShape("v1 manifest must not contain `libraries`"))
        else:
            Ok(ArtifactManifest(version, artifacts, []))
    else if version != 2 && version != 3:
        Err(ManifestShape("unsupported artifact manifest version"))
    else:
        match doc.get("libraries"):
            None -> Err(ManifestShape("library manifest is missing `libraries`"))
            Some(libraries) ->
                match libraries.as_object():
                    None -> Err(ManifestShape("`libraries` is not an object"))
                    Some(entries) ->
                        match parse_library_entries(entries, version, []):
                            Err(error) -> Err(error)
                            Ok(parsed) -> Ok(ArtifactManifest(version, artifacts, parsed))

fn parse_library_entries(entries: List((String, Json)), version: Int, acc: List((String, LibraryEntry))) -> Result(List((String, LibraryEntry)), ArtifactError):
    match entries:
        [] -> Ok(acc)
        [pair, ..rest] ->
            let (module, value) = pair
            if !valid_library_module(module):
                Err(BadModule(module))
            else if acc.any(fn(entry: (String, LibraryEntry)): entry.0 == module):
                Err(DuplicateLibrary(module))
            else:
                match parse_library_entry(value, version):
                    Err(e) -> Err(e)
                    Ok(entry) -> parse_library_entries(rest, version, acc.concat([(module, entry)]))

fn parse_library_entry(value: Json, version: Int) -> Result(LibraryEntry, ArtifactError):
    let wasm = value.get_string("wasm_sha256") ?? ""
    let contract = value.get_string("opt_callable_export_sha256") ?? ""
    if !valid_digest(wasm):
        Err(BadDigest(wasm))
    else if !valid_digest(contract):
        Err(BadDigest(contract))
    else if version == 2:
        // Preserve v2's signed spelling, but do not admit it for precompiled
        // loading: it had no authenticated byte bounds or ABI kind.
        Ok(LibraryEntry("", wasm, 0, contract, 0))
    else:
        let kind = value.get_string("kind") ?? ""
        let wasm_size = value.get_int("wasm_size") ?? -1
        let sidecar_size = value.get_int("opt_callable_export_size") ?? -1
        if !valid_library_kind(kind):
            Err(BadLibraryKind(kind))
        else if wasm_size <= 0 || wasm_size > max_precompiled_wasm_bytes:
            Err(BadSize("wasm_size=${wasm_size}"))
        else if sidecar_size <= 0 || sidecar_size > max_precompiled_sidecar_bytes:
            Err(BadSize("opt_callable_export_size=${sidecar_size}"))
        else:
            Ok(LibraryEntry(kind, wasm, wasm_size, contract, sidecar_size))

fn parse_entry(ev: Json) -> Result(ArtifactEntry, ArtifactError):
    let command = ev.get_string("command") ?? ""
    let sha = ev.get_string("sha256") ?? ""
    if !valid_command(command):
        Err(BadCommand(command))
    else if !valid_digest(sha):
        Err(BadDigest(sha))
    else:
        Ok(ArtifactEntry(ev.get_string("kind") ?? "", command, sha, ev.get_int("size") ?? 0, ev.get_string("binding_plan_sha256") ?? "", ev.get_strings("authority")))

// The artifact for `target`, or None if the release has no artifact for that host.
pub fn select(manifest: ArtifactManifest, target: String) -> Option(ArtifactEntry):
    find_target(manifest.artifacts, target)

fn find_target(entries: List((String, ArtifactEntry)), target: String) -> Option(ArtifactEntry):
    match entries:
        [] -> None
        [pair, ..rest] -> if pair.0 == target: Some(pair.1) else: find_target(rest, target)

// Every target the manifest carries an artifact for, sorted (the "available
// targets" a missing-target error lists).
pub fn targets(manifest: ArtifactManifest) -> List(String):
    var names: List(String) = manifest.artifacts.map(fn(p: (String, ArtifactEntry)): p.0)
    list.sort(names)
    names

pub fn select_library(manifest: ArtifactManifest, module: String) -> Option(LibraryEntry):
    find_library(manifest.libraries, module)

// A package resolver may load only this fixed ABI, and only from a v3 manifest
// that signs both decoded byte bounds. V2 digest-only entries remain readable
// for history but cannot become precompiled dependencies.
pub fn select_precompiled_library(manifest: ArtifactManifest, module: String) -> Option(LibraryEntry):
    if manifest.version != 3:
        None
    else:
        match find_library(manifest.libraries, module):
            Some(entry) -> if entry.kind == "precompiled": Some(entry) else: None
            None -> None

fn find_library(entries: List((String, LibraryEntry)), module: String) -> Option(LibraryEntry):
    match entries:
        [] -> None
        [pair, ..rest] -> if pair.0 == module: Some(pair.1) else: find_library(rest, module)

pub fn library_modules(manifest: ArtifactManifest) -> List(String):
    var names: List(String) = manifest.libraries.map(fn(p: (String, LibraryEntry)): p.0)
    list.sort(names)
    names

// The canonical digest a release record commits to, binding the manifest into the
// signed payload (RFC-0095). An empty manifest yields "" — a source-only release,
// whose record signs the legacy payload byte-for-byte.
pub fn manifest_digest(manifest: ArtifactManifest) -> String:
    if list.length(manifest.artifacts) == 0 && list.length(manifest.libraries) == 0:
        ""
    else:
        "sha256:" + crypto.sha256(canonical(manifest))

// An order-stable serialization for hashing. Version 1 stays byte-identical to
// RFC-0095. Later versions prefix their two namespaces, so a target spelling
// can never collide with a module spelling in a signed digest.
fn canonical(manifest: ArtifactManifest) -> String:
    if manifest.version == 1:
        let lines = targets(manifest).map(fn(t: String): entry_line(t, find_target(manifest.artifacts, t)))
        "v1\n" + list.join(lines, "\n")
    else if manifest.version == 2:
        let target_lines = targets(manifest).map(fn(t: String): "target|" + entry_line(t, find_target(manifest.artifacts, t)))
        let library_lines = library_modules(manifest).map(fn(m: String): library_line(m, find_library(manifest.libraries, m)))
        "v2\n" + list.join(target_lines.concat(library_lines), "\n")
    else:
        let target_lines = targets(manifest).map(fn(t: String): "target|" + entry_line(t, find_target(manifest.artifacts, t)))
        let library_lines = library_modules(manifest).map(fn(m: String): "library|" + library_v3_line(m, find_library(manifest.libraries, m)))
        "v3\n" + list.join(target_lines.concat(library_lines), "\n")

fn entry_line(target: String, entry: Option(ArtifactEntry)) -> String:
    match entry:
        None -> target + "|"
        Some(e) -> target + "|" + e.command + "|" + e.sha256 + "|${e.size}|" + e.binding_plan_sha256

fn library_line(module: String, entry: Option(LibraryEntry)) -> String:
    match entry:
        None -> "library|" + module + "|"
        Some(e) -> "library|" + module + "|" + e.wasm_sha256 + "|" + e.opt_callable_export_sha256

fn library_v3_line(module: String, entry: Option(LibraryEntry)) -> String:
    match entry:
        None -> module + "|"
        Some(e) -> module + "|" + e.kind + "|" + e.wasm_sha256 + "|${e.wasm_size}|" + e.opt_callable_export_sha256 + "|${e.opt_callable_export_size}"
