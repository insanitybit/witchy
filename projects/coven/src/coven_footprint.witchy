// coven_footprint — server-side capability-footprint recomputation. The whole
// point of the registry's trust model: the capabilities a rune may exercise are
// computed HERE from its source via the compiler, never taken on faith from the
// uploaded manifest. `member`/`add_unique` are the small set helpers this needs.

import json
import compiler
import string

// The capabilities the uploaded source actually demands — the union over its
// `src/**/*.witchy` modules, computed via `compiler.footprint`.
pub fn computed_footprint(files: List((String, String))) -> List(String):
    var out = []
    for path, text in files:
        if is_src_module(path):
            for cap in footprint_total(compiler.footprint(text)):
                out = add_unique(out, cap)
    out

fn is_src_module(path: String) -> Bool:
    string.starts_with(path, "src/") && string.ends_with(path, ".witchy")

fn footprint_total(report: String) -> List(String):
    match json.decode(report):
        Ok(doc) -> json.get_strings(doc, "total")
        Err(_e) -> []

// Append `x` to `xs` only if absent (a small ordered set over strings).
pub fn add_unique(xs: List(String), x: String) -> List(String):
    if member(xs, x):
        xs
    else:
        list.push(xs, x)

pub fn member(xs: List(String), x: String) -> Bool:
    var found = false
    for it in xs:
        if it == x:
            found = true
    found
