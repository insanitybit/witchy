// coven_footprint — server-side capability-footprint recomputation. coven computes
// the capabilities a rune may exercise from its source via the compiler, never
// trusting the uploaded manifest; that recomputation is what the registry's trust
// model rests on. `member`/`add_unique` are the small set helpers this needs.

import json
import compiler
import string

// The capabilities the uploaded source actually demands — the union over its
// `src/**/*.witchy` modules, computed via `compiler.footprint`. A module whose footprint
// cannot be computed (the source does not compile, or the report does not parse) is a
// HARD failure: returning an empty footprint would let an uncomputable rune slip past the
// under-declaration gate (empty is trivially covered), so the publish is refused instead.
pub fn computed_footprint(files: List((String, String))) -> Result(List(String), String):
    var out = []
    for path, text in files:
        if is_src_module(path):
            let caps = footprint_total(compiler.footprint(text))?
            for cap in caps:
                out = add_unique(out, cap)
    Ok(out)

fn is_src_module(path: String) -> Bool:
    string.starts_with(path, "src/") && string.ends_with(path, ".witchy")

// The `total` array of a `compiler.footprint` report, or an Err if the report does not
// parse or is an `{"error":..}` report (the source did not compile). Never silently [].
fn footprint_total(report: String) -> Result(List(String), String):
    match json.decode(report):
        Err(_e) -> Err("the compiler footprint report did not parse")
        Ok(doc) ->
            match json.get(doc, "error"):
                Some(_e) -> Err("the rune source does not compile — its capability footprint is uncomputable")
                None -> Ok(json.get_strings(doc, "total"))

// Append `x` to `xs` only if absent (a small ordered set over strings).
pub fn add_unique(xs: List(String), x: String) -> List(String):
    if member(xs, x):
        xs
    else:
        list.push(xs, x)

pub fn member(xs: List(String), x: String) -> Bool:
    var found = false
    for it in xs:
        if it == x:
            found = true
    found

// The foreign-code COMPARTMENT renderer ids a rune embeds (RFC-0015), found by scanning
// its source modules for `compartment("<id>"` call sites. This is the registry-side audit
// of "what third-party code does this package run?" — the `Js` governance signal, kept
// HERE (in coven) rather than in the compiler so the compiler stays decoupled from the
// glamour framework. It is a REVIEW HINT: it reads literal renderer ids from the text, so
// it may over-report an id mentioned in a comment and cannot see a non-literal id. The
// actual isolation is the host's iframe sandbox, not this — the audit just makes the
// foreign code visible (a reviewer/the package page can flag it).
pub fn compartments_in(files: List((String, String))) -> List(String):
    var out = []
    for path, text in files:
        if is_src_module(path):
            for id in scan_compartments(text):
                out = add_unique(out, id)
    out

fn scan_compartments(s: String) -> List(String):
    let marker = "compartment(\""
    let i = string.index_of(s, marker) ?? -1
    if i < 0:
        []
    else:
        let after = string.drop(s, i + string.char_count(marker))
        let close = string.index_of(after, "\"") ?? -1
        if close < 0:
            []
        else:
            let id = string.substring(after, 0, close)
            list.push(scan_compartments(string.drop(after, close)), id)
