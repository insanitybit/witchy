// coven — the witchy package registry, written in witchy. A content-addressed,
// immutable, signed registry that recomputes every rune's capability footprint
// from source (server-side enforcement — uploaded metadata is never trusted) and
// enforces the two-phase publish lifecycle (publish stages; a second-factor
// promote releases). Records are signed with a payload byte-identical to the Rust
// registry's, so a record signed here verifies against the Rust client.
//
//   witchy --net 127.0.0.1:8787 --signing-key <seed> projects/coven/src/coven.witchy 127.0.0.1:8787
//
// This file is the HTTP server: the request lifecycle (publish/promote/yank) and
// the routes. The layers it sits on are their own modules:
//   coven_store     content addressing + the record/source store
//   coven_trust     trusted-publishing identity tokens + canonical claims
//   coven_record    the signed record type + its canonical signing payload
//   coven_validate  name/version validation     coven_footprint  footprint recompute
//   coven_json      JSON read/build conveniences for untrusted input

import server
import crypto
import secretstore
import fs
import toml
import string
import rights
import coven_validate
import coven_footprint
import coven_json
import coven_store
import coven_meta
import compiler
// --- error flow --------------------------------------------------------------
// A handler failure as an HTTP status + message. Handlers return
// `Result(Response, CovenError)` and use `?` to short-circuit; `guard` renders the
// error once at the boundary, so each handler reads as a straight-line success path.

// Render a failure as its HTTP response — the single boundary where a `CovenError`
// becomes a `Response` (a free function: witchy resolves methods on params and loop
// vars, not on a `match` binding like `e`).

// Adapt a fallible handler into the plain `fn(Request) -> Response` the router
// stores: an `Err` renders to its response, so handlers can use `?`.

// Guard a precondition: `require(cond, 400, "...")?` returns early with the error
// when `cond` is false, and is a no-op (the `?` discards the `true`) otherwise.

// The request's JSON body, or a 400 — so handlers `let doc = body(req)?`.

// --- server ------------------------------------------------------------------
// The registry's ambient context: the content store, the root signing key, the
// clock, and the trusted issuers. Bundling these lets the handlers read as
// `self.store` / `self.key` methods rather than threading four parameters.

// The host grants a `SecretStore`; the root signing key is its `signing` secret
// (`--signing-key <seed>` is sugar for `--secret-file signing=<path>`). Required —
// `require` fails loudly if it was not granted rather than handing back an Option.

// Trailing `issuer=pubkeyhex` args are trusted issuers (a JWKS stand-in). With
// at least one, publish/promote require a short-lived identity token (trusted
// publishing); with none, the registry is anonymous (local mode).

// Parse trailing `issuer=pubkeyhex` args (the first arg is the listen address).

// `iss=jwks:<json>` — a rotating-key issuer; the key is chosen per token `kid`.

// The routes + the publish/promote/yank lifecycle, as methods on the context. Each
// `route_*` returns the handler closure (capturing `self`); the work is in the
// `do_*`/`*_checked` methods, speaking to the store/trust/record layers.

// A browse-oriented index: every rune with its newest version, that version's
// state, and its recomputed runtime footprint — so a UI can show authority
// (witchy's headline) per rune in one request, without N record fetches.

// GET /coven/compartments: the foreign-code renderer ids this rune embeds — the `Js`
// audit (what third-party code it runs), scanned from the stored source. A review hint.

// POST /coven/publish : stage a new immutable version. Server-side enforcement —
// recompute the footprint from source, reject an under-declared manifest,
// content-address the bytes, land it STAGED. Re-publishing a version is refused.

// The publisher identity comes from a verified token (401) that satisfies the
// namespace's bound policy (403), never from a client-asserted field. The
// verified `claims` (None when anonymous) build the SLSA provenance attestation.

// Trusted (claims present): a SLSA provenance attestation bound to the verified
// identity + digest. Anonymous: the uploader/hash fallback.

// SEC-013: a free-form field with an embedded newline could inject a sibling
// `key=` line into the canonical signing payload — refuse rather than sign it.

// POST /coven/promote : second-factor release (separation of duties).
//
// SECURITY INVARIANT — promotion is an isolated HUMAN operation, by design.
// Publishing (POST /coven/publish) is a machine/CI action authorized by an OIDC
// identity token; it can only ever produce a `Staged` version — never a released,
// consumable one (`promote_checked` rejects any non-`Staged` state). Releasing a
// version is a SEPARATE step that requires (a) a human-presented second factor —
// a fresh, single-use WebAuthn 2FA assertion, NOT a replayable CI token — and
// (b) separation of duties: the promoter identity must differ from the publisher.
//
// The consequence is the whole point: a FULL CI compromise (stolen OIDC token,
// malicious workflow, supply-chain attack on the build) can publish a poisoned
// version, but it CANNOT promote it to a released package consumers resolve. That
// gate is a human at a distinct system with a passkey. Do not "streamline" promote
// to accept a CI token, drop the second factor, or relax separation of duties —
// each of those collapses the isolation boundary that contains a CI compromise.

// SEC-013: keep the canonical signing payload unambiguous (see publish_checked).

// `delta_build` is always empty (coven never has build footprints — `build=` is
// hard-empty); present for wire-shape parity with the Rust PromoteResp.

// POST /coven/yank : exclude from new resolutions (re-sign the same fields yanked).

// SEC-018: yank is a destructive maintainer action, so a trusted registry requires
// an existing maintainer of the namespace — not just any client.

// GET /coven/snapshot, /coven/timestamp : the TUF roles (regenerated on demand).

// Regenerate + re-sign the TUF snapshot + timestamp (rollback + freeze
// protection); the role construction + canonical signing lives in coven_meta.

// --- authorization: bind identity tokens to the namespace's trust state ------
// The authorized publisher (claims.sub) plus the verified claims (for the SLSA
// attestation). Anonymous (no trusted issuers): fall back to the client-asserted
// `uploaded_by`, no claims. Trusted: the token must verify (401) AND satisfy the
// namespace's policy (403); the first trusted publish binds it.

// SEC-022/BUG-419: a publish token is single-use. The `jti` is consumed BEFORE any
// namespace-policy binding, so a REPLAYED token can never bind (or rebind) namespace
// trust state — the replay is refused before it can mutate anything. (A fresh token
// spent on a policy-rejected publish is burned; that is the safe direction, and a
// legitimate publisher always publishes to its own bound namespace.)

// SEC-022: mark a token's `jti` consumed so it cannot publish twice (replay defense).
// The marker is keyed by sha256(jti) so an issuer-chosen id can never escape `_policy/`
// via path traversal. A token with no `jti` (a non-GitHub issuer, or a legacy token) is
// not single-use-checked — the namespace↔repo-org binding still gates it.

// SEC-012: bind only on a token that carries the CI identity claims. Binding with
// an empty repository/workflow_ref would later be satisfied by ANY token from the
// same issuer lacking those claims (""==""), letting an unrelated identity squat
// and publish to the namespace.

// SEC-023: the first publisher must own the namespace. A real CI `repository` is
// `org/repo`; require its org to equal the namespace, so `evilorg/fork` cannot
// land-grab `victim`. (A `/`-less repository — a non-GitHub issuer or a test —
// can't express an org, so it is not org-checked; an attacker can't forge the
// signed claim, and every GitHub Actions token is `org/repo`.)

// The authorized promoter. Trusted: the token must verify (401) and be a
// registered maintainer of the namespace (403). First promoter becomes a
// maintainer (TOFU); machines stage, humans release.

// SEC-018: yank requires an EXISTING maintainer of the namespace. Unlike promote it
// never bootstraps maintainership (you must not be able to become a maintainer by
// yanking). Anonymous mode (no trusted issuers) stays open for local registries.

// The stored record as a typed `Record` — 404 if absent, 500 if corrupt.

// GET /coven/source: the stored files, refusing to serve them if they no longer
// hash to the signed record (tamper detection).

// GET /coven/doc: Markdown API docs generated from the (hash-verified) stored source.
// `compiler.doc` only PARSES the source — it never runs it — so this is safe on
// untrusted published code; the output is witchy-rendered derived content.

// --- authorization helpers (CovenError-returning bridges over coven_trust) ----
// Verify a request's identity token, lifting a (401, reason) on failure.

// A trusted publish must match the namespace's first-bound policy on every field.

// SEC-012: a policy bound before the bind-time guard (empty repository/workflow_ref)
// must not be matchable by a claimless token via ""==""; refuse and require a rebind.

// --- response shaping --------------------------------------------------------
import reflect
from http import Request, Response
from json import Json
from coven_trust import Issuer
from coven_record import Record, State
from coven_proto import PublishRequest, PromoteRequest, YankRequest

type CovenError:
    status: Int
    message: String

fn fail_response(e: CovenError) -> Response:
    err_json(e.status, e.message)

fn guard(h: fn(Request) -> Result(Response, CovenError)) -> fn(Request) -> Response:
    fn(req: Request):
        match h(req):
            Ok(resp) -> resp
            Err(e) -> fail_response(e)

fn require(cond: Bool, status: Int, message: String) -> Result(Bool, CovenError):
    return Ok(true) if cond
    Err(CovenError(status, message))

fn body(req: Request) -> Result(Json, CovenError):
    match server.json_body(req):
        Ok(doc) -> Ok(doc)
        Err(e) -> Err(CovenError(400, "bad request body: " + e))

type Coven:
    store: Dir
    key: Secret
    clock: Clock
    issuers: List(Issuer)

fn main(console: Console, net: Net, root: Dir, secrets: SecretStore, clock: Clock, args: List(String)):
    serve(console, net, root, secrets.require("signing"), clock, args)

fn serve(console: Console, net: Net, root: Dir, key: Secret, clock: Clock, args: List(String)):
    let addr = if list.length(args) > 0: list.at(args, 0) else: "127.0.0.1:8787"
    let issuers = parse_issuers(args)
    fs.ensure_dir(root, "registry")
    let c = Coven(root.subtree("registry"), key, clock, issuers)
    let app = server.router()
        .get("/coven/rootpub", c.route_rootpub())
        .get("/coven/index", c.route_index())
        .get("/coven/catalog", c.route_catalog())
        .get("/coven/versions", c.route_versions())
        .get("/coven/record", c.route_record())
        .get("/coven/source", c.route_source())
        .get("/coven/doc", c.route_doc())
        .get("/coven/compartments", c.route_compartments())
        .get("/coven/snapshot", c.route_snapshot())
        .get("/coven/timestamp", c.route_timestamp())
        .post("/coven/publish", c.route_publish())
        .post("/coven/promote", c.route_promote())
        .post("/coven/yank", c.route_yank())
    console.print("coven serving at http://" + addr + "  (root key " + crypto.public_key(key) + "; " + "${list.length(issuers)}" + " trusted issuer(s))")

    server.serve(net, addr, app)

fn parse_issuers(args: List(String)) -> List(Issuer):
    var out = []
    for a in list.drop(args, 1):
        out = list.push(out, parse_issuer_arg(a))
    out

// Every trailing arg is meant to be a trusted-issuer spec. A malformed one (no `=`, or an
// unparseable JWKS) must FAIL LOUDLY rather than parse to nothing and silently start the
// registry with fewer — or zero — trusted issuers (which would quietly make it anonymous).
fn parse_issuer_arg(a: String) -> Issuer:
    if !string.contains(a, "="):
        fail("coven: malformed trusted-issuer argument `" + a + "` (expected `issuer=pubkeyhex` or `issuer=jwks:<json>`)")
    let (id, value) = string.split_once(a, "=")
    if string.starts_with(value, "jwks:"):
        let (_tag, jwks_json) = string.split_once(value, ":")
        match json.decode(jwks_json):
            Ok(jwks) -> Issuer(id, "", Some(jwks))
            Err(e) -> bad_issuer("coven: malformed JWKS for issuer `" + id + "`: " + json.decode_error_message(e))
    else:
        Issuer(id, value, None)

// `fail` aborts, so the trailing value is unreachable — it only gives this the `Issuer`
// type the caller needs where `fail` sits in an expression position.
fn bad_issuer(msg: String) -> Issuer:
    fail(msg)
    Issuer("", "", None)

impl Coven:
    fn route_rootpub(self) -> fn(Request) -> Response:
        fn(req: Request): server.text(200, crypto.public_key(self.key))

    fn route_index(self) -> fn(Request) -> Response:
        fn(req: Request): server.send(200, .{names: coven_store.all_names(self.store)})

    fn route_catalog(self) -> fn(Request) -> Response:
        fn(req: Request):
            var runes = []
            for name in coven_store.all_names(self.store):
                if let Some(r) = coven_store.latest_record(self.store, name):
                    runes = list.push(runes, .{name: name, version: r.version, state: r.state, runtime_footprint: r.runtime_footprint, uploaded_by: r.uploaded_by, released_at: r.released_at})
            server.send(200, .{runes: runes})

    fn route_versions(self) -> fn(Request) -> Response:
        fn(req: Request):
            let name = coven_validate.unwire(server.query_or(req, "name", ""))
            var recs: List(Json) = []
            for v in coven_store.versions_of(self.store, name):
                if let Some(r) = coven_store.read_record(self.store, name, v):
                    recs = list.push(recs, coven_json.or_null(r))
            server.send(200, .{records: recs})

    fn route_record(self) -> fn(Request) -> Response:
        guard(fn(req: Request) -> Result(Response, CovenError):
            let name = coven_validate.unwire(server.query_or(req, "name", ""))
            let version = server.query_or(req, "version", "")
            self.validate_ref(name, version)?
            match coven_store.read_record(self.store, name, version):
                Some(rec) -> Ok(server.json(200, rec))
                None -> Err(CovenError(404, name + "@" + version + " not found in registry"))
        )

    fn route_source(self) -> fn(Request) -> Response:
        guard(fn(req: Request) -> Result(Response, CovenError):
            let name = coven_validate.unwire(server.query_or(req, "name", ""))
            let version = server.query_or(req, "version", "")
            self.validate_ref(name, version)?
            require(coven_store.record_exists(self.store, name, version), 404, name + "@" + version + " not found")?
            self.source_response(name, version)
        )

    fn route_doc(self) -> fn(Request) -> Response:
        guard(fn(req: Request) -> Result(Response, CovenError):
            let name = coven_validate.unwire(server.query_or(req, "name", ""))
            let version = server.query_or(req, "version", "")
            self.validate_ref(name, version)?
            require(coven_store.record_exists(self.store, name, version), 404, name + "@" + version + " not found")?
            self.doc_response(name, version)
        )

    fn validate_ref(self, name: String, version: String) -> Result(Bool, CovenError):
        // BUG-019: reject a malformed name/version on the read routes too — every path is
        // built from a network-supplied name, so validate it at each entry, not only publish.
        require(coven_validate.valid_name(name), 400, "invalid rune name `" + name + "`")?
        require(coven_validate.valid_version(version), 400, "invalid version `" + version + "`")

    fn route_compartments(self) -> fn(Request) -> Response:
        guard(fn(req: Request) -> Result(Response, CovenError):
            let name = coven_validate.unwire(server.query_or(req, "name", ""))
            let version = server.query_or(req, "version", "")
            self.validate_ref(name, version)?
            require(coven_store.record_exists(self.store, name, version), 404, name + "@" + version + " not found")?
            let files = coven_store.read_source(self.store, name, version)
            Ok(server.send(200, .{compartments: coven_footprint.compartments_in(files)}))
        )

    fn route_publish(self) -> fn(Request) -> Response:
        guard(fn(req: Request) -> Result(Response, CovenError): self.do_publish(body(req)?))

    fn do_publish(self, doc: Json) -> Result(Response, CovenError):
        let req = coven_proto.publish_of(doc)
        let name = toml_field(req.manifest, "rune.name")
        let version = toml_field(req.manifest, "rune.version")
        require(coven_validate.valid_name(name), 400, "invalid rune name `" + name + "` (need lowercase `namespace/name`, no traversal)")?
        require(coven_validate.valid_version(version), 400, "invalid version `" + version + "`")?
        require(!coven_store.record_exists(self.store, name, version), 409, name + "@" + version + " already published — versions are immutable, bump the version")?
        let (uploaded_by, claims) = self.authorized_publisher(req, self.clock.now() / 1000, name)?
        self.publish_checked(req.manifest, name, version, uploaded_by, claims, req.files)

    fn publish_checked(self, manifest: String, name: String, version: String, uploaded_by: String, claims: Option(Json), files: List((String, String))) -> Result(Response, CovenError):
        // BUG-422: a footprint that cannot be computed (source does not compile / bad
        // report) is a hard 400, never a silently-empty footprint that trivially passes
        // the under-declaration gate.
        let computed = coven_footprint.computed_footprint(files).map_err(fn(e: String): CovenError(400, "coven could not compute the capability footprint from source: " + e))?
        let gap = rights.uncovered(toml.get_array(manifest, "capabilities.runtime"), computed)
        require(string.is_empty(list.join(gap, ", ")), 400, "declared [capabilities] does not cover what the source demands (" + list.join(gap, ", ") + ") — coven recomputes and will not publish an under-declared rune")?
        let hash = coven_store.content_hash(files)
        let provenance = match claims:
            Some(c) -> coven_trust.attestation(c, hash, self.clock.now() / 1000)
            None -> "uploader=" + uploaded_by + "|hash=" + hash

        require(coven_validate.single_line(uploaded_by) && coven_validate.single_line(provenance), 400, "record fields must not contain newlines")?
        // BUG-423: store the source only after EVERY validation has passed, so a rejected
        // publish never leaves poisoned source bytes on disk for this version.
        coven_store.store_source(self.store, name, version, files)
        let rec = coven_record.sign_record(self.key, name, version, Staged, hash, computed, uploaded_by, "", "", provenance, 0)
        coven_store.write_record(self.store, name, version, rec)
        self.rebuild_metadata()
        Ok(server.json(200, rec))

    fn route_promote(self) -> fn(Request) -> Response:
        guard(fn(req: Request) -> Result(Response, CovenError): self.do_promote(body(req)?))

    fn do_promote(self, doc: Json) -> Result(Response, CovenError):
        let req = coven_proto.promote_of(doc)
        require(coven_validate.valid_name(req.name), 400, "invalid rune name `" + req.name + "`")?
        require(coven_validate.valid_version(req.version), 400, "invalid version `" + req.version + "`")?
        require(coven_store.record_exists(self.store, req.name, req.version), 404, req.name + "@" + req.version + " not found")?
        require(!string.is_empty(req.second_factor), 400, "promotion requires a second factor (the out-of-band 2FA event) — refusing to release")?
        let (promoter, claims) = self.authorized_promoter(req, self.clock.now() / 1000)?
        require(!string.is_empty(promoter), 400, "promotion requires an authenticated promoter identity")?
        let resp = self.promote_checked(req.name, req.version, req.second_factor, promoter)?
        // BUG-281: bind the TOFU maintainer only now the promote has actually succeeded.
        if let Some(c) = claims:
            self.bind_maintainer(req.name, c)
        Ok(resp)

    fn promote_checked(self, name: String, version: String, factor: String, promoter: String) -> Result(Response, CovenError):
        let rec = self.load_record(name, version)?
        require(coven_record.state_of(rec.state) == Staged, 400, name + "@" + version + " is " + rec.state + "; only a staged version can be promoted")?
        require(promoter != rec.uploaded_by, 403, "separation of duties: the identity that published a version may not promote it")?
        require(coven_validate.single_line(promoter) && coven_validate.single_line(factor), 400, "record fields must not contain newlines")?
        let signed = coven_record.sign_record(self.key, name, version, Released, rec.hash, rec.runtime_footprint, rec.uploaded_by, promoter, factor, coven_record.str_or_empty(rec.provenance), self.clock.now() / 1000)
        coven_store.write_record(self.store, name, version, signed)
        self.rebuild_metadata()
        let delta = rights.uncovered(coven_store.latest_released_footprint(self.store, name, version), rec.runtime_footprint)
        let delta_build: List(String) = []
        Ok(server.send(200, .{record: coven_json.or_null(signed), separation_of_duties: true, delta_runtime: delta, delta_build: delta_build}))

    fn route_yank(self) -> fn(Request) -> Response:
        guard(fn(req: Request) -> Result(Response, CovenError): self.do_yank(body(req)?))

    fn do_yank(self, doc: Json) -> Result(Response, CovenError):
        let req = coven_proto.yank_of(doc)
        require(coven_validate.valid_name(req.name), 400, "invalid rune name `" + req.name + "`")?
        require(coven_validate.valid_version(req.version), 400, "invalid version `" + req.version + "`")?
        let rec = self.load_record(req.name, req.version)?
        let _yanker = self.authorized_yanker(req.name, req.id_token, self.clock.now() / 1000)?
        let signed = coven_record.sign_record(self.key, req.name, req.version, Yanked, rec.hash, rec.runtime_footprint, rec.uploaded_by, coven_record.str_or_empty(rec.promoted_by), coven_record.str_or_empty(rec.second_factor), coven_record.str_or_empty(rec.provenance), rec.released_at)
        coven_store.write_record(self.store, req.name, req.version, signed)
        self.rebuild_metadata()
        Ok(server.send(200, .{ok: true}))

    fn route_snapshot(self) -> fn(Request) -> Response:
        fn(req: Request):
            if !self.store.exists("snapshot.json"):
                self.rebuild_metadata()
            server.json(200, self.store.read("snapshot.json"))

    fn route_timestamp(self) -> fn(Request) -> Response:
        fn(req: Request):
            if !self.store.exists("timestamp.json"):
                self.rebuild_metadata()
            server.json(200, self.store.read("timestamp.json"))

    fn rebuild_metadata(self):
        coven_meta.rebuild(self.store, self.key, self.clock.now() / 1000)

    fn authorized_publisher(self, req: PublishRequest, now: Int, name: String) -> Result((String, Option(Json)), CovenError):
        if list.length(self.issuers) == 0:
            Ok((if req.uploaded_by.is_empty(): "anonymous" else: req.uploaded_by, None))
        else:
            let claims = verified_claims(self.issuers, req.id_token, now, "publishing to a trusted registry requires a short-lived identity token (long-lived API tokens are not accepted)")?
            // SEC/BUG-411: the publisher identity is the token's `sub`; an empty subject is
            // not an identity — refuse it (it would also collapse separation-of-duties, as
            // `promoter != "" == uploaded_by` could be trivially satisfied).
            require(!string.is_empty(coven_json.str(claims, "sub")), 403, "identity token carries no subject (`sub`) claim")?
            // SEC-022/BUG-419: the single-use replay check runs BEFORE any namespace-policy
            // binding, so a REPLAYED token can never bind (or rebind) namespace trust state —
            // the write only happens for a token that is fresh.
            let _used = self.consume_jti(claims)?
            let sub = self.authorize_publish(name, claims)?
            Ok((sub, Some(claims)))

    fn consume_jti(self, claims: Json) -> Result(String, CovenError):
        // SEC-022/BUG-400: a trusted-publishing token MUST carry a non-empty `jti` so it can be
        // single-use — a missing one is refused, never waved through unmarked (which would make
        // a jti-less token replayable). The marker is keyed by sha256(jti) so an issuer-chosen
        // id can never escape `_policy/` via path traversal.
        let jti = coven_trust.claim(claims, "jti")
        require(!string.is_empty(jti), 403, "identity token has no `jti` claim — a single-use token id is required (replay defense)")?
        let marker = "_policy/_jti/" + crypto.sha256(jti)
        require(!self.store.exists(marker), 403, "identity token already used — single-use replay refused")?
        fs.ensure_dir(self.store, "_policy/_jti")
        self.store.write(marker, "1")
        Ok(jti)

    fn authorize_publish(self, name: String, claims: Json) -> Result(String, CovenError):
        let ns = coven_trust.namespace_of(name)
        let pubfile = "_policy/" + ns + "/publisher.json"
        if !self.store.exists(pubfile):
            let repo = coven_trust.claim(claims, "repository")
            let wf = coven_trust.claim(claims, "workflow_ref")
            require(!string.is_empty(repo) && !string.is_empty(wf), 403, "cannot bind `" + ns + "`: the identity token carries no repository/workflow_ref claims (trusted publishing requires a CI identity)")?
            require(!string.contains(repo, "/") || ns == coven_trust.namespace_of(repo), 403, "namespace `" + ns + "` does not match the token's repository org `" + coven_trust.namespace_of(repo) + "`")?
            fs.ensure_dir(self.store, "_policy/" + ns)
            self.store.write(pubfile, json.encode(JsonObject([("issuer", JsonString(coven_json.str(claims, "iss"))), ("repository", JsonString(repo)), ("workflow_ref", JsonString(wf))])))
            Ok(coven_json.str(claims, "sub"))
        else:
            // BUG-379: a publisher.json that does not DECODE is corruption/tampering — a
            // distinct hard error (500), not the 403 "incomplete trust policy" that a
            // decoded-but-empty policy yields. Both fail closed; they are not the same fault.
            match json.decode(self.store.read(pubfile)):
                Err(e) -> Err(CovenError(500, "corrupt trust policy for namespace `" + ns + "` (" + json.decode_error_message(e) + "); it must be repaired or rebound out of band"))
                Ok(policy) -> enforce_publish_policy(policy, claims, ns)

    fn authorized_promoter(self, req: PromoteRequest, now: Int) -> Result((String, Option(Json)), CovenError):
        if list.length(self.issuers) == 0:
            Ok((req.promoted_by, None))
        else:
            let claims = verified_claims(self.issuers, req.id_token, now, "promoting on a trusted registry requires a short-lived identity token")?
            let sub = self.authorize_promote(req.name, claims)?
            Ok((sub, Some(claims)))

    fn authorize_promote(self, name: String, claims: Json) -> Result(String, CovenError):
        // Authorize a promoter WITHOUT binding maintainership: allow the first promoter of an
        // unclaimed namespace (TOFU) or an existing maintainer, and reject everyone else. The
        // TOFU bind is deferred to `bind_maintainer`, run only AFTER the promote succeeds —
        // BUG-281: a FAILED self-promote must not leave the caller a registered maintainer.
        let ns = coven_trust.namespace_of(name)
        let mfile = "_policy/" + ns + "/maintainers.json"
        let id = coven_json.str(claims, "iss") + "|" + coven_json.str(claims, "sub")
        if !self.store.exists(mfile):
            Ok(coven_json.str(claims, "sub"))
        else:
            let maintainers = self.maintainer_ids(ns, mfile)?
            if coven_footprint.member(maintainers, id):
                Ok(coven_json.str(claims, "sub"))
            else:
                Err(CovenError(403, "`" + coven_json.str(claims, "sub") + "` is not a maintainer of namespace `" + ns + "`"))

    fn bind_maintainer(self, name: String, claims: Json):
        // Commit the trust-on-first-use maintainer binding, only for an as-yet-unclaimed
        // namespace. Called AFTER a successful promote so a rejected one never binds authority.
        let ns = coven_trust.namespace_of(name)
        let mfile = "_policy/" + ns + "/maintainers.json"
        if !self.store.exists(mfile):
            let id = coven_json.str(claims, "iss") + "|" + coven_json.str(claims, "sub")
            fs.ensure_dir(self.store, "_policy/" + ns)
            self.store.write(mfile, json.encode(JsonArray([JsonString(id)])))

    fn authorized_yanker(self, name: String, id_token: Option(String), now: Int) -> Result(String, CovenError):
        if list.length(self.issuers) == 0:
            Ok("anonymous")
        else:
            let claims = verified_claims(self.issuers, id_token, now, "yanking on a trusted registry requires a short-lived identity token")?
            let ns = coven_trust.namespace_of(name)
            let mfile = "_policy/" + ns + "/maintainers.json"
            require(self.store.exists(mfile), 403, "namespace `" + ns + "` has no registered maintainers; nothing may be yanked")?
            let id = coven_json.str(claims, "iss") + "|" + coven_json.str(claims, "sub")
            let maintainers = self.maintainer_ids(ns, mfile)?
            require(coven_footprint.member(maintainers, id), 403, "`" + coven_json.str(claims, "sub") + "` is not a maintainer of namespace `" + ns + "`")?
            Ok(coven_json.str(claims, "sub"))

    fn maintainer_ids(self, ns: String, path: String) -> Result(List(String), CovenError):
        coven_trust.string_array(self.store.read(path)).map_err(fn(e: String): CovenError(500, "corrupt maintainer policy for namespace `" + ns + "` (" + e + "); it must be repaired or rebound out of band"))

    fn load_record(self, name: String, version: String) -> Result(Record, CovenError):
        match coven_store.read_record(self.store, name, version):
            None -> Err(CovenError(404, name + "@" + version + " not found"))
            Some(text) ->
                match coven_record.parse(text):
                    Ok(r) -> Ok(r)
                    Err(e) -> Err(CovenError(500, "corrupt record `" + name + "@" + version + "`: " + e))

    fn source_response(self, name: String, version: String) -> Result(Response, CovenError):
        let files = coven_store.read_source(self.store, name, version)
        let rec = self.load_record(name, version)?
        require(coven_store.content_hash(files) == rec.hash, 500, "integrity failure: source no longer matches the signed hash")?
        Ok(server.send(200, .{files: files}))

    fn doc_response(self, name: String, version: String) -> Result(Response, CovenError):
        let files = coven_store.read_source(self.store, name, version)
        let rec = self.load_record(name, version)?
        require(coven_store.content_hash(files) == rec.hash, 500, "integrity failure: source no longer matches the signed hash")?
        var md = ""
        for f in files:
            let (path, text) = f
            if string.ends_with(path, ".witchy"):
                md = md + compiler.doc(name, text) + "\n"
        Ok(server.send(200, .{markdown: md}))

fn verified_claims(issuers: List(Issuer), id_token: Option(String), now: Int, missing: String) -> Result(Json, CovenError):
    let token = id_token.ok_or(CovenError(401, missing))?
    coven_trust.verify_token(issuers, token, now).map_err(fn(e: String): CovenError(401, e))

fn enforce_publish_policy(policy: Json, claims: Json, ns: String) -> Result(String, CovenError):
    if string.is_empty(coven_json.str(policy, "repository")) || string.is_empty(coven_json.str(policy, "workflow_ref")):
        Err(CovenError(403, "namespace `" + ns + "` has an incomplete trust policy; rebind it from a CI identity"))
    else if coven_json.str(policy, "issuer") != coven_json.str(claims, "iss"):
        Err(CovenError(403, "namespace `" + ns + "` trusts issuer `" + coven_json.str(policy, "issuer") + "`, not `" + coven_json.str(claims, "iss") + "`"))
    else if coven_json.str(policy, "repository") != coven_trust.claim(claims, "repository"):
        Err(CovenError(403, "identity not authorized to publish to `" + ns + "`: repository `" + coven_trust.claim(claims, "repository") + "` does not match the bound `" + coven_json.str(policy, "repository") + "`"))
    else if coven_json.str(policy, "workflow_ref") != coven_trust.claim(claims, "workflow_ref"):
        Err(CovenError(403, "identity not authorized to publish to `" + ns + "`: workflow_ref does not match the bound policy"))
    else:
        Ok(coven_json.str(claims, "sub"))

fn err_json(code: Int, msg: String) -> Response:
    server.send(code, .{error: msg})

fn toml_field(manifest: String, path: String) -> String:
    toml.get(manifest, path).unwrap_or("")
