// coven_proto — the client<->server request envelopes, as types. The server reads
// `req.name` instead of fishing fields out of raw JSON, and the client builds the
// very shape the server parses, so the two never drift. This is coven's own
// (unsigned) wire protocol, so the readers are deliberately lenient: an absent or
// wrong-typed field on untrusted input reads as its empty value, never a hard error.

import json
import coven_json
import coven_validate
from json import Json

// A publish: the manifest, the full source tree, and the claimed identity — a
// trusted-publishing token when present (`id_token`), otherwise the client-asserted
// `uploaded_by` (honoured only by an anonymous registry).
type PublishRequest:
    manifest: String
    files: List((String, String))
    uploaded_by: String
    id_token: Option(String)

// A promote: the decoded rune name + version, the out-of-band second factor, and the
// promoter identity (token or asserted).
type PromoteRequest:
    name: String
    version: String
    second_factor: String
    promoted_by: String
    id_token: Option(String)

// A yank: name + version, plus the trusted-publishing token (SEC-018) — yank is a
// maintainer action, so a trusted registry requires the same identity token as promote.
type YankRequest:
    name: String
    version: String
    id_token: Option(String)

// --- server side: parse an untrusted request body into its envelope --------------
pub fn publish_of(doc: Json) -> PublishRequest:
    PublishRequest(coven_json.str(doc, "manifest_toml"), source_files(doc), coven_json.str(doc, "uploaded_by"), json.get_string(doc, "id_token"))

pub fn promote_of(doc: Json) -> PromoteRequest:
    PromoteRequest(coven_validate.unwire(coven_json.str(doc, "name")), coven_json.str(doc, "version"), coven_json.str(doc, "second_factor"), coven_json.str(doc, "promoted_by"), json.get_string(doc, "id_token"))

pub fn yank_of(doc: Json) -> YankRequest:
    YankRequest(coven_validate.unwire(coven_json.str(doc, "name")), coven_json.str(doc, "version"), json.get_string(doc, "id_token"))

// The wire source is {"source":{"files":[[path,text],...]}} (matches SourceDto).
fn source_files(doc: Json) -> List((String, String)):
    let files = json.get(doc, "source")
        .and_then(fn(src: Json): json.get(src, "files"))
        .and_then(fn(a: Json): json.as_array(a))
        .unwrap_or([])
    list.map(files, file_pair)

fn file_pair(it: Json) -> (String, String):
    (coven_json.index_str(it, 0), coven_json.index_str(it, 1))

// --- client side: build the exact body the server parses -------------------------
pub fn publish_body(manifest: String, files: List((String, String)), uploaded_by: String) -> String:
    json.encode(JsonObject([("manifest_toml", JsonString(manifest)), ("source", JsonObject([("files", JsonArray(file_jsons(files)))])), ("uploaded_by", JsonString(uploaded_by))]))

pub fn promote_body(name: String, version: String, factor: String, promoter: String) -> String:
    json.encode(JsonObject([("name", JsonString(name)), ("version", JsonString(version)), ("second_factor", JsonString(factor)), ("promoted_by", JsonString(promoter))]))

fn file_jsons(files: List((String, String))) -> List(Json):
    var out = []
    for path, text in files:
        out = list.push(out, JsonArray([JsonString(path), JsonString(text)]))
    out
