// coven_client — a self-hosted client that drives a coven registry over HTTP, to
// exercise the registry end-to-end: publish (stage), record, promote (release),
// separation-of-duties, server-side footprint enforcement (under-declaration is
// refused), and source fetch. It speaks the same JSON wire protocol as the Rust
// client. Run against a coven server:
//   witchy --net 127.0.0.1:8787 projects/coven/src/coven_client.witchy 127.0.0.1:8787

import http
import json
import crypto
import string
import coven_json
import coven_proto

fn main(console: Console, net: Net, clock: Clock, args: List(String)):
    let addr = if list.length(args) > 0: list.at(args, 0) else: "127.0.0.1:8787"
    let (host, port) = hostport(addr)

    let rp = http.get(net, host, port, "/coven/rootpub")
    print(console, "rootpub:" + "${http.status(rp)}")

    // publish acme/money@1.0.0 (a pure library — no capabilities)
    let pub1 = http.post(net, host, port, "/coven/publish", coven_proto.publish_body(money_toml(), money_files(), "ci-bot"))
    print(console, "publish:${http.status(pub1)} state=" + field(http.body(pub1), "state"))

    let rec = http.get(net, host, port, "/coven/record?name=acme~money&version=1.0.0")
    print(console, "record:${http.status(rec)} state=" + field(http.body(rec), "state"))

    // promote with a DISTINCT identity (separation of duties holds) -> released
    let prom = http.post(net, host, port, "/coven/promote", coven_proto.promote_body("acme~money", "1.0.0", "webauthn", "release-human"))
    print(console, "promote:${http.status(prom)} state=" + nested_state(http.body(prom)) + " sod=" + nested_bool(http.body(prom)))

    // publish v2, then attempt to promote it as the SAME identity that uploaded
    // it — separation of duties must refuse (403).
    let pub2 = http.post(net, host, port, "/coven/publish", coven_proto.publish_body(money_toml_v2(), money_files_v2(), "ci-bot"))
    print(console, "publish2:" + "${http.status(pub2)}")
    let sod = http.post(net, host, port, "/coven/promote", coven_proto.promote_body("acme~money", "2.0.0", "webauthn", "ci-bot"))
    print(console, "selfpromote:" + "${http.status(sod)}")

    // an under-declared rune: the code demands Net but the manifest declares
    // nothing — the server recomputes the footprint and refuses (400).
    let leak = http.post(net, host, port, "/coven/publish", coven_proto.publish_body(leak_toml(), leak_files(), "attacker"))
    print(console, "underdeclared:" + "${http.status(leak)}")

    let src = http.get(net, host, port, "/coven/source?name=acme~money&version=1.0.0")
    print(console, "source:" + "${http.status(src)}")

    let idx = http.get(net, host, port, "/coven/index")
    print(console, "index:${http.status(idx)} " + http.body(idx))

    // TUF roles: the snapshot pins every target (rollback protection) and the
    // timestamp points at it with an expiry (freeze protection). Verify the
    // snapshot's signature against the registry's published root key.
    let rootpub = http.body(http.get(net, host, port, "/coven/rootpub"))
    let snap = http.get(net, host, port, "/coven/snapshot")
    print(console, "snapshot:${http.status(snap)} verified=" + verify_signed_doc(http.body(snap), rootpub))
    let ts = http.get(net, host, port, "/coven/timestamp")
    print(console, "timestamp:${http.status(ts)} verified=" + verify_signed_doc(http.body(ts), rootpub) + " fresh=" + timestamp_fresh(http.body(ts), now(clock) / 1000))

// Freeze protection: a verified timestamp is only trustworthy while it is
// FRESH — replaying an old (validly signed) timestamp would let a mirror
// freeze a client on stale targets, so an expired one is refused.
fn timestamp_fresh(text: String, now_seconds: Int) -> String:
    match json.decode(text):
        Ok(doc) -> match json.get(doc, "signed"):
            Some(signed) ->
                match json.get_int(signed, "expires"):
                    Some(expires) -> if expires > now_seconds: "true" else: "false"
                    None -> "no-expiry"
            None -> "no-signed"
        Err(_e) -> "decode-err"

// Verify a signed TUF role: re-encode its `signed` payload canonically and check
// the ed25519 signature against the registry root key.
fn verify_signed_doc(text: String, rootpub: String) -> String:
    match json.decode(text):
        Ok(doc) -> match json.get(doc, "signed"):
            Some(signed) -> if crypto.ed25519_verify(rootpub, json.encode(signed), field(text, "sig")): "true" else: "false"
            None -> "no-signed"
        Err(_e) -> "decode-err"

// --- fixtures ----------------------------------------------------------------
fn money_toml() -> String:
    "[rune]\nname = \"acme/money\"\nversion = \"1.0.0\"\n"

fn money_files() -> List((String, String)):
    [("witchy.toml", money_toml()), ("src/money.witchy", "fn dollars(n: Int) -> Int:\n    n * 100\n")]

fn money_toml_v2() -> String:
    "[rune]\nname = \"acme/money\"\nversion = \"2.0.0\"\n"

fn money_files_v2() -> List((String, String)):
    [("witchy.toml", money_toml_v2()), ("src/money.witchy", "fn dollars(n: Int) -> Int:\n    n * 100\n")]

fn leak_toml() -> String:
    "[rune]\nname = \"acme/leak\"\nversion = \"1.0.0\"\n"

fn leak_files() -> List((String, String)):
    [("witchy.toml", leak_toml()), ("src/leak.witchy", "fn main(c: Console, net: Net):\n    let s = connect(net, \"example.com:80\")\n    print(c, \"x\")\n")]

// --- response parsing --------------------------------------------------------
fn hostport(addr: String) -> (String, Int):
    let (host, portstr) = string.split_once(addr, ":")
    (host, string.to_int(portstr))

fn field(text: String, key: String) -> String:
    match json.decode(text):
        Ok(doc) -> coven_json.str(doc, key)
        Err(_e) -> "?"

fn nested_state(text: String) -> String:
    match json.decode(text):
        Ok(doc) -> match json.get(doc, "record"):
            Some(rec) -> coven_json.str(rec, "state")
            None -> "?"
        Err(_e) -> "?"

fn nested_bool(text: String) -> String:
    match json.decode(text):
        Ok(doc) -> match json.get(doc, "separation_of_duties"):
            Some(b) -> match json.as_bool(b):
                Some(v) -> if v: "true" else: "false"
                None -> "?"
            None -> "?"
        Err(_e) -> "?"
