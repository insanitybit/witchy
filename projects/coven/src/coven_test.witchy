// coven_test — unit tests for coven's data-only logic. Run with `witchy test`.
// The server lifecycle (publish -> promote -> add, TUF, trusted publishing) is
// covered end-to-end by the Rust e2e suite; these lock the data-only pieces:
// name/version validation, and the derive(Json) round-trip the records rely on.

import testing
import coven_validate
import coven_proto
import coven_footprint
import coven_trust
import coven_artifact
import coven_typo
import reflect
import result
import option
from json import Json
from coven_record import State

// --- name + version validation -----------------------------------------------
fn test_valid_name_accepts_namespaced():
    testing.assert(coven_validate.valid_name("acme/json"), "namespace/name is valid")
    testing.assert(coven_validate.valid_name("std/http-client"), "hyphens allowed in the name")

fn test_valid_name_rejects_bad():
    testing.assert(!coven_validate.valid_name("acme"), "a bare name (no namespace) is rejected")
    testing.assert(!coven_validate.valid_name("../../etc"), "path traversal is rejected")
    testing.assert(!coven_validate.valid_name("acme/a/b"), "two slashes are rejected")
    testing.assert(!coven_validate.valid_name("/etc/passwd"), "a leading slash is rejected")

// BUG-019: the name charset is `[a-z0-9-]` per segment — reject uppercase and any
// URL-unsafe character rather than accepting them as before.
fn test_valid_name_rejects_unsafe_charset():
    testing.assert(!coven_validate.valid_name("Acme/money"), "uppercase in the namespace is rejected")
    testing.assert(!coven_validate.valid_name("acme/Money"), "uppercase in the name is rejected")
    testing.assert(!coven_validate.valid_name("acme/mo ney"), "a space is rejected")
    testing.assert(!coven_validate.valid_name("acme/mo_ney"), "an underscore is rejected")
    testing.assert(!coven_validate.valid_name("acme/mo.ney"), "a dot is rejected")
    testing.assert(!coven_validate.valid_name("acme/mon%65y"), "a percent-escape is rejected")
    testing.assert(coven_validate.valid_name("acme/money-2"), "lowercase, digits, and hyphen are accepted")

fn test_valid_version():
    testing.assert(coven_validate.valid_version("1.0.0"), "strict semver is valid")
    testing.assert(coven_validate.valid_version("0.1.0"), "a lone zero component is valid")
    testing.assert(!coven_validate.valid_version("1.0"), "two components are rejected")
    testing.assert(!coven_validate.valid_version("1.x.0"), "non-digits are rejected")

// BUG-248: a redundant leading zero (`01`) is not canonical semver — reject it.
fn test_valid_version_rejects_leading_zero():
    testing.assert(!coven_validate.valid_version("01.2.3"), "a leading-zero major is rejected")
    testing.assert(!coven_validate.valid_version("1.02.3"), "a leading-zero minor is rejected")
    testing.assert(!coven_validate.valid_version("1.2.03"), "a leading-zero patch is rejected")

fn test_unwire():
    testing.assert_eq(coven_validate.unwire("acme~json"), "acme/json")

// SEC-013: a record field must not embed the signing-payload line separator.
fn test_single_line():
    testing.assert(coven_validate.single_line("ci@github/acme/foo"), "a normal identity is single-line")
    testing.assert(coven_validate.single_line(""), "empty is single-line")
    testing.assert(!coven_validate.single_line("x\npromoted_by=admin"), "an embedded newline is rejected")

// --- State <-> wire round-trip (the publish lifecycle as a sum type) ----------
fn test_state_round_trips():
    testing.assert_eq(coven_record.state_wire(Staged), "staged")
    testing.assert_eq(coven_record.state_wire(Released), "released")
    testing.assert_eq(coven_record.state_wire(Yanked), "yanked")
    testing.assert(coven_record.state_of("released") == Released, "the wire string parses back to its variant")
    // BUG-224: an unrecognized state must NOT read as `Staged` (which is promotable) —
    // it maps to `Unknown`, so a corrupt state can never be promoted.
    testing.assert(coven_record.state_of("nonsense") == Unknown, "an unknown state maps to Unknown, not Staged")
    testing.assert(coven_record.state_of("staged") == Staged, "the staged wire string still parses to Staged")

// BUG-363: the signed footprint payload must commit to list element boundaries.
// Capability strings themselves may contain commas (`Net[Connect, Tcp]`), so a raw
// comma join would make `["A,B"]` and `["A", "B"]` indistinguishable.
fn test_runtime_footprint_payload_is_injective():
    let one = coven_record.signing_payload("acme/net", "1.0.0", "released", "sha256:x", ["Net[Connect, Tcp]"], "ci", "alice", "webauthn", "prov", 1, "")
    let split = coven_record.signing_payload("acme/net", "1.0.0", "released", "sha256:x", ["Net[Connect", " Tcp]"], "ci", "alice", "webauthn", "prov", 1, "")
    testing.assert(one != split, "different footprint list shapes must produce different signed payloads")
    testing.assert(one.contains("rt=[\"Net[Connect, Tcp]\"]"), "the runtime footprint is encoded as a JSON array")

// (RFC-0095) The signed payload is versioned by artifact-manifest presence: an
// empty digest is byte-identical coven-v1 (a source-only release, unchanged from
// before RFC-0095), and a non-empty digest is coven-v2 with a trailing
// `artifact=` line. The version token must be chosen by presence, never guessed.
fn test_signing_payload_versions_by_artifact_digest():
    let v1 = coven_record.signing_payload("acme/wrg", "1.0.0", "released", "sha256:h", ["Dir[Read]"], "ci", "alice", "webauthn", "prov", 7, "")
    testing.assert(v1.starts_with("coven-v1\n"), "an empty artifact digest signs coven-v1")
    testing.assert(!v1.contains("\nartifact="), "coven-v1 carries no artifact line")

    let dg = "sha256:416e71b2cf6ce3fb316381f0eec039aa5b586e931f925f4d1f0be1d2d5009b5d"
    let v2 = coven_record.signing_payload("acme/wrg", "1.0.0", "released", "sha256:h", ["Dir[Read]"], "ci", "alice", "webauthn", "prov", 7, dg)
    testing.assert(v2.starts_with("coven-v2\n"), "a present artifact digest signs coven-v2")
    testing.assert(v2.ends_with("\nartifact=" + dg), "coven-v2 appends the artifact digest as the final line")
    testing.assert(v1 != v2, "committing to an artifact changes the signed payload")

    // Backward compatibility: coven-v1 is the old body with only the version tag
    // swapped in — stripping the tag lines must leave identical bodies.
    testing.assert_eq(v1.replace("coven-v1\n", ""), v2.replace("coven-v2\n", "").replace("\nartifact=" + dg, ""))

fn test_record_parse_errors_are_typed():
    match coven_record.parse("{"):
        Ok(_r) -> testing.assert(false, "malformed record JSON must fail")
        Err(e) ->
            match e:
                coven_record.RecordJson(_reason) -> testing.assert(true, "malformed JSON is typed")
                _ -> testing.assert(false, "malformed JSON should be RecordJson")

    match coven_record.parse("{\"name\":\"acme/x\"}"):
        Ok(_r) -> testing.assert(false, "wrong-shaped record JSON must fail")
        Err(e) ->
            match e:
                coven_record.RecordShape(_reason) -> testing.assert(true, "wrong shape is typed")
                _ -> testing.assert(false, "wrong shape should be RecordShape")

// --- proto builders carry the identity token (BUG-225) -----------------------
// The client builders must emit `id_token` when a trusted-publishing token is present
// (the parsers already read it), and omit it for an anonymous registry.
fn test_publish_body_round_trips_id_token():
    let body = coven_proto.publish_body("[rune]\n", [], "ci-bot", Some("tok123"), None)
    match json.decode(body):
        Ok(doc) ->
            match coven_proto.publish_of(doc):
                Ok(req) -> match req.id_token:
                    Some(t) -> testing.assert_eq(t, "tok123")
                    None -> testing.assert(false, "id_token should round-trip as Some")
                Err(e) -> testing.assert(false, "publish_of failed: ${e}")
        Err(e) -> testing.assert(false, "decode failed: ${json.decode_error_message(e)}")

fn test_publish_body_omits_id_token_when_anonymous():
    let body = coven_proto.publish_body("[rune]\n", [], "ci-bot", None, None)
    testing.assert(!body.contains("id_token"), "an anonymous publish body omits id_token")

// (RFC-0095) The publish body carries the optional artifact manifest: emitted
// when present (an application release), omitted for a source-only rune.
fn test_publish_body_round_trips_artifact():
    let m = "{\"version\":1,\"artifacts\":{}}"
    let body = coven_proto.publish_body("[rune]\n", [], "ci-bot", None, Some(m))
    match json.decode(body):
        Ok(doc) ->
            match coven_proto.publish_of(doc):
                Ok(req) -> match req.artifact:
                    Some(a) -> testing.assert_eq(a, m)
                    None -> testing.assert(false, "artifact should round-trip as Some")
                Err(e) -> testing.assert(false, "publish_of failed: ${e}")
        Err(e) -> testing.assert(false, "decode failed: ${json.decode_error_message(e)}")

fn test_publish_body_omits_artifact_when_source_only():
    let body = coven_proto.publish_body("[rune]\n", [], "ci-bot", None, None)
    testing.assert(!body.contains("artifact"), "a source-only publish body omits the artifact field")

fn test_yank_body_carries_id_token():
    let body = coven_proto.yank_body("acme/x", "1.0.0", Some("ytok"))
    match json.decode(body):
        Ok(doc) ->
            match coven_proto.yank_of(doc):
                Ok(req) -> match req.id_token:
                    Some(t) -> testing.assert_eq(t, "ytok")
                    None -> testing.assert(false, "yank_body id_token should round-trip as Some")
                Err(e) -> testing.assert(false, "yank_of failed: ${e}")
        Err(e) -> testing.assert(false, "decode failed: ${json.decode_error_message(e)}")

fn unsigned_token(iss: String) -> String:
    "eyJhbGciOiJSUzI1NiJ9.${json_b64_payload(iss)}.sig"

fn json_b64_payload(iss: String) -> String:
    if iss == "rogue":
        "eyJpc3MiOiJyb2d1ZSJ9"
    else:
        "eyJpc3MiOiJnaGEifQ"

fn test_verify_token_errors_are_typed():
    match coven_trust.verify_token([], unsigned_token("rogue"), 0):
        Ok(_claims) -> testing.assert(false, "untrusted issuer must fail")
        Err(e) ->
            match e:
                coven_trust.TokenUntrustedIssuer(iss) -> testing.assert_eq(iss, "rogue")
                _ -> testing.assert(false, "untrusted issuer should be TokenUntrustedIssuer")

    let jwks_issuer = coven_trust.Issuer("gha", "", Some(JsonObject([])), None)
    match coven_trust.verify_token([jwks_issuer], unsigned_token("gha"), 0):
        Ok(_claims) -> testing.assert(false, "JWKS issuer without kid must fail")
        Err(e) ->
            match e:
                coven_trust.TokenMissingKid(id) -> testing.assert_eq(id, "gha")
                _ -> testing.assert(false, "missing kid should be TokenMissingKid")

    // RFC-0119: an Ed25519 issuer accepts ONLY EdDSA tokens. Dispatch is by the
    // configured key type, so an RS256-headed token (algorithm confusion) is
    // rejected on the EdDSA path (UnsupportedAlg -> TokenOidc), never verified with
    // the RSA path.
    let ed_issuer = coven_trust.Issuer("gha", "", None, Some("aa"))
    match coven_trust.verify_token([ed_issuer], unsigned_token("gha"), 0):
        Ok(_claims) -> testing.assert(false, "an Ed25519 issuer must reject an RS256-headed token")
        Err(e) ->
            match e:
                coven_trust.TokenOidc(_reason) -> testing.assert(true, "RS256 header rejected on the EdDSA path")
                _ -> testing.assert(false, "an EdDSA-pinned rejection should be TokenOidc")

// BUG-219: trusted promotion proof comes only from claims in the verified identity
// token. A client-provided request marker must never substitute for an IdP `amr`.
fn test_second_factor_method_accepts_verified_amr():
    match coven_trust.second_factor_method(JsonObject([("amr", JsonString("webauthn"))])):
        Some(method) -> testing.assert_eq(method, "webauthn")
        None -> testing.assert(false, "a verified WebAuthn amr should be accepted")

    let array_claims = JsonObject([("amr", JsonArray([JsonString("pwd"), JsonString("mfa")]))])
    match coven_trust.second_factor_method(array_claims):
        Some(method) -> testing.assert_eq(method, "mfa")
        None -> testing.assert(false, "an accepted method in an amr array should be accepted")

fn test_second_factor_method_rejects_client_marker():
    let claims = JsonObject([("amr", JsonString("pwd")), ("second_factor", JsonString("webauthn"))])

    testing.assert(option.is_none(coven_trust.second_factor_method(claims)), "a request marker is not verified authentication proof")

// BUG-219: the original hole — an empty-string second factor (or missing `amr`)
// passed the old string-marker check. Verify both reject with the new claims-based gate.
fn test_second_factor_method_rejects_empty_string_and_missing_amr():
    // Empty-string amr claim: not a valid MFA attestation.
    let empty_amr = JsonObject([("amr", JsonString(""))])
    testing.assert(option.is_none(coven_trust.second_factor_method(empty_amr)), "an empty-string amr must not be accepted as MFA proof")

    // No amr claim at all: the most common attack vector from BUG-219.
    let no_amr = JsonObject([("sub", JsonString("attacker")), ("iss", JsonString("https://idp.example"))])
    testing.assert(option.is_none(coven_trust.second_factor_method(no_amr)), "a token with no amr claim must not be accepted as MFA proof")

    // amr array containing only non-MFA methods: must still reject.
    let weak_amr = JsonObject([("amr", JsonArray([JsonString("pwd"), JsonString("sms")]))])
    testing.assert(option.is_none(coven_trust.second_factor_method(weak_amr)), "an amr array without mfa or webauthn must not be accepted")

// --- footprint recompute fails closed (BUG-422) ------------------------------
// A source whose footprint cannot be computed (it does not compile) must be a hard
// error, never a silently-empty footprint that trivially passes the under-declaration
// gate. A valid library with no root capability demand computes an empty footprint.
fn test_computed_footprint_fails_closed_on_bad_source():
    match coven_footprint.computed_footprint([("src/x.witchy", "fn broken( ->")]):
        Ok(_caps) -> testing.assert(false, "a non-compiling source must not yield a footprint")
        Err(e) ->
            match e:
                coven_footprint.FootprintSourceDoesNotCompile(_detail) -> testing.assert(true, "an uncomputable footprint is a typed hard error")
                _ -> testing.assert(false, "a non-compiling source should be FootprintSourceDoesNotCompile")

fn test_computed_footprint_ok_for_empty_footprint_source():
    match coven_footprint.computed_footprint([("src/x.witchy", "pub fn f(n: Int) -> Int:\n    n\n")]):
        Ok(caps) -> testing.assert(caps.length() == 0, "the library should have an empty footprint")
        Err(e) -> testing.assert(false, "a valid empty-footprint source should compute: ${coven_footprint.footprint_error_message(e)}")

// --- encode (reflection) + derive(Deserialize) round-trip ------
type Sample derive(Reflect, Deserialize):
    name: String
    versions: List(String)
    note: Option(String)
    count: Int

fn test_json_roundtrip():
    let s = Sample("acme/json", ["1.0.0", "1.1.0"], Some("hi"), 2)
    match Sample.from_json(json.from_value(s)):
        Ok(b) ->
            testing.assert_eq(b.name, "acme/json")
            testing.assert_int_eq(b.count, 2)
            testing.assert_int_eq(b.versions.length(), 2)
            testing.assert(option.is_some(b.note), "the optional note round-trips as Some")
        Err(e) -> testing.assert(false, "round-trip failed: ${e}")

fn test_json_missing_field_errors():
    match Sample.from_json(JsonObject([("name", JsonString("x"))])):
        Ok(_b) -> testing.assert(false, "decode should fail when a required field is absent")
        Err(_e) -> testing.assert(true, "missing field is a loud Err")

fn test_json_null_optional_is_none():
    let s = Sample("a/b", [], None, 0)
    match Sample.from_json(json.from_value(s)):
        Ok(b) -> testing.assert(option.is_none(b.note), "an absent optional decodes to None")
        Err(e) -> testing.assert(false, "round-trip failed: ${e}")

// RFC-0095: the artifact manifest a released application version commits to.
fn artifact_hex64() -> String:
    "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn test_artifact_manifest_parses_and_selects():
    let h = artifact_hex64()
    let good = "{\"version\":1,\"artifacts\":{\"aarch64-apple-darwin\":{\"kind\":\"witchy-trusted-exe-v1\",\"command\":\"wrg\",\"sha256\":\"" + h + "\",\"size\":12345,\"binding_plan_sha256\":\"" + h + "\",\"authority\":[\"root: cwd Dir[Read]\"]}}}"
    match coven_artifact.parse(good):
        Err(e) -> testing.assert(false, "valid manifest must parse: ${coven_artifact.artifact_error_message(e)}")
        Ok(m) ->
            testing.assert_eq(list.join(coven_artifact.targets(m), ","), "aarch64-apple-darwin")
            match coven_artifact.select(m, "aarch64-apple-darwin"):
                Some(entry) -> testing.assert_eq(entry.command, "wrg")
                None -> testing.assert(false, "the selected target's artifact must be present")

            testing.assert(!coven_artifact.manifest_digest(m).is_empty(), "a non-empty manifest has a digest")

fn test_artifact_manifest_rejects_unsafe_command():
    let h = artifact_hex64()
    let bad = "{\"version\":1,\"artifacts\":{\"x86_64-unknown-linux-gnu\":{\"command\":\"../evil\",\"sha256\":\"" + h + "\",\"size\":1,\"binding_plan_sha256\":\"" + h + "\"}}}"
    match coven_artifact.parse(bad):
        Ok(_m) -> testing.assert(false, "a `..`-traversal command must be refused")
        Err(e) ->
            match e:
                coven_artifact.BadCommand(_c) -> testing.assert(true, "unsafe command refused")
                _ -> testing.assert(false, "wrong error for an unsafe command")

fn test_artifact_manifest_rejects_bad_digest():
    let h = artifact_hex64()
    let bad = "{\"version\":1,\"artifacts\":{\"x86_64-unknown-linux-gnu\":{\"command\":\"wrg\",\"sha256\":\"deadbeef\",\"size\":1,\"binding_plan_sha256\":\"" + h + "\"}}}"
    match coven_artifact.parse(bad):
        Ok(_m) -> testing.assert(false, "a malformed sha256 must be refused")
        Err(e) ->
            match e:
                coven_artifact.BadDigest(_d) -> testing.assert(true, "malformed digest refused")
                _ -> testing.assert(false, "wrong error for a malformed digest")

// (RFC-0095 typosquat) The name-distance metric catches the confusable edits a
// typosquat relies on: adjacent transposition, a dropped/added letter, an
// adjacent-key substitution — each edit-distance 1 from a real name.
fn test_typo_distance_catches_confusable_names():
    testing.assert_int_eq(coven_typo.distance("requests", "requests"), 0)
    testing.assert_int_eq(coven_typo.distance("requests", "reqeusts"), 1)
    testing.assert_int_eq(coven_typo.distance("acme/requests", "acme/request"), 1)
    testing.assert_int_eq(coven_typo.distance("acme/color", "acme/colour"), 1)
    testing.assert_int_eq(coven_typo.distance("kitten", "sitting"), 3)
    testing.assert_int_eq(coven_typo.distance("", "abc"), 3)

fn test_typo_nearest_reports_the_closest_existing_name():
    let existing = ["acme/requests", "acme/json", "other/http"]
    let (near, dist) = coven_typo.nearest("acme/reqeusts", existing)
    testing.assert_eq(near, "acme/requests")
    testing.assert_int_eq(dist, 1)
    let (_n2, d2) = coven_typo.nearest("wholly/different", existing)
    testing.assert(d2 > 2, "a clearly distinct name is far from every existing one")
    let (_n3, d3) = coven_typo.nearest("first/ever", [])
    testing.assert(d3 > 2, "with no existing names, a first package is never too close")

// Namespace scoping: a shared tool name across DIFFERENT namespaces is not a squat.
fn test_typo_is_namespace_scoped():
    let existing = ["a/util", "acme/requests"]
    testing.assert_int_eq(list.length(coven_typo.same_namespace("b/util", existing)), 0)
    let scoped = coven_typo.same_namespace("acme/reqeusts", existing)
    testing.assert_int_eq(list.length(scoped), 1)
    testing.assert_eq(list.at(scoped, 0), "acme/requests")
