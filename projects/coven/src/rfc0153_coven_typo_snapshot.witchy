// RFC-0153 measurement driver for Coven's production typosquat-distance path.
// Input construction is outside the clock; the timed loop invokes only the
// existing `coven_typo.distance` consumer used by the publish gate.

import coven_typo

fn main(let console: Console, let clock: Clock):
    let left = "pkg-0123456789abcdefghijklmnopqrstuvwxyz-pkg-0123456789abcdefghijklmnopqrstuvwxyz-pkg-0123456789abcdefghijklmnopqrstuvwxyz"
    let right = "pkg-0123456789abcedfghijklmnopqrstuvwxyz-pkg-0123456789abcedfghijklmnopqrstuvwxyz-pkg-0123456789abcedfghijklmnopqrstuvwxyz"
    let bench_t0 = clock.now_monotonic()
    var total = 0
    for _ in 0..1:
        total = total + coven_typo.distance(left, right)
    let bench_t1 = clock.now_monotonic()

    console.print("${total}")
    console.print("bench_ns=${bench_t1 - bench_t0}")
