// coven's content-addressed store: the on-disk layout plus record/source IO,
// behind a high-level API so the server speaks in records and versions, never raw
// paths. Layout under the store root:
//   <namespace>/<name>/<version>/{coven.json, rune/<files>}
// with the signed TUF metadata (*.json) and `_policy` trust state at the root.

import crypto
import fs
import semver
import vm
from json import Json
from coven_record import Record, State

// --- record IO ---------------------------------------------------------------
fn meta_path(name: String, version: String) -> String:
    "${name}/${version}/coven.json"

// Whether a version's signed record exists.
pub fn record_exists(store: Dir, name: String, version: String) -> Bool:
    store.exists(meta_path(name, version))

// A version's stored record JSON, or None if absent.
pub fn read_record(store: Dir, name: String, version: String) -> Option(String):
    if store.exists(meta_path(name, version)):
        Some(store.read(meta_path(name, version)))
    else:
        None

// Atomically claim a version coordinate before writing its source (SEC-049/
// RFC-0118). Exclusive-creates `coven.json` as an empty placeholder: exactly one
// concurrent first-publish wins (`true`); the loser (`false`) gets the same 409 as
// a sequential re-publish. The winner then writes source and finalizes the record
// with `write_record` (an atomic replace). A placeholder is unparseable, so a
// concurrent reader or snapshot treats a mid-publish coordinate as absent, never
// torn — and a crashed publish self-heals (the empty record re-publishes).
pub fn claim_record(store: Dir, name: String, version: String) -> Bool:
    fs.ensure_dir(store, "${name}/${version}")
    store.create_new(meta_path(name, version), "")

// Atomically write (or replace) a version's record JSON — a concurrent reader sees
// the whole old record or the whole new one, never a torn write (RFC-0118).
pub fn write_record(store: Dir, name: String, version: String, record: String):
    store.replace(meta_path(name, version), record)

// A version's record decoded to a typed `Record`, or None if absent or corrupt.
pub fn read_record_typed(store: Dir, name: String, version: String) -> Option(Record):
    match read_record(store, name, version):
        Some(text) ->
            match coven_record.parse(text):
                Ok(r) -> Some(r)
                Err(_e) -> None
        None -> None

// --- source IO + content addressing ------------------------------------------
fn rune_path(name: String, version: String, rel: String) -> String:
    "${name}/${version}/rune/${rel}"

// Write every source file under <name>/<version>/rune/, creating dirs as needed.
pub fn store_source(store: Dir, name: String, version: String, files: List((String, String))):
    for rel, text in files:
        let full = rune_path(name, version, rel)
        fs.ensure_dir(store, fs.parent_dir(full) ?? "")
        store.write(full, text)

// Read the stored source back as (relpath, text) pairs: witchy.toml + every
// src/**/*.witchy (recursively, so a nested module keeps its full path).
pub fn read_source(store: Dir, name: String, version: String) -> List((String, String)):
    var out = []
    let base = "${name}/${version}/rune"
    if store.exists("${base}/witchy.toml"):
        out.push(("witchy.toml", store.read("${base}/witchy.toml")))
    for f in fs.collect_files(store, "${base}/src", "src", ".witchy"):
        out.push(f)
    out

// The content address of a rune's source (matches crypto.rune_hash / pm/store.rs).
pub fn content_hash(files: List((String, String))) -> String:
    let paths = files.map(fn(file: (String, String)): file.0)
    let texts = files.map(fn(file: (String, String)): file.1)
    crypto.rune_hash(paths, texts)

// --- artifact IO (RFC-0095) --------------------------------------------------
// An application release commits to a target-indexed artifact manifest
// (coven_artifact). It lives beside the record and is written once, by the same
// single-writer publish that already claimed the version coordinate, so the
// version's immutability covers it — a re-publish is refused before this runs.
fn artifact_manifest_path(name: String, version: String) -> String:
    "${name}/${version}/artifact.json"

// Whether a version carries an artifact manifest (i.e. is an application release
// rather than source-only).
pub fn artifact_manifest_exists(store: Dir, name: String, version: String) -> Bool:
    store.exists(artifact_manifest_path(name, version))

// Store a version's artifact manifest JSON (atomic replace, like write_record).
pub fn store_artifact_manifest(store: Dir, name: String, version: String, manifest: String):
    fs.ensure_dir(store, "${name}/${version}")
    store.replace(artifact_manifest_path(name, version), manifest)

// A version's artifact manifest JSON, or None for a source-only release.
pub fn read_artifact_manifest(store: Dir, name: String, version: String) -> Option(String):
    if store.exists(artifact_manifest_path(name, version)):
        Some(store.read(artifact_manifest_path(name, version)))
    else:
        None

// The raw trusted-exe bytes for one target, keyed by the (validated) target
// triple. `target` MUST already be checked with coven_artifact.valid_target — it
// becomes a path component, so an unvalidated one could escape the store subtree.
fn artifact_bytes_path(name: String, version: String, target: String) -> String:
    "${name}/${version}/artifacts/${target}"

// Whether this target's artifact bytes have already been uploaded (write-once).
pub fn artifact_bytes_exists(store: Dir, name: String, version: String, target: String) -> Bool:
    store.exists(artifact_bytes_path(name, version, target))

// Store one target's decoded trusted-exe bytes. Integrity is anchored elsewhere:
// the signed record commits to the manifest digest, and the manifest commits to
// each artifact's sha256, so a swapped byte blob is caught at install time.
pub fn store_artifact_bytes(store: Dir, name: String, version: String, target: String, data: Bytes):
    fs.ensure_dir(store, "${name}/${version}/artifacts")
    store.write_bytes(artifact_bytes_path(name, version, target), data)

// One target's stored artifact bytes, or None if not uploaded.
pub fn read_artifact_bytes(store: Dir, name: String, version: String, target: String) -> Option(Bytes):
    if store.exists(artifact_bytes_path(name, version, target)):
        Some(store.read_bytes(artifact_bytes_path(name, version, target)))
    else:
        None

// --- walking -----------------------------------------------------------------
// Every published version of a rune.
pub fn versions_of(store: Dir, name: String) -> List(String):
    if store.exists(name):
        store.subtree(name).list()
    else:
        []

// Every published rune name (namespace/name) — the store is two levels deep; skip
// the TUF metadata (*.json) and `_policy` trust state that sit at the root.
pub fn all_names(store: Dir) -> List(String):
    var out = []
    for ns in store.list():
        if !ns.ends_with(".json") && !ns.starts_with("_"):
            for nm in store.subtree(ns).list():
                out.push("${ns}/${nm}")
    out

// The content digest of one signed-record payload. Pure (no capability), so the
// snapshot's hashing fans out across cores via `vm.par_map`.
fn hash_payload(payload: String) -> String:
    "sha256:${crypto.sha256(payload)}"

// Every current target as (name@version -> digest of its signed payload). The
// snapshot sorts these keys to match the Rust BTreeMap's canonical ordering. Reading
// the records is sequential I/O (it needs the `store` Dir), but the SHA-256 of each
// payload is pure CPU, so we collect the payloads first and hash them in PARALLEL
// across worker VMs — the snapshot of a large registry hashes on every core.
pub fn all_target_digests(store: Dir) -> List((String, Json)):
    var keys = []
    var payloads = []
    for name in all_names(store):
        for v in versions_of(store, name):
            if let Some(text) = read_record(store, name, v):
                // RFC-0118: skip a mid-publish placeholder (empty/unparseable
                // `coven.json`) — the coordinate is claimed but not yet finalized,
                // so it is not a target until its record lands whole.
                if coven_record.parse(text).is_ok():
                    keys.push("${name}@${v}")
                    payloads.push(coven_record.record_signing_payload(text))
    let digests = vm.par_map(payloads, hash_payload)
    list.zip_with(keys, digests, fn(key: String, digest: String): (key, JsonString(digest)))

// The runtime footprint of the highest RELEASED version other than `version` — the
// baseline a promote delta is computed against, so an upgrade's delta names only
// the authority that is actually NEW. Empty on first release.
pub fn latest_released_footprint(store: Dir, name: String, version: String) -> List(String):
    var best = ""
    for v in versions_of(store, name):
        if v != version:
            if let Some(rec) = read_record_typed(store, name, v):
                if coven_record.state_of(rec.state) == Released && (best.is_empty() || version_newer(v, best)):
                    best = v
    if best.is_empty():
        []
    else:
        match read_record_typed(store, name, best):
            Some(rec) -> rec.runtime_footprint
            None -> []

// The highest-semver version's record (any state), or None if the rune has no
// readable record — the catalog/browse view of a rune is its newest version.
pub fn latest_record(store: Dir, name: String) -> Option(Record):
    var best = ""
    for v in versions_of(store, name):
        if best.is_empty() || version_newer(v, best):
            best = v
    if best.is_empty():
        None
    else:
        read_record_typed(store, name, best)

fn version_newer(a: String, b: String) -> Bool:
    match semver.parse(a):
        Ok(va) ->
            match semver.parse(b):
                Ok(vb) -> semver.compare(va, vb) > 0
                Err(_e) -> true
        Err(_e) -> false
