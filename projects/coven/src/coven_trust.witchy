// Trusted publishing: OIDC identity-token verification. coven does not accept long-lived
// API tokens (the most-stolen supply-chain credential); a publisher proves identity with a
// short-lived OIDC JWT from a trusted issuer (a CI system's OIDC token, e.g. GitHub
// Actions). This module verifies the RS256 signature against the issuer's pinned key, the
// audience, and the expiry (via `std/jwt`), and derives identity from the VERIFIED claims.
// Pure (no HTTP, no store): the server maps these results to status codes.

import jwt
import coven_json
import show
import error
import convert
import url
from json import Json

// A trusted issuer: a provider id (the token's `iss`) plus the key(s) that sign its
// tokens. One of: a single pinned RSA key (`pubkey`, DER PKCS#1 hex) for a static issuer;
// a `jwks` document from which the signing key is selected by the token's `kid` — the
// rotating form a real OIDC provider (e.g. GitHub Actions) publishes; or an Ed25519 public
// key (`ed25519`, hex) for an INTERNAL EdDSA issuer such as coven-web, which mints a
// short-lived identity token after verifying a passkey server-side (witchy has native
// Ed25519 signing but no RSA signing). Dispatch is by the CONFIGURED key type, never the
// token's `alg` header: an Ed25519 issuer accepts ONLY EdDSA, an RSA/jwks issuer ONLY RS256.
type Issuer:
    id: String
    pubkey: String
    jwks: Option(Json)
    ed25519: Option(String)

// The namespace (first path segment) of a rune name.
pub fn namespace_of(name: String) -> String:
    if name.contains("/"):
        let (ns, _rest) = name.split_once("/")
        ns
    else:
        name

// A provider claim (`repository`, `workflow_ref`, ...) — a top-level field of the JWT
// payload, as a real GitHub Actions OIDC token carries them. "" if absent.
pub fn claim(claims: Json, key: String) -> String:
    coven_json.str(claims, key)

// The second-factor method attested by an ALREADY VERIFIED OIDC token. Real
// providers encode `amr` as an array; the local IdP harness uses a string claim.
// Accept only an explicit MFA/WebAuthn method, never a client request marker.
pub fn second_factor_method(claims: Json) -> Option(String):
    match json.get(claims, "amr"):
        Some(JsonString(method)) -> accepted_second_factor(method)
        Some(JsonArray(methods)) -> list.find_map(methods, second_factor_item)
        _ -> None

fn second_factor_item(item: Json) -> Option(String):
    match item:
        JsonString(method) -> accepted_second_factor(method)
        _ -> None

fn accepted_second_factor(method: String) -> Option(String):
    if method == "mfa" || method == "webauthn":
        Some(method)
    else:
        None

// A SLSA-style provenance attestation built from the VERIFIED identity-token claims,
// bound to the content digest and stamped with the verification time (unix seconds).
// Byte-identical to the Rust `attestation` (src/pm/server.rs): the field order,
// separators, and `verified_at` units must match so the signed `provenance` is the
// same bytes — a record published here verifies under the Rust verifier, and the
// tamper test that greps the signed record for `trusted-publisher` applies unchanged.
// idiom-exempt: concatenation defines the signed provenance byte format.
pub fn attestation(claims: Json, digest: String, now: Int) -> String:
    "trusted-publisher|issuer=" + coven_json.str(claims, "iss") + "|sub=" + coven_json.str(claims, "sub") + "|repository=" + claim(claims, "repository") + "|workflow_ref=" + claim(claims, "workflow_ref") + "|ref=" + claim(claims, "ref") + "|digest=" + digest + "|verified_at=" + "${now}"

// A durable trust-policy JSON string array (e.g. a namespace's maintainers.json).
// Unlike coven's request-body helpers, malformed or wrong-shaped policy state is
// corruption, not an empty policy.
pub fn string_array(text: String) -> Result(List(String), TrustPolicyError):
    match json.decode(text):
        Err(e) -> Err(PolicyInvalidJson(json.decode_error_message(e)))
        Ok(doc) -> strict_string_array(doc)

// Matchable errors for durable trust-policy state. This is authority-bearing
// registry state, so malformed JSON and wrong shapes are corruption, not a
// silent empty policy.
type TrustPolicyError:
    PolicyInvalidJson(String)
    PolicyNotStringArray
    PolicyNonString(Int)

pub fn trust_policy_error_message(e: TrustPolicyError) -> String:
    match e:
        PolicyInvalidJson(reason) -> reason
        PolicyNotStringArray -> "expected a JSON array of strings"
        PolicyNonString(index) -> "expected a string at index ${index}"

impl Show for TrustPolicyError:
    fn show(self) -> String:
        trust_policy_error_message(self)

impl Error for TrustPolicyError

impl From(TrustPolicyError) for String:
    fn from(value: TrustPolicyError) -> Self:
        trust_policy_error_message(value)

fn strict_string_array(doc: Json) -> Result(List(String), TrustPolicyError):
    match doc:
        JsonArray(items) -> strict_strings(items)
        _ -> Err(PolicyNotStringArray)

fn strict_strings(items: List(Json)) -> Result(List(String), TrustPolicyError):
    var out: List(String) = []
    var index = 0
    for item in items:
        if let JsonString(s) = item:
            out.push(s)
        else:
            return Err(PolicyNonString(index))
        index = index + 1
    Ok(out)

// Verify a request's identity token (a compact OIDC JWT): the token's `iss` selects the
// trusted issuer's pinned key, then `verify_oidc` checks the RS256 signature, that the
// audience is this registry, and that it is a fresh, short-lived token. Reading `iss` BEFORE verifying
// is safe — `verify_oidc` re-checks `iss` and the signature, so only a token actually
// signed by the issuer it names (and trusted here) passes. Returns the verified claims, or
// a matchable reason the server renders as 401.
pub fn verify_token(issuers: List(Issuer), token: String, now: Int) -> Result(Json, TokenError):
    let unverified = jwt.claims_unverified(token).map_err(fn(e: jwt.JwtError): TokenMalformedIdentity(jwt.jwt_error_message(e)))?
    let iss = coven_json.str(unverified, "iss")
    match find_issuer(issuers, iss):
        None -> Err(TokenUntrustedIssuer(iss))
        Some(entry) ->
            // BUG-068: trusted-publishing identity tokens are intentionally short-lived.
            // The local IdP defaults to five minutes; permit up to ten minutes plus
            // 60 seconds of issuer clock lead while rejecting absent `iat` or a longer
            // signed lifetime.
            match entry.ed25519:
                // An Ed25519 issuer accepts ONLY EdDSA tokens (dispatch by configured
                // key type, never the wire `alg` header).
                Some(hex) -> jwt.verify_oidc_fresh_eddsa(token, hex, iss, "coven-registry", now, 600, 60).map_err(fn(e: jwt.JwtError): TokenOidc(jwt.jwt_error_message(e)))
                None ->
                    let pubkey = signing_key(entry, token)?
                    jwt.verify_oidc_fresh(token, pubkey, iss, "coven-registry", now, 600, 60).map_err(fn(e: jwt.JwtError): TokenOidc(jwt.jwt_error_message(e)))

// Matchable trusted-publishing identity-token failures. These sit above
// `jwt.JwtError`: the registry also owns issuer trust and JWKS key-selection
// policy, so callers should not have to parse HTTP-facing strings to distinguish
// malformed tokens, untrusted issuers, missing `kid`, or OIDC rejection.
type TokenError:
    TokenMalformedIdentity(String)
    TokenUntrustedIssuer(String)
    TokenMissingKid(String)
    TokenJwksKey(String)
    TokenOidc(String)

pub fn token_error_message(e: TokenError) -> String:
    match e:
        TokenMalformedIdentity(reason) -> "malformed identity token: ${reason}"
        TokenUntrustedIssuer(iss) -> "issuer `${iss}` is not trusted by this registry"
        TokenMissingKid(id) -> "issuer `${id}` publishes a JWKS but the token has no `kid` header"
        TokenJwksKey(reason) -> reason
        TokenOidc(reason) -> reason

impl Show for TokenError:
    fn show(self) -> String:
        token_error_message(self)

impl Error for TokenError

impl From(TokenError) for String:
    fn from(value: TokenError) -> Self:
        token_error_message(value)

fn find_issuer(issuers: List(Issuer), iss: String) -> Option(Issuer):
    list.find_map(issuers, fn(entry: Issuer): if entry.id == iss: Some(entry) else: None)

// The RS256 public key to verify a token against: for a JWKS issuer, the key whose `kid`
// matches the token header (so key rotation is tolerated); otherwise the single pinned key.
fn signing_key(entry: Issuer, token: String) -> Result(String, TokenError):
    match entry.jwks:
        Some(jwks) ->
            match jwt.kid(token):
                Some(k) -> jwt.rsa_key_for_kid(jwks, k).map_err(fn(e: jwt.JwtError): TokenJwksKey(jwt.jwt_error_message(e)))
                None -> Err(TokenMissingKid(entry.id))
        None -> Ok(entry.pubkey)

// --- live OIDC issuer discovery (pure validation) -----------------------------
// The `<issuer-url>=oidc` trust form resolves an issuer's JWKS at startup from
// its OIDC discovery document. This module stays pure: the two HTTPS fetches
// live in coven.witchy (through a Fetch scoped to the issuer origin); these
// validators decide what a fetched document may install, so they can be
// differential-tested without a network.

// Matchable failures resolving live OIDC issuer trust. Every one is
// startup-fatal in the server: a registry must never come up with
// silently-empty trust.
type DiscoveryError:
    IssuerNotHttps(String)
    IssuerInvalidUrl(String)
    DiscoveryInvalidJson(String)
    DiscoveryMissingJwksUri
    JwksUriInvalidUrl(String)
    JwksUriNotHttps(String)
    JwksUriCrossOrigin(String, String)
    JwksInvalidJson(String)
    JwksMissingKeys
    JwksKeysNotArray
    JwksNoRsaKeys

pub fn discovery_error_message(e: DiscoveryError) -> String:
    match e:
        IssuerNotHttps(u) -> "issuer `${u}` must be an https:// URL — live JWKS discovery refuses plaintext http (a network attacker could install the registry's trust roots)"
        IssuerInvalidUrl(reason) -> "invalid issuer URL: ${reason}"
        DiscoveryInvalidJson(reason) -> "malformed OIDC discovery document: ${reason}"
        DiscoveryMissingJwksUri -> "OIDC discovery document carries no `jwks_uri` string"
        JwksUriInvalidUrl(reason) -> "invalid `jwks_uri`: ${reason}"
        JwksUriNotHttps(u) -> "`jwks_uri` `${u}` must be an https:// URL"
        JwksUriCrossOrigin(uri, origin) -> "`jwks_uri` `${uri}` is not same-origin with the issuer (${origin}) — refusing a discovery document that points key fetching at another host"
        JwksInvalidJson(reason) -> "malformed JWKS document: ${reason}"
        JwksMissingKeys -> "JWKS document carries no `keys` field"
        JwksKeysNotArray -> "JWKS `keys` is not an array"
        JwksNoRsaKeys -> "JWKS carries no RSA signing keys — RS256 verification needs at least one `kty: RSA` key"

impl Show for DiscoveryError:
    fn show(self) -> String:
        discovery_error_message(self)

impl Error for DiscoveryError

impl From(DiscoveryError) for String:
    fn from(value: DiscoveryError) -> Self:
        discovery_error_message(value)

// The issuer's canonical origin ("https://host:port") — what the discovery
// fetches are capability-scoped to. https only; a query or fragment is not an
// issuer identifier (OIDC Discovery §3) and is refused.
pub fn issuer_origin(issuer: String) -> Result(String, DiscoveryError):
    match url.parse(issuer):
        Err(e) -> Err(IssuerInvalidUrl(url.url_error_message(e)))
        Ok(u) ->
            if url.scheme(u) != "https":
                Err(IssuerNotHttps(issuer))
            else:
                match (url.query(u), url.fragment(u)):
                    (None, None) -> Ok(origin_of(u))
                    _ -> Err(IssuerInvalidUrl("issuer `${issuer}` must not carry a query or fragment"))

fn origin_of(u: url.Url) -> String:
    "${url.scheme(u)}://${url.host(u)}:${url.port(u)}"

// The issuer's discovery-document URL (OIDC Discovery): the issuer with
// `/.well-known/openid-configuration` appended to its path.
pub fn discovery_url(issuer: String) -> Result(String, DiscoveryError):
    let _origin = issuer_origin(issuer)?
    Ok(issuer.strip_suffix("/") + "/.well-known/openid-configuration")

// The `jwks_uri` of a fetched discovery document — required to be an https URL
// on the SAME ORIGIN as the issuer, so a compromised discovery document cannot
// point key fetching at an attacker-controlled host (and so the server's Net
// grant for the issuer origin provably covers both startup fetches).
pub fn jwks_uri_of(issuer: String, discovery_json: String) -> Result(String, DiscoveryError):
    let origin = issuer_origin(issuer)?
    match json.decode(discovery_json):
        Err(e) -> Err(DiscoveryInvalidJson(json.decode_error_message(e)))
        Ok(doc) ->
            match json.get_string(doc, "jwks_uri"):
                None -> Err(DiscoveryMissingJwksUri)
                Some(uri) ->
                    match url.parse(uri):
                        Err(e) -> Err(JwksUriInvalidUrl(url.url_error_message(e)))
                        Ok(u) ->
                            if url.scheme(u) != "https":
                                Err(JwksUriNotHttps(uri))
                            else if origin_of(u) != origin:
                                Err(JwksUriCrossOrigin(uri, origin))
                            else:
                                Ok(uri)

// A fetched JWKS document, validated at INSTALL time: it must decode, carry a
// `keys` array, and hold at least one RSA key — the only key type RS256
// verification can use. An empty or RSA-less key set would make every later
// token verification fail 401 while the registry looks healthy; refuse to
// install it instead.
pub fn installed_jwks(jwks_json: String) -> Result(Json, DiscoveryError):
    match json.decode(jwks_json):
        Err(e) -> Err(JwksInvalidJson(json.decode_error_message(e)))
        Ok(doc) ->
            match json.get(doc, "keys"):
                None -> Err(JwksMissingKeys)
                Some(keys) ->
                    match json.as_array(keys):
                        None -> Err(JwksKeysNotArray)
                        Some(arr) ->
                            if has_rsa_key(arr):
                                Ok(doc)
                            else:
                                Err(JwksNoRsaKeys)

fn has_rsa_key(keys: List(Json)) -> Bool:
    for k in keys:
        if json.get_string(k, "kty").unwrap_or("") == "RSA":
            return true
    false
