// The book's live Glamour counter. It is a pure MVU application: the browser
// grants it no network authority and it emits no effects.

import reflect
from glamour import VNode, Cmd
from json import Json

type Model derive(Reflect, Deserialize):
    n: Int

type Msg derive(Reflect):
    Inc
    Dec
    Reset

fn view(model: Model) -> VNode(Msg):
    let decrement = html"<button class=counter-btn on:click=${Dec}>−</button>"
    let value = html"<span class=counter-value>${int_to_str(model.n)}</span>"
    let increment = html"<button class=counter-btn on:click=${Inc}>+</button>"
    let reset = html"<button class=counter-reset on:click=${Reset}>reset</button>"
    glamour.classed("div", "counter-demo", [decrement, value, increment, reset])

fn update(model: Model, msg: Msg) -> (Model, Cmd(Msg)):
    let n = match msg:
        Inc -> model.n + 1
        Dec -> model.n - 1
        Reset -> 0

    (Model(n: n), NoCmd)

fn int_to_str(value: Int) -> String:
    "${value}"

fn parse_model(value: Json) -> Model:
    match Model.from_json(value):
        Ok(model) -> model
        Err(_) -> Model(n: 0)

fn parse_msg(value: Json) -> Msg:
    match glamour.msg_variant(value):
        Some("Inc") -> Inc
        Some("Dec") -> Dec
        _ -> Reset

pub fn export_step(input: String) -> String:
    glamour.step(input, view, update, parse_model, parse_msg)
