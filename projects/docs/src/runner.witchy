from glamour import Cmd, Interactive, Program, Start, Sub, Ui, UiRoot

type Msg:
    RunnerIdle

fn authorize(_root: UiRoot) -> Nil:
    Nil

fn initial(_start: Start) -> String:
    ""

fn start(_auth: Nil, _source: String) -> Cmd(Msg):
    NoCmd

fn update(_auth: Nil, source: String, _message: Msg) -> (String, Cmd(Msg)):
    (source, NoCmd)

fn editor_rows(source: String) -> String:
    let lines = source.lines().length()
    if lines < 3: "3" else: "${lines}"

fn view(source: String) -> Ui(Msg):
    glamour.ui(glamour.element("div", [glamour.static_class_attribute(["witchy-cell"]), glamour.attribute("data-witchy-runnable", "1")], [glamour.element("textarea", [glamour.static_class_attribute(["witchy-editor"]), glamour.attribute("rows", editor_rows(source))], [glamour.text(source)]), glamour.element("button", [glamour.static_class_attribute(["witchy-run"]), glamour.attribute("type", "button")], [glamour.text("Run")]), glamour.element("pre", [glamour.static_class_attribute(["witchy-output"])], []), glamour.element("pre", [glamour.static_class_attribute(["witchy-stats"])], []), glamour.element("button", [glamour.static_class_attribute(["witchy-copy"]), glamour.attribute("type", "button"), glamour.aria_attribute("aria-label", "Copy code to clipboard")], [glamour.text("Copy")])]))

fn subscriptions(_auth: Nil, _source: String) -> Sub(Msg):
    NoSub

fn app() -> Program(Nil, String, Msg):
    glamour.program(authorize, initial, start, update, view, subscriptions)

pub fn interactive_runner(source: String) -> Interactive:
    glamour.interactive(app(), source).named("runnable-fence").activate(glamour.OnLoad)
