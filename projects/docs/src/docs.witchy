// docs — The witchy Book as a glamour app (RFC-0041). A capability-PURE MVU app that
// renders the book's Markdown pages (via std/markdown) with a sidebar DERIVED FROM
// `SUMMARY.md`, routed client-side. Every fetch is the host shell's authority — the rune
// holds no `Net`, only a `UiFetch` narrowed from the app-root `UiRoot` (RFC-0039/0040) — so
// the whole docs site is XSS-immune by construction and its host footprint is empty. This
// is the dogfood: the language's own front door is a witchy program, a sibling of coven-web.

import glamour
import markdown
import json
import list
import reflect

// The current path, the book's `SUMMARY.md` source (for the nav), and the current page's
// raw Markdown. The host fetches both; the app parses the nav from the summary itself.
type Model:
    Model(String, String, String)   // route, summary, content

type Msg derive(Reflect):
    Route(String)        // the URL changed (initial, popstate, or after a Nav) -> fetch it
    Visit(String)        // a sidebar click -> navigate to a page
    GotNav(Int, String)  // SUMMARY.md arrived (status, body) -> the nav source
    GotPage(Int, String) // the page's Markdown arrived (status, body)

// The slug for a route: `/p/<slug>` -> `<slug>`; anything else is the home page.
fn slug_of(route: String) -> String:
    if string.starts_with(route, "/p/"):
        string.substring(route, 3, string.length(route))
    else:
        "introduction"

// Parse `SUMMARY.md` into `(title, slug)` nav entries: every `[Title](slug.md)` link
// (flattened — nesting is a later polish) becomes a sidebar page. Lines without a Markdown
// link (the `# Summary` header, blanks) are skipped. Pure string surgery — no capability.
fn parse_nav(summary: String) -> List((String, String)):
    var out = []
    for line in string.lines(summary):
        if string.contains(line, "](") && string.contains(line, ".md)"):
            let (_pre, after_lb) = string.split_once(line, "[")
            let (title, after_bracket) = string.split_once(after_lb, "](")
            let (slug, _rest) = string.split_once(after_bracket, ".md)")
            out = list.push(out, (title, slug))
    out

fn update(m: Model, msg: Msg, fetch: UiFetch, route_cap: UiRoute) -> (Model, Cmd(Msg)):
    match m:
        Model(route, summary, content) ->
            match msg:
                // A sidebar click is a real navigation; the shell echoes it back as `Route`.
                Visit(path) -> (m, glamour.navigate(route_cap, path))
                // The route changed: fetch that page. On the FIRST route (no nav yet) also
                // fetch SUMMARY.md, batched — the host performs both (it holds the Net).
                Route(path) ->
                    let slug = slug_of(path)
                    let page = glamour.http_get(fetch, "/content/" + slug + ".md", "GotPage")
                    let cmd = if string.is_empty(summary):
                        Batch([glamour.http_get(fetch, "/content/SUMMARY.md", "GotNav"), page])
                    else:
                        page
                    (Model(path, summary, content), cmd)
                GotNav(_status, body) -> (Model(route, body, content), NoCmd)
                GotPage(_status, body) -> (Model(route, summary, body), NoCmd)

fn view(m: Model) -> VNode(Msg):
    match m:
        Model(route, summary, content) ->
            glamour.element("div", [glamour.prop("class", "book")], [
                sidebar(route, summary),
                // Untrusted Markdown renders INLINE as data (never an HTML sink) — safe by
                // construction (std/markdown): raw HTML shows as literal text, hrefs are
                // scheme-checked. No compartment needed for content.
                glamour.element("main", [glamour.prop("class", "page")], [
                    runnable_markdown(content),
                    nav_chapters(route, summary),
                ]),
            ])

// Prev/next chapter links at the foot of the page (mdBook-style), from the current route's
// position in the SUMMARY-derived nav. A missing edge (first/last page) renders a spacer so the
// remaining link keeps its side.
fn nav_chapters(route: String, summary: String) -> VNode(Msg):
    let entries = parse_nav(summary)
    let idx = index_of_route(entries, route)
    glamour.element("div", [glamour.prop("class", "nav-chapters")], [
        edge_link(entries, idx - 1, "prev", "Previous"),
        edge_link(entries, idx + 1, "next", "Next"),
    ])

fn index_of_route(entries: List((String, String)), route: String) -> Int:
    var idx = 0 - 1
    var i = 0
    for entry in entries:
        let (_title, slug) = entry
        if "/p/" + slug == route:
            idx = i
        i = i + 1
    idx

fn edge_link(entries: List((String, String)), i: Int, cls: String, label: String) -> VNode(Msg):
    if i >= 0 && i < list.length(entries):
        let (title, slug) = list.at(entries, i)
        glamour.element("button", [glamour.prop("class", "nav-chapter " + cls), glamour.on("click", Visit("/p/" + slug))], [
            glamour.element("span", [glamour.prop("class", "dir")], [glamour.text(label)]),
            glamour.element("span", [glamour.prop("class", "title")], [glamour.text(title)]),
        ])
    else:
        glamour.element("span", [glamour.prop("class", "nav-spacer")], [])

fn sidebar(route: String, summary: String) -> VNode(Msg):
    var items = []
    for entry in parse_nav(summary):
        let (title, slug) = entry
        let path = "/p/" + slug
        let cls = if path == route: "nav-item active" else: "nav-item"
        items = list.push(items, glamour.element("li", [], [
            glamour.element("button", [glamour.prop("class", cls), glamour.on("click", Visit(path))], [glamour.text(title)]),
        ]))
    glamour.element("nav", [glamour.prop("class", "sidebar")], [
        glamour.element("h1", [], [glamour.text("The witchy Book")]),
        glamour.element("ul", [], items),
    ])

// (RFC-0041 P2) Render the page's Markdown, then replace each `witchy` code block with a host
// `Slot` — the DOM shell mounts a RUNNABLE cell there, in a subtree glamour never diffs into,
// so re-renders (a nav change, another fetch) can't clobber it. `markdown.to_vnode` wraps the
// page in `<div class="markdown">[blocks]`, and a fenced block is a top-level `<pre>`, so we
// only remap the div's immediate children. Everything else renders exactly as before.
fn runnable_markdown(md: String) -> VNode(Msg):
    match markdown.to_vnode(md):
        Element(tag, attrs, blocks) -> Element(tag, attrs, list.map(blocks, to_runnable))
        other -> other

fn to_runnable(block: VNode(Msg)) -> VNode(Msg):
    match block:
        Element(tag, _attrs, kids) ->
            if tag == "pre" && list.length(kids) == 1:
                match list.at(kids, 0):
                    Element(ctag, cattrs, ckids) ->
                        if ctag == "code":
                            let code = code_text(ckids)
                            let lang = code_language(cattrs)
                            if lang == "witchy":
                                // A Run cell ONLY where the snippet actually runs in the cell;
                                // a capability example is highlighted static code (no Run
                                // button, so no misleading "capability denied" error).
                                let kind = if runs_in_browser(code): "witchy-runnable" else: "witchy-static"
                                glamour.slot(kind, code)
                            else if lang == "sh":
                                glamour.slot("shell-static", code)
                            else if lang == "toml":
                                glamour.slot("toml-static", code)
                            else if lang == "glamour-app":
                                // The fence body NAMES a bundled demo app; the host mounts it
                                // live (via the book's own glamour-dom runtime, network denied).
                                glamour.slot("glamour-app", string.trim(code))
                            else:
                                // `text` (program output / diagrams) and untagged fences stay
                                // as plain styled blocks — not code to syntax-highlight.
                                block
                        else:
                            block
                    _ -> block
            else:
                block
        _ -> block

// A `witchy` fence RUNS in the browser cell iff its `main` needs no capability the denied
// sandbox withholds — the cell grants only `Console`, so a `Dir`/`Net`/`Secret`/… example
// (or one taking a glamour UI token) can't run here. Heuristic over the snippet: it has a
// `main`, and its code names no non-Console capability TYPE. Types are Title-cased, so
// builtins (`read_file`, `connect`) don't false-match; a capability appears as a `main`
// parameter type in every real example.
fn runs_in_browser(code: String) -> Bool:
    string.contains(code, "fn main(") && !names_denied_capability(code)

fn names_denied_capability(code: String) -> Bool:
    var found = false
    for cap in ["Dir", "Net", "File", "Secret", "Clock", "Exec", "UiRoot", "UiFetch", "UiRoute", "UiTimer", "CredentialPort", "SecretInput", "SecretRef"]:
        if string.contains(code, cap):
            found = true
    found

// The fence language from a `<code>`'s `language-<lang>` class (markdown preserves the fence's
// info string there), or "" if none — so the app can slot each fence to the right highlighter.
fn attr_language(a: Attr(Msg)) -> String:
    match a:
        Prop(name, value) ->
            if name == "class" && string.starts_with(value, "language-"):
                string.substring(value, 9, string.length(value))
            else:
                ""
        On(_e, _m) -> ""
        OnInput(_e, _t) -> ""

fn code_language(attrs: List(Attr(Msg))) -> String:
    var lang = ""
    for a in attrs:
        let l = attr_language(a)
        if !string.is_empty(l):
            lang = l
    lang

// The source text inside a `<code>` (its single child text node).
fn code_text(kids: List(VNode(Msg))) -> String:
    if list.length(kids) >= 1:
        match list.at(kids, 0):
            Text(s) -> s
            _ -> ""
    else:
        ""

// --- MVU glue (the inbound/outbound JSON boundary) -----------------------------
fn parse_model(j: Json) -> Model:
    let route = json.get_string(j, "route").unwrap_or("/")
    let summary = json.get_string(j, "summary").unwrap_or("")
    let content = json.get_string(j, "content").unwrap_or("")
    Model(route, summary, content)

fn arg_int(j: Json, i: Int) -> Int:
    match json.get(j, "$values"):
        Some(arr) ->
            match json.index(arr, i):
                Some(v) -> json.as_int(v).unwrap_or(0)
                None -> 0
        None -> 0

fn arg_str(j: Json, i: Int) -> String:
    match json.get(j, "$values"):
        Some(arr) ->
            match json.index(arr, i):
                Some(v) -> json.as_string(v).unwrap_or("")
                None -> ""
        None -> ""

fn parse_msg(j: Json) -> Msg:
    match json.get_string(j, "$variant"):
        Some(v) ->
            if v == "Visit":
                Visit(arg_str(j, 0))
            else if v == "GotNav":
                GotNav(arg_int(j, 0), arg_str(j, 1))
            else if v == "GotPage":
                GotPage(arg_int(j, 0), arg_str(j, 1))
            else:
                Route(arg_str(j, 0))
        None -> Route("/")

fn model_to_json(m: Model) -> Json:
    match m:
        Model(route, summary, content) ->
            JsonObject([("route", JsonString(route)), ("summary", JsonString(summary)), ("content", JsonString(content))])

fn msg_to_json(m: Msg) -> Json:
    json.value_of(m)

pub fn export_step(ui: UiRoot, input: String) -> String:
    // (RFC-0039/0040) narrow the host-minted `UiRoot` into a GET-only `UiFetch` (confined
    // to the content dir) and a `UiRoute` (push under `/p`), curried into `update` — so the
    // docs app can fetch pages and navigate only because it holds those tokens.
    let fetch = glamour.fetch_scope(ui, "book", "GET", "/content/")
    let route_cap = glamour.route_scope(ui, "/p", "push")
    let upd = fn(m: Model, msg: Msg): update(m, msg, fetch, route_cap)
    step_with(input, view, upd, parse_model, parse_msg, model_to_json, msg_to_json)

fn main(console: Console, ui: UiRoot):
    print(console, export_step(ui, "{\"model\": {\"route\": \"/\", \"summary\": \"\", \"content\": \"# The witchy Book\\n\\nWelcome.\"}}") + "\n")
