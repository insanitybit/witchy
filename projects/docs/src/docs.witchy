// The Witchy Book is a Glamour application. Its model and update loop are
// ordinary Witchy; the browser host supplies narrowly scoped fetch and route
// authority and renders the resulting VNode tree.

import list
import docs_content
import reflect
from glamour import VNode, Cmd, UiFetch, UiRoute, UiRoot
from docs_model import Model, Msg
from docs_nav import Entry, Page
from json import Json

fn update(model: Model, msg: Msg, fetch: UiFetch, route: UiRoute) -> (Model, Cmd(Msg)):
    match msg:
        Visit(path) -> (model, glamour.navigate(route, path))
        Route(path) ->
            let source = "/content/${docs_nav.slug(path)}.md"
            let page = glamour.http_get_with(fetch, source, "GotPage", [JsonString(path)])
            let navigation = glamour.http_get(fetch, "/content/SUMMARY.md", "GotNav")
            let command = if model.summary.is_empty(): Batch([navigation, page]) else: page
            (docs_model.route_started(model, path), command)
        GotNav(_status, body) -> (Model(summary: body, ..model), NoCmd)
        GotPage(path, _status, body) -> (docs_model.page_loaded(model, path, body), NoCmd)

fn view(model: Model) -> VNode(Msg):
    let entries = docs_nav.parse(model.summary)
    let content = docs_content.render(model.content)
    let main = glamour.classed("main", "page", [content, chapter_links(model.route, entries)])
    glamour.classed("div", "book", [sidebar(model.route, entries), main])

fn chapter_links(route: String, entries: List(Entry)) -> VNode(Msg):
    let pages = docs_nav.pages(entries)
    let (previous, next) = match docs_nav.route_position(pages, route):
        Some(current) -> (edge_link(pages, current - 1, "prev", "Previous"), edge_link(pages, current + 1, "next", "Next"))
        None -> (empty_edge(), empty_edge())

    glamour.classed("div", "nav-chapters", [previous, next])

fn empty_edge() -> VNode(Msg):
    html"<span class=nav-spacer></span>"

fn edge_link(pages: List(Page), index: Int, class_name: String, direction: String) -> VNode(Msg):
    match pages.get(index):
        Some(page) ->
            let path = docs_nav.page_path(page)
            let attrs = [glamour.prop("class", "nav-chapter ${class_name}"), glamour.on("click", Visit(path))]
            let label = html"<span class=dir>${direction}</span>"
            let title = html"<span class=title>${page.title}</span>"
            glamour.element("button", attrs, [label, title])
        None -> empty_edge()

fn sidebar(route: String, entries: List(Entry)) -> VNode(Msg):
    let items = entries.drop(1).map(fn(entry: Entry): nav_entry(entry, route))
    let brand = html"<button class=sidebar-brand on:click=${Visit(docs_nav.cover_path(entries))}>The witchy Book</button>"
    let links = glamour.element("ul", [], items)
    glamour.classed("nav", "sidebar", [brand, links])

fn nav_entry(entry: Entry, route: String) -> VNode(Msg):
    match entry:
        Divider -> html"<li class=nav-divider></li>"
        PageLink(depth, page) ->
            let path = docs_nav.page_path(page)
            let active = if docs_nav.is_current(page, route): " active" else: ""
            let class_name = "nav-item nav-depth-${depth}${active}"
            let attrs = [glamour.prop("class", class_name), glamour.on("click", Visit(path))]
            let button = glamour.element("button", attrs, [glamour.text(page.title)])
            glamour.element("li", [], [button])

pub fn export_step(ui: UiRoot, input: String) -> String:
    let fetch = glamour.fetch_scope(ui, "book", "GET", "/content/")
    let route = glamour.route_scope(ui, "/p", "push")
    let app_update = fn(model: Model, msg: Msg): update(model, msg, fetch, route)
    glamour.step(input, view, app_update, docs_model.parse, docs_model.parse_msg)

fn main(console: Console, ui: UiRoot):
    let input = json.stringify(.{model: docs_model.initial("/")})
    console.print("${export_step(ui, input)}\n")
