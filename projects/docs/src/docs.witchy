// docs — The witchy Book as a glamour app (RFC-0041). An empty-root-footprint MVU app that
// renders the book's Markdown pages (via std/markdown) with a sidebar DERIVED FROM
// `SUMMARY.md`, routed client-side. Every fetch is the host shell's authority — the rune
// holds no `Net`, only a `UiFetch` narrowed from the app-root `UiRoot` (RFC-0039/0040) — so
// the whole docs site is XSS-immune by construction and its host footprint is empty. This
// is the dogfood: the language's own front door is a witchy program, a sibling of coven-web.

import markdown
import list
import reflect
import counter
import runner
from glamour import Attr, Cmd, HttpResult, Interactive, NavigationResult, Program, RouteDef, RouteGraph, RouteId, Site, Start, StaticContent, Sub, Ui, UiFetch, UiRoute, UiRoot, VNode
from json import Json

// The current path, the book's `SUMMARY.md` source (for the nav), and the current page's
// raw Markdown. The host fetches both; the app parses the nav from the summary itself.
type Model:
    Model(String, String, String)

type Msg derive(Reflect):
    Route(String)
    Visit(String)
    GotNav(HttpResult)
    GotPage(HttpResult)
    NavigationDone(NavigationResult)

type Auth:
    Auth(UiFetch, UiRoute)

fn page_route() -> RouteDef:
    glamour.route("/p/*slug").unwrap_or(RouteDef(RouteId("invalid"), "/", []))

fn book_routes() -> RouteGraph:
    glamour.route_graph([page_route()]).unwrap_or(RouteGraph([]))

fn page_path(slug: String) -> String:
    match glamour.route_url(page_route(), [("slug", slug)]):
        Ok(destination) -> glamour.safe_url_string(destination)
        Err(_error) -> "/"

// Parse the current path through the same typed graph used to construct links.
fn slug_of(path: String) -> String:
    match glamour.match_route(book_routes(), path):
        Some(found) -> glamour.route_match_parameter(found, "slug") ?? "introduction"
        None -> "introduction"

// A parsed `SUMMARY.md` entry: a page link at some nesting depth, or the `---` rule that
// separates the appendices from the main chapters.
type Nav:
    Item(Int, String, String)
    Divider

// Parse `SUMMARY.md` into nav entries, PRESERVING its two-level structure: every
// `[Title](slug.md)` link becomes an `Item` tagged with its indentation depth (so the sidebar
// nests sub-pages under their chapter), and a `---` line becomes a `Divider`. Lines without a
// Markdown link (the `# Summary` header, blanks) are skipped. Data-only string surgery — no cap.
fn parse_nav(summary: String) -> List(Nav):
    var out = []
    for line in summary.lines():
        if line.trim() == "---":
            out.push(Divider)
        else if line.contains("](") && line.contains(".md)"):
            let (_pre, after_lb) = line.split_once("[")
            let (title, after_bracket) = after_lb.split_once("](")
            let (slug, _rest) = after_bracket.split_once(".md)")
            out.push(Item(nav_depth(line), title, slug))
    out

// A nav line's indentation depth: bulleted sub-pages nest by a 2-space indent (`  - `); a
// chapter (`- `) or an un-bulleted part link (the cover, the appendices) sits at depth 0.
fn nav_depth(line: String) -> Int:
    (line.length() - line.trim_start().length()) / 2

// The flat reading-order list of real pages (dropping depth + dividers). Prev/next and the
// active-page lookup walk the book in order, independent of how it nests in the sidebar.
fn nav_pages(nav: List(Nav)) -> List((String, String)):
    var out = []
    for entry in nav:
        if let Item(_depth, title, slug) = entry:
            out.push((title, slug))

    out

fn update(auth: Auth, m: Model, msg: Msg) -> (Model, Cmd(Msg)):
    match auth:
        Auth(fetch, route_cap) ->
            match m:
                // A sidebar click is a real navigation; the shell echoes it back as `Route`.

                // The route changed: fetch that page. On the FIRST route (no nav yet) also
                // fetch SUMMARY.md, batched — the host performs both (it holds the Net).
                Model(route, summary, content) ->
                    match msg:
                        Visit(path) -> (m, glamour.navigate("book.navigation", route_cap, path, fn(result: NavigationResult): NavigationDone(result)))
                        Route(path) ->
                            let slug = slug_of(path)
                            let page = glamour.http_get("book.page", fetch, "/content/${slug}.md", fn(result: HttpResult): GotPage(result))
                            let cmd = if summary.is_empty(): Batch([glamour.http_get("book.summary", fetch, "/content/SUMMARY.md", fn(result: HttpResult): GotNav(result)), page]) else: page
                            (Model(path, summary, content), cmd)
                        GotNav(result) ->
                            match result:
                                HttpResponse(_status, body) -> (Model(route, body, content), NoCmd)
                                HttpFailure(_problem) -> (m, NoCmd)
                                _ -> (m, NoCmd)
                        GotPage(result) ->
                            match result:
                                HttpResponse(_status, body) -> (Model(route, summary, body), NoCmd)
                                HttpFailure(_problem) -> (m, NoCmd)
                                _ -> (m, NoCmd)
                        NavigationDone(result) ->
                            match result:
                                Navigated(path) -> update(auth, m, Route(path))
                                _ -> (m, NoCmd)

fn view(m: Model) -> Ui(Msg):
    book_view(m)

fn book_view(m: Model) -> Ui(Msg):
    match m:
        Model(route, summary, content) ->
            glamour.ui(glamour.element("div", [glamour.prop("class", "book")], [sidebar(route, summary), glamour.element("main", [glamour.prop("class", "page")], [runnable_markdown(content), nav_chapters(route, summary)])]))

// Untrusted Markdown renders INLINE as data (never an HTML sink) — safe by
// construction (std/markdown): raw HTML shows as literal text, hrefs are
// scheme-checked. No compartment needed for content.

// Prev/next chapter links at the foot of the page (mdBook-style), from the current route's
// position in the SUMMARY-derived nav. A missing edge (first/last page) renders a spacer so the
// remaining link keeps its side.
fn nav_chapters(route: String, summary: String) -> VNode(Msg):
    let entries = nav_pages(parse_nav(summary))
    let idx = index_of_route(entries, route)
    glamour.element("div", [glamour.prop("class", "nav-chapters")], [edge_link(entries, idx - 1, "prev", "Previous"), edge_link(entries, idx + 1, "next", "Next")])

fn index_of_route(entries: List((String, String)), route: String) -> Int:
    var idx = 0 - 1
    var i = 0
    for _title, slug in entries:
        if page_path(slug) == route:
            idx = i
        i = i + 1
    idx

fn edge_link(entries: List((String, String)), i: Int, cls: String, label: String) -> VNode(Msg):
    if i >= 0 && i < entries.length():
        let (title, slug) = entries.at(i)
        let path = page_path(slug)
        glamour.element("a", [glamour.prop("class", "nav-chapter ${cls}"), glamour.navigation_url_attribute("href", glamour.navigation_url_or_root(path)), glamour.on("click", Visit(path))], [glamour.element("span", [glamour.prop("class", "dir")], [glamour.text(label)]), glamour.element("span", [glamour.prop("class", "title")], [glamour.text(title)])])
    else:
        glamour.element("span", [glamour.prop("class", "nav-spacer")], [])

fn sidebar(route: String, summary: String) -> VNode(Msg):
    let nav = parse_nav(summary)
    // The first entry is the book's cover (the un-bulleted title link); the sidebar header IS
    // its link, so it isn't repeated in the list below.
    let items = nav.drop(1).map(fn(entry: Nav): nav_node(entry, route))
    let cover = cover_path(nav)
    glamour.element("nav", [glamour.prop("class", "sidebar")], [glamour.element("a", [glamour.prop("class", "sidebar-brand"), glamour.navigation_url_attribute("href", glamour.navigation_url_or_root(cover)), glamour.on("click", Visit(cover))], [glamour.text("The witchy Book")]), glamour.element("ul", [], items)])

// The route of the cover page (the first nav entry), so the sidebar header links to it.
fn cover_path(nav: List(Nav)) -> String:
    if nav.length() >= 1:
        match nav.at(0):
            Item(_d, _t, slug) -> page_path(slug)
            Divider -> page_path("introduction")
    else:
        page_path("introduction")

// One sidebar entry: a page button (indented by its depth, highlighted when it is the current
// route) or the appendix divider.
fn nav_node(entry: Nav, route: String) -> VNode(Msg):
    match entry:
        Divider -> glamour.element("li", [glamour.prop("class", "nav-divider")], [])
        Item(depth, title, slug) ->
            let path = page_path(slug)
            let active = if path == route: " active" else: ""
            let cls = "nav-item nav-depth-${depth}${active}"
            glamour.element("li", [], [glamour.element("a", [glamour.prop("class", cls), glamour.navigation_url_attribute("href", glamour.navigation_url_or_root(path)), glamour.on("click", Visit(path))], [glamour.text(title)])])

// Render the page's Markdown, then make each browser-runnable Witchy fence a compiler-owned
// interactive region. The static page contains the complete editor cell; the small host adopts
// that authenticated DOM after resumable activation and owns only compilation and execution.
// `markdown.to_vnode` wraps the page in `<div class="markdown">[blocks]`, so only the immediate
// fenced children need remapping. Everything else renders exactly as before.
fn runnable_markdown(md: String) -> VNode(Msg):
    match markdown.to_vnode(md):
        Element(tag, attrs, blocks) -> Element(tag, attrs, blocks.map(to_runnable))
        other -> other

fn embed_region(interactive: Interactive) -> VNode(Msg):
    let mapped = glamour.ui(glamour.embed(interactive)).map(fn(_never: Nil): Route(""))
    glamour.ui_node(mapped)

fn to_runnable(block: VNode(Msg)) -> VNode(Msg):
    match block:
        // A Run cell ONLY where the snippet actually runs in the cell;
        // a capability example is highlighted static code (no Run
        // button, so no misleading "capability denied" error).

        // The fence body NAMES a bundled demo app; the host mounts it
        // live (via the book's own glamour-dom runtime, network denied).

        // `text` (program output / diagrams) and untagged fences stay
        // as plain styled blocks. Source fragments use `witchy-static`.
        Element(tag, _attrs, kids) ->
            if tag == "pre" && kids.length() == 1:
                match kids.at(0):
                    Element(ctag, cattrs, ckids) ->
                        if ctag == "code":
                            let code = code_text(ckids)
                            let lang = code_language(cattrs)
                            if lang == "witchy":
                                if runs_in_browser(code):
                                    embed_region(runner.interactive_runner(code))
                                else:
                                    glamour.slot("witchy-static", code)
                            else if lang == "witchy-static":
                                // Highlighted fragments that are not executed
                                // programs. The example harness only extracts
                                // ```witchy fences, so these stay out of the
                                // runnable census.
                                glamour.slot("witchy-static", code)
                            else if lang == "sh":
                                glamour.slot("shell-static", code)
                            else if lang == "toml":
                                glamour.slot("toml-static", code)
                            else if lang == "glamour-app":
                                if code.trim() == "counter":
                                    embed_region(counter.interactive_counter())
                                else:
                                    glamour.slot("glamour-app", code.trim())
                            else:
                                block
                        else:
                            block
                    _ -> block
            else:
                block
        _ -> block

// A `witchy` fence RUNS in the browser cell iff its `main` needs no capability the denied
// sandbox withholds — the cell grants only `Console`, so a `Dir`/`Net`/`Secret`/… example
// (or one taking a glamour UI token) can't run here. Heuristic over the snippet: it has a
// `main`, and its code names no non-Console capability TYPE. Types are Title-cased, so
// builtins (`read_file`, `connect`) don't false-match; a capability appears as a `main`
// parameter type in every real example.
//
// This book's cell deliberately uses the capability-DENIED host (`web/witchy-host.js`), so a
// capability example is shown as read-only code — never a Run button that would fail to
// instantiate. RFC-0091 adds an OPT-IN playground host (`web/witchy-runtime/witchy-runtime.mjs`)
// that can back `Clock`/`Env`/`Dir` with browser-honest resources; a teaching embedder that
// wires that host in (and the `browser_runnable` classification in `book/examples.json`) can
// offer Run for those families. We keep the denied host here so the guarantee stays: no
// affordance the book's own engine can't honor.
fn runs_in_browser(code: String) -> Bool:
    code.contains("fn main(") && !names_denied_capability(code)

fn names_denied_capability(code: String) -> Bool:
    let denied = ["Net", "File", "Rand", "Exec", "UiRoot", "UiFetch", "UiRoute", "UiTimer", "CredentialPort", "SecretInput", "SecretRef"]
    denied.any(fn(cap: String): code.contains(cap)) || code.replace("SecretStore", "").contains("Secret")

// The fence language from a `<code>`'s `language-<lang>` class (markdown preserves the fence's
// info string there), or "" if none — so the app can slot each fence to the right highlighter.
fn attr_language(a: Attr(Msg)) -> String:
    match a:
        Attribute(name, value) ->
            if name == "class" && value.starts_with("language-"):
                value.drop(9)
            else:
                ""
        BooleanAttribute(_name, _enabled) -> ""
        Property(_name, _value) -> ""
        UrlAttribute(_name, _value) -> ""
        ClassAttribute(names) ->
            names.fold("", fn(language: String, name: String): if language.is_empty() && name.starts_with("language-"): name.drop(9) else: language)
        AriaAttribute(_name, _value) -> ""
        CustomProperties(_assignments) -> ""
        Prop(name, value) ->
            if name == "class" && value.starts_with("language-"):
                value.drop(9)
            else:
                ""
        On(_e, _m) -> ""
        OnInput(_e, _t) -> ""
        OnDecoded(_id, _event, _decoder) -> ""

fn code_language(attrs: List(Attr(Msg))) -> String:
    attrs.fold("", fn(language: String, a: Attr(Msg)):
        let l = attr_language(a)
        if l.is_empty():
            language
        else:
            l
    )

// The source text inside a `<code>` (its single child text node).
fn code_text(kids: List(VNode(Msg))) -> String:
    if kids.length() >= 1:
        match kids.at(0):
            Text(s) -> s
            _ -> ""
    else:
        ""

// Static delivery receives a compiler-snapshotted content collection. The same
// view function renders both the native static document and the client DOM, so
// their equivalence is testable without maintaining a second template.
pub fn web(content: StaticContent) -> Site:
    let summary = glamour.static_content_get(content, "SUMMARY.md") ?? "# Summary\n\n[The witchy Book](title.md)\n\n- [Introduction](introduction.md)\n"
    let introduction = glamour.static_content_get(content, "introduction.md") ?? "# Introduction\n"
    var pages = [static_book_page("/", "/", summary, introduction)]
    for file in glamour.static_content_files(content):
        let source = glamour.static_content_path(file)
        if source != "SUMMARY.md" && source.ends_with(".md"):
            let slug = source.strip_suffix(".md")
            let route = page_path(slug)
            pages.push(static_book_page(route, route, summary, glamour.static_content_text(file)))
    glamour.site(pages)

fn static_book_page(output_route: String, model_route: String, summary: String, content: String) -> glamour.StaticPage:
    glamour.static_page(output_route, book_view(Model(model_route, summary, content)))

// --- MVU glue (the inbound/outbound JSON boundary) -----------------------------
fn parse_model(j: Json) -> Model:
    let route = json.get_string(j, "route").unwrap_or("/")
    let summary = json.get_string(j, "summary").unwrap_or("")
    let content = json.get_string(j, "content").unwrap_or("")
    Model(route, summary, content)

fn arg_json(j: Json, i: Int) -> Json:
    match json.get(j, "\$values"):
        Some(arr) ->
            match json.index(arr, i):
                Some(v) -> v
                None -> JsonNull
        None -> JsonNull

fn arg_str(j: Json, i: Int) -> String:
    match json.get(j, "\$values"):
        Some(arr) ->
            match json.index(arr, i):
                Some(v) -> json.as_string(v).unwrap_or("")
                None -> ""
        None -> ""

fn parse_msg(j: Json) -> Msg:
    match json.get_string(j, "\$variant"):
        Some(v) ->
            if v == "Visit":
                Visit(arg_str(j, 0))
            else if v == "GotNav":
                GotNav(glamour.http_result_from_json(arg_json(j, 0)))
            else if v == "GotPage":
                GotPage(glamour.http_result_from_json(arg_json(j, 0)))
            else if v == "NavigationDone":
                NavigationDone(glamour.navigation_result_from_json(arg_json(j, 0)))
            else:
                Route(arg_str(j, 0))
        None -> Route("/")

fn model_to_json(m: Model) -> Json:
    match m:
        Model(route, summary, content) ->
            JsonObject([("route", JsonString(route)), ("summary", JsonString(summary)), ("content", JsonString(content))])

fn msg_to_json(m: Msg) -> Json:
    json.from_value(m)

fn authorize(ui: UiRoot) -> Auth:
    Auth(glamour.fetch_scope(ui, "book", "GET", "/content/"), glamour.route_scope(ui, "/p", "push"))

fn initial(start: Start) -> Model:
    match start:
        Start(route, bootstrap) -> Model(route, "", bootstrap)

fn start(_auth: Auth, _model: Model) -> Cmd(Msg):
    NoCmd

fn subscriptions(_auth: Auth, _model: Model) -> Sub(Msg):
    glamour.no_sub()

fn app() -> Program(Auth, Model, Msg):
    glamour.program(authorize, initial, start, update, view, subscriptions)

pub fn export_step(ui: UiRoot, input: String) -> String:
    glamour.program_step_with(input, ui, app(), parse_model, parse_msg, model_to_json, msg_to_json)

fn main(console: Console, ui: UiRoot):
    // idiom-exempt: the trailing newline frames the exported JSON for the host.
    console.print(export_step(ui, "{\"model\": {\"route\": \"/\", \"summary\": \"\", \"content\": \"# The witchy Book\\n\\nWelcome.\"}}") + "\n")
