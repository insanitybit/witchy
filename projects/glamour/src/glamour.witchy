// glamour — the view layer (RFC-0008): a capability-pure MVU core over a `VNode`
// tree. A view is a VALUE, not a side effect: `view(state) -> VNode(msg)` is a
// pure projection of state to data, an event is a `msg` VALUE carried by `On`,
// and `update(state, msg) -> (state, Cmd(msg))` is an ordinary `match`. The rune
// holds NO capability; `witchy caps projects/glamour/src/glamour.witchy` proves
// the footprint is empty. A capability-holding host shell diffs the tree into the
// real DOM and marshals DOM events back as `msg` values — the rune computes, the
// shell acts.
//
// `string`/`list` come from the prelude (no import needed) and are PURE, so they
// grant no authority — that is what keeps this rune's footprint empty.

// `json`/`reflect` are PURE (capability-free) too — they serialize the VNode tree
// and reflect a `msg` value to JSON the host shell consumes. Importing them keeps
// the empty footprint (they touch no Net/Dir/Clock); see `to_json`/the run loop.

import reflect
import meta
import crypto
import url
import dict
import bytes
from public_state import PublicState
from json import Deserialize, Json

// ---------------------------------------------------------------------------
// UI capabilities (RFC-0039) — Glamour's own authority vocabulary. `UiRoot` is a
// BARE grantable capability an app's `main` receives from the host (a `[user_caps]`
// grant, RFC-0038); Glamour NARROWS it into per-concern tokens. A component can
// only construct the effects for which it holds the matching token, so effect
// authority is statically reviewable — while REAL browser authority stays in the
// host shell (RFC-0007/0008). These carry only policy data (no host capability),
// so the rune's host footprint stays empty; they surface on the `user_caps` axis.
// ---------------------------------------------------------------------------

// The app-root UI token, granted to `main`. Bare: policy data only.
grantable capability UiRoot:
    policy: String

// Authority to construct a fetch command, confined to a method-set + path prefix.
capability UiFetch:
    scope: String
    methods: String
    prefix: String

// Authority to construct a navigation command, within a base path.
capability UiRoute:
    base: String
    rights: String

// Authority to construct a timer command (no shorter than `min_ms`).
capability UiTimer:
    min_ms: Int

// Authority to use one namespaced browser storage provider.
capability UiStorage:
    provider: String
    namespace: String
    key_prefix: String
    max_value_bytes: Int

// Authority to run one compiler-authenticated capability-free worker task.
capability UiWorker:
    name: String
    max_request_bytes: Int
    max_result_bytes: Int
    max_concurrency: Int
    timeout_ms: Int

// Authority to invoke a named host credential port (login, passkey, promote).
capability CredentialPort:
    name: String

// A toolchain-owned typed host adapter. The request/result parameters remain
// visible to the compiler while the runtime token contains only registry policy.
sealed type HostPort(request, result):
    HostPort(String, String, Int, Int)

type CredentialExchangeRequest derive(Reflect):
    CredentialExchangeRequest(String)

type CredentialExchangeOutcome derive(Reflect):
    CredentialExchangeOutcome(Int, Bool)

// Authority to render a host-owned secret input — the value stays host-side.
capability SecretInput:
    form: String
    field: String

// An opaque handle to a host-held secret value — passed, never read by the rune.
capability SecretRef:
    slot: String

// Narrow the app-root token into per-concern tokens. Only Glamour (this module)
// can mint them; an app hands each narrowed token to the component that needs it,
// so the component-authority graph is explicit and reviewable.
pub fn fetch_scope(root: UiRoot, scope: String, methods: String, prefix: String) -> UiFetch:
    match root:
        UiRoot(_) -> UiFetch(scope, methods, prefix)

pub fn route_scope(root: UiRoot, base: String, rights: String) -> UiRoute:
    match root:
        UiRoot(_) -> UiRoute(base, rights)

pub fn timer_scope(root: UiRoot, min_ms: Int) -> UiTimer:
    match root:
        UiRoot(_) -> UiTimer(min_ms)

pub fn storage_scope(root: UiRoot, provider: String, namespace: String, key_prefix: String, max_value_bytes: Int) -> UiStorage:
    match root:
        UiRoot(_) -> UiStorage(provider, namespace, key_prefix, max_value_bytes)

pub fn worker_scope(root: UiRoot, name: String, max_request_bytes: Int, max_result_bytes: Int, max_concurrency: Int, timeout_ms: Int) -> UiWorker:
    match root:
        UiRoot(_) -> UiWorker(name, max_request_bytes, max_result_bytes, max_concurrency, timeout_ms)

pub fn credential_port(root: UiRoot, name: String) -> CredentialPort:
    match root:
        UiRoot(_) -> CredentialPort(name)

pub fn credential_get_exchange(root: UiRoot, endpoint: String) -> HostPort(CredentialExchangeRequest, CredentialExchangeOutcome):
    match root:
        UiRoot(_) -> HostPort("credential.get-exchange.v1", endpoint, 61440, 512)

pub fn credential_create_exchange(root: UiRoot, endpoint: String) -> HostPort(CredentialExchangeRequest, CredentialExchangeOutcome):
    match root:
        UiRoot(_) -> HostPort("credential.create-exchange.v1", endpoint, 61440, 512)

pub fn credential_exchange_request(options_json: String) -> CredentialExchangeRequest:
    CredentialExchangeRequest(options_json)

pub fn credential_exchange_status(outcome: CredentialExchangeOutcome) -> Int:
    match outcome:
        CredentialExchangeOutcome(status, _succeeded) -> status

pub fn credential_exchange_succeeded(outcome: CredentialExchangeOutcome) -> Bool:
    match outcome:
        CredentialExchangeOutcome(_status, succeeded) -> succeeded

pub fn secret_field(root: UiRoot, form: String, field: String) -> SecretInput:
    match root:
        UiRoot(_) -> SecretInput(form, field)

// ---------------------------------------------------------------------------
// VNode — the view as data (parameterized over the app's message type `msg`,
// because event handlers carry app-specific messages).
// ---------------------------------------------------------------------------

// A compiler-produced static template plan. `id` is derived from the normalized
// static skeleton and slot layout, while `origin` is diagnostic metadata supplied
// by the tagged-literal expander. Slot values remain in the VNode below during
// Phase 2's JSON reference transport; Phase 3 moves them into compact patch
// buffers without changing this public view contract.
type TemplateSlot:
    TemplateSlot(Int, String, String)

type TemplatePlan:
    TemplatePlan(String, String, List(TemplateSlot))

// A resumable island is generic only while it is checked. The public plan is
// sealed closed data so heterogeneous islands can share one Site registry
// without erasing programs, models, or messages to strings.
type Activation:
    OnLoad
    OnIdle
    OnVisible
    OnMedia(MediaQuery)
    OnInteraction

type Prefetch:
    NoPrefetch
    PrefetchIdle
    PrefetchVisible
    PrefetchMedia(MediaQuery)
    PrefetchIntent

sealed type MediaQuery:
    MediaQuery(String)

sealed type IslandMarkup:
    IslandMarkup(String, String, String, String)

sealed type IslandStart:
    Resumable(String)
    Fresh

sealed type IslandPlan:
    IslandPlan(String, String, Activation, Prefetch, Option(String), IslandStart, IslandMarkup)

sealed type Interactive:
    Interactive(IslandPlan)

sealed type FrameRenderer:
    FrameRenderer(String, Int, Int)

sealed type FrameGrant:
    FrameGrant(String)

type FrameEvent derive(Reflect):
    FrameMessage(String)

// An element with a tag name, attributes, and children, OR a text node. Text is
// ALWAYS a leaf carrying a plain String — there is no `string -> markup` variant,
// so a `${userInput}` routed here (see the `html` tag) can only ever be inert
// text. That is the XSS-immunity-by-construction guarantee, made structural.
type VNode(msg):
    Planned(TemplatePlan, VNode(msg))
    Element(String, List(Attr(msg)), List(VNode(msg)))
    Text(String)
    Compartment(String, String, String)
    FrameCompartment(String, Int, Int, String, String, String, Decoder(msg))
    Keyed(String, VNode(msg))
    Branch(String, Bool, VNode(msg))
    ChildRegion(String, VNode(msg), Option(VNode(msg)))
    SecretField(SecretInput, String)
    Slot(String, String)
    IslandBoundary(IslandMarkup)
    InteractiveBoundary(IslandPlan)

// A minimal keyed-region edit. Keys are compiler-assigned positive integers;
// zero is reserved by RFC-0108 as the append/end sentinel for `before`.
type KeyedEdit:
    RemoveKey(Int)
    InsertKey(Int, Int)
    MoveKey(Int, Int)

type DynamicKeyedEdit:
    RemoveDynamicKey(String)
    InsertDynamicKey(String, String)
    MoveDynamicKey(String, String)

// A browser event is reduced at the host boundary to this allowlisted data.
// No DOM object, target handle, clipboard, file, or ambient browser authority
// can enter a decoder.
type EventData:
    EventData(String, Bool, String)

// Typed effect results. The two Probe variants are compiler/library protocol
// values used only while serializing a completion callback: the host compares
// callback(ProbeA) with callback(ProbeB), proves there is exactly one changing
// result slot, and fills that slot with the real outcome. This keeps function
// values inside Witchy while preserving Cmd.map through the JSON compatibility
// boundary.
type HttpResult:
    HttpProbeA0107
    HttpProbeB0107
    HttpResponse(Int, String)
    HttpFailure(String)

impl Reflect for HttpResult:
    fn reflect(self) -> reflect.Mirror:
        match self:
            HttpProbeA0107 -> reflect.MVariant("HttpResult", "HttpProbeA0107", [])
            HttpProbeB0107 -> reflect.MVariant("HttpResult", "HttpProbeB0107", [])
            HttpResponse(status, body) -> reflect.MVariant("HttpResult", "HttpResponse", [reflect.reflect_one(status), reflect.reflect_one(body)])
            HttpFailure(problem) -> reflect.MVariant("HttpResult", "HttpFailure", [reflect.reflect_one(problem)])

type NavigationResult:
    NavigationProbeA0107
    NavigationProbeB0107
    Navigated(String)
    NavigationFailure(String)

impl Reflect for NavigationResult:
    fn reflect(self) -> reflect.Mirror:
        match self:
            NavigationProbeA0107 -> reflect.MVariant("NavigationResult", "NavigationProbeA0107", [])
            NavigationProbeB0107 -> reflect.MVariant("NavigationResult", "NavigationProbeB0107", [])
            Navigated(path) -> reflect.MVariant("NavigationResult", "Navigated", [reflect.reflect_one(path)])
            NavigationFailure(problem) -> reflect.MVariant("NavigationResult", "NavigationFailure", [reflect.reflect_one(problem)])

type PortResult:
    PortProbeA0107
    PortProbeB0107
    PortResponse(String)
    PortFailure(String)

impl Reflect for PortResult:
    fn reflect(self) -> reflect.Mirror:
        match self:
            PortProbeA0107 -> reflect.MVariant("PortResult", "PortProbeA0107", [])
            PortProbeB0107 -> reflect.MVariant("PortResult", "PortProbeB0107", [])
            PortResponse(value) -> reflect.MVariant("PortResult", "PortResponse", [reflect.reflect_one(value)])
            PortFailure(problem) -> reflect.MVariant("PortResult", "PortFailure", [reflect.reflect_one(problem)])

type StorageResult:
    StorageMissing
    StorageValue(String)
    StorageStored
    StorageRemoved
    StorageFailure(String)

impl Reflect for StorageResult:
    fn reflect(self) -> reflect.Mirror:
        match self:
            StorageMissing -> reflect.MVariant("StorageResult", "StorageMissing", [])
            StorageValue(value) -> reflect.MVariant("StorageResult", "StorageValue", [reflect.reflect_one(value)])
            StorageStored -> reflect.MVariant("StorageResult", "StorageStored", [])
            StorageRemoved -> reflect.MVariant("StorageResult", "StorageRemoved", [])
            StorageFailure(problem) -> reflect.MVariant("StorageResult", "StorageFailure", [reflect.reflect_one(problem)])

// Declarative typed event decoding. IDs are stable within an application
// build; the JSON compatibility host sends only the ID and allowlisted fields
// back to `program_step_with`, which recreates the old view and runs the typed
// decoder in Witchy.
type Decoder(msg):
    Emit(msg)
    Value(fn(String) -> msg)
    Checked(fn(Bool) -> msg)
    Key(fn(String) -> msg)
    FilterKey(String, Decoder(msg))
    PreventDefault(Decoder(msg))
    StopPropagation(Decoder(msg))

impl Decoder(msg):
    pub fn map(self, f: fn(msg) -> outer) -> Decoder(outer):
        match self:
            Emit(message) -> Emit(f(message))
            Value(to_message) -> Value(fn(value: String): f(to_message(value)))
            Checked(to_message) -> Checked(fn(checked: Bool): f(to_message(checked)))
            Key(to_message) -> Key(fn(key: String): f(to_message(key)))
            FilterKey(expected, decoder) -> FilterKey(expected, decoder.map(f))
            PreventDefault(decoder) -> PreventDefault(decoder.map(f))
            StopPropagation(decoder) -> StopPropagation(decoder.map(f))

pub fn event_msg(message: msg) -> Decoder(msg):
    Emit(message)

pub fn event_value(to_message: fn(String) -> msg) -> Decoder(msg):
    Value(to_message)

pub fn event_checked(to_message: fn(Bool) -> msg) -> Decoder(msg):
    Checked(to_message)

pub fn event_key(to_message: fn(String) -> msg) -> Decoder(msg):
    Key(to_message)

pub fn event_key_is(key: String, decoder: Decoder(msg)) -> Decoder(msg):
    FilterKey(key, decoder)

pub fn prevent_default(decoder: Decoder(msg)) -> Decoder(msg):
    PreventDefault(decoder)

pub fn stop_propagation(decoder: Decoder(msg)) -> Decoder(msg):
    StopPropagation(decoder)

// An isolated FOREIGN-CODE compartment (RFC-0015): `renderer` names a sealed bundle
// the host shell loads into a locked-down iframe (opaque origin, `connect-src 'none'`);
// `grant` is the ONLY data that crosses in (a JSON string); `on_event` is the msg-tag
// the narrow channel may send back. The witchy rune holds no authority over it — the
// capability model expressed at the browser boundary.

// A child with a STABLE KEY (RFC-0015): in a list, the host diffs by key instead of
// by position, so reordering/inserting/removing items reuses the matching DOM node
// (preserving its identity — and an `<input>`'s focus/caret) instead of rebuilding.

// (RFC-0039) A host-owned SECRET input field. `SecretInput` is the unforgeable
// authority to render it, and NAMES the host slot (`form`/`field`); the second field
// is the msg-tag the shell dispatches — carrying only a NON-sensitive status
// ("Empty"/"NonEmpty") — when the field changes. The typed value stays in host
// custody: it NEVER crosses into the rune as a msg or model String, so a sibling
// component cannot observe another component's password. To act on the value, the
// rune passes an opaque `SecretRef` to `submit_secret` — it holds the handle, never
// the bytes.

// (RFC-0041) A HOST SLOT: a subtree the host renders ONCE via a registered renderer named
// `kind`, and that glamour NEVER diffs into — the framework-owns-the-DOM escape hatch for a
// host-managed widget (e.g. a runnable code cell). `data` is the payload the renderer
// receives (for `"witchy-runnable"`, the cell's source). Unlike `Compartment` this is NOT a
// sandboxed iframe — the host mounts it in the MAIN frame; the rune only names the slot and
// supplies its data, while what goes inside is entirely the host's (see `glamour-dom.mjs`).

// A DOM property/attribute (`class="card"`, `href=…`), OR an event→msg binding.
// `On` carries a `msg` VALUE, not a closure — the whole MVU model: events are
// DATA the shell hands back to `update`, never live handlers wired into the view.
type Attr(msg):
    Attribute(String, String)
    BooleanAttribute(String, Bool)
    Property(String, String)
    UrlAttribute(String, String)
    ClassAttribute(List(String))
    AriaAttribute(String, String)
    CustomProperties(List(CssAssignment))
    Prop(String, String)
    On(String, msg)
    OnInput(String, String)
    OnDecoded(String, String, Decoder(msg))

// An input-VALUE handler: on `event`, the shell dispatches the 1-arg msg variant named
// `tag` carrying the target's current value — the forms/controlled-input path the
// fixed-msg `On` can't express (a keystroke's text isn't known at view time). The value
// is delivered as data into `update`, so the rune still performs no DOM reads.

// ---- constructors / helpers (the names the `html` tag emits) ----
// The typed `html` tag gives these calls definition-site identity, so a consumer's
// `let text = …` cannot shadow the emitted `text` constructor (RFC-0006/RFC-0080
// hygiene). The hole values are spliced as
// already-parsed AST at the tag's markers (see the `html` tag below), so a hole
// expression resolves at the CALL site — the other half of the hygiene split.
pub fn element(tag: String, attrs: List(Attr(msg)), children: List(VNode(msg))) -> VNode(msg):
    Element(tag, attrs, children)

pub fn text(s: String) -> VNode(msg):
    Text(s)

// Constructor used by the checked `html`/`jsx` tags. It is public only because
// definition-site hygienic generated code resolves through the module boundary;
// ordinary application code should author plans through tagged literals.
pub fn planned(id: String, origin: String, slots: List(TemplateSlot), node: VNode(msg)) -> VNode(msg):
    Planned(TemplatePlan(id, origin, slots), node)

pub fn template_slot(index: Int, kind: String, name: String) -> TemplateSlot:
    TemplateSlot(index, kind, name)

pub fn template_id(node: VNode(msg)) -> Option(String):
    match node:
        Planned(plan, _inner) ->
            match plan:
                TemplatePlan(id, _origin, _slots) -> Some(id)
        _ -> None

pub fn template_origin(node: VNode(msg)) -> Option(String):
    match node:
        Planned(plan, _inner) ->
            match plan:
                TemplatePlan(_id, origin, _slots) -> Some(origin)
        _ -> None

pub fn template_slots(node: VNode(msg)) -> List(TemplateSlot):
    match node:
        Planned(plan, _inner) ->
            match plan:
                TemplatePlan(_id, _origin, slots) -> slots
        _ -> []

// Embed an isolated foreign-code compartment (RFC-0015). `renderer` is a sealed bundle
// id the host serves under a locked-down origin; `grant` is the JSON-string payload that
// crosses in (the ONLY thing that does); `on_event` is the Reflect variant name the
// compartment's narrow channel may dispatch back. Spawning foreign code is the host's
// `Js` authority — the rune only describes it, exactly like every other effect.
pub fn compartment(renderer: String, grant: String, on_event: String) -> VNode(msg):
    Compartment(renderer, grant, on_event)

// The initial locked renderer registry has one inert document renderer. The
// compiler and publisher authenticate this sealed value and replace its marker
// with one content-addressed opaque-origin frame artifact.
pub fn document_renderer() -> FrameRenderer:
    FrameRenderer("document.v1", 65536, 4096)

pub fn frame_text(value: String) -> FrameGrant:
    FrameGrant(value)

pub fn frame(renderer: FrameRenderer, grant: FrameGrant, fallback: StaticUi, event_id: String, receive: fn(FrameEvent) -> msg) -> VNode(msg):
    match renderer:
        FrameRenderer(name, max_grant_bytes, max_event_bytes) ->
            match grant:
                FrameGrant(data) ->
                    match fallback:
                        StaticUi(node) -> FrameCompartment(name, max_grant_bytes, max_event_bytes, data, to_html(node), event_id, event_value(fn(value: String): receive(FrameMessage(value))))

// Tag a child with a stable key for keyed list reconciliation (see `Keyed`).
pub fn keyed(key: String, node: VNode(msg)) -> VNode(msg):
    Keyed(key, node)

// A stable conditional region for optimized islands. The branch identity is
// authenticated at publication; toggling `active` mounts or removes its
// compiler-owned static template without exposing a DOM construction sink.
pub fn branch(id: String, active: Bool, node: VNode(msg)) -> VNode(msg):
    if !valid_island_key(id):
        fail("glamour branch: id must begin with an ASCII letter and contain only letters, digits, `-`, or `_`")
    Branch(id, active, node)

// A stable optional child plan. `template` authenticates the dormant structure
// even when `child` is `None`; `Some(node)` supplies the current slot values.
// The empty region never invents a placeholder DOM element.
pub fn optional_child(id: String, template: VNode(msg), child: Option(VNode(msg))) -> VNode(msg):
    if !valid_island_key(id):
        fail("glamour optional child: id must begin with an ASCII letter and contain only letters, digits, `-`, or `_`")
    ChildRegion(id, template, child)

// Compute a minimum-move keyed reconciliation plan. Retained keys are mapped to
// their old positions, then an O(n log n) longest-increasing-subsequence pass
// identifies the keys already in relative order. Traversing the target order
// right-to-left makes every `before` key live when an insert/move is applied.
// Duplicate or non-positive keys are rejected before producing any edit.
pub fn keyed_plan(old_keys: List(Int), new_keys: List(Int)) -> Result(List(KeyedEdit), String):
    var old_positions: Dict(Int, Int) = dict.new()
    var new_members: Dict(Int, Bool) = dict.new()
    var old_index = 0
    for key in old_keys:
        if key <= 0:
            return Err("glamour keyed plan: keys must be positive")
        if old_positions.contains_key(key):
            return Err("glamour keyed plan: duplicate old key ${key}")
        old_positions.insert(key, old_index)
        old_index = old_index + 1

    for key in new_keys:
        if key <= 0:
            return Err("glamour keyed plan: keys must be positive")
        if new_members.contains_key(key):
            return Err("glamour keyed plan: duplicate new key ${key}")
        new_members.insert(key, true)

    var retained_keys: List(Int) = []
    var retained_positions: List(Int) = []
    var retained_indices: Dict(Int, Int) = dict.new()
    for key in new_keys:
        if old_positions.contains_key(key):
            retained_indices.insert(key, retained_keys.length())
            retained_keys.push(key)
            retained_positions.push(old_positions.at(key))

    // `tails_values[length - 1]` is the smallest old position ending an
    // increasing subsequence of `length`; `tails_indices` and `predecessors`
    // retain enough identity to reconstruct one concrete LIS.
    var tails_values: List(Int) = []
    var tails_indices: List(Int) = []
    var predecessors: List(Int) = []
    var retained_index = 0
    for position in retained_positions:
        var low = 0
        var high = tails_values.length()
        while low < high:
            let middle = low + (high - low) / 2
            if tails_values.at(middle) < position:
                low = middle + 1
            else:
                high = middle
        let predecessor = if low > 0: tails_indices.at(low - 1) else: -1
        predecessors.push(predecessor)
        if low == tails_values.length():
            tails_values.push(position)
            tails_indices.push(retained_index)
        else:
            tails_values.set_at(low, position)
            tails_indices.set_at(low, retained_index)
        retained_index = retained_index + 1

    var stable_indices: Dict(Int, Bool) = dict.new()
    if tails_indices.length() > 0:
        var cursor = tails_indices.at(tails_indices.length() - 1)
        while cursor >= 0:
            stable_indices.insert(cursor, true)
            cursor = predecessors.at(cursor)

    var edits: List(KeyedEdit) = []
    for key in old_keys:
        if !new_members.contains_key(key):
            edits.push(RemoveKey(key))

    var target_index = new_keys.length() - 1
    while target_index >= 0:
        let key = new_keys.at(target_index)
        let before = if target_index + 1 < new_keys.length(): new_keys.at(target_index + 1) else: 0
        if !old_positions.contains_key(key):
            edits.push(InsertKey(key, before))
        else:
            let index = retained_indices.at(key)
            if !stable_indices.contains_key(index):
                edits.push(MoveKey(key, before))
        target_index = target_index - 1
    Ok(edits)

fn dynamic_keyed_plan(old_keys: List(String), new_keys: List(String)) -> Result(List(DynamicKeyedEdit), String):
    var identities: Dict(String, Int) = dict.new()
    var sources: List(String) = []
    for key in old_keys:
        if key.is_empty() || bytes.from_string(key).length() > 1024:
            return Err("glamour keyed plan: dynamic keys must contain 1 to 1024 UTF-8 bytes")
        if !identities.contains_key(key):
            sources.push(key)
            let _previous = identities.insert(key, sources.length())
    for key in new_keys:
        if key.is_empty() || bytes.from_string(key).length() > 1024:
            return Err("glamour keyed plan: dynamic keys must contain 1 to 1024 UTF-8 bytes")
        if !identities.contains_key(key):
            sources.push(key)
            let _previous = identities.insert(key, sources.length())

    var old_ids: List(Int) = []
    for key in old_keys:
        old_ids.push(identities.at(key))
    var new_ids: List(Int) = []
    for key in new_keys:
        new_ids.push(identities.at(key))
    match keyed_plan(old_ids, new_ids):
        Err(problem) -> Err(problem)
        Ok(edits) ->
            var dynamic: List(DynamicKeyedEdit) = []
            for edit in edits:
                match edit:
                    RemoveKey(key) -> dynamic.push(RemoveDynamicKey(sources.at(key - 1)))
                    InsertKey(key, before) -> dynamic.push(InsertDynamicKey(sources.at(key - 1), if before == 0: "" else: sources.at(before - 1)))
                    MoveKey(key, before) -> dynamic.push(MoveDynamicKey(sources.at(key - 1), if before == 0: "" else: sources.at(before - 1)))

            Ok(dynamic)

// (RFC-0041) Emit a host slot: the host's `kind` renderer mounts a widget here (in the main
// frame) and glamour never diffs into it. `data` is the payload (e.g. a runnable cell's
// source). The rune stays pure — it only names the slot; the host owns the widget.
pub fn slot(kind: String, data: String) -> VNode(msg):
    Slot(kind, data)

// (RFC-0039) Render a host-owned secret input. Requires a `SecretInput` token (minted by
// `secret_field`), so a component without one cannot even put a password field on screen.
// `on_ready` is the msg-tag the shell dispatches — carrying only a non-sensitive status —
// when the field changes. The typed value stays in host custody; to act on it, hand
// `secret_ref(input)` to `submit_secret`.
pub fn secret_input(input: SecretInput, on_ready: String) -> VNode(msg):
    SecretField(input, on_ready)

pub fn prop(name: String, value: String) -> Attr(msg):
    Prop(name, value)

// Preferred typed sinks. The generic `prop` constructor remains an explicit
// compatibility escape hatch; checked templates emit these variants instead.
pub fn attribute(name: String, value: String) -> Attr(msg):
    Attribute(name, value)

pub fn boolean_attribute(name: String, enabled: Bool) -> Attr(msg):
    BooleanAttribute(name, enabled)

pub fn property(name: String, value: String) -> Attr(msg):
    Property(name, value)

type NavigationUrl:
    NavigationUrl

type AssetUrl:
    AssetUrl

type FormUrl:
    FormUrl

type SafeUrl(kind):
    SafeUrl(String)

type UrlError:
    UnsafeUrl(String)

type ClassList:
    ClassList(List(String))

pub fn classes(names: List(String)) -> ClassList:
    ClassList(names.filter(fn(name: String): valid_class_token(name)))

pub fn navigation_url(value: String) -> Result(SafeUrl(NavigationUrl), UrlError):
    match safe_navigation_url(value):
        Ok(normalized) -> Ok(SafeUrl(normalized))
        Err(error) -> Err(error)

pub fn asset_url(value: String) -> Result(SafeUrl(AssetUrl), UrlError):
    match safe_asset_url(value):
        Ok(normalized) -> Ok(SafeUrl(normalized))
        Err(error) -> Err(error)

pub fn form_url(value: String) -> Result(SafeUrl(FormUrl), UrlError):
    match safe_form_url(value):
        Ok(normalized) -> Ok(SafeUrl(normalized))
        Err(error) -> Err(error)

pub fn navigation_url_or_root(value: String) -> SafeUrl(NavigationUrl):
    navigation_url(value).unwrap_or(SafeUrl("#"))

pub fn asset_url_or_empty(value: String) -> SafeUrl(AssetUrl):
    asset_url(value).unwrap_or(SafeUrl("#"))

pub fn form_url_or_root(value: String) -> SafeUrl(FormUrl):
    form_url(value).unwrap_or(SafeUrl("#"))

pub fn safe_url_string(value: SafeUrl(kind)) -> String:
    match value:
        SafeUrl(url) -> url

pub fn navigation_url_attribute(name: String, value: SafeUrl(NavigationUrl)) -> Attr(msg):
    match value:
        SafeUrl(url) -> UrlAttribute(name, url)

pub fn asset_url_attribute(name: String, value: SafeUrl(AssetUrl)) -> Attr(msg):
    match value:
        SafeUrl(url) -> UrlAttribute(name, url)

pub fn form_url_attribute(name: String, value: SafeUrl(FormUrl)) -> Attr(msg):
    match value:
        SafeUrl(url) -> UrlAttribute(name, url)

pub fn static_url_attribute(name: String, value: String) -> Attr(msg):
    match safe_navigation_url(value):
        Ok(url) -> UrlAttribute(name, url)
        Err(_) -> UrlAttribute(name, "#")

pub fn static_asset_url_attribute(name: String, value: String) -> Attr(msg):
    match safe_asset_url(value):
        Ok(url) -> UrlAttribute(name, url)
        Err(_) -> UrlAttribute(name, "#")

pub fn static_form_url_attribute(name: String, value: String) -> Attr(msg):
    match safe_form_url(value):
        Ok(url) -> UrlAttribute(name, url)
        Err(_) -> UrlAttribute(name, "#")

pub fn class_attribute(names: ClassList) -> Attr(msg):
    match names:
        ClassList(tokens) -> ClassAttribute(tokens)

pub fn static_class_attribute(names: List(String)) -> Attr(msg):
    ClassAttribute(names.filter(fn(name: String): valid_class_token(name)))

pub fn aria_attribute(name: String, value: String) -> Attr(msg):
    AriaAttribute(name, value)

// Compile-time CSS asset. Application data cannot become CSS syntax; the only
// hole admitted in this slice is a sealed, canonical local asset URL in an
// image-valued declaration. The tag scopes every selector to its immutable
// sheet ID, records declared class handles, and exposes deterministic extracted
// text to the web build.
type CssSheet:
    CssSheet(String, String, String, String, List(String))

type CssClass:
    CssClass(String, String)

sealed type CssImage:
    CssImage(String)

type CssColorKind:
    CssColorKind

type CssLengthKind:
    CssLengthKind

type CssNumberKind:
    CssNumberKind

type CssPercentageKind:
    CssPercentageKind

type CssAngleKind:
    CssAngleKind

type CssTimeKind:
    CssTimeKind

sealed type CssValue(kind):
    CssValue(String, String)

sealed type CssProperty(kind):
    CssProperty(String, String)

sealed type CssAssignment:
    CssAssignment(String, String, String)

type CssError:
    UnknownCssClass(String)
    UnsafeCssAsset(String)
    InvalidCssProperty(String)
    InvalidCssValue(String)

pub fn css_sheet_id(sheet: CssSheet) -> String:
    match sheet:
        CssSheet(id, _scope, _origin, _text, _classes) -> id

pub fn css_text(sheet: CssSheet) -> String:
    match sheet:
        CssSheet(_id, _scope, _origin, text, _classes) -> text

pub fn css_origin(sheet: CssSheet) -> String:
    match sheet:
        CssSheet(_id, _scope, origin, _text, _classes) -> origin

pub fn css_class(sheet: CssSheet, name: String) -> Result(CssClass, CssError):
    match sheet:
        CssSheet(id, _scope, _origin, _text, declared) ->
            if declared.contains(name):
                Ok(CssClass(id, name))
            else:
                Err(UnknownCssClass(name))

pub fn css_classes(values: List(CssClass)) -> ClassList:
    var names: List(String) = []
    for value in values:
        match value:
            CssClass(_sheet, name) -> names.push(name)

    classes(names)

pub fn css_scope(sheet: CssSheet) -> Attr(msg):
    match sheet:
        CssSheet(_id, scope, _origin, _text, _classes) ->
            if scope == "global":
                fail("glamour css: a global sheet has no element scope")
            Attribute("data-glamour-scope", scope)

pub fn css_sheet(id: String, scope: String, origin: String, text: String, declared: List(String)) -> CssSheet:
    CssSheet(id, scope, origin, text, declared)

pub fn css_asset(asset: SafeUrl(AssetUrl)) -> Result(CssImage, CssError):
    let value = safe_url_string(asset)
    if valid_css_asset_path(value):
        Ok(CssImage("url(\"" + value + "\")"))
    else:
        Err(UnsafeCssAsset(value))

fn css_image_text(value: CssImage) -> String:
    match value:
        CssImage(text) -> text

pub fn css_color(value: String) -> Result(CssValue(CssColorKind), CssError):
    let normalized = value.trim().to_lower()
    if valid_css_color(normalized):
        Ok(CssValue("color", normalized))
    else:
        Err(InvalidCssValue(value))

pub fn css_px(value: Int) -> Result(CssValue(CssLengthKind), CssError):
    if value >= -1000000 && value <= 1000000:
        Ok(CssValue("length", "${value}px"))
    else:
        Err(InvalidCssValue("${value}px"))

pub fn css_rem(value: Int) -> Result(CssValue(CssLengthKind), CssError):
    if value >= -10000 && value <= 10000:
        Ok(CssValue("length", "${value}rem"))
    else:
        Err(InvalidCssValue("${value}rem"))

pub fn css_number(value: Int) -> Result(CssValue(CssNumberKind), CssError):
    if value >= -1000000 && value <= 1000000:
        Ok(CssValue("number", "${value}"))
    else:
        Err(InvalidCssValue("${value}"))

pub fn css_percent(value: Int) -> Result(CssValue(CssPercentageKind), CssError):
    if value >= -100000 && value <= 100000:
        Ok(CssValue("percentage", "${value}%"))
    else:
        Err(InvalidCssValue("${value}%"))

pub fn css_deg(value: Int) -> Result(CssValue(CssAngleKind), CssError):
    if value >= -360000 && value <= 360000:
        Ok(CssValue("angle", "${value}deg"))
    else:
        Err(InvalidCssValue("${value}deg"))

pub fn css_ms(value: Int) -> Result(CssValue(CssTimeKind), CssError):
    if value >= -3600000 && value <= 3600000:
        Ok(CssValue("time", "${value}ms"))
    else:
        Err(InvalidCssValue("${value}ms"))

pub fn css_color_property(name: String) -> Result(CssProperty(CssColorKind), CssError):
    match css_property_name(name):
        Ok(value) -> Ok(CssProperty("color", value))
        Err(error) -> Err(error)

pub fn css_length_property(name: String) -> Result(CssProperty(CssLengthKind), CssError):
    match css_property_name(name):
        Ok(value) -> Ok(CssProperty("length", value))
        Err(error) -> Err(error)

pub fn css_number_property(name: String) -> Result(CssProperty(CssNumberKind), CssError):
    match css_property_name(name):
        Ok(value) -> Ok(CssProperty("number", value))
        Err(error) -> Err(error)

pub fn css_percentage_property(name: String) -> Result(CssProperty(CssPercentageKind), CssError):
    match css_property_name(name):
        Ok(value) -> Ok(CssProperty("percentage", value))
        Err(error) -> Err(error)

pub fn css_angle_property(name: String) -> Result(CssProperty(CssAngleKind), CssError):
    match css_property_name(name):
        Ok(value) -> Ok(CssProperty("angle", value))
        Err(error) -> Err(error)

pub fn css_time_property(name: String) -> Result(CssProperty(CssTimeKind), CssError):
    match css_property_name(name):
        Ok(value) -> Ok(CssProperty("time", value))
        Err(error) -> Err(error)

pub fn css_var(property: CssProperty(kind)) -> CssValue(kind):
    match property:
        CssProperty(category, name) -> CssValue(category, "var(" + name + ")")

pub fn css_assign(property: CssProperty(kind), value: CssValue(kind)) -> CssAssignment:
    match property:
        CssProperty(property_category, name) ->
            match value:
                CssValue(value_category, text) ->
                    if property_category != value_category:
                        fail("glamour css: custom-property category changed")
                    CssAssignment(name, property_category, text)

pub fn css_custom_properties(assignments: List(CssAssignment)) -> Attr(msg):
    var names: List(String) = []
    for assignment in assignments:
        match assignment:
            CssAssignment(name, _category, _value) ->
                if names.contains(name):
                    fail("glamour css: custom properties must be unique on one element")
                names.push(name)

    CustomProperties(assignments)

fn css_assignment_text(assignments: List(CssAssignment)) -> String:
    var declarations: List(String) = []
    for assignment in assignments:
        match assignment:
            CssAssignment(name, _category, value) -> declarations.push(name + ":" + value)

    declarations.join(";")

fn css_color_text(value: CssValue(CssColorKind)) -> String:
    match value:
        CssValue(_category, text) -> text

fn css_length_text(value: CssValue(CssLengthKind)) -> String:
    match value:
        CssValue(_category, text) -> text

fn css_number_text(value: CssValue(CssNumberKind)) -> String:
    match value:
        CssValue(_category, text) -> text

fn css_percentage_text(value: CssValue(CssPercentageKind)) -> String:
    match value:
        CssValue(_category, text) -> text

fn css_angle_text(value: CssValue(CssAngleKind)) -> String:
    match value:
        CssValue(_category, text) -> text

fn css_time_text(value: CssValue(CssTimeKind)) -> String:
    match value:
        CssValue(_category, text) -> text

fn css_property_name(name: String) -> Result(String, CssError):
    if meta.is_identifier(name) && name.char_count() <= 64:
        Ok("--glamour-" + name)
    else:
        Err(InvalidCssProperty(name))

fn valid_css_color(value: String) -> Bool:
    if value == "transparent" || value == "currentcolor" || value == "black" || value == "white" || value == "red" || value == "green" || value == "blue" || value == "rebeccapurple":
        true
    else if value.starts_with("#") && (value.char_count() == 4 || value.char_count() == 5 || value.char_count() == 7 || value.char_count() == 9):
        for character in value.substring(1, value.char_count()).chars():
            if !"0123456789abcdef".contains(character):
                return false
        true
    else:
        false

// Public only as the hygienic target of the `css` tagged-literal expansion.
// Publication independently authenticates the resulting sheet.
pub fn css_sheet_from_source(source: String, origin: String) -> CssSheet:
    let _safe = validate_css(source)
    let source_digest = crypto.sha256(source)
    let scope = source_digest.take(12)
    let declared = css_class_names(source)
    let scoped = scope_css(source, scope)
    let digest = crypto.sha256(scope + "|" + scoped + "|" + declared.join("|"))
    CssSheet("glamour-css1-" + digest, scope, origin, scoped, declared)

// Global rules are deliberately separate from ordinary scoped CSS. Their
// compiler origin and route attachment remain part of the production manifest
// and build report, so an unscoped rule always has a named owner.
pub fn global_css_sheet_from_source(source: String, origin: String) -> CssSheet:
    let _safe = validate_css(source)
    let declared = css_class_names(source)
    let global = normalize_global_css(source)
    let digest = crypto.sha256("global|" + global + "|" + declared.join("|"))
    CssSheet("glamour-css1-" + digest, "global", origin, global, declared)

// ---------------------------------------------------------------------------
// Typed routes. Patterns are parsed once into a closed graph; route identities
// depend only on normalized patterns. Dynamic segments are URL-encoded by the
// builder, and matching returns typed IDs plus named values rather than asking
// components to parse location strings.
// ---------------------------------------------------------------------------
type RouteId:
    RouteId(String)

type RouteDef:
    RouteDef(RouteId, String, List(String))

type RouteGraph:
    RouteGraph(List(RouteDef))

type RouteMatch:
    RouteMatch(RouteId, List((String, String)))

type RouteError:
    InvalidRoutePattern(String)
    DuplicateRoutePattern(String)
    MissingRouteParameter(String)
    UnexpectedRouteParameter(String)

pub fn route(pattern: String) -> Result(RouteDef, RouteError):
    let normalized = normalize_route_pattern(pattern)
    if !valid_route_pattern(normalized):
        Err(InvalidRoutePattern(pattern))
    else:
        Ok(RouteDef(RouteId("glamour-route1-" + crypto.sha256(normalized)), normalized, route_parameter_names(normalized)))

pub fn route_graph(routes: List(RouteDef)) -> Result(RouteGraph, RouteError):
    var patterns: List(String) = []
    for item in routes:
        match item:
            RouteDef(_id, pattern, _parameters) ->
                if patterns.contains(pattern):
                    return Err(DuplicateRoutePattern(pattern))
                patterns.push(pattern)
    Ok(RouteGraph(routes))

pub fn route_id(route: RouteDef) -> RouteId:
    match route:
        RouteDef(id, _pattern, _parameters) -> id

pub fn route_pattern(route: RouteDef) -> String:
    match route:
        RouteDef(_id, pattern, _parameters) -> pattern

pub fn route_id_string(id: RouteId) -> String:
    match id:
        RouteId(value) -> value

pub fn route_match_id(found: RouteMatch) -> RouteId:
    match found:
        RouteMatch(id, _values) -> id

pub fn route_match_parameter(found: RouteMatch, name: String) -> Option(String):
    match found:
        RouteMatch(_id, values) -> parameter_value(values, name)

pub fn static_route_paths(graph: RouteGraph) -> List(String):
    match graph:
        RouteGraph(routes) ->
            var paths: List(String) = []
            for item in routes:
                match item:
                    RouteDef(_id, pattern, parameters) ->
                        if parameters.is_empty():
                            paths.push(pattern)
            paths

pub fn match_route(graph: RouteGraph, path: String) -> Option(RouteMatch):
    match graph:
        RouteGraph(routes) ->
            var found: Option(RouteMatch) = None
            for item in routes:
                match found:
                    Some(_) -> Nil
                    None -> found = match_route_def(item, normalize_route_path(path))
            found

pub fn route_url(route: RouteDef, values: List((String, String))) -> Result(SafeUrl(NavigationUrl), RouteError):
    match route:
        RouteDef(_id, pattern, parameters) ->
            for parameter in parameters:
                if parameter_value(values, parameter).is_none():
                    return Err(MissingRouteParameter(parameter))
            for pair in values:
                let (name, _value) = pair
                if !parameters.contains(name):
                    return Err(UnexpectedRouteParameter(name))
            let pattern_segments = pattern.split("/")
            var built: List(String) = []
            for segment in pattern_segments:
                if segment.starts_with("*"):
                    let name = segment.drop(1)
                    let value = parameter_value(values, name) ?? ""
                    built.push(value.split("/").map(url.encode).join("/"))
                else if segment.starts_with(":"):
                    let name = segment.drop(1)
                    let value = parameter_value(values, name) ?? ""
                    built.push(url.encode(value))
                else:
                    built.push(segment)
            match navigation_url(built.join("/")):
                Ok(destination) -> Ok(destination)
                Err(_) -> Err(InvalidRoutePattern(pattern))

pub fn navigate_route(id: String, authority: UiRoute, route: RouteDef, values: List((String, String)), on_done: fn(NavigationResult) -> msg) -> Cmd(msg):
    match route_url(route, values):
        Ok(destination) ->
            match destination:
                SafeUrl(path) -> navigate(id, authority, path, on_done)
        Err(_error) -> NoCmd

pub fn route_error_message(error: RouteError) -> String:
    match error:
        InvalidRoutePattern(pattern) -> "invalid route pattern `${pattern}`"
        DuplicateRoutePattern(pattern) -> "duplicate route pattern `${pattern}`"
        MissingRouteParameter(name) -> "missing route parameter `${name}`"
        UnexpectedRouteParameter(name) -> "unexpected route parameter `${name}`"

fn normalize_route_pattern(pattern: String) -> String:
    let trimmed = pattern.trim()
    if trimmed == "/":
        "/"
    else:
        "/" + trimmed.split("/").filter(fn(segment: String): !segment.is_empty()).join("/")

fn normalize_route_path(path: String) -> String:
    let without_query = path.split("?").at(0).split("#").at(0)
    normalize_route_pattern(without_query)

fn valid_route_pattern(pattern: String) -> Bool:
    if !pattern.starts_with("/") || pattern.contains("?") || pattern.contains("#") || pattern.contains("\\"):
        false
    else:
        let segments = pattern.split("/")
        var names: List(String) = []
        var valid = true
        var i = 0
        let count = segments.length()
        for segment in segments:
            if segment.starts_with(":") || segment.starts_with("*"):
                let name = segment.drop(1)
                if !meta.is_identifier(name) || names.contains(name):
                    valid = false
                if segment.starts_with("*") && i != count - 1:
                    valid = false
                names.push(name)
            else if segment.contains(":") || segment.contains("*"):
                valid = false
            i = i + 1
        valid

fn route_parameter_names(pattern: String) -> List(String):
    var names: List(String) = []
    for segment in pattern.split("/"):
        if segment.starts_with(":") || segment.starts_with("*"):
            names.push(segment.drop(1))
    names

fn match_route_def(route: RouteDef, path: String) -> Option(RouteMatch):
    match route:
        RouteDef(id, pattern, _parameters) ->
            let expected = pattern.split("/")
            let actual = path.split("/")
            var values: List((String, String)) = []
            var valid = true
            var i = 0
            var wildcard = false
            while i < expected.length() && valid:
                let wanted = expected.at(i)
                if wanted.starts_with("*"):
                    values.push((wanted.drop(1), actual.drop(i).join("/")))
                    wildcard = true
                    i = expected.length()
                else if i >= actual.length():
                    valid = false
                else if wanted.starts_with(":"):
                    values.push((wanted.drop(1), actual.at(i)))
                    i = i + 1
                else if wanted == actual.at(i):
                    i = i + 1
                else:
                    valid = false
            if valid && (wildcard || i == actual.length()):
                Some(RouteMatch(id, values))
            else:
                None

fn parameter_value(values: List((String, String)), name: String) -> Option(String):
    var found: Option(String) = None
    for pair in values:
        let (candidate, value) = pair
        if candidate == name:
            found = Some(value)
    found

// ---------------------------------------------------------------------------
// Progressive forms. A schema owns method/action/field facts used by both the
// interactive Program and static HTML. Secret fields name host-custodied controls
// and never place their bytes in FormValue or the application model.
// ---------------------------------------------------------------------------
type FormFieldKind:
    FormText
    FormEmail
    FormNumber
    FormCheckbox
    FormSecret

type FormField:
    FormField(String, String, FormFieldKind, Bool)

type FormSchema:
    FormSchema(String, String, SafeUrl(FormUrl), List(FormField))

type FormValue:
    FormValue(String, String)

sealed type ServerSecretValue:
    ServerSecretValue(String, String)

sealed type FormSubmission:
    FormSubmission(List(FormValue), List(ServerSecretValue))

// Protocol-1.4 action messages. Public form values are reconstructed according
// to their declared field kind; secret fields have no variant and cannot enter
// the application model through this boundary.
type ClientActionValue:
    ClientActionText(String, String)
    ClientActionEmail(String, String)
    ClientActionNumber(String, String)
    ClientActionCheckbox(String, Option(Bool))

type ClientActionStatus:
    ClientActionSucceeded
    ClientActionValidationFailed
    ClientActionServerFailed
    ClientActionNetworkFailed
    ClientActionCancelled
    ClientActionInvalidSubmission

type ClientActionFrame:
    ClientActionInput(Int, List(ClientActionValue))
    ClientActionCompletion(Int, ClientActionStatus, Int)

type FormProblem:
    InvalidFormName(String)
    SecretFormRequiresPost(String)
    DuplicateFormField(String)
    DuplicateSubmittedField(String)
    UnexpectedFormField(String)
    MissingFormField(String)
    InvalidFormField(String)

pub fn form_field(name: String, label: String, kind: FormFieldKind, required: Bool) -> FormField:
    FormField(name, label, kind, required)

pub fn form_schema(name: String, method: String, action: SafeUrl(FormUrl), fields: List(FormField)) -> Result(FormSchema, FormProblem):
    if !meta.is_identifier(name):
        Err(InvalidFormName(name))
    else:
        let normalized_method = method.to_upper()
        if normalized_method != "GET" && normalized_method != "POST":
            return Err(InvalidFormName("unsupported form method `${method}`"))
        var names: List(String) = []
        for field in fields:
            match field:
                FormField(field_name, _label, kind, _required) ->
                    if !meta.is_identifier(field_name) || names.contains(field_name):
                        return Err(DuplicateFormField(field_name))
                    if normalized_method == "GET" && kind == FormSecret:
                        return Err(SecretFormRequiresPost(field_name))
                    names.push(field_name)
        Ok(FormSchema("glamour-form1-" + crypto.sha256(name + "|" + normalized_method + "|" + names.join(",")), normalized_method, action, fields))

pub fn form_attributes(schema: FormSchema) -> List(Attr(msg)):
    match schema:
        FormSchema(id, method, action, _fields) ->
            [attribute("data-glamour-form", id), attribute("method", method), form_url_attribute("action", action)]

pub fn validate_form(schema: FormSchema, values: List(FormValue)) -> List(FormProblem):
    match schema:
        FormSchema(_id, _method, _action, fields) ->
            var problems: List(FormProblem) = []
            for field in fields:
                match field:
                    FormField(name, _label, kind, required) ->
                        let value = form_value(values, name) ?? ""
                        if required && value.trim().is_empty():
                            problems.push(MissingFormField(name))
                        else if !value.is_empty() && !valid_form_value(kind, value):
                            problems.push(InvalidFormField(name))
            problems

// Shared browser/server submission decoder. Raw entries are checked against the
// same FormSchema that produced the DOM and static action manifest. Secret
// values are separated from ordinary model-safe values before application code
// receives the submission.
pub fn decode_form_entries(schema: FormSchema, entries: List((String, String))) -> Result(FormSubmission, List(FormProblem)):
    match schema:
        FormSchema(_id, _method, _action, fields) ->
            var public_values: List(FormValue) = []
            var secret_values: List(ServerSecretValue) = []
            var problems: List(FormProblem) = []
            var seen: List(String) = []
            for entry in entries:
                let (name, value) = entry
                if seen.contains(name):
                    problems.push(DuplicateSubmittedField(name))
                else:
                    seen.push(name)
                    match declared_form_field(fields, name):
                        None -> problems.push(UnexpectedFormField(name))
                        Some(FormField(_field_name, _label, kind, required)) ->
                            if required && value.trim().is_empty():
                                problems.push(MissingFormField(name))
                            else if !value.is_empty() && !valid_form_value(kind, value):
                                problems.push(InvalidFormField(name))
                            else:
                                match kind:
                                    FormSecret -> secret_values.push(ServerSecretValue(name, value))
                                    _ -> public_values.push(FormValue(name, value))

            for field in fields:
                match field:
                    FormField(name, _label, _kind, required) ->
                        if required && !seen.contains(name):
                            problems.push(MissingFormField(name))
            if problems.is_empty():
                Ok(FormSubmission(public_values, secret_values))
            else:
                Err(problems)

pub fn form_schema_method(schema: FormSchema) -> String:
    match schema:
        FormSchema(_id, method, _action, _fields) -> method

pub fn form_schema_action(schema: FormSchema) -> String:
    match schema:
        FormSchema(_id, _method, action, _fields) -> safe_url_string(action)

pub fn form_input_schema(schema: FormSchema) -> Int:
    client_action_schema_identity("witchy.glamour.action-input.v1", schema)

pub fn form_result_schema(schema: FormSchema) -> Int:
    client_action_schema_identity("witchy.glamour.action-result.v1", schema)

fn client_action_schema_identity(domain: String, schema: FormSchema) -> Int:
    let digest = crypto.sha256(domain + "\n" + client_action_schema_material(schema))
    var identity = 0
    for digit in digest.substring(0, 8).chars():
        match "0123456789abcdef".index_of(digit):
            Some(value) -> identity = identity * 16 + value
            None -> fail("glamour action: compiler hash is not hexadecimal")

    if identity == 0:
        1
    else:
        identity

fn client_action_schema_material(schema: FormSchema) -> String:
    match schema:
        FormSchema(id, method, action, fields) ->
            let action_text = safe_url_string(action)
            var material = "${id.length()}:${id}|${method.length()}:${method}|${action_text.length()}:${action_text}|${fields.length()}"
            var ordinal = 0
            for field in fields:
                match field:
                    FormField(name, _label, kind, required) ->
                        let kind_text = static_action_field_kind(kind)
                        let required_text = if required: "1" else: "0"
                        material = material + "|${ordinal}:${name.length()}:${name}:${kind_text.length()}:${kind_text}:${required_text}"
                ordinal = ordinal + 1
            material

pub fn decode_client_action_frame(schema: FormSchema, input: Bytes, app_id: Int, build_low: Int, build_high: Int, sequence: Int) -> ClientActionFrame:
    let length = input.length()
    if length < 72 || input.at(0) != 71 || input.at(1) != 76 || input.at(2) != 77 || input.at(3) != 82:
        fail("glamour action: invalid frame header")
    if client_action_read_u16(input, 4) != 1 || client_action_read_u16(input, 6) != 4 || input.at(9) != 0 || client_action_read_u16(input, 10) != 48:
        fail("glamour action: unsupported protocol version or flags")
    if client_action_read_u32(input, 12) != length || client_action_read_u32(input, 16) != 1 || client_action_read_u32(input, 20) != app_id:
        fail("glamour action: frame identity is invalid")
    if client_action_read_u32(input, 24) != build_low || client_action_read_u32(input, 28) != build_high || client_action_read_u32(input, 32) != sequence || client_action_read_u32(input, 36) != 0 || client_action_read_u32(input, 44) != 0:
        fail("glamour action: frame build or sequence is invalid")
    if client_action_read_u16(input, 48) != 1 || client_action_read_u16(input, 50) != 0:
        fail("glamour action: frame record is invalid")
    match input.at(8):
        4 -> decode_client_action_input(schema, input)
        5 -> decode_client_action_completion(schema, input)
        _ ->
            fail("glamour action: input has an unsupported frame kind")
            ClientActionInput(0, [])

fn decode_client_action_input(schema: FormSchema, input: Bytes) -> ClientActionFrame:
    let length = input.length()
    let record_length = client_action_read_u32(input, 52)
    let input_schema = client_action_read_u32(input, 56)
    let generation = client_action_read_u32(input, 60)
    let field_count = client_action_read_u32(input, 64)
    if generation == 0 || field_count > 256 || client_action_read_u32(input, 68) != 0 || record_length != 24 + field_count * 16:
        fail("glamour action: input record shape is invalid")
    let record_end = 48 + record_length
    let payload_start = client_action_read_u32(input, 40)
    if record_end > length || payload_start != 0 && payload_start != record_end:
        fail("glamour action: input payload table is invalid")
    if input_schema != form_input_schema(schema):
        fail("glamour action: input schema does not match its declaration")
    let fields = client_action_fields(schema)
    var values: List(ClientActionValue) = []
    var previous_ordinal = -1
    var payload_cursor = payload_start
    var index = 0
    while index < field_count:
        let cursor = 72 + index * 16
        let ordinal = client_action_read_u16(input, cursor)
        let kind_tag = input.at(cursor + 2)
        let flags = input.at(cursor + 3)
        let value_offset = client_action_read_u32(input, cursor + 4)
        let value_length = client_action_read_u32(input, cursor + 8)
        if cursor + 16 > record_end || ordinal <= previous_ordinal || ordinal >= fields.length() || flags != 0 || client_action_read_u32(input, cursor + 12) != 0:
            fail("glamour action: input field record is invalid")
        if value_offset != payload_cursor || value_offset + value_length > length:
            fail("glamour action: input field payload is invalid")
        if payload_start == 0 && value_length != 0:
            fail("glamour action: non-empty field has no payload table")
        match fields.at(ordinal):
            FormField(name, _label, kind, _required) ->
                if kind == FormSecret || client_action_kind_tag(kind) != kind_tag:
                    fail("glamour action: input field disagrees with its public schema")
                let value = client_action_text(input, value_offset, value_length)
                if !value.is_empty() && !valid_form_value(kind, value):
                    fail("glamour action: input field value is invalid")
                values.push(client_action_value(name, kind, value))
        previous_ordinal = ordinal
        payload_cursor = payload_cursor + value_length
        index = index + 1
    if payload_start == 0:
        if record_end != length || payload_cursor != 0:
            fail("glamour action: empty input payload is not canonical")
    else if payload_cursor != length:
        fail("glamour action: input payload does not consume its frame")
    for field in fields:
        match field:
            FormField(name, _label, kind, required) ->
                if required && kind != FormSecret:
                    match client_action_value_text(values, name):
                        Some(value) -> if value.is_empty(): fail("glamour action: required input field is empty")
                        None -> fail("glamour action: required input field is absent")

    ClientActionInput(generation, values)

fn decode_client_action_completion(schema: FormSchema, input: Bytes) -> ClientActionFrame:
    let result_schema = client_action_read_u32(input, 56)
    let generation = client_action_read_u32(input, 60)
    let status = client_action_read_u32(input, 64)
    let http_status = client_action_read_u32(input, 68)
    if input.length() != 80 || client_action_read_u32(input, 40) != 0 || client_action_read_u32(input, 52) != 32 || generation == 0 || status > 5 || client_action_read_u32(input, 72) != 0 || client_action_read_u32(input, 76) != 0:
        fail("glamour action: completion record is invalid")
    if result_schema != form_result_schema(schema):
        fail("glamour action: result schema does not match its declaration")
    if (status == 0 || status == 2) && (http_status < 100 || http_status > 599):
        fail("glamour action: HTTP completion status is invalid")
    if status != 0 && status != 2 && http_status != 0:
        fail("glamour action: non-HTTP completion carries an HTTP status")
    let result = match status:
        0 -> ClientActionSucceeded
        1 -> ClientActionValidationFailed
        2 -> ClientActionServerFailed
        3 -> ClientActionNetworkFailed
        4 -> ClientActionCancelled
        _ -> ClientActionInvalidSubmission

    ClientActionCompletion(generation, result, http_status)

fn client_action_fields(schema: FormSchema) -> List(FormField):
    match schema:
        FormSchema(_id, _method, _action, fields) -> fields

fn client_action_kind_tag(kind: FormFieldKind) -> Int:
    match kind:
        FormText -> 1
        FormEmail -> 2
        FormNumber -> 3
        FormCheckbox -> 4
        FormSecret -> 0

fn client_action_value(name: String, kind: FormFieldKind, value: String) -> ClientActionValue:
    match kind:
        FormText -> ClientActionText(name, value)
        FormEmail -> ClientActionEmail(name, value)
        FormNumber -> ClientActionNumber(name, value)
        FormCheckbox -> ClientActionCheckbox(name, if value.is_empty(): None else: Some(value == "true" || value == "on"))
        FormSecret ->
            fail("glamour action: secret field entered the public decoder")
            ClientActionText(name, "")

fn client_action_value_text(values: List(ClientActionValue), name: String) -> Option(String):
    for value in values:
        match value:
            ClientActionText(candidate, text) ->
                if candidate == name:
                    return Some(text)
            ClientActionEmail(candidate, text) ->
                if candidate == name:
                    return Some(text)
            ClientActionNumber(candidate, text) ->
                if candidate == name:
                    return Some(text)
            ClientActionCheckbox(candidate, checked) ->
                if candidate == name:
                    match checked:
                        Some(value) -> return Some(if value: "true" else: "false")
                        None -> return Some("")
    None

fn client_action_text(input: Bytes, offset: Int, length: Int) -> String:
    if offset < 0 || length < 0 || offset + length > input.length():
        fail("glamour action: text payload is outside its frame")
    match bytes.slice(input, offset, offset + length).decode_utf8():
        Ok(value) -> value
        Err(_error) ->
            fail("glamour action: text payload is not valid UTF-8")
            ""

fn client_action_read_u16(input: Bytes, offset: Int) -> Int:
    if offset < 0 || input.length() < offset + 2:
        fail("glamour action: truncated input frame")
    input.at(offset) + input.at(offset + 1) * 256

fn client_action_read_u32(input: Bytes, offset: Int) -> Int:
    if offset < 0 || input.length() < offset + 4:
        fail("glamour action: truncated input frame")
    input.at(offset) + input.at(offset + 1) * 256 + input.at(offset + 2) * 65536 + input.at(offset + 3) * 16777216

pub fn form_submission_values(submission: FormSubmission) -> List(FormValue):
    match submission:
        FormSubmission(values, _secrets) -> values

@server
pub fn form_submission_secret(submission: FormSubmission, name: String) -> Option(String):
    match submission:
        FormSubmission(_values, secrets) ->
            for secret in secrets:
                match secret:
                    ServerSecretValue(candidate, value) ->
                        if candidate == name:
                            return Some(value)
            None

pub fn form_secret(schema: FormSchema, name: String, input: SecretInput, on_ready: String) -> Option(VNode(msg)):
    match schema:
        FormSchema(_id, _method, _action, fields) ->
            var allowed = false
            for field in fields:
                match field:
                    FormField(field_name, _label, kind, _required) ->
                        if field_name == name:
                            match kind:
                                FormSecret -> allowed = true
                                _ -> Nil

            if allowed:
                Some(secret_input(input, on_ready))
            else:
                None

pub fn form_problem_message(problem: FormProblem) -> String:
    match problem:
        InvalidFormName(name) -> "invalid form declaration `${name}`"
        SecretFormRequiresPost(name) -> "secret form field `${name}` requires POST"
        DuplicateFormField(name) -> "duplicate form field `${name}`"
        DuplicateSubmittedField(name) -> "duplicate submitted form field `${name}`"
        UnexpectedFormField(name) -> "unexpected submitted form field `${name}`"
        MissingFormField(name) -> "missing required form field `${name}`"
        InvalidFormField(name) -> "invalid value for form field `${name}`"

fn declared_form_field(fields: List(FormField), name: String) -> Option(FormField):
    for field in fields:
        match field:
            FormField(candidate, _label, _kind, _required) ->
                if candidate == name:
                    return Some(field)
    None

fn form_value(values: List(FormValue), name: String) -> Option(String):
    var found: Option(String) = None
    for item in values:
        match item:
            FormValue(candidate, value) ->
                if candidate == name:
                    found = Some(value)
    found

fn valid_form_value(kind: FormFieldKind, value: String) -> Bool:
    match kind:
        FormText -> true
        FormEmail ->
            let pieces = value.split("@")
            pieces.length() == 2 && !pieces.at(0).is_empty() && pieces.at(1).contains(".")
        FormNumber -> numeric_text(value)
        FormCheckbox -> value == "true" || value == "false" || value == "on"
        FormSecret -> true

fn numeric_text(value: String) -> Bool:
    let body: String = if value.starts_with("-"): value.drop(1) else: value
    var valid = !body.is_empty()
    for character in body.chars():
        if !"0123456789".contains(character):
            valid = false
    valid

pub fn on(event: String, msg: msg) -> Attr(msg):
    On(event, msg)

// An input-value handler: on `event` (e.g. "input"), the shell dispatches the 1-arg msg
// variant named `tag` with the field's current value — for search boxes and form fields.
pub fn on_input(event: String, tag: String) -> Attr(msg):
    OnInput(event, tag)

// A typed event binding. `id` is the stable decoder identity and `decoder`
// contains the typed message constructor; neither is executable host code.
pub fn on_event(id: String, event: String, decoder: Decoder(msg)) -> Attr(msg):
    OnDecoded(id, event, decoder)

// Accessible primitives encode the minimum naming relationship in their
// constructors, while the tagged-template checker covers equivalent raw markup.
pub fn button(label: String, message: msg) -> VNode(msg):
    element("button", [attribute("type", "button"), on("click", message)], [text(label)])

pub fn submit_button(label: String, message: msg) -> VNode(msg):
    element("button", [attribute("type", "submit"), on("click", message)], [text(label)])

pub fn decoded_button(label: String, id: String, decoder: Decoder(msg)) -> VNode(msg):
    element("button", [attribute("type", "button"), on_event(id, "click", decoder)], [text(label)])

pub fn image(source: SafeUrl(AssetUrl), alternative: String) -> VNode(msg):
    element("img", [asset_url_attribute("src", source), attribute("alt", alternative)], [])

pub fn labelled_input(id: String, label: String, value: String, decoder_id: String, decoder: Decoder(msg)) -> VNode(msg):
    element("div", [], [element("label", [attribute("for", id)], [text(label)]), element("input", [attribute("id", id), property("value", value), on_event(decoder_id, "input", decoder)], [])])

// ---------------------------------------------------------------------------
// Cmd — effects as data (RFC-0008's "honest hard part"). `update` does not
// PERFORM effects — the rune is capability-denied — it DESCRIBES them: it returns
// a `Cmd(msg)` the capability-HOLDING host shell interprets. The rune decides
// WHAT should happen; the shell, which alone holds the capability, decides
// WHETHER it may and actually does it. This is the purest expression of "authority
// lives at the edge":
//     view:   fn(state) -> VNode(msg)
//     update: fn(state, msg) -> (state, Cmd(msg))
// ---------------------------------------------------------------------------

// `NoCmd` (not `None`) names the empty effect: `None` is already `Option.None`
// from the prelude, so an `update` returning `(model, None)` would be read as an
// `Option`. `NoCmd` is unambiguous and reads as "no command".
//
// `After(timer, ms, msg)` is the canonical Elm timer effect: "after `ms`
// milliseconds, dispatch `msg`". The rune CANNOT perform this — it holds no `Clock`
// capability — so it only DESCRIBES it; the shell holds the timer (`setTimeout`) and
// performs it. (RFC-0039) The leading `UiTimer` is the unforgeable authority to arm
// a timer, confined to `min_ms`; a component without one cannot schedule work.
// `Batch(cmds)` runs several commands; it lets one `update` request more than one
// effect.
//
// Optimized callback environments use one closed recursively copyable value.
// Application source never constructs these values: the checked web compiler
// emits exact typed encoders and decoders for each authenticated work site.
// The environment stays inside Wasm and contains no function, capability,
// descriptor, or host handle.
type IslandCapture derive(Reflect):
    IslandCaptureNil
    IslandCaptureInt(Int)
    IslandCaptureFloat(Float)
    IslandCaptureBool(Bool)
    IslandCaptureString(String)
    IslandCaptureBytes(Bytes)
    IslandCaptureList(List(IslandCapture))
    IslandCaptureNode(Int, List(IslandCapture))

pub fn island_capture_nil() -> IslandCapture:
    IslandCaptureNil

pub fn island_capture_int(value: Int) -> IslandCapture:
    IslandCaptureInt(value)

pub fn island_capture_float(value: Float) -> IslandCapture:
    IslandCaptureFloat(value)

pub fn island_capture_bool(value: Bool) -> IslandCapture:
    IslandCaptureBool(value)

pub fn island_capture_string(value: String) -> IslandCapture:
    IslandCaptureString(value)

pub fn island_capture_bytes(value: Bytes) -> IslandCapture:
    IslandCaptureBytes(value)

pub fn island_capture_list(value: List(IslandCapture)) -> IslandCapture:
    IslandCaptureList(value)

pub fn island_capture_node(tag: Int, fields: List(IslandCapture)) -> IslandCapture:
    if tag < 0:
        fail("glamour island: callback environment tag is invalid")
    IslandCaptureNode(tag, fields)

pub fn island_capture_int_value(value: IslandCapture) -> Int:
    match value:
        IslandCaptureInt(inner) -> inner
        _ -> island_capture_abort()

pub fn island_capture_nil_value(value: IslandCapture):
    match value:
        IslandCaptureNil -> Nil
        _ -> island_capture_abort()

pub fn island_capture_float_value(value: IslandCapture) -> Float:
    match value:
        IslandCaptureFloat(inner) -> inner
        _ -> island_capture_abort()

pub fn island_capture_bool_value(value: IslandCapture) -> Bool:
    match value:
        IslandCaptureBool(inner) -> inner
        _ -> island_capture_abort()

pub fn island_capture_string_value(value: IslandCapture) -> String:
    match value:
        IslandCaptureString(inner) -> inner
        _ -> island_capture_abort()

pub fn island_capture_bytes_value(value: IslandCapture) -> Bytes:
    match value:
        IslandCaptureBytes(inner) -> inner
        _ -> island_capture_abort()

pub fn island_capture_list_value(value: IslandCapture) -> List(IslandCapture):
    match value:
        IslandCaptureList(inner) -> inner
        _ -> island_capture_abort()

pub fn island_capture_node_fields(value: IslandCapture, expected_tag: Int, expected_fields: Int) -> List(IslandCapture):
    match value:
        IslandCaptureNode(tag, fields) ->
            if tag != expected_tag || fields.length() != expected_fields:
                return island_capture_abort()
            fields
        _ -> island_capture_abort()

pub fn island_capture_abort() -> value:
    fail("glamour island: callback environment does not match its authenticated type")
    island_capture_abort()

pub fn island_capture_encoded_bytes(value: IslandCapture) -> Int:
    match value:
        IslandCaptureNil -> 1
        IslandCaptureInt(_inner) -> 9
        IslandCaptureFloat(_inner) -> 9
        IslandCaptureBool(_inner) -> 2
        IslandCaptureString(inner) -> 5 + bytes.from_string(inner).length()
        IslandCaptureBytes(inner) -> 5 + inner.length()
        IslandCaptureList(items) ->
            var total = 5
            for item in items:
                total = total + island_capture_encoded_bytes(item)
            total
        IslandCaptureNode(_tag, fields) ->
            var total = 9
            for field in fields:
                total = total + island_capture_encoded_bytes(field)
            total

pub fn island_capture_depth(value: IslandCapture) -> Int:
    match value:
        IslandCaptureList(items) ->
            var depth = 1
            for item in items:
                let child = 1 + island_capture_depth(item)
                if child > depth:
                    depth = child
            depth
        IslandCaptureNode(_tag, fields) ->
            var depth = 1
            for field in fields:
                let child = 1 + island_capture_depth(field)
                if child > depth:
                    depth = child
            depth
        _ -> 1

pub fn island_validate_capture(value: IslandCapture, maximum_bytes: Int, maximum_depth: Int) -> Int:
    if maximum_bytes < 0 || maximum_depth < 1:
        fail("glamour island: callback environment limits are invalid")
    let encoded = island_capture_encoded_bytes(value)
    if encoded > maximum_bytes || island_capture_depth(value) > maximum_depth:
        fail("glamour island: callback environment exceeds its authenticated limits")
    encoded

fn island_capture_wire_abort() -> value:
    fail("glamour worker: malformed typed capture wire")
    island_capture_wire_abort()

fn island_capture_wire_bytes(values: List(Int)) -> Bytes:
    for value in values:
        if value < 0 || value > 255:
            return island_capture_wire_abort()
    match bytes.from_list(values):
        Ok(encoded) -> encoded
        Err(_) -> island_capture_wire_abort()

fn island_capture_wire_values(value: Json, expected: Int) -> List(Json):
    match json.get(value, "\$values"):
        Some(JsonArray(values)) -> if values.length() == expected: values else: island_capture_wire_abort()
        _ -> island_capture_wire_abort()

fn island_capture_wire_list(value: Json) -> List(IslandCapture):
    match value:
        JsonArray(values) -> values.map(island_capture_from_json)
        _ -> island_capture_wire_abort()

fn island_capture_wire_byte_list(value: Json) -> Bytes:
    match value:
        JsonArray(values) ->
            var output: List(Int) = []
            for value in values:
                match value:
                    JsonInt(byte) -> output.push(byte)
                    _ -> return island_capture_wire_abort()
            island_capture_wire_bytes(output)
        _ -> island_capture_wire_abort()

fn island_capture_from_json(value: Json) -> IslandCapture:
    match json.get_string(value, "\$variant"):
        Some("IslandCaptureNil") ->
            let _ = island_capture_wire_values(value, 0)
            IslandCaptureNil
        Some("IslandCaptureInt") ->
            match island_capture_wire_values(value, 1).at(0):
                JsonInt(inner) -> IslandCaptureInt(inner)
                _ -> island_capture_wire_abort()
        Some("IslandCaptureFloat") ->
            match island_capture_wire_values(value, 1).at(0):
                JsonFloat(inner) -> IslandCaptureFloat(inner)
                JsonInt(inner) ->
                    match json.float_of(JsonInt(inner)):
                        Ok(number) -> IslandCaptureFloat(number)
                        Err(_) -> island_capture_wire_abort()
                _ -> island_capture_wire_abort()
        Some("IslandCaptureBool") ->
            match island_capture_wire_values(value, 1).at(0):
                JsonBool(inner) -> IslandCaptureBool(inner)
                _ -> island_capture_wire_abort()
        Some("IslandCaptureString") ->
            match island_capture_wire_values(value, 1).at(0):
                JsonString(inner) -> IslandCaptureString(inner)
                _ -> island_capture_wire_abort()
        Some("IslandCaptureBytes") -> IslandCaptureBytes(island_capture_wire_byte_list(island_capture_wire_values(value, 1).at(0)))
        Some("IslandCaptureList") -> IslandCaptureList(island_capture_wire_list(island_capture_wire_values(value, 1).at(0)))
        Some("IslandCaptureNode") ->
            let values = island_capture_wire_values(value, 2)
            match values.at(0):
                JsonInt(tag) -> if tag >= 0: IslandCaptureNode(tag, island_capture_wire_list(values.at(1))) else: island_capture_wire_abort()
                _ -> island_capture_wire_abort()
        _ -> island_capture_wire_abort()

pub fn island_capture_to_wire(value: IslandCapture, maximum_bytes: Int) -> String:
    let _ = island_validate_capture(value, maximum_bytes, 32)
    let encoded = json.encode(json.from_value(value))
    if bytes.from_string(encoded).length() > maximum_bytes:
        fail("glamour worker: typed capture wire exceeds its authenticated limit")
    encoded

pub fn island_capture_from_wire(value: String, maximum_bytes: Int) -> IslandCapture:
    if maximum_bytes < 1 || bytes.from_string(value).length() > maximum_bytes:
        return island_capture_wire_abort()
    match json.decode(value):
        Ok(document) ->
            let capture = island_capture_from_json(document)
            let _ = island_validate_capture(capture, maximum_bytes, 32)
            capture
        Err(_) -> island_capture_wire_abort()

fn island_request_field(value: String) -> String:
    "${bytes.from_string(value).length()}:${value}"

pub fn island_http_request(fetch: UiFetch, method: String, url: String, body: String) -> String:
    match fetch:
        UiFetch(scope, methods, prefix) -> island_request_field(scope) + island_request_field(methods) + island_request_field(prefix) + island_request_field(method) + island_request_field(url) + island_request_field(body)

pub fn island_navigation_request(route: UiRoute, path: String) -> String:
    match route:
        UiRoute(base, rights) -> island_request_field(base) + island_request_field(rights) + island_request_field(path)

pub fn island_port_request(credential: CredentialPort, argument: String) -> String:
    match credential:
        CredentialPort(name) -> island_request_field(name) + island_request_field(argument)

pub fn island_host_port_request(adapter: String, endpoint: String, maximum_request_bytes: Int, request: IslandCapture) -> String:
    island_request_field(adapter) + island_request_field(endpoint) + island_request_field(island_capture_to_wire(request, maximum_request_bytes))

pub fn island_secret_request(secret: SecretRef, credential: CredentialPort) -> String:
    match secret:
        SecretRef(slot) ->
            match credential:
                CredentialPort(name) -> island_request_field(slot) + island_request_field(name)

pub fn island_storage_request(storage: UiStorage, key: String, value: Option(String)) -> String:
    match storage:
        UiStorage(provider, namespace, key_prefix, max_value_bytes) ->
            let prefix = island_request_field(provider) + island_request_field(namespace) + island_request_field(key_prefix) + island_request_field("${max_value_bytes}") + island_request_field(key)
            match value:
                Some(text) -> prefix + island_request_field(text)
                None -> prefix

pub fn island_worker_request(worker: UiWorker, request: IslandCapture) -> String:
    match worker:
        UiWorker(_name, max_request_bytes, _max_result_bytes, _max_concurrency, _timeout_ms) -> island_capture_to_wire(request, max_request_bytes)

type Cmd(msg):
    NoCmd
    Immediate(msg)
    After(UiTimer, Int, msg)
    AfterStable(String, UiTimer, Int, msg)
    CancelCmd(String)
    Batch(List(Cmd(msg)))
    DetachedCmd(Cmd(msg))
    HttpTask(String, UiFetch, String, String, String, fn(HttpResult) -> msg)
    NavigationTask(String, UiRoute, String, fn(NavigationResult) -> msg)
    PortTask(String, CredentialPort, String, fn(PortResult) -> msg)
    SecretTask(String, SecretRef, CredentialPort, fn(PortResult) -> msg)
    StorageGetTask(String, UiStorage, String, fn(StorageResult) -> msg)
    StorageSetTask(String, UiStorage, String, String, fn(StorageResult) -> msg)
    StorageRemoveTask(String, UiStorage, String, fn(StorageResult) -> msg)
    IslandAfter(Int, Int, UiTimer, Int, IslandCapture)
    IslandAfterStable(Int, Int, String, UiTimer, Int, IslandCapture)
    IslandHttpTask(Int, Int, Int, String, UiFetch, String, String, String, IslandCapture)
    IslandNavigationTask(Int, Int, Int, String, UiRoute, String, IslandCapture)
    IslandPortTask(Int, Int, String, CredentialPort, String, IslandCapture)
    IslandHostPortTask(Int, Int, String, String, String, Int, Int, IslandCapture, IslandCapture)
    IslandSecretTask(Int, Int, String, SecretRef, CredentialPort, IslandCapture)
    IslandStorageGetTask(Int, Int, String, UiStorage, String, IslandCapture)
    IslandStorageSetTask(Int, Int, String, UiStorage, String, String, IslandCapture)
    IslandStorageRemoveTask(Int, Int, String, UiStorage, String, IslandCapture)
    IslandWorkerTask(Int, Int, String, UiWorker, IslandCapture, IslandCapture)
    // Compatibility variants retained while existing applications migrate.
    Http(UiFetch, String, String, String, String)
    Nav(UiRoute, String)
    Port(CredentialPort, String, String)
    SubmitSecret(SecretRef, CredentialPort, String)

// ---------------------------------------------------------------------------
// RFC-0107 application and composition contracts.
//
// `Ui` is a nominal wrapper around the compatibility VNode tree. Keeping the
// wrapper nominal lets the implementation change from a full tree to a static
// template plan without changing every application's Program signature.
// (`View(T, 'a)` is already Witchy's borrowed-view type.)
// ---------------------------------------------------------------------------
type Ui(msg):
    Ui(VNode(msg))

sealed type StaticUi:
    StaticUi(VNode(Nil))

pub fn ui(node: VNode(msg)) -> Ui(msg):
    Ui(node)

pub fn ui_node(rendered: Ui(msg)) -> VNode(msg):
    match rendered:
        Ui(node) -> node

pub fn static_ui(node: VNode(Nil)) -> StaticUi:
    check_static_ui_node(node)
    StaticUi(node)

fn check_static_ui_node(node: VNode(Nil)):
    match node:
        Planned(_plan, inner) -> check_static_ui_node(inner)
        Text(_value) -> Nil
        Keyed(_key, inner) -> check_static_ui_node(inner)
        Branch(_id, _active, inner) -> check_static_ui_node(inner)
        ChildRegion(_id, template, child) ->
            check_static_ui_node(template)
            match child:
                Some(inner) -> check_static_ui_node(inner)
                None -> Nil
        Element(_tag, attrs, children) ->
            for attr in attrs:
                match attr:
                    Property(_name, _value) -> fail("glamour StaticUi: browser property sinks are not static")
                    Prop(_name, _value) -> fail("glamour StaticUi: browser property sinks are not static")
                    On(_event, _message) -> fail("glamour StaticUi: event bindings are not allowed")
                    OnInput(_event, _tag) -> fail("glamour StaticUi: event bindings are not allowed")
                    OnDecoded(_id, _event, _decoder) -> fail("glamour StaticUi: event bindings are not allowed")
                    _ -> Nil

            for child in children:
                check_static_ui_node(child)
        Compartment(_renderer, _grant, _on) -> fail("glamour StaticUi: compartments are not static")
        FrameCompartment(_renderer, _max_grant, _max_event, _grant, _fallback, _id, _decoder) -> fail("glamour StaticUi: compartments are not static")
        SecretField(_input, _on_ready) -> fail("glamour StaticUi: secret fields are not static")
        Slot(_kind, _data) -> fail("glamour StaticUi: host slots are not static")
        IslandBoundary(_markup) -> fail("glamour StaticUi: nested islands are not allowed")
        InteractiveBoundary(_plan) -> fail("glamour StaticUi: nested interactive regions are not allowed")

fn template_child_value(_value: child) -> VNode(msg):
    fail("glamour template child: compiler lowering was not applied")
    Text("")

fn template_child_string(value: String) -> VNode(msg):
    Text(value)

fn template_child_vnode(value: VNode(msg)) -> VNode(msg):
    value

fn template_child_ui(value: Ui(msg)) -> VNode(msg):
    ui_node(value)

fn template_child_region(id: String, node: VNode(msg)) -> VNode(msg):
    ChildRegion(id, Text(""), Some(node))

impl Ui(msg):
    pub fn map(self, f: fn(msg) -> outer) -> Ui(outer):
        match self:
            Ui(node) -> Ui(map_node(node, f))

fn map_node(node: VNode(msg), f: fn(msg) -> outer) -> VNode(outer):
    match node:
        Planned(plan, inner) -> Planned(plan, map_node(inner, f))
        Text(value) -> Text(value)
        Compartment(renderer, grant, on_event) -> Compartment(renderer, grant, on_event)
        FrameCompartment(renderer, max_grant, max_event, grant, fallback, id, decoder) -> FrameCompartment(renderer, max_grant, max_event, grant, fallback, id, decoder.map(f))
        Keyed(key, inner) -> Keyed(key, map_node(inner, f))
        Branch(id, active, inner) -> Branch(id, active, map_node(inner, f))
        ChildRegion(id, template, child) ->
            match child:
                Some(inner) -> ChildRegion(id, map_node(template, f), Some(map_node(inner, f)))
                None -> ChildRegion(id, map_node(template, f), None)
        SecretField(input, on_ready) -> SecretField(input, on_ready)
        Slot(kind, data) -> Slot(kind, data)
        IslandBoundary(markup) -> IslandBoundary(markup)
        InteractiveBoundary(plan) -> InteractiveBoundary(plan)
        Element(tag, attrs, children) ->
            Element(tag, attrs.map(fn(attr: Attr(msg)): map_attr(attr, f)), children.map(fn(child: VNode(msg)): map_node(child, f)))

fn map_attr(attr: Attr(msg), f: fn(msg) -> outer) -> Attr(outer):
    match attr:
        Attribute(name, value) -> Attribute(name, value)
        BooleanAttribute(name, enabled) -> BooleanAttribute(name, enabled)
        Property(name, value) -> Property(name, value)
        UrlAttribute(name, value) -> UrlAttribute(name, value)
        ClassAttribute(names) -> ClassAttribute(names)
        AriaAttribute(name, value) -> AriaAttribute(name, value)
        CustomProperties(assignments) -> CustomProperties(assignments)
        Prop(name, value) -> Prop(name, value)
        On(event, message) -> On(event, f(message))
        OnInput(event, tag) -> OnInput(event, tag)
        OnDecoded(id, event, decoder) -> OnDecoded(id, event, decoder.map(f))

impl Cmd(msg):
    // Map every message already carried as typed data. Compatibility effects
    // whose completion is still a reflected tag carry no `msg` value to map;
    // typed completion descriptors replace those string boundaries.
    pub fn map(self, f: fn(msg) -> outer) -> Cmd(outer):
        match self:
            NoCmd -> NoCmd
            Immediate(message) -> Immediate(f(message))
            After(timer, milliseconds, message) -> After(timer, milliseconds, f(message))
            AfterStable(id, timer, milliseconds, message) -> AfterStable(id, timer, milliseconds, f(message))
            CancelCmd(id) -> CancelCmd(id)
            Batch(commands) -> Batch(commands.map(fn(command: Cmd(msg)): command.map(f)))
            DetachedCmd(command) -> DetachedCmd(command.map(f))
            HttpTask(id, fetch, method, url, body, on_done) -> HttpTask(id, fetch, method, url, body, fn(result: HttpResult): f(on_done(result)))
            NavigationTask(id, route, path, on_done) -> NavigationTask(id, route, path, fn(result: NavigationResult): f(on_done(result)))
            PortTask(id, credential, argument, on_done) -> PortTask(id, credential, argument, fn(result: PortResult): f(on_done(result)))
            SecretTask(id, secret, credential, on_done) -> SecretTask(id, secret, credential, fn(result: PortResult): f(on_done(result)))
            StorageGetTask(id, storage, key, on_done) -> StorageGetTask(id, storage, key, fn(result: StorageResult): f(on_done(result)))
            StorageSetTask(id, storage, key, value, on_done) -> StorageSetTask(id, storage, key, value, fn(result: StorageResult): f(on_done(result)))
            StorageRemoveTask(id, storage, key, on_done) -> StorageRemoveTask(id, storage, key, fn(result: StorageResult): f(on_done(result)))
            IslandAfter(descriptor, completion, timer, milliseconds, environment) -> IslandAfter(descriptor, completion, timer, milliseconds, environment)
            IslandAfterStable(descriptor, completion, id, timer, milliseconds, environment) -> IslandAfterStable(descriptor, completion, id, timer, milliseconds, environment)
            IslandHttpTask(descriptor, completion, owner, id, fetch, method, url, body, environment) -> IslandHttpTask(descriptor, completion, owner, id, fetch, method, url, body, environment)
            IslandNavigationTask(descriptor, completion, owner, id, route, path, environment) -> IslandNavigationTask(descriptor, completion, owner, id, route, path, environment)
            IslandPortTask(descriptor, completion, id, credential, argument, environment) -> IslandPortTask(descriptor, completion, id, credential, argument, environment)
            IslandHostPortTask(descriptor, completion, id, adapter, endpoint, maximum_request_bytes, maximum_result_bytes, request, environment) -> IslandHostPortTask(descriptor, completion, id, adapter, endpoint, maximum_request_bytes, maximum_result_bytes, request, environment)
            IslandSecretTask(descriptor, completion, id, secret, credential, environment) -> IslandSecretTask(descriptor, completion, id, secret, credential, environment)
            IslandStorageGetTask(descriptor, completion, id, storage, key, environment) -> IslandStorageGetTask(descriptor, completion, id, storage, key, environment)
            IslandStorageSetTask(descriptor, completion, id, storage, key, value, environment) -> IslandStorageSetTask(descriptor, completion, id, storage, key, value, environment)
            IslandStorageRemoveTask(descriptor, completion, id, storage, key, environment) -> IslandStorageRemoveTask(descriptor, completion, id, storage, key, environment)
            IslandWorkerTask(descriptor, completion, id, worker, request, environment) -> IslandWorkerTask(descriptor, completion, id, worker, request, environment)
            Http(fetch, method, url, body, tag) -> Http(fetch, method, url, body, tag)
            Nav(route, path) -> Nav(route, path)
            Port(credential, argument, tag) -> Port(credential, argument, tag)
            SubmitSecret(secret, credential, tag) -> SubmitSecret(secret, credential, tag)

// Public startup data. Authority remains in the separate `auth` value.
type Start:
    Start(String, String)

// Ongoing external input. IDs are application-stable values used for
// reconciliation and cancellation; the host owns the actual source.
type Sub(msg):
    NoSub
    Every(String, UiTimer, Int, msg)
    IslandEvery(Int, Int, String, UiTimer, Int, IslandCapture)
    BatchSub(List(Sub(msg)))

pub fn no_sub() -> Sub(msg):
    NoSub

pub fn every(id: String, timer: UiTimer, milliseconds: Int, message: msg) -> Sub(msg):
    Every(id, timer, milliseconds, message)

pub fn batch_sub(subscriptions: List(Sub(msg))) -> Sub(msg):
    BatchSub(subscriptions)

impl Sub(msg):
    pub fn map(self, f: fn(msg) -> outer) -> Sub(outer):
        match self:
            NoSub -> NoSub
            Every(id, timer, milliseconds, message) -> Every(id, timer, milliseconds, f(message))
            IslandEvery(descriptor, completion, id, timer, milliseconds, environment) -> IslandEvery(descriptor, completion, id, timer, milliseconds, environment)
            BatchSub(subscriptions) -> BatchSub(subscriptions.map(fn(subscription: Sub(msg)): subscription.map(f)))

// Complete async state; stale data is explicit while loading or failed.
type Resource(value, problem):
    Idle
    Loading(String, Option(value))
    Ready(value)
    Failed(problem, Option(value))

// The application is ordinary immutable data containing its state-machine
// functions. It owns no ambient browser instance or lifecycle hooks.
type Program(auth, model, msg):
    Program(fn(UiRoot) -> auth, fn(Start) -> model, fn(auth, model) -> Cmd(msg), fn(auth, model, msg) -> (model, Cmd(msg)), fn(model) -> Ui(msg), fn(auth, model) -> Sub(msg))

pub fn program(authorize: fn(UiRoot) -> auth, initial: fn(Start) -> model, start: fn(auth, model) -> Cmd(msg), update: fn(auth, model, msg) -> (model, Cmd(msg)), render: fn(model) -> Ui(msg), subscriptions: fn(auth, model) -> Sub(msg)) -> Program(auth, model, msg):
    Program(authorize, initial, start, update, render, subscriptions)

fn media_query_literal(source: String) -> MediaQuery:
    let query = source.trim()
    if valid_media_query(query):
        MediaQuery(query)
    else:
        fail("glamour media: expected a bounded static CSS media condition")
        MediaQuery("")

fn valid_media_query(query: String) -> Bool:
    if query.is_empty() || bytes.from_string(query).length() > 512:
        false
    else:
        var depth = 0
        for character in query.chars():
            if character == "(":
                depth = depth + 1
            else if character == ")":
                depth = depth - 1
                if depth < 0:
                    return false
            else if !(character >= "a" && character <= "z" || character >= "A" && character <= "Z" || character >= "0" && character <= "9" || character == " " || character == "\t" || character == "\n" || character == "\r" || character == "-" || character == ":" || character == "." || character == "/" || character == "_" || character == "%"):
                return false
        depth == 0

fn media_query_text(query: MediaQuery) -> String:
    match query:
        MediaQuery(source) -> source

// The generic values couple the island's program, initial model, and static
// projection during ordinary type checking. Only canonical public data and
// Glamour-rendered markup survive in the closed plan. The publication compiler
// separately authenticates the direct program and projection declarations and
// derives the executable identity; `key` is diagnostic data, not an export.
pub fn island(key: String, _app: Program(auth, model, msg), initial: model, static_view: fn(model) -> Ui(msg), activate: Activation) -> IslandPlan where model: PublicState, model: Reflect, model: Deserialize:
    if !valid_island_key(key):
        fail("glamour island: key must begin with an ASCII letter and contain only letters, digits, `-`, or `_`")
    island_plan(key, "low-level:" + key, initial, static_view, activate)

fn island_plan(key: String, source_origin: String, initial: model, static_view: fn(model) -> Ui(msg), activate: Activation) -> IslandPlan where model: PublicState, model: Reflect, model: Deserialize:
    public_state.check(initial)
    let state = json.encode(public_state.to_json(initial))
    let node = ui_node(static_view(initial))
    let html = island_to_html(node)
    let resume = json.encode(island_resume_node(node))
    let templates = json.encode(island_template_node(node))
    IslandPlan(key, source_origin, activate, NoPrefetch, None, Resumable(state), IslandMarkup(key, html, resume, templates))

pub fn interactive(app: Program(auth, model, msg), initial: model) -> Interactive where model: PublicState, model: Reflect, model: Deserialize:
    interactive_with_origin("interactive-origin1-unlowered", app, initial)

fn interactive_with_origin(source_origin: String, app: Program(auth, model, msg), initial: model) -> Interactive where model: PublicState, model: Reflect, model: Deserialize:
    match app:
        Program(_authorize, _initial, _start, _update, view, _subscriptions) ->
            Interactive(island_plan("interactive", source_origin, initial, view, OnVisible))

pub fn client_region(app: Program(auth, model, msg), fallback: StaticUi) -> Interactive:
    client_region_with_origin("client-region-origin1-unlowered", app, fallback)

fn client_region_with_origin(source_origin: String, _app: Program(auth, model, msg), fallback: StaticUi) -> Interactive:
    match fallback:
        StaticUi(node) ->
            check_static_ui_node(node)
            let html = island_to_html(node)
            let resume = json.encode(island_resume_node(node))
            let templates = json.encode(island_template_node(node))
            Interactive(IslandPlan("client-region", source_origin, OnVisible, NoPrefetch, None, Fresh, IslandMarkup("client-region", html, resume, templates)))

// Compiler evaluation uses the capability-free fresh path to authenticate the
// live template separately from a client region's inert fallback. The private
// model remains inside the compiler evaluation and the generated Wasm instance.
fn client_region_live_graph(key: String, rendered: Ui(msg)) -> (String, String, String, String):
    let node = ui_node(rendered)
    (key, island_to_html(node), json.encode(island_resume_node(node)), json.encode(island_template_node(node)))

impl Interactive:
    pub fn named(self, name: String) -> Interactive:
        if !valid_island_key(name):
            fail("glamour interactive: diagnostic names must begin with an ASCII letter and contain only letters, digits, `-`, or `_`")
        match self:
            Interactive(IslandPlan(key, source_origin, activation, prefetch, _name, start, markup)) -> Interactive(IslandPlan(key, source_origin, activation, prefetch, Some(name), start, markup))

    pub fn activate(self, activation: Activation) -> Interactive:
        match self:
            Interactive(IslandPlan(key, source_origin, _activation, prefetch, name, start, markup)) -> Interactive(IslandPlan(key, source_origin, activation, prefetch, name, start, markup))

    pub fn prefetch(self, prefetch: Prefetch) -> Interactive:
        match self:
            Interactive(IslandPlan(key, source_origin, activation, _prefetch, name, start, markup)) -> Interactive(IslandPlan(key, source_origin, activation, prefetch, name, start, markup))

pub fn embed(interactive_value: Interactive) -> VNode(Nil):
    match interactive_value:
        Interactive(plan) -> InteractiveBoundary(plan)

fn island_resume_node(node: VNode(msg)) -> Json:
    match node:
        Planned(_plan, inner) -> island_resume_node(inner)
        Text(_value) -> JsonObject([("kind", JsonString("text"))])
        FrameCompartment(renderer, max_grant, max_event, grant, fallback, id, decoder) ->
            JsonObject([("kind", JsonString("frame")), ("renderer", JsonString(renderer)), ("maxGrantBytes", JsonInt(max_grant)), ("maxEventBytes", JsonInt(max_event)), ("grant", JsonString(grant)), ("fallback", JsonString(fallback)), ("id", JsonString(id)), ("decoder", JsonString(decoder_kind(decoder)))])
        Keyed(key, inner) -> JsonObject([("kind", JsonString("keyed")), ("key", JsonString(key)), ("child", island_resume_node(inner))])
        Branch(id, active, inner) -> JsonObject([("kind", JsonString("branch")), ("id", JsonString(id)), ("active", JsonBool(active)), ("child", island_resume_node(inner))])
        ChildRegion(id, template, child) ->
            match child:
                Some(inner) -> JsonObject([("kind", JsonString("child")), ("id", JsonString(id)), ("mounted", JsonBool(true)), ("child", island_resume_node(inner))])
                None -> JsonObject([("kind", JsonString("child")), ("id", JsonString(id)), ("mounted", JsonBool(false)), ("child", island_resume_node(template))])
        Element(tag, attrs, children) ->
            var attributes: List(Json) = []
            var events: List(Json) = []
            for attr in attrs:
                match attr:
                    Attribute(name, _value) -> attributes.push(JsonObject([("kind", JsonString("attribute")), ("name", JsonString(name))]))
                    BooleanAttribute(name, _enabled) -> attributes.push(JsonObject([("kind", JsonString("boolean")), ("name", JsonString(name))]))
                    Property(name, _value) -> attributes.push(JsonObject([("kind", JsonString("property")), ("name", JsonString(name))]))
                    UrlAttribute(name, _value) -> attributes.push(JsonObject([("kind", JsonString("url")), ("name", JsonString(name))]))
                    ClassAttribute(_names) -> attributes.push(JsonObject([("kind", JsonString("class")), ("name", JsonString("class"))]))
                    AriaAttribute(name, _value) -> attributes.push(JsonObject([("kind", JsonString("aria")), ("name", JsonString(name))]))
                    CustomProperties(assignments) ->
                        for assignment in assignments:
                            match assignment:
                                CssAssignment(name, category, _value) -> attributes.push(JsonObject([("kind", JsonString("css-" + category)), ("name", JsonString(name))]))
                    Prop(name, _value) -> attributes.push(JsonObject([("kind", JsonString("prop")), ("name", JsonString(name))]))
                    OnDecoded(id, event, decoder) ->
                        events.push(JsonObject([("id", JsonString(id)), ("event", JsonString(event)), ("kind", JsonString(decoder_kind(decoder))), ("preventDefault", JsonBool(decoder_prevents_default(decoder))), ("stopPropagation", JsonBool(decoder_stops_propagation(decoder)))]))
                    On(_event, _message) -> fail("glamour island: resumable events must use typed glamour.on_event")
                    OnInput(_event, _tag) -> fail("glamour island: resumable input events must use typed glamour.on_event")
                    _ -> Nil

            var child_records: List(Json) = []
            for child in children:
                child_records.push(island_resume_node(child))
            JsonObject([("kind", JsonString("element")), ("tag", JsonString(tag)), ("attributes", JsonArray(attributes)), ("events", JsonArray(events)), ("children", JsonArray(child_records))])
        _ -> island_resume_failure("glamour island: resumable static views support only planned, keyed, branch, optional child, element, and text nodes")

fn island_resume_failure(message: String) -> Json:
    fail(message)
    JsonNull

fn island_template_node(node: VNode(msg)) -> Json:
    match node:
        Planned(_plan, inner) -> island_template_node(inner)
        Text(value) -> JsonObject([("kind", JsonString("text")), ("value", JsonString(value))])
        FrameCompartment(renderer, max_grant, max_event, grant, fallback, id, decoder) ->
            JsonObject([("kind", JsonString("frame")), ("renderer", JsonString(renderer)), ("maxGrantBytes", JsonInt(max_grant)), ("maxEventBytes", JsonInt(max_event)), ("grant", JsonString(grant)), ("fallback", JsonString(fallback)), ("id", JsonString(id)), ("decoder", JsonString(decoder_kind(decoder)))])
        Keyed(key, inner) -> JsonObject([("kind", JsonString("keyed")), ("key", JsonString(key)), ("child", island_template_node(inner))])
        Branch(id, _active, inner) -> JsonObject([("kind", JsonString("branch")), ("id", JsonString(id)), ("child", island_template_node(inner))])
        ChildRegion(id, template, _child) ->
            JsonObject([("kind", JsonString("child")), ("id", JsonString(id)), ("child", island_template_node(template))])
        Element(tag, attrs, children) ->
            var attributes: List(Json) = []
            for attr in attrs:
                match attr:
                    Attribute(name, value) -> attributes.push(JsonObject([("kind", JsonString("attribute")), ("name", JsonString(name)), ("value", JsonString(value)), ("enabled", JsonBool(true))]))
                    BooleanAttribute(name, enabled) -> attributes.push(JsonObject([("kind", JsonString("boolean")), ("name", JsonString(name)), ("value", JsonString("")), ("enabled", JsonBool(enabled))]))
                    Property(name, value) -> attributes.push(JsonObject([("kind", JsonString("property")), ("name", JsonString(name)), ("value", JsonString(value)), ("enabled", JsonBool(true))]))
                    UrlAttribute(name, value) -> attributes.push(JsonObject([("kind", JsonString("url")), ("name", JsonString(name)), ("value", JsonString(safe_url_or_hash(value))), ("enabled", JsonBool(true))]))
                    ClassAttribute(names) -> attributes.push(JsonObject([("kind", JsonString("class")), ("name", JsonString("class")), ("value", JsonString(names.join(" "))), ("enabled", JsonBool(true))]))
                    AriaAttribute(name, value) -> attributes.push(JsonObject([("kind", JsonString("aria")), ("name", JsonString(name)), ("value", JsonString(value)), ("enabled", JsonBool(true))]))
                    CustomProperties(assignments) ->
                        for assignment in assignments:
                            match assignment:
                                CssAssignment(name, category, value) -> attributes.push(JsonObject([("kind", JsonString("css-" + category)), ("name", JsonString(name)), ("value", JsonString(value)), ("enabled", JsonBool(true))]))
                    Prop(name, value) -> attributes.push(JsonObject([("kind", JsonString("prop")), ("name", JsonString(name)), ("value", JsonString(value)), ("enabled", JsonBool(true))]))
                    OnDecoded(_id, _event, _decoder) -> Nil
                    On(_event, _message) -> fail("glamour island: resumable events must use typed glamour.on_event")
                    OnInput(_event, _tag) -> fail("glamour island: resumable input events must use typed glamour.on_event")

            var child_records: List(Json) = []
            for child in children:
                child_records.push(island_template_node(child))
            JsonObject([("kind", JsonString("element")), ("tag", JsonString(tag)), ("attributes", JsonArray(attributes)), ("children", JsonArray(child_records))])
        _ -> island_resume_failure("glamour island: resumable templates support only planned, keyed, branch, optional child, element, and text nodes")

fn island_to_html(node: VNode(msg)) -> String:
    match node:
        Planned(_plan, inner) -> island_to_html(inner)
        Text(value) -> escape_text(value)
        FrameCompartment(renderer, _max_grant, _max_event, _grant, fallback, id, _decoder) ->
            "<iframe sandbox=\"allow-scripts\" class=\"glamour-compartment\" data-glamour-frame-renderer=\"" + escape_attr(renderer) + "\" data-glamour-frame-event=\"" + escape_attr(id) + "\">" + fallback + "</iframe>"
        Keyed(_key, inner) -> island_to_html(inner)
        Branch(_id, active, inner) -> if active: island_to_html(inner) else: ""
        ChildRegion(_id, _template, child) ->
            match child:
                Some(inner) -> island_to_html(inner)
                None -> ""
        Element(tag, attrs, children) ->
            let ok_tag = valid_tag_name(tag)
            let emit_tag = if ok_tag: tag else: "span"
            var out = "<" + emit_tag
            if !ok_tag:
                out = out + " data-glamour-invalid-tag=\"" + escape_attr(tag) + "\""
            var event_ids: List(String) = []
            for attr in attrs:
                match attr:
                    OnDecoded(id, _event, _decoder) -> event_ids.push(id)
                    Attribute("data-glamour-events", _value) -> fail("glamour island: data-glamour-events is reserved")
                    Property("data-glamour-events", _value) -> fail("glamour island: data-glamour-events is reserved")
                    Prop("data-glamour-events", _value) -> fail("glamour island: data-glamour-events is reserved")
                    _ -> out = out + render_attr(attr)
            if !event_ids.is_empty():
                out = out + " data-glamour-events=\"" + escape_attr(event_ids.join(" ")) + "\""
            out = out + ">"
            for child in children:
                out = out + island_to_html(child)
            out + "</" + emit_tag + ">"
        _ -> island_html_failure("glamour island: resumable static views support only planned, keyed, branch, optional child, element, and text nodes")

fn island_html_failure(message: String) -> String:
    fail(message)
    ""

pub fn island_node(plan: IslandPlan) -> VNode(msg):
    match plan:
        IslandPlan(_key, _source_origin, _activate, _prefetch, _name, _start, markup) -> IslandBoundary(markup)

fn valid_island_key(key: String) -> Bool:
    if key.is_empty():
        false
    else:
        let first = key.take(1)
        if !(first >= "A" && first <= "Z") && !(first >= "a" && first <= "z"):
            false
        else:
            for character in key.chars():
                if !(character >= "A" && character <= "Z" || character >= "a" && character <= "z" || character >= "0" && character <= "9" || character == "-" || character == "_"):
                    return false
            true

pub fn program_init(app: Program(auth, model, msg), root: UiRoot, start: Start) -> (auth, model, Cmd(msg), Sub(msg), Ui(msg)):
    match app:
        Program(authorize, initial, start_program, _update, render, subscriptions) ->
            let auth = authorize(root)
            let model = initial(start)
            let command = start_program(auth, model)
            (auth, model, command, subscriptions(auth, model), render(model))

pub fn program_update(app: Program(auth, model, msg), auth: auth, model: model, message: msg) -> (model, Cmd(msg), Sub(msg), Ui(msg)):
    match app:
        Program(_authorize, _initial, _start, update, render, subscriptions) ->
            let (next_model, command) = update(auth, model, message)
            (next_model, command, subscriptions(auth, next_model), render(next_model))

// An async HTTP request (RFC-0015): method, url, body, and the Reflect VARIANT NAME
// the shell wraps the `(status, body)` response into and dispatches back. The rune
// holds no `Net` — it only DESCRIBES the request; the capability-holding host shell
// performs the fetch (attaching any session credential ITSELF) and feeds the result
// back as that msg, exactly like the `After` timer. So `update` stays pure and the
// footprint stays empty, while the app still talks to a server.
// (RFC-0039) The leading `UiFetch` is the unforgeable authority to construct
// this fetch: a component without one CANNOT emit an HTTP effect. The token is
// NOT serialized (it gates construction, not the wire) — see `cmd_to_json`.

// Push a new URL onto history (client-side routing); the shell mirrors it back as
// the app's route msg so `view` re-renders for the new path.
// (RFC-0039) The leading `UiRoute` is the unforgeable authority to navigate,
// confined to a `base` path; a component without one cannot redirect the app.

// A host-shell PORT (RFC-0015): run a named host capability (session login, a
// WebAuthn passkey ceremony, storage) with `arg`, dispatching the 1-arg msg `tag(result)`
// back. The port — and any credential or browser-native API it touches
// (`navigator.credentials`, the session token) — lives entirely in the host; the rune
// emits only the description and receives only the result, holding no authority itself.
// (RFC-0039) The leading `CredentialPort` is the unforgeable authority AND it NAMES
// the port: the name is read out of the token (see `cmd_to_json`), never passed as a
// free argument, so a component holding a `promote` port can ONLY ever emit a promote
// call — it cannot invoke `yank` or any other port it was not granted.

// (RFC-0039) Submit a host-held SECRET (named by the opaque `SecretRef`) to a host
// credential port, dispatching `on_done(result)` back. The rune never holds the secret
// bytes — only the opaque handle — and the shell reads the value out of its OWN custody
// and hands it to the port. Both the secret slot and the port name ride their tokens,
// so neither is a forgeable free argument. This is how a password is used without ever
// becoming rune-visible data.

// ---------------------------------------------------------------------------
// Cmd WIRE FORMAT — serialize a `Cmd(msg)` to the JSON shape the host shell
// (`web/witchy-runtime/glamour-dom.mjs`) reads and INTERPRETS. The shell holds the
// authority (the `setTimeout` timer); the rune only produced this description.
//
// Shape (compact JSON):
//   NoCmd          -> {"cmd": "none"}
//   After(ms, msg) -> {"cmd": "after", "ms": ms, "msg": <msg-json>}
//   Batch(cmds)    -> {"cmd": "batch", "cmds": [<cmd-json>...]}
//
// The embedded `msg` is serialized via the same caller-supplied `msg_to_json`
// the VNode `on` bindings use, so a `Cmd`'s deferred msg round-trips back into
// `update` exactly as a click-sourced msg would. Events AND effects are data.
// ---------------------------------------------------------------------------
pub fn cmd_to_json(cmd: Cmd(msg), msg_to_json: fn(msg) -> Json) -> Json:
    match cmd:
        // (BUG-017) Carry the token's `min_ms` floor so the shell — the real authority —
        // re-clamps the delay itself, rather than trusting the emitted `ms` blindly.

        // `tag` is a literal variant NAME (not routed through msg_to_json): the shell
        // reconstructs `{"$variant": tag, "$values": [status, body]}` once the response
        // arrives, so the response carries data the rune did not have at emit time.
        // (BUG-017) The `UiFetch` policy (`methods`/`prefix`/`scope`) rides the wire so the
        // host re-checks method+prefix before performing the fetch — the real authority.

        // (BUG-017) Carry the `UiRoute` `base`/`rights` so the host re-checks the path is
        // under the authorized base before `pushState`.

        // The port NAME is read out of the `CredentialPort` token (not a free arg), so
        // the wire can only ever name the port the component was actually granted.

        // A secret submit carries the host-slot name (from the `SecretRef`) and the port
        // name (from the `CredentialPort`) — both from tokens, neither forgeable — plus the
        // reply tag. The secret VALUE is NOT here: the shell reads it from its own custody.
        NoCmd -> JsonObject([("cmd", JsonString("none"))])
        Immediate(message) -> JsonObject([("cmd", JsonString("immediate")), ("msg", msg_to_json(message))])
        After(timer, ms, msg) ->
            let mj: Json = msg_to_json(msg)
            match timer:
                UiTimer(min_ms) ->
                    JsonObject([("cmd", JsonString("after")), ("ms", JsonInt(ms)), ("min_ms", JsonInt(min_ms)), ("msg", mj)])
        AfterStable(id, timer, ms, msg) ->
            let mj: Json = msg_to_json(msg)
            match timer:
                UiTimer(min_ms) ->
                    JsonObject([("cmd", JsonString("after")), ("id", JsonString(id)), ("ms", JsonInt(ms)), ("min_ms", JsonInt(min_ms)), ("msg", mj)])
        CancelCmd(id) -> JsonObject([("cmd", JsonString("cancel")), ("id", JsonString(id))])
        Batch(cmds) ->
            var cjs: List(Json) = []
            for c in cmds:
                let cj: Json = cmd_to_json(c, msg_to_json)
                cjs.push(cj)
            JsonObject([("cmd", JsonString("batch")), ("cmds", JsonArray(cjs))])
        DetachedCmd(command) -> cmd_to_json(command, msg_to_json)
        HttpTask(id, fetch, method, url, body, on_done) ->
            match fetch:
                UiFetch(scope, methods, prefix) ->
                    JsonObject([("cmd", JsonString("http")), ("id", JsonString(id)), ("method", JsonString(method)), ("url", JsonString(url)), ("body", JsonString(body)), ("reply_a", msg_to_json(on_done(HttpProbeA0107))), ("reply_b", msg_to_json(on_done(HttpProbeB0107))), ("methods", JsonString(methods)), ("prefix", JsonString(prefix)), ("scope", JsonString(scope))])
        NavigationTask(id, route, path, on_done) ->
            match route:
                UiRoute(base, rights) ->
                    JsonObject([("cmd", JsonString("nav")), ("id", JsonString(id)), ("path", JsonString(path)), ("reply_a", msg_to_json(on_done(NavigationProbeA0107))), ("reply_b", msg_to_json(on_done(NavigationProbeB0107))), ("base", JsonString(base)), ("rights", JsonString(rights))])
        PortTask(id, cred, arg, on_done) ->
            match cred:
                CredentialPort(name) ->
                    JsonObject([("cmd", JsonString("port")), ("id", JsonString(id)), ("port", JsonString(name)), ("arg", JsonString(arg)), ("reply_a", msg_to_json(on_done(PortProbeA0107))), ("reply_b", msg_to_json(on_done(PortProbeB0107)))])
        SecretTask(id, secret, cred, on_done) ->
            match secret:
                SecretRef(slot) ->
                    match cred:
                        CredentialPort(name) ->
                            JsonObject([("cmd", JsonString("submit_secret")), ("id", JsonString(id)), ("slot", JsonString(slot)), ("port", JsonString(name)), ("reply_a", msg_to_json(on_done(PortProbeA0107))), ("reply_b", msg_to_json(on_done(PortProbeB0107)))])
        IslandAfter(_descriptor, _completion, _timer, _milliseconds, _message) ->
            fail("glamour island: compiler-owned command cannot cross the JSON host")
            JsonNull
        IslandAfterStable(_descriptor, _completion, _id, _timer, _milliseconds, _message) ->
            fail("glamour island: compiler-owned command cannot cross the JSON host")
            JsonNull
        IslandHttpTask(_descriptor, _completion, _owner, _id, _fetch, _method, _url, _body, _on_done) ->
            fail("glamour island: compiler-owned command cannot cross the JSON host")
            JsonNull
        IslandNavigationTask(_descriptor, _completion, _owner, _id, _route, _path, _on_done) ->
            fail("glamour island: compiler-owned command cannot cross the JSON host")
            JsonNull
        IslandPortTask(_descriptor, _completion, _id, _credential, _argument, _on_done) ->
            fail("glamour island: compiler-owned command cannot cross the JSON host")
            JsonNull
        IslandHostPortTask(_descriptor, _completion, _id, _adapter, _endpoint, _maximum_request_bytes, _maximum_result_bytes, _request, _on_done) ->
            fail("glamour island: compiler-owned command cannot cross the JSON host")
            JsonNull
        IslandSecretTask(_descriptor, _completion, _id, _secret, _credential, _on_done) ->
            fail("glamour island: compiler-owned command cannot cross the JSON host")
            JsonNull
        StorageGetTask(_id, _storage, _key, _on_done) ->
            fail("glamour storage: optimized browser compilation is required")
            JsonNull
        StorageSetTask(_id, _storage, _key, _value, _on_done) ->
            fail("glamour storage: optimized browser compilation is required")
            JsonNull
        StorageRemoveTask(_id, _storage, _key, _on_done) ->
            fail("glamour storage: optimized browser compilation is required")
            JsonNull
        IslandStorageGetTask(_descriptor, _completion, _id, _storage, _key, _environment) ->
            fail("glamour island: compiler-owned command cannot cross the JSON host")
            JsonNull
        IslandStorageSetTask(_descriptor, _completion, _id, _storage, _key, _value, _environment) ->
            fail("glamour island: compiler-owned command cannot cross the JSON host")
            JsonNull
        IslandStorageRemoveTask(_descriptor, _completion, _id, _storage, _key, _environment) ->
            fail("glamour island: compiler-owned command cannot cross the JSON host")
            JsonNull
        IslandWorkerTask(_descriptor, _completion, _id, _worker, _request, _environment) ->
            fail("glamour island: compiler-owned command cannot cross the JSON host")
            JsonNull
        Http(fetch, method, url, body, tag) ->
            match fetch:
                UiFetch(scope, methods, prefix) ->
                    JsonObject([("cmd", JsonString("http")), ("method", JsonString(method)), ("url", JsonString(url)), ("body", JsonString(body)), ("tag", JsonString(tag)), ("methods", JsonString(methods)), ("prefix", JsonString(prefix)), ("scope", JsonString(scope))])
        Nav(route, path) ->
            match route:
                UiRoute(base, rights) ->
                    JsonObject([("cmd", JsonString("nav")), ("path", JsonString(path)), ("base", JsonString(base)), ("rights", JsonString(rights))])
        Port(cred, arg, tag) ->
            match cred:
                CredentialPort(name) ->
                    JsonObject([("cmd", JsonString("port")), ("port", JsonString(name)), ("arg", JsonString(arg)), ("tag", JsonString(tag))])
        SubmitSecret(secret, cred, tag) ->
            match secret:
                SecretRef(slot) ->
                    match cred:
                        CredentialPort(name) ->
                            JsonObject([("cmd", JsonString("submit_secret")), ("slot", JsonString(slot)), ("port", JsonString(name)), ("tag", JsonString(tag))])

// Typed HTTP effects. `on_done` is an ordinary Witchy function value, so the
// compiler checks its input and Cmd.map can compose it without string tags.
// `id` supplies replacement, cancellation, and stale-completion identity.
pub fn http_get(id: String, fetch: UiFetch, url: String, on_done: fn(HttpResult) -> msg) -> Cmd(msg):
    http_request(id, fetch, "GET", url, "", on_done)

pub fn http_post(id: String, fetch: UiFetch, url: String, body: String, on_done: fn(HttpResult) -> msg) -> Cmd(msg):
    http_request(id, fetch, "POST", url, body, on_done)

pub fn http_request(id: String, fetch: UiFetch, method: String, url: String, body: String, on_done: fn(HttpResult) -> msg) -> Cmd(msg):
    match fetch:
        UiFetch(_scope, methods, prefix) ->
            if method_allowed(methods, method) && url.starts_with(prefix):
                HttpTask(id, fetch, method, url, body, on_done)
            else:
                NoCmd

// Compatibility constructors for the old reflected-variant protocol.
pub fn http_get_compat(fetch: UiFetch, url: String, on_done: String) -> Cmd(msg):
    fetch_cmd_compat(fetch, "GET", url, "", on_done)

pub fn http_post_compat(fetch: UiFetch, url: String, body: String, on_done: String) -> Cmd(msg):
    fetch_cmd_compat(fetch, "POST", url, body, on_done)

// (BUG-017) Enforce the `UiFetch` token policy at CONSTRUCTION: the method must be in the
// token's method-set and the URL under its path prefix. FAIL CLOSED — a violation yields
// `NoCmd`, so a component cannot even describe an effect its token does not authorize. The
// host shell re-checks the same policy (carried on the wire by `cmd_to_json`) as the real
// authority boundary; this witchy-side gate is the reviewable first line.
fn fetch_cmd_compat(fetch: UiFetch, method: String, url: String, body: String, on_done: String) -> Cmd(msg):
    match fetch:
        UiFetch(_scope, methods, prefix) ->
            if method_allowed(methods, method) && url.starts_with(prefix):
                Http(fetch, method, url, body, on_done)
            else:
                NoCmd

// Arm a timer: after `ms` milliseconds the shell dispatches `msg`. Requires a `UiTimer`
// token (the shell holds the real `setTimeout` and re-checks the token's `min_ms`).
pub fn after(timer: UiTimer, ms: Int, msg: msg) -> Cmd(msg):
    // (BUG-017) A `UiTimer` promises "no shorter than `min_ms`". Enforce the floor at
    // construction by clamping UP; the host re-clamps against the wired `min_ms` too.
    match timer:
        UiTimer(min_ms) ->
            let safe_ms = if ms < min_ms: min_ms else: ms
            After(timer, safe_ms, msg)

// A replaceable delayed command. Re-emitting `id` cancels the prior generation;
// `cancel_cmd(id)` cancels it explicitly. Late callbacks are ignored by the host.
pub fn schedule(id: String, timer: UiTimer, ms: Int, msg: msg) -> Cmd(msg):
    match timer:
        UiTimer(min_ms) ->
            let safe_ms = if ms < min_ms: min_ms else: ms
            AfterStable(id, timer, safe_ms, msg)

pub fn cancel_cmd(id: String) -> Cmd(msg):
    CancelCmd(id)

// Keep command work alive at the application root if the structural feature
// that emitted it leaves before completion. The optimized compiler retains
// this explicit lifecycle choice in its private owner envelope.
pub fn detach(command: Cmd(msg)) -> Cmd(msg):
    DetachedCmd(command)

// Navigate to `path`, then deliver the typed completion through `on_done`.
pub fn navigate(id: String, route: UiRoute, path: String, on_done: fn(NavigationResult) -> msg) -> Cmd(msg):
    // (BUG-017) Enforce the `UiRoute` token's `base` at construction — a path outside the
    // authorized base is FAIL CLOSED to `NoCmd`. The host re-checks the wired `base`.
    match route:
        UiRoute(base, _rights) ->
            if path.starts_with(base):
                NavigationTask(id, route, path, on_done)
            else:
                NoCmd

// Compatibility navigation relies on the host's global route tag.
pub fn navigate_compat(route: UiRoute, path: String) -> Cmd(msg):
    match route:
        UiRoute(base, _rights) ->
            if path.starts_with(base):
                Nav(route, path)
            else:
                NoCmd

// Run a host-shell port (session login, WebAuthn, storage) with `arg`; the shell dispatches
// the typed result through `on_done`. The port NAME is carried by the
// `CredentialPort` token (minted by `credential_port`), not passed here — so a component can
// only invoke the exact port it was granted. Authority stays in the host; the rune never
// sees the credential, only the outcome.
pub fn port(id: String, cred: CredentialPort, arg: String, on_done: fn(PortResult) -> msg) -> Cmd(msg):
    PortTask(id, cred, arg, on_done)

// Generic source API for the locked host-adapter registry. Optimized browser
// compilation replaces the call with a numeric authenticated descriptor. The
// compatibility oracle reports deterministic unavailability and never invokes a
// browser credential API or returns credential material.
pub fn host_port(id: String, authority: HostPort(request, result), request: request, on_done: fn(Result(result, String)) -> msg) -> Cmd(msg):
    match authority:
        HostPort(_adapter, _endpoint, _maximum_request_bytes, _maximum_result_bytes) ->
            if id == "":
                NoCmd
            else:
                Immediate(on_done(Err("typed host port requires optimized browser publication")))

pub fn port_compat(cred: CredentialPort, arg: String, on_done: String) -> Cmd(msg):
    Port(cred, arg, on_done)

// (RFC-0039) An opaque handle to the host-held secret named by `input`. The rune can pass
// it to `submit_secret`, but — `SecretRef` being a sealed capability of this module — a
// consuming component can never unwrap it to read the bytes or even the slot. Only Glamour
// mints it, and only from a `SecretInput` the component already holds, so the handle can
// never outrun the render authority that produced the secret.
pub fn secret_ref(input: SecretInput) -> SecretRef:
    match input:
        // (BUG-273) Collision-free slot encoding so two distinct `(form, field)` pairs can
        // never map to the same host-custody key (see `slot_encode`).
        SecretInput(form, field) -> SecretRef(slot_encode(form, field))

// (RFC-0039) Submit the host-held secret (named by `secret`) to a host credential `port`.
// The shell reads the value out of its OWN custody and hands it to the port, dispatching
// `on_done(result)` back — the rune never sees the bytes, only the outcome.
pub fn submit_secret(id: String, secret: SecretRef, cred: CredentialPort, on_done: fn(PortResult) -> msg) -> Cmd(msg):
    SecretTask(id, secret, cred, on_done)

fn storage_key_allowed(storage: UiStorage, key: String) -> Bool:
    match storage:
        UiStorage(_provider, _namespace, key_prefix, _maximum) ->
            !key.contains("\0") && bytes.from_string(key).length() <= 256 && key.starts_with(key_prefix)

pub fn storage_get(id: String, storage: UiStorage, key: String, on_done: fn(StorageResult) -> msg) -> Cmd(msg):
    if storage_key_allowed(storage, key):
        StorageGetTask(id, storage, key, on_done)
    else:
        NoCmd

pub fn storage_set(id: String, storage: UiStorage, key: String, value: String, on_done: fn(StorageResult) -> msg) -> Cmd(msg):
    match storage:
        UiStorage(_provider, _namespace, _key_prefix, maximum) ->
            if storage_key_allowed(storage, key) && bytes.from_string(value).length() <= maximum:
                StorageSetTask(id, storage, key, value, on_done)
            else:
                NoCmd

pub fn storage_remove(id: String, storage: UiStorage, key: String, on_done: fn(StorageResult) -> msg) -> Cmd(msg):
    if storage_key_allowed(storage, key):
        StorageRemoveTask(id, storage, key, on_done)
    else:
        NoCmd

// The compatibility oracle evaluates the capability-free task deterministically
// and queues its typed result. Optimized browser compilation replaces this exact
// direct call with an authenticated worker descriptor before execution.
pub fn worker(id: String, authority: UiWorker, task: fn(request) -> output, input: request, on_done: fn(Result(output, String)) -> msg) -> Cmd(msg):
    match authority:
        UiWorker(_name, _max_request_bytes, _max_result_bytes, _max_concurrency, _timeout_ms) ->
            if id == "":
                NoCmd
            else:
                Immediate(on_done(Ok(task(input))))

// Compiler-specialized constructors bind authenticated descriptor and
// completion identities into ordinary typed Cmd/Sub values. Source APIs keep
// their ergonomic signatures; only the island artifact rewrite calls these.
pub fn island_cmd_after(descriptor: Int, completion: Int, timer: UiTimer, milliseconds: Int, environment: IslandCapture) -> Cmd(msg):
    match timer:
        UiTimer(minimum) -> IslandAfter(descriptor, completion, timer, if milliseconds < minimum: minimum else: milliseconds, environment)

pub fn island_cmd_schedule(descriptor: Int, completion: Int, id: String, timer: UiTimer, milliseconds: Int, environment: IslandCapture) -> Cmd(msg):
    match timer:
        UiTimer(minimum) -> IslandAfterStable(descriptor, completion, id, timer, if milliseconds < minimum: minimum else: milliseconds, environment)

pub fn island_cmd_http(descriptor: Int, completion: Int, owner: Int, id: String, fetch: UiFetch, method: String, url: String, body: String, environment: IslandCapture) -> Cmd(msg):
    match fetch:
        UiFetch(_scope, methods, prefix) ->
            if method_allowed(methods, method) && url.starts_with(prefix):
                IslandHttpTask(descriptor, completion, owner, id, fetch, method, url, body, environment)
            else:
                NoCmd

pub fn island_cmd_navigate(descriptor: Int, completion: Int, owner: Int, id: String, route: UiRoute, path: String, environment: IslandCapture) -> Cmd(msg):
    match route:
        UiRoute(base, _rights) ->
            if path.starts_with(base):
                IslandNavigationTask(descriptor, completion, owner, id, route, path, environment)
            else:
                NoCmd

pub fn island_cmd_navigate_route(descriptor: Int, completion: Int, owner: Int, id: String, authority: UiRoute, route: RouteDef, values: List((String, String)), environment: IslandCapture) -> Cmd(msg):
    match route_url(route, values):
        Ok(destination) ->
            match destination:
                SafeUrl(path) -> island_cmd_navigate(descriptor, completion, owner, id, authority, path, environment)
        Err(_error) -> NoCmd

pub fn island_cmd_port(descriptor: Int, completion: Int, id: String, credential: CredentialPort, argument: String, environment: IslandCapture) -> Cmd(msg):
    IslandPortTask(descriptor, completion, id, credential, argument, environment)

pub fn island_cmd_host_port(descriptor: Int, completion: Int, id: String, authority: HostPort(request, result), request: IslandCapture, environment: IslandCapture) -> Cmd(msg):
    match authority:
        HostPort(adapter, endpoint, maximum_request_bytes, maximum_result_bytes) -> IslandHostPortTask(descriptor, completion, id, adapter, endpoint, maximum_request_bytes, maximum_result_bytes, request, environment)

pub fn island_cmd_submit_secret(descriptor: Int, completion: Int, id: String, secret: SecretRef, credential: CredentialPort, environment: IslandCapture) -> Cmd(msg):
    IslandSecretTask(descriptor, completion, id, secret, credential, environment)

pub fn island_cmd_storage_get(descriptor: Int, completion: Int, id: String, storage: UiStorage, key: String, environment: IslandCapture) -> Cmd(msg):
    if storage_key_allowed(storage, key):
        IslandStorageGetTask(descriptor, completion, id, storage, key, environment)
    else:
        NoCmd

pub fn island_cmd_storage_set(descriptor: Int, completion: Int, id: String, storage: UiStorage, key: String, value: String, environment: IslandCapture) -> Cmd(msg):
    match storage:
        UiStorage(_provider, _namespace, _key_prefix, maximum) ->
            if storage_key_allowed(storage, key) && bytes.from_string(value).length() <= maximum:
                IslandStorageSetTask(descriptor, completion, id, storage, key, value, environment)
            else:
                NoCmd

pub fn island_cmd_storage_remove(descriptor: Int, completion: Int, id: String, storage: UiStorage, key: String, environment: IslandCapture) -> Cmd(msg):
    if storage_key_allowed(storage, key):
        IslandStorageRemoveTask(descriptor, completion, id, storage, key, environment)
    else:
        NoCmd

pub fn island_cmd_worker(descriptor: Int, completion: Int, id: String, worker: UiWorker, request: IslandCapture, environment: IslandCapture) -> Cmd(msg):
    if id == "":
        NoCmd
    else:
        IslandWorkerTask(descriptor, completion, id, worker, request, environment)

pub fn island_sub_every(descriptor: Int, completion: Int, id: String, timer: UiTimer, milliseconds: Int, environment: IslandCapture) -> Sub(msg):
    match timer:
        UiTimer(minimum) -> IslandEvery(descriptor, completion, id, timer, if milliseconds < minimum: minimum else: milliseconds, environment)

pub fn submit_secret_compat(secret: SecretRef, cred: CredentialPort, on_done: String) -> Cmd(msg):
    SubmitSecret(secret, cred, on_done)

// ---------------------------------------------------------------------------
// Serializer — render a VNode tree to an HTML string. There is no browser here,
// so this is how the structural safety becomes OBSERVABLE in tests: text content
// is escaped, so a text-node hole containing `<script>` renders as the literal
// characters `&lt;script&gt;`, never executable markup.
// ---------------------------------------------------------------------------
pub fn to_html(node: VNode(msg)) -> String:
    // idiom-exempt: rendering assembles exact HTML bytes after escaping each dynamic field.
    match node:
        Planned(_plan, inner) -> to_html(inner)
        // (BUG-272) The renderer is a REGISTRY KEY, not URL path material. Validate it as
        // an opaque, non-path id; a value carrying `/`, `.`, `%`, `?`, `#` (which URL
        // resolution could normalize out of the `/compartments/<id>/` namespace) is FAIL
        // CLOSED to an inert `about:blank` frame instead of a crafted path.
        Text(s) -> escape_text(s)
        Compartment(renderer, _grant, _on) ->
            if valid_renderer_id(renderer):
                "<iframe sandbox=\"allow-scripts\" class=\"glamour-compartment\" src=\"/compartments/" + renderer + "/\"></iframe>"
            else:
                "<iframe sandbox=\"allow-scripts\" class=\"glamour-compartment\" src=\"about:blank\"></iframe>"
        FrameCompartment(renderer, _max_grant, _max_event, _grant, fallback, id, _decoder) ->
            "<iframe sandbox=\"allow-scripts\" class=\"glamour-compartment\" data-glamour-frame-renderer=\"" + escape_attr(renderer) + "\" data-glamour-frame-event=\"" + escape_attr(id) + "\">" + fallback + "</iframe>"
        Keyed(_key, inner) -> to_html(inner)
        Branch(_id, active, inner) -> if active: to_html(inner) else: ""
        ChildRegion(_id, _template, child) ->
            match child:
                Some(inner) -> to_html(inner)
                None -> ""
        SecretField(_input, _on_ready) -> "<input type=\"password\" class=\"glamour-secret\"></input>"
        Slot(kind, data) -> "<pre class=\"glamour-slot\" data-glamour-slot-kind=\"" + escape_attr(kind) + "\"><code>" + escape_text(data) + "</code></pre>"
        IslandBoundary(markup) ->
            match markup:
                IslandMarkup(key, html, _resume, _templates) -> "<div data-glamour-island-key=\"" + escape_attr(key) + "\">" + html + "</div>"
        InteractiveBoundary(plan) ->
            match plan:
                IslandPlan(_key, _source_origin, _activation, _prefetch, _name, _start, markup) ->
                    match markup:
                        IslandMarkup(key, html, _resume, _templates) -> "<div data-glamour-island-key=\"" + escape_attr(key) + "\">" + html + "</div>"
        Element(tag, attrs, children) -> render_element(tag, attrs, children)

// A static site is an ordinary, closed Witchy value. Each page is rendered
// eagerly while `web()` runs on the capability-free native build evaluator, so
// no message representation or browser closure enters the build manifest.
type StaticPage:
    StaticPage(String, String, List(String), List(IslandPlan))

type StaticActionField:
    StaticActionField(String, String, String, Bool)

type StaticAction:
    StaticAction(String, String, String, List(StaticActionField))

// A stylesheet is attached only to the declared routes. Routes in
// `critical_routes` receive the checked rules inline; the remaining routes
// receive one content-addressed extracted asset. Keeping both sets explicit
// makes critical-CSS decisions reviewable build data rather than a heuristic.
type StaticStyle:
    StaticStyle(CssSheet, List(String), List(String))

type StaticPreloadKind:
    PreloadStyle
    PreloadFont
    PreloadImage

type StaticPreload:
    StaticPreload(String, String, String)

type StaticAsset:
    StaticAsset(String)

// A declared static-build input is snapshotted by the Witchy build tool and
// crosses the compiler boundary as inert data. Paths are normalized relative
// to the declared content root; no file handle or ambient read authority enters
// application code.
type StaticContentFile:
    StaticContentFile(String, String)

type StaticContent:
    StaticContent(List(StaticContentFile))

type Site:
    Site(List(StaticPage), List(StaticAction), List(StaticStyle), List(StaticPreload), List(StaticAsset), List(IslandPlan))

pub fn static_content_files(content: StaticContent) -> List(StaticContentFile):
    match content:
        StaticContent(files) -> files

pub fn static_content_path(file: StaticContentFile) -> String:
    match file:
        StaticContentFile(path, _text) -> path

pub fn static_content_text(file: StaticContentFile) -> String:
    match file:
        StaticContentFile(_path, text) -> text

pub fn static_content_get(content: StaticContent, path: String) -> Option(String):
    for file in static_content_files(content):
        if static_content_path(file) == path:
            return Some(static_content_text(file))
    None

pub fn static_page(path: String, body: Ui(msg)) -> StaticPage:
    let node = rekey_interactive(ui_node(body), path, "root")
    StaticPage(path, "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"></head><body>" + to_html(node) + "</body></html>", island_keys(node), interactive_plans(node))

fn rekey_interactive(node: VNode(msg), route: String, scope: String) -> VNode(msg):
    match node:
        Planned(plan, inner) ->
            match plan:
                TemplatePlan(id, _origin, _slots) -> Planned(plan, rekey_interactive(inner, route, scope + "." + id))
        Keyed(key, inner) -> Keyed(key, rekey_interactive(inner, route, scope + ".keyed"))
        Branch(id, active, inner) -> Branch(id, active, rekey_interactive(inner, route, scope + ".branch"))
        ChildRegion(id, template, child) ->
            let next_template = rekey_interactive(template, route, scope + ".template")
            let next_child = match child:
                Some(inner) -> Some(rekey_interactive(inner, route, scope + ".child"))
                None -> None

            ChildRegion(id, next_template, next_child)
        InteractiveBoundary(plan) ->
            match plan:
                IslandPlan(_key, source_origin, activation, prefetch, name, start, markup) ->
                    let key = "interactive-" + crypto.sha256(route + "|" + scope)
                    match markup:
                        IslandMarkup(_markup_key, html, resume, templates) -> InteractiveBoundary(IslandPlan(key, source_origin, activation, prefetch, name, start, IslandMarkup(key, html, resume, templates)))
        Element(tag, attrs, children) ->
            var next: List(VNode(msg)) = []
            var index = 0
            for child in children:
                next.push(rekey_interactive(child, route, scope + ".${index}"))
                index = index + 1
            Element(tag, attrs, next)
        Text(value) -> Text(value)
        Compartment(renderer, grant, on_event) -> Compartment(renderer, grant, on_event)
        FrameCompartment(renderer, max_grant, max_event, grant, fallback, id, decoder) -> FrameCompartment(renderer, max_grant, max_event, grant, fallback, id, decoder)
        SecretField(input, on_ready) -> SecretField(input, on_ready)
        Slot(kind, data) -> Slot(kind, data)
        IslandBoundary(markup) -> IslandBoundary(markup)

fn island_keys(node: VNode(msg)) -> List(String):
    match node:
        Planned(_plan, inner) -> island_keys(inner)
        Keyed(_key, inner) -> island_keys(inner)
        Branch(_id, active, inner) -> if active: island_keys(inner) else: []
        ChildRegion(_id, _template, child) ->
            match child:
                Some(inner) -> island_keys(inner)
                None -> []
        IslandBoundary(markup) ->
            match markup:
                IslandMarkup(key, _html, _resume, _templates) -> [key]
        InteractiveBoundary(plan) ->
            match plan:
                IslandPlan(key, _source_origin, _activation, _prefetch, _name, _start, _markup) -> [key]
        Element(_tag, _attrs, children) ->
            var keys: List(String) = []
            for child in children:
                keys = list.concat(keys, island_keys(child))
            keys
        _ -> []

fn interactive_plans(node: VNode(msg)) -> List(IslandPlan):
    match node:
        Planned(_plan, inner) -> interactive_plans(inner)
        Keyed(_key, inner) -> interactive_plans(inner)
        Branch(_id, active, inner) -> if active: interactive_plans(inner) else: []
        ChildRegion(_id, _template, child) ->
            match child:
                Some(inner) -> interactive_plans(inner)
                None -> []
        InteractiveBoundary(plan) -> [plan]
        Element(_tag, _attrs, children) ->
            var plans: List(IslandPlan) = []
            for child in children:
                plans = list.concat(plans, interactive_plans(child))
            plans
        _ -> []

fn page_interactive_plans(pages: List(StaticPage)) -> List(IslandPlan):
    var plans: List(IslandPlan) = []
    for page in pages:
        match page:
            StaticPage(_path, _html, _keys, page_plans) -> plans = list.concat(plans, page_plans)
    plans

pub fn site(pages: List(StaticPage)) -> Site:
    Site(pages, [], [], [], [], page_interactive_plans(pages))

pub fn site_with_forms(pages: List(StaticPage), forms: List(FormSchema)) -> Site:
    Site(pages, forms.map(static_action), [], [], [], page_interactive_plans(pages))

pub fn stylesheet(sheet: CssSheet, routes: List(String)) -> StaticStyle:
    StaticStyle(sheet, routes, [])

pub fn critical_stylesheet(sheet: CssSheet, routes: List(String)) -> StaticStyle:
    StaticStyle(sheet, routes, routes)

pub fn routed_stylesheet(sheet: CssSheet, routes: List(String), critical_routes: List(String)) -> StaticStyle:
    StaticStyle(sheet, routes, critical_routes)

pub fn static_preload(route: String, asset: SafeUrl(AssetUrl), kind: StaticPreloadKind) -> StaticPreload:
    StaticPreload(route, safe_url_string(asset), static_preload_kind(kind))

pub fn static_asset(asset: SafeUrl(AssetUrl)) -> StaticAsset:
    StaticAsset(safe_url_string(asset))

pub fn site_with_resources(pages: List(StaticPage), forms: List(FormSchema), styles: List(StaticStyle), preloads: List(StaticPreload)) -> Site:
    Site(pages, forms.map(static_action), styles, preloads, [], page_interactive_plans(pages))

pub fn site_with_assets(pages: List(StaticPage), forms: List(FormSchema), styles: List(StaticStyle), assets: List(StaticAsset), preloads: List(StaticPreload)) -> Site:
    Site(pages, forms.map(static_action), styles, preloads, assets, page_interactive_plans(pages))

pub fn with_islands(site: Site, islands: List(IslandPlan)) -> Site:
    match site:
        Site(pages, actions, styles, preloads, assets, existing) -> Site(pages, actions, styles, preloads, assets, list.concat(existing, islands))

fn static_preload_kind(kind: StaticPreloadKind) -> String:
    match kind:
        PreloadStyle -> "style"
        PreloadFont -> "font"
        PreloadImage -> "image"

fn static_action(schema: FormSchema) -> StaticAction:
    match schema:
        FormSchema(id, method, action, fields) ->
            StaticAction(id, method, safe_url_string(action), fields.map(static_action_field))

fn static_action_field(field: FormField) -> StaticActionField:
    match field:
        FormField(name, label, kind, required) ->
            StaticActionField(name, label, static_action_field_kind(kind), required)

fn static_action_field_kind(kind: FormFieldKind) -> String:
    match kind:
        FormText -> "text"
        FormEmail -> "email"
        FormNumber -> "number"
        FormCheckbox -> "checkbox"
        FormSecret -> "secret"

// A foreign-code compartment renders as a locked-down iframe; the grant/event
// channel is wired by the JS host at runtime (it never enters the HTML).

// The key is a diff hint only — render the inner node.

// A secret field renders as an INERT password input carrying no value — the typed
// bytes live only in host custody, never in this (or any) rune-produced string.

// A host slot has no static HTML (the host mounts its widget at runtime); the
// fallback shows the payload as an inert, escaped code block so a no-JS render still
// presents the source.
fn render_element(tag: String, attrs: List(Attr(msg)), children: List(VNode(msg))) -> String:
    // (BUG-259) FAIL CLOSED: `element(tag, …)` takes an arbitrary `String`, so a crafted
    // name (` onload=x`, `a"><script`) could otherwise break out of the static-HTML string
    // boundary. Validate the tag against the name allowlist; an invalid one is inertized to
    // a `<span>` that records the rejected name as an escaped, non-executable data attribute.
    let ok_tag = valid_tag_name(tag)
    let emit_tag = if ok_tag: tag else: "span"
    var out = "<" + emit_tag
    if !ok_tag:
        out = out + " data-glamour-invalid-tag=\"" + escape_attr(tag) + "\""
    for a in attrs:
        out = out + render_attr(a)
    if children.is_empty():
        out + "></" + emit_tag + ">"
    else:
        out = out + ">"
        for c in children:
            out = out + to_html(c)
        out + "</" + emit_tag + ">"

fn render_attr(a: Attr(msg)) -> String:
    match a:
        Attribute(name, value) -> render_named_attr(name, value)
        BooleanAttribute(name, enabled) ->
            if enabled && valid_attr_name(name):
                " " + name + "=\"\""
            else:
                ""
        Property(name, value) -> render_named_attr(name, value)
        UrlAttribute(name, value) -> render_named_attr(name, safe_url_or_hash(value))
        ClassAttribute(names) -> render_named_attr("class", names.join(" "))
        AriaAttribute(name, value) ->
            if name.starts_with("aria-"):
                render_named_attr(name, value)
            else:
                ""
        CustomProperties(assignments) -> render_named_attr("style", css_assignment_text(assignments))
        // (BUG-259) An attribute/event NAME is validated against the allowlist so it can
        // never break the `name="value"` boundary; a rejected name is dropped in favor of an
        // inert `data-glamour-invalid-*` marker (the value is still escaped as before).
        Prop(name, value) ->
            if valid_attr_name(name):
                " " + name + "=\"" + escape_attr(value) + "\""
            else:
                " data-glamour-invalid-attr=\"" + escape_attr(name) + "\""
        On(event, _msg) ->
            if valid_tag_name(event):
                ""
            else:
                " data-glamour-invalid-event=\"[msg]\""
        OnInput(event, _tag) ->
            if valid_tag_name(event):
                ""
            else:
                " data-glamour-invalid-event=\"[input]\""
        OnDecoded(_id, event, _decoder) ->
            if valid_tag_name(event):
                ""
            else:
                " data-glamour-invalid-event=\"[decoder]\""

fn render_named_attr(name: String, value: String) -> String:
    if valid_attr_name(name):
        " " + name + "=\"" + escape_attr(value) + "\""
    else:
        " data-glamour-invalid-attr=\"" + escape_attr(name) + "\""

// (BUG-259) NAME allowlists — the load-bearing complement to value escaping. Value escaping
// (`escape_attr`) keeps a value from breaking its quotes; these keep a NAME from breaking the
// tag/attribute structure itself. A tag/event name must start with an ASCII letter and then
// contain only ASCII letters, digits, or `-`. An attribute name may also carry `_ : .` (for
// `data-*`, `aria-*`, namespaced attrs) — none of which can break the `name="value"` boundary,
// whereas a space, quote, `<`, `>`, `=`, or `/` can.
fn name_alpha() -> String:
    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

fn valid_tag_name(name: String) -> Bool:
    // idiom-exempt: these suffixes define the accepted character sets.
    valid_name_with(name, name_alpha() + "0123456789-")

fn valid_attr_name(name: String) -> Bool:
    valid_name_with(name, name_alpha() + "0123456789-_:.")

fn safe_navigation_url(value: String) -> Result(String, UrlError):
    let normalized = value.trim()
    if unsafe_url_prefix(normalized):
        Err(UnsafeUrl(value))
    else if allowed_relative_url(normalized) || normalized.to_lower().starts_with("https://") || normalized.to_lower().starts_with("http://") || normalized.to_lower().starts_with("mailto:") || normalized.to_lower().starts_with("tel:"):
        Ok(normalized)
    else:
        Err(UnsafeUrl(value))

fn safe_form_url(value: String) -> Result(String, UrlError):
    let normalized = value.trim()
    if unsafe_url_prefix(normalized):
        Err(UnsafeUrl(value))
    else if allowed_relative_url(normalized) || normalized.to_lower().starts_with("https://") || normalized.to_lower().starts_with("http://"):
        Ok(normalized)
    else:
        Err(UnsafeUrl(value))

fn safe_asset_url(value: String) -> Result(String, UrlError):
    let normalized = value.trim()
    let lower = normalized.to_lower()
    if unsafe_url_prefix(normalized):
        Err(UnsafeUrl(value))
    else if allowed_relative_url(normalized) || lower.starts_with("https://") || lower.starts_with("http://") || lower.starts_with("data:image/png;") || lower.starts_with("data:image/jpeg;") || lower.starts_with("data:image/jpg;") || lower.starts_with("data:image/gif;") || lower.starts_with("data:image/webp;"):
        Ok(normalized)
    else:
        Err(UnsafeUrl(value))

fn unsafe_url_prefix(value: String) -> Bool:
    value.contains("\n") || value.contains("\r") || value.contains("\t") || value.starts_with("//") || value.starts_with("\\\\") || value.starts_with("/\\") || value.starts_with("\\/")

fn allowed_relative_url(value: String) -> Bool:
    match value.index_of(":"):
        None -> true
        Some(colon) ->
            let slash = value.index_of("/")
            let query = value.index_of("?")
            let fragment = value.index_of("#")
            delimiter_before(slash, colon) || delimiter_before(query, colon) || delimiter_before(fragment, colon)

fn delimiter_before(position: Option(Int), boundary: Int) -> Bool:
    match position:
        Some(index) -> index < boundary
        None -> false

fn safe_url_or_hash(value: String) -> String:
    match safe_navigation_url(value):
        Ok(url) -> url
        Err(_) ->
            match safe_asset_url(value):
                Ok(url) -> url
                Err(_) -> "#"

fn valid_class_token(name: String) -> Bool:
    !name.is_empty() && !name.contains(" ") && !name.contains("\t") && !name.contains("\n") && !name.contains("\r") && !name.contains("\"") && !name.contains("'") && !name.contains("<") && !name.contains(">")

fn valid_name_with(name: String, allowed_rest: String) -> Bool:
    if name.is_empty():
        false
    else:
        let cs = name.chars()
        var ok = name_alpha().contains(cs.at(0))
        var i = 1
        let n = cs.length()
        while i < n:
            if !allowed_rest.contains(cs.at(i)):
                ok = false
            i = i + 1
        ok

// A static/property attribute. The value is attribute-escaped so a `"`
// can't break out of the quoted value.

// An event binding is data for the host shell and has no static HTML surface.
// Valid bindings are omitted; malformed event names retain an inert diagnostic
// marker matching the client DOM host's fail-closed behavior.

// Escape text content: the four characters that could otherwise be parsed as
// markup. This is the load-bearing line for XSS-immunity being observable.
fn escape_text(s: String) -> String:
    var out = s.replace("&", "&amp;")
    out = out.replace("<", "&lt;")
    out = out.replace(">", "&gt;")
    out

// Escape an attribute value: as text, plus the quote that delimits the value.
fn escape_attr(s: String) -> String:
    var out = escape_text(s)
    out = out.replace("\"", "&quot;")
    out

// (BUG-272) A compartment renderer id must be a REGISTRY KEY, never URL path material:
// lowercase ASCII alnum, `-`, `_`, starting with an alnum, non-empty. This grammar excludes
// `/`, `.`, `%`, `?`, `#` and whitespace, so the id can never escape the `/compartments/<id>/`
// namespace (browser URL resolution can normalize `..`/dot-segments out of a path). The JS
// host re-checks the same grammar at the live iframe sink.
fn valid_renderer_id(id: String) -> Bool:
    // idiom-exempt: these literals define the renderer-id character set.
    if id.is_empty():
        false
    else:
        let cs = id.chars()
        let lead = "abcdefghijklmnopqrstuvwxyz0123456789"
        let rest = lead + "-_"
        var ok = lead.contains(cs.at(0))
        var i = 1
        let n = cs.length()
        while i < n:
            if !rest.contains(cs.at(i)):
                ok = false
            i = i + 1
        ok

// (BUG-273) Encode a secret slot from its `(form, field)` coordinates so distinct pairs can
// NEVER collide. A raw `form + "/" + field` join lets `("a/b","c")` and `("a","b/c")` collapse
// to the same key; here each component's `%` and `/` are percent-escaped first, so the `/`
// separator is unambiguous and the mapping is injective. The JS host mirrors this exact
// encoding (`secretSlot`), so `secret_ref` and the rendered `SecretField` name the same slot.
fn slot_encode(form: String, field: String) -> String:
    // idiom-exempt: this is a collision-resistant encoded key, not presentation text.
    slot_escape(form) + "/" + slot_escape(field)

fn slot_escape(s: String) -> String:
    var out = s.replace("%", "%25")
    out = out.replace("/", "%2F")
    out

// (BUG-017) A fetch token's method-set membership test. `methods` is a set spelled with any of
// `,`/`space`/`|` as separators (e.g. "GET", "GET,POST", "GET POST"); a method is allowed only
// if it appears as a whole token. Case-normalized to the uppercase HTTP-verb convention.
fn method_allowed(methods: String, method: String) -> Bool:
    // idiom-exempt: delimiters make the comma-separated membership check exact.
    let norm = methods.to_upper().replace(" ", ",").replace("|", ",")
    ("," + norm + ",").contains("," + method.to_upper() + ",")

fn decoder_kind(decoder: Decoder(msg)) -> String:
    match decoder:
        Emit(_) -> "msg"
        Value(_) -> "value"
        Checked(_) -> "checked"
        Key(_) -> "key"
        FilterKey(_, inner) -> decoder_kind(inner)
        PreventDefault(inner) -> decoder_kind(inner)
        StopPropagation(inner) -> decoder_kind(inner)

fn decoder_prevents_default(decoder: Decoder(msg)) -> Bool:
    match decoder:
        PreventDefault(_) -> true
        FilterKey(_, inner) -> decoder_prevents_default(inner)
        StopPropagation(inner) -> decoder_prevents_default(inner)
        _ -> false

fn decoder_stops_propagation(decoder: Decoder(msg)) -> Bool:
    match decoder:
        StopPropagation(_) -> true
        FilterKey(_, inner) -> decoder_stops_propagation(inner)
        PreventDefault(inner) -> decoder_stops_propagation(inner)
        _ -> false

fn decode_event(decoder: Decoder(msg), data: EventData) -> Option(msg):
    match decoder:
        Emit(message) -> Some(message)
        Value(to_message) ->
            match data:
                EventData(value, _checked, _key) -> Some(to_message(value))
        Checked(to_message) ->
            match data:
                EventData(_value, checked, _key) -> Some(to_message(checked))
        Key(to_message) ->
            match data:
                EventData(_value, _checked, key) -> Some(to_message(key))
        FilterKey(expected, inner) ->
            match data:
                EventData(_value, _checked, key) ->
                    if key == expected:
                        decode_event(inner, data)
                    else:
                        None
        PreventDefault(inner) -> decode_event(inner, data)
        StopPropagation(inner) -> decode_event(inner, data)

fn find_decoder(node: VNode(msg), id: String) -> Option(Decoder(msg)):
    match node:
        Planned(_plan, inner) -> find_decoder(inner, id)
        Keyed(_key, inner) -> find_decoder(inner, id)
        Branch(_branch_id, active, inner) -> if active: find_decoder(inner, id) else: None
        ChildRegion(_child_id, _template, child) ->
            match child:
                Some(inner) -> find_decoder(inner, id)
                None -> None
        Element(_tag, attrs, children) ->
            var found: Option(Decoder(msg)) = None
            for attr in attrs:
                if let OnDecoded(candidate, _event, decoder) = attr:
                    if candidate == id:
                        found = Some(decoder)
            for child in children:
                match found:
                    Some(_) -> Nil
                    None -> found = find_decoder(child, id)
            found
        _ -> None

// Compiler-owned resumable-island adapters use these closed records. The
// browser sends only an authenticated numeric plan plus allowlisted scalar
// event data; the matching typed Decoder and message remain inside Witchy.
type IslandEventInput:
    IslandEventInput(Int, Int, Int, String, Bool, String)

type IslandCompletionInput:
    IslandCompletionInput(Int, Int, Int, Int, Int, Int, Bytes)

type IslandEventDescriptor:
    IslandEventDescriptor(Int, Int, Int, String, String, String, Bool, Bool)

type IslandTextNode:
    IslandTextNode(List(Int), Int)

type IslandAttributeSink:
    IslandAttributeSink(List(Int), Int, Int, String, String, Int)

type IslandTemplateSlot:
    IslandTemplateTextSlot(Int, List(Int))
    IslandTemplateAttributeSlot(Int, List(Int), Int, String, String)

type IslandSlotValue:
    IslandSlotValue(Int, String)

type IslandRegionKey:
    IslandRegionKey(String, Int, Int, List(Int), List(IslandTemplateSlot))

type IslandRegion:
    IslandListRegion(List(Int), Int, Int, List(IslandRegionKey), IslandRegionKey)
    IslandBranchRegion(List(Int), Int, Int, Int, Int, List(Int), List(IslandTemplateSlot))
    IslandChildRegion(List(Int), Int, Int, Int, Int, List(Int), List(IslandTemplateSlot))

type IslandPatchWork(msg):
    IslandPatchWork(VNode(msg), VNode(msg), VNode(msg), List(Int))

type IslandPatchChange:
    IslandPatchText(Int, String)
    IslandPatchString(Int, Int, Int, String)
    IslandPatchBoolean(Int, Int, Bool)
    IslandPatchClass(Int, String)
    IslandPatchListMove(Int, Int, Int)
    IslandPatchListRemove(Int, Int)
    IslandPatchListInsert(Int, Int, Int, Int, Int, List(IslandSlotValue))
    IslandPatchDynamicInsert(Int, String, String, Int, List(IslandSlotValue))
    IslandPatchDynamicMove(Int, String, String)
    IslandPatchDynamicRemove(Int, String)
    IslandPatchDynamicSlots(Int, String, List(IslandSlotValue))
    IslandPatchEnterBranch(Int, Int, Int, List(IslandSlotValue))
    IslandPatchLeaveBranch(Int)
    IslandPatchMountChild(Int, Int, Int, List(IslandSlotValue))
    IslandPatchUnmountChild(Int)
    IslandPatchSetEventPlan(Int, Int, Int)
    IslandPatchRemoveEventPlan(Int, Int)

type IslandHostWork:
    IslandStartEffect(Int, Int, Int, String)
    IslandCancelEffect(Int)
    IslandSyncSubscription(Int, Int, String)
    IslandRemoveSubscription(Int)

pub fn island_text_node(path: List(Int), id: Int) -> IslandTextNode:
    IslandTextNode(path, id)

pub fn island_event_descriptor(plan: Int, node: Int, event_class: Int, id: String, event: String, kind: String, prevent_default: Bool, stop_propagation: Bool) -> IslandEventDescriptor:
    IslandEventDescriptor(plan, node, event_class, id, event, kind, prevent_default, stop_propagation)

fn island_wire_u32(value: Int, zero_allowed: Bool) -> Bool:
    let minimum = if zero_allowed: 0 else: 1
    value >= minimum && value <= 4294967295

pub fn island_start_effect(instance: Int, cancellation_key: Int, descriptor: Int, request: String) -> IslandHostWork:
    if !island_wire_u32(instance, false) || !island_wire_u32(cancellation_key, true) || !island_wire_u32(descriptor, false):
        fail("glamour island: effect work has an invalid identity")
    IslandStartEffect(instance, cancellation_key, descriptor, request)

pub fn island_cancel_effect(cancellation_key: Int) -> IslandHostWork:
    if !island_wire_u32(cancellation_key, false):
        fail("glamour island: effect cancellation has an invalid identity")
    IslandCancelEffect(cancellation_key)

pub fn island_sync_subscription(subscription: Int, descriptor: Int, request: String) -> IslandHostWork:
    if !island_wire_u32(subscription, false) || !island_wire_u32(descriptor, false):
        fail("glamour island: subscription work has an invalid identity")
    IslandSyncSubscription(subscription, descriptor, request)

pub fn island_remove_subscription(subscription: Int) -> IslandHostWork:
    if !island_wire_u32(subscription, false):
        fail("glamour island: subscription removal has an invalid identity")
    IslandRemoveSubscription(subscription)

pub fn island_attribute_sink(path: List(Int), node: Int, index: Int, kind: String, name: String, id: Int) -> IslandAttributeSink:
    IslandAttributeSink(path, node, index, kind, name, id)

pub fn island_template_text_slot(id: Int, path: List(Int)) -> IslandTemplateSlot:
    IslandTemplateTextSlot(id, path)

pub fn island_template_attribute_slot(id: Int, path: List(Int), index: Int, kind: String, name: String) -> IslandTemplateSlot:
    IslandTemplateAttributeSlot(id, path, index, kind, name)

pub fn island_region_key(source: String, id: Int, template: Int, path: List(Int), slots: List(IslandTemplateSlot)) -> IslandRegionKey:
    IslandRegionKey(source, id, template, path, slots)

pub fn island_no_dynamic_key() -> IslandRegionKey:
    IslandRegionKey("", 0, 0, [], [])

pub fn island_region(path: List(Int), id: Int, parent: Int, keys: List(IslandRegionKey), dynamic: IslandRegionKey) -> IslandRegion:
    IslandListRegion(path, id, parent, keys, dynamic)

pub fn island_branch_region(path: List(Int), id: Int, parent: Int, template: Int, instance: Int, child_path: List(Int), slots: List(IslandTemplateSlot)) -> IslandRegion:
    IslandBranchRegion(path, id, parent, template, instance, child_path, slots)

pub fn island_child_region(path: List(Int), id: Int, parent: Int, template: Int, instance: Int, child_path: List(Int), slots: List(IslandTemplateSlot)) -> IslandRegion:
    IslandChildRegion(path, id, parent, template, instance, child_path, slots)

pub fn island_public_json(input: Bytes, app_id: Int, build_low: Int, build_high: Int) -> Json:
    if input.length() <= 48 || input.length() > 1048624 || input.at(0) != 71 || input.at(1) != 76 || input.at(2) != 77 || input.at(3) != 82:
        fail("glamour island: invalid start frame header")
    if island_read_u16(input, 4) != 1 || island_read_u16(input, 6) != 0 || input.at(8) != 1 || input.at(9) > 1 || island_read_u16(input, 10) != 48:
        fail("glamour island: unsupported start frame")
    if island_read_u32(input, 12) != input.length() || island_read_u32(input, 16) != 0 || island_read_u32(input, 20) != app_id:
        fail("glamour island: start frame identity is invalid")
    if island_read_u32(input, 24) != build_low || island_read_u32(input, 28) != build_high || island_read_u32(input, 32) != 0 || island_read_u32(input, 36) != 0 || island_read_u32(input, 40) != 48 || island_read_u32(input, 44) != 0:
        fail("glamour island: start frame build or payload is invalid")
    match json.decode(bytes.to_string(bytes.slice(input, 48, input.length()))):
        Ok(document) -> document
        Err(error) ->
            fail("glamour island: invalid public state: " + json.decode_error_message(error))
            JsonNull

pub fn island_resumed_start(input: Bytes) -> Bool:
    input.at(9) == 1

pub fn island_activation_input(input: Bytes, app_id: Int, build_low: Int, build_high: Int, sequence: Int):
    if input.length() != 48 || input.at(0) != 71 || input.at(1) != 76 || input.at(2) != 77 || input.at(3) != 82:
        fail("glamour island: invalid activation frame header")
    if island_read_u16(input, 4) != 1 || island_read_u16(input, 6) != 0 || input.at(8) != 6 || input.at(9) != 0 || island_read_u16(input, 10) != 48:
        fail("glamour island: unsupported activation frame")
    if island_read_u32(input, 12) != 48 || island_read_u32(input, 16) != 0 || island_read_u32(input, 20) != app_id:
        fail("glamour island: activation frame identity is invalid")
    if island_read_u32(input, 24) != build_low || island_read_u32(input, 28) != build_high || island_read_u32(input, 32) != sequence || island_read_u32(input, 36) != 0 || island_read_u32(input, 40) != 0 || island_read_u32(input, 44) != 0:
        fail("glamour island: activation frame build or sequence is invalid")

pub fn island_start_input(input: Bytes, app_id: Int, build_low: Int, build_high: Int) -> Start:
    if let JsonObject(fields) = island_public_json(input, app_id, build_low, build_high):
        var route: Option(String) = None
        var bootstrap: Option(String) = None
        for field in fields:
            match field:
                ("route", JsonString(value)) ->
                    match route:
                        Some(_) -> fail("glamour island: fresh Start repeats route")
                        None -> route = Some(value)
                ("bootstrap", JsonString(value)) ->
                    match bootstrap:
                        Some(_) -> fail("glamour island: fresh Start repeats bootstrap")
                        None -> bootstrap = Some(value)
                _ -> fail("glamour island: fresh Start contains an unknown or mistyped field")

        if let (Some(route), Some(bootstrap)) = (route, bootstrap):
            if bytes.from_string(route).length() > 4096 || bytes.from_string(bootstrap).length() > 1048576:
                fail("glamour island: fresh Start exceeds its public bounds")
            Start(route, bootstrap)
        else:
            fail("glamour island: fresh Start requires route and bootstrap")
            Start("", "")
    else:
        fail("glamour island: fresh Start is not an object")
        Start("", "")

fn find_island_decoder(node: VNode(msg), id: String, event: String, kind: String, prevent_default: Bool, stop_propagation: Bool) -> Option(Decoder(msg)):
    match node:
        Planned(_plan, inner) -> find_island_decoder(inner, id, event, kind, prevent_default, stop_propagation)
        Keyed(_key, inner) -> find_island_decoder(inner, id, event, kind, prevent_default, stop_propagation)
        Branch(_branch_id, active, inner) -> if active: find_island_decoder(inner, id, event, kind, prevent_default, stop_propagation) else: None
        ChildRegion(_child_id, _template, child) ->
            match child:
                Some(inner) -> find_island_decoder(inner, id, event, kind, prevent_default, stop_propagation)
                None -> None
        Element(_tag, attrs, children) ->
            var found: Option(Decoder(msg)) = None
            for attr in attrs:
                if let OnDecoded(candidate, candidate_event, decoder) = attr:
                    if candidate == id:
                        if candidate_event != event || decoder_kind(decoder) != kind || decoder_prevents_default(decoder) != prevent_default || decoder_stops_propagation(decoder) != stop_propagation:
                            fail("glamour island: live event decoder disagrees with its authenticated plan")
                        match found:
                            Some(_) -> fail("glamour island: live render duplicates an event identity")
                            None -> found = Some(decoder)
            for child in children:
                match find_island_decoder(child, id, event, kind, prevent_default, stop_propagation):
                    Some(decoder) ->
                        match found:
                            Some(_) -> fail("glamour island: live render duplicates an event identity")
                            None -> found = Some(decoder)
                    None -> Nil

            found
        _ -> None

fn island_event_count(node: VNode(msg)) -> Int:
    match node:
        Planned(_plan, inner) -> island_event_count(inner)
        Keyed(_key, inner) -> island_event_count(inner)
        Branch(_id, active, inner) -> if active: island_event_count(inner) else: 0
        ChildRegion(_id, _template, child) ->
            match child:
                Some(inner) -> island_event_count(inner)
                None -> 0
        Element(_tag, attrs, children) ->
            var count = 0
            for attr in attrs:
                match attr:
                    OnDecoded(_id, _event, _decoder) -> count = count + 1
                    On(_event, _message) -> fail("glamour island: live render introduced a legacy event")
                    OnInput(_event, _tag) -> fail("glamour island: live render introduced a legacy input event")
                    _ -> Nil

            for child in children:
                count = count + island_event_count(child)
            count
        Text(_value) -> 0
        _ ->
            fail("glamour island: live event graph contains an unsupported node")
            0

fn island_validate_events(node: VNode(msg), descriptors: List(IslandEventDescriptor)):
    var live = 0
    for descriptor in descriptors:
        match descriptor:
            IslandEventDescriptor(_plan, _node, _event_class, id, event, kind, prevent_default, stop_propagation) ->
                match find_island_decoder(node, id, event, kind, prevent_default, stop_propagation):
                    Some(_decoder) -> live = live + 1
                    None -> Nil

    if island_event_count(node) != live:
        fail("glamour island: live event graph disagrees with its authenticated plan")

fn island_event_at(descriptors: List(IslandEventDescriptor), plan: Int) -> IslandEventDescriptor:
    var found: Option(IslandEventDescriptor) = None
    for descriptor in descriptors:
        match descriptor:
            IslandEventDescriptor(candidate, _node, _event_class, _id, _event, _kind, _prevent_default, _stop_propagation) ->
                if candidate == plan:
                    match found:
                        Some(_) -> fail("glamour island: duplicate authenticated event plan")
                        None -> found = Some(descriptor)
    match found:
        Some(descriptor) -> descriptor
        None ->
            fail("glamour island: event plan has no authenticated descriptor")
            island_event_at(descriptors, plan)

pub fn island_decode_event(rendered: Ui(msg), descriptors: List(IslandEventDescriptor), plan: Int, value: String, checked: Bool, key: String) -> Option(msg):
    island_validate_events(ui_node(rendered), descriptors)
    match island_event_at(descriptors, plan):
        IslandEventDescriptor(_plan, _node, _event_class, id, event, kind, prevent_default, stop_propagation) ->
            match find_island_decoder(ui_node(rendered), id, event, kind, prevent_default, stop_propagation):
                Some(decoder) -> decode_event(decoder, EventData(value, checked, key))
                None ->
                    fail("glamour island: authenticated event is absent from the live render")
                    None

fn island_read_u16(input: Bytes, offset: Int) -> Int:
    if offset < 0 || input.length() < offset + 2:
        fail("glamour island: truncated input frame")
    input.at(offset) + input.at(offset + 1) * 256

fn island_read_u32(input: Bytes, offset: Int) -> Int:
    if offset < 0 || input.length() < offset + 4:
        fail("glamour island: truncated input frame")
    input.at(offset) + input.at(offset + 1) * 256 + input.at(offset + 2) * 65536 + input.at(offset + 3) * 16777216

fn island_input_text(input: Bytes, offset: Int, length: Int) -> String:
    if offset < 0 || length < 0 || offset + length > input.length():
        fail("glamour island: event payload is outside its frame")
    match bytes.slice(input, offset, offset + length).decode_utf8_string():
        Ok(text) -> text
        Err(_) ->
            fail("glamour island: text payload is not strict UTF-8")
            ""

fn island_input_bytes(input: Bytes, offset: Int, length: Int) -> Bytes:
    if offset < 0 || length < 0 || offset + length > input.length():
        fail("glamour island: binary payload is outside its frame")
    bytes.slice(input, offset, offset + length)

pub fn island_event_input(input: Bytes, app_id: Int, build_low: Int, build_high: Int, sequence: Int) -> IslandEventInput:
    let length = input.length()
    if length < 96 || input.at(0) != 71 || input.at(1) != 76 || input.at(2) != 77 || input.at(3) != 82:
        fail("glamour island: invalid event frame header")
    if island_read_u16(input, 4) != 1 || island_read_u16(input, 6) != 0 || input.at(8) != 2 || input.at(9) != 0 || island_read_u16(input, 10) != 48:
        fail("glamour island: unsupported event frame")
    if island_read_u32(input, 12) != length || island_read_u32(input, 16) != 1 || island_read_u32(input, 20) != app_id:
        fail("glamour island: event frame identity is invalid")
    if island_read_u32(input, 24) != build_low || island_read_u32(input, 28) != build_high || island_read_u32(input, 32) != sequence || island_read_u32(input, 36) != 0:
        fail("glamour island: event frame build or sequence is invalid")
    if island_read_u32(input, 40) != 96 || island_read_u32(input, 44) != 0 || island_read_u16(input, 48) != 1 || island_read_u16(input, 50) != 0 || island_read_u32(input, 52) != 48:
        fail("glamour island: event record is invalid")
    let flags = island_read_u32(input, 68)
    let value_offset = island_read_u32(input, 72)
    let value_length = island_read_u32(input, 76)
    let key_offset = island_read_u32(input, 80)
    let key_length = island_read_u32(input, 84)
    if flags > 15 || value_offset != 96 || key_offset != value_offset + value_length || key_offset + key_length != length || island_read_u32(input, 88) != 0 || island_read_u32(input, 92) != 0:
        fail("glamour island: event payload layout is invalid")
    IslandEventInput(island_read_u32(input, 56), island_read_u32(input, 60), island_read_u32(input, 64), island_input_text(input, value_offset, value_length), flags % 2 == 1, island_input_text(input, key_offset, key_length))

pub fn island_completion_input(input: Bytes, app_id: Int, build_low: Int, build_high: Int, sequence: Int) -> IslandCompletionInput:
    let length = input.length()
    if length < 88 || input.at(0) != 71 || input.at(1) != 76 || input.at(2) != 77 || input.at(3) != 82:
        fail("glamour island: invalid completion frame header")
    if island_read_u16(input, 4) != 1 || island_read_u16(input, 6) != 0 || input.at(8) != 3 || input.at(9) != 0 || island_read_u16(input, 10) != 48:
        fail("glamour island: unsupported completion frame")
    if island_read_u32(input, 12) != length || island_read_u32(input, 16) != 1 || island_read_u32(input, 20) != app_id:
        fail("glamour island: completion frame identity is invalid")
    if island_read_u32(input, 24) != build_low || island_read_u32(input, 28) != build_high || island_read_u32(input, 32) != sequence || island_read_u32(input, 36) != 0:
        fail("glamour island: completion frame build or sequence is invalid")
    if island_read_u32(input, 40) != 88 || island_read_u32(input, 44) != 0 || island_read_u16(input, 48) != 1 || island_read_u16(input, 50) != 0 || island_read_u32(input, 52) != 40:
        fail("glamour island: completion record is invalid")
    let source = island_read_u32(input, 56)
    let instance = island_read_u32(input, 60)
    let generation = island_read_u32(input, 64)
    let descriptor = island_read_u32(input, 68)
    let result_schema = island_read_u32(input, 72)
    let status = island_read_u32(input, 76)
    let value_offset = island_read_u32(input, 80)
    let value_length = island_read_u32(input, 84)
    if !(source == 1 || source == 2) || instance == 0 || generation == 0 || descriptor == 0 || result_schema == 0 || status > 1 || value_offset != 88 || value_offset + value_length != length:
        fail("glamour island: completion payload is invalid")
    IslandCompletionInput(source, instance, generation, descriptor, result_schema, status, island_input_bytes(input, value_offset, value_length))

fn island_completion_text(payload: Bytes, offset: Int, length: Int) -> String:
    if offset < 0 || length < 0 || offset + length != payload.length():
        fail("glamour island: completion text length is not canonical")
    match bytes.slice(payload, offset, offset + length).decode_utf8_string():
        Ok(text) -> text
        Err(_) ->
            fail("glamour island: completion text is not strict UTF-8")
            ""

fn island_completion_variant(payload: Bytes, expected: Int, minimum: Int):
    if payload.length() < minimum || payload.at(0) != expected || payload.at(1) != 0 || payload.at(2) != 0 || payload.at(3) != 0:
        fail("glamour island: completion variant is invalid")

fn island_completion_status(status: Int):
    if !(status == 0 || status == 1):
        fail("glamour island: completion status is invalid")

pub fn island_unit_completion(payload: Bytes, status: Int):
    island_completion_status(status)
    if status != 0 || !payload.is_empty():
        fail("glamour island: unit completion is invalid")

pub fn island_http_completion(payload: Bytes, status: Int) -> HttpResult:
    island_completion_status(status)
    if status == 0:
        island_completion_variant(payload, 1, 12)
        let http_status = island_read_u32(payload, 4)
        let length = island_read_u32(payload, 8)
        if http_status < 100 || http_status > 599:
            fail("glamour island: HTTP completion status is invalid")
        HttpResponse(http_status, island_completion_text(payload, 12, length))
    else:
        island_completion_variant(payload, 2, 8)
        HttpFailure(island_completion_text(payload, 8, island_read_u32(payload, 4)))

pub fn island_navigation_completion(payload: Bytes, status: Int) -> NavigationResult:
    island_completion_status(status)
    island_completion_variant(payload, if status == 0: 1 else: 2, 8)
    let value = island_completion_text(payload, 8, island_read_u32(payload, 4))
    if status == 0:
        Navigated(value)
    else:
        NavigationFailure(value)

pub fn island_port_completion(payload: Bytes, status: Int) -> PortResult:
    island_completion_status(status)
    island_completion_variant(payload, if status == 0: 1 else: 2, 8)
    let value = island_completion_text(payload, 8, island_read_u32(payload, 4))
    if status == 0:
        PortResponse(value)
    else:
        PortFailure(value)

pub fn island_storage_completion(payload: Bytes, status: Int) -> StorageResult:
    island_completion_status(status)
    if status == 1:
        island_completion_variant(payload, 5, 8)
        StorageFailure(island_completion_text(payload, 8, island_read_u32(payload, 4)))
    else:
        let tag = payload.at(0)
        if tag == 1:
            island_completion_variant(payload, 1, 4)
            if payload.length() != 4:
                fail("glamour island: storage missing completion is invalid")
            StorageMissing
        else if tag == 2:
            island_completion_variant(payload, 2, 8)
            StorageValue(island_completion_text(payload, 8, island_read_u32(payload, 4)))
        else if tag == 3:
            island_completion_variant(payload, 3, 4)
            if payload.length() != 4:
                fail("glamour island: storage write completion is invalid")
            StorageStored
        else:
            island_completion_variant(payload, 4, 4)
            if payload.length() != 4:
                fail("glamour island: storage removal completion is invalid")
            StorageRemoved

pub fn island_worker_completion_capture(payload: Bytes, status: Int, maximum_bytes: Int) -> IslandCapture:
    island_completion_status(status)
    if status != 0 || payload.is_empty() || payload.length() > maximum_bytes:
        return island_capture_wire_abort()
    match payload.decode_utf8_string():
        Ok(encoded) -> island_capture_from_wire(encoded, maximum_bytes)
        Err(_) -> island_capture_wire_abort()

pub fn island_worker_completion_problem(payload: Bytes, status: Int) -> String:
    island_completion_status(status)
    if status != 1 || payload.is_empty() || payload.length() > 128:
        fail("glamour worker: failure completion is invalid")
    match payload.decode_utf8_string():
        Ok(problem) -> problem
        Err(_) ->
            fail("glamour worker: failure completion is not strict UTF-8")
            ""

pub fn island_host_port_completion_capture(payload: Bytes, status: Int, maximum_bytes: Int) -> IslandCapture:
    island_completion_status(status)
    if status != 0 || payload.is_empty() || payload.length() > maximum_bytes:
        return island_capture_wire_abort()
    match payload.decode_utf8_string():
        Ok(encoded) -> island_capture_from_wire(encoded, maximum_bytes)
        Err(_) -> island_capture_wire_abort()

pub fn island_host_port_completion_problem(payload: Bytes, status: Int) -> String:
    island_completion_status(status)
    if status != 1 || payload.is_empty() || payload.length() > 128:
        fail("glamour host port: failure completion is invalid")
    match payload.decode_utf8_string():
        Ok(problem) -> problem
        Err(_) ->
            fail("glamour host port: failure completion is not strict UTF-8")
            ""

fn island_text_id(nodes: List(IslandTextNode), path: List(Int)) -> Int:
    var found = 0
    for node in nodes:
        match node:
            IslandTextNode(candidate, id) ->
                if candidate == path:
                    if found != 0:
                        fail("glamour island: duplicate text-node path")
                    found = id
    if found == 0:
        fail("glamour island: rendered text has no authenticated node identity")
    found

fn island_attribute_at(sinks: List(IslandAttributeSink), path: List(Int), index: Int) -> IslandAttributeSink:
    var found: Option(IslandAttributeSink) = None
    for sink in sinks:
        match sink:
            IslandAttributeSink(candidate, _node, candidate_index, _kind, _name, _id) ->
                if candidate == path && candidate_index == index:
                    match found:
                        Some(_) -> fail("glamour island: duplicate attribute sink path")
                        None -> found = Some(sink)
    match found:
        Some(sink) -> sink
        None ->
            fail("glamour island: rendered attribute has no authenticated sink")
            island_attribute_at(sinks, path, index)

fn island_region_at(regions: List(IslandRegion), path: List(Int)) -> IslandRegion:
    var found: Option(IslandRegion) = None
    for descriptor in regions:
        match descriptor:
            IslandListRegion(candidate, _id, _parent, _keys, _dynamic) ->
                if candidate == path:
                    match found:
                        Some(_) -> fail("glamour island: duplicate region path")
                        None -> found = Some(descriptor)
            IslandBranchRegion(candidate, _id, _parent, _template, _instance, _child_path, _slots) ->
                if candidate == path:
                    match found:
                        Some(_) -> fail("glamour island: duplicate region path")
                        None -> found = Some(descriptor)
            IslandChildRegion(candidate, _id, _parent, _template, _instance, _child_path, _slots) ->
                if candidate == path:
                    match found:
                        Some(_) -> fail("glamour island: duplicate region path")
                        None -> found = Some(descriptor)
    match found:
        Some(descriptor) -> descriptor
        None ->
            fail("glamour island: rendered keyed children have no authenticated region")
            island_region_at(regions, path)

fn island_region_option_at(regions: List(IslandRegion), path: List(Int)) -> Option(IslandRegion):
    var found: Option(IslandRegion) = None
    for descriptor in regions:
        let candidate = match descriptor:
            IslandListRegion(candidate, _id, _parent, _keys, _dynamic) -> candidate
            IslandBranchRegion(candidate, _id, _parent, _template, _instance, _child_path, _slots) -> candidate
            IslandChildRegion(candidate, _id, _parent, _template, _instance, _child_path, _slots) -> candidate

        if candidate == path:
            match found:
                Some(_) -> fail("glamour island: duplicate region path")
                None -> found = Some(descriptor)
    found

fn island_region_key_option_at(keys: List(IslandRegionKey), source: String) -> Option(IslandRegionKey):
    var found: Option(IslandRegionKey) = None
    for key in keys:
        match key:
            IslandRegionKey(candidate, _id, _template, _path, _slots) ->
                if candidate == source:
                    match found:
                        Some(_) -> fail("glamour island: duplicate authenticated keyed identity")
                        None -> found = Some(key)
    found

fn island_collect_live_owner_instances(node: VNode(msg), path: List(Int), regions: List(IslandRegion), var owners: List(Int)):
    match node:
        Planned(_plan, inner) -> island_collect_live_owner_instances(inner, path, regions, owners)
        Keyed(_key, inner) -> island_collect_live_owner_instances(inner, path, regions, owners)
        Branch(_id, active, inner) ->
            match island_region_at(regions, path):
                IslandBranchRegion(_region_path, _region_id, _parent, _template, instance, child_path, _slots) ->
                    if active:
                        owners.push(instance)
                        island_collect_live_owner_instances(inner, child_path, regions, owners)
                _ -> fail("glamour island: branch resolved to a non-branch owner scope")
        ChildRegion(_id, _template, child) ->
            match island_region_at(regions, path):
                IslandChildRegion(_region_path, _region_id, _parent, _child_template, instance, child_path, _slots) ->
                    match child:
                        Some(inner) ->
                            owners.push(instance)
                            island_collect_live_owner_instances(inner, child_path, regions, owners)
                        None -> Nil
                _ -> fail("glamour island: optional child resolved to a non-child owner scope")
        Element(_tag, _attrs, children) ->
            match island_region_option_at(regions, path):
                Some(IslandListRegion(_region_path, _region_id, _parent, keys, _dynamic)) ->
                    let live = island_live_region_keys(children)
                    for source in live:
                        match island_region_key_option_at(keys, source):
                            Some(IslandRegionKey(_source, instance, _template, child_path, _slots)) ->
                                match island_live_key_at(children, source):
                                    Some(inner) ->
                                        owners.push(instance)
                                        island_collect_live_owner_instances(inner, child_path, regions, owners)
                                    None -> fail("glamour island: authenticated keyed owner is not live")
                            None -> Nil
                Some(_) -> fail("glamour island: element path resolved to a non-list owner scope")
                None ->
                    var index = 0
                    for child in children:
                        island_collect_live_owner_instances(child, list.concat(path, [index]), regions, owners)
                        index = index + 1
        _ -> Nil

pub fn island_live_owner_instances(rendered: Ui(msg), regions: List(IslandRegion), root: Int) -> List(Int):
    if !island_wire_u32(root, false):
        fail("glamour island: root owner instance is invalid")
    var owners = [root]
    match rendered:
        Ui(node) -> island_collect_live_owner_instances(node, [0], regions, owners)

    owners

fn island_region_key_at(keys: List(IslandRegionKey), source: String) -> IslandRegionKey:
    var found: Option(IslandRegionKey) = None
    for key in keys:
        match key:
            IslandRegionKey(candidate, _id, _template, _path, _slots) ->
                if candidate == source:
                    match found:
                        Some(_) -> fail("glamour island: duplicate authenticated keyed identity")
                        None -> found = Some(key)
    match found:
        Some(key) -> key
        None ->
            fail("glamour island: live keyed child is outside its authenticated key set")
            island_region_key_at(keys, source)

fn island_live_key_at(children: List(VNode(msg)), source: String) -> Option(VNode(msg)):
    var found: Option(VNode(msg)) = None
    for child in children:
        match child:
            Keyed(candidate, node) ->
                if candidate == source:
                    match found:
                        Some(_) -> fail("glamour island: live render duplicates a keyed child")
                        None -> found = Some(node)
            _ -> Nil

    found

fn island_live_keys(children: List(VNode(msg))) -> Option(List(String)):
    var keyed: List(String) = []
    var plain = 0
    for child in children:
        if let Keyed(key, _node) = child:
            if keyed.contains(key):
                fail("glamour island: live render duplicates a keyed child")
            keyed.push(key)
        else:
            plain = plain + 1
    if keyed.length() > 0 && plain > 0:
        fail("glamour island: live render mixes keyed and unkeyed children")
    if keyed.length() > 0:
        Some(keyed)
    else:
        None

fn island_live_region_keys(children: List(VNode(msg))) -> List(String):
    var keyed: List(String) = []
    for child in children:
        match child:
            Keyed(key, _node) ->
                if keyed.contains(key):
                    fail("glamour island: live render duplicates a keyed child")
                keyed.push(key)
            _ -> fail("glamour island: live keyed region contains an unkeyed child")

    keyed

type IslandDataAttribute:
    IslandDataAttribute(String, String, String, Bool)

fn island_data_attributes(attrs: List(Attr(msg))) -> List(IslandDataAttribute):
    var output: List(IslandDataAttribute) = []
    var custom_names: List(String) = []
    for attr in attrs:
        match attr:
            Attribute(name, value) -> output.push(IslandDataAttribute("attribute", name, value, true))
            BooleanAttribute(name, enabled) -> output.push(IslandDataAttribute("boolean", name, "", enabled))
            Property(name, value) -> output.push(IslandDataAttribute("property", name, value, true))
            UrlAttribute(name, value) -> output.push(IslandDataAttribute("url", name, value, true))
            ClassAttribute(names) -> output.push(IslandDataAttribute("class", "class", names.join(" "), true))
            AriaAttribute(name, value) -> output.push(IslandDataAttribute("aria", name, value, true))
            CustomProperties(assignments) ->
                for assignment in assignments:
                    match assignment:
                        CssAssignment(name, category, value) ->
                            if custom_names.contains(name):
                                fail("glamour island: live render duplicates a custom property")
                            custom_names.push(name)
                            output.push(IslandDataAttribute("css-" + category, name, value, true))
            Prop(name, value) -> output.push(IslandDataAttribute("prop", name, value, true))
            OnDecoded(_id, _event, _decoder) -> Nil
            On(_event, _message) -> fail("glamour island: live render introduced a legacy event")
            OnInput(_event, _tag) -> fail("glamour island: live render introduced a legacy input event")

    output

fn island_event_descriptor_by_id(descriptors: List(IslandEventDescriptor), id: String) -> IslandEventDescriptor:
    var found: Option(IslandEventDescriptor) = None
    for descriptor in descriptors:
        match descriptor:
            IslandEventDescriptor(_plan, _node, _event_class, candidate, _event, _kind, _prevent_default, _stop_propagation) ->
                if candidate == id:
                    match found:
                        Some(_) -> fail("glamour island: duplicate authenticated event identity")
                        None -> found = Some(descriptor)
    match found:
        Some(descriptor) -> descriptor
        None ->
            fail("glamour island: live event has no authenticated descriptor")
            island_event_descriptor_by_id(descriptors, id)

fn island_element_events(attrs: List(Attr(msg)), descriptors: List(IslandEventDescriptor)) -> List(IslandEventDescriptor):
    var output: List(IslandEventDescriptor) = []
    for attr in attrs:
        match attr:
            OnDecoded(id, event, decoder) ->
                let descriptor = island_event_descriptor_by_id(descriptors, id)
                match descriptor:
                    IslandEventDescriptor(_plan, node, event_class, _id, expected_event, kind, prevent_default, stop_propagation) ->
                        if node <= 0 || event_class <= 0 || event != expected_event || decoder_kind(decoder) != kind || decoder_prevents_default(decoder) != prevent_default || decoder_stops_propagation(decoder) != stop_propagation:
                            fail("glamour island: live event disagrees with its authenticated descriptor")
                        for existing in output:
                            match existing:
                                IslandEventDescriptor(_existing_plan, _existing_node, existing_class, _existing_id, _existing_event, _existing_kind, _existing_prevent, _existing_stop) ->
                                    if existing_class == event_class:
                                        fail("glamour island: live node duplicates an event class")
                        output.push(descriptor)
            On(_event, _message) -> fail("glamour island: live render introduced a legacy event")
            OnInput(_event, _tag) -> fail("glamour island: live render introduced a legacy input event")
            _ -> Nil

    output

fn island_event_for_class(events: List(IslandEventDescriptor), event_class: Int) -> Option(IslandEventDescriptor):
    for descriptor in events:
        match descriptor:
            IslandEventDescriptor(_plan, _node, candidate, _id, _event, _kind, _prevent_default, _stop_propagation) ->
                if candidate == event_class:
                    return Some(descriptor)
    None

fn island_collect_event_changes(old_attrs: List(Attr(msg)), new_attrs: List(Attr(msg)), descriptors: List(IslandEventDescriptor), emit_changes: Bool, var changes: List(IslandPatchChange)):
    let old_events = island_element_events(old_attrs, descriptors)
    let new_events = island_element_events(new_attrs, descriptors)
    for old_descriptor in old_events:
        match old_descriptor:
            IslandEventDescriptor(old_plan, old_node, event_class, _old_id, _old_event, _old_kind, _old_prevent, _old_stop) ->
                match island_event_for_class(new_events, event_class):
                    Some(IslandEventDescriptor(new_plan, new_node, _new_class, _new_id, _new_event, _new_kind, _new_prevent, _new_stop)) ->
                        if old_node != new_node:
                            fail("glamour island: retained event changed node identity")
                        if emit_changes && old_plan != new_plan:
                            changes.push(IslandPatchSetEventPlan(new_node, event_class, new_plan))
                    None ->
                        if emit_changes:
                            changes.push(IslandPatchRemoveEventPlan(old_node, event_class))
    for new_descriptor in new_events:
        match new_descriptor:
            IslandEventDescriptor(new_plan, new_node, event_class, _new_id, _new_event, _new_kind, _new_prevent, _new_stop) ->
                match island_event_for_class(old_events, event_class):
                    Some(_) -> Nil
                    None ->
                        if emit_changes:
                            changes.push(IslandPatchSetEventPlan(new_node, event_class, new_plan))

fn island_template_attribute_value(attr: IslandDataAttribute, kind: String, name: String) -> String:
    match attr:
        IslandDataAttribute(candidate_kind, candidate_name, value, enabled) ->
            if candidate_kind != kind || candidate_name != name:
                fail("glamour island: template attribute slot identity changed")
            if kind == "boolean":
                if enabled:
                    "1"
                else:
                    "0"
            else if kind == "url":
                safe_url_or_hash(value)
            else:
                value

fn island_collect_template_slot_values(node: VNode(msg), path: List(Int), slots: List(IslandTemplateSlot), var values: List(IslandSlotValue)):
    match node:
        Planned(_plan, inner) ->
            island_collect_template_slot_values(inner, path, slots, values)
            Nil
        Keyed(_key, inner) ->
            island_collect_template_slot_values(inner, path, slots, values)
            Nil
        Branch(_id, active, inner) ->
            if active:
                island_collect_template_slot_values(inner, path, slots, values)
        ChildRegion(_id, _template, child) ->
            match child:
                Some(inner) ->
                    island_collect_template_slot_values(inner, path, slots, values)
                    Nil
                None -> Nil
        Text(value) ->
            for slot in slots:
                match slot:
                    IslandTemplateTextSlot(id, candidate) ->
                        if candidate == path:
                            values.push(IslandSlotValue(id, value))
                    IslandTemplateAttributeSlot(_id, _candidate, _index, _kind, _name) -> Nil
        Element(_tag, attrs, children) ->
            let data = island_data_attributes(attrs)
            for slot in slots:
                match slot:
                    IslandTemplateTextSlot(_id, _candidate) -> Nil
                    IslandTemplateAttributeSlot(id, candidate, index, kind, name) ->
                        if candidate == path:
                            if index < 0 || index >= data.length():
                                fail("glamour island: template attribute slot is outside the live render")
                            values.push(IslandSlotValue(id, island_template_attribute_value(data.at(index), kind, name)))
            var index = 0
            for child in children:
                island_collect_template_slot_values(child, list.concat(path, [index]), slots, values)
                index = index + 1
        _ -> Nil

fn island_template_slot_values(node: VNode(msg), path: List(Int), slots: List(IslandTemplateSlot)) -> List(IslandSlotValue):
    var values: List(IslandSlotValue) = []
    island_collect_template_slot_values(node, path, slots, values)
    if values.length() != slots.length():
        fail("glamour island: live template does not cover its authenticated slot table")
    values

fn island_collect_attribute_changes(old_attrs: List(Attr(msg)), new_attrs: List(Attr(msg)), path: List(Int), sinks: List(IslandAttributeSink), emit_changes: Bool, var changes: List(IslandPatchChange)):
    let old_data = island_data_attributes(old_attrs)
    let new_data = island_data_attributes(new_attrs)
    if old_data.length() != new_data.length():
        fail("glamour island: rendered attribute structure changed")
    var index = 0
    while index < old_data.length():
        match island_attribute_at(sinks, path, index):
            IslandAttributeSink(_sink_path, node, _sink_index, kind, name, sink) ->
                match old_data.at(index):
                    IslandDataAttribute(old_kind, old_name, old_value, old_enabled) ->
                        match new_data.at(index):
                            IslandDataAttribute(new_kind, new_name, new_value, new_enabled) ->
                                if old_kind != kind || new_kind != kind || old_name != name || new_name != name:
                                    fail("glamour island: rendered attribute identity changed")
                                if emit_changes && kind == "boolean" && old_enabled != new_enabled:
                                    changes.push(IslandPatchBoolean(node, sink, new_enabled))
                                else if emit_changes && old_value != new_value:
                                    if kind == "property":
                                        changes.push(IslandPatchString(3, node, sink, new_value))
                                    else if kind == "url":
                                        changes.push(IslandPatchString(4, node, sink, safe_url_or_hash(new_value)))
                                    else if kind == "class":
                                        changes.push(IslandPatchClass(node, new_value))
                                    else if kind == "aria":
                                        changes.push(IslandPatchString(17, node, sink, new_value))
                                    else if kind.starts_with("css-"):
                                        changes.push(IslandPatchString(18, node, sink, new_value))
                                    else:
                                        changes.push(IslandPatchString(4, node, sink, new_value))

        index = index + 1

fn island_same_int(left: Int, right: Int) -> Bool:
    left == right

fn island_same_string(left: String, right: String) -> Bool:
    left == right

fn island_validate_dynamic_shape(template: VNode(msg), node: VNode(msg), var valid: Bool):
    if valid:
        match template:
            Planned(template_plan, template_inner) ->
                if let Planned(node_plan, node_inner) = node:
                    match template_plan:
                        TemplatePlan(template_id, _template_origin, _template_slots) ->
                            match node_plan:
                                TemplatePlan(node_id, _node_origin, _node_slots) ->
                                    if !island_same_string(template_id, node_id):
                                        valid = false
                                    else:
                                        island_validate_dynamic_shape(template_inner, node_inner, valid)
                else:
                    valid = false
            Text(_value) ->
                match node:
                    Text(_other) -> Nil
                    _ -> valid = false
            Element(template_tag, template_attrs, template_children) ->
                if let Element(node_tag, node_attrs, node_children) = node:
                    if !island_same_string(template_tag, node_tag) || !island_same_int(island_event_count(template), 0) || !island_same_int(island_event_count(node), 0):
                        valid = false
                    let template_data = island_data_attributes(template_attrs)
                    let node_data = island_data_attributes(node_attrs)
                    if !island_same_int(template_data.length(), node_data.length()) || !island_same_int(template_children.length(), node_children.length()):
                        valid = false
                    var index = 0
                    while valid && index < template_data.length():
                        match template_data.at(index):
                            IslandDataAttribute(template_kind, template_name, _template_value, _template_enabled) ->
                                match node_data.at(index):
                                    IslandDataAttribute(node_kind, node_name, _node_value, _node_enabled) ->
                                        if !island_same_string(template_kind, node_kind) || !island_same_string(template_name, node_name):
                                            valid = false
                        index = index + 1
                    index = 0
                    while valid && index < template_children.length():
                        island_validate_dynamic_shape(template_children.at(index), node_children.at(index), valid)
                        index = index + 1
                else:
                    valid = false
            _ -> valid = false

fn island_slot_values_equal(left: List(IslandSlotValue), right: List(IslandSlotValue)) -> Bool:
    if left.length() != right.length():
        return false
    var index = 0
    while index < left.length():
        match left.at(index):
            IslandSlotValue(left_id, left_value) ->
                match right.at(index):
                    IslandSlotValue(right_id, right_value) ->
                        if left_id != right_id || left_value != right_value:
                            return false
        index = index + 1
    true

fn island_collect_keyed_changes(baseline_children: List(VNode(msg)), old_items: List(String), old_children: List(VNode(msg)), new_items: List(String), new_children: List(VNode(msg)), descriptor: IslandRegion, var changes: List(IslandPatchChange)):
    match descriptor:
        IslandBranchRegion(_path, _region, _parent, _template, _instance, _child_path, _slots) -> fail("glamour island: keyed children resolved to a non-list region")
        IslandChildRegion(_path, _region, _parent, _template, _instance, _child_path, _slots) -> fail("glamour island: keyed children resolved to a non-list region")
        IslandListRegion(_path, region_id, _parent, keys, dynamic) ->
            match dynamic:
                IslandRegionKey(prototype_source, _prototype_id, template, key_path, slots) ->
                    if template != 0:
                        let prototype = match island_live_key_at(baseline_children, prototype_source):
                            Some(node) -> node
                            None ->
                                fail("glamour island: dynamic keyed region lost its authenticated prototype")
                                baseline_children.at(0)
                        match dynamic_keyed_plan(old_items, new_items):
                            Err(problem) -> fail(problem)
                            Ok(edits) ->
                                for edit in edits:
                                    match edit:
                                        MoveDynamicKey(key, before) -> changes.push(IslandPatchDynamicMove(region_id, key, before))
                                        RemoveDynamicKey(key) -> changes.push(IslandPatchDynamicRemove(region_id, key))
                                        InsertDynamicKey(key, before) ->
                                            match island_live_key_at(new_children, key):
                                                Some(node) ->
                                                    var valid_shape = true
                                                    island_validate_dynamic_shape(prototype, node, valid_shape)
                                                    if !valid_shape:
                                                        fail("glamour island: dynamic keyed child disagrees with its authenticated template")
                                                    changes.push(IslandPatchDynamicInsert(region_id, key, before, template, island_template_slot_values(node, key_path, slots)))
                                                None -> fail("glamour island: dynamic keyed insertion has no live value")

                        for source in new_items:
                            match island_live_key_at(old_children, source):
                                Some(old_node) ->
                                    match island_live_key_at(new_children, source):
                                        Some(new_node) ->
                                            var valid_old_shape = true
                                            island_validate_dynamic_shape(prototype, old_node, valid_old_shape)
                                            var valid_new_shape = true
                                            island_validate_dynamic_shape(prototype, new_node, valid_new_shape)
                                            if !valid_old_shape || !valid_new_shape:
                                                fail("glamour island: dynamic keyed child disagrees with its authenticated template")
                                            let old_slots = island_template_slot_values(old_node, key_path, slots)
                                            let new_slots = island_template_slot_values(new_node, key_path, slots)
                                            if !island_slot_values_equal(old_slots, new_slots):
                                                changes.push(IslandPatchDynamicSlots(region_id, source, new_slots))
                                        None -> fail("glamour island: dynamic keyed child disappeared during reconciliation")
                                None -> Nil
                    else:
                        if old_items.length() > keys.length() || new_items.length() > keys.length():
                            fail("glamour island: keyed region exceeds its authenticated key set")
                        var old_ids: List(Int) = []
                        for source in old_items:
                            match island_region_key_at(keys, source):
                                IslandRegionKey(_key, id, _template, _key_path, _slots) -> old_ids.push(id)

                        var new_ids: List(Int) = []
                        for source in new_items:
                            match island_region_key_at(keys, source):
                                IslandRegionKey(_key, id, _template, _key_path, _slots) -> new_ids.push(id)

                        match keyed_plan(old_ids, new_ids):
                            Ok(edits) ->
                                for edit in edits:
                                    match edit:
                                        MoveKey(key, before) -> changes.push(IslandPatchListMove(region_id, key, before))
                                        RemoveKey(key) -> changes.push(IslandPatchListRemove(region_id, key))
                                        InsertKey(key, before) ->
                                            var found: Option(IslandRegionKey) = None
                                            for descriptor_key in keys:
                                                match descriptor_key:
                                                    IslandRegionKey(_source, candidate, _template, _path, _slots) ->
                                                        if candidate == key:
                                                            found = Some(descriptor_key)
                                            match found:
                                                Some(IslandRegionKey(source, _id, key_template, source_path, source_slots)) ->
                                                    if key_template == 0:
                                                        fail("glamour island: keyed re-entry has no authenticated template")
                                                    match island_live_key_at(new_children, source):
                                                        Some(node) -> changes.push(IslandPatchListInsert(region_id, key, before, key_template, key, island_template_slot_values(node, source_path, source_slots)))
                                                        None -> fail("glamour island: keyed insertion has no live template value")
                                                None -> fail("glamour island: keyed insertion has no authenticated template")
                            Err(problem) -> fail(problem)

fn island_collect_patch_changes(baseline: VNode(msg), old: VNode(msg), new: VNode(msg), path: List(Int), nodes: List(IslandTextNode), sinks: List(IslandAttributeSink), events: List(IslandEventDescriptor), regions: List(IslandRegion), var changes: List(IslandPatchChange)):
    var pending = [IslandPatchWork(baseline, old, new, path)]
    var cursor_index = 0
    while cursor_index < pending.length():
        let cursor_work = pending.at(cursor_index)
        cursor_index = cursor_index + 1
        match cursor_work:
            IslandPatchWork(baseline_node, old_node, new_node, node_path) ->
                match baseline_node:
                    Planned(_baseline_plan, baseline_inner) ->
                        match old_node:
                            Planned(_old_plan, old_inner) ->
                                match new_node:
                                    Planned(_new_plan, new_inner) -> pending.push(IslandPatchWork(baseline_inner, old_inner, new_inner, node_path))
                                    _ -> fail("glamour island: rendered structure changed at a planned node")
                            _ -> fail("glamour island: previous render changed at a planned node")
                    Keyed(baseline_key, baseline_inner) ->
                        match old_node:
                            Keyed(old_key, old_inner) ->
                                match new_node:
                                    Keyed(new_key, new_inner) ->
                                        if baseline_key != old_key || old_key != new_key:
                                            fail("glamour island: keyed structure changed without a region plan")
                                        pending.push(IslandPatchWork(baseline_inner, old_inner, new_inner, node_path))
                                    _ -> fail("glamour island: rendered structure changed at a keyed node")
                            _ -> fail("glamour island: previous render changed at a keyed node")
                    Branch(baseline_id, baseline_active, baseline_inner) ->
                        match old_node:
                            Branch(old_id, old_active, old_inner) ->
                                match new_node:
                                    Branch(new_id, new_active, new_inner) ->
                                        if baseline_id != old_id || old_id != new_id:
                                            fail("glamour island: rendered branch identity changed")
                                        match island_region_at(regions, node_path):
                                            IslandBranchRegion(_region_path, region_id, _parent, template, instance, child_path, slots) ->
                                                if old_active && !new_active:
                                                    changes.push(IslandPatchLeaveBranch(region_id))
                                                else if !old_active && new_active:
                                                    changes.push(IslandPatchEnterBranch(region_id, template, instance, island_template_slot_values(new_inner, child_path, slots)))
                                                    pending.push(IslandPatchWork(baseline_inner, baseline_inner, new_inner, child_path))
                                                else if old_active && new_active:
                                                    pending.push(IslandPatchWork(baseline_inner, old_inner, new_inner, child_path))
                                            _ -> fail("glamour island: branch resolved to a non-branch region")
                                    _ -> fail("glamour island: rendered structure changed at a branch node")
                            _ -> fail("glamour island: previous render changed at a branch node")
                    ChildRegion(baseline_id, baseline_template, _baseline_child) ->
                        match old_node:
                            ChildRegion(old_id, _old_template, old_child) ->
                                match new_node:
                                    ChildRegion(new_id, _new_template, new_child) ->
                                        if baseline_id != old_id || old_id != new_id:
                                            fail("glamour island: rendered child identity changed")
                                        match island_region_at(regions, node_path):
                                            IslandChildRegion(_region_path, region_id, _parent, template, instance, child_path, slots) ->
                                                match old_child:
                                                    Some(old_inner) ->
                                                        match new_child:
                                                            Some(new_inner) -> pending.push(IslandPatchWork(baseline_template, old_inner, new_inner, child_path))
                                                            None -> changes.push(IslandPatchUnmountChild(region_id))
                                                    None ->
                                                        match new_child:
                                                            Some(new_inner) ->
                                                                changes.push(IslandPatchMountChild(region_id, template, instance, island_template_slot_values(new_inner, child_path, slots)))
                                                                pending.push(IslandPatchWork(baseline_template, baseline_template, new_inner, child_path))
                                                            None -> Nil
                                            _ -> fail("glamour island: optional child resolved to a non-child region")
                                    _ -> fail("glamour island: rendered structure changed at an optional child")
                            _ -> fail("glamour island: previous render changed at an optional child")
                    Text(_baseline_value) ->
                        match old_node:
                            Text(old_value) ->
                                match new_node:
                                    Text(new_value) ->
                                        if old_value != new_value:
                                            changes.push(IslandPatchText(island_text_id(nodes, node_path), new_value))
                                    _ -> fail("glamour island: rendered text changed node kind")
                            _ -> fail("glamour island: previous render changed text node kind")
                    Element(baseline_tag, baseline_attrs, baseline_children) ->
                        match old_node:
                            Element(old_tag, old_attrs, old_children) ->
                                match new_node:
                                    Element(new_tag, new_attrs, new_children) ->
                                        if baseline_tag != old_tag || old_tag != new_tag:
                                            fail("glamour island: rendered element tag changed without a region plan")
                                        island_collect_attribute_changes(baseline_attrs, old_attrs, node_path, sinks, false, changes)
                                        island_collect_attribute_changes(old_attrs, new_attrs, node_path, sinks, true, changes)
                                        island_collect_event_changes(baseline_attrs, old_attrs, events, false, changes)
                                        island_collect_event_changes(old_attrs, new_attrs, events, true, changes)
                                        match island_live_keys(baseline_children):
                                            Some(baseline_items) ->
                                                let old_items = island_live_region_keys(old_children)
                                                let new_items = island_live_region_keys(new_children)
                                                let descriptor = island_region_at(regions, node_path)
                                                if baseline_items.length() > 0:
                                                    island_collect_keyed_changes(baseline_children, old_items, old_children, new_items, new_children, descriptor, changes)
                                                match descriptor:
                                                    IslandListRegion(_region_path, _region_id, _parent, keys, dynamic) ->
                                                        match dynamic:
                                                            IslandRegionKey(_source, _id, template, _path, _slots) ->
                                                                if template == 0:
                                                                    var item_index = 0
                                                                    while item_index < new_items.length():
                                                                        let source = new_items.at(item_index)
                                                                        match island_live_key_at(baseline_children, source):
                                                                            Some(baseline_child) ->
                                                                                match island_live_key_at(new_children, source):
                                                                                    Some(new_child) ->
                                                                                        let compare_old = match island_live_key_at(old_children, source):
                                                                                            Some(old_child) -> old_child
                                                                                            None -> baseline_child

                                                                                        match island_region_key_at(keys, source):
                                                                                            IslandRegionKey(_key, _id, _template, key_path, _slots) -> pending.push(IslandPatchWork(baseline_child, compare_old, new_child, key_path))
                                                                                    None -> fail("glamour island: keyed child disappeared during reconciliation")
                                                                            None -> fail("glamour island: live keyed child is outside its authenticated key set")

                                                                        item_index = item_index + 1
                                                    _ -> fail("glamour island: keyed children resolved to a non-list region")
                                            None ->
                                                match island_live_keys(old_children):
                                                    Some(_old_items) -> fail("glamour island: previous render introduced a keyed region")
                                                    None -> Nil

                                                match island_live_keys(new_children):
                                                    Some(_new_items) -> fail("glamour island: rendered structure introduced a keyed region")
                                                    None -> Nil

                                                if baseline_children.length() != old_children.length() || old_children.length() != new_children.length():
                                                    fail("glamour island: rendered element structure changed without a region plan")
                                                var child_index = 0
                                                while child_index < old_children.length():
                                                    pending.push(IslandPatchWork(baseline_children.at(child_index), old_children.at(child_index), new_children.at(child_index), list.concat(node_path, [child_index])))
                                                    child_index = child_index + 1
                                    _ -> fail("glamour island: rendered element changed node kind")
                            _ -> fail("glamour island: previous render changed node kind")
                    _ -> fail("glamour island: unsupported live node in resumable render graph")

fn island_put_u8(var output: List(Int), value: Int):
    output.push(value % 256)

fn island_put_u16(var output: List(Int), value: Int):
    island_put_u8(output, value)
    island_put_u8(output, value / 256)

fn island_put_u32(var output: List(Int), value: Int):
    island_put_u16(output, value % 65536)
    island_put_u16(output, value / 65536)

fn island_put_header(var output: List(Int), kind: Int, total_length: Int, operation_count: Int, app_id: Int, build_low: Int, build_high: Int, sequence: Int, payload_offset: Int):
    island_put_u8(output, 71)
    island_put_u8(output, 76)
    island_put_u8(output, 77)
    island_put_u8(output, 82)
    island_put_u16(output, 1)
    island_put_u16(output, 3)
    island_put_u8(output, kind)
    island_put_u8(output, 0)
    island_put_u16(output, 48)
    island_put_u32(output, total_length)
    island_put_u32(output, operation_count)
    island_put_u32(output, app_id)
    island_put_u32(output, build_low)
    island_put_u32(output, build_high)
    island_put_u32(output, sequence)
    island_put_u32(output, 0)
    island_put_u32(output, payload_offset)
    island_put_u32(output, 0)

fn island_patch_operation_bytes(change: IslandPatchChange) -> Int:
    match change:
        IslandPatchString(_tag, _node, _sink, _value) -> 24
        IslandPatchListRemove(_region, _key) -> 16
        IslandPatchListInsert(_region, _key, _before, _template, _instance, slots) -> 32 + slots.length() * 12
        IslandPatchDynamicInsert(_region, _key, _before, _template, slots) -> 36 + slots.length() * 12
        IslandPatchDynamicMove(_region, _key, _before) -> 28
        IslandPatchDynamicRemove(_region, _key) -> 20
        IslandPatchDynamicSlots(_region, _key, slots) -> 24 + slots.length() * 12
        IslandPatchEnterBranch(_region, _template, _instance, slots) -> 24 + slots.length() * 12
        IslandPatchLeaveBranch(_region) -> 12
        IslandPatchMountChild(_region, _template, _instance, slots) -> 24 + slots.length() * 12
        IslandPatchUnmountChild(_region) -> 12
        IslandPatchSetEventPlan(_node, _event_class, _event_plan) -> 20
        IslandPatchRemoveEventPlan(_node, _event_class) -> 16
        _ -> 20

fn island_patch_payload(change: IslandPatchChange) -> String:
    match change:
        IslandPatchText(_node, value) -> value
        IslandPatchString(_tag, _node, _sink, value) -> value
        IslandPatchClass(_node, value) -> value
        IslandPatchBoolean(_node, _sink, _enabled) -> ""
        IslandPatchListMove(_region, _key, _before) -> ""
        IslandPatchListRemove(_region, _key) -> ""
        IslandPatchListInsert(_region, _key, _before, _template, _instance, _slots) -> ""
        IslandPatchDynamicInsert(_region, key, before, _template, _slots) -> key + before
        IslandPatchDynamicMove(_region, key, before) -> key + before
        IslandPatchDynamicRemove(_region, key) -> key
        IslandPatchDynamicSlots(_region, key, _slots) -> key
        IslandPatchEnterBranch(_region, _template, _instance, _slots) -> ""
        IslandPatchLeaveBranch(_region) -> ""
        IslandPatchMountChild(_region, _template, _instance, _slots) -> ""
        IslandPatchUnmountChild(_region) -> ""
        IslandPatchSetEventPlan(_node, _event_class, _event_plan) -> ""
        IslandPatchRemoveEventPlan(_node, _event_class) -> ""

fn island_slot_payload_length(slots: List(IslandSlotValue)) -> Int:
    var length = 0
    for slot in slots:
        match slot:
            IslandSlotValue(_id, value) -> length = length + bytes.from_string(value).length()
    length

fn island_patch_slot_payload_length(change: IslandPatchChange) -> Int:
    match change:
        IslandPatchListInsert(_region, _key, _before, _template, _instance, slots) -> island_slot_payload_length(slots)
        IslandPatchDynamicInsert(_region, _key, _before, _template, slots) -> island_slot_payload_length(slots)
        IslandPatchDynamicSlots(_region, _key, slots) -> island_slot_payload_length(slots)
        IslandPatchEnterBranch(_region, _template, _instance, slots) -> island_slot_payload_length(slots)
        IslandPatchMountChild(_region, _template, _instance, slots) -> island_slot_payload_length(slots)
        _ -> 0

fn island_host_work_operation_bytes(work: IslandHostWork) -> Int:
    match work:
        IslandStartEffect(_instance, _cancellation_key, _descriptor, _request) -> 28
        IslandCancelEffect(_cancellation_key) -> 12
        IslandSyncSubscription(_subscription, _descriptor, _request) -> 24
        IslandRemoveSubscription(_subscription) -> 12

fn island_host_work_payload(work: IslandHostWork) -> String:
    match work:
        IslandStartEffect(_instance, _cancellation_key, _descriptor, request) -> request
        IslandSyncSubscription(_subscription, _descriptor, request) -> request
        _ -> ""

fn island_write_host_work(var output: List(Int), work: IslandHostWork, cursor: Int) -> Int:
    match work:
        IslandStartEffect(instance, cancellation_key, descriptor, request) ->
            let encoded = bytes.from_string(request)
            island_put_u16(output, 256)
            island_put_u16(output, 0)
            island_put_u32(output, 28)
            island_put_u32(output, instance)
            island_put_u32(output, cancellation_key)
            island_put_u32(output, descriptor)
            island_put_u32(output, cursor)
            island_put_u32(output, encoded.length())
            cursor + encoded.length()
        IslandCancelEffect(cancellation_key) ->
            island_put_u16(output, 257)
            island_put_u16(output, 0)
            island_put_u32(output, 12)
            island_put_u32(output, cancellation_key)
            cursor
        IslandSyncSubscription(subscription, descriptor, request) ->
            let encoded = bytes.from_string(request)
            island_put_u16(output, 258)
            island_put_u16(output, 0)
            island_put_u32(output, 24)
            island_put_u32(output, subscription)
            island_put_u32(output, descriptor)
            island_put_u32(output, cursor)
            island_put_u32(output, encoded.length())
            cursor + encoded.length()
        IslandRemoveSubscription(subscription) ->
            island_put_u16(output, 259)
            island_put_u16(output, 0)
            island_put_u32(output, 12)
            island_put_u32(output, subscription)
            cursor

pub fn island_patch(baseline: Ui(msg), old: Ui(msg), new: Ui(msg), nodes: List(IslandTextNode), sinks: List(IslandAttributeSink), events: List(IslandEventDescriptor), regions: List(IslandRegion), app_id: Int, build_low: Int, build_high: Int, sequence: Int) -> Bytes:
    island_patch_with_work(baseline, old, new, nodes, sinks, events, regions, [], app_id, build_low, build_high, sequence)

pub fn island_patch_with_work(baseline: Ui(msg), old: Ui(msg), new: Ui(msg), nodes: List(IslandTextNode), sinks: List(IslandAttributeSink), events: List(IslandEventDescriptor), regions: List(IslandRegion), work: List(IslandHostWork), app_id: Int, build_low: Int, build_high: Int, sequence: Int) -> Bytes:
    island_validate_events(ui_node(baseline), events)
    island_validate_events(ui_node(old), events)
    island_validate_events(ui_node(new), events)
    var changes: List(IslandPatchChange) = []
    island_collect_patch_changes(ui_node(baseline), ui_node(old), ui_node(new), [0], nodes, sinks, events, regions, changes)
    var operation_bytes = 0
    for change in changes:
        operation_bytes = operation_bytes + island_patch_operation_bytes(change)
    for operation in work:
        operation_bytes = operation_bytes + island_host_work_operation_bytes(operation)
    let operation_count = changes.length() + work.length()
    let payload_offset = if operation_count == 0: 0 else: 48 + operation_bytes
    var payload_length = 0
    for change in changes:
        payload_length = payload_length + bytes.from_string(island_patch_payload(change)).length() + island_patch_slot_payload_length(change)
    for operation in work:
        payload_length = payload_length + bytes.from_string(island_host_work_payload(operation)).length()
    var output: List(Int) = []
    island_put_header(output, 17, 48 + operation_bytes + payload_length, operation_count, app_id, build_low, build_high, sequence, payload_offset)
    var cursor = payload_offset
    for change in changes:
        match change:
            IslandPatchText(node, value) ->
                let encoded = bytes.from_string(value)
                island_put_u16(output, 2)
                island_put_u16(output, 0)
                island_put_u32(output, 20)
                island_put_u32(output, node)
                island_put_u32(output, cursor)
                island_put_u32(output, encoded.length())
                cursor = cursor + encoded.length()
            IslandPatchString(tag, node, sink, value) ->
                let encoded = bytes.from_string(value)
                island_put_u16(output, tag)
                island_put_u16(output, 0)
                island_put_u32(output, 24)
                island_put_u32(output, node)
                island_put_u32(output, sink)
                island_put_u32(output, cursor)
                island_put_u32(output, encoded.length())
                cursor = cursor + encoded.length()
            IslandPatchBoolean(node, sink, enabled) ->
                island_put_u16(output, 6)
                island_put_u16(output, 0)
                island_put_u32(output, 20)
                island_put_u32(output, node)
                island_put_u32(output, sink)
                island_put_u32(output, if enabled: 1 else: 0)
            IslandPatchClass(node, value) ->
                let encoded = bytes.from_string(value)
                island_put_u16(output, 16)
                island_put_u16(output, 0)
                island_put_u32(output, 20)
                island_put_u32(output, node)
                island_put_u32(output, cursor)
                island_put_u32(output, encoded.length())
                cursor = cursor + encoded.length()
            IslandPatchListMove(region_id, key, before) ->
                island_put_u16(output, 10)
                island_put_u16(output, 0)
                island_put_u32(output, 20)
                island_put_u32(output, region_id)
                island_put_u32(output, key)
                island_put_u32(output, before)
            IslandPatchListRemove(region_id, key) ->
                island_put_u16(output, 11)
                island_put_u16(output, 0)
                island_put_u32(output, 16)
                island_put_u32(output, region_id)
                island_put_u32(output, key)
            IslandPatchListInsert(region_id, key, before, template, instance, slots) ->
                island_put_u16(output, 9)
                island_put_u16(output, 0)
                island_put_u32(output, 32 + slots.length() * 12)
                island_put_u32(output, region_id)
                island_put_u32(output, key)
                island_put_u32(output, before)
                island_put_u32(output, template)
                island_put_u32(output, instance)
                island_put_u32(output, slots.length())
                for slot in slots:
                    match slot:
                        IslandSlotValue(id, value) ->
                            let encoded = bytes.from_string(value)
                            island_put_u32(output, id)
                            island_put_u32(output, cursor)
                            island_put_u32(output, encoded.length())
                            cursor = cursor + encoded.length()
            IslandPatchDynamicInsert(region_id, key, before, template, slots) ->
                let encoded_key = bytes.from_string(key)
                let encoded_before = bytes.from_string(before)
                island_put_u16(output, 19)
                island_put_u16(output, 0)
                island_put_u32(output, 36 + slots.length() * 12)
                island_put_u32(output, region_id)
                island_put_u32(output, cursor)
                island_put_u32(output, encoded_key.length())
                island_put_u32(output, cursor + encoded_key.length())
                island_put_u32(output, encoded_before.length())
                island_put_u32(output, template)
                island_put_u32(output, slots.length())
                cursor = cursor + encoded_key.length() + encoded_before.length()
                for slot in slots:
                    match slot:
                        IslandSlotValue(id, value) ->
                            let encoded = bytes.from_string(value)
                            island_put_u32(output, id)
                            island_put_u32(output, cursor)
                            island_put_u32(output, encoded.length())
                            cursor = cursor + encoded.length()
            IslandPatchDynamicMove(region_id, key, before) ->
                let encoded_key = bytes.from_string(key)
                let encoded_before = bytes.from_string(before)
                island_put_u16(output, 20)
                island_put_u16(output, 0)
                island_put_u32(output, 28)
                island_put_u32(output, region_id)
                island_put_u32(output, cursor)
                island_put_u32(output, encoded_key.length())
                island_put_u32(output, cursor + encoded_key.length())
                island_put_u32(output, encoded_before.length())
                cursor = cursor + encoded_key.length() + encoded_before.length()
            IslandPatchDynamicRemove(region_id, key) ->
                let encoded = bytes.from_string(key)
                island_put_u16(output, 21)
                island_put_u16(output, 0)
                island_put_u32(output, 20)
                island_put_u32(output, region_id)
                island_put_u32(output, cursor)
                island_put_u32(output, encoded.length())
                cursor = cursor + encoded.length()
            IslandPatchDynamicSlots(region_id, key, slots) ->
                let encoded_key = bytes.from_string(key)
                island_put_u16(output, 22)
                island_put_u16(output, 0)
                island_put_u32(output, 24 + slots.length() * 12)
                island_put_u32(output, region_id)
                island_put_u32(output, cursor)
                island_put_u32(output, encoded_key.length())
                island_put_u32(output, slots.length())
                cursor = cursor + encoded_key.length()
                for slot in slots:
                    match slot:
                        IslandSlotValue(id, value) ->
                            let encoded = bytes.from_string(value)
                            island_put_u32(output, id)
                            island_put_u32(output, cursor)
                            island_put_u32(output, encoded.length())
                            cursor = cursor + encoded.length()
            IslandPatchEnterBranch(region_id, template, instance, slots) ->
                island_put_u16(output, 7)
                island_put_u16(output, 0)
                island_put_u32(output, 24 + slots.length() * 12)
                island_put_u32(output, region_id)
                island_put_u32(output, template)
                island_put_u32(output, instance)
                island_put_u32(output, slots.length())
                for slot in slots:
                    match slot:
                        IslandSlotValue(id, value) ->
                            let encoded = bytes.from_string(value)
                            island_put_u32(output, id)
                            island_put_u32(output, cursor)
                            island_put_u32(output, encoded.length())
                            cursor = cursor + encoded.length()
            IslandPatchLeaveBranch(region_id) ->
                island_put_u16(output, 8)
                island_put_u16(output, 0)
                island_put_u32(output, 12)
                island_put_u32(output, region_id)
            IslandPatchMountChild(region_id, template, instance, slots) ->
                island_put_u16(output, 12)
                island_put_u16(output, 0)
                island_put_u32(output, 24 + slots.length() * 12)
                island_put_u32(output, region_id)
                island_put_u32(output, template)
                island_put_u32(output, instance)
                island_put_u32(output, slots.length())
                for slot in slots:
                    match slot:
                        IslandSlotValue(id, value) ->
                            let encoded = bytes.from_string(value)
                            island_put_u32(output, id)
                            island_put_u32(output, cursor)
                            island_put_u32(output, encoded.length())
                            cursor = cursor + encoded.length()
            IslandPatchUnmountChild(region_id) ->
                island_put_u16(output, 13)
                island_put_u16(output, 0)
                island_put_u32(output, 12)
                island_put_u32(output, region_id)
            IslandPatchSetEventPlan(node, event_class, event_plan) ->
                island_put_u16(output, 14)
                island_put_u16(output, 0)
                island_put_u32(output, 20)
                island_put_u32(output, node)
                island_put_u32(output, event_class)
                island_put_u32(output, event_plan)
            IslandPatchRemoveEventPlan(node, event_class) ->
                island_put_u16(output, 15)
                island_put_u16(output, 0)
                island_put_u32(output, 16)
                island_put_u32(output, node)
                island_put_u32(output, event_class)
    for operation in work:
        cursor = island_write_host_work(output, operation, cursor)
    for change in changes:
        for byte in bytes.from_string(island_patch_payload(change)).to_list():
            output.push(byte)
        match change:
            IslandPatchListInsert(_region, _key, _before, _template, _instance, slots) ->
                for slot in slots:
                    match slot:
                        IslandSlotValue(_id, value) ->
                            for byte in bytes.from_string(value).to_list():
                                output.push(byte)
            IslandPatchDynamicInsert(_region, _key, _before, _template, slots) ->
                for slot in slots:
                    match slot:
                        IslandSlotValue(_id, value) ->
                            for byte in bytes.from_string(value).to_list():
                                output.push(byte)
            IslandPatchDynamicSlots(_region, _key, slots) ->
                for slot in slots:
                    match slot:
                        IslandSlotValue(_id, value) ->
                            for byte in bytes.from_string(value).to_list():
                                output.push(byte)
            IslandPatchEnterBranch(_region, _template, _instance, slots) ->
                for slot in slots:
                    match slot:
                        IslandSlotValue(_id, value) ->
                            for byte in bytes.from_string(value).to_list():
                                output.push(byte)
            IslandPatchMountChild(_region, _template, _instance, slots) ->
                for slot in slots:
                    match slot:
                        IslandSlotValue(_id, value) ->
                            for byte in bytes.from_string(value).to_list():
                                output.push(byte)
            _ -> Nil

    for operation in work:
        for byte in bytes.from_string(island_host_work_payload(operation)).to_list():
            output.push(byte)

    match bytes.from_list(output):
        Ok(frame) -> frame
        Err(_) ->
            fail("glamour island: generated patch frame is invalid")
            bytes.from_string("")

pub fn island_mount(rendered: Ui(msg), template: Int, instance: Int, slots: List(IslandTemplateSlot), events: List(IslandEventDescriptor), app_id: Int, build_low: Int, build_high: Int) -> Bytes:
    island_mount_with_work(rendered, template, instance, slots, events, [], app_id, build_low, build_high)

pub fn island_mount_with_work(rendered: Ui(msg), template: Int, instance: Int, slots: List(IslandTemplateSlot), events: List(IslandEventDescriptor), work: List(IslandHostWork), app_id: Int, build_low: Int, build_high: Int) -> Bytes:
    island_validate_events(ui_node(rendered), events)
    let values = island_template_slot_values(ui_node(rendered), [0], slots)
    var operation_bytes = 28 + values.length() * 12
    for operation in work:
        operation_bytes = operation_bytes + island_host_work_operation_bytes(operation)
    var payload_length = 0
    for value in values:
        match value:
            IslandSlotValue(_id, text) -> payload_length = payload_length + bytes.from_string(text).length()
    for operation in work:
        payload_length = payload_length + bytes.from_string(island_host_work_payload(operation)).length()
    let payload_offset = if payload_length == 0 && work.is_empty(): 0 else: 48 + operation_bytes
    var output: List(Int) = []
    island_put_header(output, 16, 48 + operation_bytes + payload_length, 1 + work.length(), app_id, build_low, build_high, 0, payload_offset)
    island_put_u16(output, 1)
    island_put_u16(output, 0)
    island_put_u32(output, operation_bytes)
    island_put_u32(output, template)
    island_put_u32(output, instance)
    island_put_u32(output, 0)
    island_put_u32(output, 0)
    island_put_u32(output, values.length())
    var cursor = payload_offset
    for value in values:
        match value:
            IslandSlotValue(id, text) ->
                let encoded = bytes.from_string(text)
                island_put_u32(output, id)
                island_put_u32(output, cursor)
                island_put_u32(output, encoded.length())
                cursor = cursor + encoded.length()
    for operation in work:
        cursor = island_write_host_work(output, operation, cursor)
    for value in values:
        match value:
            IslandSlotValue(_id, text) ->
                for byte in bytes.from_string(text).to_list():
                    output.push(byte)
    for operation in work:
        for byte in bytes.from_string(island_host_work_payload(operation)).to_list():
            output.push(byte)
    match bytes.from_list(output):
        Ok(frame) -> frame
        Err(_) ->
            fail("glamour island: generated mount frame is invalid")
            bytes.from_string("")

// ===========================================================================
// The WIRE FORMAT — serialize a VNode tree to JSON the JS DOM host shell
// (`web/witchy-runtime/glamour-dom.mjs`) consumes (RFC-0007's string-bridge,
// RFC-0008's run loop). There is no DOM here; the shell deserializes this and
// builds nodes with `createElement`/`textContent`/`setAttribute` ONLY — never an
// HTML-string sink — so the Perfect-Types-safe render path is structural.
//
// Shape (compact JSON):
//   element : {"el": tag, "attrs": [<attr>...], "kids": [<node>...]}
//   text    : {"text": "..."}
//   <attr>  : ["prop", name, value]            (a static property)
//           | ["on", event, <msg-json>]        (an event->msg binding; the msg is
//                                                serialized by the app's
//                                                `msg_to_json`, sent back verbatim
//                                                by the shell as the next
//                                                `{model, msg}` input)
//
// The `On` binding embeds the message value as JSON via a caller-supplied
// `msg_to_json: fn(msg) -> Json` (symmetric with `parse_msg` on the way back in).
// Passing the serializer as a value — rather than reflecting a still-generic type
// var inside this function — keeps monomorphization happy; `json.from_value(msg)` is
// the obvious `msg_to_json` an app hands in (it works for any `Reflect` msg).
// ===========================================================================
pub fn to_json(node: VNode(msg), msg_to_json: fn(msg) -> Json) -> String:
    json.encode(node_json(node, msg_to_json))

fn node_json(node: VNode(msg), msg_to_json: fn(msg) -> Json) -> Json:
    match node:
        // A secret field carries only its host-slot coordinates (`form`/`field`, read out
        // of the `SecretInput` token) and the non-sensitive `on_ready` msg-tag. No value —
        // the shell owns the bytes; the rune never emitted them.

        // A host slot names its `kind` renderer and carries its `data` payload; the host
        // mounts the widget (glamour never diffs into it).

        // The msg VALUE serialized to JSON — the host sends it back
        // unchanged, so a `${Inc}` event handler round-trips as the
        // `Inc` message into `update`. Events are data.

        // The shell fills the target's value into a `tag(value)` msg on `event`.

        // Keep the live-DOM wire contract identical to `to_html`: an
        // invalid name becomes an inert marker instead of reaching a
        // host `setAttribute`/`addEventListener` sink (BUG-512).
        Planned(plan, inner) ->
            match plan:
                TemplatePlan(id, origin, slots) ->
                    var slot_json: List(Json) = []
                    for slot in slots:
                        match slot:
                            TemplateSlot(index, kind, name) ->
                                slot_json.push(JsonObject([("index", JsonInt(index)), ("kind", JsonString(kind)), ("name", JsonString(name))]))
                    JsonObject([("plan", JsonObject([("version", JsonInt(1)), ("id", JsonString(id)), ("origin", JsonString(origin)), ("slots", JsonArray(slot_json))])), ("node", node_json(inner, msg_to_json))])
        Text(s) -> JsonObject([("text", JsonString(s))])
        Compartment(renderer, grant, on_event) ->
            JsonObject([("compartment", JsonString(renderer)), ("grant", JsonString(grant)), ("on", JsonString(on_event))])
        FrameCompartment(_renderer, _max_grant, _max_event, _grant, _fallback, _id, _decoder) ->
            fail("glamour frame: typed compartments require optimized browser compilation")
            JsonNull
        Keyed(key, inner) ->
            JsonObject([("key", JsonString(key)), ("node", node_json(inner, msg_to_json))])
        // The compatibility JSON host has no structural-region protocol. It
        // receives the active child directly, or one inert text placeholder
        // that keeps sibling indices stable until the optimized path is used.
        Branch(_id, active, inner) -> if active: node_json(inner, msg_to_json) else: JsonObject([("text", JsonString(""))])
        ChildRegion(_id, _template, child) ->
            match child:
                Some(inner) -> node_json(inner, msg_to_json)
                None -> JsonObject([("text", JsonString(""))])
        SecretField(input, on_ready) ->
            match input:
                SecretInput(form, field) ->
                    JsonObject([("secret", JsonObject([("form", JsonString(form)), ("field", JsonString(field))])), ("on_ready", JsonString(on_ready))])
        Slot(kind, data) ->
            JsonObject([("slot", JsonString(kind)), ("data", JsonString(data))])
        IslandBoundary(markup) ->
            match markup:
                IslandMarkup(key, _html, _resume, _templates) -> JsonObject([("island", JsonObject([("key", JsonString(key))]))])
        InteractiveBoundary(plan) ->
            match plan:
                IslandPlan(key, _source_origin, _activation, _prefetch, _name, _start, _markup) -> JsonObject([("island", JsonObject([("key", JsonString(key))]))])
        Element(tag, attrs, children) ->
            var ajs: List(Json) = []
            for a in attrs:
                let aj: Json = match a:
                    Attribute(name, value) ->
                        JsonArray([JsonString("attr"), JsonString(name), JsonString(value)])
                    BooleanAttribute(name, enabled) ->
                        JsonArray([JsonString("bool"), JsonString(name), JsonBool(enabled)])
                    Property(name, value) ->
                        JsonArray([JsonString("property"), JsonString(name), JsonString(value)])
                    UrlAttribute(name, value) ->
                        JsonArray([JsonString("url"), JsonString(name), JsonString(safe_url_or_hash(value))])
                    ClassAttribute(names) ->
                        JsonArray([JsonString("class"), JsonString("class"), JsonString(names.join(" "))])
                    AriaAttribute(name, value) ->
                        JsonArray([JsonString("aria"), JsonString(name), JsonString(value)])
                    CustomProperties(assignments) ->
                        JsonArray([JsonString("attr"), JsonString("style"), JsonString(css_assignment_text(assignments))])
                    Prop(name, value) ->
                        if valid_attr_name(name):
                            JsonArray([JsonString("prop"), JsonString(name), JsonString(value)])
                        else:
                            JsonArray([JsonString("prop"), JsonString("data-glamour-invalid-attr"), JsonString(name)])
                    On(event, msg) ->
                        if valid_tag_name(event):
                            let mj: Json = msg_to_json(msg)
                            JsonArray([JsonString("on"), JsonString(event), mj])
                        else:
                            JsonArray([JsonString("prop"), JsonString("data-glamour-invalid-event"), JsonString("[msg]")])
                    OnInput(event, tag) ->
                        if valid_tag_name(event):
                            JsonArray([JsonString("oninput"), JsonString(event), JsonString(tag)])
                        else:
                            JsonArray([JsonString("prop"), JsonString("data-glamour-invalid-event"), JsonString("[input]")])
                    OnDecoded(id, event, decoder) ->
                        if valid_tag_name(event):
                            JsonArray([JsonString("decode"), JsonString(event), JsonString(id), JsonString(decoder_kind(decoder)), JsonBool(decoder_prevents_default(decoder)), JsonBool(decoder_stops_propagation(decoder))])
                        else:
                            JsonArray([JsonString("prop"), JsonString("data-glamour-invalid-event"), JsonString("[decoder]")])
                ajs.push(aj)
            var kjs: List(Json) = []
            for c in children:
                let cj: Json = node_json(c, msg_to_json)
                kjs.push(cj)
            JsonObject([("el", JsonString(tag)), ("attrs", JsonArray(ajs)), ("kids", JsonArray(kjs))])

// ===========================================================================
// The RUN-LOOP glue (RFC-0008's MVU loop, host-driven). The app author writes a
// single pure `pub fn export_step(input: String) -> String` (the `export_`
// prefix marks it a JS-callable WASM export — see `is_string_export` in codegen).
// The host calls it with `{"model": <model-json>}` (initial render) or
// `{"model": <model-json>, "msg": <msg-json>}` (after an event). `step_with`
// below is the reusable engine: parse the input, run `update(model, msg)` when a
// msg is present, then `view(model)`, and return `{"model": <model-json>,
// "vnode": <vnode-json>}` for the shell to diff into the DOM.
//
// `step_with` is generic over the app's `model`/`msg` and takes `view`/`update`
// and the model/msg encode+decode as first-class function values (the stdlib
// already passes `fn` values throughout). The app supplies:
//   * `parse_model: fn(Json) -> model` / `parse_msg: fn(Json) -> msg` (a small
//     match over its own JSON shape — the inbound boundary), and
//   * `model_to_json: fn(model) -> Json` / `msg_to_json: fn(msg) -> Json` (the
//     outbound boundary; `json.from_value` is the obvious choice for a `Reflect`
//     type).
// `update` returns `(model, Cmd(msg))`; this engine THREADS the `Cmd` through and
// serializes it into the returned JSON (`cmd_to_json`), so the shell — which alone
// holds the authority — can interpret it. The initial render (model-only input,
// no msg) emits `NoCmd`. Passing the serializers as values (rather than a
// `where _: Reflect` bound here) keeps the generic monomorphization tractable —
// the unproven part RFC-0008 flagged.
// ===========================================================================
pub fn step_with(input: String, view: fn(model) -> VNode(msg), update: fn(model, msg) -> (model, Cmd(msg)), parse_model: fn(Json) -> model, parse_msg: fn(Json) -> msg, model_to_json: fn(model) -> Json, msg_to_json: fn(msg) -> Json) -> String:
    let parsed = json.decode(input)
    match parsed:
        // The model is required; a missing/invalid `model` is an error result.

        // Apply `update` only when a `msg` is present (the event step);
        // the initial render has model-only input and so emits `NoCmd`.
        // Kept inline (not a helper) so the `model`/`msg` type vars
        // thread without a cross-function inference hop.

        // Initial render: model-only input, no msg, so no effect.

        // Event step: fold the msg in and carry its command out.

        // Serialize the command so the host shell can interpret it —
        // the shell holds the authority (e.g. the timer); the rune only
        // described the effect here.
        Err(e) -> json.encode(JsonObject([("error", JsonString(json.decode_error_message(e)))]))
        Ok(doc) ->
            match json.get(doc, "model"):
                None -> json.encode(JsonObject([("error", JsonString("missing `model`"))]))
                Some(model_json) ->
                    let model0 = parse_model(model_json)
                    let stepped = match json.get(doc, "msg"):
                        None -> (model0, NoCmd)
                        Some(msg_json) ->
                            let msg = parse_msg(msg_json)
                            update(model0, msg)
                    let (model1, cmd) = stepped
                    let vnode = view(model1)
                    let model_j = model_to_json(model1)
                    let vnode_j = node_json(vnode, msg_to_json)
                    let cmd_j = cmd_to_json(cmd, msg_to_json)
                    json.encode(JsonObject([("model", model_j), ("vnode", vnode_j), ("cmd", cmd_j)]))

fn sub_to_json(subscription: Sub(msg), msg_to_json: fn(msg) -> Json) -> Json:
    match subscription:
        NoSub -> JsonObject([("sub", JsonString("none"))])
        Every(id, timer, milliseconds, message) ->
            match timer:
                UiTimer(min_ms) ->
                    JsonObject([("sub", JsonString("every")), ("id", JsonString(id)), ("ms", JsonInt(milliseconds)), ("min_ms", JsonInt(min_ms)), ("msg", msg_to_json(message))])
        IslandEvery(_descriptor, _completion, _id, _timer, _milliseconds, _message) ->
            fail("glamour island: compiler-owned subscription cannot cross the JSON host")
            JsonNull
        BatchSub(subscriptions) ->
            var encoded: List(Json) = []
            for subscription in subscriptions:
                encoded.push(sub_to_json(subscription, msg_to_json))
            JsonObject([("sub", JsonString("batch")), ("subs", JsonArray(encoded))])

fn event_data_from_json(message: Json) -> EventData:
    EventData(json.get_string(message, "value") ?? "", json.get_bool(message, "checked") ?? false, json.get_string(message, "key") ?? "")

fn result_value(document: Json, index: Int) -> Json:
    match json.get(document, "\$values"):
        Some(values) -> json.index(values, index) ?? JsonNull
        None -> JsonNull

// Helpers for the temporary JSON compatibility boundary. Application
// deserializers use these when a typed completion message returns from the
// host; the binary Phase 2 protocol removes this hand-written JSON glue.
pub fn http_result_from_json(document: Json) -> HttpResult:
    match json.get_string(document, "\$variant"):
        Some("HttpResponse") -> HttpResponse(json.as_int(result_value(document, 0)) ?? 0, json.as_string(result_value(document, 1)) ?? "")
        Some("HttpFailure") -> HttpFailure(json.as_string(result_value(document, 0)) ?? "")
        _ -> HttpFailure("invalid HTTP completion")

pub fn navigation_result_from_json(document: Json) -> NavigationResult:
    match json.get_string(document, "\$variant"):
        Some("Navigated") -> Navigated(json.as_string(result_value(document, 0)) ?? "")
        Some("NavigationFailure") -> NavigationFailure(json.as_string(result_value(document, 0)) ?? "")
        _ -> NavigationFailure("invalid navigation completion")

pub fn port_result_from_json(document: Json) -> PortResult:
    match json.get_string(document, "\$variant"):
        Some("PortResponse") -> PortResponse(json.as_string(result_value(document, 0)) ?? "")
        Some("PortFailure") -> PortFailure(json.as_string(result_value(document, 0)) ?? "")
        _ -> PortFailure("invalid port completion")

// RFC-0107 Program runner over the current JSON host. Initial input carries
// `{"start":{"route":"...","bootstrap":"..."}}`; subsequent calls carry the
// returned model plus either a reflected compatibility msg or a typed
// `{"$glamour_event":"stable-id", ...allowlisted fields...}` event.
pub fn program_step_with(input: String, root: UiRoot, app: Program(auth, model, msg), parse_model: fn(Json) -> model, parse_msg: fn(Json) -> msg, model_to_json: fn(model) -> Json, msg_to_json: fn(msg) -> Json) -> String:
    let parsed = json.decode(input)
    match parsed:
        Err(error) -> json.encode(JsonObject([("error", JsonString(json.decode_error_message(error)))]))
        Ok(document) ->
            match app:
                Program(authorize, initial, start_program, update, render, subscriptions) ->
                    let auth = authorize(root)
                    let initial_or_model = match json.get(document, "model"):
                        Some(model_json) -> Some(parse_model(model_json))
                        None -> None

                    let stepped = match initial_or_model:
                        None ->
                            let start_json = json.get(document, "start") ?? JsonObject([])
                            let start = Start(json.get_string(start_json, "route") ?? "/", json.get_string(start_json, "bootstrap") ?? "")
                            let model = initial(start)
                            (model, start_program(auth, model))
                        Some(model0) ->
                            match json.get(document, "msg"):
                                None -> (model0, NoCmd)
                                Some(message_json) ->
                                    match json.get_string(message_json, "\$glamour_event"):
                                        None -> update(auth, model0, parse_msg(message_json))
                                        Some(id) ->
                                            let old_ui = render(model0)
                                            match find_decoder(ui_node(old_ui), id):
                                                None -> (model0, NoCmd)
                                                Some(decoder) ->
                                                    match decode_event(decoder, event_data_from_json(message_json)):
                                                        None -> (model0, NoCmd)
                                                        Some(message) -> update(auth, model0, message)

                    let (model1, command) = stepped
                    let rendered = render(model1)
                    let subscription = subscriptions(auth, model1)
                    json.encode(JsonObject([("model", model_to_json(model1)), ("vnode", node_json(ui_node(rendered), msg_to_json)), ("cmd", cmd_to_json(command, msg_to_json)), ("subs", sub_to_json(subscription, msg_to_json))]))

// Static CSS tagged literal. Asset holes are accepted only as sealed CssImage
// values and only as the complete value of an image-valued declaration. Other
// dynamic values use typed custom-property APIs rather than entering stylesheet
// syntax. The emitted sheet is deterministic and already scoped.
pub comptime fn css(parts: List(String), holes: List(String), origin: String) -> meta.ExprSyntax:
    css_literal_source(parts, holes, origin, "css_sheet_from_source")

pub comptime fn global_css(parts: List(String), holes: List(String), origin: String) -> meta.ExprSyntax:
    css_literal_source(parts, holes, origin, "global_css_sheet_from_source")

// Media conditions share one static parser with delivery-policy publication.
// Dynamic strings cannot construct the sealed MediaQuery boundary.
pub comptime fn media(parts: List(String), holes: List(String), _origin: String) -> meta.ExprSyntax:
    if !holes.is_empty() || parts.length() != 1:
        fail("glamour media: interpolations are not allowed")
    let query = parts.at(0).trim()
    if !valid_media_query(query):
        fail("glamour media: expected a bounded static CSS media condition")
    meta.expr_raw("media_query_literal(\"" + escape_src(query) + "\")")

comptime fn css_literal_source(parts: List(String), holes: List(String), origin: String, builder: String) -> meta.ExprSyntax:
    for part in parts:
        if part.to_lower().contains("url("):
            fail("glamour css: write asset URLs with a typed glamour.css_asset interpolation")
        if part.to_lower().contains("var("):
            fail("glamour css: write custom-property references with a typed glamour.css_var interpolation")
    var source = "\"" + escape_src(parts.at(0)) + "\""
    var index = 0
    while index < holes.length():
        let before = parts.at(index)
        let after = parts.at(index + 1)
        let renderer = css_hole_renderer(before, after)
        source = source + " + " + renderer + "(" + holes.at(index) + ") + \"" + escape_src(after) + "\""
        index = index + 1
    meta.expr_raw(builder + "(" + source + ", \"" + escape_src(origin) + "\")")

fn css_hole_renderer(before: String, after: String) -> String:
    let block_parts = before.split("{")
    let block = block_parts.at(block_parts.length() - 1)
    let declaration_parts = block.split(";")
    let declaration = declaration_parts.at(declaration_parts.length() - 1)
    match declaration.index_of(":"):
        None ->
            fail("glamour css: interpolation must be the complete value of a supported property")
            ""
        Some(colon) ->
            let property = declaration.substring(0, colon).trim().to_lower()
            let suffix = after.trim()
            if !suffix.starts_with(";") && !suffix.starts_with("}"):
                fail("glamour css: interpolation must be the complete property value")
            if property == "background-image" || property == "border-image-source" || property == "list-style-image":
                "css_image_text"
            else if property == "color" || property == "background-color" || property == "border-color" || property == "border-top-color" || property == "border-right-color" || property == "border-bottom-color" || property == "border-left-color" || property == "outline-color" || property == "text-decoration-color" || property == "fill" || property == "stroke":
                "css_color_text"
            else if property == "gap" || property == "row-gap" || property == "column-gap" || property == "width" || property == "height" || property == "min-width" || property == "min-height" || property == "max-width" || property == "max-height" || property == "margin-top" || property == "margin-right" || property == "margin-bottom" || property == "margin-left" || property == "padding-top" || property == "padding-right" || property == "padding-bottom" || property == "padding-left" || property == "font-size" || property == "border-width" || property == "border-radius":
                "css_length_text"
            else if property == "opacity" || property == "z-index" || property == "flex-grow" || property == "flex-shrink" || property == "order":
                "css_number_text"
            else if property == "background-position-x" || property == "background-position-y" || property == "font-stretch":
                "css_percentage_text"
            else if property == "rotate":
                "css_angle_text"
            else if property == "animation-duration" || property == "animation-delay" || property == "transition-duration" || property == "transition-delay":
                "css_time_text"
            else:
                fail("glamour css: interpolation is not supported for property `${property}`")
                ""

fn validate_css(source: String) -> Bool:
    let lower = source.to_lower()
    if source.contains("\\") || source.contains("/*") || source.contains("*/") || lower.contains("@import") || lower.contains("javascript:") || lower.contains("expression(") || lower.contains("</style") || lower.contains("-moz-binding") || lower.contains("behavior:"):
        fail("glamour css: unsafe stylesheet construct")
    validate_css_blocks(source, true)
    true

fn validate_css_blocks(source: String, allow_media: Bool):
    for head, body in css_blocks(source):
        if head.starts_with("@"):
            if !allow_media || !head.to_lower().starts_with("@media "):
                fail("glamour css: only top-level @media rules are supported")
            let query = head.substring(6, head.char_count()).trim()
            if !valid_media_query(query):
                fail("glamour css: invalid @media condition")
            validate_css_blocks(body, false)
        else if head.contains("@") || body.contains("@"):
            fail("glamour css: at-rules are allowed only as top-level @media blocks")

fn css_blocks(source: String) -> List((String, String)):
    let characters = source.chars()
    var blocks: List((String, String)) = []
    var start = 0
    var open = -1
    var depth = 0
    var index = 0
    for character in characters:
        if character == "{":
            if depth == 0:
                open = index
            depth = depth + 1
        else if character == "}":
            depth = depth - 1
            if depth < 0:
                fail("glamour css: unmatched `}`")
            else if depth == 0:
                let head = source.substring(start, open).trim()
                if head.is_empty():
                    fail("glamour css: expected a selector or @media condition")
                blocks.push((head, source.substring(open + 1, index)))
                start = index + 1
        index = index + 1
    if depth != 0:
        fail("glamour css: unmatched `{`")
    if !source.substring(start, source.char_count()).trim().is_empty():
        fail("glamour css: expected `{` before declarations")
    blocks

fn valid_css_asset_path(value: String) -> Bool:
    if value == "/" || !value.starts_with("/") || value.starts_with("//") || value.contains("%") || value.contains("?") || value.contains("#") || value.contains("\\"):
        false
    else:
        for segment in value.split("/"):
            if segment == "." || segment == "..":
                return false
        for character in value.chars():
            if !name_alpha().contains(character) && !"0123456789/-_.".contains(character):
                return false
        true

fn css_class_names(source: String) -> List(String):
    var names: List(String) = []
    for head, body in css_blocks(source):
        if head.to_lower().starts_with("@media "):
            for name in css_class_names(body):
                if !names.contains(name):
                    names.push(name)
        else:
            let chars = head.chars()
            let n = chars.length()
            var i = 0
            while i < n:
                if chars.at(i) == ".":
                    var j = i + 1
                    var name = ""
                    while j < n && css_ident_char(chars.at(j)):
                        name = name + chars.at(j)
                        j = j + 1
                    if !name.is_empty() && !names.contains(name):
                        names.push(name)
                    i = j
                else:
                    i = i + 1
    names

fn css_ident_char(c: String) -> Bool:
    name_alpha().contains(c) || "0123456789-_".contains(c)

fn scope_css(source: String, scope: String) -> String:
    render_css_blocks(source, scope, true, true)

fn normalize_global_css(source: String) -> String:
    render_css_blocks(source, "", false, true)

fn render_css_blocks(source: String, scope: String, scoped: Bool, allow_media: Bool) -> String:
    var out = ""
    for head, body in css_blocks(source):
        if head.starts_with("@"):
            if !allow_media || !head.to_lower().starts_with("@media "):
                fail("glamour css: only top-level @media rules are supported")
            let query = head.substring(6, head.char_count()).trim()
            if !valid_media_query(query):
                fail("glamour css: invalid @media condition")
            out = out + "@media " + query + " {\n" + render_css_blocks(body, scope, scoped, false) + "}\n"
        else:
            let selectors = head.split(",")
            var normalized: List(String) = []
            for selector in selectors:
                let value = selector.trim()
                if value.is_empty():
                    fail("glamour css: selector must not be empty")
                if scoped:
                    normalized.push("[data-glamour-scope=\"${scope}\"] " + value)
                else:
                    normalized.push(value)
            out = out + normalized.join(", ") + " { " + body.trim() + "}\n"
    out

// ===========================================================================
// The `html` tag — a COMPILE-TIME tagged literal (RFC-0006). `html"<div…>"`
// expands DURING COMPILATION: this function runs once in the compiler, receives
// the static fragments (`parts`) and an OPAQUE MARKER per hole (`holes` — each
// element is a `__witchy_hole_N` token, NOT the hole's source), and returns typed
// expression syntax constructing a `VNode`. The tag PLACES each marker where the
// hole's value belongs; `tagged::expand` substitutes the real hole expression
// (parsed once at the call site, carrying its source position) at each marker. The
// emitted constructors receive definition-site identity, so they resolve in this
// module and cannot be shadowed by a call-site local — the hygiene
// split (RFC-0006). The result is spliced over the literal, so both backends
// compile the same AST.
//
// Holes are typed BY POSITION (the headline safety property):
//   * a hole in TEXT position      -> a stable typed child region; String is
//     inert text, while VNode and Ui values splice checked structure directly.
//   * a hole in ATTRIBUTE-VALUE    -> `prop("name", <marker>)`
//     position
//   * a hole in `on:event=${...}`  -> `on("event", <marker>)`  (events as
//     data; the hole is a `msg` value).
//   * a hole in a FORBIDDEN spot   -> `fail("…")` at comptime, aborting the
//     (e.g. as a tag NAME)            compile with a message naming the problem.
//
// Supported subset: nested `<tag attr=… on:evt=…>children</tag>`, self-closing
// `<tag/>`, static text, static `name="value"` / `name=value` attributes, and
// `${}` holes in text / attribute-value / event positions. NOT supported (noted):
// HTML comments, entities beyond the escape set, boolean attributes without a
// value, and namespaced/SVG tags.
// ===========================================================================
pub comptime fn html(parts: List(String), holes: List(String), origin: String) -> meta.ExprSyntax:
    meta.expr_raw(template_literal_source(parts, holes, origin))

fn template_literal_source(parts: List(String), holes: List(String), origin: String) -> String:
    // A source `\0` escape is legal in a tagged literal's static parts, but NUL
    // is the private hole-marker delimiter below. Reject it before weaving so
    // static text can never be parsed as a synthetic hole (BUG-439).
    let _safe_parts = reject_static_nul(parts)
    // Reconstruct the full template, replacing each hole with a sentinel marker
    // `<NUL>N<NUL>`, so the parser can walk a single char stream and recover
    // hole `N`'s source when it meets a marker.
    let template = weave(parts)
    let toks = lex_html(template)
    let _accessible = check_template_accessibility(toks)
    // Parse one top-level node (the RFC's examples are single-rooted).
    let parsed = parse_node(toks, 0, holes)
    let (src, next) = parsed
    // (BUG-227) A template must have exactly ONE root: reject any content after it.
    let _checked = no_trailing_tokens(toks, next)
    // The plan identity depends only on normalized static structure and slot
    // positions, never byte offsets, line numbers, formatting outside the
    // literal, or runtime hole values. Identical templates intentionally share
    // one host plan. `origin` remains separate diagnostic metadata.
    let slots = emit_template_slots(toks)
    let id = "glamour-tp1-" + crypto.sha256(src + "|" + slots)
    "planned(\"" + id + "\", \"" + escape_src(origin) + "\", [" + slots + "], " + src + ")"

// JSX-shaped authoring through Witchy's existing general tagged-literal
// mechanism. This is a library tag, not a lexer mode: it deliberately shares
// html's parser, hygiene, positional typing, and XSS guarantees.
pub comptime fn jsx(parts: List(String), holes: List(String), origin: String) -> meta.ExprSyntax:
    meta.expr_raw(template_literal_source(parts, holes, origin))

fn reject_static_nul(parts: List(String)) -> Bool:
    let nul = string.from_code(0)
    for part in parts:
        if part.contains(nul):
            let _bad = fail("glamour html: NUL is not allowed in static template text")
    true

// (BUG-227) After the single root node, no meaningful tokens may remain — a second root
// (`<div/><span/>`) or trailing markup is a compile-time error. Whitespace-only text runs
// (indentation/newlines around the template) are ignored. Returns `true` when clean; `fail`s
// at comptime otherwise.
fn no_trailing_tokens(toks: List(HtmlTok), from: Int) -> Bool:
    let n = toks.length()
    var i = from
    while i < n:
        if let TextRun(s) = toks.at(i):
            if !s.trim().is_empty():
                let _b = fail("glamour html: content after the root element — a template must have a single root")
        else:
            let _b2 = fail("glamour html: more than one root element — wrap the roots in a single parent")
        i = i + 1
    true

// Static accessibility facts are checked while the tag still has source-hole
// positions. Dynamic labels/alt text are accepted as typed String holes; missing
// relationships fail during expansion rather than becoming browser warnings.
fn check_template_accessibility(toks: List(HtmlTok)) -> Bool:
    var ids: List(String) = []
    var label_targets: List(String) = []
    for tok in toks:
        if let Open(name, attrs, _self_close) = tok:
            if let Some(id) = static_template_attr(attrs, "id"):
                if ids.contains(id):
                    fail("glamour html accessibility: duplicate static id `${id}`")
                ids.push(id)
            if name == "label":
                if let Some(target) = static_template_attr(attrs, "for"):
                    label_targets.push(target)

    var i = 0
    while i < toks.length():
        if let Open(name, attrs, self_close) = toks.at(i):
            if name == "img" && !template_has_attr(attrs, "alt"):
                fail("glamour html accessibility: <img> requires an alt attribute")
            if name == "a" && !template_has_attr(attrs, "href"):
                fail("glamour html accessibility: <a> requires a typed href")
            if name == "button" && !template_has_attr(attrs, "aria-label") && !template_region_has_name(toks, i + 1, "button"):
                fail("glamour html accessibility: <button> requires text content or aria-label")
            if name == "input" && !template_is_hidden_input(attrs) && !template_has_attr(attrs, "aria-label"):
                match static_template_attr(attrs, "id"):
                    Some(id) ->
                        if !label_targets.contains(id):
                            fail("glamour html accessibility: <input id=\"${id}\"> needs a matching <label for=\"${id}\"> or aria-label")
                    None -> fail("glamour html accessibility: <input> needs an id with matching label, or aria-label")

            if self_close && name == "button":
                fail("glamour html accessibility: a self-closing <button> has no accessible name")
        i = i + 1
    true

fn template_has_attr(attrs: List(HAttr), wanted: String) -> Bool:
    var found = false
    for attr in attrs:
        match attr:
            SProp(name, _value) ->
                if name == wanted:
                    found = true
            SBool(name, _enabled) ->
                if name == wanted:
                    found = true
            HProp(name, _index) ->
                if name == wanted:
                    found = true
            _ -> Nil

    found

fn static_template_attr(attrs: List(HAttr), wanted: String) -> Option(String):
    var found: Option(String) = None
    for attr in attrs:
        if let SProp(name, value) = attr:
            if name == wanted:
                found = Some(value)
    found

fn template_is_hidden_input(attrs: List(HAttr)) -> Bool:
    match static_template_attr(attrs, "type"):
        Some(kind) -> kind.to_lower() == "hidden"
        None -> false

fn template_region_has_name(toks: List(HtmlTok), start: Int, closing: String) -> Bool:
    var i = start
    var depth = 0
    var named = false
    var done = false
    while i < toks.length() && !done:
        match toks.at(i):
            TextRun(value) ->
                if !value.trim().is_empty():
                    named = true
            HoleNode(_index) -> named = true
            Open(name, _attrs, self_close) ->
                if name == closing && !self_close:
                    depth = depth + 1
            Close(name) ->
                if name == closing:
                    if depth == 0:
                        done = true
                    else:
                        depth = depth - 1
            _ -> Nil

        i = i + 1
    named

// Interleave static parts with NUL-delimited hole markers: part0 + M0 + part1 +
// M1 + … . `parts.len() == holes.len() + 1`, so every gap gets exactly one
// marker indexed by its position.
fn weave(parts: List(String)) -> String:
    // idiom-exempt: this emits the parser's NUL-delimited hole wire format.
    let nul = string.from_code(0)
    var out = ""
    var i = 0
    let n = parts.length()
    for p in parts:
        out = out + p
        if i < n - 1:
            out = out + nul + "${i}" + nul
        i = i + 1
    out

// ---- a tiny HTML lexer over the woven template ----
// Tokens are encoded as strings for simplicity (no extra type leaks into the
// rune's public surface): a tag-open marker, attributes, text runs, and holes.
type HtmlTok:
    Open(String, List(HAttr), Bool)
    Close(String)
    TextRun(String)
    HoleNode(Int)

// `<tag` open (the tag name; "" if the name was a forbidden hole — caught
// later) with the parsed attributes and whether it self-closed (`/>`).

// `</tag>` close.

// A run of literal text (already de-woven: holes inside text are separate).

// A `${N}` hole appearing in TEXT position (child of an element).
type HAttr:
    SProp(String, String)
    SBool(String, Bool)
    HProp(String, Int)
    HOn(String, Int)
    Bad(String)

// `name="value"` / `name=value` — a static attribute.

// `name=${N}` — an attribute whose value is hole `N`.

// `on:event=${N}` — an event binding to hole `N` (a `msg` value).

// `on:event=${N}` written with a static literal is rejected at parse time;
// a forbidden attribute shape becomes `Bad(message)`.
fn lex_html(s: String) -> List(HtmlTok):
    let cs = s.chars()
    let n = cs.length()
    var out = []
    var i = 0
    var text = ""
    let nul = string.from_code(0)
    while i < n:
        let c = cs.at(i)
        if c == nul:
            // A hole marker `<NUL>N<NUL>` in TEXT position.
            if text.length() > 0:
                out.push(TextRun(text))
                text = ""
            let (idx, j) = read_marker(cs, i, nul)
            out.push(HoleNode(idx))
            i = j
        else if c == "<":
            if text.length() > 0:
                out.push(TextRun(text))
                text = ""
            let (tok, j) = lex_tag(cs, i, nul)
            out.push(tok)
            i = j
        else:
            text = text + c
            i = i + 1
    if text.length() > 0:
        out.push(TextRun(text))
    out

// Read a NUL-delimited marker `<NUL>digits<NUL>` starting at `i` (which is the
// opening NUL). Returns (hole index, index after the closing NUL).
fn read_marker(cs: List(String), i: Int, nul: String) -> (Int, Int):
    var j = i + 1
    var digits = ""
    let n = cs.length()
    while j < n && cs.at(j) != nul:
        digits = digits + cs.at(j)
        j = j + 1
    (digits.to_int(), j + 1)

// Lex a `<...>` tag starting at the `<`. Returns (token, index after `>`).
fn lex_tag(cs: List(String), start: Int, nul: String) -> (HtmlTok, Int):
    let n = cs.length()
    var i = start + 1
    // Closing tag `</name>`.
    if i < n && cs.at(i) == "/":
        i = i + 1
        var name = ""
        while i < n && cs.at(i) != ">":
            name = name + cs.at(i)
            i = i + 1
        (Close(name.trim()), i + 1)
    else:
        // Opening tag: read the name (up to whitespace, `>`, or `/`). A name that
        // is or contains a hole marker is FORBIDDEN.
        var name = ""
        if i < n && cs.at(i) == nul:
            // Tag name is a hole — forbidden. Emit an empty-named Open carrying a
            // marker the parser turns into a comptime `fail`.
            let (_idx, j) = read_marker(cs, i, nul)
            (Open("", [], false), j)
        else:
            while i < n && !is_name_end(cs.at(i)):
                name = name + cs.at(i)
                i = i + 1
            let (attrs, j, self_close) = lex_attrs(cs, i, nul)
            (Open(name.trim(), attrs, self_close), j)

fn is_name_end(c: String) -> Bool:
    c == " " || c == "\t" || c == "\n" || c == "\r" || c == ">" || c == "/"

fn is_ws(c: String) -> Bool:
    c == " " || c == "\t" || c == "\n" || c == "\r"

// Lex the attribute list after the tag name, up to (and consuming) `>` or `/>`.
// Returns (attrs, index after `>`, self_closing?).
fn lex_attrs(cs: List(String), start: Int, nul: String) -> (List(HAttr), Int, Bool):
    let n = cs.length()
    var i = start
    var attrs = []
    while i < n:
        let c = cs.at(i)
        if is_ws(c):
            i = i + 1
        else if c == ">":
            return (attrs, i + 1, false)
        else if c == "/":
            // `/>` self-close.
            return (attrs, i + 2, true)
        else:
            let (attr, j) = lex_one_attr(cs, i, nul)
            attrs.push(attr)
            i = j
    (attrs, i, false)

// Lex a single `name=value` (or `on:event=value`) attribute.
fn lex_one_attr(cs: List(String), start: Int, nul: String) -> (HAttr, Int):
    let n = cs.length()
    var i = start
    var name = ""
    while i < n && !is_attr_name_end(cs.at(i)):
        name = name + cs.at(i)
        i = i + 1
    // Bare attributes are accepted only for the pinned boolean-attribute set.
    if i >= n || cs.at(i) != "=":
        if template_boolean_attr(name):
            (SBool(name, true), i)
        else:
            (Bad("attribute `${name}` has no value and is not a supported boolean attribute"), i)
    else:
        i = i + 1
        // Value: a bare `${N}` hole, a `"quoted"` value (static OR a single `"${N}"` hole),
        // or a bare token.
        if i < n && cs.at(i) == nul:
            let (idx, j) = read_marker(cs, i, nul)
            (hole_attr(name, idx), j)
        else if i < n && cs.at(i) == "\"":
            // (BUG-405) A quoted value: recognize the natural `href="${url}"` spelling as a
            // hole, not static text (which used to capture the NUL marker literally).
            lex_quoted_attr(cs, i, nul, name)
        else:
            let (value, j) = lex_attr_value(cs, i, nul)
            // A static value for an `on:` handler is rejected — events are data.
            if name.starts_with("on:"):
                (Bad("event `${name}` needs a \${msg} hole, not a static value"), j)
            else:
                (SProp(name, value), j)

// (BUG-405) Lex a double-quoted attribute value starting at the opening `"`. Three shapes:
//   * `"${N}"`  — exactly one hole: substituted like the bare `name=${N}` form (`hole_attr`).
//   * `"text"`  — static: emitted as `SProp` (or rejected for an `on:` handler — events are
//                 data, not a static string).
//   * `"x ${N}"`— MIXED static + hole: rejected (`Bad`) until concatenated attribute
//                 expressions are intentionally designed.
// Returns (attr, index after the closing quote).
fn lex_quoted_attr(cs: List(String), start: Int, nul: String, name: String) -> (HAttr, Int):
    let n = cs.length()
    let body_start = start + 1
    if body_start < n && cs.at(body_start) == nul:
        // Leads with a hole marker: valid only if the closing quote immediately follows it.
        let (idx, after_marker) = read_marker(cs, body_start, nul)
        if after_marker < n && cs.at(after_marker) == "\"":
            (hole_attr(name, idx), after_marker + 1)
        else:
            (Bad("attribute `${name}` mixes static text and a \${hole} in a quoted value — unsupported"), scan_to_quote(cs, after_marker))
    else:
        // Static (or mixed) text: read to the closing quote; a marker anywhere inside means
        // the value mixes static text and a hole.
        var v = ""
        var has_hole = false
        var k = body_start
        while k < n && cs.at(k) != "\"":
            if cs.at(k) == nul:
                has_hole = true
            v = v + cs.at(k)
            k = k + 1
        let after = k + 1
        if has_hole:
            (Bad("attribute `${name}` mixes static text and a \${hole} in a quoted value — unsupported"), after)
        else if name.starts_with("on:"):
            (Bad("event `${name}` needs a \${msg} hole, not a static value"), after)
        else:
            (SProp(name, v), after)

// Advance past the next closing `"` from `start` (used to resynchronize after a rejected
// mixed quoted value). Returns the index just after the quote.
fn scan_to_quote(cs: List(String), start: Int) -> Int:
    let n = cs.length()
    var i = start
    while i < n && cs.at(i) != "\"":
        i = i + 1
    i + 1

fn is_attr_name_end(c: String) -> Bool:
    c == "=" || is_ws(c) || c == ">" || c == "/"

fn hole_attr(name: String, idx: Int) -> HAttr:
    if name.starts_with("on:"):
        HOn(name.drop(3), idx)
    else:
        HProp(name, idx)

// Read a static attribute value: `"quoted"` (may contain a hole marker? no — a
// holed value is handled by the caller) or a bare token up to whitespace/`>`.
fn lex_attr_value(cs: List(String), start: Int, nul: String) -> (String, Int):
    let n = cs.length()
    var i = start
    if i < n && cs.at(i) == "\"":
        i = i + 1
        var v = ""
        while i < n && cs.at(i) != "\"":
            v = v + cs.at(i)
            i = i + 1
        (v, i + 1)
    else:
        var v = ""
        while i < n && !is_name_end(cs.at(i)):
            v = v + cs.at(i)
            i = i + 1
        (v, i)

// ---- the parser: tokens -> witchy expression source building a VNode ----

// Parse the node starting at token `at`. Returns (source, index after the node).
fn parse_node(toks: List(HtmlTok), at: Int, holes: List(String)) -> (String, Int):
    let n = toks.length()
    if at >= n:
        fail("glamour html: empty template — expected a single root element")
        ("", at)
    else:
        match toks.at(at):
            TextRun(s) -> (emit_text_literal(s), at + 1)
            HoleNode(idx) -> (emit_text_hole(idx, holes), at + 1)
            Close(name) ->
                let _bad = fail("glamour html: unexpected closing tag </${name}>")
                ("", at + 1)
            Open(name, attrs, self_close) -> parse_element(toks, at, name, attrs, self_close, holes)

fn parse_element(toks: List(HtmlTok), at: Int, name: String, attrs: List(HAttr), self_close: Bool, holes: List(String)) -> (String, Int):
    // idiom-exempt: this parser emits Witchy source and must preserve quoting byte-for-byte.
    if name.length() == 0:
        let _bad = fail("glamour html: a tag NAME may not be a \${hole} — the element name must be static")
        ("", at + 1)
    else if !safe_template_element(name):
        let _bad2 = fail("glamour html: unsupported or unsafe platform element <${name}>")
        ("", at + 1)
    else:
        let attr_src = emit_attrs(attrs, holes)
        if self_close:
            ("element(\"" + escape_src(name) + "\", [" + attr_src + "], [])", at + 1)
        else:
            let (kids_src, after) = parse_children(toks, at + 1, name, holes)
            ("element(\"" + escape_src(name) + "\", [" + attr_src + "], [" + kids_src + "])", after)

// Parse children until the matching `</name>`. Returns (comma-joined child
// sources, index after the close tag).
fn parse_children(toks: List(HtmlTok), at: Int, name: String, holes: List(String)) -> (String, Int):
    let n = toks.length()
    var i = at
    var kids = []
    var done = false
    var closed = false
    while i < n && !done:
        // (BUG-227) A close tag must MATCH the element being parsed. The old loop closed on
        // ANY `</…>`, so `<div><span>x</div>` (mismatched) and `<div><span>x` (missing close,
        // ending at EOF) both silently "succeeded". Compare the name and fail on a mismatch;
        // an unterminated element (EOF before its close) is caught by `!closed` below.
        if let Close(close_name) = toks.at(i):
            if close_name == name:
                closed = true
            else:
                let _bad = fail("glamour html: expected </${name}>, found </${close_name}>")
            done = true
            i = i + 1
        else:
            let (src, j) = parse_node(toks, i, holes)
            kids.push(src)
            i = j
    if !closed:
        let _bad2 = fail("glamour html: unclosed <${name}> — missing its </${name}>")
    (kids.join(", "), i)

// ---- emitters: produce witchy expression SOURCE ----

// idiom-exempt: these emitters assemble Witchy source and preserve quoting byte-for-byte.

// Static text -> `text("…")` with the literal string-escaped for re-parsing.
fn emit_text_literal(s: String) -> String:
    "text(\"" + escape_src(s) + "\")"

// A text-position hole becomes a stable child region. Compiler lowering admits
// only inert String text, a checked VNode, or a checked Ui; arbitrary values
// cannot stringify themselves into markup. `holes.at(idx)` is the opaque
// compiler expression token substituted without a source round trip.
fn emit_text_hole(idx: Int, holes: List(String)) -> String:
    "template_child_region(\"template-child-${idx}\", template_child_value(" + holes.at(idx) + "))"

// Build the compile-time dynamic-slot table in lexical order. Hole indices are
// assigned by Witchy's tagged-literal parser and remain stable when application
// code outside the literal is reformatted. The table deliberately records sink
// categories so the browser host never has to infer whether a dynamic value is
// text, a URL, a property, an ARIA value, or an event.
fn emit_template_slots(toks: List(HtmlTok)) -> String:
    var slots = []
    for tok in toks:
        match tok:
            HoleNode(index) ->
                slots.push("template_slot(${index}, \"child\", \"\")")
            Open(_name, attrs, _self_close) ->
                for attr in attrs:
                    match attr:
                        HProp(name, index) ->
                            slots.push("template_slot(${index}, \"" + template_attr_kind(name) + "\", \"" + escape_src(name) + "\")")
                        HOn(event, index) ->
                            slots.push("template_slot(${index}, \"event\", \"" + escape_src(event) + "\")")
                        _ -> Nil
            _ -> Nil

    slots.join(", ")

fn template_attr_kind(name: String) -> String:
    if name == "href" || name == "src" || name == "action" || name == "formaction" || name == "poster":
        "url"
    else if name == "value":
        "property"
    else if template_boolean_attr(name):
        "boolean"
    else if name == "class":
        "class"
    else if name.starts_with("aria-"):
        "aria"
    else:
        "attribute"

fn emit_attrs(attrs: List(HAttr), holes: List(String)) -> String:
    var srcs = []
    for a in attrs:
        srcs.push(emit_attr(a, holes))
    srcs.join(", ")

fn emit_attr(a: HAttr, holes: List(String)) -> String:
    match a:
        SProp(name, value) ->
            let _name_ok = check_template_attr(name)
            emit_static_attr(name, value)
        SBool(name, enabled) ->
            let _name_ok = check_template_attr(name)
            let enabled_src = if enabled: "true" else: "false"
            "boolean_attribute(\"" + escape_src(name) + "\", " + enabled_src + ")"
        HProp(name, idx) ->
            let _name_ok = check_template_attr(name)
            emit_dynamic_attr(name, holes.at(idx))
        HOn(event, idx) ->
            let _event_ok = check_template_event(event)
            "on(\"" + escape_src(event) + "\", " + holes.at(idx) + ")"
        Bad(msg) ->
            let _bad = fail("glamour html: ${msg}")
            ""

fn emit_static_attr(name: String, value: String) -> String:
    let escaped_name = escape_src(name)
    let escaped_value = escape_src(value)
    if name == "href":
        let _safe = require_static_navigation_url(name, value)
        "static_url_attribute(\"" + escaped_name + "\", \"" + escaped_value + "\")"
    else if name == "action" || name == "formaction":
        let _safe = require_static_form_url(name, value)
        "static_form_url_attribute(\"" + escaped_name + "\", \"" + escaped_value + "\")"
    else if name == "src" || name == "poster":
        let _safe = require_static_asset_url(name, value)
        "static_asset_url_attribute(\"" + escaped_name + "\", \"" + escaped_value + "\")"
    else if template_boolean_attr(name):
        "boolean_attribute(\"" + escaped_name + "\", true)"
    else if name == "value":
        "property(\"" + escaped_name + "\", \"" + escaped_value + "\")"
    else if name == "class":
        "static_class_attribute([\"" + value.split(" ").map(fn(token: String): escape_src(token)).join("\", \"") + "\"])"
    else if name.starts_with("aria-"):
        "aria_attribute(\"" + escaped_name + "\", \"" + escaped_value + "\")"
    else:
        "attribute(\"" + escaped_name + "\", \"" + escaped_value + "\")"

fn emit_dynamic_attr(name: String, marker: String) -> String:
    let escaped_name = escape_src(name)
    if name == "href":
        "navigation_url_attribute(\"" + escaped_name + "\", " + marker + ")"
    else if name == "action" || name == "formaction":
        "form_url_attribute(\"" + escaped_name + "\", " + marker + ")"
    else if name == "src" || name == "poster":
        "asset_url_attribute(\"" + escaped_name + "\", " + marker + ")"
    else if template_boolean_attr(name):
        "boolean_attribute(\"" + escaped_name + "\", " + marker + ")"
    else if name == "value":
        "property(\"" + escaped_name + "\", " + marker + ")"
    else if name == "class":
        "class_attribute(" + marker + ")"
    else if name.starts_with("aria-"):
        "aria_attribute(\"" + escaped_name + "\", " + marker + ")"
    else:
        "attribute(\"" + escaped_name + "\", " + marker + ")"

fn safe_template_element(name: String) -> Bool:
    let elements = "|a|abbr|address|article|aside|b|bdi|bdo|blockquote|br|button|caption|cite|code|col|colgroup|data|datalist|dd|del|details|dfn|dialog|div|dl|dt|em|fieldset|figcaption|figure|footer|form|h1|h2|h3|h4|h5|h6|header|hgroup|hr|i|img|input|ins|kbd|label|legend|li|main|mark|menu|meter|nav|ol|optgroup|option|output|p|picture|pre|progress|q|rp|rt|ruby|s|samp|section|select|small|source|span|strong|sub|summary|sup|table|tbody|td|textarea|tfoot|th|thead|time|tr|u|ul|var|wbr|"
    elements.contains("|" + name.to_lower() + "|")

fn template_boolean_attr(name: String) -> Bool:
    let attrs = "|disabled|required|readonly|multiple|hidden|open|checked|selected|autofocus|novalidate|"
    attrs.contains("|" + name.to_lower() + "|")

fn check_template_attr(name: String) -> Bool:
    let lower = name.to_lower()
    let attrs = "|id|title|name|type|value|class|role|for|href|src|alt|action|formaction|poster|method|placeholder|autocomplete|tabindex|width|height|min|max|step|pattern|accept|rows|cols|scope|colspan|rowspan|datetime|lang|dir|rel|target|download|loading|decoding|disabled|required|readonly|multiple|hidden|open|checked|selected|autofocus|novalidate|"
    if !valid_attr_name(name) || lower.starts_with("on") || lower == "srcdoc":
        fail("glamour html: unsupported or unsafe attribute `${name}`")
        false
    else if attrs.contains("|" + lower + "|") || lower.starts_with("data-") || lower.starts_with("aria-"):
        true
    else:
        fail("glamour html: attribute `${name}` is not in Glamour's pinned browser schema")
        false

fn check_template_event(event: String) -> Bool:
    let events = "|click|input|change|submit|keydown|keyup|blur|focus|pointerdown|pointerup|mousedown|mouseup|touchstart|touchend|"
    if valid_tag_name(event) && events.contains("|" + event.to_lower() + "|"):
        true
    else:
        fail("glamour html: event `${event}` is not in Glamour's pinned event schema")
        false

fn require_static_navigation_url(name: String, value: String) -> Bool:
    match safe_navigation_url(value):
        Ok(_) -> true
        Err(_) ->
            fail("glamour html: unsafe static URL in `${name}`")
            false

fn require_static_form_url(name: String, value: String) -> Bool:
    match safe_form_url(value):
        Ok(_) -> true
        Err(_) ->
            fail("glamour html: unsafe static URL in `${name}`")
            false

fn require_static_asset_url(name: String, value: String) -> Bool:
    match safe_asset_url(value):
        Ok(_) -> true
        Err(_) ->
            fail("glamour html: unsafe static URL in `${name}`")
            false

// Escape a string so it can be re-parsed as a witchy string LITERAL (the emitted
// source is parsed by the compiler). Backslash first, then quote.
fn escape_src(s: String) -> String:
    var out = s.replace("\\", "\\\\")
    out = out.replace("\"", "\\\"")
    out
