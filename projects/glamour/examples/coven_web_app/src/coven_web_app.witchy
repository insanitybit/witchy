// coven_web_app — the COMPLETE coven-web frontend as ONE glamour app (RFC-0015 Phase D):
// the routed, data-fetched, authenticated shell that replaces the TypeScript app. All four
// views (catalog, version record, API docs, registry trust) are wired into one MVU loop;
// every fetch is performed by the host shell (which attaches the session credential itself),
// every navigation is a real URL, and login + promote/yank go through host PORTS (the
// WebAuthn ceremony runs in the host, never the rune). The rune is capability-PURE — no Net,
// no token, empty footprint — so the whole trusted shell is XSS-immune by construction;
// authority lives entirely at the JS host edge (glamour-dom.mjs + the fetch/session/passkey
// ports). State is 4 strings — the route, the signed-in identity, the current view's raw
// response, and a status notice — because only one view is active at a time.

import markdown
import highlight
import list
import reflect
import time
from glamour import Cmd, CredentialPort, HttpResult, NavigationResult, PortResult, Program, Start, Sub, Ui, UiFetch, UiRoot, UiRoute, VNode
from json import Json

// State is 5 strings + the enabled social-login providers (a list like ["github"], injected
// by the host from the server's provider config): the route, the signed-in identity, the
// current view's raw response, a status notice, the search query, and which social-login
// buttons the signed-out header should offer (a passkey-only instance carries an empty list,
// so no GitHub/Google button — whose route would 404 — is ever rendered).
type Model:
    Model(String, String, String, String, String, List(String))

type Msg derive(Reflect):
    Route(String)
    Visit(String)
    GotData(HttpResult)
    NavigationDone(NavigationResult)
    Login
    Register
    LoggedIn(PortResult)
    Promote
    Yank
    OpDone(PortResult)
    Search(String)

// (RFC-0039) The app's capability BUNDLE. Glamour narrows the app-root `UiRoot` into
// exactly the tokens this shell needs — read-only fetch, navigation, and the four named
// host credential ports — and `export_step` threads this ONE value into `update`. A
// component can construct only the effect whose token it was handed, and each
// `CredentialPort` BAKES IN its port name, so the promote token can never emit a yank:
// the authority graph is explicit, reviewable, and unforgeable.
type Caps:
    //   fetch     router   login          register        promote         yank
    Caps(UiFetch, UiRoute, CredentialPort, CredentialPort, CredentialPort, CredentialPort)

// --- routing + effects -------------------------------------------------------
fn fetch_for(fetch: UiFetch, path: String) -> Cmd(Msg):
    if path.starts_with("/trust"):
        glamour.http_get("coven-web.data", fetch, "/api/coven/rootpub", fn(result: HttpResult): GotData(result))
    else if path.starts_with("/d/"):
        let (name, ver) = name_ver(path)
        glamour.http_get("coven-web.data", fetch, "/api/coven/doc?name=${name}&version=${ver}", fn(result: HttpResult): GotData(result))
    else if path.starts_with("/s/"):
        let (name, ver) = name_ver(path)
        glamour.http_get("coven-web.data", fetch, "/api/coven/source?name=${name}&version=${ver}", fn(result: HttpResult): GotData(result))
    else if path.starts_with("/v/"):
        let (name, ver) = name_ver(path)
        glamour.http_get("coven-web.data", fetch, "/api/coven/record?name=${name}&version=${ver}", fn(result: HttpResult): GotData(result))
    else:
        glamour.http_get("coven-web.data", fetch, "/api/coven/catalog", fn(result: HttpResult): GotData(result))

fn update(caps: Caps, m: Model, msg: Msg) -> (Model, Cmd(Msg)):
    match caps:
        // A write (or register) finished: show its result AND re-fetch the current view so
        // the record reflects the new state immediately (a promote flips staged -> released).
        Caps(fetch, router, login, register, promote_cred, yank_cred) ->
            match m:
                Model(route, sess, data, notice, query, providers) ->
                    match msg:
                        Visit(path) -> (m, glamour.navigate("coven-web.navigation", router, path, fn(result: NavigationResult): NavigationDone(result)))
                        Route(path) -> (Model(path, sess, "", "", "", providers), fetch_for(fetch, path))
                        GotData(result) ->
                            match result:
                                HttpResponse(_status, body) -> (Model(route, sess, body, notice, query, providers), NoCmd)
                                HttpFailure(problem) -> (Model(route, sess, data, problem, query, providers), NoCmd)
                                _ -> (m, NoCmd)
                        NavigationDone(result) ->
                            match result:
                                Navigated(path) -> (Model(path, sess, "", "", "", providers), fetch_for(fetch, path))
                                _ -> (m, NoCmd)
                        Login -> (m, glamour.port("coven-web.login", login, "", fn(result: PortResult): LoggedIn(result)))
                        Register -> (Model(route, sess, data, "registering passkey…", query, providers), glamour.port("coven-web.register", register, "", fn(result: PortResult): OpDone(result)))
                        LoggedIn(result) ->
                            match result:
                                PortResponse(who) -> (Model(route, who, data, "", query, providers), NoCmd)
                                PortFailure(problem) -> (Model(route, sess, data, problem, query, providers), NoCmd)
                                _ -> (m, NoCmd)
                        Promote -> (Model(route, sess, data, "promoting…", query, providers), glamour.port("coven-web.promote", promote_cred, route, fn(result: PortResult): OpDone(result)))
                        Yank -> (Model(route, sess, data, "yanking…", query, providers), glamour.port("coven-web.yank", yank_cred, route, fn(result: PortResult): OpDone(result)))
                        OpDone(result) ->
                            match result:
                                PortResponse(value) -> (Model(route, sess, data, value, query, providers), fetch_for(fetch, route))
                                PortFailure(problem) -> (Model(route, sess, data, problem, query, providers), NoCmd)
                                _ -> (m, NoCmd)
                        Search(q) -> (Model(route, sess, data, notice, q, providers), NoCmd)

// --- views -------------------------------------------------------------------
fn view(m: Model) -> Ui(Msg):
    match m:
        Model(route, sess, data, notice, query, providers) ->
            glamour.ui(glamour.element("div", [glamour.prop("class", "app")], [header(sess, notice, providers), body(route, data, sess, query)]))

fn header(sess: String, notice: String, providers: List(String)) -> VNode(Msg):
    let auth = auth_node(sess, providers)

    // "Profile" appears only when signed in (session identity is non-empty).
    let profile_nav = if sess.is_empty(): glamour.text("") else: glamour.element("button", [glamour.prop("class", "button link"), glamour.on("click", Visit("/profile"))], [glamour.text("Profile")])

    glamour.element("nav", [glamour.prop("class", "topnav")], [glamour.element("button", [glamour.prop("class", "button link"), glamour.on("click", Visit("/"))], [glamour.text("Runes")]), glamour.element("button", [glamour.prop("class", "button link"), glamour.on("click", Visit("/trust"))], [glamour.text("Trust")]), profile_nav, auth, glamour.element("span", [glamour.prop("class", "muted notice")], [glamour.text(notice)])])

// The signed-out auth affordances: the passkey sign-in + register buttons (host credential
// PORTS, exactly as before) PLUS a plain same-origin link per enabled social-login provider.
// A social login is NOT a credential port — it is an ordinary full-page navigation to the
// server's `/auth/<provider>/login`, which mints a session and redirects back to `/#token=…`
// (main.ts's adoptLoginFragment then labels the header with the real identity). When signed
// in, only the identity chip shows. `providers` is injected by the host from the server's
// live config, so a passkey-only instance renders no social button (its route would 404).
fn auth_node(sess: String, providers: List(String)) -> VNode(Msg):
    if sess.is_empty():
        var kids = [glamour.element("button", [glamour.prop("class", "button link"), glamour.on("click", Login)], [glamour.text("sign in with passkey")]), glamour.element("button", [glamour.prop("class", "button link ghost"), glamour.on("click", Register)], [glamour.text("register")])]
        for node in social_logins(providers):
            kids.push(node)
        glamour.element("span", [glamour.prop("class", "nav-auth")], kids)
    else:
        glamour.element("span", [glamour.prop("class", "nav-auth")], [glamour.element("span", [glamour.prop("class", "session-id")], [glamour.text("● signed in as ${sess}")])])

// One "sign in with <Provider>" link per enabled provider, as an ordinary same-origin anchor
// to the server route (glamour scheme-checks href, so this relative path passes untouched).
fn social_logins(providers: List(String)) -> List(VNode(Msg)):
    var out = []
    for p in providers:
        if p == "github":
            out.push(glamour.element("a", [glamour.prop("class", "button link"), glamour.prop("href", "/auth/github/login")], [glamour.text("sign in with GitHub")]))
        else if p == "google":
            out.push(glamour.element("a", [glamour.prop("class", "button link"), glamour.prop("href", "/auth/google/login")], [glamour.text("sign in with Google")]))
    out

fn body(route: String, data: String, sess: String, query: String) -> VNode(Msg):
    if route.starts_with("/trust"):
        trust_view(data)
    else if route.starts_with("/profile"):
        profile_view(data, sess)
    else if route.starts_with("/d/"):
        docs_view(route, data)
    else if route.starts_with("/s/"):
        source_view(route, data)
    else if route.starts_with("/v/"):
        version_view(route, data, sess)
    else:
        catalog_view(data, query)

// catalog: a crates.io-style list. Each row LEADS with the rune name + version and its publish
// metadata — author, lifecycle state, release date — the things you scan a registry for. A rune's
// required capabilities are a quiet secondary line, not the headline. The search box still filters
// by name, author, OR capability (so "Net" finds everything that touches the network); filtering
// is pure (the model holds the query, no fetch per keystroke).
fn catalog_view(data: String, query: String) -> VNode(Msg):
    let all = parse_runes(data)
    let q = query.to_lower()
    var items = []
    for r in all:
        let name = json.get_string(r, "name").unwrap_or("?")
        let ver = json.get_string(r, "version").unwrap_or("0.0.0")
        let caps = json.get_strings(r, "runtime_footprint")
        let author = json.get_string(r, "uploaded_by").unwrap_or("unknown")
        let st = json.get_string(r, "state").unwrap_or("staged")
        if q.is_empty() || rune_matches(name, caps, author, q):
            items.push(glamour.keyed(name, rune_card(name, ver, caps, author, st, gi(r, "released_at"))))
    let shown = items.length()
    let total = all.length()
    let noun = if total == 1: "rune" else: "runes"
    let label = if query.is_empty(): "${total} ${noun}" else: "${shown} of ${total} ${noun}"
    let listing = if items.is_empty() && !query.is_empty(): glamour.element("p", [glamour.prop("class", "empty-state")], [glamour.text("no runes match '${query}'")]) else: glamour.element("ul", [glamour.prop("class", "rune-list")], items)
    glamour.element("section", [glamour.prop("class", "catalog")], [glamour.element("h1", [], [glamour.text("Runes")]), glamour.element("input", [glamour.prop("class", "field search"), glamour.prop("type", "search"), glamour.prop("placeholder", "search runes by name, author, or capability"), glamour.on_input("input", "Search")], []), glamour.element("p", [glamour.prop("class", "muted count")], [glamour.text(label)]), listing])

// One catalog row (crates.io card): name + version is the link; the right rail carries the
// lifecycle badge, the author byline, and the release date; the footprint is a quiet "needs" line.
fn rune_card(name: String, ver: String, caps: List(String), author: String, st: String, released: Int) -> VNode(Msg):
    let date_node = if released > 0: glamour.element("span", [glamour.prop("class", "meta-date")], [glamour.text("published ${fmt_date(released)}")]) else: glamour.element("span", [glamour.prop("class", "meta-date dim")], [glamour.text("not yet released")])
    glamour.element("li", [glamour.prop("class", "rune-row")], [glamour.element("div", [glamour.prop("class", "rune-main")], [glamour.element("button", [glamour.prop("class", "rune-name"), glamour.on("click", Visit("/v/${wire(name)}/${ver}"))], [glamour.text(name), glamour.element("span", [glamour.prop("class", "ver")], [glamour.text(" v${ver}")])]), needs(caps)]), glamour.element("div", [glamour.prop("class", "rune-meta")], [state_badge(st), glamour.element("span", [glamour.prop("class", "meta-by")], [glamour.text("by ${author}")]), date_node])])

// the quiet, secondary footprint line: small chips, still color-coded by danger but low-key.
fn needs(caps: List(String)) -> VNode(Msg):
    if caps.is_empty():
        glamour.element("span", [glamour.prop("class", "needs")], [glamour.element("span", [glamour.prop("class", "chip-sm cap-none")], [glamour.text("no authority")])])
    else:
        var cs = []
        for c in caps:
            cs.push(glamour.element("span", [glamour.prop("class", "chip-sm cap-${cap_kind(c)}")], [glamour.text(c)]))
        glamour.element("span", [glamour.prop("class", "needs")], cs)

fn state_badge(st: String) -> VNode(Msg):
    glamour.element("span", [glamour.prop("class", "badge state-${st}")], [glamour.text(st)])

fn gi(j: Json, k: String) -> Int:
    match json.get(j, k):
        Some(v) -> json.as_int(v).unwrap_or(0)
        None -> 0

// Format a unix-SECONDS timestamp as a crates.io-style date, e.g. "Jun 23, 2026" (pure: no Clock).
fn fmt_date(secs: Int) -> String:
    time.format(time.from_unix(secs), "%b %d, %Y")

fn parse_runes(data: String) -> List(Json):
    match json.decode(data):
        Ok(doc) -> json.as_array(json.get(doc, "runes").unwrap_or(JsonNull)).unwrap_or([])
        Err(_e) -> []

// A rune matches the filter if its name, author, or any footprint capability contains the query.
fn rune_matches(name: String, caps: List(String), author: String, q: String) -> Bool:
    if name.to_lower().contains(q) || author.to_lower().contains(q):
        true
    else:
        var hit = false
        for c in caps:
            if c.to_lower().contains(q):
                hit = true
        hit

// profile: the logged-in user's home. Shows WHO you are (the session identity the host handed
// back after passkey login) and YOUR runes — filtered out of the already-fetched catalog by the
// publisher/subject that matches your identity, so no new server endpoint is needed. When the
// session identity is a passkey placeholder that can't be matched to any publisher, we show the
// identity and an honest empty state rather than faking ownership; it fills in once real SSO
// carries a publisher-scoped subject.
fn profile_view(data: String, sess: String) -> VNode(Msg):
    let all = parse_runes(data)
    var mine = []
    for r in all:
        let name = json.get_string(r, "name").unwrap_or("?")
        let ver = json.get_string(r, "version").unwrap_or("0.0.0")
        let caps = json.get_strings(r, "runtime_footprint")
        let author = json.get_string(r, "uploaded_by").unwrap_or("unknown")
        let st = json.get_string(r, "state").unwrap_or("staged")
        if rune_matches_identity(r, sess):
            mine.push(glamour.keyed(name, rune_card(name, ver, caps, author, st, gi(r, "released_at"))))
    let listing = if mine.is_empty(): glamour.element("p", [glamour.prop("class", "empty-state")], [glamour.text("You haven't published any runes under this identity yet.")]) else: glamour.element("ul", [glamour.prop("class", "rune-list")], mine)
    glamour.element("article", [glamour.prop("class", "profile")], [glamour.element("h1", [], [glamour.text("Profile")]), glamour.element("p", [glamour.prop("class", "session-id")], [glamour.text("● signed in as ${sess}")]), glamour.element("h2", [glamour.prop("class", "profile-runes-title")], [glamour.text("Your runes")]), listing])

// A rune belongs to you if its uploader OR its attested provenance subject equals your identity.
fn rune_matches_identity(r: Json, ident: String) -> Bool:
    if ident.is_empty():
        false
    else:
        let id = ident.to_lower()
        let author = json.get_string(r, "uploaded_by").unwrap_or("")
        let sub = prov_field(json.get_string(r, "provenance").unwrap_or(""), "sub")
        !author.is_empty() && author.to_lower() == id || !sub.is_empty() && sub.to_lower() == id

// version: the signed record (security audit) + promote/yank (when signed in) + a docs link.
fn version_view(route: String, data: String, sess: String) -> VNode(Msg):
    let (name, ver) = name_ver(route)
    let rows = record_rows(data)
    let controls = if sess.is_empty(): glamour.element("p", [glamour.prop("class", "muted")], [glamour.text("sign in to promote or yank")]) else: glamour.element("div", [glamour.prop("class", "promote")], [glamour.element("button", [glamour.prop("class", "button"), glamour.on("click", Promote)], [glamour.text("promote")]), glamour.element("button", [glamour.prop("class", "button"), glamour.on("click", Yank)], [glamour.text("yank")])])

    glamour.element("article", [glamour.prop("class", "version")], [glamour.element("button", [glamour.prop("class", "button link"), glamour.on("click", Visit("/"))], [glamour.text("← all runes")]), glamour.element("h1", [], [glamour.text(unwire(name)), glamour.element("span", [glamour.prop("class", "ver")], [glamour.text(" v${ver}")])]), record_subhead(data), glamour.element("dl", [glamour.prop("class", "record")], rows), install_block(name), controls, glamour.element("div", [glamour.prop("class", "viewlinks")], [glamour.element("button", [glamour.prop("class", "button link"), glamour.on("click", Visit("/d/${name}/${ver}"))], [glamour.text("API documentation →")]), glamour.element("button", [glamour.prop("class", "button link"), glamour.on("click", Visit("/s/${name}/${ver}"))], [glamour.text("source →")])])])

// UI-01: the "how to install" affordance the record page was missing. A copy-paste command
// (with the hosted registry pinned via COVEN_URL) plus a one-line note that a release still in
// its 72h staging cooldown needs `--allow-fresh`. Pure text nodes — no HTML sink.
fn install_block(name: String) -> VNode(Msg):
    glamour.element("section", [glamour.prop("class", "install")], [glamour.element("h2", [glamour.prop("class", "install-title")], [glamour.text("install")]), glamour.element("pre", [glamour.prop("class", "install-cmd")], [glamour.element("code", [], [glamour.text("COVEN_URL=https://witchy.fly.dev witchy add ${unwire(name)}")])]), glamour.element("p", [glamour.prop("class", "muted install-note")], [glamour.text("A release still inside its 72h staging cooldown needs --allow-fresh.")])])

// source: every file of the package, rendered inline as <pre><code> and SYNTAX-HIGHLIGHTED by the
// shared `highlight` module (`.witchy` and `.toml` get classed <span> runs; other files fall back
// to plain text). Untrusted stranger-uploaded source is DATA, and the highlighter emits only
// glamour.text nodes — never an HTML sink — so it is XSS-immune INLINE in the trusted shell, no
// sandbox/compartment needed (RFC-0015 §0: foreign *code* gets a compartment; untrusted *data*
// renders inline, safe by construction).
fn source_view(route: String, data: String) -> VNode(Msg):
    let (name, ver) = name_ver(route)
    let files = match json.decode(data):
        Ok(doc) -> json.as_array(json.get(doc, "files").unwrap_or(JsonNull)).unwrap_or([])
        Err(_e) -> []

    var blocks = []
    blocks.push(glamour.element("button", [glamour.prop("class", "button link"), glamour.on("click", Visit("/v/${name}/${ver}"))], [glamour.text("← ${unwire(name)} @ ${ver}")]))
    blocks.push(glamour.element("h1", [], [glamour.text("source")]))
    for f in files:
        let path = json.as_string(json.index(f, 0).unwrap_or(JsonNull)).unwrap_or("?")
        let contents = json.as_string(json.index(f, 1).unwrap_or(JsonNull)).unwrap_or("")
        blocks.push(glamour.keyed(path, glamour.element("div", [glamour.prop("class", "srcfile")], [glamour.element("div", [glamour.prop("class", "srcpath")], [glamour.text(path)]), glamour.element("pre", [glamour.prop("class", "src")], [glamour.element("code", [], highlight.code_spans(path, contents))])])))

    glamour.element("article", [glamour.prop("class", "source")], blocks)

// The crates.io-style byline under the title: lifecycle badge · author · release date. The
// human-facing facts lead; the cryptographic audit (footprint, provenance, hash) is the dl below.
fn record_subhead(data: String) -> VNode(Msg):
    match json.decode(data):
        Ok(doc) ->
            let st = json.get_string(doc, "state").unwrap_or("staged")
            let author = json.get_string(doc, "uploaded_by").unwrap_or("unknown")
            let released = gi(doc, "released_at")
            let date_txt = if released > 0: "published ${fmt_date(released)}" else: "not yet released"
            glamour.element("div", [glamour.prop("class", "version-meta")], [state_badge(st), glamour.element("span", [glamour.prop("class", "meta-by")], [glamour.text("by ${author}")]), glamour.element("span", [glamour.prop("class", "meta-date")], [glamour.text(date_txt)])])
        Err(_e) -> glamour.text("")

fn record_rows(data: String) -> List(VNode(Msg)):
    match json.decode(data):
        Ok(doc) ->
            var rows = []
            rows = rows.concat(dt_chips("footprint", json.get_strings(doc, "runtime_footprint")))
            rows = rows.concat(row("determinism", json.get_string(doc, "determinism").unwrap_or("?")))
            rows = rows.concat(provenance_rows(json.get_string(doc, "provenance").unwrap_or("")))
            rows = rows.concat(row("hash", json.get_string(doc, "hash").unwrap_or("?")))
            rows
        Err(_e) -> []

// UI-02: provenance arrives as a pipe-delimited machine string, e.g.
// `trusted-publisher|issuer=admin|sub=colin|repository=x/y|verified_at=1786141989`. Parse it
// into labeled sub-rows, render `verified_at` as a human date, relabel `sub`->subject, and drop
// empty fields (a bare `ref=`) rather than dumping the raw string at the reader.
fn provenance_rows(prov: String) -> List(VNode(Msg)):
    if prov.is_empty() || prov == "?":
        row("provenance", "unattested")
    else:
        var out = []
        let parts = prov.split("|")
        for part in parts:
            if part.contains("="):
                let (k, v) = part.split_once("=")
                if !v.is_empty():
                    out = out.concat(row(prov_label(k), prov_value(k, v)))
            else if !part.is_empty():
                out = out.concat(row("provenance", part))
        out

fn prov_label(k: String) -> String:
    if k == "sub":
        "subject"
    else if k == "verified_at":
        "verified"
    else:
        k

fn prov_value(k: String, v: String) -> String:
    if k == "verified_at":
        fmt_date(v.parse_int().unwrap_or(0))
    else:
        v

// The provenance subject a rune was published under: the attested `sub`, else the uploader.
fn prov_field(prov: String, key: String) -> String:
    var out = ""
    let parts = prov.split("|")
    for part in parts:
        if part.contains("="):
            let (k, v) = part.split_once("=")
            if k == key:
                out = v
    out

// API docs. Carries the same "← <name> @ <ver>" back button as `source_view`, so the two
// secondary views a record links to are navigationally consistent (UI-08).
fn docs_view(route: String, data: String) -> VNode(Msg):
    let (name, ver) = name_ver(route)
    let md = match json.decode(data):
        Ok(doc) -> json.get_string(doc, "markdown").unwrap_or("(no docs)")
        Err(_e) -> "loading…"

    glamour.element("article", [glamour.prop("class", "apidocs")], [glamour.element("button", [glamour.prop("class", "button link"), glamour.on("click", Visit("/v/${name}/${ver}"))], [glamour.text("← ${unwire(name)} @ ${ver}")]), markdown.to_vnode(md)])

fn trust_view(data: String) -> VNode(Msg):
    let rootpub = if data.is_empty(): "loading…" else: data
    glamour.element("article", [glamour.prop("class", "trust")], [glamour.element("h1", [], [glamour.text("Registry trust (TUF)")]), glamour.element("p", [glamour.prop("class", "muted trust-note")], [glamour.text("This is the registry's TUF root public key — the trust anchor every download is verified against. It changes only when the registry rotates its signing keys, so pinning it lets your client detect a compromised or substituted registry.")]), glamour.element("dl", [glamour.prop("class", "record")], row("root key", rootpub))])

// --- small view helpers ------------------------------------------------------
fn row(label: String, value: String) -> List(VNode(Msg)):
    [glamour.element("dt", [], [glamour.text(label)]), glamour.element("dd", [], [glamour.text(value)])]

fn dt_chips(label: String, caps: List(String)) -> List(VNode(Msg)):
    [glamour.element("dt", [], [glamour.text(label)]), glamour.element("dd", [], [chips(caps)])]

fn chips(caps: List(String)) -> VNode(Msg):
    if caps.is_empty():
        glamour.element("span", [glamour.prop("class", "chip cap-none")], [glamour.text("no authority")])
    else:
        var cs = []
        for c in caps:
            cs.push(glamour.element("span", [glamour.prop("class", "chip cap cap-${cap_kind(c)}")], [glamour.text(c)]))
        glamour.element("span", [glamour.prop("class", "chips")], cs)

// Classify a footprint capability so the UI can color-code authority: the dangerous ones
// (foreign Js code, Exec, Net egress, filesystem, secrets) get their own conspicuous hue,
// the benign ambient ones (Console/Clock/Env/Random) read as plain.
fn cap_kind(c: String) -> String:
    let lc = c.to_lower()
    if lc.starts_with("js"):
        "js"
    else if lc.starts_with("exec"):
        "exec"
    else if lc.starts_with("net"):
        "net"
    else if lc.starts_with("file") || lc.starts_with("dir"):
        "fs"
    else if lc.starts_with("secret"):
        "secret"
    else:
        "plain"

// --- path helpers ------------------------------------------------------------
fn wire(name: String) -> String:
    name.replace("/", "~")

fn unwire(w: String) -> String:
    w.replace("~", "/")

// "/v/<name>/<version>" or "/d/<name>/<version>" -> (name, version). `name` stays wire-encoded.
fn name_ver(path: String) -> (String, String):
    let rest = path.drop(3)
    if rest.contains("/"):
        rest.split_once("/")
    else:
        (rest, "")

// --- MVU glue ----------------------------------------------------------------
fn gs(j: Json, k: String) -> String:
    json.get_string(j, k).unwrap_or("")

fn parse_model(j: Json) -> Model:
    Model(gs(j, "route"), gs(j, "session"), gs(j, "data"), gs(j, "notice"), gs(j, "query"), json.get_strings(j, "providers"))

fn model_to_json(m: Model) -> Json:
    match m:
        Model(route, sess, data, notice, query, providers) ->
            var pvs = []
            for p in providers:
                pvs.push(JsonString(p))
            JsonObject([("route", JsonString(route)), ("session", JsonString(sess)), ("data", JsonString(data)), ("notice", JsonString(notice)), ("query", JsonString(query)), ("providers", JsonArray(pvs))])

fn aj(j: Json, i: Int) -> Json:
    match json.get(j, "\$values"):
        Some(arr) -> json.index(arr, i).unwrap_or(JsonNull)
        None -> JsonNull

fn as_(j: Json, i: Int) -> String:
    match json.get(j, "\$values"):
        Some(arr) -> json.as_string(json.index(arr, i).unwrap_or(JsonNull)).unwrap_or("")
        None -> ""

fn parse_msg(j: Json) -> Msg:
    match json.get_string(j, "\$variant"):
        Some(v) ->
            if v == "Visit":
                Visit(as_(j, 0))
            else if v == "GotData":
                GotData(glamour.http_result_from_json(aj(j, 0)))
            else if v == "NavigationDone":
                NavigationDone(glamour.navigation_result_from_json(aj(j, 0)))
            else if v == "Login":
                Login
            else if v == "Register":
                Register
            else if v == "LoggedIn":
                LoggedIn(glamour.port_result_from_json(aj(j, 0)))
            else if v == "Promote":
                Promote
            else if v == "Yank":
                Yank
            else if v == "OpDone":
                OpDone(glamour.port_result_from_json(aj(j, 0)))
            else if v == "Search":
                Search(as_(j, 0))
            else:
                Route(as_(j, 0))
        None -> Route("/")

fn msg_to_json(m: Msg) -> Json:
    json.from_value(m)

fn authorize(ui: UiRoot) -> Caps:
    Caps(glamour.fetch_scope(ui, "coven-web", "GET", "/api/coven/"), glamour.route_scope(ui, "/", "push"), glamour.credential_port(ui, "passkeyLogin"), glamour.credential_port(ui, "passkeyRegister"), glamour.credential_port(ui, "promote"), glamour.credential_port(ui, "yank"))

fn initial(start: Start) -> Model:
    match start:
        Start(route, _bootstrap) -> Model(route, "", "", "", "", [])

fn start(_caps: Caps, _model: Model) -> Cmd(Msg):
    NoCmd

fn subscriptions(_caps: Caps, _model: Model) -> Sub(Msg):
    glamour.no_sub()

fn app() -> Program(Caps, Model, Msg):
    glamour.program(authorize, initial, start, update, view, subscriptions)

pub fn export_step(ui: UiRoot, input: String) -> String:
    glamour.program_step_with(input, ui, app(), parse_model, parse_msg, model_to_json, msg_to_json)

fn main(console: Console, ui: UiRoot):
    let output = export_step(ui, "{\"model\": {\"route\": \"/\", \"session\": \"\", \"data\": \"\", \"notice\": \"\"}}")
    console.print("${output}\n")
