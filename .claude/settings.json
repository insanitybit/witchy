{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/worktree-warm.sh || true",
            "timeout": 120,
            "statusMessage": "Warming worktree build cache"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/worktree-create.sh",
            "timeout": 300,
            "statusMessage": "Creating worktree with warm build cache"
          }
        ]
      }
    ]
  }
}
