import dict
import option
import string

fn main(console: Console):
    var d = dict_new()
    let k = string.trim("  host  ")   // runtime-built string with content "host"
    d = insert(d, k, "localhost")
    print(console, "stored key length = " <> int_to_string(string_length(k)))
    match dict.get(d, "host"):        // look up with a literal "host"
        Some(v) -> print(console, "dict.get found: " <> v)
        None -> print(console, "dict.get: NONE (lookup failed!)")
