type Account:
    name: String
    balance: Int

type Direction:
    North
    South
    East
    West

type Shape:
    Circle(Int)
    Rectangle(Int, Int)
    Triangle(Int, Int, Int)

fn deposit(a: Account, amount: Int) -> Account:
    Account(balance: a.balance + amount, ..a)

fn area(s: Shape) -> Int:
    match s:
        Circle(r) -> 3 * r * r
        Rectangle(w, h) -> w * h
        Triangle(a, b, c) -> (a * b + b * c + c * a) / 3

fn turn_right(d: Direction) -> Direction:
    match d:
        North -> East
        East -> South
        South -> West
        West -> North

fn head_describe(xs: List(Int)) -> String:
    match xs:
        [] -> "empty"
        [only] -> "one: ${only}"
        [first, ..rest] -> "first ${first}, rest length ${list.length(rest)}"

fn sign(n: Int) -> String:
    match n:
        0 -> "zero"
        m if m > 0 -> "positive"
        _ -> "negative"

fn main(console: Console):
    let a = Account("ada", 100)
    let richer = deposit(a, 50)
    print(console, "${a.name}: ${a.balance}")
    print(console, "${richer.name}: ${richer.balance}")

    print(console, "${turn_right(North)}")
    print(console, "circle r=3 area=${area(Circle(3))}")
    print(console, "rect 4x5 area=${area(Rectangle(4, 5))}")
    print(console, "tri 3,4,5 area=${area(Triangle(3, 4, 5))}")

    print(console, head_describe([]))
    print(console, head_describe([7]))
    print(console, head_describe([1, 2, 3]))

    print(console, sign(0))
    print(console, sign(5))
    print(console, sign(0 - 3))
