import regex

fn main(console: Console):
    let text = "ab123cd"
    print(console, "find \\d+: ${regex.find("\\d+", text)}")
    print(console, "find [0-9]+: ${regex.find("[0-9]+", text)}")
    print(console, "extract \\d+: ${regex.extract("\\d+", text)}")
    print(console, "extract [0-9]+: ${regex.extract("[0-9]+", text)}")
    // Quantifiers on \d
    print(console, "find \\d: ${regex.find("\\d", text)}")
