// Probe: actor with a narrowed Dir[Write] subdir, plus message delegation.

import string
import list

actor Auditor:
    log: Dir[Write]

impl Auditor:
    on Record(line: String):
        write(log, "audit.txt", line)
    on Stop():
        // nothing to clean up; demonstrates an empty handler
        write(log, "audit.txt", "STOP")

actor Boss:
    console: Console
    auditor: Subject

impl Boss:
    on Tick(label: String):
        send(auditor, Record("tick:${label}"))
        print(console, "logged ${label}")

fn main(console: Console, dir: Dir):
    let audit_dir = subdir(dir, "audit") as Dir[Write]
    let auditor = spawn Auditor(audit_dir)
    let boss = spawn Boss(console, auditor)
    send(boss, Tick("one"))
    send(boss, Tick("two"))
    send(auditor, Stop)
