// 10_actors.witchy — counter actor and a worker/boss pair.
actor Counter:
    console: Console
    var n: Int = 0

impl Counter:
    on Inc():
        n = n + 1
        print(console, "count = ${n}")
    on AddN(amount: Int):
        n = n + amount
        print(console, "count = ${n} (after +${amount})")

actor Worker:
    boss: Subject

impl Worker:
    on Task(label: String, x: Int):
        send(boss, Done(label, x * x))

actor Boss:
    console: Console

impl Boss:
    on Done(label: String, result: Int):
        print(console, "${label} -> ${result}")

fn main(console: Console):
    let counter = spawn Counter(console)
    send(counter, Inc)
    send(counter, AddN(10))
    send(counter, Inc)

    let boss = spawn Boss(console)
    let worker = spawn Worker(boss)
    send(worker, Task("square 5", 5))
    send(worker, Task("square 9", 9))
