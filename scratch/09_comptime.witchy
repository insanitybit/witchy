// Generate lucky_0 .. lucky_4 functions at compile time, then call them.
comptime:
    var i = 0
    while i < 5:
        emit("pub fn lucky_${i}() -> Int:")
        emit("    ${i * 7}")
        emit("")
        i = i + 1

fn main(console: Console):
    print(console, "${lucky_0()} ${lucky_1()} ${lucky_2()} ${lucky_3()} ${lucky_4()}")
