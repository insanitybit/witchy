// Probe: comptime: block that emits witchy source for many functions.
// Notes:
// - emit(...) writes a line of witchy source appended to the module.
// - comptime: blocks have no capability access by construction.
comptime:
    var i = 0
    while i < 4:
        emit("pub fn lucky_${i}() -> Int:")
        emit("    ${i * 7}")
        emit("")
        i = i + 1

fn main(console: Console):
    print(console, "${lucky_0()} ${lucky_1()} ${lucky_2()} ${lucky_3()}")
