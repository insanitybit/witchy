// wordapp — uses wordlib to summarize sample.txt.
//
// NOTE: `witchy run` in a project doesn't forward extra command-line arguments
// to the program (passing `witchy run sample.txt` invokes the program with an
// empty `args` list). So this app reads a hard-coded relative path inside the
// project — the host backs `Dir[Read]` with the project root.

import wordlib

fn main(console: Console, root: Dir[Read]) -> Int:
    let text = read(root, "sample.txt")
    let counts = wordlib.count(text)
    print(console, "top 5 words in sample.txt:")
    for wc in wordlib.top(counts, 5):
        print(console, "  ${wc.word}: ${wc.n}")
    0
