// wordlib — pure word-frequency utilities.
//
// Note: tuple `.0`/`.1` field access isn't a thing in witchy at the moment
// (the parser wants an identifier after `.`), so we either destructure
// or use a record. Records are clearer here anyway.

import string

type WordCount:
    word: String
    n: Int

pub fn tokens(text: String) -> List(String):
    var out = []
    for tok in string.split(text, " "):
        let t = string.trim(tok)
        if string.length(t) > 0:
            out = list.push(out, string.to_lower(t))
    out

pub fn count(text: String) -> Dict(String, Int):
    var d = dict.new()
    for tok in tokens(text):
        let cur = dict.get_or(d, tok, 0)
        d = dict.insert(d, tok, cur + 1)
    d

pub fn top(d: Dict(String, Int), n: Int) -> List(WordCount):
    var pairs = []
    for k in dict.keys(d):
        pairs = list.push(pairs, WordCount(k, dict.get_or(d, k, 0)))
    // sort_by takes a `less` predicate; we want descending so `a.n > b.n`.
    let sorted = list.sort_by(pairs, fn(a: WordCount, b: WordCount): a.n > b.n)
    list.take(sorted, n)
