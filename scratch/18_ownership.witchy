// inout, var, own/move, let-borrow.
fn bump(var n: Int):
    n = n + 1

fn add_twice(var n: Int, by: Int):
    n = n + by
    n = n + by

fn sum_borrowed(let xs: List(Int)) -> Int:
    var total = 0
    for x in xs:
        total = total + x
    total

fn into_label(own name: String) -> String:
    "[" + name + "]"

fn main(console: Console):
    var counter = 41
    bump(counter)
    print(console, "after bump: ${counter}")
    add_twice(counter, 10)
    print(console, "after add_twice(+10,+10): ${counter}")

    let xs = [1, 2, 3, 4, 5]
    print(console, "sum: ${sum_borrowed(xs)}")
    print(console, "len after borrow: ${list.length(xs)}")

    let name = "witchy"
    print(console, into_label(move name))

// touching `name` here would now be a compile error.
