// 11_tests.witchy — pure functions and their tests.

import testing

fn factorial(n: Int) -> Int:
    if n <= 1:
        1
    else:
        n * factorial(n - 1)

fn reverse(xs: List(Int)) -> List(Int):
    var out = []
    let n = list.length(xs)
    var i = n - 1
    while i >= 0:
        out = list.push(out, list.at(xs, i))
        i = i - 1
    out

fn test_factorial():
    testing.assert_int_eq(factorial(0), 1)
    testing.assert_int_eq(factorial(1), 1)
    testing.assert_int_eq(factorial(5), 120)
    testing.assert_int_eq(factorial(10), 3628800)

fn test_reverse():
    testing.assert(reverse([]) == [], "empty reverses to empty")
    testing.assert(reverse([1, 2, 3]) == [3, 2, 1], "1 2 3 -> 3 2 1")
    testing.assert(reverse([7]) == [7], "single stays")
