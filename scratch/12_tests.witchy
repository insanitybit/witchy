// Probe: in-language test framework.

import testing
import list

fn double(n: Int) -> Int:
    n * 2

fn classify(n: Int) -> String:
    if n > 0:
        "positive"
    else if n == 0:
        "zero"
    else:
        "negative"

fn sum(xs: List(Int)) -> Int:
    var t = 0
    for x in xs:
        t = t + x
    t

fn test_double():
    testing.assert_int_eq(double(21), 42)

fn test_classify():
    testing.assert_eq(classify(5), "positive")
    testing.assert_eq(classify(0), "zero")
    testing.assert(classify(0 - 3) == "negative", "negatives classify as negative")

fn test_sum_empty():
    testing.assert_int_eq(sum([]), 0)

fn test_sum_basic():
    testing.assert_int_eq(sum([1, 2, 3, 4]), 10)

fn test_string_eq():
    testing.assert_eq("hello", "hello")
