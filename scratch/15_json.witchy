// 15_json.witchy — decode JSON (the function is json.decode, the type Json,
// not parse/JsonValue as I first guessed from the appendix).

import json

fn describe(v: Json) -> String:
    match v:
        JsonNull -> "null"
        JsonBool(b) -> "bool ${b}"
        JsonInt(n) -> "int ${n}"
        JsonFloat(f) -> "float ${f}"
        JsonString(s) -> "string \"${s}\""
        JsonArray(xs) -> "array of ${list.length(xs)}"
        JsonObject(_) -> "object"

fn main(console: Console):
    let src = "{\"name\": \"ada\", \"age\": 36, \"likes\": [\"math\", \"machines\"]}"
    match json.decode(src):
        Ok(v) ->
            print(console, describe(v))
            match json.get_string(v, "name"):
                Some(n) -> print(console, "name = ${n}")
                None -> print(console, "no name")

            match json.get_int(v, "age"):
                Some(a) -> print(console, "age  = ${a}")
                None -> print(console, "no age")

            print(console, "likes = ${json.get_strings(v, "likes")}")
        Err(e) -> print(console, "decode error: ${e}")
