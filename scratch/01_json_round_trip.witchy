// 01_json_round_trip — encode some structured data and decode it back.

import json
import string

fn main(console: Console):
    let doc = JsonObject([("name", JsonString("witchy")), ("year", JsonInt(2026)), ("tags", JsonArray([JsonString("safe"), JsonString("capable")])), ("ready", JsonBool(true))])

    let text = json.encode(doc)
    print(console, "encoded: " <> text)

    match json.decode(text):
        Ok(d) ->
            match json.get(d, "name"):
                Some(j) ->
                    match json.as_string(j):
                        Some(n) -> print(console, "name = " <> n)
                        None -> print(console, "name not a string?!")
                None -> print(console, "no name field")
        Err(e) -> print(console, "decode failed: " <> e)
