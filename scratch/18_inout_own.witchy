// 18 — ownership conventions: inout / own + move / let-borrow.
fn bump(var n: Int):
    n = n + 1

fn into_label(own name: String) -> String:
    "[" <> name <> "]"

fn sum_view(let xs: List(Int), i: Int) -> Int:
    if i >= list.length(xs):
        0
    else:
        list.at(xs, i) + sum_view(xs, i + 1)

fn main(console: Console):
    var counter = 41
    bump(counter)
    bump(counter)
    print(console, "counter=${counter}")

    let name = "witchy"
    print(console, into_label(move name))

    // print(console, name) — compile error, moved
    let xs = [1, 2, 3, 4]
    print(console, "sum=${sum_view(xs, 0)} len=${list.length(xs)}")
