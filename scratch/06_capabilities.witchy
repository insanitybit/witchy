// Probe: Clock, Env, Dir reading, args, narrowing, retain/without firewalls.

import option

fn pure_compute(x: Int) -> Int:
    x * x + 1

fn log_value(console: Console, label: String, n: Int):
    print(console, "${label}: ${n}")

fn load_first_line(dir: Dir[Read], name: String) -> String:
    read(dir, name)

fn main(console: Console, dir: Dir, clock: Clock, env: Env, args: List(String)):
    // Pure functions: no capability arguments at all.
    log_value(console, "compute(6)", pure_compute(6))

    // Read the clock (Clock capability)
    let t = now(clock)
    if t > 0:
        print(console, "the clock is ticking")
    else:
        print(console, "epoch")

    // Read an env var
    match get_env(env, "GREETING"):
        Some(g) -> print(console, "GREETING=${g}")
        None -> print(console, "no GREETING set")

    // Narrowing dir to Dir[Read] via `as`, then to a subdir
    let ro = dir as Dir[Read]
    print(console, load_first_line(ro, "scratch/sample.txt"))

    // retain firewall: only console survives in this block
    retain console:
        print(console, "sealed block: only console")

    // without clock: clock not usable here
    without clock:
        print(console, "no-clock block")

    // arguments
    print(console, "args has ${list.length(args)} entries")
