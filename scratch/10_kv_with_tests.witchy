// 10_kv_with_tests — parse "k = v" pairs and use them as a tiny config
// store; test functions exercise it.

import string
import testing

pub fn parse_pairs(text: String) -> Dict(String, String):
    var d = dict.new()
    for line in string.lines(text):
        let t = string.trim(line)
        if !string.is_empty(t):
            if !string.starts_with(t, "#"):
                let (k, v) = string.split_once(t, "=")
                let key = string.trim(k)
                let val = string.trim(v)
                if !string.is_empty(key):
                    d = dict.insert(d, key, val)
    d

pub fn get_or_default(d: Dict(String, String), key: String, default: String) -> String:
    dict.get_or(d, key, default)

pub fn keys_sorted(d: Dict(String, String)) -> List(String):
    list.sort_by(dict.keys(d), fn(a: String, b: String): a < b)

fn test_basic():
    let d = parse_pairs("name = ada\nyear = 1815\n")
    testing.assert_int_eq(dict.size(d), 2)
    testing.assert_eq(get_or_default(d, "name", "?"), "ada")
    testing.assert_eq(get_or_default(d, "year", "?"), "1815")

fn test_comments_and_blank():
    let d = parse_pairs("# comment\n\nfoo = bar\n   \nx=y\n# another\n")
    testing.assert_int_eq(dict.size(d), 2)

fn test_missing():
    let d = parse_pairs("only = one\n")
    testing.assert_eq(get_or_default(d, "absent", "fallback"), "fallback")

fn test_overwrite():
    let d = parse_pairs("a=1\na=2\na=3\n")
    testing.assert_eq(get_or_default(d, "a", "?"), "3")

fn test_keys_sorted():
    let d = parse_pairs("c=3\na=1\nb=2\n")
    let ks = keys_sorted(d)
    testing.assert_eq(list.at(ks, 0), "a")
    testing.assert_eq(list.at(ks, 1), "b")
    testing.assert_eq(list.at(ks, 2), "c")

fn main(console: Console):
    let d = parse_pairs("greeting = hello\ntarget = world\n")
    print(console, "${get_or_default(d, "greeting", "?")}, ${get_or_default(d, "target", "?")}!")
