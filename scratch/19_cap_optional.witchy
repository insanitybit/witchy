// Optional / enum-wrapped capabilities.
type Access:
    ReadOnly(Dir[Read])
    Writable(Dir[Write])

fn record(out: Option(Dir[Write]), name: String, line: String) -> Bool:
    match out:
        Some(d) ->
            append(d, name, line)
            true
        None -> false

fn handle(a: Access, name: String) -> String:
    match a:
        ReadOnly(d) -> read(d, name)
        Writable(d) ->
            write(d, name, "touched\n")
            "wrote " + name

fn main(console: Console, dir: Dir, env: Env):
    let enabled = match get_env(env, "ALLOW_WRITE"):
        Some(_) -> Some(dir as Dir[Write])
        None -> None

    let wrote = record(enabled, "log.txt", "started\n")
    print(console, "did write? ${wrote}")

    print(console, handle(ReadOnly(dir as Dir[Read]), "log.txt"))
    print(console, handle(Writable(dir as Dir[Write]), "out.txt"))
    print(console, "wrote out.txt? ${exists(dir as Dir[Read], "out.txt")}")
