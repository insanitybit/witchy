// 05 — Option, Result, ? operator, if-let.
fn checked_div(a: Int, b: Int) -> Result(Int, String):
    if b == 0:
        Err("div by zero")
    else:
        Ok(a / b)

fn checked_chain(a: Int, b: Int, c: Int) -> Result(Int, String):
    let q1 = checked_div(a, b)?
    let q2 = checked_div(q1, c)?
    Ok(q2)

fn first_even(xs: List(Int)) -> Option(Int):
    for x in xs:
        if x % 2 == 0:
            return Some(x)
    None

fn show_result(r: Result(Int, String)) -> String:
    match r:
        Ok(v) -> "ok: ${v}"
        Err(e) -> "err: ${e}"

fn main(console: Console):
    print(console, show_result(checked_chain(100, 5, 2)))
    print(console, show_result(checked_chain(100, 0, 2)))
    print(console, show_result(checked_chain(100, 5, 0)))

    if let Some(v) = first_even([1, 3, 4, 7]):
        print(console, "first even: ${v}")
    else:
        print(console, "no even")

    if let Some(v) = first_even([1, 3, 5]):
        print(console, "first even: ${v}")
    else:
        print(console, "no even")
