// 15_comptime_register — comptime emits a registry of named handlers.
// The block iterates over a (name, body) table and emits both the handler
// function and a `dispatch(name) -> Int` that knows them all.

import string

comptime:
    let names = ["double", "halve", "negate", "square", "cube"]
    let bodies = ["x * 2", "x / 2", "0 - x", "x * x", "x * x * x"]

    var i = 0
    while i < list.length(names):
        emit("pub fn op_${list.at(names, i)}(x: Int) -> Int:")
        emit("    ${list.at(bodies, i)}")
        emit("")
        i = i + 1

    // dispatch: an exhaustive name-to-call mapping.
    emit("pub fn dispatch(name: String, x: Int) -> Int:")
    var j = 0
    while j < list.length(names):
        let prefix = if j == 0: "    if" else: "    else if"
        emit("${prefix} name == \"${list.at(names, j)}\":")
        emit("        op_${list.at(names, j)}(x)")
        j = j + 1
    emit("    else:")
    emit("        0")
    emit("")

fn main(console: Console):
    print(console, "double 10 = ${op_double(10)}")
    print(console, "square 9 = ${op_square(9)}")
    print(console, "cube   4 = ${op_cube(4)}")
    print(console, "dispatch:")
    for nm in ["double", "halve", "negate", "square", "cube", "unknown"]:
        print(console, "  ${nm}(7) = ${dispatch(nm, 7)}")
