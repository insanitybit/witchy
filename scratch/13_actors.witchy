// 13 — actors: Counter + Boss/Worker, capabilities only via state.
actor Counter:
    console: Console
    var n: Int = 0

impl Counter:
    on Inc():
        n = n + 1
        print(console, "n=${n}")
    on Add(by: Int):
        n = n + by
        print(console, "n=${n}")

actor Worker:
    boss: Subject

impl Worker:
    on Task(label: String, work: Int):
        send(boss, Done(label, work * work))

actor Boss:
    console: Console

impl Boss:
    on Done(label: String, result: Int):
        print(console, "${label} -> ${result}")

fn main(console: Console):
    let c = spawn Counter(console)
    send(c, Inc)
    send(c, Add(10))
    send(c, Inc)

    let boss = spawn Boss(console)
    let w = spawn Worker(boss)
    send(w, Task("sq 5", 5))
    send(w, Task("sq 9", 9))
