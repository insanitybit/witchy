// Probe: a richer pure program — parse a JSON inventory, tally by category,
// and print a summary with custom rendering via Show.

import json
import option
import result
import list
import dict
import string
import show

type Item:
    name: String
    category: String
    price: Int
    qty: Int

impl Show for Item:
    fn show(self) -> String:
        "${self.name} (${self.category}) ${self.qty}x@${self.price}"

impl Item:
    fn total(self) -> Int:
        self.price * self.qty

    fn from_json(j: Json) -> Option(Item):
        let name = json.get_string(j, "name")?
        let category = json.get_string(j, "category")?
        let price = json.get_int(j, "price")?
        let qty = json.get_int(j, "qty")?
        Some(Item(name, category, price, qty))

fn as_array_or_err(j: Json) -> Result(List(Json), String):
    match json.as_array(j):
        Some(a) -> Ok(a)
        None -> Err("expected JSON array at top level")

fn item_or_err(j: Json) -> Result(Item, String):
    match Item.from_json(j):
        Some(it) -> Ok(it)
        None -> Err("bad item: ${json.encode(j)}")

fn parse_inventory(s: String) -> Result(List(Item), String):
    let j = json.decode(s)?
    let arr = as_array_or_err(j)?
    var out = []
    for elem in arr:
        let it = item_or_err(elem)?
        out = list.push(out, it)
    Ok(out)

fn tally_by_category(items: List(Item)) -> Dict(String, Int):
    var totals = dict.new()
    for it in items:
        let prev = dict.get_or(totals, it.category, 0)
        totals = dict.insert(totals, it.category, prev + it.total())
    totals

fn main(console: Console):
    let raw = "[\n      {\"name\": \"widget\", \"category\": \"hardware\", \"price\": 5, \"qty\": 3},\n      {\"name\": \"sprocket\", \"category\": \"hardware\", \"price\": 12, \"qty\": 2},\n      {\"name\": \"gizmo\", \"category\": \"electronics\", \"price\": 100, \"qty\": 1}\n    ]"

    match parse_inventory(raw):
        Ok(items) ->
            for it in items:
                show.say(console, it)
            let totals = tally_by_category(items)
            print(console, "by category: ${totals}")
        Err(e) -> print(console, "error: ${e}")
