import dict
import option

fn main(console: Console):
    var d = dict_new()
    d = insert(d, "host", "localhost")
    d = insert(d, "port", "8080")
    // builtin get_or:
    print(console, "get_or host = " <> get_or(d, "host", "MISSING"))
    // stdlib dict.get (uses `==` on a type-variable key):
    match dict.get(d, "host"):
        Some(v) -> print(console, "dict.get host = " <> v)
        None -> print(console, "dict.get host = NONE")
