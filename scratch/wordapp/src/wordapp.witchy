// wordapp — CLI that runs wordlib over a file given as an argument.
//
// usage: wordapp <count|hist> <file>

import wordlib

fn print_hist(console: Console, d: Dict(String, Int)):
    var pairs = []
    for k in dict.keys(d):
        pairs = list.push(pairs, (k, dict.get_or(d, k, 0)))
    // Sort descending by count, then alphabetically.
    let sorted = list.sort_by(pairs, fn(a: (String, Int), b: (String, Int)): if a.1 == b.1: a.0 < b.0 else: a.1 > b.1)

    for p in sorted:
        print(console, "${p.0}\t${p.1}")

fn main(console: Console, dir: Dir[Read], args: List(String)) -> Int:
    if list.length(args) < 2:
        print(console, "usage: wordapp <count|hist> <file>")
        return 1
    let cmd = list.at(args, 0)
    let path = list.at(args, 1)
    let text = read(dir, path)
    match cmd:
        "count" ->
            print(console, "chars: ${wordlib.count_chars(text)}")
            print(console, "lines: ${wordlib.count_lines(text)}")
            print(console, "words: ${wordlib.count_words(text)}")
            0
        "hist" ->
            print_hist(console, wordlib.histogram(text))
            0
        _ ->
            print(console, "unknown command: ${cmd}")
            1
