// 09_big_gen — generate, filter, and aggregate ~5000 synthetic readings
// using gen fn + iter without materializing the whole intermediate list.

import iter
import string

// A deterministic-ish PRNG-like stream (LCG).
gen fn lcg(seed: Int, mod: Int) -> Iter(Int):
    var x = seed
    while true:
        x = (x * 1103515245 + 12345) % 2147483647
        yield x % mod

// "metric values" 0..99 from a deterministic stream.
fn values(seed: Int) -> Iter(Int):
    lcg(seed, 100)

fn main(console: Console):
    let stream = values(1)

    // Take a few hundred (interpreter has a step budget; 5000 would blow it).
    let lo_sum = iter.fold(iter.take(iter.filter(values(1), fn(v: Int): v < 50), 200), 0, fn(acc: Int, v: Int): acc + v)
    let hi_sum = iter.fold(iter.take(iter.filter(values(1), fn(v: Int): v >= 50), 200), 0, fn(acc: Int, v: Int): acc + v)

    let total = iter.sum(iter.take(values(1), 400))
    let count = iter.count(iter.take(values(1), 400))
    let avg = total / count

    print(console, "stream  count=${count}  total=${total}  avg=${avg}")
    print(console, "lo_sum (200 vals < 50): ${lo_sum}")
    print(console, "hi_sum (200 vals >=50): ${hi_sum}")

    // Find the first 5 values > 95.
    let big = iter.collect(iter.take(iter.filter(values(1), fn(v: Int): v > 95), 5))
    var parts = []
    for x in big:
        parts = list.push(parts, to_string(x))
    print(console, "first 5 values > 95: " <> string.join(parts, ", "))

    // Chain two streams: first 3 of one then first 3 of another.
    let chained = iter.collect(iter.chain(iter.take(values(1), 3), iter.take(values(99), 3)))
    var cparts = []
    for x in chained:
        cparts = list.push(cparts, to_string(x))
    print(console, "chained 3+3: " <> string.join(cparts, ", "))
