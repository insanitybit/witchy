// 16 — Optional and "branded" capabilities via a wrapping type.
//   Demonstrates: Option(Dir[Write]), a sum-type Access wrapper.
type Access:
    ReadOnly(Dir[Read])
    Writable(Dir[Write])

fn handle(a: Access, name: String) -> String:
    match a:
        ReadOnly(d) ->
            if exists(d, name):
                read(d, name)
            else:
                "(missing: ${name})"
        Writable(d) ->
            write(d, name, "touched\n")
            "wrote " <> name

fn maybe_log(out: Option(Dir[Write]), name: String, line: String) -> Bool:
    match out:
        Some(d) ->
            append(d, name, line)
            true
        None -> false

fn main(console: Console, dir: Dir):
    print(console, handle(ReadOnly(dir as Dir[Read]), "hello.txt"))
    print(console, handle(Writable(dir as Dir[Write]), "out.txt"))

    let wrote = maybe_log(Some(dir as Dir[Write]), "log.txt", "started\n")
    print(console, "logged? ${wrote}")
    let skip = maybe_log(None, "log.txt", "nope\n")
    print(console, "logged? ${skip}")
