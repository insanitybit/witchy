// 03 — lists, comprehensions, dicts, tuples, structural equality.
fn main(console: Console):
    let xs = [1, 2, 3, 4, 5]
    let squares = [n * n for n in xs]
    let evens = [n for n in xs if n % 2 == 0]
    print(console, "${xs}")
    print(console, "${squares}")
    print(console, "${evens}")

    let pair = (42, "answer")
    print(console, "${pair.0} = ${pair.1}")
    let (n, word) = pair
    print(console, "destructured: ${n} ${word}")

    var ages = dict.new()
    ages = dict.insert(ages, "ada", 36)
    ages = dict.insert(ages, "bob", 41)
    print(console, "${ages}")
    print(console, "ada=${dict.get_or(ages, "ada", 0)}")
    print(console, "missing=${dict.get_or(ages, "nobody", -1)}")

    // structural equality
    print(console, "${[1, 2, 3] == [1, 2, 3]}")
    print(console, "${(1, "a") == (1, "a")}")
