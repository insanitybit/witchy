import string

fn main(console: Console, dir: Dir[Read], args: List(String)) -> Int:
    if length(args) == 0:
        print(console, "usage: wc <file>")
        return 1
    let path = at(args, 0)
    if !exists(dir, path):
        print(console, "no such file: ${path}")
        return 1
    let contents = read(dir, path)
    let lines = length(string.lines(contents))
    let words = length(string.words(contents))
    let chars = char_count(contents)
    print(console, "${lines} lines, ${words} words, ${chars} chars in ${path}")
    0
