// 21_nested_derive — derived Show/Eq for nested records.

import string

type Point derive(Show, Eq):
    x: Int
    y: Int

type Line derive(Show, Eq):
    a: Point
    b: Point

type Path derive(Show, Eq):
    label: String
    segments: List(Line)

fn main(console: Console):
    let p1 = Point(0, 0)
    let p2 = Point(3, 4)
    let p3 = Point(7, 0)

    let path = Path("zigzag", [Line(p1, p2), Line(p2, p3), Line(p3, p1)])
    print(console, "${path}")
    print(console, "first seg eq same: ${Line(p1, p2) == list.at(path.segments, 0)}")
    print(console, "first seg eq diff: ${Line(p1, p3) == list.at(path.segments, 0)}")
