// Stress test for string building, interpolation, concatenation, and escapes.
fn pad_right(s: String, w: Int) -> String:
    let n = string.length(s)
    if n >= w:
        s
    else:
        var out = s
        var i = 0
        while i < w - n:
            out = out + " "
            i = i + 1
        out

fn render_row(label: String, value: Int) -> String:
    pad_right(label, 12) + " | " + "${value}"

fn join_csv(xs: List(Int)) -> String:
    string.join(["${n}" for n in xs], ",")

fn quote(s: String) -> String:
    "\"" + s + "\""

fn main(console: Console):
    let who = "world"
    print(console, "concat: " + "hello, " + who + "!")
    print(console, "interp: hello, ${who}!")

    // mix: concat of interpolation
    let n = 7
    let mixed = "n=" + "${n}" + ", n*2=" + "${n * 2}"
    print(console, mixed)

    // escapes
    print(console, "tab\there")
    print(console, "newline\\n is escaped backslash-n; \n was a real newline above? no")
    print(console, "${quote("escaped quote in string")}")
    // literal dollar without interpolation: just write it without `${`
    // (a `\$` escape is in the appendix, but `witchy fmt` rejects it as of
    // 2026-06-12 — see LEARNING-LOG.md.)
    print(console, "literal dollar: $not_interpolated")

    // table
    print(console, render_row("alpha", 1))
    print(console, render_row("beta", 22))
    print(console, render_row("gamma", 333))

    // join through interpolation
    print(console, "csv: " + join_csv([1, 2, 3, 4, 5]))

    // splice via interpolation only (no `+`)
    let a = "AAA"
    let b = "BBB"
    print(console, "${a}${b}-${a}")

    // empty string round-trip
    let empty = ""
    print(console, "empty len: ${string.length(empty)}")
    print(console, "concat with empty: ${empty + "x" + empty}")
