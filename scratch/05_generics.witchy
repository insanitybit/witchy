// 05_generics.witchy — generic functions, trait bounds, derive(Show,Eq,Ord),
// `impl Show` for a custom type, and the `say` Show-print.

import ord
import show

type Temp:
    celsius: Int

impl Show for Temp:
    fn show(self) -> String:
        "${self.celsius}°C"

type Score derive(Show, Eq, Ord):
    points: Int
    label: String

fn largest(xs: List(a)) -> a where a: Ord:
    var best = list.at(xs, 0)
    for x in xs:
        if greater(x, best):
            best = x
    best

fn announce(console: Console, label: String, x: impl Show):
    print(console, "${label}: ${show(x)}")

fn main(console: Console):
    print(console, "largest int = ${largest([3, 9, 2, 7])}")
    print(console, "largest str = ${largest(["fig", "apple", "pear"])}")

    let a = Score(10, "alpha")
    let b = Score(12, "beta")
    let c = Score(10, "alpha")
    print(console, "a == c     : ${a == c}")
    print(console, "max(a,b)   : ${ord.max_of(a, b)}")

    announce(console, "now", Temp(21))
    announce(console, "count", 42)
    show.say(console, Temp(5))
