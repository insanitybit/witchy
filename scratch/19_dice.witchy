// 19_dice.witchy — seeded random, pure.

import random

fn rolls(seed: Int, n: Int) -> List(Int):
    var r = random.seed(seed)
    var out = []
    var i = 0
    while i < n:
        let (v, r2) = random.next_below(r, 6)
        out = list.push(out, v + 1)
        r = r2
        i = i + 1
    out

fn main(console: Console):
    print(console, "rolls(42, 10) = ${rolls(42, 10)}")
    print(console, "rolls(7,  10) = ${rolls(7,  10)}")
