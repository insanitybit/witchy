// 13_http_client.witchy — connect-only Net, no listen capability.

import http

// NOTE: docs (capabilities-narrowing.md / appendix-recipes.md) say a Net[Connect, Tcp]
// is enough to dial out, but std/http.get's signature requires a full `Net`, so
// calling http.get from a narrowed Net errors at type-check time. Using full Net here.
fn fetch(net: Net, host: String, port: Int, path: String) -> String:
    let resp = http.get(net, host, port, path)
    "status " <> to_string(http.status(resp))

fn main(console: Console, net: Net):
    print(console, fetch(net, "example.com", 80, "/"))
