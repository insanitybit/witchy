// 13_worker_pool — 5 actors:
//   Dispatcher distributes Work to one of three Workers (round-robin).
//   Each Worker computes and sends Done back to a Collector.
//   The Collector counts and sums, reporting to Reporter on Drain.
//   Reporter prints final results.

import string

actor Reporter:
    console: Console

impl Reporter:
    on Report(total_jobs: Int, total_sum: Int):
        print(console, "[reporter] jobs=${total_jobs} sum=${total_sum}")

actor Collector:
    reporter: Subject
    var total_jobs: Int = 0
    var total_sum: Int = 0
    var drains: Int = 0

impl Collector:
    on Done(worker_id: Int, x: Int, result: Int):
        total_jobs = total_jobs + 1
        total_sum = total_sum + result
    on Drain():
        drains = drains + 1
        if drains == 3:
            send(reporter, Report(total_jobs, total_sum))
            total_jobs = 0
            total_sum = 0
            drains = 0

actor Worker:
    collector: Subject

impl Worker:
    on Work(my_id: Int, x: Int):
        // expensive! (just x*x)
        send(collector, Done(my_id, x, x * x))
    on Drain():
        send(collector, Drain)

actor Dispatcher:
    console: Console
    w0: Subject
    w1: Subject
    w2: Subject
    collector: Subject
    var next: Int = 0

impl Dispatcher:
    on Dispatch(x: Int):
        let target = next
        next = (next + 1) % 3
        if target == 0:
            send(w0, Work(0, x))
        else if target == 1:
            send(w1, Work(1, x))
        else:
            send(w2, Work(2, x))
    on FlushWith(label: String):
        print(console, "[dispatcher] draining for ${label}")
        // Per-actor mailboxes are FIFO, so route Drain through each worker;
        // Collector counts 3 Drains and emits the final report once.
        send(w0, Drain)
        send(w1, Drain)
        send(w2, Drain)

fn main(console: Console):
    let reporter = spawn Reporter(console)
    let collector = spawn Collector(reporter)
    let w0 = spawn Worker(collector)
    let w1 = spawn Worker(collector)
    let w2 = spawn Worker(collector)
    let disp = spawn Dispatcher(console, w0, w1, w2, collector)

    // Send 12 jobs.
    var i = 1
    while i <= 12:
        send(disp, Dispatch(i))
        i = i + 1
    send(disp, FlushWith("batch1"))

// expected jobs=12, sum=1+4+9+16+25+36+49+64+81+100+121+144 = 650
