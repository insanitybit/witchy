// 08_caps_layers — capability plumbing through 4 layers.
// Top: main holds (Console, Dir).
//   layer1 narrows the Dir to Dir[Read].
//   layer2 takes Dir[Read] and a Console.
//   layer3 takes ONLY Dir[Read] (no Console — provably can't print).
//   layer4 sees a subdir narrowed further.
// We verify with `witchy caps`.

import string

fn main(console: Console, root: Dir):
    print(console, "== main ==")
    layer1(console, root)

    // retain block: no caps in scope at all.
    let computed = retain:
        var sum = 0
        var i = 0
        while i < 10:
            sum = sum + i
            i = i + 1
        sum
    print(console, "pure block returned ${computed}")

    // without block: drop console for this region.
    without console:
        let names = ["one", "two", "three"]
        let _kept = list.filter(names, fn(n: String): string.length(n) == 3)
    print(console, "(without-block did pure filtering)")

fn layer1(console: Console, root: Dir):
    print(console, "layer1: narrowing Dir to Dir[Read]")
    let ro = root as Dir[Read]
    layer2(console, ro)

fn layer2(console: Console, ro: Dir[Read]):
    print(console, "layer2: walking into a subdir")
    let sub = subdir(ro, "examples") as Dir[Read]
    layer3(sub)
    // Now console is back; layer3 saw none.
    print(console, "layer2: back from layer3 (which had no Console)")

fn layer3(ro: Dir[Read]):
    // No Console here.  Cannot print.  Hand off to layer4 with a deeper narrow.
    let inner = subdir(ro, "data") as Dir[Read]
    layer4(inner)

fn layer4(ro: Dir[Read]):
    // Read a file from the doubly-narrowed Dir.
    let _payload = read(ro, "greeting.txt")

// No console, no return — pure side-effect-free read (the value is discarded).
