// 07_comptime.witchy — generate a family of constants at compile time.
comptime:
    var i = 0
    while i < 5:
        emit("pub fn double_${i}() -> Int:")
        emit("    ${i * 2}")
        emit("")
        i = i + 1

fn main(console: Console):
    print(console, "${double_0()} ${double_1()} ${double_2()} ${double_3()} ${double_4()}")
