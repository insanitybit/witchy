// 20_actor_caps.witchy — an actor that holds a Dir[Write] capability and writes audit lines.

actor Auditor:
    log: Dir[Write]
    var n: Int = 0

impl Auditor:
    on Record(line: String):
        n = n + 1
        append(log, "audit.txt", "${n}: ${line}\n")

fn main(console: Console, dir: Dir):
    let auditor = spawn Auditor(subdir(dir, "audit") as Dir[Write])
    send(auditor, Record("started"))
    send(auditor, Record("step 2"))
    send(auditor, Record("done"))
    print(console, "audit sent")
