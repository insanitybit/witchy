import string

type ConfigError:
    NoEquals(Int)
    MissingKey(String)

fn describe(e: ConfigError) -> String:
    match e:
        NoEquals(lineno) -> "line " <> int_to_string(lineno) <> ": missing '='"
        MissingKey(key) -> "missing required key: " <> key

fn parse_pairs(text: String) -> Result(Dict(String, String), ConfigError):
    var d = dict_new()
    var i = 1
    for line in string.lines(text):
        let trimmed = string.trim(line)
        if string_length(trimmed) > 0:
            if !contains(trimmed, "="):
                return Err(NoEquals(i))
            let (k, v) = string.split_once(trimmed, "=")
            d = insert(d, string.trim(k), string.trim(v))
        i = i + 1
    Ok(d)

// NOTE: use the builtin `get_or` (content-correct on both backends), NOT the
// stdlib `dict.get`, which compares type-variable keys with `==` and so does
// pointer comparison on the compiled backend (F15) — runtime-built keys then
// fail to match. We use "" as the absent sentinel (config values are non-empty).
fn require(d: Dict(String, String), key: String) -> Result(String, ConfigError):
    let v = get_or(d, key, "")
    if string_length(v) == 0:
        Err(MissingKey(key))
    else:
        Ok(v)

// Uses `?` three times: parse, then two required lookups.
fn load(text: String) -> Result(String, ConfigError):
    let d = parse_pairs(text)?
    let host = require(d, "host")?
    let port = require(d, "port")?
    Ok(host <> ":" <> port)

fn main(console: Console):
    let good = "host = localhost\nport = 8080\n"
    let bad = "host = localhost\nport 8080\n"
    let missing = "host = localhost\n"
    for text in [good, bad, missing]:
        match load(text):
            Ok(addr) -> print(console, "ok: " <> addr)
            Err(e) -> print(console, "error: " <> describe(e))
