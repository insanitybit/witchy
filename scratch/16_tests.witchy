import testing

fn double(n: Int) -> Int:
    n * 2

fn classify(n: Int) -> String:
    if n > 0:
        "positive"
    else if n == 0:
        "zero"
    else:
        "negative"

fn factorial(n: Int) -> Int:
    if n <= 1:
        1
    else:
        n * factorial(n - 1)

fn test_double():
    testing.assert_int_eq(double(21), 42)
    testing.assert_int_eq(double(0), 0)
    testing.assert_int_eq(double(0 - 5), 0 - 10)

fn test_classify():
    testing.assert_eq(classify(5), "positive")
    testing.assert_eq(classify(0), "zero")
    testing.assert(classify(0 - 3) == "negative", "negatives classify as negative")

fn test_factorial():
    testing.assert_int_eq(factorial(0), 1)
    testing.assert_int_eq(factorial(1), 1)
    testing.assert_int_eq(factorial(5), 120)
    testing.assert_int_eq(factorial(6), 720)
