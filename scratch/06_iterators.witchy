// 06_iterators.witchy — lazy iter and a gen fn (Fibonacci) + Collatz.

import iter

gen fn fibs() -> Iter(Int):
    var a = 0
    var b = 1
    while true:
        yield a
        let nxt = a + b
        a = b
        b = nxt

gen fn collatz(start: Int) -> Iter(Int):
    var n = start
    yield n
    while n > 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1
        yield n

fn main(console: Console):
    let first10 = iter.collect(iter.take(fibs(), 10))
    print(console, "fibs(10) = ${first10}")

    let evens = iter.filter(iter.range(1, 20), fn(n: Int): n % 2 == 0)
    let doubled = iter.map(evens, fn(n: Int): n * 2)
    print(console, "evens*2  = ${iter.collect(iter.take(doubled, 5))}")

    print(console, "collatz(27) length = ${iter.count(collatz(27))}")
    print(console, "collatz(6)         = ${iter.collect(collatz(6))}")
