// 08 — derive(Json) and json encode/decode.

import json

type Point derive(Show, Eq, Json):
    x: Int
    y: Int

type Polyline derive(Show, Json):
    name: String
    points: List(Point)

fn main(console: Console):
    let line = Polyline("zigzag", [Point(0, 0), Point(1, 2), Point(3, 1)])
    let encoded = json.encode(line.to_json())
    print(console, encoded)

    // round-trip via decode
    let parsed = json.decode(encoded)
    match parsed:
        Ok(j) -> print(console, "decoded: ${j}")
        Err(e) -> print(console, "decode err: ${e}")
