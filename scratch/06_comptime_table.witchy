// 06_comptime_table — generate a static lookup table at compile time.
// The comptime block emits 20 pure functions: square_N for N in 0..20,
// plus an aggregated `all_squares()` that returns a List(Int).

import string

comptime:
    var i = 0
    while i < 20:
        emit("pub fn square_${i}() -> Int:")
        emit("    ${i * i}")
        emit("")
        i = i + 1

    // Build an aggregator that returns the whole table.
    emit("pub fn all_squares() -> List(Int):")
    var j = 0
    var parts = "    ["
    while j < 20:
        if j > 0:
            parts = parts <> ", "
        parts = parts <> to_string(j * j)
        j = j + 1
    parts = parts <> "]"
    emit(parts)
    emit("")

fn main(console: Console):
    // Use specific generated functions:
    print(console, "square_7  = ${square_7()}")
    print(console, "square_19 = ${square_19()}")

    // Use the generated aggregator:
    let table = all_squares()
    print(console, "count = ${list.length(table)}")
    print(console, "sum = ${list.fold(table, 0, fn(a: Int, b: Int): a + b)}")
    print(console, "last = ${list.at(table, 19)}")
