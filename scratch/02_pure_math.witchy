// Pure helpers — no capabilities anywhere.
fn double(n: Int) -> Int:
    n * 2

fn classify(n: Int) -> String:
    if n > 0:
        "positive"
    else if n == 0:
        "zero"
    else:
        "negative"

fn factorial(n: Int) -> Int:
    if n <= 1:
        1
    else:
        n * factorial(n - 1)

fn fib(n: Int) -> Int:
    var a = 0
    var b = 1
    var i = 0
    while i < n:
        let nxt = a + b
        a = b
        b = nxt
        i = i + 1
    a

fn main(console: Console):
    print(console, classify(double(0)))
    print(console, "${double(21)}")
    print(console, "${factorial(6)}")
    print(console, "fib(10) = ${fib(10)}")
