// 12_optional_caps.witchy — `Option(Dir[Write])` and a capability enum.
type Access:
    ReadOnly(Dir[Read])
    Writable(Dir[Write])

fn record(out: Option(Dir[Write]), name: String, line: String) -> Bool:
    match out:
        Some(d) ->
            append(d, name, line)
            true
        None -> false

fn use_access(a: Access, name: String) -> String:
    match a:
        ReadOnly(d) -> "read: " <> read(d, name)
        Writable(d) ->
            write(d, name, "touched\n")
            "wrote " <> name

fn main(console: Console, dir: Dir, env: Env):
    let enabled = match get_env(env, "DRY_RUN"):
        Some(_) -> None
        None -> Some(dir as Dir[Write])

    let wrote = record(enabled, "log.txt", "started\n")
    print(console, "wrote? ${wrote}")
    print(console, use_access(Writable(dir as Dir[Write]), "out.txt"))
    print(console, use_access(ReadOnly(dir as Dir[Read]), "log.txt"))
