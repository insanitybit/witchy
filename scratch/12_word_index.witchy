// 12_word_index — build an inverted index from documents to words and
// answer simple queries (intersect, union, contains) over the index.

import string
import set

type Doc derive(Show, Eq):
    id: String
    body: String

fn index_one(d: Doc, idx: Dict(String, List(String))) -> Dict(String, List(String)):
    var out = idx
    for w in string.words(string.to_lower(d.body)):
        let prior = dict.get_or(out, w, [])
        if !list.contains(prior, d.id):
            out = dict.insert(out, w, list.push(prior, d.id))
    out

fn build_index(docs: List(Doc)) -> Dict(String, List(String)):
    var idx = dict.new()
    for d in docs:
        idx = index_one(d, idx)
    idx

fn docs_with(idx: Dict(String, List(String)), word: String) -> List(String):
    dict.get_or(idx, string.to_lower(word), [])

fn intersect(a: List(String), b: List(String)) -> List(String):
    list.filter(a, fn(x: String): list.contains(b, x))

fn main(console: Console):
    let docs = [Doc("d1", "the quick brown fox jumps over the lazy dog"), Doc("d2", "a quick brown dog jumps over a sleeping cat"), Doc("d3", "the lazy cat watches the brown fox"), Doc("d4", "no dogs cats or foxes here")]

    let idx = build_index(docs)

    let brown = docs_with(idx, "brown")
    let fox = docs_with(idx, "fox")
    let dog = docs_with(idx, "dog")

    print(console, "brown: " <> string.join(brown, ", "))
    print(console, "fox:   " <> string.join(fox, ", "))
    print(console, "dog:   " <> string.join(dog, ", "))
    print(console, "brown AND fox: " <> string.join(intersect(brown, fox), ", "))

    // Comprehension: lengths of every word in d1.
    let lens = [string.length(w) for w in string.words(list.at(docs, 0).body)]
    print(console, "d1 word lens: ${lens}")

    // unique terms across the index.
    let all_terms = list.sort_by(dict.keys(idx), fn(a: String, b: String): a < b)
    print(console, "vocab size: ${list.length(all_terms)}")
    print(console, "first 5: " <> string.join(list.take(all_terms, 5), ", "))
