// 03_actor_pipeline — four actors in a pipeline:
//   Producer -> Filter -> Aggregator -> Reporter
// Producer holds Console (to chatter) and the Filter's Subject.
// Filter only forwards even values to the Aggregator.
// Aggregator sums; on Flush it sends the running total to the Reporter.
// Reporter prints.  Capability flow is one-way: each step has only the
// authority needed to take its next step.
actor Reporter:
    console: Console

impl Reporter:
    on Total(label: String, value: Int):
        print(console, "[reporter] ${label} => ${value}")

actor Aggregator:
    reporter: Subject
    var sum: Int = 0
    var count: Int = 0

impl Aggregator:
    on Sample(value: Int):
        sum = sum + value
        count = count + 1
    on Flush(label: String):
        send(reporter, Total(label <> "/sum", sum))
        send(reporter, Total(label <> "/count", count))
        sum = 0
        count = 0

actor Filter:
    next: Subject

impl Filter:
    on FlushTag(label: String):
        send(next, Flush(label))
    on Maybe(value: Int):
        if value % 2 == 0:
            send(next, Sample(value))

actor Producer:
    console: Console
    downstream: Subject

impl Producer:
    on Burst(label: String, start: Int, count: Int):
        print(console, "[producer] burst ${label} start=${start} count=${count}")
        var i = 0
        while i < count:
            send(downstream, Maybe(start + i))
            i = i + 1
        send(downstream, FlushTag(label))

// we cannot forward a Flush directly because Filter only knows Maybe;
// for this demo we route Flush through main instead (see below).
fn main(console: Console):
    let reporter = spawn Reporter(console)
    let agg = spawn Aggregator(reporter)
    let filt = spawn Filter(agg)
    let prod = spawn Producer(console, filt)

    send(prod, Burst("first", 1, 10))
    send(prod, Burst("second", 20, 5))
