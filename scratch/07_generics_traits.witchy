// 07 — generics, traits, where bounds, derive(Show/Eq/Ord), impl Show, say.

import ord
import show

type Temp:
    celsius: Int

impl Show for Temp:
    fn show(self) -> String:
        "${self.celsius} deg C"

type Score derive(Show, Eq, Ord):
    points: Int
    label: String

fn largest(xs: List(a)) -> a where a: Ord:
    var best = list.at(xs, 0)
    for x in xs:
        if greater(x, best):
            best = x
    best

fn announce(console: Console, label: String, x: impl Show):
    print(console, "${label}: ${show(x)}")

fn main(console: Console):
    print(console, "${largest([3, 9, 2, 7])}")
    print(console, "${largest(["apple", "pear", "fig"])}")

    announce(console, "temp", Temp(21))
    announce(console, "count", 42)
    show.say(console, Temp(5))

    let a = Score(10, "alpha")
    let b = Score(12, "beta")
    print(console, "${a == Score(10, "alpha")}")
    print(console, "${ord.max_of(a, b)}")
