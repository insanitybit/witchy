// wordlib — pure word/character helpers, no capabilities.
pub fn count_words(text: String) -> Int:
    var n = 0
    var in_word = false
    var i = 0
    let len = string.length(text)
    while i < len:
        let c = string.char_at(text, i)
        let space = c == " " || c == "\t" || c == "\n"
        if space:
            in_word = false
        else if !in_word:
            n = n + 1
            in_word = true
        i = i + 1
    n

pub fn count_chars(text: String) -> Int:
    string.length(text)

pub fn count_lines(text: String) -> Int:
    if string.length(text) == 0:
        0
    else:
        list.length(string.lines(text))

pub fn histogram(text: String) -> Dict(String, Int):
    var d = dict.new()
    for line in string.lines(text):
        for word in string.split(line, " "):
            if string.length(word) > 0:
                let cur = dict.get_or(d, word, 0)
                d = dict.insert(d, word, cur + 1)
    d
