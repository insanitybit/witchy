import string

fn count_words(text: String) -> Dict(String, Int):
    var counts = dict_new()
    for word in string.words(text):
        let w = to_lower(word)
        counts = insert(counts, w, get_or(counts, w, 0) + 1)
    counts

fn main(console: Console):
    let text = "the quick brown fox\nthe lazy dog\nThe QUICK fox"
    let counts = count_words(text)
    print(console, "distinct words: ${size(counts)}")
    for entry in pairs(counts):
        let (word, n) = entry
        print(console, "${word}: ${n}")
