// 16_generic_linked — a generic linked list with custom traits.
// Defines `Counter` and `Drawable` traits, an `LL` generic recursive type,
// generic algos that require both bounds together.

import string
import ord

type LL:
    LNil
    LCons(a, LL(a))

trait Counter:
    fn weight(self) -> Int

trait Drawable:
    fn render(self) -> String

type Card:
    Card(String, Int)

type Coin:
    Coin(Int)

impl Counter for Card:
    fn weight(self) -> Int:
        match self:
            Card(_n, w) -> w

impl Drawable for Card:
    fn render(self) -> String:
        match self:
            Card(n, w) -> "[" <> n <> "/" <> to_string(w) <> "]"

impl Counter for Coin:
    fn weight(self) -> Int:
        match self:
            Coin(d) -> d

impl Drawable for Coin:
    fn render(self) -> String:
        match self:
            Coin(d) -> "(${d}c)"

fn len(l: LL(a)) -> Int:
    match l:
        LNil -> 0
        LCons(_x, rest) -> 1 + len(rest)

fn weights_list(xs: List(a)) -> Int where a: Counter:
    var total = 0
    for x in xs:
        total = total + weight(x)
    total

// Trait dispatch in `where a: Trait` resolves on DIRECT params only — not on
// match-pattern variables.  So we iterate by collecting into a List and using
// a for-loop variable (also direct).  This is the witchy idiom.
fn to_list(l: LL(a)) -> List(a):
    match l:
        LNil -> []
        LCons(x, rest) -> list.push(to_list(rest), x)

fn describe_list(xs: List(a)) -> String where a: Counter, a: Drawable:
    var out = ""
    var first = true
    // for-loop variable IS a direct binding of `a`, so trait dispatch works.
    for x in xs:
        let piece = render(x) <> "[w=" <> to_string(weight(x)) <> "]"
        if first:
            out = piece
            first = false
        else:
            out = out <> " -> " <> piece
    if string.is_empty(out):
        "(empty)"
    else:
        out

// (`describe` would have been a tidy wrapper, but witchy's trait dispatch
// resolves only on direct params; a generic wrapper calling another generic
// can't transfer the bound through. Call describe_list with a concrete-typed
// list from main instead. This is documented behavior.)
fn main(console: Console):
    let cards = LCons(Card("ace", 14), LCons(Card("king", 13), LCons(Card("queen", 12), LNil)))
    let coins = LCons(Coin(25), LCons(Coin(10), LCons(Coin(5), LCons(Coin(1), LNil))))

    let cards_l = to_list(cards)
    let coins_l = to_list(coins)

    print(console, "cards: ${describe_list(cards_l)}")
    print(console, "  len=${len(cards)}  total weight=${weights_list(cards_l)}")
    print(console, "coins: ${describe_list(coins_l)}")
    print(console, "  len=${len(coins)}  total weight=${weights_list(coins_l)}")
