// Probe: records, sum types, match, list patterns, spread, guards.

import list

type Account:
    name: String
    balance: Int

fn deposit(a: Account, amount: Int) -> Account:
    Account(balance: a.balance + amount, ..a)

type Shape:
    Circle(Int)
    Rectangle(Int, Int)
    Empty

fn area(s: Shape) -> Int:
    match s:
        Circle(r) -> 3 * r * r
        Rectangle(w, h) -> w * h
        Empty -> 0

fn head(xs: List(Int)) -> String:
    match xs:
        [] -> "empty"
        [only] -> "one: ${only}"
        [first, ..rest] -> "first ${first} then ${list.length(rest)}"

fn sign(n: Int) -> String:
    match n:
        0 -> "zero"
        m if m > 0 -> "positive"
        _ -> "negative"

fn main(console: Console):
    let a = Account("ada", 100)
    let richer = deposit(a, 50)
    print(console, "${richer.balance} (was ${a.balance})")
    print(console, "${area(Circle(2))} ${area(Rectangle(3, 4))} ${area(Empty)}")
    print(console, head([]))
    print(console, head([7]))
    print(console, head([1, 2, 3]))
    print(console, "${sign(0)} ${sign(4)} ${sign(0 - 1)}")
