// 10 — comptime: generate a family of functions at compile time.
comptime:
    var i = 0
    while i < 5:
        emit("pub fn n_${i}() -> Int:")
        emit("    ${i * 10}")
        emit("")
        i = i + 1

fn main(console: Console):
    print(console, "${n_0()} ${n_1()} ${n_2()} ${n_3()} ${n_4()}")
