// 09_narrowing.witchy — narrow a full Dir into a Dir[Write] subdir; load via Dir[Read].
fn load(dir: Dir[Read], name: String) -> String:
    read(dir, name)

fn save(dir: Dir[Write], name: String, body: String):
    write(dir, name, body)

fn main(console: Console, root: Dir):
    // Narrow at call sites: implicit on `load`, explicit `as` for the subdir/Write.
    save(subdir(root, "out") as Dir[Write], "msg.txt", "hello from witchy\n")
    print(console, "wrote out/msg.txt")
    print(console, "contents: " <> load(root, "out/msg.txt"))
