// 02_traits_bounds — my own trait `Priced` plus a custom `Summable` trait,
// generic algorithms with bounds, and derive(Show, Eq, Ord) on a record.

import string
import ord

trait Priced:
    fn unit_price(self) -> Int
    fn label(self) -> String

type Book derive(Show, Eq):
    title: String
    cents: Int

type Coffee derive(Show, Eq):
    style: String
    cents: Int

impl Priced for Book:
    fn unit_price(self) -> Int:
        self.cents

    fn label(self) -> String:
        "book:" <> self.title

impl Priced for Coffee:
    fn unit_price(self) -> Int:
        self.cents

    fn label(self) -> String:
        "coffee:" <> self.style

// A generic invoice line — works for any Priced thing.
fn invoice_line(item: i, qty: Int) -> String where i: Priced:
    let subtotal = unit_price(item) * qty
    label(item) <> " x " <> to_string(qty) <> " = " <> to_string(subtotal) <> "c"

// Generic total via fold; works on any Priced list.
fn total_cents(items: List(i)) -> Int where i: Priced:
    var sum = 0
    for item in items:
        sum = sum + unit_price(item)
    sum

// Bounded generic: largest by Ord.
fn biggest(xs: List(a)) -> a where a: Ord:
    var best = list.at(xs, 0)
    for x in xs:
        if greater(x, best):
            best = x
    best

fn main(console: Console):
    let books = [Book("Tolkien", 1500), Book("Pratchett", 1200), Book("LeGuin", 1800)]
    let coffees = [Coffee("latte", 450), Coffee("mocha", 525), Coffee("espresso", 300)]

    for b in books:
        print(console, invoice_line(b, 2))
    for c in coffees:
        print(console, invoice_line(c, 1))

    print(console, "books total: ${total_cents(books)}c")
    print(console, "coffees total: ${total_cents(coffees)}c")

    // derive(Show, Eq):
    print(console, "show: ${list.at(books, 0)}")
    print(console, "eq:   ${Book("LeGuin", 1800) == list.at(books, 2)}")

    // Ord on Int via stdlib.
    let nums = [3, 9, 1, 7, 4]
    print(console, "biggest int: " <> to_string(biggest(nums)))
    let names = ["pear", "apple", "fig", "quince"]
    print(console, "biggest str: " <> biggest(names))
