// Capability narrowing: `as`, subdir, retain/without.
fn load(dir: Dir[Read], name: String) -> String:
    read(dir, name)

fn count_lines(dir: Dir[Read], name: String) -> Int:
    list.length(string.lines(read(dir, name)))

fn main(console: Console, dir: Dir):
    // Implicit narrowing at the call boundary.
    print(console, "lines: ${count_lines(dir, "app.log")}")

    // Explicit narrowing.
    let ro = dir as Dir[Read]
    print(console, "first 12 chars: ${string.substring(load(ro, "app.log"), 0, 12)}")

    // retain: only console survives, dir is dropped within the block.
    retain console:
        let pure = 21 * 2
        print(console, "pure inside retain: ${pure}")

    // without: drop a name, prove it's pure thereafter.
    without dir:
        print(console, "no dir here")

    // Re-binding a dropped name shadows the firewall (legal — fresh value).
    // We can't *name* the dropped console here, so nothing useful inside;
    // demonstrate the firewall by simply doing pure work.
    without console:
        let n = 1 + 1
        let m = n * 2
        // a print(console, ...) here would be a compile error.
        m
