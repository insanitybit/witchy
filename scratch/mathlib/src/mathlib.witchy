// mathlib — pure math helpers, no capabilities.

pub fn square(n: Int) -> Int:
    n * n

pub fn sum(xs: List(Int)) -> Int:
    var total = 0
    for x in xs:
        total = total + x
    total

pub fn mean(xs: List(Int)) -> Option(Int):
    if list.length(xs) == 0:
        None
    else:
        Some(sum(xs) / list.length(xs))
