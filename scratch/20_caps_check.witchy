// 20_caps_check — a tiny "lint" that loads a witchy source file from a
// read-only Dir, computes its capability footprint via compiler.footprint,
// and exits 0 / 1 depending on whether the demanded capabilities include
// a forbidden capability (here: "Net").

import compiler
import json
import string

fn main(console: Console, root: Dir[Read], args: List(String)) -> Int:
    if list.length(args) < 1:
        print(console, "usage: caps_check <file> [forbidden-cap]")
        2
    else:
        let path = list.at(args, 0)
        let forbidden = if list.length(args) >= 2: list.at(args, 1) else: "Net"
        let source = read(root, path)
        let report = compiler.footprint(source)
        check_report(console, path, report, forbidden)

fn check_report(console: Console, path: String, report: String, forbidden: String) -> Int:
    match json.decode(report):
        Ok(doc) ->
            let caps = caps_in(doc)
            print(console, "${path} demands: " <> string.join(caps, ", "))
            if list.contains(caps, forbidden):
                print(console, "FAIL: forbidden capability '${forbidden}' is required")
                1
            else:
                print(console, "OK: '${forbidden}' is not required")
                0
        Err(e) ->
            print(console, "parse error: ${e}")
            3

fn caps_in(doc: Json) -> List(String):
    var out = []
    match json.get(doc, "total"):
        Some(j) ->
            match json.as_array(j):
                Some(items) ->
                    for it in items:
                        match json.as_string(it):
                            Some(s) -> out = list.push(out, s)
                            None -> out = out
                None -> out = out
        None -> out = out
    out
