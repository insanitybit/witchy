// formatting — render reports.  Pure: no caps.

import core
import string

pub fn header(title: String) -> String:
    let line = string.repeat("=", string.length(title))
    title <> "\n" <> line

pub fn bucket_row(b: Bucket) -> String:
    string.pad_right(b.host, 12, " ") <> string.pad_right(b.metric, 8, " ") <> string.pad_left(to_string(b.count), 6, " ") <> string.pad_left(to_string(b.sum), 8, " ") <> string.pad_left(to_string(b.min), 6, " ") <> string.pad_left(to_string(b.max), 6, " ") <> string.pad_left(to_string(bucket_avg(b)), 6, " ")

pub fn table_header() -> String:
    string.pad_right("host", 12, " ") <> string.pad_right("metric", 8, " ") <> string.pad_left("count", 6, " ") <> string.pad_left("sum", 8, " ") <> string.pad_left("min", 6, " ") <> string.pad_left("max", 6, " ") <> string.pad_left("avg", 6, " ")

pub fn render_table(rows: List(Bucket)) -> String:
    var lines = [table_header()]
    for b in rows:
        lines = list.push(lines, bucket_row(b))
    string.join(lines, "\n")
