// app — ties core + parsing + analytics + formatting into a runnable
// pipeline.  Reads metrics.csv from a read-only Dir, writes report.txt
// via a separately-narrowed write Dir, and prints a summary on Console.

import core
import parsing
import analytics
import formatting
import string

fn main(console: Console, root: Dir):
    let input = root as Dir[Read]
    let output = root as Dir[Write]

    let text = read(input, "metrics.csv")
    let readings = parsing.parse_all(text)

    print(console, "parsed ${list.length(readings)} readings")

    let agg = analytics.aggregate(readings)
    let hosts = analytics.unique_hosts(agg)
    print(console, "hosts: " <> string.join(hosts, ", "))

    let top = analytics.top_by_sum(agg, 5)
    let report = formatting.header("Top 5 buckets by sum") <> "\n" <> formatting.render_table(top) <> "\n\ncpu total: ${analytics.metric_total(agg, "cpu")}" <> "\nmem total: ${analytics.metric_total(agg, "mem")}\n"

    write(output, "report.txt", report)
    print(console, "wrote report.txt")
