// parsing — read CSV-ish "ts,host,metric,value" lines into Readings.

import core
import string
import option

// Skip blank lines and lines starting with '#'.  Lines that fail to parse
// (wrong field count, non-integer ts/value) are dropped silently.
pub fn parse_all(text: String) -> List(Reading):
    var out = []
    for line in string.lines(text):
        match parse_line(string.trim(line)):
            Some(r) -> out = list.push(out, r)
            None -> out = out
    out

pub fn parse_line(line: String) -> Option(Reading):
    if string.is_empty(line):
        None
    else if string.starts_with(line, "#"):
        None
    else:
        let parts = string.split(line, ",")
        if list.length(parts) != 4:
            None
        else:
            match string.parse_int(string.trim(list.at(parts, 0))):
                Some(ts) ->
                    match string.parse_int(string.trim(list.at(parts, 3))):
                        Some(v) -> Some(Reading(ts, string.trim(list.at(parts, 1)), string.trim(list.at(parts, 2)), v))
                        None -> None
                None -> None
