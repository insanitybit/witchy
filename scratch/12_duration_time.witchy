// 12 — Duration literals; std/time format & parse.

import time
import duration

fn main(console: Console):
    let t = 30s
    let big = 2h
    print(console, "${t < big}")
    // duration interpolation renders the raw ms integer, not "1m30s" —
    // reach for duration.human for a friendly label.
    print(console, duration.human(t + 1m))
    print(console, duration.clock(big + 5m + 7s))

    // wall-clock parsing & formatting are pure (no Clock needed for that)
    match time.parse_iso8601("2026-06-12T15:30:00Z"):
        Ok(when) -> print(console, "parsed: ${time.iso8601(when)}")
        Err(e) -> print(console, "parse err: ${e}")

    // strftime-style format
    match time.parse_iso8601("2026-06-12T15:30:00Z"):
        Ok(when) -> print(console, time.format(when, "%Y/%m/%d %H:%M"))
        Err(e) -> print(console, "err: ${e}")
