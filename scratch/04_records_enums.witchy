// 04 — records, enums, sum types, match with inline statement arms, spread.
type Account:
    name: String
    balance: Int

fn deposit(a: Account, amount: Int) -> Account:
    Account(balance: a.balance + amount, ..a)

type Shape:
    Circle(Int)
    Rectangle(Int, Int)
    Square(Int)

fn area(s: Shape) -> Int:
    match s:
        Circle(r) -> 3 * r * r
        Rectangle(w, h) -> w * h
        Square(s) -> s * s

type Event:
    Click(Int, Int)
    Key(String)
    Close

fn describe(e: Event) -> String:
    match e:
        Click(x, y) -> "click at ${x}," <> to_string(y)
        Key(k) -> "key " <> k
        Close -> "close"

fn classify(n: Int) -> String:
    match n:
        0 -> "zero"
        m if m > 0 -> "positive"
        _ -> "negative"

fn main(console: Console):
    let a = Account("ada", 100)
    let r = deposit(a, 50)
    print(console, "ada: ${a.balance} -> ${r.balance}")

    print(console, "${area(Circle(2))}")
    print(console, "${area(Rectangle(3, 4))}")
    print(console, "${area(Square(5))}")

    print(console, describe(Click(3, 9)))
    print(console, describe(Key("Enter")))
    print(console, describe(Close))

    print(console, classify(0))
    print(console, classify(7))
    print(console, classify(0 - 5))

    // inline statement arm: update a var
    var total = 0
    for x in [Some(1), None, Some(3), Some(4), None]:
        match x:
            Some(v) -> total = total + v
            None -> total = total + 0
    print(console, "total: ${total}")
