// Net narrowing in signatures. Doesn't actually connect, so parity stays clean.

import http

fn maybe_get(net: Net[Connect, Tcp], host: String, port: Int, path: String) -> Int:
    // We deliberately don't call http.get here to keep parity hermetic;
    // the point of this program is that `caps` reports Net[Connect, Tcp].
    string.length(host) + port + string.length(path)

fn main(console: Console, net: Net[Connect, Tcp]):
    let n = maybe_get(net, "example.test", 80, "/")
    print(console, "shape ok: ${n}")
