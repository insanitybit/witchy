// 20 — word frequency: pure core + Dir[Read] shell. Sorted descending.

import ord

type Pair derive(Show):
    word: String
    count: Int

fn word_counts(text: String) -> List(Pair):
    var counts = dict.new()
    for line in string.lines(text):
        for w in string.split(line, " "):
            let trimmed = string.trim(w)
            if string.length(trimmed) > 0:
                let key = string.to_lower(trimmed)
                let prev = dict.get_or(counts, key, 0)
                counts = dict.insert(counts, key, prev + 1)
    var out = []
    for k in dict.keys(counts):
        out = list.push(out, Pair(k, dict.get_or(counts, k, 0)))
    // sort by count descending, then word ascending
    list.sort_by(out, fn(a: Pair, b: Pair): if a.count != b.count: a.count > b.count else: a.word < b.word)

fn main(console: Console, dir: Dir[Read], args: List(String)) -> Int:
    let path = if list.length(args) > 0: list.at(args, 0) else: "input.txt"
    if !exists(dir, path):
        print(console, "no such file: ${path}")
        return 1
    let counts = word_counts(read(dir, path))
    for p in counts:
        print(console, "${p.count}\t${p.word}")
    0
