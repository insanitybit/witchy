// Closure-call benchmark: invoke a first-class function (an `Rc<dyn Fn>` on the
// compiled backend) several million times in a tight loop. Measures closure-call
// overhead (heap pointer + indirect call), the same shape Go's func values have.

fn main(console: Console, clock: Clock):
    let bench_t0 = clock.now_monotonic()
    let f = fn(x: Int): x % 7
    var total = 0
    var i = 0
    while i < 5000000:
        total = total + f(i)
        i = i + 1
    let bench_t1 = clock.now_monotonic()
    console.print("${total}")
    console.print("bench_ns=${bench_t1 - bench_t0}")
