// nsieve (benchmarksgame): count primes below N with the Sieve of Eratosthenes.
// Exercises in-place `list.set_at` on a large flag array — O(n log log n) only
// because `xs = list.set_at(xs, j, false)` mutates the owned buffer in place;
// without that fast path the per-set rebuild is O(n^2) and OOMs.

import list

fn nsieve(n: Int) -> Int:
    var flags = []
    for i in list.range(n):
        flags = list.push(flags, true)
    var count = 0
    var i = 2
    while i < n:
        if list.at(flags, i):
            count = count + 1
            var j = i + i
            while j < n:
                flags = list.set_at(flags, j, false)
                j = j + i
        i = i + 1
    count

fn main(console: Console):
    var total = 0
    total = total + nsieve(800000)
    total = total + nsieve(400000)
    total = total + nsieve(200000)
    print(console, "${total}")
