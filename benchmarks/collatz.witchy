fn steps(start: Int) -> Int:
    var n = start
    var c = 0
    while n > 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1
        c = c + 1
    c

fn main(console: Console):
    var total = 0
    var i = 1
    while i < 1000000:
        total = total + steps(i)
        i = i + 1
    print(console, int_to_string(total))
