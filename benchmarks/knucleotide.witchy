mode opt

import dict
import string
import list
import bytes

fn main(let console: Console, let clock: Clock):
    let bench_t0 = clock.now_monotonic()
    let n = 200000
    let k = 10
    var cs = []
    var seed = 42
    var i = 0
    while i < n:
        seed = (seed * 1103515245 + 12345) % 2147483648
        let b = seed / 65536 % 4
        let ch = if b == 0: 65 else: if b == 1: 67 else: if b == 2: 71 else: 84
        list.push(cs, ch)
        i = i + 1
    let raw = match bytes.from_list(cs):
        Ok(b) -> b
        Err(_e) -> bytes.from_string("")
    var counts = dict.with_capacity(1000)
    var j = 0
    while j + k <= n:
        let kmer = bytes.slice(raw, j, j + k)
        dict.update(counts, kmer, 0, fn(c: Int): c + 1)
        j = j + 1
    let bench_t1 = clock.now_monotonic()
    console.print("${dict.length(counts)}")
    console.print("bench_ns=${bench_t1 - bench_t0}")
