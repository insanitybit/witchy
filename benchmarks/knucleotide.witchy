mode opt

import dict
import string
import list

fn main(let console: Console, let clock: Clock):
    let bench_t0 = clock.now_monotonic()
    let n = 200000
    let k = 10
    var cs = []
    var seed = 42
    var i = 0
    while i < n:
        seed = (seed * 1103515245 + 12345) % 2147483648
        let b = seed / 65536 % 4
        let ch = if b == 0: "A" else: if b == 1: "C" else: if b == 2: "G" else: "T"
        list.push(cs, ch)
        i = i + 1
    var counts = dict.new()
    var j = 0
    while j + k <= n:
        var kmer = ""
        var m = 0
        while m < k:
            kmer = kmer + list.at(cs, j + m)
            m = m + 1
        dict.update(counts, kmer, 0, fn(c: Int): c + 1)
        j = j + 1
    let bench_t1 = clock.now_monotonic()
    console.print("${dict.length(counts)}")
    console.print("bench_ns=${bench_t1 - bench_t0}")
