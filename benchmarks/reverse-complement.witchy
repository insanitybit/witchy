mode opt

import list
import bytes
import string

fn main(let console: Console, let clock: Clock):
    let alu_str = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"
    
    let alu_bytes = bytes.from_string(alu_str)
    let alu_list = alu_bytes.to_list()

    let total = 3000000
    var seq = list.repeat(0, total)
    let alu_len = list.length(alu_list)
    var idx = 0
    while idx < total:
        list.set_at(seq, idx, list.at(alu_list, idx % alu_len))
        idx = idx + 1

    var comp = list.repeat(0, 256)
    var c_idx = 0
    while c_idx < 256:
        list.set_at(comp, c_idx, c_idx)
        c_idx = c_idx + 1
        
    list.set_at(comp, 65, 84)
    list.set_at(comp, 97, 84)
    list.set_at(comp, 67, 71)
    list.set_at(comp, 99, 71)
    list.set_at(comp, 71, 67)
    list.set_at(comp, 103, 67)
    list.set_at(comp, 84, 65)
    list.set_at(comp, 116, 65)

    let bench_t0 = clock.now_monotonic()

    var iter = 0
    while iter < 15:
        var i = 0
        var j = total - 1
        while i <= j:
            let ci = list.at(seq, i)
            let cj = list.at(seq, j)
            list.set_at(seq, i, list.at(comp, cj))
            list.set_at(seq, j, list.at(comp, ci))
            i = i + 1
            j = j - 1
        iter = iter + 1

    let bench_t1 = clock.now_monotonic()

    console.print(">ONE Homo sapiens alu")
    var k = 0
    while k < total:
        var end_idx = k + 60
        if end_idx > total:
            end_idx = total
        
        var chunk = []
        var chunk_idx = k
        while chunk_idx < end_idx:
            list.push(chunk, list.at(seq, chunk_idx))
            chunk_idx = chunk_idx + 1
            
        let s = match bytes.from_list(chunk):
            Ok(b) -> bytes.to_string(b)
            Err(_e) -> ""
        console.print("${s}")
        k = k + 60

    console.print("bench_ns=${bench_t1 - bench_t0}")
