mode opt

import bytes

fn build_table() -> Bytes:
    var tbl = bytes.repeat(0, 256)
    var i = 0
    while i < 256:
        tbl.set_at(i, i)
        i = i + 1
    tbl.set_at(65, 84)
    tbl.set_at(67, 71)
    tbl.set_at(71, 67)
    tbl.set_at(84, 65)
    tbl.set_at(97, 84)
    tbl.set_at(99, 71)
    tbl.set_at(103, 67)
    tbl.set_at(116, 65)
    return tbl

fn main(let console: Console, let clock: Clock):
    let alu_str = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"
    
    let alu_bytes = bytes.from_string(alu_str)
    let alu_len = alu_bytes.length()

    let total = 3000000
    var seq = bytes.repeat(0, total)
    var idx = 0
    while idx < total:
        seq.set_at(idx, alu_bytes.at(idx % alu_len))
        idx = idx + 1

    let tbl = build_table()
    let bench_t0 = clock.now_monotonic()

    var iter = 0
    while iter < 15:
        var i = 0
        var j = total - 1
        while i <= j:
            let ci = seq.at(i)
            let cj = seq.at(j)
            seq.set_at(i, tbl.at(cj))
            seq.set_at(j, tbl.at(ci))
            i = i + 1
            j = j - 1
        iter = iter + 1

    let bench_t1 = clock.now_monotonic()

    console.print(">ONE Homo sapiens alu")
    var k = 0
    while k < total:
        var end_idx = k + 60
        if end_idx > total:
            end_idx = total
        
        console.print("${seq.slice(k, end_idx).to_string()}")
        k = k + 60

    console.print("bench_ns=${bench_t1 - bench_t0}")
