mode opt

import list
import bytes
import string

fn slice_to_string(let seq: List(Int), let start: Int, let end_idx: Int) -> String:
    var chunk = []
    var i = start
    while i < end_idx:
        list.push(chunk, list.at(seq, i))
        i = i + 1
    match bytes.from_list(chunk):
        Ok(b) -> bytes.to_string(b)
        Err(_e) -> ""

fn get_comp(c: Int) -> Int:
    if c == 65 || c == 97:
        84
    else if c == 67 || c == 99:
        71
    else if c == 71 || c == 103:
        67
    else if c == 84 || c == 116:
        65
    else:
        c

fn main(let console: Console, let clock: Clock):
    let alu_str = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"
    
    let alu_bytes = bytes.from_string(alu_str)
    let alu_list = alu_bytes.to_list()

    let total = 3000000
    var seq = []
    let alu_len = list.length(alu_list)
    var idx = 0
    while idx < total:
        list.push(seq, list.at(alu_list, idx % alu_len))
        idx = idx + 1

    let bench_t0 = clock.now_monotonic()

    var iter = 0
    while iter < 15:
        var i = 0
        var j = total - 1
        while i <= j:
            let ci = list.at(seq, i)
            let cj = list.at(seq, j)
            list.set_at(seq, i, get_comp(cj))
            list.set_at(seq, j, get_comp(ci))
            i = i + 1
            j = j - 1
        iter = iter + 1

    let bench_t1 = clock.now_monotonic()

    console.print(">ONE Homo sapiens alu")
    var k = 0
    while k < total:
        var end_idx = k + 60
        if end_idx > total:
            end_idx = total
        
        console.print("${slice_to_string(seq, k, end_idx)}")
        k = k + 60

    console.print("bench_ns=${bench_t1 - bench_t0}")
