// Text-processing benchmark: format a word, count its occurrences in a
// string-keyed dict, then sum the counts. Stresses string formatting and
// string hashing — the bread-and-butter of Go log/text processors.
//
// `update(d, w, 0, fn(n): n + 1)` is the single-lookup upsert — one hash, like
// Go's `m[w]++`. The native backend fuses it to `d.entry(w).or_insert(0)` and
// inlines the `+ 1` updater (no per-iteration closure allocation).

fn main(console: Console):
    var d = dict_new()
    var i = 0
    while i < 1000000:
        let w = f"word{i % 1000}"
        d = update(d, w, 0, fn(n: Int): n + 1)
        i = i + 1
    var total = 0
    for v in values(d):
        total = total + v
    print(console, int_to_string(total + size(d)))
