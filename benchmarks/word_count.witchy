mode opt

fn main(let console: Console, let clock: Clock):
    let bench_t0 = clock.now_monotonic()
    var d = dict.new()
    var i = 0
    while i < 1000000:
        let w = "word${i % 1000}"
        dict.update(d, w, 0, fn(n: Int): n + 1)
        i = i + 1
    var total = 0
    for v in dict.values(d):
        total = total + v
    let bench_t1 = clock.now_monotonic()
    console.print("${total + dict.length(d)}")
    console.print("bench_ns=${bench_t1 - bench_t0}")
