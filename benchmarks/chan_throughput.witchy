// Channel throughput: a spawned producer sends N ints over a bounded channel and
// the consumer FOLDS them into a running sum — timing the async executor's
// send/recv + cooperative scheduling vs Go goroutines+channels. Both ends know N,
// and the consumer reports the sum (0+1+…+N-1), so the fold is checked.
//
// (RFC-0059 Stage-1) The async lowering is now a defunctionalized state machine:
// each `await` is one segment function, so there is no `and_then` continuation
// TOWER rebuilt per poll, and the loops carry their state in parameters (a `while`
// counter, a folded `var sum`) instead of the old `for_each`/`consume` closures.
// The old drain form (a `for i in 0..n` producer + a draining `for await`) grew
// superlinearly and OOM-trapped past ~10k messages; this form is FLAT at a few
// hundred ns/message and un-capped (measured well past 100k). It is NOT yet flat
// to N = 1,000,000 — the general boxed-frame path still leaks a bounded amount per
// message until the scalar-SoA + ring-channel follow-on (RFC-0059 step 2, which
// needs recursive `$rdrop`, RFC-0036).
//
// N = 64,000 is 4x past the old ~16k OOM cliff (proving the un-cap), and its sum
// 2,047,968,000 stays under 2^32 on purpose: a message / channel value above 2^32
// is truncated to 32 bits on the compiled backend (a PRE-EXISTING executor-slot
// defect, independent of this lowering — see bugs/), so a larger fold would fail
// the parity gate for a reason this RFC does not own.
from chan import Receiver, Sender

async fn producer(tx: Sender(Int), n: Int) -> Nil:
    var i = 0
    while i < n:
        chan.send(tx, i).await
        i = i + 1

async fn main(console: Console):
    let (tx, rx) = chan.channel(64).await
    chan.spawn(producer(tx, 64000)).await
    var sum = 0
    for await v in rx:
        sum = sum + v
    print(console, "${sum}")
