// Channel throughput: a spawned producer sends N ints over a bounded channel and
// the consumer drains them — timing the async executor's send/recv + cooperative
// scheduling vs Go goroutines+channels. Both ends know N, so both print it after
// the full exchange (witchy's for-await body captures by value, so it can't fold
// the stream into a sum yet — this drains instead).
//
// N is capped at 8000. The executor now OWNS its scheduling state (RFC-0036
// Design B): `slots`/`channels` are confined-unique local accumulators mutated in
// place, so the per-message ARRAY churn that was O(n^2) is bounded. What still
// grows is the per-message CLOSURE garbage — the `and_then` continuation towers
// each `await` rebuilds — which shell-only drop cannot reclaim, so live memory
// still climbs ~linearly and traps (OOB) past ~10k. Uncapping N to the high-
// throughput regime needs recursive `$rdrop` (RFC-0036, to free those closure
// children) and then the state-machine lowering that stops rebuilding them
// (RFC-0059). As-is this is a small but real send/recv throughput probe.
import chan

async fn producer(tx: Sender(Int), n: Int) -> Nil:
    for i in 0..n:
        chan.send(tx, i).await

async fn main(console: Console):
    let (tx, rx) = chan.channel(64).await
    chan.spawn(producer(tx, 8000)).await
    for await v in rx:
        chan.done(v)
    print(console, "8000")
