mode opt

type Expr:
    Num(Int)
    Add(Expr, Expr)
    Mul(Expr, Expr)

fn eval(let e: Expr) -> Int:
    match e:
        Num(n) -> n
        Add(a, b) -> eval(a) + eval(b)
        Mul(a, b) -> eval(a) * eval(b)

// A balanced tree of `Add(Mul(t, 2), t)`, so eval(build(d)) == 3^d.
fn build(let depth: Int) -> Expr:
    if depth <= 0:
        Num(1)
    else:
        Add(Mul(build(depth - 1), Num(2)), build(depth - 1))

fn main(let console: Console, let clock: Clock):
    let bench_t0 = clock.now_monotonic()
    var total = 0
    var i = 0
    while i < 10:
        total = total + eval(build(16))
        i = i + 1
    let bench_t1 = clock.now_monotonic()
    console.print("${total}")
    console.print("bench_ns=${bench_t1 - bench_t0}")
