mode opt

fn main(let console: Console, let clock: Clock):
    let bench_t0 = clock.now_monotonic()
    var xs = []
    var k = 0
    while k < 5000:
        list.push(xs, k)
        k = k + 1
    var total = 0
    var rep = 0
    while rep < 2000:
        for i in 0..list.length(xs):
            total = total + xs[i]
        rep = rep + 1
    let bench_t1 = clock.now_monotonic()
    console.print("${total}")
    console.print("bench_ns=${bench_t1 - bench_t0}")
