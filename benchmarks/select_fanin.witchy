mode opt

from chan import Sender

async fn produce(let tx: Sender(Int), let start: Int, let count: Int):
    var i = 0
    while i < count:
        chan.send(tx, start + i * 2).await
        i = i + 1

fn expected_checksum(let per_source: Int) -> Int:
    var checksum = 0
    var i = 0
    while i < per_source:
        checksum = (checksum * 257 + i * 2 + 1) % 1000000007
        i = i + 1
    i = 0
    while i < per_source:
        checksum = (checksum * 257 + i * 2 + 3) % 1000000007
        i = i + 1
    checksum

async fn main(let console: Console, let clock: Clock):
    let (a_tx, a_rx) = chan.channel(2048).await
    let (b_tx, b_rx) = chan.channel(2048).await
    let a_handle = chan.spawn(produce(a_tx, 0, 2048)).await
    let b_handle = chan.spawn(produce(b_tx, 1, 2048)).await
    chan.join(a_handle).await
    chan.join(b_handle).await

    var seen_a = 0
    var seen_b = 0
    var checksum = 0
    var order_ok = true
    let bench_t0 = clock.now_monotonic()
    while seen_a + seen_b < 4096:
        let selected = chan.select(a_rx, b_rx).await
        let (add_a, add_b, next_checksum, selected_ok) = match selected:
            First(value) ->
                (1, 0, (checksum * 257 + value + 1) % 1000000007, seen_b == 0 && value == seen_a * 2)
            Second(value) ->
                (0, 1, (checksum * 257 + value + 2) % 1000000007, seen_a == 2048 && value == seen_b * 2 + 1)
            Closed -> (1, 0, checksum, false)

        seen_a = seen_a + add_a
        seen_b = seen_b + add_b
        checksum = next_checksum
        order_ok = order_ok && selected_ok
    let bench_t1 = clock.now_monotonic()

    let expected = expected_checksum(2048)
    if order_ok && seen_a == 2048 && seen_b == 2048 && checksum == expected:
        console.print("count=${seen_a + seen_b} checksum=${checksum} order=ok")
    else:
        console.print("count=${seen_a + seen_b} checksum=${checksum} expected=${expected} order=bad")
    console.print("bench_ns=${bench_t1 - bench_t0}")
