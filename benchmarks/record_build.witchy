mode opt

type Stack:
    items: List(Int)
    total: Int

fn build(let n: Int) -> Stack:
    var s = Stack([], 0)
    var i = 0
    while i < n:
        list.push(s.items, i)
        s.total += i
        i = i + 1
    s

fn main(let console: Console, let clock: Clock):
    let bench_t0 = clock.now_monotonic()
    let s = build(500000)
    let bench_t1 = clock.now_monotonic()
    console.print("${s.total + list.length(s.items)}")
    console.print("bench_ns=${bench_t1 - bench_t0}")
