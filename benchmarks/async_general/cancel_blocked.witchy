from chan import Sender
import task

async fn blocked(tx: Sender(String), start: Int) -> Int:
    var i = start
    while i < start + 64:
        chan.send(tx, "payload ${i}").await
        i = i + 1
    9

async fn main(console: Console, clock: Clock):
    let bench_t0 = clock.now_monotonic()
    var i = 0
    var valid = true
    while i < __MESSAGES__:
        let (tx, rx) = chan.channel(1).await
        chan.send(tx, "seed").await
        match chan.race(blocked(tx, i), task.done(-1)).await:
            Some(value) ->
                if value != -1:
                    valid = false
            None -> valid = false
        match chan.recv(rx).await:
            Some(text) ->
                if text != "seed":
                    valid = false
            None -> valid = false
        i = i + 1
    let bench_t1 = clock.now_monotonic()
    let checksum = if valid: i else: -1
    console.print("${checksum}")
    console.print("bench_ns=${bench_t1 - bench_t0}")
