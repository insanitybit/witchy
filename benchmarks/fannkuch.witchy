mode opt

import list

fn fannkuch(let n: Int) -> Int:
    var perm1 = []
    for i in list.range(n):
        list.push(perm1, i)
    var count = []
    for i in list.range(n):
        list.push(count, 0)
    // `perm` is allocated ONCE and refilled in place each permutation (like Go's
    // `copy(perm, perm1)`); allocating a fresh copy per permutation would leak
    // 10! transient arrays into the never-freeing bump allocator and OOM.
    var perm = []
    for i in list.range(n):
        list.push(perm, 0)
    var max_flips = 0
    var checksum = 0
    var perm_count = 0
    var r = n
    while true:
        while r != 1:
            list.set_at(count, r - 1, r)
            r = r - 1
        if list.at(perm1, 0) != 0:
            var j = 0
            while j < list.length(perm):
                list.set_at(perm, j, list.at(perm1, j))
                j = j + 1
            var flips = 0
            var k = list.at(perm, 0)
            while k != 0:
                var lo = 0
                var hi = k
                while lo < hi:
                    let a = list.at(perm, lo)
                    let b = list.at(perm, hi)
                    list.set_at(perm, lo, b)
                    list.set_at(perm, hi, a)
                    lo = lo + 1
                    hi = hi - 1
                flips = flips + 1
                k = list.at(perm, 0)
            if flips > max_flips:
                max_flips = flips
            if perm_count % 2 == 0:
                checksum = checksum + flips
            else:
                checksum = checksum - flips
        var advanced = false
        while !advanced:
            if r == n:
                return checksum * 1000 + max_flips
            let perm0 = list.at(perm1, 0)
            var i = 0
            while i < r:
                list.set_at(perm1, i, list.at(perm1, i + 1))
                i = i + 1
            list.set_at(perm1, r, perm0)
            list.set_at(count, r, list.at(count, r) - 1)
            if list.at(count, r) > 0:
                advanced = true
            else:
                r = r + 1
        perm_count = perm_count + 1
    0

fn main(let console: Console, let clock: Clock):
    let bench_t0 = clock.now_monotonic()
    let r = fannkuch(10)
    let bench_t1 = clock.now_monotonic()
    console.print("${r}")
    console.print("bench_ns=${bench_t1 - bench_t0}")
