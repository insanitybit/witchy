mode opt

import bytes
import math

fn min(a: Int, b: Int) -> Int:
    if a < b:
        return a
    return b

fn fasta_repeat(let console: Console, n_total: Int, let seq_bytes: Bytes):
    let seq_len = bytes.length(seq_bytes)
    var n = n_total
    var seqi = 0
    while n > 0:
        let len_out = min(n, 60)
        if seqi + len_out < seq_len:
            console.print(bytes.to_string(bytes.slice(seq_bytes, seqi, seqi + len_out)))
            seqi = seqi + len_out
        else:
            let s1 = bytes.slice(seq_bytes, seqi, seq_len)
            let s2 = bytes.slice(seq_bytes, 0, len_out - (seq_len - seqi))
            seqi = len_out - (seq_len - seqi)
            console.print(bytes.to_string(bytes.concat(s1, s2)))
        n = n - len_out

fn main(let console: Console, let clock: Clock):
    let bench_t0 = clock.now_monotonic()
    
    let n = 2500000
    
    let alu_seq = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"
    let alu_bytes = bytes.from_string(alu_seq)
        
    console.print(">ONE Homo sapiens alu")
    fasta_repeat(console, 2 * n, alu_bytes)
    
    console.print(">TWO IUB ambiguity codes")
    var n2 = 3 * n
    var seed = 42
    
    let ca = 97
    let cc = 99
    let cg = 103
    let ct = 116
    let cB = 66
    let cD = 68
    let cH = 72
    let cK = 75
    let cM = 77
    let cN = 78
    let cR = 82
    let cS = 83
    let cV = 86
    let cW = 87
    let cY = 89
    
    var line_buf = bytes.repeat(0, 60)
    while n2 > 0:
        let len_out = min(n2, 60)
        var i = 0
        while i < len_out:
            seed = (seed * 3877 + 29573) % 139968
            let r = math.to_float(seed) / 139968.0
            
            let ch = if r < 0.27: ca else: if r < 0.39: cc else: if r < 0.51: cg else: if r < 0.78: ct else: if r < 0.80: cB else: if r < 0.82: cD else: if r < 0.84: cH else: if r < 0.86: cK else: if r < 0.88: cM else: if r < 0.90: cN else: if r < 0.92: cR else: if r < 0.94: cS else: if r < 0.96: cV else: if r < 0.98: cW else: cY
            bytes.set_at(line_buf, i, ch)
            i = i + 1
            
        if len_out == 60:
            console.print(bytes.to_string(line_buf))
        else:
            console.print(bytes.to_string(bytes.slice(line_buf, 0, len_out)))
        n2 = n2 - len_out
        
    console.print(">THREE Homo sapiens frequency")
    var n3 = 5 * n
    var line_buf3 = bytes.repeat(0, 60)
    while n3 > 0:
        let len_out = min(n3, 60)
        var i = 0
        while i < len_out:
            seed = (seed * 3877 + 29573) % 139968
            let r = math.to_float(seed) / 139968.0
            
            let ch = if r < 0.3029549426680: ca else: if r < 0.5009432431601: cc else: if r < 0.6984905497992: cg else: ct
            bytes.set_at(line_buf3, i, ch)
            i = i + 1
            
        if len_out == 60:
            console.print(bytes.to_string(line_buf3))
        else:
            console.print(bytes.to_string(bytes.slice(line_buf3, 0, len_out)))
        n3 = n3 - len_out

    let bench_t1 = clock.now_monotonic()
    console.print("bench_ns=${bench_t1 - bench_t0}")
