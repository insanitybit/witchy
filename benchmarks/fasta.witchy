mode opt

import list
import bytes
import string
import math

fn min(a: Int, b: Int) -> Int:
    if a < b:
        return a
    return b

fn fasta_repeat(let console: Console, n_total: Int, let seq_str: String):
    let s_ref = string.as_str(&seq_str)
    let seq_len = string.length(seq_str)
    var n = n_total
    var seqi = 0
    while n > 0:
        let len_out = min(n, 60)
        if seqi + len_out < seq_len:
            console.print(string.slice(s_ref, seqi, seqi + len_out).to_string())
            seqi = seqi + len_out
        else:
            let s1 = string.slice(s_ref, seqi, seq_len).to_string()
            let s2 = string.slice(s_ref, 0, len_out - (seq_len - seqi)).to_string()
            seqi = len_out - (seq_len - seqi)
            console.print(s1 + s2)
        n = n - len_out

fn main(let console: Console, let clock: Clock):
    let bench_t0 = clock.now_monotonic()
    
    let n = 2500000
    
    let alu_seq = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"
        
    console.print(">ONE Homo sapiens alu")
    fasta_repeat(console, 2 * n, alu_seq)
    
    console.print(">TWO IUB ambiguity codes")
    var n2 = 3 * n
    var seed = 42
    
    let ca = "a"
    let cc = "c"
    let cg = "g"
    let ct = "t"
    let cB = "B"
    let cD = "D"
    let cH = "H"
    let cK = "K"
    let cM = "M"
    let cN = "N"
    let cR = "R"
    let cS = "S"
    let cV = "V"
    let cW = "W"
    let cY = "Y"
    
    while n2 > 0:
        let len_out = min(n2, 60)
        var line_seq = ""
        var i = 0
        while i < len_out:
            seed = (seed * 3877 + 29573) % 139968
            let r = math.to_float(seed) / 139968.0
            
            let ch = if r < 0.27: ca else: if r < 0.39: cc else: if r < 0.51: cg else: if r < 0.78: ct else: if r < 0.80: cB else: if r < 0.82: cD else: if r < 0.84: cH else: if r < 0.86: cK else: if r < 0.88: cM else: if r < 0.90: cN else: if r < 0.92: cR else: if r < 0.94: cS else: if r < 0.96: cV else: if r < 0.98: cW else: cY
            line_seq = line_seq + ch
            i = i + 1
            
        console.print(line_seq)
        n2 = n2 - len_out
        
    console.print(">THREE Homo sapiens frequency")
    var n3 = 5 * n
    while n3 > 0:
        let len_out = min(n3, 60)
        var line_seq = ""
        var i = 0
        while i < len_out:
            seed = (seed * 3877 + 29573) % 139968
            let r = math.to_float(seed) / 139968.0
            
            let ch = if r < 0.3029549426680: ca else: if r < 0.5009432431601: cc else: if r < 0.6984905497992: cg else: ct
            line_seq = line_seq + ch
            i = i + 1
            
        console.print(line_seq)
        n3 = n3 - len_out

    let bench_t1 = clock.now_monotonic()
    console.print("bench_ns=${bench_t1 - bench_t0}")
